 PS2_READ_FUNCTIONS(128, __m128i, Load128)
 #undef PS2_READ_FUNCTIONS
+#else
+#define PS2_READ_FUNCTIONS(bits, type, load)                                                               \
+    static PS2_NOINLINE type Ps2ReadSlow##bits(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime,     \
+                                               uint32_t addr)                                            \
+    {                                                                                                    \
+        if (g_ps2HotStatsOn)                                                                             \
+            ps2HotNoteSlowAccess(addr, sizeof(type), false);                                             \
+        if (addr < PS2_RAM_SIZE)                                                                         \
+            return Ps2FastRead##bits(rdram, addr);                                                       \
+        type value;                                                                                      \
+        if (Ps2ScratchpadInlineRead(addr, value))                                                        \
+            return value;                                                                                \
+        if (!PS2Runtime::isSpecialAddress(addr))                                                         \
+            return Ps2FastRead##bits(rdram, addr);                                                       \
+        return Ps2ScratchpadRead(addr, value) ? value : runtime->load(rdram, ctx, addr);                 \
+    }                                                                                                    \
+    static PS2_FORCEINLINE type Ps2Read##bits(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime,    \
+                                             uint32_t addr)                                              \
+    {                                                                                                    \
+        type value;                                                                                      \
+        const uint32_t offset = PS2_RAM_INLINE_OFFSET(addr);                                             \
+        if (offset <= PS2_RAM_SIZE - sizeof(type)) [[likely]]                                            \
+        {                                                                                                \
+            std::memcpy(&value, rdram + offset, sizeof(type));                                           \
+            return value;                                                                                \
+        }                                                                                                \
+        if (PS2_SPR_TRY_READ(addr, value))                                                                \
