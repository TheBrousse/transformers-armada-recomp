+// The stores' rare paths (see above): as the inline form did after its main-RAM test.
+#define PS2_WRITE_SLOW_FUNCTION(bits, type, store, drain)                                                  \
+    static PS2_NOINLINE void Ps2WriteSlow##bits(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime,    \
