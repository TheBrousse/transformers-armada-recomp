 // scratchpad, I/O and VU memory, the BIOS - through a call kept out of its way. (Until
 // 2026-10-04 these were immediately invoked lambdas, which the compiler did not always inline
@@ -481,6 +519,71 @@ PS2_READ_FUNCTIONS(32, uint32_t, Load32)
