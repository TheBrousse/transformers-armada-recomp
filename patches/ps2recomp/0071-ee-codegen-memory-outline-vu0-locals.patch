+                        replacement = "(" + std::string(args[0]) + ")";
+                    else
+                        replacement = "_mm_blend_ps(" + std::string(args[0]) + ", " + std::string(args[1]) + ", " +
+                                      std::to_string(imm) + ")";
+                    line.replace(at, close + 1 - at, replacement);
+                    at += replacement.size();
+                    ++folded;
+                }
+            }
+            // PS2_VADD/PS2_VSUB(x, mul_res) after `__m128 mul_res = PS2_VMUL...(`: mul_res is clamped already
+            if (line.find("__m128 mul_res = PS2_VMUL") != std::string::npos)
+            {
+                static constexpr std::pair<std::string_view, std::string_view> kOps[] = {
+                    {"PS2_VADD(", "PS2_VADD_C("}, {"PS2_VSUB(", "PS2_VSUB_C("}};
+                for (const auto &[from, to] : kOps)
+                {
+                    size_t at = 0;
+                    while ((at = line.find(from, at)) != std::string::npos)
+                    {
+                        std::vector<std::string_view> args;
+                        size_t close = 0;
+                        if (splitArguments(line, at + from.size() - 1, args, close) && args.size() == 2 && args[1] == "mul_res")
+                        {
+                            line.replace(at, from.size(), to);
+                            ++folded;
+                        }
+                        at += from.size();
+                    }
+                }
+            }
+            return folded;
+        }
+    }
+
+    int foldVuConstantBlends(std::string &functionText)
+    {
+        int folded = 0;
+        std::string out;
+        out.reserve(functionText.size());
+        size_t at = 0;
+        std::string line;
+        while (at < functionText.size())
+        {
+            const size_t nl = functionText.find('\n', at);
+            const size_t end = nl == std::string::npos ? functionText.size() : nl + 1;
+            line.assign(functionText, at, end - at);
+            const std::string_view t = trim(line);
+            if (!t.starts_with("//") && (line.find("blendv_ps(") != std::string::npos || line.find("PS2_VBLEND(") != std::string::npos ||
+                                        line.find("mul_res") != std::string::npos))
+                folded += foldLine(line);
+            out.append(line);
+            at = end;
+        }
+        if (folded)
+            functionText = std::move(out);
+        return folded;
+    }
+
+    // (FPS round 5) elideFpuClamps: see register_cache.h.
+    namespace
+    {
+        // rf_<n> as the whole of `v`: n, else -1.
+        int fpLocal(std::string_view v)
+        {
+            if (!v.starts_with("rf_") || v.size() < 4 || v.size() > 5)
+                return -1;
+            int n = 0;
+            for (size_t i = 3; i < v.size(); ++i)
+            {
+                if (!std::isdigit(static_cast<unsigned char>(v[i])))
+                    return -1;
+                n = n * 10 + (v[i] - '0');
+            }
+            return n < 32 ? n : -1;
+        }
+
+        struct FpuClampState
+        {
+            std::bitset<32> known; // rf_<n> holds a clamped value (an ADD/SUB/MUL/DIV/SQRT result or a copy of one)
+        };
+
+        // An operand of FPU_ADD/SUB/MUL_S: whether its value is clamped already; a nested ADD/SUB/MUL is
+        // rewritten in place (its own operands) and is clamped.
+        bool operandClamped(std::string &operand, const std::bitset<32> &known, int &elided);
+
+        // `call` = "FPU_ADD_S(a, b)" (or SUB/MUL): rewritten to FPU_ADD_S_KN(...) etc. when an operand is known
+        // clamped. Returns false when it is not that shape.
+        bool rewriteArithmetic(std::string &call, const std::bitset<32> &known, int &elided)
+        {
+            static constexpr std::string_view kOps[] = {"FPU_ADD_S(", "FPU_SUB_S(", "FPU_MUL_S("};
+            std::string_view op;
+            for (const std::string_view candidate : kOps)
+            {
+                if (call.starts_with(candidate))
+                    op = candidate;
+            }
+            if (op.empty())
+                return false;
+            std::vector<std::string_view> args;
+            size_t close = 0;
+            if (!splitArguments(call, op.size() - 1, args, close) || close + 1 != call.size() || args.size() != 2)
+                return false;
+            std::string a(args[0]), b(args[1]);
+            const bool ka = operandClamped(a, known, elided);
+            const bool kb = operandClamped(b, known, elided);
+            std::string name(op.substr(0, op.size() - 1));
+            if (ka || kb)
+            {
+                name += ka ? (kb ? "_KK" : "_KN") : "_NK";
+                elided += (ka ? 1 : 0) + (kb ? 1 : 0);
+            }
+            call = name + "(" + a + ", " + b + ")";
+            return true;
+        }
+
+        bool operandClamped(std::string &operand, const std::bitset<32> &known, int &elided)
+        {
+            const int n = fpLocal(operand);
+            if (n >= 0)
+                return known.test(static_cast<size_t>(n));
+            // FPU_SET_ACC is the only writer of the FPU's ACC, always with an ADD/SUB/MUL result (clamped); it
+            // starts at 0 and save states do not hold it.
+            if (operand == "ctx->f_acc")
+                return true;
+            return rewriteArithmetic(operand, known, elided);
+        }
+    }
+
+    int elideFpuClamps(std::string &functionText)
+    {
+        int elided = 0;
+        std::string out;
+        out.reserve(functionText.size() + functionText.size() / 16);
+        std::bitset<32> known;
+        std::vector<std::bitset<32>> blocks;
+        std::vector<char> code;
+        size_t at = 0;
+        while (at < functionText.size())
+        {
+            const size_t nl = functionText.find('\n', at);
+            const size_t end = nl == std::string::npos ? functionText.size() : nl + 1;
+            std::string line = functionText.substr(at, end - at);
+            at = end;
+            std::string_view body = line;
+            while (!body.empty() && (body.back() == '\n' || body.back() == '\r'))
+                body.remove_suffix(1);
+            const std::string_view t = trim(body);
+            if (t.empty() || t.starts_with("//") || t.starts_with("#"))
+            {
+                out.append(line);
+                continue;
+            }
+            if (t.starts_with("label_") && t.ends_with(":"))
+            {
+                known.reset(); // (a join: what reaches it is not known)
+                out.append(line);
+                continue;
+            }
+            const size_t indent = body.find_first_not_of(" \t");
+            std::string stmt(t);
+            int dest = -1;
+            bool handled = false;
+            bool destKnown = false;
+            // rf_D = <expr>;
+            if (stmt.starts_with("rf_") && stmt.ends_with(";"))
+            {
+                const size_t eq = stmt.find(" = ");
+                if (eq != std::string::npos && (dest = fpLocal(std::string_view(stmt).substr(0, eq))) >= 0)
+                {
+                    std::string expr = stmt.substr(eq + 3, stmt.size() - eq - 4);
+                    if (rewriteArithmetic(expr, known, elided))
+                    {
+                        destKnown = true;
+                        handled = true;
+                    }
+                    else
+                    {
+                        static constexpr std::string_view kCopies[] = {"FPU_MOV_S(", "FPU_NEG_S(", "FPU_ABS_S("};
+                        static constexpr std::string_view kPicks[] = {"FPU_MAX_S(", "FPU_MIN_S("};
+                        static constexpr std::string_view kResults[] = {"FPU_DIV_S(", "FPU_SQRT_S(", "FPU_RSQRT_S("};
+                        for (const std::string_view f : kCopies)
+                        {
+                            if (expr.starts_with(f) && expr.ends_with(")"))
+                            {
+                                const int s = fpLocal(std::string_view(expr).substr(f.size(), expr.size() - f.size() - 1));
+                                destKnown = s >= 0 && known.test(static_cast<size_t>(s));
+                            }
+                        }
+                        for (const std::string_view f : kPicks)
+                        {
+                            std::vector<std::string_view> args;
+                            size_t close = 0;
+                            if (expr.starts_with(f) && splitArguments(expr, f.size() - 1, args, close) && args.size() == 2 &&
+                                close + 1 == expr.size())
+                            {
+                                const int a = fpLocal(args[0]), b = fpLocal(args[1]);
+                                destKnown = a >= 0 && b >= 0 && known.test(static_cast<size_t>(a)) && known.test(static_cast<size_t>(b));
+                            }
+                        }
+                        for (const std::string_view f : kResults)
+                        {
+                            if (expr.starts_with(f))
+                                destKnown = true; // (their results are clamped: ps2_runtime_macros.h)
+                        }
+                        handled = true;
+                    }
+                    stmt = stmt.substr(0, eq + 3) + expr + ";";
+                }
+            }
+            else if (stmt.starts_with("FPU_SET_ACC(ctx, ") && stmt.ends_with(");"))
+            {
+                std::string expr = stmt.substr(17, stmt.size() - 19);
+                if (rewriteArithmetic(expr, known, elided))
+                    stmt = "FPU_SET_ACC(ctx, " + expr + ");";
+                handled = true;
+            }
+            if (handled)
+            {
+                if (dest >= 0)
+                    known.set(static_cast<size_t>(dest), destKnown);
+                out.append(body.substr(0, indent)).append(stmt).append(line.substr(body.size()));
+                continue;
+            }
+            // Anything else: every rf_<n> it assigns is no longer known; RC_FLD(n) (after a call) neither.
+            markCode(body, code);
+            const bool oneLineBlock = t.starts_with("{") && t.ends_with("}");
+            for (size_t i = 0; i < body.size(); ++i)
+            {
+                if (!code[i])
+                    continue;
+                if (!oneLineBlock && body[i] == '{')
+                {
+                    blocks.push_back(known);
+                    continue;
+                }
+                if (!oneLineBlock && body[i] == '}')
+                {
+                    if (!blocks.empty())
+                    {
+                        known &= blocks.back(); // (the way past the block and the way through it)
+                        blocks.pop_back();
+                    }
+                    continue;
+                }
+                if (body.substr(i, 3) == "rf_" && (i == 0 || !isIdentChar(body[i - 1])))
+                {
+                    size_t e = i + 3;
+                    while (e < body.size() && std::isdigit(static_cast<unsigned char>(body[e])))
+                        ++e;
+                    const int n = fpLocal(body.substr(i, e - i));
+                    if (n >= 0 && (assignsAfter(body, e) || (i > 0 && body[i - 1] == '&')))
+                        known.reset(static_cast<size_t>(n));
+                    i = e - 1;
+                    continue;
+                }
+                if (body.substr(i, 7) == "RC_FLD(")
+                {
+                    size_t e = i + 7;
+                    int n = 0;
+                    while (e < body.size() && std::isdigit(static_cast<unsigned char>(body[e])))
+                        n = n * 10 + (body[e++] - '0');
+                    if (n < 32)
+                        known.reset(static_cast<size_t>(n));
+                    i = e - 1;
+                }
+            }
+            out.append(line);
+        }
+        if (elided)
+            functionText = std::move(out);
+        return elided;
+    }
 }
