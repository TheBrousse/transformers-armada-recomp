+        }                                                                                                \
+        else if (PS2Runtime::isSpecialAddress(addr))                                                     \
+        {                                                                                                \
+            runtime->store(rdram, ctx, addr, value);                                                     \
+        }                                                                                                \
+        else                                                                                             \
+        {                                                                                                \
+            Ps2FastWrite##bits(rdram, addr, value);                                                      \
+        }                                                                                                \
+    }
+PS2_WRITE_SLOW_FUNCTION(8, uint8_t, Store8, false)
+PS2_WRITE_SLOW_FUNCTION(16, uint16_t, Store16, false)
+PS2_WRITE_SLOW_FUNCTION(32, uint32_t, Store32, true)
+PS2_WRITE_SLOW_FUNCTION(64, uint64_t, Store64, false)
+PS2_WRITE_SLOW_FUNCTION(128, __m128i, Store128, false)
+#undef PS2_WRITE_SLOW_FUNCTION
