+// (0x20000000-0x21FFFFFF, where the game writes its DMA lists) in the inline test as well - the address with bit
+// 29 cleared, which is that mirror's offset in RAM and leaves every other address outside RAM. The same bytes as
+// the out-of-line way (an address there is not special: Ps2FastWrite* masks it to the same offset).
+#ifndef PS2X_MEMORY_MIRROR_INLINE
+#define PS2X_MEMORY_MIRROR_INLINE 1
+#endif
+#if PS2X_MEMORY_MIRROR_INLINE
+#define PS2_RAM_INLINE_OFFSET(addr) ((addr) & 0xDFFFFFFFu)
+#else
+#define PS2_RAM_INLINE_OFFSET(addr) (addr)
+#endif
+#if PS2X_MEMORY_SCRATCHPAD_OUTLINE
+#define PS2_SPR_TRY_READ(addr, value) false
+#define PS2_SPR_TRY_WRITE(addr, value) false
+#else
+#define PS2_SPR_TRY_READ(addr, value) Ps2ScratchpadInlineRead(addr, value)
+#define PS2_SPR_TRY_WRITE(addr, value) Ps2ScratchpadInlineWrite(addr, value)
+#endif
+#if PS2X_MEMORY_COLD_INLINE
