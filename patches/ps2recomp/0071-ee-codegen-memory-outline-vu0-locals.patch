 }
 
+// (FPS round 5) PS2X_MEMORY_COLD_INLINE (-DTF_MEMORY_COLD_INLINE=ON for the game): every rare path of a
+// load and a store inline at each access, as before. By default only main RAM's usual case is inline - an
+// access wholly inside its 32 MB (none that wraps around its end), then the scratchpad as before - and the
+// rest (the wrap-around, the mirrors, I/O, VU memory, the BIOS) goes to one out-of-line function per size
+// with the former inline logic unchanged. The inline copies of the rare paths made each access ~0.5-1 KB of
+// code (the generated code ~220 MB for 21,600 functions).
+#ifndef PS2X_MEMORY_COLD_INLINE
+#define PS2X_MEMORY_COLD_INLINE 0
+#endif
+// PS2X_MEMORY_SCRATCHPAD_OUTLINE (with the rare paths out of line): the scratchpad (a non-constant address there)
+// left to the out-of-line function too, so an access is only main RAM's test inline.
+#ifndef PS2X_MEMORY_SCRATCHPAD_OUTLINE
+#define PS2X_MEMORY_SCRATCHPAD_OUTLINE 0
+#endif
