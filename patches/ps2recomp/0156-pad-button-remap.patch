+    // ---- The controller's buttons (patch 0156): the controller buttons that press each game button ----
+    constexpr int kPadButtons = kBindSelect + 1; // up .. select
+    std::mutex g_padMapMutex;
+    std::vector<int> g_padSources[kPadButtons]; // a game button's controller buttons
+    bool g_padMapLoaded = false;
+
+    int padButtonIndex(const std::string &name)
+    {
+        for (int i = 0; i < kPadButtons; ++i)
+            if (name == kBindingNames[i].name)
+                return i;
+        return -1;
+    }
+
+    void parsePadmap(const std::string &spec, std::vector<int> (&into)[kPadButtons])
+    {
+        size_t at = 0;
+        while (at < spec.size())
+        {
+            size_t end = spec.find(';', at);
+            if (end == std::string::npos)
+                end = spec.size();
+            const std::string item = spec.substr(at, end - at);
+            at = end + 1;
+            const size_t eq = item.find('=');
+            const int game = eq == std::string::npos ? -1 : padButtonIndex(item.substr(0, eq));
+            if (game < 0)
+                continue;
+            std::vector<int> list;
+            const std::string names = item.substr(eq + 1);
+            size_t p = 0;
+            while (p <= names.size())
+            {
+                size_t comma = names.find(',', p);
+                if (comma == std::string::npos)
+                    comma = names.size();
+                const int physical = padButtonIndex(names.substr(p, comma - p));
+                if (physical >= 0 && std::find(list.begin(), list.end(), physical) == list.end())
+                    list.push_back(physical);
+                p = comma + 1;
+            }
+            into[game] = list;
+        }
+    }
+
+    void padIdentity(std::vector<int> (&into)[kPadButtons])
+    {
+        for (int i = 0; i < kPadButtons; ++i)
+            into[i] = {i};
+    }
+
+    std::string formatPadmap(const std::vector<int> (&from)[kPadButtons])
+    {
+        std::string out;
+        for (int i = 0; i < kPadButtons; ++i)
+        {
+            if (!out.empty())
+                out += ';';
+            out += kBindingNames[i].name;
+            out += '=';
+            for (size_t c = 0; c < from[i].size(); ++c)
+                out += (c ? "," : "") + std::string(kBindingNames[from[i][c]].name);
+        }
+        return out;
+    }
+
+    // (with g_padMapMutex held) The triggers' routing for their adaptive effects: the game trigger each controller
+    // trigger presses (the game's L2 first).
+    void routeTriggersLocked()
+    {
+        const auto route = [](int physical)
+        {
+            for (int game : {kBindL2, kBindR2})
+                if (std::find(g_padSources[game].begin(), g_padSources[game].end(), physical) != g_padSources[game].end())
+                    return game == kBindL2 ? 1 : 2;
+            return 0;
+        };
+        ps2x::sonypad::setTriggerRouting(route(kBindL2), route(kBindR2));
+    }
+
+    void loadPadMapLocked()
+    {
+        if (g_padMapLoaded)
+            return;
+        g_padMapLoaded = true;
+        padIdentity(g_padSources);
+        if (const char *env = std::getenv("PS2X_PADMAP"); env && *env)
+        {
+            parsePadmap(env, g_padSources);
+            std::fprintf(stderr, "[pad] controller buttons: %s\n", formatPadmap(g_padSources).c_str());
+        }
+        routeTriggersLocked();
+    }
+
+    // The game's buttons from the controller's (pressed[i]: controller button i), and the game's analog L2 / R2 from the
+    // controller's triggers (a game trigger pressed by a button: 0 or 1).
+    uint16_t padToGame(const bool (&pressed)[kPadButtons], float physicalL2, float physicalR2, float &gameL2, float &gameR2)
+    {
+        std::vector<int> sources[kPadButtons];
+        {
+            std::lock_guard<std::mutex> lock(g_padMapMutex);
+            loadPadMapLocked();
+            for (int i = 0; i < kPadButtons; ++i)
+                sources[i] = g_padSources[i];
+        }
+        uint16_t down = 0u;
+        const auto analog = [&](int game)
+        {
+            float v = 0.0f;
+            for (int p : sources[game])
+                v = std::max(v, p == kBindL2 ? physicalL2 : p == kBindR2 ? physicalR2 : (pressed[p] ? 1.0f : 0.0f));
+            return v;
+        };
+        for (int game = 0; game < kPadButtons; ++game)
+            for (int p : sources[game])
+                if (pressed[p])
+                {
+                    down |= kBindingNames[game].mask;
+                    break;
+                }
+        gameL2 = analog(kBindL2);
+        gameR2 = analog(kBindR2);
+        return down;
+    }
 }
 
