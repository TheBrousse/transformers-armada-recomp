diff --git a/ps2xRuntime/src/lib/ps2_sony_pad.cpp b/ps2xRuntime/src/lib/ps2_sony_pad.cpp
--- a/ps2xRuntime/src/lib/ps2_sony_pad.cpp
+++ b/ps2xRuntime/src/lib/ps2_sony_pad.cpp
@@ -549,10 +549,44 @@ namespace ps2x::sonypad
         host::wake();
     }
 
+    namespace
+    {
+        std::atomic<int> g_routeLeft{1}, g_routeRight{2}; // (patch 0156: the game trigger each controller trigger presses)
+    }
+
     TriggerRequest triggerRequest()
     {
-        std::lock_guard<std::mutex> lock(g_requestMutex);
-        return g_triggerRequest;
+        TriggerRequest game;
+        {
+            std::lock_guard<std::mutex> lock(g_requestMutex);
+            game = g_triggerRequest;
+        }
+        const int left = g_routeLeft.load(std::memory_order_relaxed), right = g_routeRight.load(std::memory_order_relaxed);
+        if (left == 1 && right == 2)
+            return game;
+        TriggerRequest out = game;
+        const auto take = [&](int from, uint8_t (&effect)[11], uint8_t &press)
+        {
+            if (from == 1)
+                std::memcpy(effect, game.left, 11), press = game.pressLeft;
+            else if (from == 2)
+                std::memcpy(effect, game.right, 11), press = game.pressRight;
+            else
+                std::memset(effect, 0, 11), press = 0u; // (a bumper presses that game button now: no effect here)
+        };
+        take(left, out.left, out.pressLeft);
+        take(right, out.right, out.pressRight);
+        return out;
+    }
+
+    void setTriggerRouting(int left, int right)
+    {
+        const bool same = (g_routeLeft.exchange(left) == left) & (g_routeRight.exchange(right) == right); // (both stored)
+        if (same)
+            return;
+        std::fprintf(stderr, "[sonypad] trigger effects: the left trigger takes the game's %s, the right its %s\n", left == 1 ? "L2" : left == 2 ? "R2" : "nothing", right == 1 ? "L2" : right == 2 ? "R2" : "nothing");
+        g_requestGeneration.fetch_add(1u, std::memory_order_acq_rel);
+        host::wake();
     }
 
     uint64_t padRequestGeneration() { return g_requestGeneration.load(std::memory_order_acquire); }
