 //                                just past it
 //   PS2X_MOUSE_TEST=<vx>,<vy>    testing: act as a captured mouse moving at that speed
 //                                (pixels per second)
+namespace
+{
+    std::mutex g_stickMutex;
+    float g_vehicleWeight = 0.0f, g_vehicleDeadzone = 0.2f;
+    std::chrono::steady_clock::time_point g_stickSample{};
+    ps2_stick_response::Config stickConfig()
+    {
+        ps2_stick_response::Config c;
+        c.enabled = ps2_settings::value("PS2X_STICK_RESPONSE") != "off";
+        c.vehicleOriginal = ps2_settings::value("PS2X_STICK_VEHICLE_MODE") != "tuned";
+        const auto number = [](const char *key, float fallback, float lo, float hi)
+        {
+            const std::string s = ps2_settings::value(key);
+            char *end = nullptr;
+            const float v = std::strtof(s.c_str(), &end);
+            return end != s.c_str() && !*end && std::isfinite(v) ? std::clamp(v, lo, hi) : fallback;
+        };
+        c.leftLift = number("PS2X_STICK_LEFT_LIFT", c.leftLift, 0.0f, 0.9f);
+        c.rightLift = number("PS2X_STICK_RIGHT_LIFT", c.rightLift, 0.0f, 0.9f);
+        c.sensitivity = number("PS2X_STICK_LEFT_SENSITIVITY", c.sensitivity, 0.1f, 2.0f);
+        const auto lift = ps2_settings::value("PS2X_STICK_VEHICLE_LIFT");
+        c.vehicleLift = lift == "off" ? 0.0f : number("PS2X_STICK_VEHICLE_LIFT", -1.0f, 0.0f, 0.9f);
+        c.vehicleResponse = number("PS2X_STICK_VEHICLE_RESPONSE", c.vehicleResponse, 0.25f, 4.0f);
+        return c;
+    }
+}
+
+void ps2_stick_response::sampleVehicle(int mode, float deadzone)
+{
+    std::lock_guard<std::mutex> lock(g_stickMutex);
+    const auto now = std::chrono::steady_clock::now();
+    const float dt = std::chrono::duration<float>(now - g_stickSample).count();
+    if (dt > 0.5f) g_vehicleWeight = mode == 3 ? 1.0f : 0.0f;
+    g_vehicleWeight = blend(g_vehicleWeight, mode, std::min(dt, 0.2f));
+    g_vehicleDeadzone = std::isfinite(deadzone) ? std::clamp(deadzone, 0.0f, 0.9f) : 0.2f;
+    g_stickSample = now;
+}
+
