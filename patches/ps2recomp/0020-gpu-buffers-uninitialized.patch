     }
 
+    // A vector that leaves new elements uninitialized (resize does not zero them): the frame's
+    // vertex and mesh buffers are written right after they grow, and the zeroing showed up as a
+    // tenth of the GS thread's time (2026-10-22, Transformers' meshes).
+    template <class T>
+    struct DefaultInit : std::allocator<T>
+    {
+        template <class U>
+        struct rebind
+        {
+            using other = DefaultInit<U>;
+        };
+        DefaultInit() = default;
+        template <class U>
+        DefaultInit(const DefaultInit<U> &) noexcept
+        {
+        }
+        template <class U, class... Args>
+        void construct(U *at, Args &&...args)
+        {
+            if constexpr (sizeof...(Args) == 0)
+                ::new (static_cast<void *>(at)) U;
+            else
+                ::new (static_cast<void *>(at)) U(std::forward<Args>(args)...);
+        }
+    };
+
     struct GpuVertex
     {
         float x, y;
