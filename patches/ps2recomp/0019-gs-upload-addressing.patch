-        const uint64_t job = fs.workers->submitBarrier([state, simd, v0, v1, v2]()
-                                                       {
-                                      const GSVertex v[3] = {v0, v1, v2};
-                                      uint64_t pixels = 0u;
-                                      runRasterJob(state, simd, v, RowSet{}, pixels); });
