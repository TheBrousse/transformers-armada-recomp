-void GSCpuBackend::ResetUnlocked()
-{
-    FinishRaster();
-    m_clut.fill(0u);
-    m_clutCbp.fill(0u);
-    m_texturePageCache.Invalidate();
-    ++m_fast->clutVersion;
-    MarkAllVramWritten();
-    m_transfer = {};
-    m_transfer.direction = 3u;
-    m_transferState = {};
