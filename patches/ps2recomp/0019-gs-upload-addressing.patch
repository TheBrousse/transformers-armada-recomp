-// Finds or makes the decoded copy of the run's texture and sets up how it is sampled. False
-// for formats this path does not sample.
-bool GSCpuBackend::PrepareRunTexture()
-{
-    FastState &fs = *m_fast;
-    FastState::Run &run = fs.run;
-    const GSDrawState &state = run.state;
-    const GSContext &ctx = state.context;
-    const GSTex0Reg &tex0 = ctx.tex0;
-    const uint8_t psm = tex0.psm;
-    const bool indexed = isFourBitIndexedPsm(psm) || isEightBitIndexedPsm(psm);
-    if (!indexed && !isColorSurfacePsm(psm) && !isDepthSurfacePsm(psm))
-        return false;
-
-    TexSampler &out = run.rs.tex;
-    const int texW = state.textureWidth;
-    const int texH = state.textureHeight;
-    const uint64_t clamp = ctx.clamp;
-    out.wrapU = static_cast<uint8_t>(clamp & 0x3u);
-    out.wrapV = static_cast<uint8_t>((clamp >> 2u) & 0x3u);
-    out.minU = static_cast<int>((clamp >> 4u) & 0x3FFu);
-    out.maxU = static_cast<int>((clamp >> 14u) & 0x3FFu);
-    out.minV = static_cast<int>((clamp >> 24u) & 0x3FFu);
-    out.maxV = static_cast<int>((clamp >> 34u) & 0x3FFu);
-    const int width = decodeExtent(texW, out.wrapU, out.minU, out.maxU);
-    const int height = decodeExtent(texH, out.wrapV, out.minV, out.maxV);
-
-    // TEXA only changes how RGB24 and RGBA16 texels expand.
-    const bool usesTexa = !indexed && psm != GS_PSM_CT32 && psm != GS_PSM_Z32;
-    const GSTexaReg texa = usesTexa ? state.texa : GSTexaReg{};
-
-    const auto matches = [&](const FastState::Texture &t)
-    {
-        return t.tbp == tex0.tbp0 && t.tbw == tex0.tbw && t.psm == psm && t.width == width && t.height == height &&
-               t.texa.ta0 == texa.ta0 && t.texa.ta1 == texa.ta1 && t.texa.aem == texa.aem;
-    };
-
-    FastState::Texture *entry = (fs.lastTexture && matches(*fs.lastTexture)) ? fs.lastTexture : nullptr;
-    if (!entry)
-    {
-        for (const auto &candidate : fs.textures)
-        {
-            if (matches(*candidate))
-            {
-                entry = candidate.get();
-                break;
-            }
-        }
-    }
-
-    if (!entry)
-    {
-        constexpr size_t kMaxTextures = 256u;
-        constexpr size_t kMaxBytes = 96u * 1024u * 1024u;
-        const size_t texels = static_cast<size_t>(width) * static_cast<size_t>(height);
-        const size_t bytes = texels * (indexed ? 1u : 4u);
-        while (!fs.textures.empty() && (fs.textures.size() >= kMaxTextures || fs.textureBytes + bytes > kMaxBytes))
-        {
-            auto oldest = std::min_element(fs.textures.begin(), fs.textures.end(), [](const auto &a, const auto &b)
-                                           { return a->lastUse < b->lastUse; });
-            for (uint16_t page : (*oldest)->pages)
-                --fs.pageTextures[page];
-            fs.textureBytes -= (*oldest)->bytes();
-            if (fs.lastTexture == oldest->get())
-                fs.lastTexture = nullptr;
-            fs.retireTexture(std::move(*oldest)); // queued primitives may still sample it
-            fs.textures.erase(oldest);
-        }
-        if (fs.deferredBytes > 256u * 1024u * 1024u)
-            fs.reclaimFinished(fs.completedJobs());
-        if (fs.deferredBytes > 256u * 1024u * 1024u)
-            FinishRaster();
-
-        auto created = std::make_unique<FastState::Texture>();
-        created->tbp = tex0.tbp0;
-        created->tbw = tex0.tbw;
-        created->psm = psm;
-        created->width = width;
-        created->height = height;
-        created->texa = texa;
-        if (indexed)
-            created->index.assign(texels + 8u, 0u); // the vector code loads four bytes per texel
-        else
-            created->rgba.assign(texels, 0u);
-        created->tilesX = (width + 15) / 16;
-        created->tilesY = (height + 15) / 16;
-        created->tileValid.assign((static_cast<size_t>(created->tilesX) * created->tilesY + 63u) / 64u, 0ull);
-
-        std::array<bool, 512> seen{};
-        forEachPage(tex0.tbp0, tex0.tbw, psm, 0, 0, width - 1, height - 1, [&](uint32_t page)
-                    {
-                        if (!seen[page])
-                        {
-                            seen[page] = true;
-                            created->pages.push_back(static_cast<uint16_t>(page));
-                        } });
-        for (uint16_t page : created->pages)
-            ++fs.pageTextures[page];
-        created->pageLo = *std::min_element(created->pages.begin(), created->pages.end());
-        created->pageHi = *std::max_element(created->pages.begin(), created->pages.end());
-
-        // Which tiles read which page, so that a write to a page drops only those.
-        std::array<int16_t, 512> pageSlot;
-        pageSlot.fill(-1);
-        for (size_t k = 0; k < created->pages.size(); ++k)
-            pageSlot[created->pages[k]] = static_cast<int16_t>(k);
-        const auto forEachTilePage = [&](auto &&fn)
-        {
-            for (int ty = 0; ty < created->tilesY; ++ty)
-                for (int tx = 0; tx < created->tilesX; ++tx)
-                    forEachPage(tex0.tbp0, tex0.tbw, psm, tx * 16, ty * 16, std::min(tx * 16 + 15, width - 1),
-                                std::min(ty * 16 + 15, height - 1), [&](uint32_t page)
-                                {
-                                    if (pageSlot[page] >= 0)
-                                        fn(static_cast<uint32_t>(ty * created->tilesX + tx), static_cast<size_t>(pageSlot[page])); });
-        };
-        created->pageTileStart.assign(created->pages.size() + 1u, 0u);
-        forEachTilePage([&](uint32_t, size_t slot)
-                        { ++created->pageTileStart[slot + 1u]; });
-        for (size_t k = 0; k < created->pages.size(); ++k)
-            created->pageTileStart[k + 1u] += created->pageTileStart[k];
-        created->pageTiles.resize(created->pageTileStart.back());
-        std::vector<uint32_t> cursor(created->pageTileStart.begin(), created->pageTileStart.end() - 1);
-        forEachTilePage([&](uint32_t tile, size_t slot)
-                        { created->pageTiles[cursor[slot]++] = tile; });
-
-        created->decodeStamp = fs.stamp;
-        created->checkedEpoch = fs.textureEpoch;
-        fs.textureBytes += created->bytes();
-        entry = created.get();
-        fs.textures.push_back(std::move(created));
-    }
-    entry->lastUse = ++fs.useClock;
-    fs.lastTexture = entry;
-    fs.preparedTexture = entry;
-    run.texture = entry;
-    run.indexed = indexed;
-
-    out.rgba = indexed ? nullptr : entry->rgba.data();
-    out.index = indexed ? entry->index.data() : nullptr;
-    out.palette = indexed ? PrepareClutPalette(tex0, state.texa) : nullptr;
-    out.stride = static_cast<size_t>(width);
-    out.texW = texW;
-    out.texH = texH;
-    out.linear = state.linearFilter;
-    out.tfx = tex0.tfx;
-    out.tcc = tex0.tcc != 0u;
-    out.scaleU = texW * 256.0;
-    out.scaleV = texH * 256.0;
-    return true;
-}
