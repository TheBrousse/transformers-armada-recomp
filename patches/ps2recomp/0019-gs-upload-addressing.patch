-                          m_transfer.bitbltbuf.dbp,
-                          std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u),
-                          x + m_transfer.trxpos.dsax,
-                          y + m_transfer.trxpos.dsay,
-                          value);
