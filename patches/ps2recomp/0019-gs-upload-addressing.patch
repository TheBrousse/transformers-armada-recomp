+// ---------------------------------------------------------------------------
+// Fast path
+//
+// The reference functions above run the whole GS pipeline one pixel at a time:
+// every register is decoded again for each pixel and each texel goes through
+// the generic swizzle helpers and a CLUT lookup. The fast path decodes the draw
+// state once per primitive, walks triangles span by span with incremental
+// attributes, and samples textures from linear copies that are decoded on
+// demand and dropped when the VRAM pages behind them are written.
+//
+// It follows the GS conventions for coverage (sample points at integer pixel
+// coordinates, top-left fill rule) and bilinear filtering (texel centres at
+// +0.5), which the reference path approximates with pixel centres at +0.5.
+// Set PS2X_GS_REFERENCE=1 to draw everything with the reference path.
+// ---------------------------------------------------------------------------
+
+namespace
+{
+    GS_FAST_INLINE void cpuRelax()
+    {
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        _mm_pause();
+#endif
+    }
+
+    // Rasterizer threads. The GS thread queues primitives; every worker walks the whole
+    // queue in order and draws only its own rows, so each pixel is still drawn by one
+    // thread in submission order. What a thread writes often is on cache lines of its own,
+    // and jobs are announced in batches: with a job per small triangle, a line shared with
+    // every worker cost more than the triangle.
+    class RasterWorkers
+    {
+    public:
+        static constexpr uint32_t kNoState = 0xFFFFFFFFu;
+
+        static constexpr uint32_t kBarrierJob = 0xFFFFFFFEu;
+
+        explicit RasterWorkers(int count)
+            : m_ring(kCapacity), m_states(kCapacity), m_stateLastJob(kCapacity, 0u), m_barrierWork(kCapacity),
+              m_progress(static_cast<size_t>(count))
+        {
+            for (int i = 0; i < count; ++i)
+                m_threads.emplace_back([this, i, count]()
+                                       { run(i, count); });
+        }
+
+        ~RasterWorkers()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_wakeMutex);
+                m_stop.store(true);
+            }
+            m_wake.notify_all();
+            for (std::thread &thread : m_threads)
+                thread.join();
+        }
+
+        // The slot for the next job; waits while the queue is full.
+        RasterJob &next()
+        {
+            if (m_queued - m_doneSeen >= kCapacity)
+                waitUntil([&]()
+                          { return m_queued - m_doneSeen < kCapacity; });
+            return m_ring[m_queued & (kCapacity - 1u)];
+        }
+
+        // Copies the state of a run to where the jobs that follow can refer to it and
+        // returns the slot. The jobs that referred to what the slot held must be done.
+        uint32_t shareState(const RasterState &state)
+        {
+            const uint32_t slot = static_cast<uint32_t>(m_statesShared++ & (kCapacity - 1u));
+            if (m_doneSeen < m_stateLastJob[slot])
+                waitUntil([&]()
+                          { return m_doneSeen >= m_stateLastJob[slot]; });
+            m_states[slot] = state;
+            return slot;
+        }
+
+        // Counts the job filled in through next(), which refers to state slot `state`.
+        void submit(uint32_t state)
+        {
+            m_stateLastJob[state] = ++m_queued;
+            m_barrierOpen = false;
+            if (m_queued - m_announced >= kAnnounceBatch)
+                announce(false);
+        }
+
+        // A job that runs `work` on one thread once every thread has finished all jobs
+        // before it; none goes on to the jobs after it until `work` is done. For what reads
+        // memory that queued primitives write (a texture decode) or that has to be drawn by
+        // one thread (a primitive that samples what it draws).
+        //
+        // Barriers that follow each other with nothing in between are one: the work joins
+        // the last barrier as long as the threads have not been told about it. Returns the
+        // number of the barrier's job.
+        uint64_t submitBarrier(std::function<void()> work)
+        {
+            if (m_barrierOpen)
+            {
+                m_barrierWork[static_cast<size_t>((m_queued - 1u) & (kCapacity - 1u))].push_back(std::move(work));
+                return m_queued;
+            }
+            RasterJob &job = next();
+            const size_t slot = static_cast<size_t>(m_queued & (kCapacity - 1u));
+            job.ys = 0;
+            job.ye = -1;
+            job.state = kBarrierJob;
+            m_barrierWork[slot].clear();
+            m_barrierWork[slot].push_back(std::move(work));
+            ++m_queued;
+            m_barrierOpen = true;
+            return m_queued;
+        }
+
+        // Tells the workers about the jobs counted so far. Waking sleeping workers costs
+        // the producer a kernel call per thread, so it wakes one per batch of jobs and
+        // that worker wakes the others; `wake` does it for a few jobs too (nothing more is
+        // coming for now).
+        // Whether the last job is a barrier that can still take more work.
+        bool barrierOpen() const { return m_barrierOpen; }
+
+        void announce(bool wake)
+        {
+            if (m_announced == m_queued)
+                return;
+            m_announced = m_queued;
+            m_barrierOpen = false;
+            wake = wake || m_barrierWorkPending(); // every thread has to get to a barrier
+            m_published.store(m_queued);
+            if (m_sleepers.load() != 0 && (wake || m_queued - m_lastWake >= kWakeBatch))
+            {
+                std::lock_guard<std::mutex> lock(m_wakeMutex);
+                m_lastWake = m_queued;
+                m_wake.notify_one();
+            }
+        }
+
+        // Waits until every job is drawn.
+        void wait()
+        {
+            announce(false);
+            if (oldestDone() != m_queued)
+                wakeAll();
+            for (uint32_t spin = 0u; oldestDone() != m_queued; ++spin)
+            {
+                if (spin < 4096u)
+                    cpuRelax();
+                else
+                    std::this_thread::yield();
+            }
+            m_doneSeen = m_queued;
+        }
+
+        // Jobs handed out so far, and how many every worker has finished.
+        uint64_t queued() const { return m_queued; }
+        uint64_t completed()
+        {
+            m_doneSeen = oldestDone();
+            return m_doneSeen;
+        }
+
+        uint64_t pixels() const
+        {
+            uint64_t total = 0u;
+            for (const Progress &progress : m_progress)
+                total += progress.pixels;
+            return total;
+        }
+
+    private:
+        static constexpr uint64_t kCapacity = 8192u;
+        static constexpr uint64_t kAnnounceBatch = 16u;
+        static constexpr uint64_t kWakeBatch = 8u;
+        static constexpr uint32_t kSpinsBeforeSleep = 6000u;
+        static constexpr int kBandShift = 3;
+
+        void wakeAll()
+        {
+            if (m_sleepers.load() == 0)
+                return;
+            std::lock_guard<std::mutex> lock(m_wakeMutex);
+            m_lastWake = m_queued;
+            m_wake.notify_all();
+        }
+
+        struct alignas(64) Progress
+        {
+            std::atomic<uint64_t> done{0u};
+            uint64_t pixels = 0u;
+        };
+
+        uint64_t oldestDone() const
+        {
+            uint64_t done = m_queued;
+            for (const Progress &progress : m_progress)
+                done = std::min(done, progress.done.load(std::memory_order_acquire));
+            return done;
+        }
+
+        // Holds the producer up until `ready`, which looks at m_doneSeen, is true.
+        template <typename Ready>
+        void waitUntil(Ready &&ready)
+        {
+            m_doneSeen = oldestDone();
+            if (ready())
+                return;
+            announce(false);
+            wakeAll();
+            for (uint32_t spin = 0u;; ++spin)
+            {
+                m_doneSeen = oldestDone();
+                if (ready())
+                    return;
+                if (spin < 256u)
+                    cpuRelax();
+                else
+                    std::this_thread::yield();
+            }
+        }
+
+        // Job `position` is a barrier: the first thread runs its work once every thread has
+        // finished the jobs before it, the others wait for that.
+        void barrier(int index, uint64_t position)
+        {
+            if (index == 0)
+            {
+                for (uint32_t spin = 0u;; ++spin)
+                {
+                    uint64_t slowest = position;
+                    for (size_t i = 1; i < m_progress.size(); ++i)
+                        slowest = std::min(slowest, m_progress[i].done.load(std::memory_order_acquire));
+                    if (slowest >= position)
+                        break;
+                    if (spin < 4096u)
+                        cpuRelax();
+                    else
+                        std::this_thread::yield();
+                }
+                std::vector<std::function<void()>> &work = m_barrierWork[position & (kCapacity - 1u)];
+                for (std::function<void()> &item : work)
+                    item();
+                work.clear();
+                m_barriersDone.store(position + 1u, std::memory_order_release);
+                return;
+            }
+            for (uint32_t spin = 0u; m_barriersDone.load(std::memory_order_acquire) <= position; ++spin)
+            {
+                if (spin < 4096u)
+                    cpuRelax();
+                else
+                    std::this_thread::yield();
+            }
+        }
+
+        void run(int index, int count)
+        {
+            const RowSet rows{kBandShift, count, index};
+            Progress &progress = m_progress[static_cast<size_t>(index)];
+            uint64_t next = 0u;
+            for (;;)
+            {
+                uint64_t published = m_published.load(std::memory_order_acquire);
+                for (uint32_t spin = 0u; published == next && spin < kSpinsBeforeSleep; ++spin)
+                {
+                    cpuRelax();
+                    published = m_published.load(std::memory_order_acquire);
+                }
+                if (published == next)
+                {
+                    std::unique_lock<std::mutex> lock(m_wakeMutex);
+                    m_sleepers.fetch_add(1);
+                    m_wake.wait(lock, [&]()
+                                { return m_stop.load() || m_published.load() != next; });
+                    m_sleepers.fetch_sub(1);
+                    if (m_stop.load())
+                        return;
+                    // The producer woke just this worker: pass it on.
+                    if (m_sleepers.load() != 0)
+                        m_wake.notify_all();
+                    continue;
+                }
+                for (; next < published; ++next)
+                {
+                    const RasterJob &job = m_ring[next & (kCapacity - 1u)];
+                    if (job.state == kBarrierJob)
+                    {
+                        barrier(index, next);
+                    }
+                    else if (rowsIntersect(rows, job.ys, job.ye))
+                    {
+                        const RasterState &state = m_states[job.state];
+                        runRasterJob(state, state.simd, job.v, rows, progress.pixels);
+                    }
+                    progress.done.store(next + 1u, std::memory_order_release);
+                }
+            }
+        }
+
+        std::vector<RasterJob> m_ring;
+        std::vector<RasterState> m_states;     // what the jobs of a run share
+        std::vector<uint64_t> m_stateLastJob;  // producer side: the last job that refers to each slot
+        std::vector<std::vector<std::function<void()>>> m_barrierWork; // by job slot
+        bool m_barrierOpen = false; // the last job is a barrier the threads do not know about yet
+        // Whether a barrier is among the jobs being announced (they all have to be awake for it).
+        bool m_barrierWorkPending() const
+        {
+            return m_queued != 0u && m_ring[(m_queued - 1u) & (kCapacity - 1u)].state == kBarrierJob;
+        }
+        std::vector<Progress> m_progress;
+        std::vector<std::thread> m_threads;
+        // Written by the producer once per batch, read by the workers all the time.
+        alignas(64) std::atomic<uint64_t> m_published{0u};
+        std::atomic<bool> m_stop{false};
+        // The job after the last barrier whose work is done.
+        alignas(64) std::atomic<uint64_t> m_barriersDone{0u};
+        // The producer's own.
+        alignas(64) uint64_t m_queued = 0u;
+        uint64_t m_announced = 0u;
+        uint64_t m_doneSeen = 0u; // a count every worker had reached when it was last looked at
+        uint64_t m_statesShared = 0u;
+        uint64_t m_lastWake = 0u;
+        // Workers going to sleep and waking up.
+        alignas(64) std::atomic<int> m_sleepers{0};
+        std::mutex m_wakeMutex;
+        std::condition_variable m_wake;
+    };
+
+    // Whether the vector rasterizer can be used: built in, the CPU and the OS support AVX2,
+    // and PS2X_GS_SIMD is not 0.
+    bool rasterSimdAvailable()
+    {
+        if (const char *env = std::getenv("PS2X_GS_SIMD"))
+        {
+            if (env[0] == '0')
+                return false;
+        }
+#if PS2X_GS_AVX2 && defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+        int info[4] = {};
+        __cpuid(info, 0);
+        if (info[0] < 7)
+            return false;
+        __cpuid(info, 1);
+        const bool osSavesState = (info[2] & (1 << 27)) != 0 && (info[2] & (1 << 28)) != 0; // OSXSAVE, AVX
+        if (!osSavesState || (_xgetbv(0) & 6u) != 6u)
+            return false;
+        __cpuidex(info, 7, 0);
+        return (info[1] & (1 << 5)) != 0;
+#elif PS2X_GS_AVX2 && (defined(__x86_64__) || defined(__i386__))
+        return __builtin_cpu_supports("avx2");
+#else
+        return false;
+#endif
+    }
+
+    int rasterThreadCount()
+    {
+        if (const char *env = std::getenv("PS2X_GS_THREADS"))
+            return std::max(0, std::min(32, std::atoi(env)));
+        const int hardware = static_cast<int>(std::thread::hardware_concurrency());
+        // From 8 hardware threads up, one each is left for the EE, VIF1/VU1 and GS threads
+        // that feed the rasterizer threads (8 threads: 5 rasterize, measured faster than 4).
+        // With fewer, spinning workers slow down the threads that feed them.
+        if (hardware >= 8)
+            return std::min(8, hardware - 3);
+        return std::max(0, std::min(4, hardware - 2));
+    }
+
+    // Host-to-local transfer: `pixels` pixels of `src` (the format's packed layout: 4, 3, 2
+    // or 1 bytes, or two pixels a byte with the first in the low nibble) to VRAM from (x, y)
+    // on, row by row within [dsax, dsax + rrw); x and y move on. `changed` is set once a
+    // pixel differs from what VRAM held.
+    template <GSMem::PixelStorageMode Psm>
+    void uploadPixels(const typename GSMem::PixelStorageTraits<Psm>::PageLookupTableT &table, uint8_t *vram, uint32_t dbp,
+                      uint32_t dbw, uint32_t dsax, uint32_t rrw, uint32_t &x, uint32_t &y, uint32_t pixels,
+                      const uint8_t *src, bool &changed)
+    {
+        using namespace GSMem;
+        using Traits = PixelStorageTraits<Psm>;
+        using Packed = typename Traits::PackedT;
+        // In runs that stay in one row of one page: the page and the row of its lookup table are
+        // the run's, and each pixel's address is worked out once (Traits::Read and Write each do it
+        // on their own, the page division included: a game that streams its textures every frame,
+        // 145 MB a second here, had this as an eighth of the GS thread's time).
+        constexpr uint32_t pageW = static_cast<uint32_t>(Traits::PageExtent().x);
+        constexpr uint32_t pageH = static_cast<uint32_t>(Traits::PageExtent().y);
+        constexpr uint32_t pagePixels = static_cast<uint32_t>(Traits::PixelsPerPage());
+        constexpr uint32_t width = static_cast<uint32_t>(UnpackedBitWidth(Psm));
+        constexpr uint32_t bitOffset = static_cast<uint32_t>(Traits::BitOffset());
+        constexpr uint32_t addressMask = static_cast<uint32_t>(MEMORY_SIZE - sizeof(Packed));
+        const auto &blockTable = table[dbp % static_cast<uint32_t>(Traits::BlocksPerPage())];
+        const uint32_t rowEnd = dsax + rrw;
+        uint32_t i = 0u;
+        while (i < pixels)
+        {
+            const uint32_t runEnd = std::min(std::min(rowEnd, (x / pageW + 1u) * pageW), x + (pixels - i));
+            const uint32_t pageBase = static_cast<uint32_t>(Traits::PageId(dbp, dbw, x, y)) * pagePixels;
+            const auto &row = blockTable[y % pageH];
+            for (; x < runEnd; ++x, ++i)
+            {
+                uint32_t value = 0u;
+                if constexpr (Psm == C32 || Psm == Z32)
+                    std::memcpy(&value, src + 4u * i, 4u);
+                else if constexpr (Psm == C24 || Psm == Z24)
+                    value = static_cast<uint32_t>(src[3u * i]) | (static_cast<uint32_t>(src[3u * i + 1u]) << 8u) |
+                            (static_cast<uint32_t>(src[3u * i + 2u]) << 16u);
+                else if constexpr (Psm == C16 || Psm == C16S || Psm == Z16 || Psm == Z16S)
+                {
+                    uint16_t half = 0u;
+                    std::memcpy(&half, src + 2u * i, 2u);
+                    value = half;
+                }
+                else if constexpr (Psm == P8 || Psm == P8H)
+                    value = src[i];
+                else
+                    value = (src[i >> 1u] >> ((i & 1u) * 4u)) & 0x0Fu;
+                const uint32_t bits = (pageBase + row[x % pageW]) * width + bitOffset;
+                uint8_t *ptr = vram + ((bits / 8u) & addressMask);
+                Packed old;
+                std::memcpy(&old, ptr, sizeof(Packed));
+                Packed next;
+                if constexpr (Psm == C24 || Psm == Z24)
+                    next = static_cast<Packed>((old & 0xFF000000u) | (value & 0x00FFFFFFu));
+                else if constexpr (Psm == P4 || Psm == P4HL || Psm == P4HH)
+                {
+                    const uint32_t shift = bits % 8u;
+                    next = static_cast<Packed>((old & ~(0x0Fu << shift)) | ((value & 0x0Fu) << shift));
+                }
+                else
+                    next = static_cast<Packed>(value);
+                if (next != old) // (what Traits::Read gives back differs: the same test as before)
+                {
+                    changed = true;
+                    std::memcpy(ptr, &next, sizeof(Packed));
+                }
+            }
+            if (x == rowEnd)
+            {
+                x = dsax;
+                ++y;
+            }
+        }
+    }
+}
+
+// Decoded textures and the VRAM write tracking that keeps them current.
+struct GSCpuBackend::FastState
+{
+    struct Texture
+    {
+        uint32_t tbp = 0u;
+        uint32_t tbw = 0u;
+        uint8_t psm = 0u;
+        int width = 0;
+        int height = 0;
+        GSTexaReg texa{};
+        std::vector<uint32_t> rgba;  // direct colour formats
+        std::vector<uint8_t> index;  // CLUT formats
+        int tilesX = 0;              // decoded on demand in 16x16 tiles
+        int tilesY = 0;
+        std::vector<uint64_t> tileValid;
+        std::vector<uint16_t> pages; // VRAM pages the texels come from
+        uint16_t pageLo = 0u;        // lowest and highest of them
+        uint16_t pageHi = 511u;
+        // The tiles that read pages[k]: pageTiles[pageTileStart[k] .. pageTileStart[k + 1]).
+        std::vector<uint32_t> pageTileStart;
+        std::vector<uint32_t> pageTiles;
+        uint64_t decodeStamp = 0u;   // write stamp the valid tiles match
+        uint64_t checkedEpoch = 0u;
+        uint8_t lastDrop = 0u;       // for PS2X_GS_DECODE_LOG: 1 = stale tiles dropped, 2 = all of them
+        uint64_t lastUse = 0u;
+        // Queued primitives read rgba/index directly: the number of the last raster
+        // job this texture was handed out to (FastState::nextJob).
+        uint64_t useJob = 0u;
+
+        size_t bytes() const
+        {
+            return rgba.size() * sizeof(uint32_t) + index.size();
+        }
+
+        // Decodes the tiles in [tx0, tx1] x [ty0, ty1] that are not valid yet; returns how
+        // many that were.
+        uint32_t decodeTiles(const uint8_t *vram, int tx0, int ty0, int tx1, int ty1);
+        // Decodes one tile into the given buffers: the texture's own, or those a queued
+        // decode was handed (the texture may have other ones by the time it runs).
+        void decodeTile(const uint8_t *vram, int tx, int ty, uint32_t *colors, uint8_t *indices) const;
+        // Marks the tiles in [tx0, tx1] x [ty0, ty1] valid and lists those that were not.
+        void claimTiles(int tx0, int ty0, int tx1, int ty1, std::vector<uint32_t> &tiles);
+        uint64_t pendingDecodeJob = 0u; // the queued decode that last writes into the buffers
+        // The last raster job that may still read tiles dropped as stale: until it is done,
+        // those are decoded again only behind a barrier or into new buffers.
+        uint64_t droppedUseJob = 0u;
+
+        bool tilesValid(int tx0, int ty0, int tx1, int ty1) const
+        {
+            for (int ty = ty0; ty <= ty1; ++ty)
+            {
+                // Bits [first, last] of the row, a word at a time.
+                const size_t first = static_cast<size_t>(ty) * static_cast<size_t>(tilesX) + static_cast<size_t>(tx0);
+                const size_t last = first + static_cast<size_t>(tx1 - tx0);
+                for (size_t word = first >> 6u; word <= (last >> 6u); ++word)
+                {
+                    uint64_t wanted = ~0ull;
+                    if (word == (first >> 6u))
+                        wanted &= ~0ull << (first & 63u);
+                    if (word == (last >> 6u))
+                        wanted &= ~0ull >> (63u - (last & 63u));
+                    if ((tileValid[word] & wanted) != wanted)
+                        return false;
+                }
+            }
+            return true;
+        }
+    };
+
+    bool reference = false;
+
+    // Write stamp of every 8 KiB page, and how many cached textures read it.
+    std::array<uint64_t, 512> pageStamp{};
+    std::array<uint32_t, 512> pageTextures{};
+    // Frame/Z pages that primitives queued on the raster workers read or write, and the
+    // ones they write. Writing VRAM (an upload) has to wait for the workers if it touches
+    // one of the first, reading it (decoding a texture, loading a CLUT) only for the second:
+    // a depth buffer that is merely tested stays readable.
+    using PageSet = std::array<uint64_t, 8>;
+    PageSet inflightPages{};
+    PageSet inflightWritePages{};
+    bool anyInflight = false;
+
+    static void addPages(PageSet &set, uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1)
+    {
+        forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                    { set[(page >> 6) & 7u] |= 1ull << (page & 63u); });
+    }
+
+    static bool intersects(const PageSet &a, const PageSet &b)
+    {
+        uint64_t common = 0u;
+        for (size_t i = 0; i < a.size(); ++i)
+            common |= a[i] & b[i];
+        return common != 0u;
+    }
+
+    // Whether the rectangle's pages can lie in [lo, hi] (a cheap test before the page sets).
+    static bool mayTouchPages(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1, uint32_t lo, uint32_t hi)
+    {
+        uint32_t first = 0u;
+        uint32_t last = 0u;
+        pageBounds(bp, bw, psm, x0, y0, x1, y1, first, last);
+        return last >= 512u || (first <= hi && last >= lo); // past 511 the pages wrap around
+    }
+
+    // The surface (base, width, format family) through which queued primitives reach each
+    // in-flight page. The rasterizer threads own bands of rows of a surface, so they draw two
+    // primitives in order only if both reach a piece of memory through the same one: a
+    // primitive that touches an in-flight page through another surface has to wait.
+    std::array<uint32_t, 512> inflightSurface{};
+
+    static uint32_t surfaceKey(uint32_t bp, uint32_t bw, uint8_t psm)
+    {
+        // 24-bit formats are laid out like their 32-bit ones.
+        const uint32_t family = psm == GS_PSM_CT24 ? GS_PSM_CT32 : (psm == GS_PSM_Z24 ? GS_PSM_Z32 : psm);
+        return 0x80000000u | ((bp & 0x3FFFu) << 14u) | ((bw & 0x3Fu) << 8u) | family;
+    }
+
+    // Which queued jobs still touch a page. Every page notes the run (or barrier) that last
+    // wrote it and the one that last read or wrote it; a run notes its last job. The GS
+    // thread can read a page itself (to decode a texture) once the job that last wrote it is
+    // done, and write it once the one that last touched it is. Runs are kept in a ring: a
+    // reused entry only ever claims a later job, which errs on the side of waiting.
+    static constexpr uint32_t kRunJobs = 8192u;
+    std::array<uint32_t, 512> pageWriteRun{};
+    std::array<uint32_t, 512> pageAccessRun{};
+    std::vector<uint64_t> runLastJob = std::vector<uint64_t>(kRunJobs, 0u);
+    uint32_t runSerial = 0u;
+    uint64_t doneSeen = 0u; // a job count every rasterizer thread had reached when last looked at
+
+    uint32_t newRun()
+    {
+        const uint32_t serial = ++runSerial;
+        runLastJob[serial & (kRunJobs - 1u)] = 0u;
+        return serial;
+    }
+
+    void notePages(std::array<uint32_t, 512> &table, uint32_t serial, uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1,
+                   int y1)
+    {
+        forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                    { table[page] = serial; });
+    }
+
+    // Whether a job that last touched a page of the rectangle (as `table` counts) is still queued.
+    bool pending(const std::array<uint32_t, 512> &table, uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1)
+    {
+        if (!workers)
+            return false;
+        uint64_t last = 0u;
+        forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                    { last = std::max(last, runLastJob[table[page] & (kRunJobs - 1u)]); });
+        return jobPending(last);
+    }
+
+    bool jobPending(uint64_t job)
+    {
+        if (job <= doneSeen)
+            return false;
+        doneSeen = workers ? workers->completed() : ~0ull;
+        return job > doneSeen;
+    }
+
+    // Pages a queued job touches (and writes, when `written`).
+    void markPending(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1, bool written, uint32_t serial)
+    {
+        addPages(inflightPages, bp, bw, psm, x0, y0, x1, y1);
+        notePages(pageAccessRun, serial, bp, bw, psm, x0, y0, x1, y1);
+        if (written)
+        {
+            addPages(inflightWritePages, bp, bw, psm, x0, y0, x1, y1);
+            notePages(pageWriteRun, serial, bp, bw, psm, x0, y0, x1, y1);
+        }
+        anyInflight = true;
+    }
+
+    // The same for a queued primitive, which the rasterizer threads draw through this
+    // surface's rows.
+    void markInflight(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1, bool written, uint32_t serial)
+    {
+        markPending(bp, bw, psm, x0, y0, x1, y1, written, serial);
+        const uint32_t key = surfaceKey(bp, bw, psm);
+        forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                    { inflightSurface[page] = key; });
+        anyInflight = true;
+    }
+
+    bool otherSurfaceInflight(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1) const
+    {
+        if (!anyInflight)
+            return false;
+        const uint32_t key = surfaceKey(bp, bw, psm);
+        bool other = false;
+        forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                    { other = other || (inflightSurface[page] != 0u && inflightSurface[page] != key); });
+        return other;
+    }
+
+    bool touchesInflight(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1) const
+    {
+        if (!anyInflight)
+            return false;
+        PageSet touched{};
+        addPages(touched, bp, bw, psm, x0, y0, x1, y1);
+        return intersects(touched, inflightPages);
+    }
+
+    bool touchesInflightWrite(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1) const
+    {
+        if (!anyInflight)
+            return false;
+        PageSet touched{};
+        addPages(touched, bp, bw, psm, x0, y0, x1, y1);
+        return intersects(touched, inflightWritePages);
+    }
+
+    // Address tables of the surfaces primitives draw to (few; queued jobs point at them, so
+    // they are kept for good).
+    struct SurfaceTable
+    {
+        uint32_t key = 0u;
+        bool separable = false;
+        SurfaceOffsets offsets;
+    };
+    std::vector<std::unique_ptr<SurfaceTable>> surfaceTables;
+    const SurfaceTable *lastFrameTable = nullptr;
+    const SurfaceTable *lastDepthTable = nullptr;
+    bool simd = rasterSimdAvailable();
+
+    const SurfaceOffsets *surfaceOffsets(uint32_t bp, uint32_t bw, uint8_t psm, const SurfaceTable *&last)
+    {
+        const uint32_t key = 0x80000000u | ((bp & 0x3FFFu) << 14u) | ((bw & 0x3Fu) << 8u) | psm;
+        if (!last || last->key != key)
+        {
+            last = nullptr;
+            for (const std::unique_ptr<SurfaceTable> &table : surfaceTables)
+            {
+                if (table->key == key)
+                {
+                    last = table.get();
+                    break;
+                }
+            }
+            if (!last)
+            {
+                auto table = std::make_unique<SurfaceTable>();
+                table->key = key;
+                table->separable = buildSurfaceOffsets(table->offsets, bp, bw, psm);
+                last = table.get();
+                surfaceTables.push_back(std::move(table));
+            }
+        }
+        return last->separable ? &last->offsets : nullptr;
+    }
+
+    // The last presented frame, the pages it was read from and the write stamp at that time.
+    PresentationFrame presentFrame;
+    GSPresentationRequest presentRequest{};
+    std::vector<uint16_t> presentPages;
+    uint64_t presentStamp = 0u;
+    bool presentReusable = false;
+    bool presentFieldMode = false;
+    uint32_t presentFieldPhase = 0u; // parity of the screen line of the picture's first row
+
+    // The run of primitives being drawn: its draw state and what was worked out from it.
+    struct Run
+    {
+        GSDrawState state{};
+        bool prepared = false; // the rest matches `state`
+        bool fast = false;     // DrawFastPrimitive draws it (the reference code otherwise)
+        RasterState rs;
+        Texture *texture = nullptr; // decoded copy of its texture, when it has one
+        bool indexed = false;
+        bool usesDepth = false;
+        // Settled once for the scissor rectangle: when false, no primitive of the run
+        // samples pages it draws to / has frame and depth pixels in the same pages.
+        bool mayFeedback = false;
+        bool mayShareDepth = false;
+        // Where the rasterizer threads find a copy of `rs`, and the texel buffers that
+        // copy points at (a texture whose buffers were replaced needs a new copy).
+        uint32_t shared = RasterWorkers::kNoState;
+        uint32_t serial = 0u; // for the pages it writes (FastState::pageWriteRun)
+        const uint32_t *sharedRgba = nullptr;
+        const uint8_t *sharedIndex = nullptr;
+        // The pages (as 64x32-pixel cells of the frame buffer) that queued primitives of
+        // the run have stamped as written and marked in flight: a primitive that stays
+        // inside them has no bookkeeping left to do. Valid for one cell generation.
+        uint64_t cellGeneration = 0u;
+        uint32_t cells[64] = {};
+
+        static uint32_t columnMask(const DrawRect &d)
+        {
+            const uint32_t x0 = static_cast<uint32_t>(d.x0) >> 6u;
+            const uint32_t x1 = static_cast<uint32_t>(d.x1) >> 6u;
+            return (0xFFFFFFFFu >> (31u - (x1 & 31u))) & (0xFFFFFFFFu << (x0 & 31u));
+        }
+
+        bool cellsCover(const DrawRect &d) const
+        {
+            const uint32_t mask = columnMask(d);
+            const uint32_t y1 = (static_cast<uint32_t>(d.y1) >> 5u) & 63u;
+            for (uint32_t y = (static_cast<uint32_t>(d.y0) >> 5u) & 63u; y <= y1; ++y)
+                if ((cells[y] & mask) != mask)
+                    return false;
+            return true;
+        }
+
+        void coverCells(const DrawRect &d, uint64_t generation)
+        {
+            if (cellGeneration != generation)
+            {
+                std::memset(cells, 0, sizeof(cells));
+                cellGeneration = generation;
+            }
+            const uint32_t mask = columnMask(d);
+            const uint32_t y1 = (static_cast<uint32_t>(d.y1) >> 5u) & 63u;
+            for (uint32_t y = (static_cast<uint32_t>(d.y0) >> 5u) & 63u; y <= y1; ++y)
+                cells[y] |= mask;
+        }
+    };
+    Run run;
+    // Starts again whenever the in-flight pages are forgotten (FinishRaster).
+    uint64_t cellGeneration = 1u;
+
+    // The texture and the texels the last PrepareTexels call set up, for DrawFastPrimitive.
+    Texture *preparedTexture = nullptr;
+    uint64_t preparedPreviousUseJob = 0u;
+    int preparedTexels[4][4] = {}; // x0, y0, x1, y1 of rectangles of the decoded copy
+    int preparedRects = 0;
+    uint64_t stamp = 1u;
+    // Bumped when a page that a cached texture reads is written.
+    uint64_t textureEpoch = 1u;
+
+    std::vector<std::unique_ptr<Texture>> textures;
+    Texture *lastTexture = nullptr;
+    size_t textureBytes = 0u;
+    uint64_t useClock = 0u;
+
+    // PS2X_GS_STATS=1: what reaches the backend, printed every two seconds.
+    bool stats = false;
+    uint64_t statPrims[8]{};
+    uint64_t statReference = 0u;
+    uint64_t statTransfers[4]{};
+    uint64_t statUploadBytes = 0u;
+    uint64_t statPixels = 0u;
+    uint64_t statRasterNs = 0u; // time spent drawing primitives on the thread that submits them
+    uint64_t workerPixelsSeen = 0u;
+    // Why the rasterizer threads had to be waited for, and what the texture cache did.
+    enum WaitReason
+    {
+        WaitTexture,  // a texture's pages are still being drawn to
+        WaitUpload,   // an upload into pages being drawn to
+        WaitTransfer, // local-to-host / local-to-local transfers read VRAM
+        WaitClut,
+        WaitFeedback, // a primitive that samples the buffer it draws into
+        WaitSurface,  // a primitive that reaches in-flight pages through another surface
+        WaitOther,
+        WaitReasons,
+    };
+    WaitReason waitReason = WaitOther;
+    uint64_t statWaits[WaitReasons]{};
+    uint64_t statWaitNs[WaitReasons]{};
+    uint64_t statTexturesInvalidated = 0u;
+    uint64_t statTilesDecoded = 0u;
+    uint64_t statDecodeNs = 0u;
+    uint64_t statUploads = 0u;
+    uint64_t statUploadsChanged = 0u;
+    uint64_t statInline = 0u;
+    uint64_t statQueuedDecodes = 0u;
+    uint64_t statSurfaceBarriers = 0u;
+    struct TextureStat
+    {
+        uint64_t tiles = 0u;
+        uint64_t decodes = 0u;
+    };
+    std::unordered_map<uint64_t, TextureStat> statTextures; // by tbp, psm and size
+    std::chrono::steady_clock::time_point statStart = std::chrono::steady_clock::now();
+
+    void printStatsIfDue()
+    {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - statStart < std::chrono::seconds(2))
+            return;
+        if (workers)
+        {
+            const uint64_t total = workers->pixels();
+            statPixels += total - workerPixelsSeen;
+            workerPixelsSeen = total;
+        }
+        std::fprintf(stderr, "[gs:stats] prims point=%llu line=%llu strip=%llu tri=%llu tstrip=%llu tfan=%llu sprite=%llu (reference %llu) "
+                             "transfers h2l=%llu l2h=%llu l2l=%llu upload=%llu KB textures=%zu | %.1f Mpix, %.1f ms on the EE thread (%.1f ns/pix)\n",
+                     static_cast<unsigned long long>(statPrims[0]), static_cast<unsigned long long>(statPrims[1]),
+                     static_cast<unsigned long long>(statPrims[2]), static_cast<unsigned long long>(statPrims[3]),
+                     static_cast<unsigned long long>(statPrims[4]), static_cast<unsigned long long>(statPrims[5]),
+                     static_cast<unsigned long long>(statPrims[6]), static_cast<unsigned long long>(statReference),
+                     static_cast<unsigned long long>(statTransfers[0]), static_cast<unsigned long long>(statTransfers[1]),
+                     static_cast<unsigned long long>(statTransfers[2]), static_cast<unsigned long long>(statUploadBytes / 1024u),
+                     textures.size(), statPixels / 1.0e6, statRasterNs / 1.0e6,
+                     statPixels ? static_cast<double>(statRasterNs) / static_cast<double>(statPixels) : 0.0);
+        std::fprintf(stderr, "[gs:stats] waits for the rasterizer: texture %llu (%.1f ms) upload %llu (%.1f ms) transfer %llu (%.1f ms) "
+                             "clut %llu (%.1f ms) feedback %llu (%.1f ms) surface %llu (%.1f ms) other %llu (%.1f ms) | "
+                             "textures invalidated %llu, "
+                             "tiles decoded %llu (%.1f ms, %llu decodes queued) | uploads %llu, %llu changed VRAM | "
+                             "%llu primitives drawn behind a barrier, %llu surface changes behind a barrier\n",
+                     static_cast<unsigned long long>(statWaits[WaitTexture]), statWaitNs[WaitTexture] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitUpload]), statWaitNs[WaitUpload] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitTransfer]), statWaitNs[WaitTransfer] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitClut]), statWaitNs[WaitClut] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitFeedback]), statWaitNs[WaitFeedback] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitSurface]), statWaitNs[WaitSurface] / 1.0e6,
+                     static_cast<unsigned long long>(statWaits[WaitOther]), statWaitNs[WaitOther] / 1.0e6,
+                     static_cast<unsigned long long>(statTexturesInvalidated),
+                     static_cast<unsigned long long>(statTilesDecoded), statDecodeNs / 1.0e6,
+                     static_cast<unsigned long long>(statQueuedDecodes),
+                     static_cast<unsigned long long>(statUploads), static_cast<unsigned long long>(statUploadsChanged),
+                     static_cast<unsigned long long>(statInline), static_cast<unsigned long long>(statSurfaceBarriers));
+        std::vector<std::pair<uint64_t, TextureStat>> busiest(statTextures.begin(), statTextures.end());
+        std::sort(busiest.begin(), busiest.end(), [](const auto &a, const auto &b)
+                  { return a.second.tiles > b.second.tiles; });
+        std::fprintf(stderr, "[gs:stats] most decoded textures (tbp psm size: tiles in decodes):");
+        for (size_t i = 0; i < busiest.size() && i < 10u; ++i)
+            std::fprintf(stderr, " | %llu %02llx %llux%llu: %llu in %llu", busiest[i].first >> 32, (busiest[i].first >> 24) & 0xFFu,
+                         (busiest[i].first >> 12) & 0xFFFu, busiest[i].first & 0xFFFu,
+                         static_cast<unsigned long long>(busiest[i].second.tiles),
+                         static_cast<unsigned long long>(busiest[i].second.decodes));
+        std::fprintf(stderr, "\n");
+        statTextures.clear();
+        std::fill(std::begin(statWaits), std::end(statWaits), 0u);
+        std::fill(std::begin(statWaitNs), std::end(statWaitNs), 0u);
+        statTexturesInvalidated = statTilesDecoded = statDecodeNs = statUploads = statUploadsChanged = statInline = 0u;
+        statQueuedDecodes = statSurfaceBarriers = 0u;
+        std::fill(std::begin(statPrims), std::end(statPrims), 0u);
+        std::fill(std::begin(statTransfers), std::end(statTransfers), 0u);
+        statReference = 0u;
+        statUploadBytes = 0u;
+        statPixels = 0u;
+        statRasterNs = 0u;
+        statStart = now;
+    }
+
+    uint32_t clutVersion = 1u;
+    bool paletteValid = false;
+    uint32_t paletteClutVersion = 0u;
+    GSTex0Reg paletteTex0{};
+    GSTexaReg paletteTexa{};
+    // Queued primitives read decode buffers and palettes directly. Whatever they may
+    // still read is set aside, tagged with the number of the last raster job that can
+    // refer to it, and reused once every worker has finished that job.
+    template <typename T>
+    struct Deferred
+    {
+        T item;
+        uint64_t freeAfter = 0u;
+    };
+
+    // Number of the raster job the primitive being prepared will become.
+    uint64_t nextJob() const { return workers ? workers->queued() + 1u : 0u; }
+    uint64_t completedJobs() const { return workers ? workers->completed() : ~0ull; }
+
+    // Expanded palettes.
+    using Palette = std::array<uint32_t, 256>;
+    std::unique_ptr<Palette> currentPalette = std::make_unique<Palette>();
+    uint64_t paletteUseJob = 0u;
+    uint32_t *palette = currentPalette->data();
+    std::vector<Deferred<std::unique_ptr<Palette>>> retiredPalettes;
+    std::vector<std::unique_ptr<Palette>> freePalettes;
+
+    // Textures evicted from the cache, and decode buffers of textures that changed.
+    std::vector<Deferred<std::unique_ptr<Texture>>> retiredTextures;
+    std::vector<Deferred<std::vector<uint32_t>>> pendingRgba;
+    std::vector<Deferred<std::vector<uint8_t>>> pendingIndex;
+    std::vector<std::vector<uint32_t>> freeRgba;
+    std::vector<std::vector<uint8_t>> freeIndex;
+    size_t deferredBytes = 0u;
+
+    template <typename T, typename Release>
+    static void reclaim(std::vector<Deferred<T>> &queue, uint64_t completed, Release &&release)
+    {
+        size_t kept = 0;
+        for (size_t i = 0; i < queue.size(); ++i)
+        {
+            if (queue[i].freeAfter <= completed)
+                release(std::move(queue[i].item));
+            else if (kept++ != i)
+                queue[kept - 1] = std::move(queue[i]);
+        }
+        queue.resize(kept);
+    }
+
+    // Moves everything the workers are done with back to the free pools.
+    void reclaimFinished(uint64_t completed)
+    {
+        constexpr size_t kMaxFree = 256u;
+        reclaim(pendingRgba, completed, [&](std::vector<uint32_t> &&buffer)
+                {
+                    deferredBytes -= buffer.size() * sizeof(uint32_t);
+                    if (freeRgba.size() < kMaxFree)
+                        freeRgba.push_back(std::move(buffer)); });
+        reclaim(pendingIndex, completed, [&](std::vector<uint8_t> &&buffer)
+                {
+                    deferredBytes -= buffer.size();
+                    if (freeIndex.size() < kMaxFree)
+                        freeIndex.push_back(std::move(buffer)); });
+        reclaim(retiredTextures, completed, [&](std::unique_ptr<Texture> &&texture)
+                { deferredBytes -= texture->bytes(); });
+        reclaim(retiredPalettes, completed, [&](std::unique_ptr<Palette> &&table)
+                {
+                    if (freePalettes.size() < kMaxFree)
+                        freePalettes.push_back(std::move(table)); });
+    }
+
+    template <typename T>
+    std::vector<T> takeBuffer(std::vector<std::vector<T>> &pool, size_t size)
+    {
+        for (int attempt = 0; attempt < 2; ++attempt)
+        {
+            for (size_t i = pool.size(); i-- > 0;)
+            {
+                if (pool[i].size() == size)
+                {
+                    std::vector<T> buffer = std::move(pool[i]);
+                    pool[i] = std::move(pool.back());
+                    pool.pop_back();
+                    return buffer;
+                }
+            }
+            if (attempt == 0)
+                reclaimFinished(completedJobs());
+        }
+        return std::vector<T>(size);
+    }
+
+    // Sets the texture's decode buffers aside and gives it others of the same size (its
+    // tiles are decoded again anyway).
+    void replaceBuffers(Texture &texture)
+    {
+        deferredBytes += texture.bytes();
+        if (!texture.rgba.empty())
+        {
+            const size_t size = texture.rgba.size();
+            pendingRgba.push_back({std::move(texture.rgba), texture.useJob});
+            texture.rgba = takeBuffer(freeRgba, size);
+        }
+        if (!texture.index.empty())
+        {
+            const size_t size = texture.index.size();
+            pendingIndex.push_back({std::move(texture.index), texture.useJob});
+            texture.index = takeBuffer(freeIndex, size);
+        }
+    }
+
+    void retireTexture(std::unique_ptr<Texture> texture)
+    {
+        deferredBytes += texture->bytes();
+        const uint64_t freeAfter = texture->useJob;
+        retiredTextures.push_back({std::move(texture), freeAfter});
+    }
+
+    // A palette buffer no queued primitive reads.
+    uint32_t *freshPalette()
+    {
+        retiredPalettes.push_back({std::move(currentPalette), paletteUseJob});
+        if (freePalettes.empty())
+            reclaimFinished(completedJobs());
+        if (freePalettes.empty())
+        {
+            currentPalette = std::make_unique<Palette>();
+        }
+        else
+        {
+            currentPalette = std::move(freePalettes.back());
+            freePalettes.pop_back();
+        }
+        return currentPalette->data();
+    }
+
+    // Created on the first draw (PS2X_GS_THREADS, 0 or 1 = draw inline).
+    // Declared last: the threads must stop before the textures they read go.
+    bool workersChecked = false;
+    std::unique_ptr<RasterWorkers> workers;
+};
+
+void GSCpuBackend::FinishRaster()
+{
+    if (m_fast && m_fast->workers)
+    {
+        if (m_fast->stats && m_fast->workers->completed() != m_fast->workers->queued())
+        {
+            const auto start = std::chrono::steady_clock::now();
+            m_fast->workers->wait();
+            ++m_fast->statWaits[m_fast->waitReason];
+            m_fast->statWaitNs[m_fast->waitReason] += static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+        }
+        m_fast->waitReason = FastState::WaitOther;
+        m_fast->workers->wait();
+        if (m_fast->anyInflight)
+        {
+            m_fast->inflightPages.fill(0u);
+            m_fast->inflightWritePages.fill(0u);
+            m_fast->inflightSurface.fill(0u);
+        }
+        m_fast->anyInflight = false;
+        ++m_fast->cellGeneration;
+        m_fast->doneSeen = m_fast->workers->queued();
+        m_fast->reclaimFinished(~0ull);
+    }
+}
+
+GSCpuBackend::~GSCpuBackend() = default;
+
+GSCpuBackend::GSCpuBackend()
+    : m_fast(std::make_unique<FastState>())
+{
+    using namespace GSMem;
+    const char *reference = std::getenv("PS2X_GS_REFERENCE");
+    m_fast->stats = std::getenv("PS2X_GS_STATS") != nullptr;
+    m_fast->reference = reference && reference[0] != '\0' && reference[0] != '0';
+    static std::once_flag lookupTablesOnce;
+    std::call_once(lookupTablesOnce, []()
+                   { InitLookupTables(); });
+    for (size_t i = 0; i < kPsmHandlerCount; ++i)
+    {
+        switch (i)
+        {
+        case GS_PSM_CT32:
+            m_readVramFuncs[i] = ReadCT32;
+            m_writeVramFuncs[i] = WriteCT32;
+            break;
+        case GS_PSM_CT24:
+            m_readVramFuncs[i] = ReadCT24;
+            m_writeVramFuncs[i] = WriteCT24;
+            break;
+        case GS_PSM_CT16:
+            m_readVramFuncs[i] = ReadCT16;
+            m_writeVramFuncs[i] = WriteCT16;
+            break;
+        case GS_PSM_CT16S:
+            m_readVramFuncs[i] = ReadCT16S;
+            m_writeVramFuncs[i] = WriteCT16S;
+            break;
+        case GS_PSM_T8:
+            m_readVramFuncs[i] = ReadP8;
+            m_writeVramFuncs[i] = WriteP8;
+            break;
+        case GS_PSM_T8H:
+            m_readVramFuncs[i] = ReadP8H;
+            m_writeVramFuncs[i] = WriteP8H;
+            break;
+        case GS_PSM_T4:
+            m_readVramFuncs[i] = ReadP4;
+            m_writeVramFuncs[i] = WriteP4;
+            break;
+        case GS_PSM_T4HH:
+            m_readVramFuncs[i] = ReadP4HH;
+            m_writeVramFuncs[i] = WriteP4HH;
+            break;
+        case GS_PSM_T4HL:
+            m_readVramFuncs[i] = ReadP4HL;
+            m_writeVramFuncs[i] = WriteP4HL;
+            break;
+        case GS_PSM_Z32:
+            m_readVramFuncs[i] = ReadZ32;
+            m_writeVramFuncs[i] = WriteZ32;
+            break;
+        case GS_PSM_Z24:
+            m_readVramFuncs[i] = ReadZ24;
+            m_writeVramFuncs[i] = WriteZ24;
+            break;
+        case GS_PSM_Z16:
+            m_readVramFuncs[i] = ReadZ16;
+            m_writeVramFuncs[i] = WriteZ16;
+            break;
+        case GS_PSM_Z16S:
+            m_readVramFuncs[i] = ReadZ16S;
+            m_writeVramFuncs[i] = WriteZ16S;
+            break;
+        default:
+            m_readVramFuncs[i] = ReadNull;
+            m_writeVramFuncs[i] = WriteNull;
+            break;
+        }
+    }
+    Reset();
+}
+
+void GSCpuBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    if (vram && vramSize < GSMem::MEMORY_SIZE)
+        throw std::invalid_argument("GS CPU backend requires at least 4 MiB of VRAM");
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_vram = vram;
+    m_vramSize = vramSize;
+    ResetUnlocked();
+}
+
+void GSCpuBackend::Reset()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    ResetUnlocked();
+}
+
+void GSCpuBackend::ResetUnlocked()
+{
+    FinishRaster();
+    m_clut.fill(0u);
+    m_clutCbp.fill(0u);
+    m_texturePageCache.Invalidate();
+    ++m_fast->clutVersion;
+    MarkAllVramWritten();
+    m_transfer = {};
+    m_transfer.direction = 3u;
+    m_transferState = {};
+    m_transferState.direction = 3u;
+    m_localToHostBuffer.clear();
+    m_localToHostReadPos = 0u;
+}
+
+void GSCpuBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || batch.vertexCount == 0u)
+        return;
+    FastState &fs = *m_fast;
+    if (!gsSameDrawState(fs.run.state, batch.state))
+    {
+        fs.run.state = batch.state;
+        fs.run.prepared = false;
+    }
+    const auto start = fs.stats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    DrawRunPrimitive(batch.vertices.data(), batch.vertexCount);
+    if (fs.stats)
+        fs.statRasterNs += static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+}
+
+void GSCpuBackend::SetDrawState(const GSDrawState &state)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_fast->run.state = state;
+    m_fast->run.prepared = false;
+}
+
+void GSCpuBackend::SubmitVertices(const GSVertex *vertices, uint32_t count)
+{
+    DrawPrimitives(vertices, 1u, count);
+}
+
+void GSCpuBackend::DrawPrimitives(const GSVertex *vertices, uint32_t primitives, uint32_t verticesEach)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || !vertices || verticesEach == 0u)
+        return;
+    FastState &fs = *m_fast;
+    const auto start = fs.stats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    for (uint32_t i = 0; i < primitives; ++i)
+        DrawRunPrimitive(vertices + static_cast<size_t>(i) * verticesEach, verticesEach);
+    if (fs.stats)
+        fs.statRasterNs += static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+}
+
+void GSCpuBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || (!isFourBitIndexedPsm(tex0.psm) && !isEightBitIndexedPsm(tex0.psm)))
+        return;
+
+    switch (tex0.cld)
+    {
+    case 0u:
+    case 6u:
+    case 7u:
+        return;
+    case 1u:
+        break;
+    case 2u:
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 3u:
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    case 4u:
+        if (m_clutCbp[0] == tex0.cbp)
+            return;
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (m_clutCbp[1] == tex0.cbp)
+            return;
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    default:
+        return;
+    }
+
+    LoadClutUnlocked(tex0, texclut);
+}
+
+void GSCpuBackend::LoadClutUnlocked(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    // Queued primitives read expanded palette copies, not the CLUT, but the CLUT is read
+    // from VRAM they may still be drawing to.
+    if (m_fast->touchesInflightWrite(tex0.cbp, 1u, tex0.cpsm, 0, 0, 15, 15))
+    {
+        m_fast->waitReason = FastState::WaitClut;
+        FinishRaster();
+    }
+    const bool fourBit = isFourBitIndexedPsm(tex0.psm);
+    const bool sixteenBit = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    const bool thirtyTwoBit = tex0.cpsm == GS_PSM_CT32 || tex0.cpsm == GS_PSM_CT24;
+    if (!sixteenBit && !thirtyTwoBit)
+        return;
+
+    const uint32_t entryCount = fourBit ? 16u : 256u;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t destinationBase = (static_cast<uint32_t>(tex0.csa) & csaMask) << 4u;
+
+    const bool loadCsm1Suffix = tex0.csm == 0u && thirtyTwoBit && !fourBit;
+    const uint32_t firstEntry = loadCsm1Suffix ? destinationBase : 0u;
+    ++m_fast->clutVersion;
+    m_fast->run.prepared = false; // its palette is of the CLUT as it was
+
+    for (uint32_t entry = firstEntry; entry < entryCount; ++entry)
+    {
+        uint32_t sourceX = 0u;
+        uint32_t sourceY = 0u;
+        uint32_t sourceWidth = 1u;
+
+        if (tex0.csm == 0u)
+        {
+            const uint32_t sourceIndex = swizzleClutIndexCSM1(entry);
+            sourceX = sourceIndex & 0x0Fu;
+            sourceY = sourceIndex >> 4u;
+        }
+        else
+        {
+            sourceWidth = texclut.cbw != 0u ? static_cast<uint32_t>(texclut.cbw) : 1u;
+            sourceX = (static_cast<uint32_t>(texclut.cou) << 4u) + entry;
+            sourceY = static_cast<uint32_t>(texclut.cov);
+        }
+
+        const uint32_t raw = ReadTextureVramUnlocked(tex0.cpsm, tex0.cbp, sourceWidth, sourceX, sourceY); 
+        const uint32_t destination = (loadCsm1Suffix ? entry : destinationBase + entry) & (sixteenBit ? 0x1FFu : 0x0FFu);
+        if (sixteenBit)
+        {
+            m_clut[destination] = static_cast<uint16_t>(raw);
+        }
+        else
+        {
+            m_clut[destination] = static_cast<uint16_t>(raw & 0xFFFFu);
+            m_clut[destination + 256u] = static_cast<uint16_t>(raw >> 16u);
+        }
+    }
+}
+
+void GSCpuBackend::Flush()
+{
+    // The rasterizer threads hear about queued primitives in batches while more keep
+    // coming; here they are told about whatever is left.
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_fast && m_fast->workers)
+        m_fast->workers->announce(true);
+}
+
+void GSCpuBackend::TextureFlush()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_texturePageCache.Invalidate();
+}
+
+void GSCpuBackend::Sync(GSSyncReason)
+{
+    // CPU backend is immediate. GPU backends may wait on fences/readbacks here.
+}
+
+uint32_t GSCpuBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_fast && m_fast->workers)
+        m_fast->workers->wait();
+    return ReadVramUnlocked(psm, base, bw, x, y);
+}
+
+uint32_t GSCpuBackend::ReadVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    if (!m_vram)
+        return 0u;
+    return m_readVramFuncs[psm & 0x3Fu](m_vram, base, bw, x, y);
+}
+
+uint32_t GSCpuBackend::ReadTextureVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+{
+    if (!m_vram)
+        return 0u;
+
+    return GSMem::ReadTexture(m_texturePageCache, m_vram, psm, base, bw, x, y);
+}
+
+void GSCpuBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    FinishRaster();
+    MarkVramWritten(base, bw, static_cast<uint8_t>(psm), static_cast<int>(x), static_cast<int>(y), static_cast<int>(x), static_cast<int>(y));
+    WriteVramUnlocked(psm, base, bw, x, y, value);
+}
+
+void GSCpuBackend::WriteVramUnlocked(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    if (!m_vram)
+        return;
+    m_writeVramFuncs[psm & 0x3Fu](m_vram, base, bw, x, y, value);
+}
+
+void GSCpuBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_fast && m_fast->workers)
+        m_fast->workers->wait();
+    if (!m_vram || m_vramSize == 0u)
+    {
+        out.clear();
+        return;
+    }
+    out.resize(m_vramSize);
+    std::memcpy(out.data(), m_vram, m_vramSize);
+}
+
+GSTransferSnapshot GSCpuBackend::GetTransferSnapshot() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    GSTransferSnapshot result = m_transferState;
+    result.localToHostPendingBytes = m_localToHostReadPos < m_localToHostBuffer.size()
+                                         ? m_localToHostBuffer.size() - m_localToHostReadPos
+                                         : 0u;
+    return result;
+}
+
+void GSCpuBackend::DrawRunPrimitive(const GSVertex *vertices, uint32_t vertexCount)
+{
+    FastState &fs = *m_fast;
+    FastState::Run &run = fs.run;
+    const GSDrawState &state = run.state;
+    const auto &ctx = state.context;
+    // The primitive with a copy of its state, for the code that draws one at a time.
+    const auto makeBatch = [&]()
+    {
+        GSPrimitiveBatch batch{};
+        batch.state = state;
+        batch.vertexCount = static_cast<uint8_t>(std::min<uint32_t>(vertexCount, 3u));
+        for (uint32_t i = 0; i < batch.vertexCount; ++i)
+            batch.vertices[i] = vertices[i];
+        return batch;
+    };
+    PS2_IF_AGRESSIVE_LOGS({
+        const GSPrimitiveBatch batch = makeBatch();
+        const uint32_t primitiveIndex = s_debugPrimitiveCount.fetch_add(1u, std::memory_order_relaxed);
+        if (primitiveIndex < 64u)
+        {
+            std::cout << "[gs:prim] idx=" << primitiveIndex
+                      << " type=" << static_cast<uint32_t>(state.prim.type)
+                      << " tme=" << static_cast<uint32_t>(state.prim.tme)
+                      << " abe=" << static_cast<uint32_t>(state.prim.abe)
+                      << " fst=" << static_cast<uint32_t>(state.prim.fst)
+                      << " ctxt=" << static_cast<uint32_t>(state.prim.ctxt)
+                      << " fbp=" << ctx.frame.fbp
+                      << " fbw=" << ctx.frame.fbw
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.frame.psm) << std::dec
+                      << " tex0=("
+                      << "tbp0=" << ctx.tex0.tbp0
+                      << " tbw=" << static_cast<uint32_t>(ctx.tex0.tbw)
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.psm) << std::dec
+                      << " tw=" << static_cast<uint32_t>(ctx.tex0.tw)
+                      << " th=" << static_cast<uint32_t>(ctx.tex0.th)
+                      << " tcc=" << static_cast<uint32_t>(ctx.tex0.tcc)
+                      << " tfx=" << static_cast<uint32_t>(ctx.tex0.tfx)
+                      << " cbp=" << ctx.tex0.cbp
+                      << " cpsm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.cpsm) << std::dec
+                      << " csm=" << static_cast<uint32_t>(ctx.tex0.csm)
+                      << " csa=" << static_cast<uint32_t>(ctx.tex0.csa)
+                      << ")"
+                      << " texclut=("
+                      << "cbw=" << static_cast<uint32_t>(state.texclut.cbw)
+                      << " cou=" << static_cast<uint32_t>(state.texclut.cou)
+                      << " cov=" << state.texclut.cov
+                      << ")"
+                      << " ofx=" << (ctx.xyoffset.ofx >> 4)
+                      << " ofy=" << (ctx.xyoffset.ofy >> 4)
+                      << " scissor=(" << ctx.scissor.x0
+                      << "," << ctx.scissor.y0
+                      << ")-(" << ctx.scissor.x1
+                      << "," << ctx.scissor.y1 << ")"
+                      << " test=0x" << std::hex << ctx.test
+                      << " alpha=0x" << ctx.alpha
+                      << std::dec
+                      << " v0=(" << batch.vertices[0].x << "," << batch.vertices[0].y << ")"
+                      << " uv0=(" << (batch.vertices[0].u >> 4) << "," << (batch.vertices[0].v >> 4) << ")"
+                      << " stq0=(" << batch.vertices[0].s << "," << batch.vertices[0].t << "," << batch.vertices[0].q << ")"
+                      << " v1=(" << batch.vertices[1].x << "," << batch.vertices[1].y << ")"
+                      << " uv1=(" << (batch.vertices[1].u >> 4) << "," << (batch.vertices[1].v >> 4) << ")"
+                      << " stq1=(" << batch.vertices[1].s << "," << batch.vertices[1].t << "," << batch.vertices[1].q << ")"
+                      << " v2=(" << batch.vertices[2].x << "," << batch.vertices[2].y << ")"
+                      << " uv2=(" << (batch.vertices[2].u >> 4) << "," << (batch.vertices[2].v >> 4) << ")"
+                      << " stq2=(" << batch.vertices[2].s << "," << batch.vertices[2].t << "," << batch.vertices[2].q << ")"
+                      << " rgba0=(" << static_cast<uint32_t>(batch.vertices[0].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[0].a) << ")"
+                      << " rgba1=(" << static_cast<uint32_t>(batch.vertices[1].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[1].a) << ")"
+                      << " rgba2=(" << static_cast<uint32_t>(batch.vertices[2].r) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].g) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].b) << ","
+                      << static_cast<uint32_t>(batch.vertices[2].a) << ")"
+                      << std::endl;
+        }
+    });
+
+    PS2_IF_AGRESSIVE_LOGS({
+        const GSPrimitiveBatch batch = makeBatch();
+        if ((state.prim.ctxt != 0u || ctx.frame.fbp == 150u) &&
+            s_debugContext1PrimitiveCount.fetch_add(1u, std::memory_order_relaxed) < 32u)
+        {
+            std::cout << "[gs:copy-prim]"
+                      << " type=" << static_cast<uint32_t>(state.prim.type)
+                      << " tme=" << static_cast<uint32_t>(state.prim.tme)
+                      << " abe=" << static_cast<uint32_t>(state.prim.abe)
+                      << " fst=" << static_cast<uint32_t>(state.prim.fst)
+                      << " ctxt=" << static_cast<uint32_t>(state.prim.ctxt)
+                      << " fbp=" << ctx.frame.fbp
+                      << " fbw=" << ctx.frame.fbw
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.frame.psm) << std::dec
+                      << " tex0=("
+                      << "tbp0=" << ctx.tex0.tbp0
+                      << " tbw=" << static_cast<uint32_t>(ctx.tex0.tbw)
+                      << " psm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.psm) << std::dec
+                      << " tcc=" << static_cast<uint32_t>(ctx.tex0.tcc)
+                      << " tfx=" << static_cast<uint32_t>(ctx.tex0.tfx)
+                      << " cbp=" << ctx.tex0.cbp
+                      << " cpsm=0x" << std::hex << static_cast<uint32_t>(ctx.tex0.cpsm) << std::dec
+                      << " csm=" << static_cast<uint32_t>(ctx.tex0.csm)
+                      << " csa=" << static_cast<uint32_t>(ctx.tex0.csa)
+                      << ")"
+                      << " texclut=("
+                      << "cbw=" << static_cast<uint32_t>(state.texclut.cbw)
+                      << " cou=" << static_cast<uint32_t>(state.texclut.cou)
+                      << " cov=" << state.texclut.cov
+                      << ")"
+                      << " ofx=" << (ctx.xyoffset.ofx >> 4)
+                      << " ofy=" << (ctx.xyoffset.ofy >> 4)
+                      << " scissor=(" << ctx.scissor.x0
+                      << "," << ctx.scissor.y0
+                      << ")-(" << ctx.scissor.x1
+                      << "," << ctx.scissor.y1 << ")"
+                      << " test=0x" << std::hex << ctx.test
+                      << " alpha=0x" << ctx.alpha
+                      << std::dec << std::endl;
+        }
+    });
+
+    if (fs.stats)
+    {
+        ++fs.statPrims[state.prim.type & 7u];
+        fs.printStatsIfDue();
+    }
+
+    // PS2X_GS_TRACE=<lines> [PS2X_GS_TRACE_AFTER=<seconds>]: one line per run
+    // of primitives drawn with the same state (debugging aid).
+    static int traceLines = []()
+    {
+        const char *env = std::getenv("PS2X_GS_TRACE");
+        return env ? std::atoi(env) : 0;
+    }();
+    if (traceLines > 0)
+    {
+        static const auto traceStart = std::chrono::steady_clock::now();
+        static const double traceAfter = []()
+        {
+            const char *env = std::getenv("PS2X_GS_TRACE_AFTER");
+            return env ? std::atof(env) : 0.0;
+        }();
+        static uint64_t lastKey = ~0ull;
+        static uint32_t runLength = 0u;
+        const uint64_t key = (static_cast<uint64_t>(state.prim.type) << 56) ^ (static_cast<uint64_t>(state.prim.tme) << 55) ^
+                             (static_cast<uint64_t>(state.prim.abe) << 54) ^ (static_cast<uint64_t>(ctx.frame.fbp) << 40) ^
+                             (static_cast<uint64_t>(ctx.zbuf.zbp) << 28) ^ (static_cast<uint64_t>(ctx.tex0.tbp0) << 12) ^
+                             ctx.alpha ^ (ctx.test << 7) ^ ctx.frame.fbmsk;
+        ++runLength;
+        if (key != lastKey &&
+            std::chrono::duration<double>(std::chrono::steady_clock::now() - traceStart).count() >= traceAfter)
+        {
+            --traceLines;
+            const GSVertex &v0 = vertices[0];
+            const GSVertex &v1 = vertices[vertexCount > 1u ? 1 : 0];
+            const GSVertex &v2 = vertices[vertexCount > 2u ? 2 : 0];
+            std::fprintf(stderr, "[gs:trace] (+%u) type=%u tme=%u fst=%u abe=%u frame=%u/%u/%02x msk=%08x zbuf=%u/%02x zmsk=%u test=%05llx alpha=%llx "
+                                 "tex=%u/%u/%02x %ux%u tfx=%u clut=%u ofs=%u,%u sc=%u,%u-%u,%u v0=(%.1f,%.1f z=%.0f) rgba=%u,%u,%u,%u v1=(%.1f,%.1f z=%.0f) v2=(%.1f,%.1f z=%.0f) stq0=(%g,%g,%g) uv0=(%u,%u) n=%u\n",
+                         runLength, state.prim.type, state.prim.tme, state.prim.fst, state.prim.abe, ctx.frame.fbp, ctx.frame.fbw,
+                         ctx.frame.psm, ctx.frame.fbmsk, ctx.zbuf.zbp, ctx.zbuf.psm, ctx.zbuf.zmask,
+                         static_cast<unsigned long long>(ctx.test), static_cast<unsigned long long>(ctx.alpha),
+                         ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, 1u << ctx.tex0.tw, 1u << ctx.tex0.th, ctx.tex0.tfx, ctx.tex0.cbp,
+                         ctx.xyoffset.ofx >> 4, ctx.xyoffset.ofy >> 4, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1,
+                         v0.x, v0.y, v0.z, v0.r, v0.g, v0.b, v0.a, v1.x, v1.y, v1.z, v2.x, v2.y, v2.z, v0.s, v0.t, v0.q, v0.u, v0.v,
+                         vertexCount);
+            runLength = 0u;
+        }
+        lastKey = key;
+    }
+
+    if (!run.prepared)
+        PrepareRun();
+    if (run.fast && vertexCount >= (run.rs.sprite ? 2u : 3u))
+    {
+        DrawFastPrimitive(vertices);
+        return;
+    }
+
+    // Reference path. Mark the scissor area written, which covers anything
+    // these primitives can draw.
+    const GSPrimitiveBatch batch = makeBatch();
+    ++fs.statReference;
+    const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    const uint32_t frameBase = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const uint32_t depthBase = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const auto markWritten = [&]()
+    {
+        MarkVramWritten(frameBase, fbw, ctx.frame.psm, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1);
+        if (!ctx.zbuf.zmask)
+            MarkVramWritten(depthBase, fbw, ctx.zbuf.psm, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1);
+    };
+    const bool pixelsOnly = state.prim.type == GS_PRIM_LINE || state.prim.type == GS_PRIM_LINESTRIP ||
+                            state.prim.type == GS_PRIM_POINT;
+    if (fs.workers && pixelsOnly)
+    {
+        // Lines and points only read and write the frame and depth buffers (no texture,
+        // no CLUT): one rasterizer thread draws them once all are through what came before,
+        // and the GS thread goes on. Later reads and writes of the pages wait for that.
+        markWritten();
+        const uint64_t job = fs.workers->submitBarrier([this, batch]()
+                                                       {
+                                      if (batch.state.prim.type == GS_PRIM_POINT)
+                                      {
+                                          const GSContext &c = batch.state.context;
+                                          const GSVertex &v = batch.vertices[0];
+                                          WritePixel(batch.state, static_cast<int>(v.x) - (c.xyoffset.ofx >> 4),
+                                                     static_cast<int>(v.y) - (c.xyoffset.ofy >> 4), static_cast<u32>(v.z), v.r, v.g,
+                                                     v.b, v.a, v.fog);
+                                      }
+                                      else
+                                      {
+                                          DrawLine(batch);
+                                      } });
+        const uint32_t serial = fs.newRun();
+        fs.runLastJob[serial & (FastState::kRunJobs - 1u)] = job;
+        fs.markPending(frameBase, fbw, ctx.frame.psm, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1, true,
+                       serial);
+        const uint32_t ztst = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        if (!ctx.zbuf.zmask || ztst >= 2u)
+            fs.markPending(depthBase, fbw, ctx.zbuf.psm, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1,
+                           !ctx.zbuf.zmask, serial);
+        return;
+    }
+    FinishRaster();
+    markWritten();
+
+    switch (state.prim.type)
+    {
+    case GS_PRIM_SPRITE:
+        DrawSprite(batch);
+        break;
+    case GS_PRIM_TRIANGLE:
+    case GS_PRIM_TRISTRIP:
+    case GS_PRIM_TRIFAN:
+        DrawTriangle(batch);
+        break;
+    case GS_PRIM_LINE:
+    case GS_PRIM_LINESTRIP:
+        DrawLine(batch);
+        break;
+    case GS_PRIM_POINT:
+    {
+        const GSVertex &v = batch.vertices[0];
+        int px = static_cast<int>(v.x) - (ctx.xyoffset.ofx >> 4);
+        int py = static_cast<int>(v.y) - (ctx.xyoffset.ofy >> 4);
+        WritePixel(state, px, py, static_cast<u32>(v.z), v.r, v.g, v.b, v.a, v.fog);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+void GSCpuBackend::WritePixel(const GSDrawState &state, int x, int y, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    if (x < ctx.scissor.x0 || x > ctx.scissor.x1 || y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return;
+
+    // SCANMSK: 2 leaves the even rows alone, 3 the odd ones.
+    const uint32_t scanmsk = static_cast<uint32_t>(state.scanmsk) & 3u;
+    if (scanmsk >= 2u && ((static_cast<uint32_t>(y) ^ scanmsk) & 1u) == 0u)
+        return;
+
+    if (state.prim.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+        {
+            return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+        };
+
+        r = applyFog(r, state.fogR);
+        g = applyFog(g, state.fogG);
+        b = applyFog(b, state.fogB);
+    }
+
+    const u32 fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const u32 fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    const u32 fpsm = ctx.frame.psm;
+    const u32 zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const u32 zpsm = ctx.zbuf.psm;
+
+    const PixelWriteMask writeMask = classifyAlphaTest(ctx.test, a, static_cast<uint8_t>(fpsm));
+    if (!writeMask.writesAnything())
+    {
+        return;
+    }
+
+    const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    const bool alphaBlendEnabled = state.prim.abe;
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && fpsm == GS_PSM_CT32;
+    const bool destinationAlphaTestNeedsRead = ((ctx.test >> 14) & 0x1u) != 0u && (fpsm == GS_PSM_CT32 || fpsm == GS_PSM_CT16 || fpsm == GS_PSM_CT16S);
+
+    // small optimization, avoid reading the framebuffer for simple draws
+    // TODO: only one address lookup for rmw
+    const bool frmw = destinationAlphaTestNeedsRead || (writeMask.writesFramebuffer() && ((ctx.frame.fbmsk != 0) || alphaBlendEnabled || preserveDestinationAlpha));
+
+    u32 rawFramebufferPixel = 0;
+    u32 fbrgba = 0;
+    if (frmw)
+    {
+        rawFramebufferPixel = ReadVramUnlocked(fpsm, fbp, fbw, x, y);
+        fbrgba = rawFramebufferPixel;
+
+        if (bitsPerPixel(fpsm) == 16)
+        {
+            fbrgba = Rgba5551ToRgba8888(fbrgba);
+        }
+        else if (fpsm == GS_PSM_CT24)
+        {
+            // The GS supplies 0x80 as destination alpha for RGB24 blending.
+            fbrgba |= 0x80000000u;
+        }
+    }
+
+    if (!passesDestinationAlphaTest(ctx.test, static_cast<uint8_t>(fpsm), rawFramebufferPixel))
+    {
+        return;
+    }
+
+    bool zpass = false;
+    uint32_t storedZ = 0u;
+    switch (ztestMethod)
+    {
+    case 0:
+        zpass = false;
+        break;
+    case 1:
+        zpass = true;
+        break;
+    case 2:
+        storedZ = ReadVramUnlocked(zpsm, zbp, fbw, x, y);
+        zpass = static_cast<uint32_t>(z) >= storedZ;
+        break;
+    case 3:
+        storedZ = ReadVramUnlocked(zpsm, zbp, fbw, x, y);
+        zpass = static_cast<uint32_t>(z) > storedZ;
+        break;
+    }
+
+    if (!zpass)
+    {
+        return;
+    }
+
+    if (writeMask.writesFramebuffer())
+    {
+        const u8 srcR = r;
+        const u8 srcG = g;
+        const u8 srcB = b;
+
+        if (state.prim.abe)
+        {
+            uint8_t dr = fbrgba & 0xFF;
+            uint8_t dg = (fbrgba >> 8) & 0xFF;
+            uint8_t db = (fbrgba >> 16) & 0xFF;
+            uint8_t da = (fbrgba >> 24) & 0xFF;
+
+            // PABE disables alpha blending when the source alpha MSB is clear.
+            if (!(state.pabe && (a & 0x80u) == 0u))
+            {
+                uint64_t alphaReg = ctx.alpha;
+                uint8_t asel = alphaReg & 3;
+                uint8_t bsel = (alphaReg >> 2) & 3;
+                uint8_t csel = (alphaReg >> 4) & 3;
+                uint8_t dsel = (alphaReg >> 6) & 3;
+                uint8_t fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+
+                auto pickRGB = [&](uint8_t sel, int cs, int cd) -> int
+                {
+                    if (sel == 0)
+                        return cs;
+                    if (sel == 1)
+                        return cd;
+                    return 0;
+                };
+                int cAlpha = (csel == 0) ? a : (csel == 1) ? da
+                                                           : fix;
+
+                r = clampU8(((pickRGB(asel, r, dr) - pickRGB(bsel, r, dr)) * cAlpha >> 7) + pickRGB(dsel, r, dr));
+                g = clampU8(((pickRGB(asel, g, dg) - pickRGB(bsel, g, dg)) * cAlpha >> 7) + pickRGB(dsel, g, dg));
+                b = clampU8(((pickRGB(asel, b, db) - pickRGB(bsel, b, db)) * cAlpha >> 7) + pickRGB(dsel, b, db));
+            }
+            else
+            {
+                r = srcR;
+                g = srcG;
+                b = srcB;
+            }
+        }
+
+        if (writeMask.writeAlpha && (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24)
+        {
+            a = static_cast<uint8_t>(a | 0x80u);
+        }
+
+        u32 pixel = pack32(r, g, b, a);
+
+        if (ctx.frame.fbmsk != 0)
+        {
+            pixel = (pixel & ~ctx.frame.fbmsk) | (fbrgba & ctx.frame.fbmsk);
+        }
+
+        if (preserveDestinationAlpha)
+        {
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        }
+
+        // format conversion
+        if (bitsPerPixel(fpsm) == 16)
+        {
+            pixel = Rgba8888ToRgba5551(pixel);
+        }
+
+        WriteVramUnlocked(fpsm, fbp, fbw, x, y, pixel);
+    }
+
+    if (writeMask.writeDepth && !ctx.zbuf.zmask)
+    {
+        WriteVramUnlocked(zpsm, zbp, fbw, x, y, z);
+    }
+}
+
+uint32_t GSCpuBackend::LookupCLUT(const GSTexaReg &texa,
+                                  uint8_t index,
+                                  uint8_t cpsm,
+                                  uint8_t csm,
+                                  uint8_t csa,
+                                  uint8_t sourcePsm)
+{
+    const bool sixteenBit = cpsm == GS_PSM_CT16 || cpsm == GS_PSM_CT16S;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t clutBase = (static_cast<uint32_t>(csa) & csaMask) << 4u;
+    const uint32_t sourceIndex = isFourBitIndexedPsm(sourcePsm)
+                                     ? (static_cast<uint32_t>(index) & 0x0Fu)
+                                     : static_cast<uint32_t>(index);
+
+    uint32_t clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && csm == 0u && isEightBitIndexedPsm(sourcePsm))
+    {
+        const uint32_t block = std::min((sourceIndex & 0xF0u) + clutBase, 240u);
+        clutIndex = block + (sourceIndex & 0x0Fu);
+    }
+
+    switch (cpsm)
+    {
+    case GS_PSM_CT32:
+    {
+        const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+        return applyTexa(texa, cpsm, raw);
+    }
+    case GS_PSM_CT24:
+    {
+        const uint32_t raw = static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u);
+        return applyTexa(texa, cpsm, raw & 0x00FFFFFFu);
+    }
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+        return applyTexa(texa, cpsm, Rgba5551ToRgba8888(m_clut[clutIndex]));
+    default:
+        break;
+    }
+
+    return 0xFFFF00FFu;
+}
+
+uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t, float q, uint16_t u, uint16_t v)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    const uint8_t wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    const uint16_t maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    const uint16_t maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+
+    float texUf, texVf;
+    if (state.prim.fst)
+    {
+        texUf = static_cast<float>(u) / 16.0f;
+        texVf = static_cast<float>(v) / 16.0f;
+    }
+    else
+    {
+        const float invQ = 1.0f / fabsQ(q);
+        texUf = s * invQ * static_cast<float>(texW);
+        texVf = t * invQ * static_cast<float>(texH);
+    }
+
+    auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+    {
+        sampleU = wrapTextureCoordinate(sampleU, texW, wrapU, minU, maxU);
+        sampleV = wrapTextureCoordinate(sampleV, texH, wrapV, minV, maxV);
+
+        u32 out = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, sampleU, sampleV);
+
+        switch (tex.psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32:
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+            return applyTexa(state.texa, tex.psm, out);
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(out));
+        case GS_PSM_T8:
+        case GS_PSM_T8H:
+        case GS_PSM_T4:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            return LookupCLUT(state.texa, static_cast<u8>(out), tex.cpsm, tex.csm, tex.csa, tex.psm);
+        }
+
+        return 0xFFFF00FFu;
+    };
+
+    if (!state.linearFilter)
+    {
+        return samplePoint(static_cast<int>(texUf), static_cast<int>(texVf));
+    }
+
+    const float sampleU = texUf - 0.5f;
+    const float sampleV = texVf - 0.5f;
+    const int u0 = static_cast<int>(std::floor(sampleU));
+    const int v0 = static_cast<int>(std::floor(sampleV));
+    const int u1 = u0 + 1;
+    const int v1 = v0 + 1;
+    const float fx = sampleU - static_cast<float>(u0);
+    const float fy = sampleV - static_cast<float>(v0);
+
+    const uint32_t c00 = samplePoint(u0, v0);
+    const uint32_t c10 = samplePoint(u1, v0);
+    const uint32_t c01 = samplePoint(u0, v1);
+    const uint32_t c11 = samplePoint(u1, v1);
+
+    const uint8_t r = lerpChannel(static_cast<uint8_t>(c00 & 0xFFu),
+                                  static_cast<uint8_t>(c10 & 0xFFu),
+                                  static_cast<uint8_t>(c01 & 0xFFu),
+                                  static_cast<uint8_t>(c11 & 0xFFu),
+                                  fx, fy);
+    const uint8_t g = lerpChannel(static_cast<uint8_t>((c00 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 8) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 8) & 0xFFu),
+                                  fx, fy);
+    const uint8_t b = lerpChannel(static_cast<uint8_t>((c00 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 16) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 16) & 0xFFu),
+                                  fx, fy);
+    const uint8_t a = lerpChannel(static_cast<uint8_t>((c00 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c10 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c01 >> 24) & 0xFFu),
+                                  static_cast<uint8_t>((c11 >> 24) & 0xFFu),
+                                  fx, fy);
+
+    return static_cast<uint32_t>(r) |
+           (static_cast<uint32_t>(g) << 8) |
+           (static_cast<uint32_t>(b) << 16) |
+           (static_cast<uint32_t>(a) << 24);
+}
+
+void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    int x0 = static_cast<int>(v0.x) - ofx;
+    int y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx;
+    int y1 = static_cast<int>(v1.y) - ofy;
+    u32 z1 = static_cast<u32>(v1.z);
+
+    if (x0 > x1)
+        std::swap(x0, x1);
+    if (y0 > y1)
+        std::swap(y0, y1);
+
+    const int unclippedX0 = x0;
+    const int unclippedY0 = y0;
+    const int spanX = std::max(1, x1 - x0);
+    const int spanY = std::max(1, y1 - y0);
+    const int unclippedX1 = unclippedX0 + spanX - 1;
+    const int unclippedY1 = unclippedY0 + spanY - 1;
+
+    // If the sprite rectangle is fully outside scissor, nothing should render.
+    if (unclippedX1 < ctx.scissor.x0 || unclippedX0 > ctx.scissor.x1 ||
+        unclippedY1 < ctx.scissor.y0 || unclippedY0 > ctx.scissor.y1)
+        return;
+
+    const int drawX0 = clampInt(unclippedX0, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY0 = clampInt(unclippedY0, ctx.scissor.y0, ctx.scissor.y1);
+    const int drawX1 = clampInt(unclippedX1, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY1 = clampInt(unclippedY1, ctx.scissor.y0, ctx.scissor.y1);
+
+    const uint64_t alphaReg = ctx.alpha;
+    const uint8_t alphaMode = static_cast<uint8_t>(alphaReg & 0xFFu);
+    const uint8_t alphaFix = static_cast<uint8_t>((alphaReg >> 32) & 0xFFu);
+
+    uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a;
+
+    if (state.prim.tme)
+    {
+        const auto &tex = ctx.tex0;
+        const int texW = state.textureWidth;
+        const int texH = state.textureHeight;
+
+        float u0f, v0f, u1f, v1f;
+        if (state.prim.fst)
+        {
+            u0f = static_cast<float>(v0.u >> 4);
+            v0f = static_cast<float>(v0.v >> 4);
+            u1f = static_cast<float>(v1.u >> 4);
+            v1f = static_cast<float>(v1.v >> 4);
+        }
+        else
+        {
+            const float q0 = fabsQ(v0.q);
+            const float q1 = fabsQ(v1.q);
+            u0f = (v0.s / q0) * static_cast<float>(texW);
+            v0f = (v0.t / q0) * static_cast<float>(texH);
+            u1f = (v1.s / q1) * static_cast<float>(texW);
+            v1f = (v1.t / q1) * static_cast<float>(texH);
+        }
+
+        float spriteW = static_cast<float>(spanX);
+        float spriteH = static_cast<float>(spanY);
+        if (spriteW < 1.0f)
+            spriteW = 1.0f;
+        if (spriteH < 1.0f)
+            spriteH = 1.0f;
+
+        for (int y = drawY0; y <= drawY1; ++y)
+        {
+            float ty = (static_cast<float>(y - unclippedY0) + 0.5f) / spriteH;
+            float texVf = v0f + (v1f - v0f) * ty;
+
+            for (int x = drawX0; x <= drawX1; ++x)
+            {
+                float tx = (static_cast<float>(x - unclippedX0) + 0.5f) / spriteW;
+                float texUf = u0f + (u1f - u0f) * tx;
+                uint32_t texel = 0xFFFF00FFu;
+                if (state.prim.fst)
+                {
+                    const int fixedU = static_cast<int>((texUf * 16.0f) + 0.5f);
+                    const int fixedV = static_cast<int>((texVf * 16.0f) + 0.5f);
+                    const uint16_t sampleU = static_cast<uint16_t>(clampInt(fixedU, 0, 0xFFFF));
+                    const uint16_t sampleV = static_cast<uint16_t>(clampInt(fixedV, 0, 0xFFFF));
+                    texel = SampleTexture(state, 0.0f, 0.0f, 1.0f, sampleU, sampleV);
+                }
+                else
+                {
+                    texel = SampleTexture(state, texUf / static_cast<float>(texW), texVf / static_cast<float>(texH), 1.0f, 0u, 0u);
+                }
+
+                uint8_t tr = static_cast<uint8_t>(texel & 0xFF);
+                uint8_t tg = static_cast<uint8_t>((texel >> 8) & 0xFF);
+                uint8_t tb = static_cast<uint8_t>((texel >> 16) & 0xFF);
+                uint8_t ta = static_cast<uint8_t>((texel >> 24) & 0xFF);
+
+                const TextureCombineResult color = combineTexture(tex, r, g, b, a, tr, tg, tb, ta);
+                WritePixel(state, x, y, z1, color.r, color.g, color.b, color.a, v1.fog);
+            }
+        }
+    }
+    else
+    {
+        for (int y = drawY0; y <= drawY1; ++y)
+            for (int x = drawX0; x <= drawX1; ++x)
+                WritePixel(state, x, y, z1, r, g, b, a, v1.fog);
+    }
+}
+
+void GSCpuBackend::DrawTriangle(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    float fx0 = v0.x - static_cast<float>(ofx);
+    float fy0 = v0.y - static_cast<float>(ofy);
+    float fx1 = v1.x - static_cast<float>(ofx);
+    float fy1 = v1.y - static_cast<float>(ofy);
+    float fx2 = v2.x - static_cast<float>(ofx);
+    float fy2 = v2.y - static_cast<float>(ofy);
+
+    int minX = static_cast<int>(std::floor(std::min({fx0, fx1, fx2})));
+    int maxX = static_cast<int>(std::ceil(std::max({fx0, fx1, fx2})));
+    int minY = static_cast<int>(std::floor(std::min({fy0, fy1, fy2})));
+    int maxY = static_cast<int>(std::ceil(std::max({fy0, fy1, fy2})));
+
+    minX = clampInt(minX, ctx.scissor.x0, ctx.scissor.x1);
+    maxX = clampInt(maxX, ctx.scissor.x0, ctx.scissor.x1);
+    minY = clampInt(minY, ctx.scissor.y0, ctx.scissor.y1);
+    maxY = clampInt(maxY, ctx.scissor.y0, ctx.scissor.y1);
+
+    float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+    if (std::fabs(denom) < 0.001f)
+        return;
+
+    const float winding = (denom < 0.0f) ? -1.0f : 1.0f;
+    const float invAbsDenom = 1.0f / std::fabs(denom);
+    constexpr float kEdgeEpsilon = 1.0e-4f;
+
+    for (int y = minY; y <= maxY; ++y)
+    {
+        float py = static_cast<float>(y) + 0.5f;
+        for (int x = minX; x <= maxX; ++x)
+        {
+            float px = static_cast<float>(x) + 0.5f;
+
+            float w0 = (((fy1 - fy2) * (px - fx2) + (fx2 - fx1) * (py - fy2)) * winding) * invAbsDenom;
+            float w1 = (((fy2 - fy0) * (px - fx2) + (fx0 - fx2) * (py - fy2)) * winding) * invAbsDenom;
+            float w2 = 1.0f - w0 - w1;
+
+            if (w0 < -kEdgeEpsilon || w1 < -kEdgeEpsilon || w2 < -kEdgeEpsilon)
+                continue;
+
+            double z = v0.z * w0 + v1.z * w1 + v2.z * w2;
+
+            uint8_t r, g, b, a;
+            if (state.prim.iip)
+            {
+                r = clampU8(static_cast<int>(v0.r * w0 + v1.r * w1 + v2.r * w2));
+                g = clampU8(static_cast<int>(v0.g * w0 + v1.g * w1 + v2.g * w2));
+                b = clampU8(static_cast<int>(v0.b * w0 + v1.b * w1 + v2.b * w2));
+                a = clampU8(static_cast<int>(v0.a * w0 + v1.a * w1 + v2.a * w2));
+            }
+            else
+            {
+                r = v2.r;
+                g = v2.g;
+                b = v2.b;
+                a = v2.a;
+            }
+
+            if (state.prim.tme)
+            {
+                float is, it, iq;
+                uint16_t iu, iv;
+                if (state.prim.fst)
+                {
+                    iu = static_cast<uint16_t>(v0.u * w0 + v1.u * w1 + v2.u * w2);
+                    iv = static_cast<uint16_t>(v0.v * w0 + v1.v * w1 + v2.v * w2);
+                    is = 0.0f;
+                    it = 0.0f;
+                    iq = 1.0f;
+                }
+                else
+                {
+                    // The GS DDA interpolates the homogeneous S, T and Q
+                    // values. Texel coordinates are calculated from S/Q and
+                    // T/Q only after interpolation.
+                    is = v0.s * w0 + v1.s * w1 + v2.s * w2;
+                    it = v0.t * w0 + v1.t * w1 + v2.t * w2;
+                    iq = v0.q * w0 + v1.q * w1 + v2.q * w2;
+                    iu = 0;
+                    iv = 0;
+                }
+
+                uint32_t texel = SampleTexture(state, is, it, iq, iu, iv);
+
+                uint8_t tr = static_cast<uint8_t>(texel & 0xFF);
+                uint8_t tg = static_cast<uint8_t>((texel >> 8) & 0xFF);
+                uint8_t tb = static_cast<uint8_t>((texel >> 16) & 0xFF);
+                uint8_t ta = static_cast<uint8_t>((texel >> 24) & 0xFF);
+
+                const auto &tex = ctx.tex0;
+                const uint8_t shadeR = r;
+                const uint8_t shadeG = g;
+                const uint8_t shadeB = b;
+                const uint8_t shadeA = a;
+                const TextureCombineResult color = combineTexture(tex, shadeR, shadeG, shadeB, shadeA, tr, tg, tb, ta);
+
+                r = color.r;
+                g = color.g;
+                b = color.b;
+                a = color.a;
+            }
+
+            const uint8_t fog = clampU8(static_cast<int>(v0.fog * w0 + v1.fog * w1 + v2.fog * w2));
+            WritePixel(state, x, y, static_cast<u32>(z + 0.5), r, g, b, a, fog);
+        }
+    }
+}
+
+void GSCpuBackend::DrawLine(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    int x0 = static_cast<int>(v0.x) - ofx;
+    int y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx;
+    int y1 = static_cast<int>(v1.y) - ofy;
+
+    int dx = std::abs(x1 - x0);
+    int dy = -std::abs(y1 - y0);
+    int sx = (x0 < x1) ? 1 : -1;
+    int sy = (y0 < y1) ? 1 : -1;
+    int err = dx + dy;
+
+    int totalSteps = std::max(std::abs(x1 - x0), std::abs(y1 - y0));
+    if (totalSteps == 0)
+        totalSteps = 1;
+    int step = 0;
+
+    for (;;)
+    {
+        float t = static_cast<float>(step) / static_cast<float>(totalSteps);
+        uint8_t r, g, b, a;
+        if (state.prim.iip)
+        {
+            r = clampU8(static_cast<int>(v0.r + (v1.r - v0.r) * t));
+            g = clampU8(static_cast<int>(v0.g + (v1.g - v0.g) * t));
+            b = clampU8(static_cast<int>(v0.b + (v1.b - v0.b) * t));
+            a = clampU8(static_cast<int>(v0.a + (v1.a - v0.a) * t));
+        }
+        else
+        {
+            r = v1.r;
+            g = v1.g;
+            b = v1.b;
+            a = v1.a;
+        }
+
+        double z = (v0.z + (v1.z - v0.z) * t);
+        const uint8_t fog = clampU8(static_cast<int>(v0.fog + (v1.fog - v0.fog) * t));
+        WritePixel(state, x0, y0, static_cast<u32>(z), r, g, b, a, fog);
+
+        if (x0 == x1 && y0 == y1)
+            break;
+
+        int e2 = 2 * err;
+        if (e2 >= dy)
+        {
+            err += dy;
+            x0 += sx;
+        }
+        if (e2 <= dx)
+        {
+            err += dx;
+            y0 += sy;
+        }
+        ++step;
+    }
+}
+
+void GSCpuBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (command.direction != 0u) // host-to-local uploads check for conflicts in UploadImage
+    {
+        m_fast->waitReason = FastState::WaitTransfer;
+        FinishRaster();
+    }
+    m_transfer = command;
+    m_transferState.x = command.trxpos.dsax;
+    m_transferState.y = command.trxpos.dsay;
+    m_transferState.totalPixels = static_cast<uint32_t>(command.trxreg.rrw) * static_cast<uint32_t>(command.trxreg.rrh);
+    m_transferState.copiedPixels = 0u;
+    m_transferState.direction = command.direction;
+    m_transferState.localToHostPendingBytes = 0u;
+    ++m_fast->statTransfers[command.direction & 3u];
+    if (m_fast->stats)
+        m_fast->printStatsIfDue();
+
+    if (command.direction == 2u)
+        PerformLocalToLocalTransfer();
+    else if (command.direction == 1u)
+        PerformLocalToHostTransfer();
+}
+
+void GSCpuBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!data || sizeBytes == 0u || !m_vram || m_transferState.direction != 0u)
+        return;
+    if (m_transfer.trxreg.rrw == 0u || m_transfer.trxreg.rrh == 0u || m_transferState.totalPixels == 0u)
+        return;
+    m_fast->statUploadBytes += sizeBytes;
+    const uint32_t uploadBp = m_transfer.bitbltbuf.dbp;
+    const uint32_t uploadBw = std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u);
+    const uint8_t uploadPsm = m_transfer.bitbltbuf.dpsm;
+    const int uploadX0 = static_cast<int>(m_transfer.trxpos.dsax);
+    const int uploadY0 = static_cast<int>(m_transfer.trxpos.dsay);
+    const int uploadX1 = static_cast<int>(m_transfer.trxpos.dsax + m_transfer.trxreg.rrw) - 1;
+    const int uploadY1 = static_cast<int>(m_transfer.trxpos.dsay + m_transfer.trxreg.rrh) - 1;
+    // Queued primitives sample decoded copies of textures, not VRAM, so they only
+    // conflict with an upload into the frame/Z pages they draw to.
+    if (m_fast->touchesInflight(uploadBp, uploadBw, uploadPsm, uploadX0, uploadY0, uploadX1, uploadY1))
+    {
+        m_fast->waitReason = FastState::WaitUpload;
+        FinishRaster();
+    }
+
+    // PS2X_GS_DUMP_UPLOADS=1: save the payload of the first upload to each
+    // destination to runs/gs_uploads/ (debugging aid).
+    static const bool dumpUploads = std::getenv("PS2X_GS_DUMP_UPLOADS") != nullptr;
+    static std::vector<uint8_t> dumpPayload;
+    static std::vector<uint32_t> dumpedKeys;
+    if (dumpUploads)
+    {
+        if (m_transferState.copiedPixels == 0u)
+            dumpPayload.clear();
+        dumpPayload.insert(dumpPayload.end(), data, data + sizeBytes);
+    }
+    struct DumpOnExit
+    {
+        GSCpuBackend *self;
+        ~DumpOnExit()
+        {
+            if (!dumpUploads || self->m_transferState.direction != 3u)
+                return;
+            const GSTransferCommand &t = self->m_transfer;
+            const uint32_t key = t.bitbltbuf.dbp | (static_cast<uint32_t>(t.bitbltbuf.dpsm) << 24);
+            if (std::find(dumpedKeys.begin(), dumpedKeys.end(), key) != dumpedKeys.end() || dumpedKeys.size() >= 200u)
+                return;
+            dumpedKeys.push_back(key);
+            char name[128];
+            std::snprintf(name, sizeof(name), "runs/gs_uploads/up_%05u_psm%02x_dbw%u_%ux%u.bin", t.bitbltbuf.dbp,
+                          t.bitbltbuf.dpsm, t.bitbltbuf.dbw, t.trxreg.rrw, t.trxreg.rrh);
+            if (std::FILE *file = std::fopen(name, "wb"))
+            {
+                std::fwrite(dumpPayload.data(), 1, dumpPayload.size(), file);
+                std::fclose(file);
+            }
+        }
+    } dumpOnExit{this};
+
+    const uint32_t dbp = m_transfer.bitbltbuf.dbp;
+    const uint32_t dbw = std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u);
+    const uint8_t dpsm = m_transfer.bitbltbuf.dpsm;
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t dsax = m_transfer.trxpos.dsax;
+    uint32_t offset = 0u;
+
+    // Only a write that changes VRAM invalidates cached textures (and the pages are
+    // stamped once this call is done, whichever way it returns).
+    struct StampIfChanged
+    {
+        GSCpuBackend *self;
+        bool changed = false;
+        uint32_t bp, bw;
+        uint8_t psm;
+        int x0, y0, x1, y1;
+        ~StampIfChanged()
+        {
+            ++self->m_fast->statUploads;
+            if (changed)
+            {
+                ++self->m_fast->statUploadsChanged;
+                self->MarkVramWritten(bp, bw, psm, x0, y0, x1, y1);
+            }
+        }
+    } stamp{this, false, uploadBp, uploadBw, uploadPsm, uploadX0, uploadY0, uploadX1, uploadY1};
+
+    auto advancePixel = [&](uint32_t count)
+    {
+        const uint32_t totalPixels = m_transferState.totalPixels;
+        m_transferState.copiedPixels =
+            std::min<uint32_t>(totalPixels, m_transferState.copiedPixels + count);
+
+        if (m_transferState.copiedPixels >= totalPixels)
+        {
+            m_transferState.direction = 3u;
+            m_transferState.totalPixels = 0u;
+            return;
+        }
+
+        m_transferState.x = dsax + (m_transferState.copiedPixels % rrw);
+        m_transferState.y = m_transfer.trxpos.dsay + (m_transferState.copiedPixels / rrw);
+    };
+
+    // The whole pixels this call brings (a partial one at the end is dropped, as before),
+    // row by row with the format's addressing inlined.
+    if (offset >= sizeBytes || m_transferState.direction != 0u)
+        return;
+    const uint32_t remaining = m_transferState.totalPixels - m_transferState.copiedPixels;
+    const uint32_t bytes = sizeBytes - offset;
+    uint32_t bitsPerPixel = 0u;
+    switch (dpsm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+        bitsPerPixel = 32u;
+        break;
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        bitsPerPixel = 24u;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        bitsPerPixel = 16u;
+        break;
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+        bitsPerPixel = 8u;
+        break;
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        bitsPerPixel = 4u;
+        break;
+    default:
+        return;
+    }
+    const uint32_t pixels = std::min<uint32_t>(
+        remaining, bitsPerPixel == 4u ? bytes * 2u : static_cast<uint32_t>(static_cast<uint64_t>(bytes) * 8u / bitsPerPixel));
+    if (pixels == 0u)
+        return;
+    uint32_t x = m_transferState.x;
+    uint32_t y = m_transferState.y;
+    const uint8_t *src = data + offset;
+    bool &changed = stamp.changed;
+    using namespace GSMem;
+    switch (dpsm)
+    {
+    case GS_PSM_CT32:
+        uploadPixels<C32>(PageTableC32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_Z32:
+        uploadPixels<Z32>(PageTableZ32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_CT24:
+        uploadPixels<C24>(PageTableC32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_Z24:
+        uploadPixels<Z24>(PageTableZ32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_CT16:
+        uploadPixels<C16>(PageTableC16, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_CT16S:
+        uploadPixels<C16S>(PageTableC16S, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_Z16:
+        uploadPixels<Z16>(PageTableZ16, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_Z16S:
+        uploadPixels<Z16S>(PageTableZ16S, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_T8:
+        uploadPixels<P8>(PageTableP8, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_T8H:
+        uploadPixels<P8H>(PageTableC32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_T4:
+        uploadPixels<P4>(PageTableP4, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_T4HL:
+        uploadPixels<P4HL>(PageTableC32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    case GS_PSM_T4HH:
+        uploadPixels<P4HH>(PageTableC32, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
+        break;
+    default:
+        return;
+    }
+    advancePixel(pixels);
+}
+
+void GSCpuBackend::PerformLocalToLocalTransfer()
+{
+    if (!m_vram)
+        return;
+
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t rrh = m_transfer.trxreg.rrh;
+    const uint32_t total = rrw * rrh;
+    if (total == 0u)
+    {
+        m_transferState.direction = 3u;
+        return;
+    }
+
+    MarkVramWritten(m_transfer.bitbltbuf.dbp, std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u), m_transfer.bitbltbuf.dpsm,
+                    m_transfer.trxpos.dsax, m_transfer.trxpos.dsay,
+                    static_cast<int>(m_transfer.trxpos.dsax + rrw) - 1, static_cast<int>(m_transfer.trxpos.dsay + rrh) - 1);
+    for (uint32_t pixel = 0; pixel < total; ++pixel)
+    {
+        uint32_t x = pixel % rrw;
+        uint32_t y = pixel / rrw;
+        if ((m_transfer.trxpos.dir & 0x2u) != 0u)
+            x = rrw - x - 1u;
+        if ((m_transfer.trxpos.dir & 0x1u) != 0u)
+            y = rrh - y - 1u;
+
+        const uint32_t value = ReadVramUnlocked(m_transfer.bitbltbuf.spsm,
+                                                m_transfer.bitbltbuf.sbp,
+                                                std::max<uint32_t>(m_transfer.bitbltbuf.sbw, 1u),
+                                                x + m_transfer.trxpos.ssax,
+                                                y + m_transfer.trxpos.ssay);
+        WriteVramUnlocked(m_transfer.bitbltbuf.dpsm,
+                          m_transfer.bitbltbuf.dbp,
+                          std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u),
+                          x + m_transfer.trxpos.dsax,
+                          y + m_transfer.trxpos.dsay,
+                          value);
+    }
+
+    m_transferState.copiedPixels = total;
+    m_transferState.direction = 3u;
+}
+
+void GSCpuBackend::PerformLocalToHostTransfer()
+{
+    m_localToHostBuffer.clear();
+    m_localToHostReadPos = 0u;
+    if (!m_vram)
+        return;
+
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t rrh = m_transfer.trxreg.rrh;
+    const uint32_t sbw = std::max<uint32_t>(m_transfer.bitbltbuf.sbw, 1u);
+    const uint8_t spsm = m_transfer.bitbltbuf.spsm;
+    const uint32_t bpp = static_cast<uint32_t>(GSMem::BitsPerPixel(static_cast<GSMem::PixelStorageMode>(spsm)));
+    const uint32_t total = rrw * rrh;
+    m_localToHostBuffer.reserve((static_cast<size_t>(total) * bpp + 7u) / 8u);
+
+    for (uint32_t pixel = 0u; pixel < total; ++pixel)
+    {
+        const uint32_t x = pixel % rrw;
+        const uint32_t y = pixel / rrw;
+        const uint32_t value = ReadVramUnlocked(spsm,
+                                                m_transfer.bitbltbuf.sbp,
+                                                sbw,
+                                                x + m_transfer.trxpos.ssax,
+                                                y + m_transfer.trxpos.ssay);
+        switch (bpp)
+        {
+        case 32:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 16u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 24u));
+            break;
+        case 24:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 16u));
+            break;
+        case 16:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value >> 8u));
+            break;
+        case 8:
+            m_localToHostBuffer.push_back(static_cast<uint8_t>(value));
+            break;
+        case 4:
+        {
+            if ((pixel & 1u) != 0u)
+                break;
+            uint32_t next = 0u;
+            if (pixel + 1u < total)
+            {
+                const uint32_t nextPixel = pixel + 1u;
+                const uint32_t nextX = nextPixel % rrw;
+                const uint32_t nextY = nextPixel / rrw;
+                next = ReadVramUnlocked(spsm, m_transfer.bitbltbuf.sbp, sbw,
+                                        nextX + m_transfer.trxpos.ssax,
+                                        nextY + m_transfer.trxpos.ssay);
+            }
+            m_localToHostBuffer.push_back(static_cast<uint8_t>((value & 0x0Fu) | ((next & 0x0Fu) << 4u)));
+            break;
+        }
+        default:
+            break;
+        }
+    }
+
+    m_transferState.copiedPixels = total;
+    m_transferState.localToHostPendingBytes = m_localToHostBuffer.size();
+}
+
+uint32_t GSCpuBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!dst || maxBytes == 0u || m_localToHostReadPos >= m_localToHostBuffer.size())
+        return 0u;
+    const size_t count = std::min<size_t>(maxBytes, m_localToHostBuffer.size() - m_localToHostReadPos);
+    std::memcpy(dst, m_localToHostBuffer.data() + m_localToHostReadPos, count);
+    m_localToHostReadPos += count;
+    m_transferState.localToHostPendingBytes = m_localToHostBuffer.size() - m_localToHostReadPos;
+    return static_cast<uint32_t>(count);
+}
+
+bool GSCpuBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    FinishRaster();
+    if (!m_vram || context.frame.fbw == 0u)
+        return false;
+
+    const uint32_t x0 = context.scissor.x0;
+    const uint32_t x1 = std::max<uint32_t>(x0, context.scissor.x1);
+    const uint32_t y0 = context.scissor.y0;
+    const uint32_t y1 = std::max<uint32_t>(y0, context.scissor.y1);
+    uint8_t r = static_cast<uint8_t>(rgba);
+    uint8_t g = static_cast<uint8_t>(rgba >> 8u);
+    uint8_t b = static_cast<uint8_t>(rgba >> 16u);
+    uint8_t a = static_cast<uint8_t>(rgba >> 24u);
+    if ((context.fba & 1ull) != 0ull && context.frame.psm != GS_PSM_CT24)
+        a |= 0x80u;
+
+    const uint32_t fbp = GSInternal::framePageBaseToBlock(context.frame.fbp);
+    const uint32_t fbw = std::max<uint32_t>(context.frame.fbw, 1u);
+    MarkVramWritten(fbp, fbw, context.frame.psm, static_cast<int>(x0), static_cast<int>(y0), static_cast<int>(x1), static_cast<int>(y1));
+    if (context.frame.psm == GS_PSM_CT32 || context.frame.psm == GS_PSM_CT24)
+    {
+        const uint32_t source = static_cast<uint32_t>(r) |
+                                (static_cast<uint32_t>(g) << 8u) |
+                                (static_cast<uint32_t>(b) << 16u) |
+                                (static_cast<uint32_t>(a) << 24u);
+        for (uint32_t y = y0; y <= y1; ++y)
+            for (uint32_t x = x0; x <= x1; ++x)
+            {
+                uint32_t pixel = source;
+                if (context.frame.fbmsk != 0u)
+                {
+                    const uint32_t old = ReadVramUnlocked(context.frame.psm, fbp, fbw, x, y);
+                    pixel = (pixel & ~context.frame.fbmsk) | (old & context.frame.fbmsk);
+                }
+                WriteVramUnlocked(context.frame.psm, fbp, fbw, x, y, pixel);
+            }
+        return true;
+    }
+
+    if (context.frame.psm == GS_PSM_CT16 || context.frame.psm == GS_PSM_CT16S)
+    {
+        const uint16_t source = encodeFramePixelPSMCT16(r, g, b, a);
+        const uint16_t mask = static_cast<uint16_t>(context.frame.fbmsk);
+        for (uint32_t y = y0; y <= y1; ++y)
+            for (uint32_t x = x0; x <= x1; ++x)
+            {
+                uint16_t pixel = source;
+                if (mask != 0u)
+                {
+                    const uint16_t old = static_cast<uint16_t>(ReadVramUnlocked(context.frame.psm, fbp, fbw, x, y));
+                    pixel = static_cast<uint16_t>((pixel & ~mask) | (old & mask));
+                }
+                WriteVramUnlocked(context.frame.psm, fbp, fbw, x, y, pixel);
+            }
+        return true;
+    }
+    return false;
+}
+
+bool GSCpuBackend::CopyFrameToHostRgba(const GSFrameReg &frame,
+                                       uint32_t width,
+                                       uint32_t height,
+                                       std::vector<uint8_t> &outPixels,
+                                       bool preserveAlpha,
+                                       bool useLocalMemoryLayout,
+                                       bool frameBaseIsPages,
+                                       uint32_t sourceOriginX,
+                                       uint32_t sourceOriginY) const
+{
+    if (!m_vram || m_vramSize == 0u)
+        return false;
+
+    outPixels.assign(kHostFrameWidth * kHostFrameHeight * 4u, 0u);
+    const uint32_t baseBytes = frameBaseIsPages ? frame.fbp * 8192u : frame.fbp * 256u;
+    const uint32_t basePtr = frameBaseIsPages ? GSInternal::framePageBaseToBlock(frame.fbp) : frame.fbp;
+    const uint32_t fbw = frame.fbw ? frame.fbw : kHostFrameWidth / 64u;
+    const uint32_t bytesPerPixel = (frame.psm == GS_PSM_CT16 || frame.psm == GS_PSM_CT16S) ? 2u : 4u;
+    const uint32_t stride = fbw * 64u * bytesPerPixel;
+
+    if (useLocalMemoryLayout && (frame.psm == GS_PSM_CT32 || frame.psm == GS_PSM_CT24) && width != 0u && height != 0u &&
+        width <= kHostFrameWidth && height <= kHostFrameHeight)
+    {
+        // Block by block: one address computation per 8x8 pixels. A pixel in memory is
+        // already R, G, B, A bytes.
+        const BlockLayout &layout = blockLayout(GS_PSM_CT32);
+        const uint32_t opaque = (preserveAlpha && frame.psm != GS_PSM_CT24) ? 0u : 0xFF000000u;
+        const int x0 = static_cast<int>(sourceOriginX);
+        const int y0 = static_cast<int>(sourceOriginY);
+        const int x1 = x0 + static_cast<int>(width) - 1;
+        const int y1 = y0 + static_cast<int>(height) - 1;
+        for (int by = y0 & ~7; by <= y1; by += 8)
+        {
+            for (int bx = x0 & ~7; bx <= x1; bx += 8)
+            {
+                const uint8_t *const block = m_vram + offsetCT32(basePtr, fbw, static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
+                const int xs = std::max(bx, x0);
+                const int xe = std::min(bx + 7, x1);
+                for (int y = std::max(by, y0); y <= std::min(by + 7, y1); ++y)
+                {
+                    uint8_t *dst = outPixels.data() +
+                                   (static_cast<size_t>(y - y0) * kHostFrameWidth + static_cast<size_t>(xs - x0)) * 4u;
+                    const uint16_t *const offsets = layout.offset[y - by];
+                    for (int x = xs; x <= xe; ++x, dst += 4)
+                    {
+                        const uint32_t color = load32(block, offsets[x - bx]) | opaque;
+                        std::memcpy(dst, &color, sizeof(color));
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    for (uint32_t y = 0; y < height; ++y)
+    {
+        uint8_t *dst = outPixels.data() + y * kHostFrameWidth * 4u;
+        for (uint32_t x = 0; x < width; ++x)
+        {
+            const uint32_t sx = sourceOriginX + x;
+            const uint32_t sy = sourceOriginY + y;
+            if (frame.psm == GS_PSM_CT32 || frame.psm == GS_PSM_CT24)
+            {
+                uint32_t color = 0u;
+                if (useLocalMemoryLayout)
+                    color = ReadVramUnlocked(frame.psm, basePtr, fbw, sx, sy);
+                else
+                {
+                    const uint32_t pixelBytes = frame.psm == GS_PSM_CT24 ? 3u : 4u;
+                    const uint64_t offset = static_cast<uint64_t>(baseBytes) + static_cast<uint64_t>(sy) * stride + static_cast<uint64_t>(sx) * pixelBytes;
+                    if (offset + pixelBytes > m_vramSize)
+                        return false;
+                    color = m_vram[offset] | (static_cast<uint32_t>(m_vram[offset + 1u]) << 8u) |
+                            (static_cast<uint32_t>(m_vram[offset + 2u]) << 16u);
+                    if (pixelBytes == 4u)
+                        color |= static_cast<uint32_t>(m_vram[offset + 3u]) << 24u;
+                }
+                dst[x * 4u] = static_cast<uint8_t>(color);
+                dst[x * 4u + 1u] = static_cast<uint8_t>(color >> 8u);
+                dst[x * 4u + 2u] = static_cast<uint8_t>(color >> 16u);
+                dst[x * 4u + 3u] = preserveAlpha && frame.psm != GS_PSM_CT24 ? static_cast<uint8_t>(color >> 24u) : 255u;
+            }
+            else if (frame.psm == GS_PSM_CT16 || frame.psm == GS_PSM_CT16S)
+            {
+                uint16_t color = 0u;
+                if (useLocalMemoryLayout)
+                    color = static_cast<uint16_t>(ReadVramUnlocked(frame.psm, basePtr, fbw, sx, sy));
+                else
+                {
+                    const uint64_t offset = static_cast<uint64_t>(baseBytes) + static_cast<uint64_t>(sy) * stride + static_cast<uint64_t>(sx) * 2u;
+                    if (offset + 2u > m_vramSize)
+                        return false;
+                    std::memcpy(&color, m_vram + offset, sizeof(color));
+                }
+                const uint32_t r = color & 31u;
+                const uint32_t g = (color >> 5u) & 31u;
+                const uint32_t b = (color >> 10u) & 31u;
+                dst[x * 4u] = static_cast<uint8_t>((r << 3u) | (r >> 2u));
+                dst[x * 4u + 1u] = static_cast<uint8_t>((g << 3u) | (g >> 2u));
+                dst[x * 4u + 2u] = static_cast<uint8_t>((b << 3u) | (b >> 2u));
+                dst[x * 4u + 3u] = preserveAlpha ? ((color & 0x8000u) ? 0x80u : 0u) : 255u;
+            }
+            else
+            {
+                outPixels.clear();
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+PresentationFrame GSCpuBackend::Present(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    FinishRaster();
+    return PresentUnlocked(request, true);
+}
+
+void GSCpuBackend::PresentQueued(const GSPresentationRequest &request, std::function<void(PresentationFrame &&)> done)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_fast->workers)
+    {
+        done(PresentUnlocked(request, true));
+        return;
+    }
+    // A rasterizer thread builds it once the others are through what came before; the GS
+    // thread goes on. The frame of the last call is not reused here: whether its pages were
+    // written since is the GS thread's to know.
+    m_fast->workers->submitBarrier([this, request, done = std::move(done)]()
+                                   { done(PresentUnlocked(request, false)); });
+    m_fast->workers->announce(true);
+}
+
+void GSCpuBackend::CaptureQueued(const GSTransferCommand &command, std::function<void(std::vector<uint8_t> &&)> done)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const uint8_t *const vram = m_vram;
+    const ReadVramFunc read = m_readVramFuncs[command.bitbltbuf.spsm & 0x3Fu];
+    // The region as PerformLocalToHostTransfer reads it, from any thread: nothing of the
+    // transfer state is touched.
+    auto work = [vram, read, command, done = std::move(done)]()
+    {
+        std::vector<uint8_t> bytes;
+        const uint32_t rrw = command.trxreg.rrw;
+        const uint32_t rrh = command.trxreg.rrh;
+        const uint32_t sbw = std::max<uint32_t>(command.bitbltbuf.sbw, 1u);
+        const uint8_t spsm = command.bitbltbuf.spsm;
+        const uint32_t bpp = static_cast<uint32_t>(GSMem::BitsPerPixel(static_cast<GSMem::PixelStorageMode>(spsm)));
+        const uint32_t total = rrw * rrh;
+        if (vram && total != 0u)
+        {
+            bytes.reserve((static_cast<size_t>(total) * bpp + 7u) / 8u);
+            const auto at = [&](uint32_t pixel)
+            {
+                return read(const_cast<uint8_t *>(vram), command.bitbltbuf.sbp, sbw, pixel % rrw + command.trxpos.ssax,
+                            pixel / rrw + command.trxpos.ssay);
+            };
+            for (uint32_t pixel = 0u; pixel < total; ++pixel)
+            {
+                const uint32_t value = at(pixel);
+                if (bpp == 4u)
+                {
+                    if ((pixel & 1u) != 0u)
+                        continue;
+                    const uint32_t next = pixel + 1u < total ? at(pixel + 1u) : 0u;
+                    bytes.push_back(static_cast<uint8_t>((value & 0x0Fu) | ((next & 0x0Fu) << 4u)));
+                    continue;
+                }
+                for (uint32_t shift = 0u; shift < bpp; shift += 8u)
+                    bytes.push_back(static_cast<uint8_t>(value >> shift));
+            }
+        }
+        done(std::move(bytes));
+    };
+    if (!m_fast->workers)
+    {
+        work();
+        return;
+    }
+    m_fast->workers->submitBarrier(std::move(work));
+    m_fast->workers->announce(true);
+}
+
+PresentationFrame GSCpuBackend::PresentUnlocked(const GSPresentationRequest &request, bool reuseAllowed)
+{
+    if (!m_vram || m_vramSize == 0u)
+        return {};
+
+    // PS2X_GS_DUMP_VRAM_AT=<seconds> or PS2X_GS_DUMP_VRAM_TICK=<vsync tick>: save local
+    // memory and the display registers once, that long after the first presented frame
+    // or at that VBlank, to runs/vram.bin and runs/vram.txt (see tools/vram_view.py).
+    static const double dumpAt = []()
+    {
+        const char *env = std::getenv("PS2X_GS_DUMP_VRAM_AT");
+        return env ? std::atof(env) : -1.0;
+    }();
+    static const uint64_t dumpTick = []()
+    {
+        const char *env = std::getenv("PS2X_GS_DUMP_VRAM_TICK");
+        return env ? std::strtoull(env, nullptr, 10) : 0ull;
+    }();
+    if (dumpAt >= 0.0 || dumpTick != 0u)
+    {
+        static const auto firstPresent = std::chrono::steady_clock::now();
+        static bool dumped = false;
+        const bool due = (dumpAt >= 0.0 &&
+                          std::chrono::duration<double>(std::chrono::steady_clock::now() - firstPresent).count() >= dumpAt) ||
+                         (dumpTick != 0u && request.vsyncTick >= dumpTick);
+        if (!dumped && due)
+        {
+            dumped = true;
+            if (std::FILE *file = std::fopen("runs/vram.bin", "wb"))
+            {
+                std::fwrite(m_vram, 1, m_vramSize, file);
+                std::fclose(file);
+            }
+            if (std::FILE *file = std::fopen("runs/vram.txt", "w"))
+            {
+                std::fprintf(file, "pmode=%llx smode2=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx bgcolor=%llx\n",
+                             static_cast<unsigned long long>(request.pmode), static_cast<unsigned long long>(request.smode2),
+                             static_cast<unsigned long long>(request.dispfb1), static_cast<unsigned long long>(request.display1),
+                             static_cast<unsigned long long>(request.dispfb2), static_cast<unsigned long long>(request.display2),
+                             static_cast<unsigned long long>(request.bgcolor));
+                for (int i = 0; i < 2; ++i)
+                    std::fprintf(file, "context%d frame fbp=%u fbw=%u psm=%u\n", i + 1, request.contextFrames[i].fbp,
+                                 request.contextFrames[i].fbw, request.contextFrames[i].psm);
+                std::fclose(file);
+            }
+        }
+    }
+
+    // The frame of the last call again if the registers are the same and none of the pages
+    // it was made from has been written since (a game that draws at 30 fps is presented
+    // twice per frame).
+    FastState &fs = *m_fast;
+    const auto sameFrame = [](const GSFrameReg &a, const GSFrameReg &b)
+    { return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm && a.fbmsk == b.fbmsk; };
+    const GSPresentationRequest &last = fs.presentRequest;
+    bool reuse = fs.presentReusable && last.pmode == request.pmode && last.smode2 == request.smode2 &&
+                 last.dispfb1 == request.dispfb1 && last.display1 == request.display1 && last.dispfb2 == request.dispfb2 &&
+                 last.display2 == request.display2 && last.bgcolor == request.bgcolor &&
+                 sameFrame(last.contextFrames[0], request.contextFrames[0]) &&
+                 sameFrame(last.contextFrames[1], request.contextFrames[1]) &&
+                 last.hasPreferredSource == request.hasPreferredSource && last.preferredDestFbp == request.preferredDestFbp &&
+                 sameFrame(last.preferredSource, request.preferredSource);
+    for (size_t i = 0; reuse && i < fs.presentPages.size(); ++i)
+        reuse = fs.pageStamp[fs.presentPages[i]] <= fs.presentStamp;
+    reuse = reuse && reuseAllowed;
+
+    PresentationFrame frame;
+    if (reuse)
+    {
+        frame = fs.presentFrame;
+    }
+    else
+    {
+        fs.presentPages.clear();
+        fs.presentReusable = true; // PresentFromLocalMemory clears it for sources it cannot track
+        frame = PresentFromLocalMemory(request);
+        fs.presentRequest = request;
+        fs.presentStamp = fs.stamp;
+        fs.presentReusable = fs.presentReusable && reuseAllowed;
+        if (fs.presentReusable)
+            fs.presentFrame = frame;
+    }
+    return frame;
+}
+
+bool GSCpuBackend::presentedFieldMode(uint32_t &firstLineParity) const
+{
+    firstLineParity = m_fast->presentFieldPhase;
+    return m_fast->presentFieldMode;
+}
+
+PresentationFrame GSCpuBackend::PresentFromLocalMemory(const GSPresentationRequest &request)
+{
+    PresentationFrame result{};
+    const GSPmodeState pmode = decodePmode(request.pmode);
+    const GSSmode2State smode2 = decodeSMode2(request.smode2);
+    const bool fieldMode = smode2.interlaced && !smode2.frameMode;
+    const GSFrameReg displayFrame1 = decodeDisplayFrame(request.dispfb1);
+    const GSFrameReg displayFrame2 = decodeDisplayFrame(request.dispfb2);
+    const GSDisplayReadOrigin origin1 = decodeDisplayReadOrigin(request.dispfb1);
+    const GSDisplayReadOrigin origin2 = decodeDisplayReadOrigin(request.dispfb2);
+    uint32_t width1 = 0u, height1 = 0u, width2 = 0u, height2 = 0u;
+    decodeDisplaySize(request.display1, width1, height1);
+    decodeDisplaySize(request.display2, width2, height2);
+    // Interlaced frame mode (FFMD 1): each field reads its lines one after the other, so a display
+    // DH + 1 lines of the whole picture high shows half as many rows of the buffer, and DY counts
+    // the picture's lines too (the SDK's double buffers of 224 rows for 448 lines; in Transformers
+    // the warp gate's loading screen alone).
+    const bool frameLines = smode2.interlaced && smode2.frameMode;
+    if (frameLines)
+    {
+        height1 = (height1 + 1u) / 2u;
+        height2 = (height2 + 1u) / 2u;
+    }
+    const auto displayDy = [&](uint64_t display64)
+    { return frameLines ? decodeDisplayDy(display64) / 2u : decodeDisplayDy(display64); };
+    const bool valid1 = pmode.enableCrt1 && hasDisplaySetup(request.display1, displayFrame1);
+    const bool valid2 = pmode.enableCrt2 && hasDisplaySetup(request.display2, displayFrame2);
+    m_fast->presentFieldMode = fieldMode;
+    if (!valid1 && !valid2)
+        return result;
+
+    auto copySource = [&](const GSFrameReg &displayFrame,
+                          const GSDisplayReadOrigin &origin,
+                          uint32_t width,
+                          uint32_t height,
+                          bool allowPreferred,
+                          bool preserveAlpha,
+                          GSFrameReg &selected,
+                          std::vector<uint8_t> &pixels,
+                          bool &usedPreferred) -> bool
+    {
+        selected = displayFrame;
+        pixels.clear();
+        usedPreferred = false;
+        if (allowPreferred && request.hasPreferredSource && request.preferredDestFbp == displayFrame.fbp &&
+            (request.preferredSource.fbw != 0u || request.preferredSource.fbp != displayFrame.fbp) &&
+            CopyFrameToHostRgba(request.preferredSource, width, height, pixels, preserveAlpha, true, false, 0u, 0u))
+        {
+            selected = request.preferredSource;
+            usedPreferred = true;
+            m_fast->presentReusable = false;
+        }
+        if (pixels.empty() && !CopyFrameToHostRgba(displayFrame, width, height, pixels, preserveAlpha, true, true, origin.x, origin.y))
+            return false;
+        if (!usedPreferred && width != 0u && height != 0u)
+            forEachPage(GSInternal::framePageBaseToBlock(displayFrame.fbp), std::max<uint32_t>(displayFrame.fbw, 1u), displayFrame.psm,
+                        static_cast<int>(origin.x), static_cast<int>(origin.y), static_cast<int>(origin.x + width) - 1,
+                        static_cast<int>(origin.y + height) - 1, [&](uint32_t page)
+                        { m_fast->presentPages.push_back(static_cast<uint16_t>(page)); });
+
+        if (!usedPreferred && displayFrame.fbp == 0u && countNonBlackPixels(pixels, width, height) == 0u)
+        {
+            m_fast->presentReusable = false;
+            for (const GSFrameReg &candidate : request.contextFrames)
+            {
+                if (candidate.fbp == selected.fbp && candidate.fbw == selected.fbw && candidate.psm == selected.psm)
+                    continue;
+                std::vector<uint8_t> candidatePixels;
+                if (!CopyFrameToHostRgba(candidate, width, height, candidatePixels, preserveAlpha, true, true, 0u, 0u))
+                    continue;
+                if (countNonBlackPixels(candidatePixels, width, height) == 0u)
+                    continue;
+                selected = candidate;
+                pixels.swap(candidatePixels);
+                break;
+            }
+        }
+        return true;
+    };
+
+    if (valid1 && valid2)
+    {
+        GSFrameReg selected1 = displayFrame1, selected2 = displayFrame2;
+        std::vector<uint8_t> crt1, crt2;
+        bool preferred1 = false, preferred2 = false;
+        // A circuit is only read when it shows: circuit 1 does not when it is mixed in with
+        // weight 0 (MMOD with ALP 0), and with SLBG the background colour takes circuit 2's
+        // place.
+        const bool show1 = !(pmode.mmod && pmode.alp == 0u);
+        const bool show2 = !pmode.slbg;
+        if ((!show1 || copySource(displayFrame1, origin1, width1, height1, false, true, selected1, crt1, preferred1)) &&
+            (!show2 || copySource(displayFrame2, origin2, width2, height2, false, true, selected2, crt2, preferred2)))
+        {
+            // The circuits are placed by their DISPLAY.DY (games offset them by a line to
+            // blend neighbouring lines); the picture is what the ones that show cover.
+            const uint32_t dy1 = displayDy(request.display1);
+            const uint32_t dy2 = displayDy(request.display2);
+            const uint32_t top = (show1 && show2) ? std::min(dy1, dy2) : (show1 ? dy1 : dy2);
+            const uint32_t row1 = show1 ? dy1 - top : 0u;
+            const uint32_t row2 = show2 ? dy2 - top : 0u;
+            m_fast->presentFieldPhase = top & 1u;
+            if (!show1 && !show2)
+            {
+                result.width = std::max(width1, width2);
+                result.height = std::max(height1, height2);
+            }
+            else
+            {
+                result.width = std::max(show1 ? width1 : 0u, show2 ? width2 : 0u);
+                result.height = std::min<uint32_t>(kHostFrameHeight, std::max(show1 ? height1 + row1 : 0u, show2 ? height2 + row2 : 0u));
+            }
+            const uint32_t rows1 = show1 ? std::min(height1, result.height - std::min(result.height, row1)) : 0u;
+            const uint32_t rows2 = show2 ? std::min(height2, result.height - std::min(result.height, row2)) : 0u;
+            result.pixels.assign(kHostFrameWidth * kHostFrameHeight * 4u, 0u);
+            const size_t rowBytes = static_cast<size_t>(kHostFrameWidth) * 4u;
+            const uint8_t bgR = static_cast<uint8_t>(request.bgcolor);
+            const uint8_t bgG = static_cast<uint8_t>(request.bgcolor >> 8u);
+            const uint8_t bgB = static_cast<uint8_t>(request.bgcolor >> 16u);
+            // Circuit 1 replaces what is below it when its blend factor is 255 everywhere:
+            // an RGB24 frame (alpha 255 here) blended by its own alpha.
+            const bool opaque1 = show1 && !pmode.mmod && !pmode.amod && selected1.psm == GS_PSM_CT24 && !preferred1;
+            const bool covers1 = opaque1 && row1 == 0u && width1 == result.width && rows1 == result.height;
+            const bool covers2 = show2 && row2 == 0u && width2 == result.width && rows2 == result.height;
+            if (!covers1 && !covers2)
+            {
+                for (uint32_t y = 0; y < result.height; ++y)
+                    for (uint32_t x = 0; x < result.width; ++x)
+                    {
+                        uint8_t *dst = result.pixels.data() + (y * kHostFrameWidth + x) * 4u;
+                        dst[0] = bgR;
+                        dst[1] = bgG;
+                        dst[2] = bgB;
+                        dst[3] = pmode.alp;
+                    }
+            }
+            if (!covers1)
+            {
+                for (uint32_t y = 0; y < rows2; ++y)
+                    std::memcpy(result.pixels.data() + (y + row2) * rowBytes, crt2.data() + y * rowBytes, width2 * 4u);
+            }
+            if (opaque1)
+            {
+                for (uint32_t y = 0; y < rows1; ++y)
+                    std::memcpy(result.pixels.data() + (y + row1) * rowBytes, crt1.data() + y * rowBytes, width1 * 4u);
+            }
+            else if (show1)
+            {
+                for (uint32_t y = 0; y < rows1; ++y)
+                    for (uint32_t x = 0; x < width1; ++x)
+                    {
+                        const uint8_t *src = crt1.data() + (y * kHostFrameWidth + x) * 4u;
+                        uint8_t *dst = result.pixels.data() + ((y + row1) * kHostFrameWidth + x) * 4u;
+                        const uint32_t factor = pmode.mmod ? pmode.alp : std::min<uint32_t>(255u, static_cast<uint32_t>(src[3]) * 2u);
+                        dst[0] = blendPresentationChannel(src[0], dst[0], factor);
+                        dst[1] = blendPresentationChannel(src[1], dst[1], factor);
+                        dst[2] = blendPresentationChannel(src[2], dst[2], factor);
+                        dst[3] = pmode.amod ? dst[3] : src[3];
+                    }
+            }
+            normalizePresentationAlpha(result.pixels, result.width, result.height);
+            result.displayFbp = displayFrame1.fbp;
+            result.sourceFbp = (show1 ? selected1 : selected2).fbp;
+            return result;
+        }
+    }
+
+    const GSFrameReg &displayFrame = valid1 ? displayFrame1 : displayFrame2;
+    const GSDisplayReadOrigin &origin = valid1 ? origin1 : origin2;
+    m_fast->presentFieldPhase = displayDy(valid1 ? request.display1 : request.display2) & 1u;
+    result.width = valid1 ? width1 : width2;
+    result.height = valid1 ? height1 : height2;
+    GSFrameReg selected = displayFrame;
+    if (!copySource(displayFrame, origin, result.width, result.height, true, false, selected, result.pixels, result.usedPreferred))
+        return {};
+    normalizePresentationAlpha(result.pixels, result.width, result.height);
+    result.displayFbp = displayFrame.fbp;
+    result.sourceFbp = selected.fbp;
+    return result;
+}
+
+// ---------------------------------------------------------------------------
+// Fast path: draw dispatch, texture cache and VRAM write tracking
+// ---------------------------------------------------------------------------
+
+// Works out from the run's draw state what its primitives share.
+void GSCpuBackend::PrepareRun()
+{
+    FastState &fs = *m_fast;
+    FastState::Run &run = fs.run;
+    const GSDrawState &state = run.state;
+    run.prepared = true;
+    run.fast = false;
+    run.texture = nullptr;
+    run.shared = RasterWorkers::kNoState;
+    run.cellGeneration = 0u;
+    run.serial = fs.newRun();
+    fs.preparedTexture = nullptr;
+    if (fs.reference)
+        return;
+
+    const GSPrimType type = state.prim.type;
+    const bool sprite = type == GS_PRIM_SPRITE;
+    if (!sprite && type != GS_PRIM_TRIANGLE && type != GS_PRIM_TRISTRIP && type != GS_PRIM_TRIFAN)
+        return;
+
+    RasterState &rs = run.rs;
+    rs = RasterState{};
+    if (!rs.pipe.init(state, m_vram))
+        return;
+    const GSContext &ctx = state.context;
+    rs.sprite = sprite;
+    rs.gouraud = state.prim.iip;
+    rs.ofx = ctx.xyoffset.ofx;
+    rs.ofy = ctx.xyoffset.ofy;
+    rs.scissorX0 = ctx.scissor.x0;
+    rs.scissorX1 = ctx.scissor.x1;
+    rs.scissorY0 = ctx.scissor.y0;
+    rs.scissorY1 = ctx.scissor.y1;
+    if (state.prim.tme)
+    {
+        if (!PrepareRunTexture())
+            return;
+        rs.texMode = state.prim.fst ? 1 : 2;
+    }
+
+    if (!fs.workersChecked)
+    {
+        fs.workersChecked = true;
+        const int threads = rasterThreadCount();
+        if (threads > 1)
+            fs.workers = std::make_unique<RasterWorkers>(threads);
+    }
+
+    const PixelPipe &pipe = rs.pipe;
+    run.usesDepth = pipe.zwrite || pipe.ztst >= 2u;
+
+    // The vector code draws everything but primitives whose pixels alias their depth
+    // (those are drawn here, see DrawFastPrimitive).
+    if (fs.simd)
+    {
+        const SurfaceOffsets *frameOffsets = fs.surfaceOffsets(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, fs.lastFrameTable);
+        const SurfaceOffsets *depthOffsets =
+            run.usesDepth ? fs.surfaceOffsets(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, fs.lastDepthTable) : nullptr;
+        if (frameOffsets && (!run.usesDepth || depthOffsets))
+        {
+            rs.pipe.frameOffsets = frameOffsets;
+            rs.pipe.depthOffsets = depthOffsets;
+            rs.simd = true;
+        }
+    }
+
+    // What no primitive of the run can do is settled here, with the scissor rectangle
+    // standing in for the primitive's own: the page ranges of a rectangle inside it lie
+    // inside its page ranges.
+    const int sx0 = rs.scissorX0, sy0 = rs.scissorY0, sx1 = rs.scissorX1, sy1 = rs.scissorY1;
+    run.mayFeedback = run.texture &&
+                      (FastState::mayTouchPages(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, sx0, sy0, sx1, sy1,
+                                                run.texture->pageLo, run.texture->pageHi) ||
+                       (pipe.zwrite &&
+                        FastState::mayTouchPages(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, sx0, sy0, sx1, sy1,
+                                                 run.texture->pageLo, run.texture->pageHi)));
+    run.mayShareDepth = false;
+    if (run.usesDepth && sx0 <= sx1 && sy0 <= sy1)
+    {
+        uint32_t frameFirst = 0u, frameLast = 0u, depthFirst = 0u, depthLast = 0u;
+        pageBounds(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, sx0, sy0, sx1, sy1, frameFirst, frameLast);
+        pageBounds(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, sx0, sy0, sx1, sy1, depthFirst, depthLast);
+        run.mayShareDepth = frameLast >= 512u || depthLast >= 512u || (frameFirst <= depthLast && depthFirst <= frameLast);
+        if (run.mayShareDepth)
+        {
+            FastState::PageSet framePages{};
+            FastState::PageSet depthPages{};
+            FastState::addPages(framePages, pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, sx0, sy0, sx1, sy1);
+            FastState::addPages(depthPages, pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, sx0, sy0, sx1, sy1);
+            run.mayShareDepth = FastState::intersects(framePages, depthPages);
+        }
+    }
+    run.fast = true;
+}
+
+// Draws one primitive of the prepared run: queued for the rasterizer threads, or here when
+// it has to see what the ones before it drew.
+void GSCpuBackend::DrawFastPrimitive(const GSVertex *vertices)
+{
+    FastState &fs = *m_fast;
+    FastState::Run &run = fs.run;
+    RasterState &rs = run.rs;
+    const PixelPipe &pipe = rs.pipe;
+
+    // Nothing to do for a primitive that covers no pixel (many do, in the distance).
+    DrawRect drawn;
+    if (rs.sprite)
+    {
+        SpriteCorners corners;
+        if (!spriteBounds(vertices, rs, corners, drawn))
+            return;
+    }
+    else
+    {
+        TriangleCorners corners;
+        if (!triangleBounds(vertices, rs, corners, drawn))
+            return;
+    }
+
+    if (run.texture)
+        PrepareTexels(vertices);
+
+    const bool usesDepth = run.usesDepth;
+
+    // A primitive that samples the pages it draws to (effects redraw a buffer from itself
+    // many times a frame) is queued like any other: it samples the decoded copy, which
+    // PrepareTexels brought up to date behind whatever queued primitives drew those pages
+    // before it, and which nothing writes until every thread is through with it.
+    bool queued = fs.workers != nullptr;
+    bool behindBarrier = false; // drawn by one rasterizer thread once all are done with what came before
+
+    // Where queued primitives of the run have been before, the pages are stamped as
+    // written and marked in flight through these surfaces already.
+    const bool tracked = queued && !run.mayFeedback && run.cellGeneration == fs.cellGeneration && run.cellsCover(drawn);
+    // PS2X_GS_BARRIER_LOG=1: the first few thousand primitives that wait for the rasterizer
+    // threads or go behind a barrier, with what they draw and sample.
+    static const bool logBarriers = std::getenv("PS2X_GS_BARRIER_LOG") != nullptr;
+    static int loggedBarriers = 0;
+    const auto logBarrier = [&](const char *why)
+    {
+        if (!logBarriers || loggedBarriers >= 6000)
+            return;
+        ++loggedBarriers;
+        std::fprintf(stderr, "[gs:barrier] %s %s %d-%d,%d-%d | frame fbp=%u fbw=%u psm=%02x zbp=%u zpsm=%02x z=%d/%u | tex %s tbp=%u tbw=%u psm=%02x"
+                             " fst=%d linear=%d texels %d-%d,%d-%d | uv %.2f,%.2f %.2f,%.2f %.2f,%.2f q %.3f %.3f %.3f\n",
+                     why, rs.sprite ? "sprite" : "tri", drawn.x0, drawn.x1, drawn.y0, drawn.y1, pipe.frame.bp / 32u, pipe.frame.bw,
+                     pipe.frame.psm, pipe.depth.bp / 32u, pipe.depth.psm, pipe.zwrite ? 1 : 0, static_cast<unsigned>(pipe.ztst),
+                     run.texture ? "yes" : "no", run.texture ? run.texture->tbp : 0u, run.texture ? run.texture->tbw : 0u,
+                     run.texture ? run.texture->psm : 0u, run.state.prim.fst ? 1 : 0, rs.tex.linear ? 1 : 0,
+                     fs.preparedTexels[0][0], fs.preparedTexels[0][2], fs.preparedTexels[0][1], fs.preparedTexels[0][3],
+                     run.state.prim.fst ? vertices[0].u / 16.0 : static_cast<double>(vertices[0].s) / vertices[0].q * rs.tex.texW,
+                     run.state.prim.fst ? vertices[0].v / 16.0 : static_cast<double>(vertices[0].t) / vertices[0].q * rs.tex.texH,
+                     run.state.prim.fst ? vertices[1].u / 16.0 : static_cast<double>(vertices[1].s) / vertices[1].q * rs.tex.texW,
+                     run.state.prim.fst ? vertices[1].v / 16.0 : static_cast<double>(vertices[1].t) / vertices[1].q * rs.tex.texH,
+                     rs.sprite ? 0.0 : (run.state.prim.fst ? vertices[2].u / 16.0 : static_cast<double>(vertices[2].s) / vertices[2].q * rs.tex.texW),
+                     rs.sprite ? 0.0 : (run.state.prim.fst ? vertices[2].v / 16.0 : static_cast<double>(vertices[2].t) / vertices[2].q * rs.tex.texH),
+                     vertices[0].q, vertices[1].q, rs.sprite ? 0.0f : vertices[2].q);
+    };
+    if (queued && !tracked &&
+        (fs.otherSurfaceInflight(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1) ||
+         (usesDepth &&
+          fs.otherSurfaceInflight(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1))))
+    {
+        if (logBarriers && loggedBarriers < 6000)
+        {
+            // The surface in flight there: base page, width, format.
+            uint32_t other = 0u;
+            const auto find = [&](uint32_t bp, uint32_t bw, uint8_t psm)
+            {
+                const uint32_t key = FastState::surfaceKey(bp, bw, psm);
+                forEachPage(bp, bw, psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, [&](uint32_t page)
+                            {
+                                if (other == 0u && fs.inflightSurface[page] != 0u && fs.inflightSurface[page] != key)
+                                    other = fs.inflightSurface[page]; });
+            };
+            find(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm);
+            if (other == 0u && usesDepth)
+                find(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm);
+            std::fprintf(stderr, "[gs:barrier] in flight there: page %u bw %u psm %02x\n", ((other >> 14u) & 0x3FFFu) / 32u,
+                         (other >> 8u) & 0x3Fu, other & 0xFFu);
+        }
+        logBarrier("surface");
+        // A barrier puts every queued job before whatever comes next, whichever rows and
+        // surfaces either touches: the in-flight surfaces start again from nothing. The
+        // pages stay in flight for what the GS thread reads and writes itself.
+        fs.workers->submitBarrier([]() {});
+        fs.inflightSurface.fill(0u);
+        ++fs.cellGeneration;
+        ++fs.statSurfaceBarriers;
+    }
+    // Frame and depth buffer in the same pages: the threads' bands of the two overlap, and
+    // a pixel's depth can be another pixel's colour.
+    bool frameDepthShared = false;
+    if (run.mayShareDepth)
+    {
+        uint32_t frameFirst = 0u, frameLast = 0u, depthFirst = 0u, depthLast = 0u;
+        pageBounds(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, frameFirst, frameLast);
+        pageBounds(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, depthFirst, depthLast);
+        frameDepthShared = frameLast >= 512u || depthLast >= 512u || (frameFirst <= depthLast && depthFirst <= frameLast);
+        if (frameDepthShared)
+        {
+            FastState::PageSet framePages{};
+            FastState::PageSet depthPages{};
+            FastState::addPages(framePages, pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1);
+            FastState::addPages(depthPages, pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1);
+            frameDepthShared = FastState::intersects(framePages, depthPages);
+        }
+    }
+    if (queued && frameDepthShared)
+    {
+        queued = false;
+        behindBarrier = true;
+    }
+    // Drawn here, at once, if no queued job still touches the pages it draws to or writes
+    // the pages it reads; otherwise behind a barrier.
+    bool drawnHere = false;
+    if (behindBarrier)
+    {
+        const bool waitsForQueue =
+            fs.pending(fs.pageAccessRun, pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1) ||
+            (usesDepth &&
+             fs.pending(fs.pageAccessRun, pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1)) ||
+            (run.texture && fs.jobPending(run.texture->pendingDecodeJob));
+        if (!waitsForQueue)
+        {
+            behindBarrier = false;
+            drawnHere = true;
+            // No queued primitive reads the texture on this one's behalf.
+            if (run.texture)
+                run.texture->useJob = fs.preparedPreviousUseJob;
+        }
+    }
+
+    if (behindBarrier || drawnHere)
+        logBarrier(frameDepthShared ? (behindBarrier ? "shared-barrier" : "shared-here")
+                                    : (behindBarrier ? "feedback-barrier" : "feedback-here"));
+    if (behindBarrier)
+    {
+        // The rasterizer threads own bands of rows of a surface: a primitive whose texture or
+        // depth buffer lies in the pages it draws to would have them read what another one
+        // is writing. One thread draws all of it, once every thread is through what came
+        // before, and none goes on until it is drawn.
+        const RasterState state = rs;
+        const bool simd = rs.simd && !frameDepthShared;
+        const GSVertex v0 = vertices[0];
+        const GSVertex v1 = vertices[1];
+        const GSVertex v2 = rs.sprite ? vertices[1] : vertices[2];
+        const uint64_t job = fs.workers->submitBarrier([state, simd, v0, v1, v2]()
+                                                       {
+                                      const GSVertex v[3] = {v0, v1, v2};
+                                      uint64_t pixels = 0u;
+                                      runRasterJob(state, simd, v, RowSet{}, pixels); });
+        // Later reads of these pages by the GS thread wait for it.
+        const uint32_t serial = fs.newRun();
+        fs.runLastJob[serial & (FastState::kRunJobs - 1u)] = job;
+        // Through no surface in particular: one thread draws all of it.
+        fs.markPending(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, true, serial);
+        if (usesDepth)
+            fs.markPending(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, pipe.zwrite,
+                           serial);
+        ++fs.statInline;
+    }
+    else if (drawnHere)
+    {
+        uint64_t pixels = 0u;
+        runRasterJob(rs, rs.simd && !frameDepthShared, vertices, RowSet{}, pixels);
+        fs.statPixels += pixels;
+    }
+    else if (queued)
+    {
+        if (run.shared == RasterWorkers::kNoState || run.sharedRgba != rs.tex.rgba || run.sharedIndex != rs.tex.index)
+        {
+            run.shared = fs.workers->shareState(rs);
+            run.sharedRgba = rs.tex.rgba;
+            run.sharedIndex = rs.tex.index;
+        }
+        RasterJob &job = fs.workers->next();
+        job.ys = static_cast<int16_t>(drawn.y0);
+        job.ye = static_cast<int16_t>(drawn.y1);
+        job.state = run.shared;
+        job.v[0] = vertices[0];
+        job.v[1] = vertices[1];
+        if (!rs.sprite)
+            job.v[2] = vertices[2];
+        fs.workers->submit(run.shared);
+        fs.runLastJob[run.serial & (FastState::kRunJobs - 1u)] = fs.workers->queued();
+    }
+    else
+    {
+        uint64_t pixels = 0u;
+        runRasterJob(rs, rs.simd && !frameDepthShared, vertices, RowSet{}, pixels);
+        fs.statPixels += pixels;
+    }
+
+    if (!tracked)
+    {
+        MarkVramWritten(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1);
+        if (pipe.zwrite)
+            MarkVramWritten(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1);
+        if (queued)
+        {
+            fs.markInflight(pipe.frame.bp, pipe.frame.bw, pipe.frame.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1, true, run.serial);
+            if (usesDepth)
+                fs.markInflight(pipe.depth.bp, pipe.depth.bw, pipe.depth.psm, drawn.x0, drawn.y0, drawn.x1, drawn.y1,
+                                pipe.zwrite, run.serial);
+            if (!run.mayFeedback)
+                run.coverCells(drawn, fs.cellGeneration);
+        }
+    }
+}
