+namespace
+{
+    // Size of the decoded copy along one axis: the texture size, or more when
+    // a region mode can address texels beyond it.
+    int decodeExtent(int size, uint8_t mode, int lo, int hi)
+    {
+        if (mode == 2u)
+            return std::max(size, hi + 1);
+        if (mode == 3u)
+            return std::max(size, (lo | hi) + 1);
+        return size;
+    }
+
+    // One or two ranges of the decoded copy along an axis.
+    struct AxisRanges
+    {
+        int count;
+        int lo[2];
+        int hi[2];
+    };
+
+    // Texels [lo, hi] (unwrapped) as ranges of the decoded copy. A range that crosses the
+    // repeat boundary once becomes the two ends of the texture.
+    AxisRanges wrappedRanges(int lo, int hi, int size, uint8_t mode, int regionLo, int regionHi, int extent)
+    {
+        switch (mode)
+        {
+        case 0: // REPEAT
+            if (hi - lo + 1 >= size)
+                return {1, {0, 0}, {size - 1, 0}};
+            if ((lo & ~(size - 1)) != (hi & ~(size - 1)))
+                return {2, {0, lo & (size - 1)}, {hi & (size - 1), size - 1}};
+            return {1, {lo & (size - 1), 0}, {hi & (size - 1), 0}};
+        case 1: // CLAMP
+            return {1, {GSInternal::clampInt(lo, 0, size - 1), 0}, {GSInternal::clampInt(hi, 0, size - 1), 0}};
+        case 2: // REGION_CLAMP
+            return {1, {std::min(std::max(lo, regionLo), regionHi), 0}, {std::min(std::max(hi, regionLo), regionHi), 0}};
+        default: // REGION_REPEAT
+            return {1, {0, 0}, {extent - 1, 0}};
+        }
+    }
+
+}
+
+void GSCpuBackend::FastState::Texture::decodeTile(const uint8_t *vram, int tx, int ty, uint32_t *colors, uint8_t *indices) const
+{
+    const uint32_t bp = tbp;
+    const uint32_t bw = tbw;
+    const size_t stride = static_cast<size_t>(width);
+    const BlockLayout &layout = blockLayout(psm);
+    const int x0 = tx * 16;
+    const int y0 = ty * 16;
+    const int x1 = std::min(x0 + 15, width - 1);
+    const int y1 = std::min(y0 + 15, height - 1);
+    const auto base32 = [&](uint32_t x, uint32_t y)
+    { return offsetCT32(bp, bw, x, y); };
+    const auto baseZ32 = [&](uint32_t x, uint32_t y)
+    { return offsetZ32(bp, bw, x, y); };
+    switch (psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    {
+        const bool depth = psm == GS_PSM_Z32;
+        const auto base = [&](uint32_t x, uint32_t y)
+        { return depth ? baseZ32(x, y) : base32(x, y); };
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        if (decodeBlocks32(vram, colors, stride, x0, y0, x1, y1, layout, base, [](__m128i pixels)
+                           { return pixels; }))
+            break;
+#endif
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, base, [&](uint32_t address)
+                     { return load32(vram, address); });
+        break;
+    }
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+    {
+        const bool depth = psm == GS_PSM_Z24;
+        const auto base = [&](uint32_t x, uint32_t y)
+        { return depth ? baseZ32(x, y) : base32(x, y); };
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        // expandTexelCT24, four pixels at a time.
+        const __m128i rgbMask = _mm_set1_epi32(0x00FFFFFF);
+        const __m128i alpha = _mm_set1_epi32(static_cast<int>(static_cast<uint32_t>(texa.ta0) << 24u));
+        const __m128i transparentBlack = texa.aem ? _mm_set1_epi32(-1) : _mm_setzero_si128();
+        if (decodeBlocks32(vram, colors, stride, x0, y0, x1, y1, layout, base, [&](__m128i pixels)
+                           {
+                               const __m128i rgb = _mm_and_si128(pixels, rgbMask);
+                               const __m128i black = _mm_and_si128(_mm_cmpeq_epi32(rgb, _mm_setzero_si128()), transparentBlack);
+                               return _mm_or_si128(rgb, _mm_andnot_si128(black, alpha)); }))
+            break;
+#endif
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, base, [&](uint32_t address)
+                     { return expandTexelCT24(load32(vram, address), texa); });
+        break;
+    }
+    case GS_PSM_CT16:
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        if (decodeBlocks16(vram, colors, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                           { return offsetCT16(bp, bw, x, y); }, texa))
+            break;
+#endif
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return offsetCT16(bp, bw, x, y); },
+                     [&](uint32_t address)
+                     { return expandTexelCT16(load16(vram, address), texa); });
+        break;
+    case GS_PSM_CT16S:
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return offsetCT16S(bp, bw, x, y); },
+                     [&](uint32_t address)
+                     { return expandTexelCT16(load16(vram, address), texa); });
+        break;
+    case GS_PSM_Z16:
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return offsetZ16(bp, bw, x, y); },
+                     [&](uint32_t address)
+                     { return expandTexelCT16(load16(vram, address), texa); });
+        break;
+    case GS_PSM_Z16S:
+        decodeBlocks(colors, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return offsetZ16S(bp, bw, x, y); },
+                     [&](uint32_t address)
+                     { return expandTexelCT16(load16(vram, address), texa); });
+        break;
+    case GS_PSM_T8:
+        decodeBlocks(indices, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return offsetT8(bp, bw, x, y); },
+                     [&](uint32_t address)
+                     { return vram[address]; });
+        break;
+    case GS_PSM_T4:
+        decodeBlocks(indices, stride, x0, y0, x1, y1, layout, [&](uint32_t x, uint32_t y)
+                     { return nibbleT4(bp, bw, x, y); },
+                     [&](uint32_t nibble)
+                     { return (vram[(nibble >> 1u) & 0x3FFFFFu] >> ((nibble & 1u) * 4u)) & 0x0Fu; });
+        break;
+    case GS_PSM_T8H:
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        if (decodeBlocksTopByte(vram, indices, stride, x0, y0, x1, y1, layout, base32))
+            break;
+#endif
+        decodeBlocks(indices, stride, x0, y0, x1, y1, layout, base32, [&](uint32_t address)
+                     { return vram[address + 3u]; });
+        break;
+    case GS_PSM_T4HL:
+        decodeBlocks(indices, stride, x0, y0, x1, y1, layout, base32, [&](uint32_t address)
+                     { return vram[address + 3u] & 0x0Fu; });
+        break;
+    case GS_PSM_T4HH:
+        decodeBlocks(indices, stride, x0, y0, x1, y1, layout, base32, [&](uint32_t address)
+                     { return vram[address + 3u] >> 4u; });
+        break;
+    default:
+        break;
+    }
+}
+
+uint32_t GSCpuBackend::FastState::Texture::decodeTiles(const uint8_t *vram, int tx0, int ty0, int tx1, int ty1)
+{
+    uint32_t decoded = 0u;
+    for (int ty = ty0; ty <= ty1; ++ty)
+    {
+        for (int tx = tx0; tx <= tx1; ++tx)
+        {
+            const size_t tile = static_cast<size_t>(ty) * static_cast<size_t>(tilesX) + static_cast<size_t>(tx);
+            uint64_t &word = tileValid[tile >> 6u];
+            const uint64_t bit = 1ull << (tile & 63u);
+            if ((word & bit) != 0u)
+                continue;
+            word |= bit;
+            ++decoded;
+            decodeTile(vram, tx, ty, rgba.data(), index.data());
+        }
+    }
+    return decoded;
+}
+
+void GSCpuBackend::FastState::Texture::claimTiles(int tx0, int ty0, int tx1, int ty1, std::vector<uint32_t> &tiles)
+{
+    for (int ty = ty0; ty <= ty1; ++ty)
+    {
+        for (int tx = tx0; tx <= tx1; ++tx)
+        {
+            const size_t tile = static_cast<size_t>(ty) * static_cast<size_t>(tilesX) + static_cast<size_t>(tx);
+            uint64_t &word = tileValid[tile >> 6u];
+            const uint64_t bit = 1ull << (tile & 63u);
+            if ((word & bit) != 0u)
+                continue;
+            word |= bit;
+            tiles.push_back(static_cast<uint32_t>(tile));
+        }
+    }
+}
+
+// Finds or makes the decoded copy of the run's texture and sets up how it is sampled. False
+// for formats this path does not sample.
+bool GSCpuBackend::PrepareRunTexture()
+{
+    FastState &fs = *m_fast;
+    FastState::Run &run = fs.run;
+    const GSDrawState &state = run.state;
+    const GSContext &ctx = state.context;
+    const GSTex0Reg &tex0 = ctx.tex0;
+    const uint8_t psm = tex0.psm;
+    const bool indexed = isFourBitIndexedPsm(psm) || isEightBitIndexedPsm(psm);
+    if (!indexed && !isColorSurfacePsm(psm) && !isDepthSurfacePsm(psm))
+        return false;
+
+    TexSampler &out = run.rs.tex;
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    out.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    out.wrapV = static_cast<uint8_t>((clamp >> 2u) & 0x3u);
+    out.minU = static_cast<int>((clamp >> 4u) & 0x3FFu);
+    out.maxU = static_cast<int>((clamp >> 14u) & 0x3FFu);
+    out.minV = static_cast<int>((clamp >> 24u) & 0x3FFu);
+    out.maxV = static_cast<int>((clamp >> 34u) & 0x3FFu);
+    const int width = decodeExtent(texW, out.wrapU, out.minU, out.maxU);
+    const int height = decodeExtent(texH, out.wrapV, out.minV, out.maxV);
+
+    // TEXA only changes how RGB24 and RGBA16 texels expand.
+    const bool usesTexa = !indexed && psm != GS_PSM_CT32 && psm != GS_PSM_Z32;
+    const GSTexaReg texa = usesTexa ? state.texa : GSTexaReg{};
+
+    const auto matches = [&](const FastState::Texture &t)
+    {
+        return t.tbp == tex0.tbp0 && t.tbw == tex0.tbw && t.psm == psm && t.width == width && t.height == height &&
+               t.texa.ta0 == texa.ta0 && t.texa.ta1 == texa.ta1 && t.texa.aem == texa.aem;
+    };
+
+    FastState::Texture *entry = (fs.lastTexture && matches(*fs.lastTexture)) ? fs.lastTexture : nullptr;
+    if (!entry)
+    {
+        for (const auto &candidate : fs.textures)
+        {
+            if (matches(*candidate))
+            {
+                entry = candidate.get();
+                break;
+            }
+        }
+    }
+
+    if (!entry)
+    {
+        constexpr size_t kMaxTextures = 256u;
+        constexpr size_t kMaxBytes = 96u * 1024u * 1024u;
+        const size_t texels = static_cast<size_t>(width) * static_cast<size_t>(height);
+        const size_t bytes = texels * (indexed ? 1u : 4u);
+        while (!fs.textures.empty() && (fs.textures.size() >= kMaxTextures || fs.textureBytes + bytes > kMaxBytes))
+        {
+            auto oldest = std::min_element(fs.textures.begin(), fs.textures.end(), [](const auto &a, const auto &b)
+                                           { return a->lastUse < b->lastUse; });
+            for (uint16_t page : (*oldest)->pages)
+                --fs.pageTextures[page];
+            fs.textureBytes -= (*oldest)->bytes();
+            if (fs.lastTexture == oldest->get())
+                fs.lastTexture = nullptr;
+            fs.retireTexture(std::move(*oldest)); // queued primitives may still sample it
+            fs.textures.erase(oldest);
+        }
+        if (fs.deferredBytes > 256u * 1024u * 1024u)
+            fs.reclaimFinished(fs.completedJobs());
+        if (fs.deferredBytes > 256u * 1024u * 1024u)
+            FinishRaster();
+
+        auto created = std::make_unique<FastState::Texture>();
+        created->tbp = tex0.tbp0;
+        created->tbw = tex0.tbw;
+        created->psm = psm;
+        created->width = width;
+        created->height = height;
+        created->texa = texa;
+        if (indexed)
+            created->index.assign(texels + 8u, 0u); // the vector code loads four bytes per texel
+        else
+            created->rgba.assign(texels, 0u);
+        created->tilesX = (width + 15) / 16;
+        created->tilesY = (height + 15) / 16;
+        created->tileValid.assign((static_cast<size_t>(created->tilesX) * created->tilesY + 63u) / 64u, 0ull);
+
+        std::array<bool, 512> seen{};
+        forEachPage(tex0.tbp0, tex0.tbw, psm, 0, 0, width - 1, height - 1, [&](uint32_t page)
+                    {
+                        if (!seen[page])
+                        {
+                            seen[page] = true;
+                            created->pages.push_back(static_cast<uint16_t>(page));
+                        } });
+        for (uint16_t page : created->pages)
+            ++fs.pageTextures[page];
+        created->pageLo = *std::min_element(created->pages.begin(), created->pages.end());
+        created->pageHi = *std::max_element(created->pages.begin(), created->pages.end());
+
+        // Which tiles read which page, so that a write to a page drops only those.
+        std::array<int16_t, 512> pageSlot;
+        pageSlot.fill(-1);
+        for (size_t k = 0; k < created->pages.size(); ++k)
+            pageSlot[created->pages[k]] = static_cast<int16_t>(k);
+        const auto forEachTilePage = [&](auto &&fn)
+        {
+            for (int ty = 0; ty < created->tilesY; ++ty)
+                for (int tx = 0; tx < created->tilesX; ++tx)
+                    forEachPage(tex0.tbp0, tex0.tbw, psm, tx * 16, ty * 16, std::min(tx * 16 + 15, width - 1),
+                                std::min(ty * 16 + 15, height - 1), [&](uint32_t page)
+                                {
+                                    if (pageSlot[page] >= 0)
+                                        fn(static_cast<uint32_t>(ty * created->tilesX + tx), static_cast<size_t>(pageSlot[page])); });
+        };
+        created->pageTileStart.assign(created->pages.size() + 1u, 0u);
+        forEachTilePage([&](uint32_t, size_t slot)
+                        { ++created->pageTileStart[slot + 1u]; });
+        for (size_t k = 0; k < created->pages.size(); ++k)
+            created->pageTileStart[k + 1u] += created->pageTileStart[k];
+        created->pageTiles.resize(created->pageTileStart.back());
+        std::vector<uint32_t> cursor(created->pageTileStart.begin(), created->pageTileStart.end() - 1);
+        forEachTilePage([&](uint32_t tile, size_t slot)
+                        { created->pageTiles[cursor[slot]++] = tile; });
+
+        created->decodeStamp = fs.stamp;
+        created->checkedEpoch = fs.textureEpoch;
+        fs.textureBytes += created->bytes();
+        entry = created.get();
+        fs.textures.push_back(std::move(created));
+    }
+    entry->lastUse = ++fs.useClock;
+    fs.lastTexture = entry;
+    fs.preparedTexture = entry;
+    run.texture = entry;
+    run.indexed = indexed;
+
+    out.rgba = indexed ? nullptr : entry->rgba.data();
+    out.index = indexed ? entry->index.data() : nullptr;
+    out.palette = indexed ? PrepareClutPalette(tex0, state.texa) : nullptr;
+    out.stride = static_cast<size_t>(width);
+    out.texW = texW;
+    out.texH = texH;
+    out.linear = state.linearFilter;
+    out.tfx = tex0.tfx;
+    out.tcc = tex0.tcc != 0u;
+    out.scaleU = texW * 256.0;
+    out.scaleV = texH * 256.0;
+    return true;
+}
+
+// Brings the texels that a primitive of the run can sample up to date.
+void GSCpuBackend::PrepareTexels(const GSVertex *vertices)
+{
+    FastState &fs = *m_fast;
+    FastState::Run &run = fs.run;
+    const GSDrawState &state = run.state;
+    const GSContext &ctx = state.context;
+    const GSTex0Reg &tex0 = ctx.tex0;
+    const uint8_t psm = tex0.psm;
+    const bool indexed = run.indexed;
+    FastState::Texture *const entry = run.texture;
+    TexSampler &out = run.rs.tex;
+    const int texW = out.texW;
+    const int texH = out.texH;
+    const int width = entry->width;
+    const int height = entry->height;
+
+    // Drop the decoded tiles that read a page written since they were decoded.
+    if (entry->checkedEpoch != fs.textureEpoch)
+    {
+        const auto forEachStaleTile = [&](auto &&fn)
+        {
+            for (size_t k = 0; k < entry->pages.size(); ++k)
+            {
+                if (fs.pageStamp[entry->pages[k]] <= entry->decodeStamp)
+                    continue;
+                for (uint32_t i = entry->pageTileStart[k]; i < entry->pageTileStart[k + 1u]; ++i)
+                {
+                    const uint32_t tile = entry->pageTiles[i];
+                    if (fn(entry->tileValid[tile >> 6u], 1ull << (tile & 63u)))
+                        return true;
+                }
+            }
+            return false;
+        };
+        const bool stale = forEachStaleTile([](uint64_t &word, uint64_t bit)
+                                            { return (word & bit) != 0u; });
+        if (stale)
+        {
+            ++fs.statTexturesInvalidated;
+            // Queued primitives may still read the dropped texels: they are decoded again
+            // behind a barrier (after those primitives) or into new buffers, see below.
+            if (fs.workers && entry->useJob > fs.completedJobs())
+                entry->droppedUseJob = std::max(entry->droppedUseJob, entry->useJob);
+            entry->lastDrop = 1u;
+            forEachStaleTile([](uint64_t &word, uint64_t bit)
+                             {
+                                 word &= ~bit;
+                                 return false; });
+        }
+        entry->decodeStamp = fs.stamp;
+        entry->checkedEpoch = fs.textureEpoch;
+    }
+    fs.preparedTexture = entry;
+    fs.preparedPreviousUseJob = entry->useJob;
+    entry->useJob = fs.nextJob();
+
+    // Decode the part this primitive can sample: the texel bounds of its
+    // vertices (with a texel of margin for filtering), through the wrap mode.
+    const bool isSprite = state.prim.type == GS_PRIM_SPRITE;
+    const int vertexCount = isSprite ? 2 : 3;
+    bool whole = false;
+    double uMin = 0.0, uMax = 0.0, vMin = 0.0, vMax = 0.0;
+    for (int i = 0; i < vertexCount; ++i)
+    {
+        const GSVertex &v = vertices[i];
+        double u = 0.0, w = 0.0;
+        if (state.prim.fst)
+        {
+            u = v.u / 16.0;
+            w = v.v / 16.0;
+        }
+        else
+        {
+            // S/Q stays between the vertex values only while Q keeps its sign.
+            if (!(v.q > 1.0e-8f))
+            {
+                whole = true;
+                break;
+            }
+            u = static_cast<double>(v.s) / v.q * texW;
+            w = static_cast<double>(v.t) / v.q * texH;
+        }
+        if (i == 0)
+        {
+            uMin = uMax = u;
+            vMin = vMax = w;
+        }
+        else
+        {
+            uMin = std::min(uMin, u);
+            uMax = std::max(uMax, u);
+            vMin = std::min(vMin, w);
+            vMax = std::max(vMax, w);
+        }
+    }
+    constexpr double kLimit = 1.0e6;
+    if (!(uMin > -kLimit && uMax < kLimit && vMin > -kLimit && vMax < kLimit))
+        whole = true;
+
+    // Up to two ranges per axis (a range that crosses the repeat boundary), so up to four
+    // rectangles of the decoded copy.
+    AxisRanges rangesU{1, {0, 0}, {width - 1, 0}};
+    AxisRanges rangesV{1, {0, 0}, {height - 1, 0}};
+    if (!whole)
+    {
+        rangesU = wrappedRanges(static_cast<int>(std::floor(uMin)) - 1, static_cast<int>(std::floor(uMax)) + 1, texW, out.wrapU,
+                                out.minU, out.maxU, width);
+        rangesV = wrappedRanges(static_cast<int>(std::floor(vMin)) - 1, static_cast<int>(std::floor(vMax)) + 1, texH, out.wrapV,
+                                out.minV, out.maxV, height);
+    }
+    fs.preparedRects = 0;
+    bool valid = true;
+    for (int iv = 0; iv < rangesV.count; ++iv)
+    {
+        for (int iu = 0; iu < rangesU.count; ++iu)
+        {
+            // Whole tiles: what gets decoded.
+            int *const rect = fs.preparedTexels[fs.preparedRects++];
+            rect[0] = (rangesU.lo[iu] / 16) * 16;
+            rect[1] = (rangesV.lo[iv] / 16) * 16;
+            rect[2] = std::min((rangesU.hi[iu] / 16) * 16 + 15, width - 1);
+            rect[3] = std::min((rangesV.hi[iv] / 16) * 16 + 15, height - 1);
+            valid = valid && entry->tilesValid(rect[0] / 16, rect[1] / 16, rect[2] / 16, rect[3] / 16);
+        }
+    }
+    if (!valid)
+    {
+        // Decoding reads VRAM: wait only if queued primitives may still draw to the pages
+        // these tiles come from.
+        bool inflight = false;
+        for (int i = 0; i < fs.preparedRects && !inflight; ++i)
+            inflight = fs.pending(fs.pageWriteRun, entry->tbp, entry->tbw, entry->psm, fs.preparedTexels[i][0], fs.preparedTexels[i][1],
+                                  fs.preparedTexels[i][2], fs.preparedTexels[i][3]);
+        if (inflight)
+        {
+            // PS2X_GS_WAIT_LOG=1 (with PS2X_GS_STATS=1): the first few thousand of these.
+            static const bool logWaits = std::getenv("PS2X_GS_WAIT_LOG") != nullptr;
+            static int loggedWaits = 0;
+            if (logWaits && loggedWaits < 4000)
+            {
+                ++loggedWaits;
+                std::fprintf(stderr, "[gs:texwait] tbp=%u tbw=%u psm=%02x %dx%d texels %d-%d,%d-%d (%d) | frame fbp=%u fbw=%u "
+                                     "psm=%02x zbp=%u zpsm=%02x\n",
+                             entry->tbp, entry->tbw, entry->psm, entry->width, entry->height, fs.preparedTexels[0][0],
+                             fs.preparedTexels[0][2], fs.preparedTexels[0][1], fs.preparedTexels[0][3], fs.preparedRects,
+                             ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.zbuf.zbp, ctx.zbuf.psm);
+            }
+        }
+        const auto decodeStart = fs.stats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        uint32_t decoded = 0u;
+        if (inflight && fs.workers)
+        {
+            // Queued primitives still draw the pages these texels come from: the decode
+            // is queued behind them, as a barrier the rasterizer threads all get to, and the
+            // GS thread goes on. The tiles count as valid from here on in the queue.
+            std::vector<uint32_t> tiles;
+            for (int i = 0; i < fs.preparedRects; ++i)
+                entry->claimTiles(fs.preparedTexels[i][0] / 16, fs.preparedTexels[i][1] / 16, fs.preparedTexels[i][2] / 16,
+                                  fs.preparedTexels[i][3] / 16, tiles);
+            decoded = static_cast<uint32_t>(tiles.size());
+            if (!tiles.empty())
+            {
+                const FastState::Texture *const texture = entry;
+                const uint8_t *const vram = m_vram;
+                uint32_t *const colors = entry->rgba.empty() ? nullptr : entry->rgba.data();
+                uint8_t *const indices = entry->index.empty() ? nullptr : entry->index.data();
+                const uint64_t job = fs.workers->submitBarrier([texture, vram, colors, indices, tiles = std::move(tiles)]()
+                                                               {
+                                              const int across = texture->tilesX;
+                                              for (const uint32_t tile : tiles)
+                                                  texture->decodeTile(vram, static_cast<int>(tile % static_cast<uint32_t>(across)),
+                                                                      static_cast<int>(tile / static_cast<uint32_t>(across)), colors, indices); });
+                entry->pendingDecodeJob = job;
+                // Writes into these pages (uploads, draws here) wait for the decode, as they
+                // would for a draw.
+                const uint32_t serial = fs.newRun();
+                fs.runLastJob[serial & (FastState::kRunJobs - 1u)] = job;
+                for (int i = 0; i < fs.preparedRects; ++i)
+                {
+                    FastState::addPages(fs.inflightPages, entry->tbp, entry->tbw, entry->psm, fs.preparedTexels[i][0],
+                                        fs.preparedTexels[i][1], fs.preparedTexels[i][2], fs.preparedTexels[i][3]);
+                    fs.notePages(fs.pageAccessRun, serial, entry->tbp, entry->tbw, entry->psm, fs.preparedTexels[i][0],
+                                 fs.preparedTexels[i][1], fs.preparedTexels[i][2], fs.preparedTexels[i][3]);
+                }
+                fs.anyInflight = true;
+                ++fs.statQueuedDecodes;
+            }
+            // The primitive comes after the barrier: its job number moved on by one.
+            entry->useJob = fs.nextJob();
+        }
+        else
+        {
+            if (fs.workers && entry->droppedUseJob != 0u && fs.jobPending(entry->droppedUseJob))
+            {
+                // Queued primitives may still read tiles dropped as stale, which this decode
+                // could write again: it goes into other buffers instead (bounded; past that,
+                // wait for the workers). A decode queued for the old buffers writes there.
+                if (fs.deferredBytes > 256u * 1024u * 1024u)
+                    fs.reclaimFinished(fs.completedJobs());
+                if (fs.deferredBytes > 256u * 1024u * 1024u)
+                {
+                    FinishRaster();
+                }
+                else
+                {
+                    fs.replaceBuffers(*entry);
+                    std::fill(entry->tileValid.begin(), entry->tileValid.end(), 0ull); // they hold nothing yet
+                    entry->lastDrop = 2u;
+                    entry->pendingDecodeJob = 0u;
+                }
+            }
+            entry->droppedUseJob = 0u;
+            // A decode queued earlier may still write into these buffers.
+            if (fs.jobPending(entry->pendingDecodeJob))
+            {
+                fs.waitReason = FastState::WaitTexture;
+                FinishRaster();
+            }
+            for (int i = 0; i < fs.preparedRects; ++i)
+                decoded += entry->decodeTiles(m_vram, fs.preparedTexels[i][0] / 16, fs.preparedTexels[i][1] / 16,
+                                              fs.preparedTexels[i][2] / 16, fs.preparedTexels[i][3] / 16);
+        }
+        fs.statTilesDecoded += decoded;
+
+        // PS2X_GS_DECODE_LOG=<tbp>: every decode of the textures at that base - tiles, whether
+        // stale tiles (1) or all tiles (2) were dropped before, texels, draw target.
+        static const long logBase = []()
+        {
+            const char *env = std::getenv("PS2X_GS_DECODE_LOG");
+            return env ? std::strtol(env, nullptr, 0) : -1L;
+        }();
+        static int logged = 0;
+        if (logBase >= 0 && static_cast<long>(entry->tbp) == logBase && logged < 20000)
+        {
+            ++logged;
+            std::fprintf(stderr, "[gs:decode] tbp=%u psm=%02x %dx%d: %u tiles, dropped %u, texels %d-%d,%d-%d (%d) | frame fbp=%u "
+                                 "fbw=%u psm=%02x scissor %d-%d,%d-%d scanmsk=%u\n",
+                         entry->tbp, entry->psm, entry->width, entry->height, decoded, entry->lastDrop, fs.preparedTexels[0][0],
+                         fs.preparedTexels[0][2], fs.preparedTexels[0][1], fs.preparedTexels[0][3], fs.preparedRects,
+                         ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.scissor.x0, ctx.scissor.x1, ctx.scissor.y0,
+                         ctx.scissor.y1, static_cast<unsigned>(state.scanmsk & 3u));
+        }
+        entry->lastDrop = 0u;
+        if (fs.stats)
+        {
+            fs.statDecodeNs += static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - decodeStart).count());
+            FastState::TextureStat &stat =
+                fs.statTextures[(static_cast<uint64_t>(entry->tbp) << 32) | (static_cast<uint64_t>(entry->psm) << 24) |
+                                (static_cast<uint64_t>(entry->width & 0xFFF) << 12) | static_cast<uint64_t>(entry->height & 0xFFF)];
+            stat.tiles += decoded;
+            ++stat.decodes;
+        }
+    }
+
+    // PS2X_GS_DUMP_TEXTURES=1: write each texture once, as decoded, to
+    // runs/gs_textures/ (debugging aid for texture corruption).
+    static const bool dumpTextures = std::getenv("PS2X_GS_DUMP_TEXTURES") != nullptr;
+    if (dumpTextures)
+    {
+        static std::vector<uint64_t> dumped;
+        const uint64_t key = (static_cast<uint64_t>(tex0.tbp0) << 32) | (static_cast<uint64_t>(psm) << 24) |
+                             (static_cast<uint64_t>(tex0.cbp & 0x3FFFu) << 8) | (static_cast<uint64_t>(tex0.tw) << 4) | tex0.th;
+        if (std::find(dumped.begin(), dumped.end(), key) == dumped.end() && dumped.size() < 200u)
+        {
+            dumped.push_back(key);
+            FinishRaster();
+            entry->decodeTiles(m_vram, 0, 0, entry->tilesX - 1, entry->tilesY - 1);
+            const uint32_t *palette = indexed ? PrepareClutPalette(tex0, state.texa) : nullptr;
+            char name[128];
+            std::snprintf(name, sizeof(name), "runs/gs_textures/tex_%05u_psm%02x_cbp%05u_%dx%d.ppm", tex0.tbp0, psm, tex0.cbp, width, height);
+            std::FILE *file = std::fopen(name, "wb");
+            if (file)
+            {
+                std::fprintf(file, "P6\n%d %d\n255\n", width, height);
+                for (size_t i = 0; i < static_cast<size_t>(width) * height; ++i)
+                {
+                    const uint32_t c = indexed ? palette[entry->index[i]] : entry->rgba[i];
+                    const uint8_t rgb[3] = {static_cast<uint8_t>(c), static_cast<uint8_t>(c >> 8), static_cast<uint8_t>(c >> 16)};
+                    std::fwrite(rgb, 1, 3, file);
+                }
+                std::fclose(file);
+            }
+        }
+    }
+
+    // Stale buffers may have been set aside for new ones.
+    out.rgba = indexed ? nullptr : entry->rgba.data();
+    out.index = indexed ? entry->index.data() : nullptr;
+    if (indexed)
+        fs.paletteUseJob = fs.nextJob(); // the palette of PrepareRunTexture, read by this primitive too
+}
+
+const uint32_t *GSCpuBackend::PrepareClutPalette(const GSTex0Reg &tex0, const GSTexaReg &texa)
+{
+    FastState &fs = *m_fast;
+    const bool fourBit = isFourBitIndexedPsm(tex0.psm);
+    const GSTex0Reg &last = fs.paletteTex0;
+    if (fs.paletteValid && fs.paletteClutVersion == fs.clutVersion &&
+        last.cpsm == tex0.cpsm && last.csm == tex0.csm && last.csa == tex0.csa &&
+        isFourBitIndexedPsm(last.psm) == fourBit &&
+        fs.paletteTexa.ta0 == texa.ta0 && fs.paletteTexa.ta1 == texa.ta1 && fs.paletteTexa.aem == texa.aem)
+    {
+        fs.paletteUseJob = fs.nextJob();
+        return fs.palette;
+    }
+
+    // Queued primitives may still read the current palette: build the new one in a
+    // buffer of its own.
+    uint32_t *const target = fs.workers ? fs.freshPalette() : fs.currentPalette->data();
+    const uint32_t entries = fourBit ? 16u : 256u;
+    for (uint32_t i = 0; i < entries; ++i)
+        target[i] = LookupCLUT(texa, static_cast<uint8_t>(i), tex0.cpsm, tex0.csm, tex0.csa, tex0.psm);
+    fs.palette = target;
+    fs.paletteUseJob = fs.nextJob();
+    fs.paletteValid = true;
+    fs.paletteClutVersion = fs.clutVersion;
+    fs.paletteTex0 = tex0;
+    fs.paletteTexa = texa;
+    return fs.palette;
+}
+
+void GSCpuBackend::MarkVramWritten(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1)
+{
+    FastState &fs = *m_fast;
+    const uint64_t stamp = ++fs.stamp;
+    bool readByTexture = false;
+    forEachPage(bp, bw, psm, x0, y0, x1, y1, [&](uint32_t page)
+                {
+                    fs.pageStamp[page] = stamp;
+                    readByTexture |= fs.pageTextures[page] != 0u; });
+    if (readByTexture)
+        ++fs.textureEpoch;
+}
+
+void GSCpuBackend::MarkAllVramWritten()
+{
+    FastState &fs = *m_fast;
+    for (auto &texture : fs.textures)
+        fs.retireTexture(std::move(texture)); // queued primitives may still sample them
+    fs.textures.clear();
+    fs.lastTexture = nullptr;
+    fs.run.prepared = false; // its texture is gone
+    fs.textureBytes = 0u;
+    fs.pageTextures.fill(0u);
+    ++fs.stamp;
+    fs.pageStamp.fill(fs.stamp);
+    ++fs.textureEpoch;
+    fs.paletteValid = false;
+}
+
+void GSCpuBackend::SaveState(ps2x::StateWriter &out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    FinishRaster();
+    out.pod(m_clut);
+    out.pod(m_clutCbp);
+    out.pod(m_transfer);
+    out.pod(m_transferState);
+    out.podVector(m_localToHostBuffer);
+    out.u64(m_localToHostReadPos);
+}
+
+void GSCpuBackend::LoadState(ps2x::StateReader &in)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    FinishRaster();
+    in.pod(m_clut);
+    in.pod(m_clutCbp);
+    in.pod(m_transfer);
+    in.pod(m_transferState);
+    in.podVector(m_localToHostBuffer);
+    m_localToHostReadPos = static_cast<size_t>(in.u64());
+    m_texturePageCache.Invalidate();
+    ++m_fast->clutVersion;
+    MarkAllVramWritten();
+}
