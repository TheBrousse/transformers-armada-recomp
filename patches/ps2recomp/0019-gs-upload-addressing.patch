-void GSCpuBackend::PresentQueued(const GSPresentationRequest &request, std::function<void(PresentationFrame &&)> done)
-{
-    std::lock_guard<std::mutex> lock(m_mutex);
-    if (!m_fast->workers)
-    {
-        done(PresentUnlocked(request, true));
-        return;
-    }
-    // A rasterizer thread builds it once the others are through what came before; the GS
-    // thread goes on. The frame of the last call is not reused here: whether its pages were
-    // written since is the GS thread's to know.
-    m_fast->workers->submitBarrier([this, request, done = std::move(done)]()
-                                   { done(PresentUnlocked(request, false)); });
-    m_fast->workers->announce(true);
-}
-
-void GSCpuBackend::CaptureQueued(const GSTransferCommand &command, std::function<void(std::vector<uint8_t> &&)> done)
-{
-    std::lock_guard<std::mutex> lock(m_mutex);
-    const uint8_t *const vram = m_vram;
-    const ReadVramFunc read = m_readVramFuncs[command.bitbltbuf.spsm & 0x3Fu];
-    // The region as PerformLocalToHostTransfer reads it, from any thread: nothing of the
-    // transfer state is touched.
-    auto work = [vram, read, command, done = std::move(done)]()
-    {
-        std::vector<uint8_t> bytes;
-        const uint32_t rrw = command.trxreg.rrw;
-        const uint32_t rrh = command.trxreg.rrh;
-        const uint32_t sbw = std::max<uint32_t>(command.bitbltbuf.sbw, 1u);
-        const uint8_t spsm = command.bitbltbuf.spsm;
-        const uint32_t bpp = static_cast<uint32_t>(GSMem::BitsPerPixel(static_cast<GSMem::PixelStorageMode>(spsm)));
-        const uint32_t total = rrw * rrh;
-        if (vram && total != 0u)
-        {
-            bytes.reserve((static_cast<size_t>(total) * bpp + 7u) / 8u);
-            const auto at = [&](uint32_t pixel)
-            {
-                return read(const_cast<uint8_t *>(vram), command.bitbltbuf.sbp, sbw, pixel % rrw + command.trxpos.ssax,
-                            pixel / rrw + command.trxpos.ssay);
-            };
-            for (uint32_t pixel = 0u; pixel < total; ++pixel)
-            {
-                const uint32_t value = at(pixel);
-                if (bpp == 4u)
-                {
-                    if ((pixel & 1u) != 0u)
-                        continue;
-                    const uint32_t next = pixel + 1u < total ? at(pixel + 1u) : 0u;
-                    bytes.push_back(static_cast<uint8_t>((value & 0x0Fu) | ((next & 0x0Fu) << 4u)));
-                    continue;
-                }
-                for (uint32_t shift = 0u; shift < bpp; shift += 8u)
-                    bytes.push_back(static_cast<uint8_t>(value >> shift));
-            }
-        }
-        done(std::move(bytes));
-    };
-    if (!m_fast->workers)
-    {
-        work();
-        return;
-    }
-    m_fast->workers->submitBarrier(std::move(work));
-    m_fast->workers->announce(true);
-}
-
-PresentationFrame GSCpuBackend::PresentUnlocked(const GSPresentationRequest &request, bool reuseAllowed)
-{
-    if (!m_vram || m_vramSize == 0u)
-        return {};
-
-    // PS2X_GS_DUMP_VRAM_AT=<seconds> or PS2X_GS_DUMP_VRAM_TICK=<vsync tick>: save local
-    // memory and the display registers once, that long after the first presented frame
-    // or at that VBlank, to runs/vram.bin and runs/vram.txt (see tools/vram_view.py).
-    static const double dumpAt = []()
-    {
-        const char *env = std::getenv("PS2X_GS_DUMP_VRAM_AT");
-        return env ? std::atof(env) : -1.0;
-    }();
-    static const uint64_t dumpTick = []()
-    {
-        const char *env = std::getenv("PS2X_GS_DUMP_VRAM_TICK");
-        return env ? std::strtoull(env, nullptr, 10) : 0ull;
-    }();
-    if (dumpAt >= 0.0 || dumpTick != 0u)
-    {
-        static const auto firstPresent = std::chrono::steady_clock::now();
-        static bool dumped = false;
-        const bool due = (dumpAt >= 0.0 &&
-                          std::chrono::duration<double>(std::chrono::steady_clock::now() - firstPresent).count() >= dumpAt) ||
-                         (dumpTick != 0u && request.vsyncTick >= dumpTick);
-        if (!dumped && due)
-        {
-            dumped = true;
-            if (std::FILE *file = std::fopen("runs/vram.bin", "wb"))
-            {
-                std::fwrite(m_vram, 1, m_vramSize, file);
-                std::fclose(file);
-            }
-            if (std::FILE *file = std::fopen("runs/vram.txt", "w"))
-            {
-                std::fprintf(file, "pmode=%llx smode2=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx bgcolor=%llx\n",
-                             static_cast<unsigned long long>(request.pmode), static_cast<unsigned long long>(request.smode2),
-                             static_cast<unsigned long long>(request.dispfb1), static_cast<unsigned long long>(request.display1),
-                             static_cast<unsigned long long>(request.dispfb2), static_cast<unsigned long long>(request.display2),
-                             static_cast<unsigned long long>(request.bgcolor));
-                for (int i = 0; i < 2; ++i)
-                    std::fprintf(file, "context%d frame fbp=%u fbw=%u psm=%u\n", i + 1, request.contextFrames[i].fbp,
-                                 request.contextFrames[i].fbw, request.contextFrames[i].psm);
-                std::fclose(file);
-            }
-        }
-    }
-
-    // The frame of the last call again if the registers are the same and none of the pages
-    // it was made from has been written since (a game that draws at 30 fps is presented
-    // twice per frame).
-    FastState &fs = *m_fast;
-    const auto sameFrame = [](const GSFrameReg &a, const GSFrameReg &b)
-    { return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm && a.fbmsk == b.fbmsk; };
-    const GSPresentationRequest &last = fs.presentRequest;
-    bool reuse = fs.presentReusable && last.pmode == request.pmode && last.smode2 == request.smode2 &&
-                 last.dispfb1 == request.dispfb1 && last.display1 == request.display1 && last.dispfb2 == request.dispfb2 &&
-                 last.display2 == request.display2 && last.bgcolor == request.bgcolor &&
-                 sameFrame(last.contextFrames[0], request.contextFrames[0]) &&
-                 sameFrame(last.contextFrames[1], request.contextFrames[1]) &&
-                 last.hasPreferredSource == request.hasPreferredSource && last.preferredDestFbp == request.preferredDestFbp &&
-                 sameFrame(last.preferredSource, request.preferredSource);
-    for (size_t i = 0; reuse && i < fs.presentPages.size(); ++i)
-        reuse = fs.pageStamp[fs.presentPages[i]] <= fs.presentStamp;
-    reuse = reuse && reuseAllowed;
-
-    PresentationFrame frame;
-    if (reuse)
-    {
-        frame = fs.presentFrame;
-    }
-    else
-    {
-        fs.presentPages.clear();
-        fs.presentReusable = true; // PresentFromLocalMemory clears it for sources it cannot track
-        frame = PresentFromLocalMemory(request);
-        fs.presentRequest = request;
-        fs.presentStamp = fs.stamp;
-        fs.presentReusable = fs.presentReusable && reuseAllowed;
-        if (fs.presentReusable)
-            fs.presentFrame = frame;
-    }
-    return frame;
-}
