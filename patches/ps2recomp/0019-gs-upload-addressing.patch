-    // Offsets of the pixels of one block from its first pixel: bytes, or nibbles for 4-bit
-    // texels. Textures are decoded block by block - one address computation per block, then
-    // loads through this table.
-    struct BlockLayout
-    {
-        int width = 8; // block size in pixels
-        int height = 8;
-        uint16_t offset[16][32] = {};
-        bool columns32 = false; // the standard 32-bit layout: columns of 16 words, two rows each
-    };
-
-    template <typename Address>
-    BlockLayout makeBlockLayout(int width, int height, Address &&address)
-    {
-        BlockLayout layout;
-        layout.width = width;
-        layout.height = height;
-        const uint32_t base = address(0u, 0u);
-        for (int y = 0; y < height; ++y)
-            for (int x = 0; x < width; ++x)
-                layout.offset[y][x] = static_cast<uint16_t>(address(static_cast<uint32_t>(x), static_cast<uint32_t>(y)) - base);
-        return layout;
-    }
-
-    BlockLayout makeBlockLayout32(bool depth)
-    {
-        BlockLayout layout = depth ? makeBlockLayout(8, 8, [](uint32_t x, uint32_t y)
-                                                     { return offsetZ32(0u, 16u, x, y); })
-                                   : makeBlockLayout(8, 8, [](uint32_t x, uint32_t y)
-                                                     { return offsetCT32(0u, 16u, x, y); });
-        layout.columns32 = true;
-        for (int y = 0; y < 8; ++y)
-            for (int x = 0; x < 8; ++x)
-                layout.columns32 = layout.columns32 &&
-                                   layout.offset[y][x] == 4 * ((y >> 1) * 16 + (y & 1) * 2 + (x >> 1) * 4 + (x & 1));
-        return layout;
-    }
-
-    const BlockLayout &blockLayout(uint8_t psm)
-    {
-        static const BlockLayout color32 = makeBlockLayout32(false);
-        static const BlockLayout depth32 = makeBlockLayout32(true);
-        static const BlockLayout color16 = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
-                                                           { return offsetCT16(0u, 16u, x, y); });
-        static const BlockLayout color16S = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
-                                                            { return offsetCT16S(0u, 16u, x, y); });
-        static const BlockLayout depth16 = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
-                                                           { return offsetZ16(0u, 16u, x, y); });
-        static const BlockLayout depth16S = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
-                                                            { return offsetZ16S(0u, 16u, x, y); });
-        static const BlockLayout index8 = makeBlockLayout(16, 16, [](uint32_t x, uint32_t y)
-                                                          { return offsetT8(0u, 16u, x, y); });
-        static const BlockLayout index4 = makeBlockLayout(32, 16, [](uint32_t x, uint32_t y)
-                                                          { return nibbleT4(0u, 16u, x, y); });
-        switch (psm)
-        {
-        case GS_PSM_Z32:
-        case GS_PSM_Z24:
-            return depth32;
-        case GS_PSM_CT16:
-            return color16;
-        case GS_PSM_CT16S:
-            return color16S;
-        case GS_PSM_Z16:
-            return depth16;
-        case GS_PSM_Z16S:
-            return depth16S;
-        case GS_PSM_T8:
-            return index8;
-        case GS_PSM_T4:
-            return index4;
-        default: // CT32, CT24 and the indices in their top byte
-            return color32;
-        }
-    }
