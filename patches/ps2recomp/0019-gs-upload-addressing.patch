-#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
-    // Whole 8x8 blocks of 32-bit pixels: a column of 16 words holds two rows of the block,
-    // the first in words 0, 1, 4, 5, 8, 9, 12, 13. `expand` maps four pixels at a time.
-    template <typename BlockBase, typename Expand>
-    GS_FAST_INLINE bool decodeBlocks32(const uint8_t *vram, uint32_t *out, size_t stride, int x0, int y0, int x1, int y1,
-                                       const BlockLayout &layout, BlockBase &&blockBase, Expand &&expand)
-    {
-        if (!layout.columns32 || ((x0 | y0) & 7) != 0 || ((x1 + 1) & 7) != 0 || ((y1 + 1) & 7) != 0)
-            return false;
-        for (int by = y0; by <= y1; by += 8)
-        {
-            for (int bx = x0; bx <= x1; bx += 8)
-            {
-                const uint8_t *const block = vram + blockBase(static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
-                uint32_t *row = out + static_cast<size_t>(by) * stride + static_cast<size_t>(bx);
-                for (int column = 0; column < 4; ++column, row += 2u * stride)
-                {
-                    const __m128i a = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64));
-                    const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 16));
-                    const __m128i c = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 32));
-                    const __m128i d = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 48));
-                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row), expand(_mm_unpacklo_epi64(a, b)));
-                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + 4), expand(_mm_unpacklo_epi64(c, d)));
-                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + stride), expand(_mm_unpackhi_epi64(a, b)));
-                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + stride + 4), expand(_mm_unpackhi_epi64(c, d)));
-                }
-            }
-        }
-        return true;
-    }
