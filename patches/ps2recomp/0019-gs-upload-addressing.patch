-            }
-            if (!covers1)
-            {
-                for (uint32_t y = 0; y < rows2; ++y)
-                    std::memcpy(result.pixels.data() + (y + row2) * rowBytes, crt2.data() + y * rowBytes, width2 * 4u);
-            }
-            if (opaque1)
-            {
-                for (uint32_t y = 0; y < rows1; ++y)
-                    std::memcpy(result.pixels.data() + (y + row1) * rowBytes, crt1.data() + y * rowBytes, width1 * 4u);
-            }
-            else if (show1)
-            {
-                for (uint32_t y = 0; y < rows1; ++y)
-                    for (uint32_t x = 0; x < width1; ++x)
-                    {
-                        const uint8_t *src = crt1.data() + (y * kHostFrameWidth + x) * 4u;
-                        uint8_t *dst = result.pixels.data() + ((y + row1) * kHostFrameWidth + x) * 4u;
