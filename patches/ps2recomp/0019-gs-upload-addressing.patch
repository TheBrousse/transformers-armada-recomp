-{
-    // Size of the decoded copy along one axis: the texture size, or more when
-    // a region mode can address texels beyond it.
-    int decodeExtent(int size, uint8_t mode, int lo, int hi)
-    {
-        if (mode == 2u)
-            return std::max(size, hi + 1);
-        if (mode == 3u)
-            return std::max(size, (lo | hi) + 1);
-        return size;
-    }
-
-    // One or two ranges of the decoded copy along an axis.
-    struct AxisRanges
-    {
-        int count;
-        int lo[2];
-        int hi[2];
-    };
-
-    // Texels [lo, hi] (unwrapped) as ranges of the decoded copy. A range that crosses the
-    // repeat boundary once becomes the two ends of the texture.
-    AxisRanges wrappedRanges(int lo, int hi, int size, uint8_t mode, int regionLo, int regionHi, int extent)
-    {
-        switch (mode)
-        {
-        case 0: // REPEAT
-            if (hi - lo + 1 >= size)
-                return {1, {0, 0}, {size - 1, 0}};
-            if ((lo & ~(size - 1)) != (hi & ~(size - 1)))
-                return {2, {0, lo & (size - 1)}, {hi & (size - 1), size - 1}};
-            return {1, {lo & (size - 1), 0}, {hi & (size - 1), 0}};
-        case 1: // CLAMP
-            return {1, {GSInternal::clampInt(lo, 0, size - 1), 0}, {GSInternal::clampInt(hi, 0, size - 1), 0}};
-        case 2: // REGION_CLAMP
-            return {1, {std::min(std::max(lo, regionLo), regionHi), 0}, {std::min(std::max(hi, regionLo), regionHi), 0}};
-        default: // REGION_REPEAT
-            return {1, {0, 0}, {extent - 1, 0}};
-        }
-    }
-
-}
