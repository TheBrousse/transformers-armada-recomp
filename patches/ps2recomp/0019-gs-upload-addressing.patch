-    {
-        if (!logBarriers || loggedBarriers >= 6000)
-            return;
-        ++loggedBarriers;
-        std::fprintf(stderr, "[gs:barrier] %s %s %d-%d,%d-%d | frame fbp=%u fbw=%u psm=%02x zbp=%u zpsm=%02x z=%d/%u | tex %s tbp=%u tbw=%u psm=%02x"
-                             " fst=%d linear=%d texels %d-%d,%d-%d | uv %.2f,%.2f %.2f,%.2f %.2f,%.2f q %.3f %.3f %.3f\n",
-                     why, rs.sprite ? "sprite" : "tri", drawn.x0, drawn.x1, drawn.y0, drawn.y1, pipe.frame.bp / 32u, pipe.frame.bw,
-                     pipe.frame.psm, pipe.depth.bp / 32u, pipe.depth.psm, pipe.zwrite ? 1 : 0, static_cast<unsigned>(pipe.ztst),
-                     run.texture ? "yes" : "no", run.texture ? run.texture->tbp : 0u, run.texture ? run.texture->tbw : 0u,
-                     run.texture ? run.texture->psm : 0u, run.state.prim.fst ? 1 : 0, rs.tex.linear ? 1 : 0,
