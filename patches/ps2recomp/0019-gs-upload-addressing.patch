+{
+    // Offsets of the pixels of one block from its first pixel: bytes, or nibbles for 4-bit
+    // texels. Textures are decoded block by block - one address computation per block, then
+    // loads through this table.
+    struct BlockLayout
+    {
+        int width = 8; // block size in pixels
+        int height = 8;
+        uint16_t offset[16][32] = {};
+        bool columns32 = false; // the standard 32-bit layout: columns of 16 words, two rows each
+    };
+
+    template <typename Address>
+    BlockLayout makeBlockLayout(int width, int height, Address &&address)
+    {
+        BlockLayout layout;
+        layout.width = width;
+        layout.height = height;
+        const uint32_t base = address(0u, 0u);
+        for (int y = 0; y < height; ++y)
+            for (int x = 0; x < width; ++x)
+                layout.offset[y][x] = static_cast<uint16_t>(address(static_cast<uint32_t>(x), static_cast<uint32_t>(y)) - base);
+        return layout;
+    }
+
+    BlockLayout makeBlockLayout32(bool depth)
+    {
+        BlockLayout layout = depth ? makeBlockLayout(8, 8, [](uint32_t x, uint32_t y)
+                                                     { return offsetZ32(0u, 16u, x, y); })
+                                   : makeBlockLayout(8, 8, [](uint32_t x, uint32_t y)
+                                                     { return offsetCT32(0u, 16u, x, y); });
+        layout.columns32 = true;
+        for (int y = 0; y < 8; ++y)
+            for (int x = 0; x < 8; ++x)
+                layout.columns32 = layout.columns32 &&
+                                   layout.offset[y][x] == 4 * ((y >> 1) * 16 + (y & 1) * 2 + (x >> 1) * 4 + (x & 1));
+        return layout;
+    }
+
+    const BlockLayout &blockLayout(uint8_t psm)
+    {
+        static const BlockLayout color32 = makeBlockLayout32(false);
+        static const BlockLayout depth32 = makeBlockLayout32(true);
+        static const BlockLayout color16 = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
+                                                           { return offsetCT16(0u, 16u, x, y); });
+        static const BlockLayout color16S = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
+                                                            { return offsetCT16S(0u, 16u, x, y); });
+        static const BlockLayout depth16 = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
+                                                           { return offsetZ16(0u, 16u, x, y); });
+        static const BlockLayout depth16S = makeBlockLayout(16, 8, [](uint32_t x, uint32_t y)
+                                                            { return offsetZ16S(0u, 16u, x, y); });
+        static const BlockLayout index8 = makeBlockLayout(16, 16, [](uint32_t x, uint32_t y)
+                                                          { return offsetT8(0u, 16u, x, y); });
+        static const BlockLayout index4 = makeBlockLayout(32, 16, [](uint32_t x, uint32_t y)
+                                                          { return nibbleT4(0u, 16u, x, y); });
+        switch (psm)
+        {
+        case GS_PSM_Z32:
+        case GS_PSM_Z24:
+            return depth32;
+        case GS_PSM_CT16:
+            return color16;
+        case GS_PSM_CT16S:
+            return color16S;
+        case GS_PSM_Z16:
+            return depth16;
+        case GS_PSM_Z16S:
+            return depth16S;
+        case GS_PSM_T8:
+            return index8;
+        case GS_PSM_T4:
+            return index4;
+        default: // CT32, CT24 and the indices in their top byte
+            return color32;
+        }
+    }
+
+    // Texels [x0, x1] x [y0, y1] of a texture into `out`. `blockBase(x, y)` is the address of
+    // the block whose first pixel is (x, y), `load(address)` the texel at an address.
+    template <typename T, typename BlockBase, typename Load>
+    GS_FAST_INLINE void decodeBlocks(T *out, size_t stride, int x0, int y0, int x1, int y1, const BlockLayout &layout,
+                                     BlockBase &&blockBase, Load &&load)
+    {
+        for (int by = y0 & ~(layout.height - 1); by <= y1; by += layout.height)
+        {
+            const int ys = std::max(by, y0);
+            const int ye = std::min(by + layout.height - 1, y1);
+            for (int bx = x0 & ~(layout.width - 1); bx <= x1; bx += layout.width)
+            {
+                const int xs = std::max(bx, x0);
+                const int xe = std::min(bx + layout.width - 1, x1);
+                const uint32_t base = blockBase(static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
+                for (int y = ys; y <= ye; ++y)
+                {
+                    T *const row = out + static_cast<size_t>(y) * stride;
+                    const uint16_t *const offsets = layout.offset[y - by];
+                    for (int x = xs; x <= xe; ++x)
+                        row[x] = static_cast<T>(load(base + offsets[x - bx]));
+                }
+            }
+        }
+    }
+
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+    // Whole 8x8 blocks of 32-bit pixels: a column of 16 words holds two rows of the block,
+    // the first in words 0, 1, 4, 5, 8, 9, 12, 13. `expand` maps four pixels at a time.
+    template <typename BlockBase, typename Expand>
+    GS_FAST_INLINE bool decodeBlocks32(const uint8_t *vram, uint32_t *out, size_t stride, int x0, int y0, int x1, int y1,
+                                       const BlockLayout &layout, BlockBase &&blockBase, Expand &&expand)
+    {
+        if (!layout.columns32 || ((x0 | y0) & 7) != 0 || ((x1 + 1) & 7) != 0 || ((y1 + 1) & 7) != 0)
+            return false;
+        for (int by = y0; by <= y1; by += 8)
+        {
+            for (int bx = x0; bx <= x1; bx += 8)
+            {
+                const uint8_t *const block = vram + blockBase(static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
+                uint32_t *row = out + static_cast<size_t>(by) * stride + static_cast<size_t>(bx);
+                for (int column = 0; column < 4; ++column, row += 2u * stride)
+                {
+                    const __m128i a = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64));
+                    const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 16));
+                    const __m128i c = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 32));
+                    const __m128i d = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 48));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row), expand(_mm_unpacklo_epi64(a, b)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + 4), expand(_mm_unpacklo_epi64(c, d)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + stride), expand(_mm_unpackhi_epi64(a, b)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + stride + 4), expand(_mm_unpackhi_epi64(c, d)));
+                }
+            }
+        }
+        return true;
+    }
+
+    // Whole 8x8 blocks of 32-bit words whose top byte is an index (PSMT8H).
+    template <typename BlockBase>
+    GS_FAST_INLINE bool decodeBlocksTopByte(const uint8_t *vram, uint8_t *out, size_t stride, int x0, int y0, int x1, int y1,
+                                            const BlockLayout &layout, BlockBase &&blockBase)
+    {
+        if (!layout.columns32 || ((x0 | y0) & 7) != 0 || ((x1 + 1) & 7) != 0 || ((y1 + 1) & 7) != 0)
+            return false;
+        const auto topBytes = [](__m128i first, __m128i second)
+        {
+            const __m128i words = _mm_packs_epi32(_mm_srli_epi32(first, 24), _mm_srli_epi32(second, 24));
+            return _mm_packus_epi16(words, words);
+        };
+        for (int by = y0; by <= y1; by += 8)
+        {
+            for (int bx = x0; bx <= x1; bx += 8)
+            {
+                const uint8_t *const block = vram + blockBase(static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
+                uint8_t *row = out + static_cast<size_t>(by) * stride + static_cast<size_t>(bx);
+                for (int column = 0; column < 4; ++column, row += 2u * stride)
+                {
+                    const __m128i a = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64));
+                    const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 16));
+                    const __m128i c = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 32));
+                    const __m128i d = _mm_loadu_si128(reinterpret_cast<const __m128i *>(block + column * 64 + 48));
+                    _mm_storel_epi64(reinterpret_cast<__m128i *>(row),
+                                     topBytes(_mm_unpacklo_epi64(a, b), _mm_unpacklo_epi64(c, d)));
+                    _mm_storel_epi64(reinterpret_cast<__m128i *>(row + stride),
+                                     topBytes(_mm_unpackhi_epi64(a, b), _mm_unpackhi_epi64(c, d)));
+                }
+            }
+        }
+        return true;
+    }
+
+    // Whole 16x8 blocks of 16-bit pixels, expanded like expandTexelCT16 four at a time.
+    template <typename BlockBase>
+    GS_FAST_INLINE bool decodeBlocks16(const uint8_t *vram, uint32_t *out, size_t stride, int x0, int y0, int x1, int y1,
+                                       const BlockLayout &layout, BlockBase &&blockBase, const GSTexaReg &texa)
+    {
+        if (layout.width != 16 || layout.height != 8 || (x0 & 15) != 0 || ((x1 + 1) & 15) != 0 || (y0 & 7) != 0 ||
+            ((y1 + 1) & 7) != 0)
+            return false;
+        const __m128i ta0 = _mm_set1_epi32(static_cast<int>(static_cast<uint32_t>(texa.ta0) << 24u));
+        const __m128i ta1 = _mm_set1_epi32(static_cast<int>(static_cast<uint32_t>(texa.ta1) << 24u));
+        const __m128i aem = texa.aem ? _mm_set1_epi32(-1) : _mm_setzero_si128();
+        const __m128i zero = _mm_setzero_si128();
+        const auto expand = [&](__m128i p)
+        {
+            const __m128i rgb = _mm_or_si128(_mm_or_si128(_mm_slli_epi32(_mm_and_si128(p, _mm_set1_epi32(0x001F)), 3),
+                                                          _mm_slli_epi32(_mm_and_si128(p, _mm_set1_epi32(0x03E0)), 6)),
+                                             _mm_slli_epi32(_mm_and_si128(p, _mm_set1_epi32(0x7C00)), 9));
+            const __m128i high = _mm_cmpeq_epi32(_mm_and_si128(p, _mm_set1_epi32(0x8000)), _mm_set1_epi32(0x8000));
+            const __m128i black = _mm_and_si128(_mm_cmpeq_epi32(_mm_and_si128(p, _mm_set1_epi32(0x7FFF)), zero), aem);
+            const __m128i alpha = _mm_or_si128(_mm_and_si128(high, ta1), _mm_andnot_si128(high, _mm_andnot_si128(black, ta0)));
+            return _mm_or_si128(rgb, alpha);
+        };
+        for (int by = y0; by <= y1; by += 8)
+        {
+            for (int bx = x0; bx <= x1; bx += 16)
+            {
+                const uint8_t *const block = vram + blockBase(static_cast<uint32_t>(bx), static_cast<uint32_t>(by));
+                for (int y = 0; y < 8; ++y)
+                {
+                    alignas(16) uint16_t pixels[16];
+                    const uint16_t *const offsets = layout.offset[y];
+                    for (int x = 0; x < 16; ++x)
+                        std::memcpy(&pixels[x], block + offsets[x], sizeof(uint16_t));
+                    const __m128i left = _mm_load_si128(reinterpret_cast<const __m128i *>(pixels));
+                    const __m128i right = _mm_load_si128(reinterpret_cast<const __m128i *>(pixels + 8));
+                    uint32_t *const row = out + static_cast<size_t>(by + y) * stride + static_cast<size_t>(bx);
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row), expand(_mm_unpacklo_epi16(left, zero)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + 4), expand(_mm_unpackhi_epi16(left, zero)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + 8), expand(_mm_unpacklo_epi16(right, zero)));
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row + 12), expand(_mm_unpackhi_epi16(right, zero)));
+                }
+            }
+        }
+        return true;
+    }
+#endif
+}
