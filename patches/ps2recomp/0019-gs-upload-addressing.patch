-uint32_t GSCpuBackend::FastState::Texture::decodeTiles(const uint8_t *vram, int tx0, int ty0, int tx1, int ty1)
-{
-    uint32_t decoded = 0u;
-    for (int ty = ty0; ty <= ty1; ++ty)
-    {
-        for (int tx = tx0; tx <= tx1; ++tx)
-        {
-            const size_t tile = static_cast<size_t>(ty) * static_cast<size_t>(tilesX) + static_cast<size_t>(tx);
-            uint64_t &word = tileValid[tile >> 6u];
-            const uint64_t bit = 1ull << (tile & 63u);
-            if ((word & bit) != 0u)
-                continue;
-            word |= bit;
-            ++decoded;
-            decodeTile(vram, tx, ty, rgba.data(), index.data());
-        }
-    }
-    return decoded;
-}
