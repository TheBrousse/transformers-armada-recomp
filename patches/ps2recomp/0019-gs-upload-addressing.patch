-    case GS_PSM_CT16S:
-        uploadPixels<C16S>(PageTableC16S, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
-        break;
-    case GS_PSM_Z16:
-        uploadPixels<Z16>(PageTableZ16, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
-        break;
-    case GS_PSM_Z16S:
-        uploadPixels<Z16S>(PageTableZ16S, m_vram, dbp, dbw, dsax, rrw, x, y, pixels, src, changed);
