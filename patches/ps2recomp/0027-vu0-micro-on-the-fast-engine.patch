@@ -256,6 +257,11 @@ namespace
         uint64_t epoch = 1;
         uint64_t decodedGeneration = kNever;
         const uint8_t *decodedCode = nullptr;
+        // VU0 (runVu0): its 4 KB of code mirrored to the 16 KB the engine decodes (an address past
+        // 4 KB is the same instruction, as VU0 wraps), and its own code generation.
+        bool vu0 = false;
+        std::vector<uint8_t> vu0Mirror;
+        uint64_t vu0MirrorGeneration = kNever;
         const uint8_t *needFlags = nullptr; // CodeImage::needFlags of the current image
         std::vector<std::unique_ptr<CodeImage>> images;
         CodeImage *image = nullptr;
@@ -2257,7 +2263,7 @@ namespace
 
     void syncCode(Engine &e, const uint8_t *code, PS2Memory *memory)
     {
-        const uint64_t generation = memory ? memory->getVU1CodeGeneration() : kNever - 1u;
+        const uint64_t generation = memory ? (e.vu0 ? memory->getVU0CodeGeneration() : memory->getVU1CodeGeneration()) : kNever - 1u;
         if (memory && generation == e.decodedGeneration && code == e.decodedCode)
             return;
         e.decodedGeneration = generation;
@@ -2365,6 +2371,9 @@ namespace
         static thread_local Engine *lastEngine = nullptr;
         if (owner == lastOwner && lastEngine)
             return *lastEngine;
+        // (VU1 runs on the VIF1 thread, VU0's micro programs on the EE's: the table is shared)
+        static std::mutex registryMutex;
+        std::lock_guard<std::mutex> lock(registryMutex);
         std::unique_ptr<Engine> &slot = engines()[owner];
         if (!slot)
         {
@@ -3203,4 +3212,22 @@ namespace ps2vu1fast
                        dataSize, code, capturedPackets);
         }
     }
+
+    void runVu0(const void *owner, VU1State &state, uint64_t &cycle, bool &stopRequested,
+                const uint8_t *code, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+                GS &gs, PS2Memory *memory, uint32_t maxCycles)
+    {
+        Engine &e = engineFor(owner);
+        e.vu0 = true;
+        const uint64_t generation = memory ? memory->getVU0CodeGeneration() : kNever - 1u;
+        if (e.vu0Mirror.size() != kCodeBytes || !memory || generation != e.vu0MirrorGeneration)
+        {
+            e.vu0Mirror.assign(kCodeBytes, 0u);
+            if (codeSize > 0u)
+                for (uint32_t at = 0; at < kCodeBytes; at += codeSize)
+                    std::memcpy(e.vu0Mirror.data() + at, code, std::min<uint32_t>(codeSize, kCodeBytes - at));
+            e.vu0MirrorGeneration = generation;
+        }
+        run(owner, state, cycle, stopRequested, e.vu0Mirror.data(), kCodeBytes, data, dataSize, gs, memory, maxCycles, nullptr);
+    }
 }
