Subject: [PATCH] VU0 micro programs on the fast VU engine

VU0's micro programs (VCALLMS) ran on the reference interpreter, which models
every pipeline stage: in a Transformers level with water (vlxWaterEffect) they
took 78% of the EE thread (37 ms a frame). ps2vu1fast::runVu0 runs them on the
fast engine: VU0's 4 KB of code mirrored to the 16 KB it decodes (VU0 wraps),
decoded again when VU0's code generation changes; the engine table now locked
(VU0 on the EE thread, VU1 on the VIF1 thread). Measured: 96,000 runs verified
against the reference with no state or cycle difference (PS2X_VU0_FAST=verify),
the EE's frame 37 -> 10.9 ms, the picture pixel-identical. PS2X_VU0_FAST=0:
the reference.
---
 ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp | 46 +++++++++++++++++++++++--
 ps2xRuntime/src/lib/vu/ps2_vu1_fast.cpp | 29 +++++++++++++++-
 ps2xRuntime/src/lib/vu/ps2_vu1_fast.h   |  7 ++++
 3 files changed, 79 insertions(+), 3 deletions(-)

diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index 0f8c0e7..a59f3f8 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -40,6 +40,23 @@ static const void *fastVerifyKey(const VU1Interpreter *vu)
     return reinterpret_cast<const char *>(vu) + 1;
 }
 
+// VU0's micro programs (VCALLMS) on the fast engine too (ps2vu1fast::runVu0): in a Transformers level
+// with water (vlxWaterEffect) they took 78% of the EE thread on the reference interpreter.
+// PS2X_VU0_FAST=0: the reference; =verify: both, the differences reported.
+static ps2vu1fast::Mode vu0Mode()
+{
+    static const ps2vu1fast::Mode mode = []()
+    {
+        const char *env = std::getenv("PS2X_VU0_FAST");
+        if (env && *env == '0')
+            return ps2vu1fast::Mode::Reference;
+        if (env && std::strcmp(env, "verify") == 0)
+            return ps2vu1fast::Mode::Verify;
+        return ps2vu1fast::Mode::Fast;
+    }();
+    return mode;
+}
+
 static void reportVerifiedRun(uint32_t startPc, const VU1State &reference, const VU1State &fast,
                               uint64_t referenceCycles, uint64_t fastCycles,
                               const uint8_t *referenceData, const uint8_t *fastData, uint32_t dataSize,
@@ -169,7 +186,7 @@ VU1Interpreter::VU1Interpreter(Unit unit)
 
 void VU1Interpreter::resetScheduler()
 {
-    if (m_unit == Unit::VU1 && ps2vu1fast::mode() == ps2vu1fast::Mode::Fast)
+    if ((m_unit == Unit::VU1 ? ps2vu1fast::mode() : vu0Mode()) == ps2vu1fast::Mode::Fast)
     {
         // The fast engine keeps its own pipelines; clearing the unused reference ones
         // (the XGKICK buffer alone is 64 KB) on every MSCAL is wasted time.
@@ -196,7 +213,7 @@ void VU1Interpreter::resetScheduler()
     m_nextWriteSequence = 0;
     m_efuResourceReady = 0;
     m_workingClip = m_state.clip;
-    if (m_unit == Unit::VU1)
+    if (m_unit == Unit::VU1 || vu0Mode() != ps2vu1fast::Mode::Reference)
     {
         ps2vu1fast::resetPipelines(this, m_state);
         ps2vu1fast::resetPipelines(fastVerifyKey(this), m_state);
@@ -1932,6 +1949,31 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
                          uint8_t *vuData, uint32_t dataSize,
                          GS &gs, PS2Memory *memory, uint32_t maxCycles)
 {
+    if (m_unit == Unit::VU0 && vu0Mode() != ps2vu1fast::Mode::Reference && !g_vu1RunningReference)
+    {
+        if (vu0Mode() == ps2vu1fast::Mode::Fast)
+        {
+            ps2vu1fast::runVu0(this, m_state, m_cycle, m_stopRequested, vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+            m_state.cycles = m_cycle;
+            return;
+        }
+        const VU1State before = m_state;
+        const std::vector<uint8_t> dataBefore(vuData, vuData + dataSize);
+        const uint64_t cycleBefore = m_cycle;
+        g_vu1RunningReference = true;
+        run(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+        g_vu1RunningReference = false;
+        VU1State fast = before;
+        std::vector<uint8_t> fastData = dataBefore;
+        uint64_t fastCycle = cycleBefore;
+        bool fastStop = false;
+        ps2vu1fast::runVu0(fastVerifyKey(this), fast, fastCycle, fastStop, vuCode, codeSize, fastData.data(), dataSize, gs, memory,
+                           maxCycles);
+        const std::vector<uint8_t> noPackets;
+        reportVerifiedRun(before.pc, m_state, fast, m_cycle - cycleBefore, fastCycle - cycleBefore, vuData, fastData.data(), dataSize,
+                          noPackets, noPackets, ps2vu1fast::flagTracking(fastVerifyKey(this)));
+        return;
+    }
     if (m_unit == Unit::VU1 && !g_vu1RunningReference)
     {
         const ps2vu1fast::Mode mode = ps2vu1fast::mode();
