+        // The DualSense's speaker over USB: the pad is also a USB sound card ("Wireless Controller", 4 channels:
+        // 1-2 the audio, 3-4 the actuators). With the output report's path set to the speaker (OutputState::
+        // speakerRoute: channel 2 plays on it), the game's sound for it is rendered there with WASAPI in shared mode,
+        // left + right mixed to that channel, the actuator channels silent (our earlier launcher's USB stream). The
+        // endpoint is found by its name; a thread of its own renders; any failure: no USB speaker (the PC plays).
+        // (from functiondiscoverykeys_devpkey.h / ksmedia.h, written out: no GUID definitions pulled into this file)
+        const PROPERTYKEY kFriendlyName = {{0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 14};
+        const GUID kSubtypeFloat = {0x00000003, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+
+        class UsbSpeaker
+        {
+        public:
+            ~UsbSpeaker() { stop(); }
+
+            void start()
+            {
+                if (m_thread.joinable())
+                    return;
+                m_stop = false;
+                m_thread = std::thread([this]() { run(); });
+            }
+
+            void stop()
+            {
+                if (!m_thread.joinable())
+                    return;
+                m_stop = true;
+                m_thread.join();
+            }
+
+            bool running() const { return m_thread.joinable(); }
+
+        private:
+            template <typename T>
+            static void release(T *&p)
+            {
+                if (p)
+                    p->Release();
+                p = nullptr;
+            }
+
+            // The pad's render endpoint: an active one whose name has "Wireless Controller" (the DualSense's USB
+            // audio function, "Speakers (2- DualSense Wireless Controller)" and the like).
+            static IMMDevice *findEndpoint(std::string &name)
+            {
+                IMMDeviceEnumerator *enumerator = nullptr;
+                if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator),
+                                            reinterpret_cast<void **>(&enumerator))))
+                    return nullptr;
+                IMMDeviceCollection *devices = nullptr;
+                IMMDevice *found = nullptr;
+                if (SUCCEEDED(enumerator->EnumAudioEndpoints(eRender, DEVICE_STATE_ACTIVE, &devices)))
+                {
+                    UINT count = 0;
+                    devices->GetCount(&count);
+                    for (UINT i = 0; i < count && !found; ++i)
+                    {
+                        IMMDevice *device = nullptr;
+                        if (FAILED(devices->Item(i, &device)))
+                            continue;
+                        IPropertyStore *props = nullptr;
+                        if (SUCCEEDED(device->OpenPropertyStore(STGM_READ, &props)))
+                        {
+                            PROPVARIANT v;
+                            PropVariantInit(&v);
+                            if (SUCCEEDED(props->GetValue(kFriendlyName, &v)) && v.vt == VT_LPWSTR && v.pwszVal)
+                            {
+                                std::wstring w(v.pwszVal);
+                                std::wstring lowered = w;
+                                std::transform(lowered.begin(), lowered.end(), lowered.begin(),
+                                               [](wchar_t c) { return static_cast<wchar_t>(std::towlower(c)); });
+                                if (lowered.find(L"wireless controller") != std::wstring::npos)
+                                {
+                                    found = device;
+                                    device = nullptr;
+                                    name = narrow(w);
+                                }
+                            }
+                            PropVariantClear(&v);
+                            props->Release();
+                        }
+                        release(device);
+                    }
+                    devices->Release();
+                }
+                enumerator->Release();
+                return found;
+            }
+
+            void run()
+            {
+                const HRESULT com = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+                bool announcedMissing = false;
+                while (!m_stop)
+                {
+                    if (!session(announcedMissing))
+                        for (int i = 0; i < 40 && !m_stop; ++i) // (not there, or it failed: look again in 2 s)
+                            Sleep(50);
+                }
+                setSpeakerLive(false);
+                if (SUCCEEDED(com))
+                    CoUninitialize();
+            }
+
+            // One stream to the endpoint; false when it could not start.
+            bool session(bool &announcedMissing)
+            {
+                std::string name;
+                IMMDevice *device = findEndpoint(name);
+                if (!device)
+                {
+                    if (!announcedMissing)
+                        logLine("[sonypad] the DualSense's USB speaker: no \"Wireless Controller\" sound device found (yet)");
+                    announcedMissing = true;
+                    return false;
+                }
+                IAudioClient *client = nullptr;
+                IAudioRenderClient *render = nullptr;
+                WAVEFORMATEX *format = nullptr;
+                HANDLE ready = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+                bool ok = SUCCEEDED(device->Activate(__uuidof(IAudioClient), CLSCTX_ALL, nullptr, reinterpret_cast<void **>(&client))) &&
+                          SUCCEEDED(client->GetMixFormat(&format)) && ready;
+                bool isFloat = false;
+                if (ok)
+                {
+                    if (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+                        isFloat = true;
+                    else if (format->wFormatTag == WAVE_FORMAT_EXTENSIBLE && format->cbSize >= 22)
+                        isFloat = reinterpret_cast<WAVEFORMATEXTENSIBLE *>(format)->SubFormat == kSubtypeFloat;
+                    ok = (isFloat && format->wBitsPerSample == 32) || (!isFloat && format->wBitsPerSample == 16);
+                    ok = ok && format->nChannels >= 1u && format->nSamplesPerSec == 48000u;
+                    if (!ok)
+                        logLine("[sonypad] the DualSense's USB speaker: its sound device's format is not one this stream writes");
+                }
+                const REFERENCE_TIME bufferTime = 400000; // 40 ms
+                ok = ok && SUCCEEDED(client->Initialize(AUDCLNT_SHAREMODE_SHARED, AUDCLNT_STREAMFLAGS_EVENTCALLBACK, bufferTime, 0, format,
+                                                        nullptr)) &&
+                     SUCCEEDED(client->SetEventHandle(ready)) &&
+                     SUCCEEDED(client->GetService(__uuidof(IAudioRenderClient), reinterpret_cast<void **>(&render)));
+                UINT32 bufferFrames = 0;
+                ok = ok && SUCCEEDED(client->GetBufferSize(&bufferFrames)) && SUCCEEDED(client->Start());
+                if (ok)
+                {
+                    const unsigned channels = format->nChannels;
+                    // How long until the pad is heard: the cushion, the buffer kept full, the stream's own latency.
+                    REFERENCE_TIME streamLatency = 0;
+                    client->GetStreamLatency(&streamLatency);
+                    const int latencyMs = 20 + static_cast<int>(static_cast<int64_t>(bufferFrames) * 1000 / 48000) +
+                                          static_cast<int>(streamLatency / 10000);
+                    setSpeakerUsbLatencyMs(latencyMs);
+                    logLine("[sonypad] the DualSense's speaker: the game's sound plays on it over USB (\"" + name + "\", " +
+                            std::to_string(channels) + " channels, heard about " + std::to_string(latencyMs) + " ms after it is mixed)");
+                    setSpeakerLive(true);
+                    bool primed = false;
+                    std::vector<int16_t> frames;
+                    while (!m_stop)
+                    {
+                        if (WaitForSingleObject(ready, 100) != WAIT_OBJECT_0)
+                            continue;
+                        UINT32 padding = 0;
+                        if (FAILED(client->GetCurrentPadding(&padding)))
+                            break; // (the device went away: unplugged)
+                        const UINT32 room = bufferFrames - padding;
+                        if (room == 0u)
+                            continue;
+                        BYTE *data = nullptr;
+                        if (FAILED(render->GetBuffer(room, &data)))
+                            break;
+                        trimSpeaker(960u + 4800u, 960u); // (more than 100 ms over the cushion: back to it)
+                        if (!primed && speakerQueued() >= 960u)
+                            primed = true; // (20 ms held first: a jitter cushion)
+                        frames.assign(static_cast<size_t>(room) * 2u, 0);
+                        size_t have = primed ? takeSpeaker(frames.data(), room) : 0u;
+                        if (primed && have < room)
+                            primed = false; // (ran dry: silence until the cushion is back)
+                        for (UINT32 i = 0; i < room; ++i)
+                        {
+                            // left + right on channel 2 (the speaker's), the rest silent
+                            const float mono = std::clamp((frames[i * 2u] + frames[i * 2u + 1u]) * 0.75f / 32768.0f, -1.0f, 1.0f);
+                            for (unsigned c = 0; c < channels; ++c)
+                            {
+                                const float v = (c == 1u || channels == 1u) ? mono : 0.0f;
+                                if (isFloat)
+                                    reinterpret_cast<float *>(data)[i * channels + c] = v;
+                                else
+                                    reinterpret_cast<int16_t *>(data)[i * channels + c] = static_cast<int16_t>(v * 32767.0f);
+                            }
+                        }
+                        render->ReleaseBuffer(room, 0);
+                    }
+                    client->Stop();
+                    setSpeakerLive(false);
+                    setSpeakerUsbLatencyMs(-1);
+                    logLine("[sonypad] the DualSense's USB speaker stops");
+                }
+                else
+                    logLine("[sonypad] the DualSense's USB speaker cannot start: its sound stays on the PC");
+                release(render);
+                release(client);
+                if (format)
+                    CoTaskMemFree(format);
+                if (ready)
+                    CloseHandle(ready);
+                release(device);
+                return ok;
+            }
+
+            std::thread m_thread;
+            std::atomic<bool> m_stop{false};
+        };
