 #include <vector>
 
+// (FPS round 6) PS2X_LEAN_CHECKPOINT=0: EeScheduler::checkpointDue and the held cycles as before round 6 (an A/B;
+// the same cycles and the same checkpoints either way).
+extern const bool g_ps2LeanCheckpoint;
+
 // This exception is the EE equivalent of a longjmp to the dispatcher.  It is
 // not an error and must only be caught at EeScheduler::run().
 struct EeDispatcherTransfer final
@@ -349,8 +353,37 @@ public:
     // EE timers and the IOP are owed are handed on in one go when one of them could act on them
     // (flushHeldCycles), and the deadline / time slice checks go out of line when the EE clock
     // reaches the earlier of the two (m_fastEndCycle) - the same answers at the same checkpoints.
+    // (FPS round 6, PS2X_LEAN_CHECKPOINT, on by default) The same answers at the same checkpoints with fewer steps:
+    // the scale read once (m_scaleNow: the override, else the default), the held cycles worked out from the clock
+    // (the clock less m_heldBase) instead of added up beside it, and one compare against m_stopAtCycle - the earlier
+    // of the held cycles' hand-over and the fast end - before the flags. Reaching it goes out of line
+    // (checkpointLeanSlow), which hands the held cycles on, then asks what the checkpoint always asked, in its order.
     [[nodiscard]] PS2_FORCEINLINE bool checkpointDue(uint32_t cycles = kGeneratedCheckpointCycles) noexcept
     {
+        if (g_ps2LeanCheckpoint) [[likely]]
+        {
+            const uint32_t scale = m_scaleNow.load(std::memory_order_relaxed);
+            if (scale < 256u)
+            {
+                const uint32_t scaled = cycles * scale + m_cycleRemainder;
+                m_cycleRemainder = scaled & 255u;
+                cycles = scaled >> 8;
+            }
+            if (cycles != 0u)
+            {
+                m_eeCycle += cycles;
+                if (m_countContext)
+                    m_countContext->cop0_count = static_cast<uint32_t>(m_eeCycle);
+            }
+            if (m_eeCycle >= m_stopAtCycle) [[unlikely]]
+                return checkpointLeanSlow(cycles != 0u);
+            if (m_checkpointPending.load(std::memory_order_acquire) || m_stopRequested.load(std::memory_order_acquire))
+            {
+                m_unwindingForCheckpoint = true;
+                return true;
+            }
+            return false;
+        }
         const uint32_t override = m_cycleScaleOverride.load(std::memory_order_relaxed);
         const uint32_t scale = override ? override : m_defaultScale256;
         if (scale < 256u)
@@ -381,7 +414,11 @@ public:
     // and the point of the next hand-over worked out again.
     void flushHeldCycles() noexcept;
     // The next hand-over at the next checkpoint (an EE timer or the IOP may act sooner now).
-    void invalidateHeldCycles() noexcept { m_heldLimit = 0u; }
+    void invalidateHeldCycles() noexcept
+    {
+        m_heldLimit = 0u;
+        updateStopAt();
+    }
     [[nodiscard]] bool onExecutorThread() const noexcept { return std::this_thread::get_id() == m_executorThread; }
     // A factor for the cycles executed guest code is charged (0: PS2X_EE_CYCLE_SCALE, 1 by
     // default). Below 1 the EE runs faster than the console's: more code fits in a VBlank.
@@ -556,17 +593,35 @@ private:
         // between (a timer register, a call into the IOP, a save state) hands them on first
         // (ps2EeFlushHeldCycles), and whatever moves their next point forward asks for the
         // limit to be worked out again (ps2EeInvalidateHeldCycles).
+        // (Round 6, the lean checkpoint: the held cycles are the clock less m_heldBase, due at m_heldStopCycle.)
+        if (g_ps2LeanCheckpoint) [[likely]]
+        {
+            if (m_eeCycle >= m_heldStopCycle)
+                flushHeldCycles();
+            return;
+        }
         m_heldCycles += elapsed;
         if (m_heldCycles >= m_heldLimit)
             flushHeldCycles();
     }
     // The checkpoint's out-of-line part: a deadline due by the EE clock, or the time slice over.
     [[nodiscard]] bool checkpointDeadlineOrSlice() noexcept;
+    // (Round 6) The lean checkpoint's out-of-line part, once the clock reaches m_stopAtCycle: the held cycles
+    // handed on when they are due (and were just added to), then the flags, then the fast end - as checkpointDue.
+    [[nodiscard]] PS2_NOINLINE bool checkpointLeanSlow(bool accounted) noexcept;
+    // (Round 6) m_heldStopCycle and m_stopAtCycle again, after the held cycles' base or limit or the fast end moved.
+    void updateStopAt() noexcept
+    {
+        const uint64_t stop = m_heldBase + m_heldLimit;
+        m_heldStopCycle = stop < m_heldBase ? ~0ull : stop; // (a limit near the top: never)
+        m_stopAtCycle = m_heldStopCycle < m_fastEndCycle ? m_heldStopCycle : m_fastEndCycle;
+    }
     // m_fastEndCycle again: the earlier of the next deadline and the time slice's end.
     void refreshFastEnd() noexcept
     {
         const uint64_t next = m_nextDeadlineCycle.load(std::memory_order_relaxed);
         m_fastEndCycle = (next != 0u && next < m_sliceEndCycle) ? next : m_sliceEndCycle;
+        updateStopAt();
     }
     // The running thread's time slice is over: another of its priority or above takes over,
     // or the slice starts again.
@@ -574,6 +629,12 @@ private:
     uint64_t m_heldCycles = 0u;       // accounted, not yet handed to the EE timers / IOP
     uint64_t m_heldLimit = 0u;        // ... handed on once they reach this (0: at the next checkpoint)
     uint64_t m_fastEndCycle = 0u;     // min(next deadline, time slice end): below it nothing is due by the clock
+    // (Round 6, the lean checkpoint) The clock when the held cycles were last handed on (they are the clock less
+    // this), when they are due again (base + limit), and the earlier of that and the fast end.
+    uint64_t m_heldBase = 0u;
+    uint64_t m_heldStopCycle = 0u;
+    uint64_t m_stopAtCycle = 0u;
+    std::atomic<uint32_t> m_scaleNow{256u}; // the scale checkpoints charge now: the override, else the default
     uint32_t m_cycleRemainder = 0u;   // (the cycle scale's fraction carried)
     uint32_t m_defaultScale256 = 256u; // PS2X_EE_CYCLE_SCALE
     bool m_unwindingForCheckpoint = false;
