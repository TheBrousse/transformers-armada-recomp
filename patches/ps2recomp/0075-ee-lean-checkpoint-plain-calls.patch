+    const uint64_t held = g_ps2LeanCheckpoint ? m_eeCycle - m_heldBase : m_heldCycles;
     m_heldCycles = 0u;
+    m_heldBase = m_eeCycle;
     PS2Memory &memory = m_runtime.memory();
     if (held != 0u)
