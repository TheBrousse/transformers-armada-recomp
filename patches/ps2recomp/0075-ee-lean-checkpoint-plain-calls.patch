+        ctx->pc = targetPc;
+        if (m_eeScheduler && m_eeScheduler->checkpointDue(EeScheduler::kGuestDispatchCycles))
+            return false;
+        const RecompiledFunction fn = callTarget(g_dispatchThread, targetPc);
+        if (!fn) [[unlikely]]
