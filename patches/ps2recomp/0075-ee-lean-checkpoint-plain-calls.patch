+// (FPS round 6) The plain call: the switches a call looks at folded into one test made once - no hot-stats count,
+// the jal's table entry (PS2X_DIRECT_CALLS 1 or 2), the lean end (PS2X_DISPATCH_LEAN), no dispatch history
+// (PS2X_DISPATCH_HISTORY). PS2X_LEAN_CALL=0: dispatchGuestCall as in round 5 (A/B). PS2X_LEAN_BRANCH=0: a call by
+// dispatchGuestBranch (jalr, the decompiled functions' calls) through enterCall as before; with it on such a call
+// takes the lean begin and end too (what dispatchGuestCall does with its table entry: the target looked up as
+// before, its level kept, the common end in place, callEnd for the rest - the target as the call's entry, as
+// enterCall's entryPc is).
+namespace
+{
+    bool envOff(const char *name)
+    {
+        const char *env = std::getenv(name);
+        return env && *env == '0';
+    }
+    bool envOn(const char *name)
+    {
+        const char *env = std::getenv(name);
+        return env && *env == '1';
+    }
+    const bool g_plainSwitches = !g_ps2HotStats && !envOff("PS2X_DISPATCH_LEAN") && !envOn("PS2X_DISPATCH_HISTORY");
+    const bool g_plainCalls = g_plainSwitches && !envOff("PS2X_LEAN_CALL") && !envOff("PS2X_DIRECT_CALLS");
+    const bool g_plainBranchCalls = g_plainSwitches && !envOff("PS2X_LEAN_BRANCH");
+}
+
