                                      R5900Context *ctx,
                                      uint32_t targetPc,
@@ -1906,6 +1930,31 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
                                      GuestBranchKind kind,
                                      const char *debugName)
 {
+    if (g_plainBranchCalls && (kind == GuestBranchKind::DirectCall || kind == GuestBranchKind::IndirectCall)) [[likely]]
