+        Ps2DispatchLevels &levels = g_ps2DispatchLevels;
+        const uint32_t level = levels.level + 1u;
+        levels.level = level;
+        if (level < kDispatchLevels) [[likely]]
+            levels.resumedByDispatcher[level] = false;
+        fn(rdram, ctx, this);
+        if (ctx->pc == fallthroughPc && !isStopRequested() && !(level < kDispatchLevels && levels.resumedByDispatcher[level]))
+            [[likely]]
+        {
