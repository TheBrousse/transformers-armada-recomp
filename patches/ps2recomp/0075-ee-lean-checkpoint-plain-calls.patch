@@ -574,6 +587,24 @@ void EeScheduler::flushHeldCycles() noexcept
                                 ? memory.m_eeTimerDue - memory.m_eeTimerCycles
                                 : 0u;
     m_heldLimit = std::min(timers, ps2IopHeldHeadroom());
+    updateStopAt();
+}
+
+// (Round 6) The lean checkpoint once the clock has reached m_stopAtCycle: what checkpointDue asked, in its order -
+// the held cycles handed on if they are due (accountCyclesInline's test, only when cycles were just added), then
+// the flags, then the fast end and the deadline / time slice.
+bool EeScheduler::checkpointLeanSlow(bool accounted) noexcept
+{
+    if (accounted && m_eeCycle >= m_heldStopCycle)
+        flushHeldCycles();
+    if (m_checkpointPending.load(std::memory_order_acquire) || m_stopRequested.load(std::memory_order_acquire))
+    {
+        m_unwindingForCheckpoint = true;
+        return true;
+    }
+    if (m_eeCycle < m_fastEndCycle)
+        return false;
+    return checkpointDeadlineOrSlice();
 }
 
 bool EeScheduler::checkpointDeadlineOrSlice() noexcept
@@ -2950,6 +2981,8 @@ void EeScheduler::loadState(ps2x::StateReader &in)
     // (cycles held from the timeline before the load are not the loaded one's)
     m_heldCycles = 0u;
     m_heldLimit = 0u;
+    m_heldBase = m_eeCycle;
+    updateStopAt();
     m_insideInterrupt = false;
     m_unwindingForCheckpoint = false;
     m_countContext = nullptr;
