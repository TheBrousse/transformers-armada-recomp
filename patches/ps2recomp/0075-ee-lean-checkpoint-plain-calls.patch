+            --levels.level;
+            return true;
+        }
+        return callEnd(rdram, ctx, targetPc, fallthroughPc, level);
+    }
     if (g_ps2HotStats) hotNoteCall(targetPc, true);
     ctx->pc = targetPc;
     const bool isCall = (kind == GuestBranchKind::DirectCall || kind == GuestBranchKind::IndirectCall);
@@ -2019,6 +2068,28 @@ bool PS2Runtime::dispatchGuestCall(uint8_t *rdram,
