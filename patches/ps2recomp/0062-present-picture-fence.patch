+        // The next picture texture's last copy into the back buffer done (TODO 98): never waited for - asked, as the GL
+        // fences are (the thread never waits inside a driver's call).
+        bool nextPictureFree()
+        {
+            Picture &picture = g.pictures[g.next];
+            if (!picture.reading)
+                return true;
+            if (g.context->GetData(picture.read, nullptr, 0u, D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK)
+                return false;
+            picture.reading = false;
+            return true;
+        }
