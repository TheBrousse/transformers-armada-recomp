+        // PS2X_PRESENT_CAPTURE=<first>,<count>,<dir> (a checking aid): the presents numbered from 1; from <first> on,
+        // <count> of them saved as they went to the back buffer - <dir>\present_<n>.bmp at a quarter of the size, and a
+        // line each in the log with the picture's stamps (TF_NATIVE_STAMP: 16 squares in the top-left and bottom-left
+        // corners, each the picture's number's bit, read at full size here). A ring of four read-back textures, each
+        // read three presents after its copy (the copy is done by then: the wait does not hold the presents up).
+        namespace capture
+        {
+            struct Slot
+            {
+                ID3D11Texture2D *texture = nullptr;
+                uint64_t number = 0u;
+                int64_t ns = 0;
+            };
+            std::array<Slot, 4> g_ring{};
+            size_t g_next = 0u;
+            uint64_t g_first = 0u, g_count = 0u, g_presents = 0u;
+            std::string g_dir;
+            bool g_on = false, g_read = false, g_all = false; // (g_all: PS2X_PRESENT_STAMPS=1 - every present's stamps read)
+
+            void setup()
+            {
+                if (g_read)
+                    return;
+                g_read = true;
+                g_all = std::getenv("PS2X_PRESENT_STAMPS") && *std::getenv("PS2X_PRESENT_STAMPS") == '1';
+                g_on = g_all;
+                const char *v = std::getenv("PS2X_PRESENT_CAPTURE");
+                if (!v)
+                    return;
+                unsigned long long first = 0, count = 0;
+                char dir[512] = {};
+                if (std::sscanf(v, "%llu,%llu,%511[^\n]", &first, &count, dir) == 3)
+                {
+                    g_first = first;
+                    g_count = count;
+                    g_dir = dir;
+                    g_on = g_on || count > 0u;
+                    std::fprintf(stderr, "[present] capture: presents %llu..%llu to %s\n", first, first + count - 1u, dir);
+                }
+            }
+
+            // The stamp's number at (x0, y): 16 squares of `side` pixels, a red one first and last as markers.
+            int stampAt(const uint8_t *data, UINT pitch, int width, int height, int x0, int y, int side)
+            {
+                if (y < 0 || y >= height || x0 + 18 * side > width)
+                    return -2;
+                auto px = [&](int x) { return data + static_cast<size_t>(y) * pitch + static_cast<size_t>(x) * 4u; };
+                const uint8_t *m = px(x0 + side / 2);
+                if (!(m[0] > 160 && m[1] < 90 && m[2] < 90))
+                    return -1; // (no marker: no stamp)
+                int value = 0;
+                for (int b = 0; b < 16; ++b)
+                {
+                    const uint8_t *p = px(x0 + (b + 1) * side + side / 2);
+                    value |= (p[1] > 128 ? 1 : 0) << b;
+                }
+                return value;
+            }
+
+            void save(Slot &slot, ID3D11DeviceContext *context, int width, int height)
+            {
+                D3D11_MAPPED_SUBRESOURCE mapped{};
+                if (FAILED(context->Map(slot.texture, 0, D3D11_MAP_READ, 0, &mapped)))
+                    return;
+                const uint8_t *data = static_cast<const uint8_t *>(mapped.pData);
+                const int side = 16;
+                const int top = stampAt(data, mapped.RowPitch, width, height, side, side + side / 2, side);
+                const int bottom = stampAt(data, mapped.RowPitch, width, height, side, height - side - side / 2, side);
+                std::fprintf(stderr, "[present] capture %llu at %.3f ms: stamp top %d bottom %d%s\n", static_cast<unsigned long long>(slot.number),
+                             static_cast<double>(slot.ns) / 1.0e6, top, bottom, top != bottom ? "  MIXED" : "");
+                if (slot.number < g_first || slot.number >= g_first + g_count)
+                {
+                    context->Unmap(slot.texture, 0);
+                    return; // (its stamps only)
+                }
+                // a quarter of the size, 24-bit BMP (bottom-up rows)
+                const int w = width / 4, h = height / 4, rowBytes = (w * 3 + 3) & ~3;
+                std::vector<uint8_t> out(static_cast<size_t>(rowBytes) * h);
+                for (int y = 0; y < h; ++y)
+                    for (int x = 0; x < w; ++x)
+                    {
+                        const uint8_t *p = data + static_cast<size_t>(y * 4) * mapped.RowPitch + static_cast<size_t>(x * 4) * 4u;
+                        uint8_t *q = out.data() + static_cast<size_t>(h - 1 - y) * rowBytes + static_cast<size_t>(x) * 3u;
+                        q[0] = p[2];
+                        q[1] = p[1];
+                        q[2] = p[0];
+                    }
+                context->Unmap(slot.texture, 0);
+                char name[600];
+                std::snprintf(name, sizeof(name), "%s\\present_%06llu.bmp", g_dir.c_str(), static_cast<unsigned long long>(slot.number));
+                if (FILE *f = std::fopen(name, "wb"))
+                {
+                    const uint32_t size = 54u + static_cast<uint32_t>(out.size());
+                    uint8_t hdr[54] = {'B', 'M'};
+                    auto put32 = [&](int at, uint32_t v) { std::memcpy(hdr + at, &v, 4); };
+                    put32(2, size);
+                    put32(10, 54u);
+                    put32(14, 40u);
+                    put32(18, static_cast<uint32_t>(w));
+                    put32(22, static_cast<uint32_t>(h));
+                    hdr[26] = 1;
+                    hdr[28] = 24;
+                    put32(34, static_cast<uint32_t>(out.size()));
+                    std::fwrite(hdr, 1, 54, f);
+                    std::fwrite(out.data(), 1, out.size(), f);
+                    std::fclose(f);
+                }
+            }
+
+            // A present's picture (in `shown`, just copied into the back buffer): copied for reading if it is wanted.
+            void take(ID3D11Device *device, ID3D11DeviceContext *context, ID3D11Texture2D *shown, int width, int height)
+            {
+                setup();
+                if (!g_on)
+                    return;
+                const uint64_t n = ++g_presents;
+                // (the oldest in the ring read now: three presents since its copy)
+                Slot &slot = g_ring[g_next];
+                if (slot.texture && slot.number)
+                {
+                    save(slot, context, width, height);
+                    slot.number = 0u;
+                }
+                if (!g_all && (n < g_first || n >= g_first + g_count))
+                {
+                    g_next = (g_next + 1u) % g_ring.size();
+                    return;
+                }
+                if (!slot.texture)
+                {
+                    D3D11_TEXTURE2D_DESC desc{};
+                    shown->GetDesc(&desc);
+                    desc.Usage = D3D11_USAGE_STAGING;
+                    desc.BindFlags = 0u;
+                    desc.MiscFlags = 0u;
+                    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+                    if (FAILED(device->CreateTexture2D(&desc, nullptr, &slot.texture)))
+                        return;
+                }
+                context->CopyResource(slot.texture, shown);
+                slot.number = n;
+                slot.ns = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+                g_next = (g_next + 1u) % g_ring.size();
+            }
+        }
