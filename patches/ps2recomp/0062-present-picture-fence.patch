+    // (TODO 98) The fence shared by the two devices (State::shareFence). PS2X_PRESENT_FENCE=0: none, as before (an A/B).
+    static void setupFence()
+    {
+        if (std::getenv("PS2X_PRESENT_FENCE") && *std::getenv("PS2X_PRESENT_FENCE") == '0')
+            return;
+        ID3D11Device5 *share5 = nullptr, *device5 = nullptr;
+        HANDLE handle = nullptr;
+        bool ok = SUCCEEDED(g.shareDevice->QueryInterface(__uuidof(ID3D11Device5), reinterpret_cast<void **>(&share5))) &&
+                  SUCCEEDED(g.device->QueryInterface(__uuidof(ID3D11Device5), reinterpret_cast<void **>(&device5))) &&
+                  SUCCEEDED(share5->CreateFence(0u, D3D11_FENCE_FLAG_SHARED, __uuidof(ID3D11Fence), reinterpret_cast<void **>(&g.shareFence))) &&
+                  SUCCEEDED(g.shareFence->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &handle)) &&
+                  SUCCEEDED(device5->OpenSharedFence(handle, __uuidof(ID3D11Fence), reinterpret_cast<void **>(&g.presentFence))) &&
+                  SUCCEEDED(g.shareContext->QueryInterface(__uuidof(ID3D11DeviceContext4), reinterpret_cast<void **>(&g.shareContext4))) &&
+                  SUCCEEDED(g.context->QueryInterface(__uuidof(ID3D11DeviceContext4), reinterpret_cast<void **>(&g.context4)));
+        if (handle)
+            CloseHandle(handle);
+        release(share5);
+        release(device5);
+        if (!ok)
+        {
+            release(g.shareFence);
+            release(g.presentFence);
+            release(g.shareContext4);
+            release(g.context4);
+        }
+        std::fprintf(stderr, ok ? "[present] the presenting device waits on a fence for each picture's unlock\n"
+                                : "[present] no fence between the two devices (Direct3D 11.4 missing): the copies unsynchronised\n");
+    }
