+    // ---- gsupload: the uploads left out while the native renderer draws alone ----
+    // A host-to-local upload in a format nothing reads from GS memory then: the colour and indexed formats
+    // (CT32/24/16/16S, T8, T4). The top-byte views (T8H/T4HL/T4HH: the light maps, read by the native
+    // renderer) and the depth formats are made as before.
+    bool skippableFormat(uint32_t psm)
+    {
+        switch (psm)
+        {
+        case 0x00: case 0x01: case 0x02: case 0x0A: case 0x13: case 0x14:
+            return true;
+        default:
+            return false;
+        }
+    }
+    bool topByteFormat(uint32_t psm) { return psm == 0x1B || psm == 0x24 || psm == 0x2C; }
+
+    // The shadow: each destination's last upload (skipped or made, in the order they came), written back in
+    // that order when GS memory has to be whole. A destination = the transfer's BITBLTBUF/TRXPOS/TRXREG;
+    // its last data overwrites all of its rectangle, so writing every destination's last data in the order
+    // of those last writes leaves GS memory as the uploads would have.
+    struct ShadowEntry
+    {
+        GSTransferCommand command{};
+        std::vector<uint8_t> bytes;
+        uint64_t sequence = 0u;
+        uint64_t first = 0u, last = 0u; // the bytes of GS memory it can write (the 32-bit footprint: no less)
+        bool dirty = false;             // its data in the shadow alone (a skipped upload not written since)
+    };
+    // A destination: base 14 bits, width 6, format 6, x 11, y 11 | width 12, height 12 - packed.
+    struct ShadowKey
+    {
+        uint64_t where = 0u;
+        uint32_t size = 0u;
+        bool operator==(const ShadowKey &o) const { return where == o.where && size == o.size; }
+    };
+    struct ShadowKeyHash
+    {
+        size_t operator()(const ShadowKey &k) const { return static_cast<size_t>((k.where ^ (static_cast<uint64_t>(k.size) << 40)) * 0x9E3779B97F4A7C15ull); }
+    };
+    ShadowKey shadowKey(const GSTransferCommand &c)
+    {
+        ShadowKey k;
+        k.where = static_cast<uint64_t>(c.bitbltbuf.dbp & 0x3FFFu) | static_cast<uint64_t>(c.bitbltbuf.dbw & 0x3Fu) << 14 |
+                  static_cast<uint64_t>(c.bitbltbuf.dpsm & 0x3Fu) << 20 | static_cast<uint64_t>(c.trxpos.dsax & 0x7FFu) << 26 |
+                  static_cast<uint64_t>(c.trxpos.dsay & 0x7FFu) << 37;
+        k.size = static_cast<uint32_t>(c.trxreg.rrw & 0xFFFu) | static_cast<uint32_t>(c.trxreg.rrh & 0xFFFu) << 12;
+        return k;
+    }
+
+    struct UploadSkip
+    {
+        std::unordered_map<ShadowKey, ShadowEntry, ShadowKeyHash> shadow;
+        ShadowEntry *current = nullptr; // the transfer whose data is arriving (skipped or recorded)
+        bool currentSent = false;       // made as well (a kept format): its data also goes to the GS
+        uint64_t sequence = 0u, shadowBytes = 0u;
+        std::atomic<bool> pending{false}; // anything skipped since the last replay (read without the lock by the drawing calls)
+        // counted (PS2X_GS_NATIVE_LOG): every 10 s
+        uint64_t skipped = 0u, skippedBytes = 0u, kept = 0u, keptBytes = 0u, replays = 0u, replayed = 0u, evicted = 0u;
+        uint64_t ensures = 0u, ensureWrites = 0u; // (readers' regions made whole: calls that wrote anything, destinations written)
+        std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+    } g_upload;
+
+    constexpr uint64_t kShadowCap = 256ull * 1024u * 1024u; // (beyond it the oldest destinations go: long since overwritten)
+
+    // (check mode) GS memory's blocks: bit 0 = its low bytes would be stale, bit 1 = its top bytes (of 32-bit words).
+    std::atomic<uint8_t> g_stale[16384] = {};
+
+    GSThreadedBackend *g_backend = nullptr; // (the one backend: ensureWhole's)
+
+    uint32_t gsAddress(uint32_t psm, uint32_t dbp, uint32_t dbw, uint32_t x, uint32_t y)
+    {
+        switch (psm)
+        {
+        case 0x02: case 0x32: return GSPSMCT16::addrPSMCT16(dbp, dbw, x, y);
+        case 0x0A: case 0x3A: return GSPSMCT16::addrPSMCT16S(dbp, dbw, x, y);
+        case 0x13: return GSPSMT8::addrPSMT8(dbp, dbw, x, y);
+        case 0x14: return GSPSMT4::addrPSMT4(dbp, dbw, x, y) >> 1u; // (nibbles)
+        default: return GSPSMCT32::addrPSMCT32(dbp, dbw, x, y);
+        }
+    }
+
+    // (check mode) The blocks a host-to-local transfer writes: `set` stale bits set, `clear` cleared. Sampled every
+    // 8 pixels and at the rectangle's last row and column (no block of any format is narrower or lower than 8).
+    void markTransfer(const GSTransferCommand &c, uint8_t set, uint8_t clear)
+    {
+        const uint32_t w = std::max<uint32_t>(c.trxreg.rrw, 1u), h = std::max<uint32_t>(c.trxreg.rrh, 1u);
+        const auto mark = [&](uint32_t x, uint32_t y)
+        {
+            const uint32_t block = (gsAddress(c.bitbltbuf.dpsm, c.bitbltbuf.dbp, c.bitbltbuf.dbw, (c.trxpos.dsax + x) & 0x7FFu,
+                                              (c.trxpos.dsay + y) & 0x7FFu) >> 8) & 16383u;
+            const uint8_t was = g_stale[block].load(std::memory_order_relaxed);
+            g_stale[block].store(static_cast<uint8_t>((was & ~clear) | set), std::memory_order_relaxed);
+        };
+        for (uint32_t y = 0;; y = std::min(y + 8u, h - 1u))
+        {
+            for (uint32_t x = 0;; x = std::min(x + 8u, w - 1u))
+            {
+                mark(x, y);
+                if (x == w - 1u)
+                    break;
+            }
+            if (y == h - 1u)
+                break;
+        }
+    }
+
+    struct CheckCounts
+    {
+        std::mutex mutex;
+        uint64_t reads = 0u, staleReads = 0u, staleBytes = 0u, skippable = 0u, kept = 0u, localReads = 0u, localStale = 0u;
+        int told = 0;
+        std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+    } g_check;
