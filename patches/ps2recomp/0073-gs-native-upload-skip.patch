+bool GSThreadedBackend::skipUpload(const GSTransferCommand &command)
+{
+    UploadSkip &u = g_upload;
+    u.current = nullptr;
+    u.currentSent = true;
+    const gsupload::Mode mode = gsupload::mode();
+    if (mode == gsupload::Mode::Off)
+        return false;
+    const bool alone = ps2_host_display::gsNativeAlone();
+    if (mode == gsupload::Mode::Check)
+    {
+        // Every upload made; GS memory's blocks marked as a skip would have left them.
+        if (command.direction == 0u && alone)
+        {
+            std::lock_guard<std::mutex> lock(g_check.mutex);
+            if (skippableFormat(command.bitbltbuf.dpsm))
+            {
+                ++g_check.skippable;
+                markTransfer(command, command.bitbltbuf.dpsm == 0x01u ? 1u : 3u, 0u);
+            }
+            else
+            {
+                ++g_check.kept;
+                markTransfer(command, 0u, topByteFormat(command.bitbltbuf.dpsm) ? 2u : 3u);
+            }
+        }
+        else if (command.direction == 0u)
+            markTransfer(command, 0u, 3u); // (drawing on: made, and the GS draws from it)
+        else
+        {
+            // A local read: what it reads would differ where a skip left GS memory stale.
+            const GSTransferCommand &c = command;
+            uint32_t stale = 0u;
+            const uint32_t w = std::max<uint32_t>(c.trxreg.rrw, 1u), h = std::max<uint32_t>(c.trxreg.rrh, 1u);
+            for (uint32_t y = 0; y < h; y += 8u)
+                for (uint32_t x = 0; x < w; x += 8u)
+                    if (gsupload::staleAt(gsAddress(c.bitbltbuf.spsm, c.bitbltbuf.sbp, c.bitbltbuf.sbw, (c.trxpos.ssax + x) & 0x7FFu,
+                                                    (c.trxpos.ssay + y) & 0x7FFu),
+                                          false))
+                        ++stale;
+            gsupload::reportRead(command.direction == 1u ? "a local-to-host transfer" : "a local-to-local transfer", c.bitbltbuf.sbp,
+                                 c.bitbltbuf.spsm, stale, 0u);
+        }
+        return false;
+    }
+    // On: anything that reads GS memory, or the GS drawing again, gets it whole first.
+    if (!alone || command.direction != 0u)
+    {
+        if (u.pending)
+            replayShadow();
+        return false;
+    }
+    ShadowEntry &e = u.shadow[shadowKey(command)];
+    if (e.sequence == 0u)
+    {
+        e.command = command;
+        e.first = static_cast<uint64_t>(command.bitbltbuf.dbp) * kBlockBytes;
+        e.last = e.first + footprintBytes(command.bitbltbuf.dbw, command.trxpos.dsax + std::max<uint32_t>(command.trxreg.rrw, 1u) - 1u,
+                                          command.trxpos.dsay + std::max<uint32_t>(command.trxreg.rrh, 1u) - 1u);
+    }
+    u.shadowBytes -= std::min<uint64_t>(u.shadowBytes, e.bytes.size());
+    e.bytes.clear();
+    e.sequence = ++u.sequence;
+    u.current = &e;
+    u.currentSent = !skippableFormat(command.bitbltbuf.dpsm);
+    e.dirty = !u.currentSent;
+    if (u.currentSent)
+    {
+        ++u.kept;
+        return false; // (made, and recorded: the replay keeps it in its place among the skipped)
+    }
+    ++u.skipped;
+    u.pending = true;
+    return true;
+}
+
+void GSThreadedBackend::replayShadow()
+{
+    UploadSkip &u = g_upload;
+    u.current = nullptr;
+    u.pending = false;
+    std::vector<ShadowEntry *> order;
+    order.reserve(u.shadow.size());
+    for (auto &kv : u.shadow)
+        order.push_back(&kv.second);
+    std::sort(order.begin(), order.end(), [](const ShadowEntry *a, const ShadowEntry *b) { return a->sequence < b->sequence; });
+    for (ShadowEntry *e : order)
+    {
+        sendTransfer(e->command);
+        if (!e->bytes.empty())
+            sendUpload(e->bytes.data(), static_cast<uint32_t>(e->bytes.size()));
+        e->dirty = false;
+        ++u.replayed;
+    }
+    reserve(Op::TextureFlush, 0u); // (the flushes left out meanwhile: one for them all)
+    publish();
+    ++u.replays;
+    std::fprintf(stderr, "[gs:skip] GS memory made whole: %zu destinations written (%.1f MB) - %s\n", order.size(), u.shadowBytes / 1048576.0,
+                 ps2_host_display::gsNativeAlone() ? "a local transfer reads it" : "the emulated drawing is back");
+}
+
+void GSThreadedBackend::ensureWhole(uint64_t first, uint64_t last)
+{
+    UploadSkip &u = g_upload;
+    uint64_t position = 0u;
+    for (int attempt = 0;; ++attempt)
+    {
+        if (attempt > 0)
+            std::this_thread::yield(); // (the lock let go: the producer finishes the transfer it is in)
+        Producer lock(*this);
+        if (!u.pending.load(std::memory_order_relaxed))
+            return;
+        // (a transfer the GS thread is taking - its data still arriving - is not cut into: its turn ends first)
+        if (m_uploadBytesLeft != 0u && !(u.current && !u.currentSent))
+        {
+            if (attempt < 2000)
+                continue;
+            return;
+        }
+        std::vector<ShadowEntry *> order;
+        bool dirty = false;
+        for (auto &kv : u.shadow)
+        {
+            ShadowEntry &e = kv.second;
+            if (&e == u.current || e.last <= first || e.first >= last)
+                continue;
+            order.push_back(&e);
+            dirty = dirty || e.dirty;
+        }
+        if (!dirty)
+            return;
+        // The destinations that reach into it, in the order of their last writes (the made ones again too: their
+        // place among the skipped) - the transfer whose data is arriving left as it was.
+        std::sort(order.begin(), order.end(), [](const ShadowEntry *a, const ShadowEntry *b) { return a->sequence < b->sequence; });
+        const uint64_t bytesLeft = m_uploadBytesLeft;
+        const bool readbackPending = m_readbackPending;
+        for (ShadowEntry *e : order)
+        {
+            sendTransfer(e->command);
+            if (!e->bytes.empty())
+                sendUpload(e->bytes.data(), static_cast<uint32_t>(e->bytes.size()));
+            e->dirty = false;
+        }
+        m_uploadBytesLeft = bytesLeft;
+        m_readbackPending = readbackPending;
+        ++u.ensures;
+        u.ensureWrites += order.size();
+        publish();
+        position = m_writePos;
+        break;
+    }
+    waitConsumed(position);
+}
+
+void GSThreadedBackend::sendTransfer(const GSTransferCommand &command)
+{
+    m_readbackPending = false;
+    m_uploadBytesLeft = 0u;
+    if (command.direction == 0u || command.direction == 2u)
+    {
+        const uint64_t first = static_cast<uint64_t>(command.bitbltbuf.dbp) * kBlockBytes;
+        const uint32_t x1 = command.trxpos.dsax + std::max<uint32_t>(command.trxreg.rrw, 1u) - 1u;
+        const uint32_t y1 = command.trxpos.dsay + std::max<uint32_t>(command.trxreg.rrh, 1u) - 1u;
+        noteWrite(first, first + footprintBytes(command.bitbltbuf.dbw, x1, y1));
+        if (command.direction == 0u)
+            m_uploadBytesLeft = (static_cast<uint64_t>(command.trxreg.rrw) * command.trxreg.rrh *
+                                 transferBits(command.bitbltbuf.dpsm) + 7u) / 8u;
+    }
+    std::memcpy(reserve(Op::BeginTransfer, sizeof(command)), &command, sizeof(command));
+    publish();
+}
+
+void GSThreadedBackend::sendUpload(const uint8_t *data, uint32_t sizeBytes)
+{
+    m_uploadBytesLeft -= std::min<uint64_t>(m_uploadBytesLeft, sizeBytes);
+    // The backend tracks transfer progress, so large uploads can arrive in pieces.
+    for (uint32_t offset = 0u; offset < sizeBytes;)
+    {
+        const uint32_t chunk = std::min(kUploadChunk, sizeBytes - offset);
+        auto *payload = static_cast<UploadPayload *>(reserve(Op::UploadImage, sizeof(UploadPayload) + chunk));
+        payload->bytes = chunk;
+        std::memcpy(payload + 1, data + offset, chunk);
+        offset += chunk;
+        publish();
+    }
+}
+
 void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
 {
     Producer lock(*this);
     m_servedBytes = m_capturedBytes; // a new transfer: nothing of an earlier readback is left to hand out
