+                std::fprintf(stderr, "[gs:skip] check: %s of tbp %x psm %x reads %u of its %u bytes where a skip would have left GS memory stale\n",
+                             what, tbp, psm, staleBytes, bytes);
+            }
+        }
+    }
+}
