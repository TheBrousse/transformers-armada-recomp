         case PMFHL_LH:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_LH(ctx->hi, ctx->lo));", inst.rd);
+            // (The low halfword of each of LO's and HI's eight words, truncated - not saturated - with LO's and HI's
+            // upper halves (lo1 / hi1): LO.w0, LO.w1, HI.w0, HI.w1, LO.w2, LO.w3, HI.w2, HI.w3.)
+            return fmt::format("SET_GPR_VEC(ctx, {}, _mm_setr_epi16((int16_t)ctx->lo, (int16_t)(ctx->lo >> 32), (int16_t)ctx->hi, "
