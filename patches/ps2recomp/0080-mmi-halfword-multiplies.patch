+    namespace
+    {
+        // The EE's parallel halfword multiplies (PMULTH, PMADDH, PMSUBH, PHMADH, PHMSBH): eight signed
+        // 16x16 products p0..p7 of rs and rt, placed in the 128-bit LO and HI (LO = ctx->lo | ctx->lo1 << 64,
+        // HI the same) by lane, as the EE manual gives them:
+        //   PMULTH / PMADDH / PMSUBH  LO.w0 p0, LO.w1 p1, HI.w0 p2, HI.w1 p3, LO.w2 p4, LO.w3 p5, HI.w2 p6, HI.w3 p7
+        //                             (set, added to or taken from each 32-bit word; wrapping)
+        //   PHMADH / PHMSBH           LO.w0 p1 + p0 / p1 - p0, HI.w0 p3 +- p2, LO.w2 p5 +- p4, HI.w2 p7 +- p6; the odd
+        //                             words p1, p3, p5, p7 (PHMADH) or their complement (PHMSBH), as PCSX2 has them
+        //   rd = LO.w0, HI.w0, LO.w2, HI.w2.
+        // (Upstream summed all the products into one 64-bit value - wrong for every lane.)
+        std::string halfwordMultiply(const Instruction &inst, const char *mode)
+        {
+            const std::string m = mode;
+            std::string op;
+            if (m == "MULT" || m == "MADD" || m == "MSUB")
+            {
+                const char *assign = m == "MULT" ? "=" : m == "MADD" ? "+=" : "-=";
+                op = fmt::format("for (int ps2_i = 0; ps2_i < 4; ++ps2_i) {{ const int ps2_j = (ps2_i & 1) + 4 * (ps2_i >> 1); "
+                                 "ps2_l[ps2_i] {0} (uint32_t)ps2_p[ps2_j]; ps2_h[ps2_i] {0} (uint32_t)ps2_p[ps2_j + 2]; }}",
+                                 assign);
+            }
+            else
+            {
+                const bool add = m == "HMADD";
+                op = fmt::format("for (int ps2_i = 0; ps2_i < 4; ++ps2_i) {{ const uint32_t ps2_e = (uint32_t)ps2_p[2 * ps2_i], ps2_o = (uint32_t)ps2_p[2 * ps2_i + 1]; "
+                                 "uint32_t *ps2_w = (ps2_i & 1) ? ps2_h : ps2_l; const int ps2_k = (ps2_i >> 1) * 2; "
+                                 "ps2_w[ps2_k] = ps2_o {} ps2_e; ps2_w[ps2_k + 1] = {}ps2_o; }}",
+                                 add ? "+" : "-", add ? "" : "~");
+            }
+            return fmt::format(
+                "{{ alignas(16) int16_t ps2_a[8], ps2_b[8]; \n"
+                "   _mm_store_si128((__m128i *)ps2_a, GPR_VEC(ctx, {})); \n"
+                "   _mm_store_si128((__m128i *)ps2_b, GPR_VEC(ctx, {})); \n"
+                "   int32_t ps2_p[8]; \n"
+                "   for (int ps2_i = 0; ps2_i < 8; ++ps2_i) ps2_p[ps2_i] = (int32_t)ps2_a[ps2_i] * (int32_t)ps2_b[ps2_i]; \n"
+                "   uint32_t ps2_l[4] = {{(uint32_t)ctx->lo, (uint32_t)(ctx->lo >> 32), (uint32_t)ctx->lo1, (uint32_t)(ctx->lo1 >> 32)}}; \n"
+                "   uint32_t ps2_h[4] = {{(uint32_t)ctx->hi, (uint32_t)(ctx->hi >> 32), (uint32_t)ctx->hi1, (uint32_t)(ctx->hi1 >> 32)}}; \n"
+                "   {} \n"
+                "   ctx->lo = (uint64_t)ps2_l[0] | ((uint64_t)ps2_l[1] << 32); ctx->lo1 = (uint64_t)ps2_l[2] | ((uint64_t)ps2_l[3] << 32); \n"
+                "   ctx->hi = (uint64_t)ps2_h[0] | ((uint64_t)ps2_h[1] << 32); ctx->hi1 = (uint64_t)ps2_h[2] | ((uint64_t)ps2_h[3] << 32); \n"
+                "   SET_GPR_VEC(ctx, {}, _mm_setr_epi32((int32_t)ps2_l[0], (int32_t)ps2_h[0], (int32_t)ps2_l[2], (int32_t)ps2_h[2])); }}",
+                inst.rs, inst.rt, op, inst.rd);
+        }
+    }
+
