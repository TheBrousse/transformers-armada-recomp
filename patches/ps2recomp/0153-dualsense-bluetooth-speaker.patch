+        // The DualSense's speaker over Bluetooth (setSpeakerWanted): every 10.67 ms one audio report 0x36 carrying the
+        // pad's state and one 10 ms Opus frame of the game's sound for it (our earlier launcher's stream, its packet
+        // format proven by the DS5Dongle project). 512 frames of the game's 48 kHz sound make each report, squeezed
+        // to the 480 an Opus frame holds: the pad plays a frame per 10.67 ms (the launcher's measurement - feeding it
+        // every 10 ms overflows its buffer). While it streams, the state rides these reports (no 0x31 writes).
+        struct SpeakerStream
+        {
+            static constexpr int64_t kPeriodUs = 10667;   // 512 frames at 48 kHz
+            static constexpr size_t kBlock = 512u, kOpusFrames = 480u;
+            static constexpr size_t kPrime = 1024u;       // frames held before the first report (a jitter cushion)
+            static constexpr uint8_t kPadBufferMs = 64u;  // the pad's own buffer (the launcher's default)
+            bool on = false, primed = false;
+            int64_t nextUs = 0;
+            uint8_t seq = 0u, counter = 0u;
+            int failuresInRow = 0;
+            uint64_t sent = 0u, silent = 0u;
+#if defined(PS2X_HAS_OPUS)
+            OpusEncoder *encoder = nullptr;
+#endif
+            ~SpeakerStream() { release(); }
+
+            static int64_t nowUs()
+            {
+                return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+            }
+
+            bool start()
+            {
+#if defined(PS2X_HAS_OPUS)
+                if (!encoder)
+                {
+                    int error = 0;
+                    encoder = opus_encoder_create(48000, 2, OPUS_APPLICATION_AUDIO, &error);
+                    if (!encoder || error != OPUS_OK)
+                    {
+                        logLine("[sonypad] the speaker's Opus encoder cannot start (error " + std::to_string(error) + ")");
+                        encoder = nullptr;
+                        return false;
+                    }
+                    // (a constant bit rate: exactly kSpeakerOpusBytes a 10 ms frame)
+                    opus_encoder_ctl(encoder, OPUS_SET_BITRATE(static_cast<opus_int32>(kSpeakerOpusBytes * 8u * 100u)));
+                    opus_encoder_ctl(encoder, OPUS_SET_VBR(0));
+                    opus_encoder_ctl(encoder, OPUS_SET_COMPLEXITY(0));
+                }
+                on = true;
+                primed = false;
+                nextUs = nowUs();
+                failuresInRow = 0;
+                setSpeakerLive(true);
+                logLine("[sonypad] the DualSense's speaker: the game's sound streams to it over Bluetooth");
+                return true;
+#else
+                return false;
+#endif
+            }
+
+            void stop(const char *why)
+            {
+                if (!on)
+                    return;
+                on = false;
+                setSpeakerLive(false);
+                logLine(std::string("[sonypad] the DualSense's speaker stops (") + why + "): " + std::to_string(sent) +
+                        " reports, " + std::to_string(silent) + " of them silent");
+            }
+
+            void release()
+            {
+#if defined(PS2X_HAS_OPUS)
+                if (encoder)
+                    opus_encoder_destroy(encoder);
+                encoder = nullptr;
+#endif
+            }
+
+            // One Opus frame of the next 512 frames of the game's sound (silence while there are not enough).
+            size_t encodeNext(uint8_t *opus)
+            {
+#if defined(PS2X_HAS_OPUS)
+                int16_t block[kBlock * 2u] = {};
+                bool have = false;
+                if (!primed && speakerQueued() >= kPrime)
+                    primed = true;
+                if (primed && speakerQueued() >= kBlock)
+                    have = takeSpeaker(block, kBlock) == kBlock;
+                else if (primed)
+                    primed = false; // (ran dry: hold off until the cushion is back)
+                if (!have)
+                    ++silent;
+                // 512 frames squeezed to 480, linearly
+                int16_t frame[kOpusFrames * 2u];
+                for (size_t i = 0; i < kOpusFrames; ++i)
+                {
+                    const double at = static_cast<double>(i) * static_cast<double>(kBlock - 1u) / static_cast<double>(kOpusFrames - 1u);
+                    const size_t j = static_cast<size_t>(at);
+                    const size_t k = std::min(j + 1u, kBlock - 1u);
+                    const double f = at - static_cast<double>(j);
+                    for (size_t c = 0; c < 2u; ++c)
+                        frame[i * 2u + c] = static_cast<int16_t>(std::lround(block[j * 2u + c] * (1.0 - f) + block[k * 2u + c] * f));
+                }
+                const opus_int32 n = opus_encode(encoder, frame, static_cast<int>(kOpusFrames), opus, static_cast<opus_int32>(kSpeakerOpusBytes));
+                return n > 0 ? static_cast<size_t>(n) : 0u;
+#else
+                (void)opus;
+                return 0u;
+#endif
+            }
+        };
