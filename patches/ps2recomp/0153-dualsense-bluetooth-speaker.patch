     uint64_t padRequestGeneration() { return g_requestGeneration.load(std::memory_order_acquire); }
 
+    namespace
+    {
+        std::atomic<bool> g_speakerWanted{false}, g_speakerLive{false};
+        std::mutex g_speakerMutex;
+        std::deque<int16_t> g_speakerFrames; // interleaved stereo
+        constexpr size_t kSpeakerMaxFrames = 48000u / 4u;
+    }
+
+    void setSpeakerWanted(bool wanted)
+    {
+        if (g_speakerWanted.exchange(wanted) != wanted)
+            host::wake();
+    }
+
+    bool speakerWanted() { return g_speakerWanted.load(std::memory_order_relaxed); }
+
+    bool speakerLive() { return g_speakerLive.load(std::memory_order_relaxed); }
+
+    void setSpeakerLive(bool live)
+    {
+        if (g_speakerLive.exchange(live) != live && !live)
+        {
+            std::lock_guard<std::mutex> lock(g_speakerMutex);
+            g_speakerFrames.clear();
+        }
+    }
+
+    void submitSpeaker(const int16_t *frames, size_t count)
+    {
+        if (!g_speakerLive.load(std::memory_order_relaxed) || !frames)
+            return;
+        std::lock_guard<std::mutex> lock(g_speakerMutex);
+        g_speakerFrames.insert(g_speakerFrames.end(), frames, frames + count * 2u);
+        if (g_speakerFrames.size() > kSpeakerMaxFrames * 2u)
+            g_speakerFrames.erase(g_speakerFrames.begin(),
+                                  g_speakerFrames.begin() + static_cast<std::ptrdiff_t>(g_speakerFrames.size() - kSpeakerMaxFrames * 2u));
+    }
+
+    size_t takeSpeaker(int16_t *out, size_t count)
+    {
+        std::lock_guard<std::mutex> lock(g_speakerMutex);
+        const size_t n = std::min(count, g_speakerFrames.size() / 2u);
+        std::copy(g_speakerFrames.begin(), g_speakerFrames.begin() + static_cast<std::ptrdiff_t>(n * 2u), out);
+        g_speakerFrames.erase(g_speakerFrames.begin(), g_speakerFrames.begin() + static_cast<std::ptrdiff_t>(n * 2u));
+        return n;
+    }
+
+    size_t speakerQueued()
+    {
+        std::lock_guard<std::mutex> lock(g_speakerMutex);
+        return g_speakerFrames.size() / 2u;
+    }
