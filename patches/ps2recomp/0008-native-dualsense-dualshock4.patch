diff --git a/ps2xRuntime/include/runtime/ps2_sony_pad.h b/ps2xRuntime/include/runtime/ps2_sony_pad.h
new file mode 100644
index 0000000..e5b704b
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_sony_pad.h
@@ -0,0 +1,202 @@
+#pragma once
+
+// Native Sony controllers (DualSense, DualSense Edge, DualShock 4) over HID, without Steam Input or DS4Windows: their
+// input reports become the PS2 pad's, and the game's own vibration (libpad actuators, libvib) drives their motors.
+// The protocol is ported from our earlier launcher's SonyPad.cs (USB input report 0x01, Bluetooth 0x31 / 0x11 after the
+// feature-report switch, output reports 0x02 / 0x31 (DualSense) and 0x05 / 0x11 (DualShock 4), the Bluetooth CRC32).
+//
+// Two halves. The protocol half (parse, build, map; ps2_sony_pad.cpp) is pure and tested with recorded byte arrays. The
+// device half (ps2_sony_pad_host.cpp) is Windows HID on a thread of its own: the game thread only copies the latest
+// report and posts motor values, it never waits on a device. Other platforms have no device half (GLFW only).
+//
+// Settings (environment variables, kept in settings.ini by the settings panel, F5: the Controller tab):
+// PS2X_GAMEPAD_BACKEND = auto (native when a Sony pad is connected, else GLFW), glfw (never open the pad: Steam
+// Input / DS4Windows users) or sony (native only: GLFW gamepads are ignored); PS2X_SONYPAD_RUMBLE = 0..100 (percent
+// of the game's vibration); PS2X_SONYPAD_LIGHTBAR = RRGGBB or off. Read at start.
+// (Ported from our earlier recomp, where they are [gamepad] backend / rumble / lightbar in its settings.ini.)
+// PS2X_SONYPAD_TRACE=1 logs detection, raw reports and writes ("[sonypad] ..."), for a first test on new hardware.
+// Unattended runs (PS2X_WINDOW_HIDDEN, a pad script) never open the pad: no light bar or rumble on the user's desk.
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace ps2x::sonypad
+{
+    enum class Model : uint8_t
+    {
+        DualSense,
+        DualShock4,
+    };
+
+    enum class Link : uint8_t
+    {
+        Usb,
+        Bluetooth,
+    };
+
+    constexpr uint16_t kSonyVendorId = 0x054Cu;
+    // A DualShock 4 / DualSense collection over Bluetooth declares input reports of at least this size (USB: 64).
+    constexpr size_t kBluetoothInputLength = 78u;
+    constexpr size_t kBluetoothOutputLength = 78u;
+
+    // DualSense 0x0CE6, DualSense Edge 0x0DF2; DualShock 4 0x05C4 (first), 0x09CC (second), 0x0BA0 (wireless adapter).
+    std::optional<Model> modelFromIds(uint16_t vendorId, uint16_t productId);
+    const char *modelName(Model model);
+    const char *linkName(Link link);
+
+    // A Sony pad's buttons (1 = pressed).
+    enum Button : uint32_t
+    {
+        kSquare = 1u << 0,
+        kCross = 1u << 1,
+        kCircle = 1u << 2,
+        kTriangle = 1u << 3,
+        kL1 = 1u << 4,
+        kR1 = 1u << 5,
+        kL2 = 1u << 6,
+        kR2 = 1u << 7,
+        kCreate = 1u << 8, // DualShock 4: Share
+        kOptions = 1u << 9,
+        kL3 = 1u << 10,
+        kR3 = 1u << 11,
+        kPs = 1u << 12,
+        kTouchpad = 1u << 13,
+        kMute = 1u << 14, // DualSense only
+        kUp = 1u << 15,
+        kDown = 1u << 16,
+        kLeft = 1u << 17,
+        kRight = 1u << 18,
+    };
+
+    struct InputState
+    {
+        uint32_t buttons = 0u;
+        uint8_t lx = 0x80u, ly = 0x80u, rx = 0x80u, ry = 0x80u; // 0 = left / up, as the PS2's sticks
+        uint8_t l2 = 0u, r2 = 0u;                               // analog triggers, 0 = released
+        int battery = -1;                                       // percent; -1 unknown (the Bluetooth basic report)
+        bool charging = false;
+        bool fullReport = false; // false: the basic report a Bluetooth pad sends until it is switched (no battery)
+    };
+
+    enum class ParseResult
+    {
+        Input,     // out holds the pad's state
+        Ignored,   // another report (feature echo, audio, ...): not input, not an error
+        TooShort,  // fewer bytes than the layout needs
+        BadCrc,    // a Bluetooth full report whose CRC32 does not match (a damaged report)
+    };
+    const char *parseResultName(ParseResult result);
+
+    // One input report as ReadFile returns it (report id first). checkCrc: verify the Bluetooth full reports' CRC32.
+    ParseResult parseInputReport(Model model, Link link, const uint8_t *report, size_t length, InputState &out,
+                                 bool checkCrc = true);
+
+    // Bluetooth CRC32 (the zlib one) over a seed byte (0xA1 input, 0xA2 output, 0xA3 feature) and data.
+    uint32_t bluetoothCrc(uint8_t seed, const uint8_t *data, size_t length);
+    // A Bluetooth report's last four bytes hold the CRC32 of the rest, little endian.
+    bool checkBluetoothCrc(uint8_t seed, const uint8_t *report, size_t length);
+    constexpr uint8_t kCrcSeedInput = 0xA1u;
+    constexpr uint8_t kCrcSeedOutput = 0xA2u;
+
+    // What an output report asks the pad to do.
+    struct OutputState
+    {
+        uint8_t weakMotor = 0u;   // right, high frequency (the PS2's small motor)
+        uint8_t strongMotor = 0u; // left, low frequency (the PS2's large motor)
+        bool lightbar = true;     // false: leave the LEDs to the pad's firmware
+        uint8_t red = 0u, green = 0u, blue = 0u;
+        uint8_t playerLeds = 0x04u; // DualSense player indicator: the centre LED = player 1
+        bool lightbarSetup = false; // DualSense: fade out the firmware's start-up glow so the colour shows
+        bool releaseLeds = false;   // DualSense: hand the LEDs back to the firmware (the game is closing)
+    };
+
+    // The output report for a pad. outputLength: the collection's OutputReportByteLength (USB only; a Bluetooth report
+    // is always kBluetoothOutputLength bytes, CRC32 included).
+    std::vector<uint8_t> buildOutputReport(Model model, Link link, const OutputState &state, size_t outputLength);
+
+    // The feature report whose read switches a Bluetooth pad from its basic to its full input report.
+    uint8_t fullReportFeatureId(Model model);
+
+    // ---- The game's vibration ----
+
+    // As the guest wrote it: the small motor is on/off (only bit 0 counts, as on a DualShock 2), the large one 0..255.
+    struct Motors
+    {
+        bool small = false;
+        uint8_t large = 0u;
+        bool operator==(const Motors &other) const { return small == other.small && large == other.large; }
+        bool operator!=(const Motors &other) const { return !(*this == other); }
+    };
+
+    // libpad: scePadSetActAlign's 6 bytes say which actuator each scePadSetActDirect byte drives (0 = small motor,
+    // 1 = large motor, 0xFF = none). A pad starts with nothing aligned.
+    Motors decodeActDirect(const uint8_t align[6], const uint8_t data[6]);
+    // libvib: sceVibSetActParam's profile bits name the actuators (bit 0 small: 1 bit, bit 1 large: 8 bits) and data
+    // packs their values in that order from bit 0 up (e.g. DBZ BT3: (large << 1) | small in two bytes).
+    Motors decodeVibParam(const uint8_t *profile, size_t profileBytes, const uint8_t *data, size_t dataBytes);
+    // The pad's motors for the guest's: small on = the weak motor at full strength (a DualShock 2's small motor has one
+    // speed), large = the strong motor; both scaled by percent (0..100, the player's [gamepad] rumble).
+    void applyMotors(const Motors &motors, int percent, OutputState &out);
+
+    // The latest vibration per PS2 port, set by the libpad / libvib HLE (Kernel/Stubs/Pad.cpp); cheap, never blocks.
+    void setGuestMotors(int port, const Motors &motors);
+    Motors guestMotors(int port);
+    // Increases with every change of any port's motors (the device thread writes on a change).
+    uint64_t guestMotorsGeneration();
+
+    // ---- The PS2 pad report ----
+
+    // data[1] of the pad backend's 32-byte report when data[8..19] carry real pressures (DualShock 2 pressure mode).
+    constexpr uint8_t kPadDataPressureMode = 0x79u;
+
+    // A raylib GamepadButton held on a Sony pad (the settings file's [gamepad] names), and its pressure 0..255 (the
+    // triggers are analog, every other button is fully pressed or not).
+    bool gamepadButtonDown(const InputState &state, int raylibButton);
+    uint8_t gamepadButtonPressure(const InputState &state, int raylibButton);
+    // ---- The device ----
+
+    enum class Backend : uint8_t
+    {
+        Auto, // native when a Sony pad is connected, else GLFW
+        Glfw, // never open the pad
+        Sony, // native only; GLFW gamepads are ignored (the keyboard still works)
+    };
+    const char *backendName(Backend backend);
+    std::optional<Backend> parseBackend(const std::string &text);
+
+    // The host pad backend's question each read (ps2_pad.cpp): the connected Sony pad's input, starting the device
+    // thread the first time the game's window is open (never for backend = glfw, a hidden window, before the window
+    // exists (tests) or without a device half). false: no Sony pad, GLFW reads the gamepads.
+    bool readHostPad(InputState &out);
+    // Tests: readHostPad answers this state (nullptr: the device again), so the whole path to the guest is testable
+    // without a controller.
+    void injectPadForTests(const InputState *state);
+    // Whether GLFW gamepads may drive the pad (false with backend = sony).
+    bool glfwGamepadsAllowed();
+    // Motors off, the LEDs back to the firmware, the thread stopped (the runtime's exit; safe without a start).
+    void shutdown();
+
+    // The device half (ps2_sony_pad_host.cpp).
+    namespace host
+    {
+        struct Config
+        {
+            int rumblePercent = 100;
+            bool lightbar = true;
+            uint8_t red = 0xDCu, green = 0x16u, blue = 0x16u;
+            bool trace = false;
+        };
+        // Whether this build can open HID devices (Windows).
+        bool available();
+        // Starts the device thread once (later calls do nothing).
+        void start(const Config &config);
+        // The connected pad's latest input; false while none is connected (or it stopped reporting).
+        bool latest(InputState &out);
+        // A guest motor change: write it now rather than at the next keep-alive.
+        void wake();
+        void stop();
+    }
+}
