diff --git a/ps2xRuntime/src/lib/ps2_sony_pad.cpp b/ps2xRuntime/src/lib/ps2_sony_pad.cpp
new file mode 100644
index 0000000..3f37188
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_sony_pad.cpp
@@ -0,0 +1,579 @@
+// Native Sony controllers (ps2_sony_pad.h), the protocol half: report layouts and the Bluetooth CRC32 (ported from
+// our earlier launcher's SonyPad.cs, cross-checked with Linux hid-playstation and SDL's hidapi drivers), the guest's vibration
+// (libpad / libvib actuator data) and the PS2 pad report. Pure functions plus the small glue the pad backend calls.
+#include "runtime/ps2_sony_pad.h"
+#include "raylib.h" // its GamepadButton codes, IsWindowReady
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+
+namespace ps2x::sonypad
+{
+    namespace
+    {
+        constexpr uint8_t kUsbInputReport = 0x01u;
+        constexpr uint8_t kBluetoothBasicReport = 0x01u;
+        constexpr uint8_t kDualSenseBluetoothReport = 0x31u;
+        constexpr uint8_t kDualShock4BluetoothReport = 0x11u;
+
+        // The button bytes are the same on both pads (only their offset differs): b0 = d-pad hat (low nibble) and the
+        // face buttons, b1 = shoulders, Create/Share, Options, sticks, b2 = PS, touchpad, mute (DualSense full report).
+        uint32_t decodeButtons(uint8_t b0, uint8_t b1, uint8_t b2, bool hasMute)
+        {
+            uint32_t buttons = 0u;
+            switch (b0 & 0x0Fu)
+            {
+            case 0: buttons |= kUp; break;
+            case 1: buttons |= kUp | kRight; break;
+            case 2: buttons |= kRight; break;
+            case 3: buttons |= kDown | kRight; break;
+            case 4: buttons |= kDown; break;
+            case 5: buttons |= kDown | kLeft; break;
+            case 6: buttons |= kLeft; break;
+            case 7: buttons |= kUp | kLeft; break;
+            default: break; // 8 = released
+            }
+            if (b0 & 0x10u) buttons |= kSquare;
+            if (b0 & 0x20u) buttons |= kCross;
+            if (b0 & 0x40u) buttons |= kCircle;
+            if (b0 & 0x80u) buttons |= kTriangle;
+            if (b1 & 0x01u) buttons |= kL1;
+            if (b1 & 0x02u) buttons |= kR1;
+            if (b1 & 0x04u) buttons |= kL2;
+            if (b1 & 0x08u) buttons |= kR2;
+            if (b1 & 0x10u) buttons |= kCreate;
+            if (b1 & 0x20u) buttons |= kOptions;
+            if (b1 & 0x40u) buttons |= kL3;
+            if (b1 & 0x80u) buttons |= kR3;
+            if (b2 & 0x01u) buttons |= kPs;
+            if (b2 & 0x02u) buttons |= kTouchpad;
+            if (hasMute && (b2 & 0x04u)) buttons |= kMute; // elsewhere these bits are a report counter
+            return buttons;
+        }
+
+        std::array<uint32_t, 256> makeCrcTable()
+        {
+            std::array<uint32_t, 256> table{};
+            for (uint32_t i = 0; i < 256u; ++i)
+            {
+                uint32_t c = i;
+                for (int bit = 0; bit < 8; ++bit)
+                    c = (c & 1u) ? (c >> 1) ^ 0xEDB88320u : (c >> 1);
+                table[i] = c;
+            }
+            return table;
+        }
+
+        const std::array<uint32_t, 256> &crcTable()
+        {
+            static const std::array<uint32_t, 256> table = makeCrcTable();
+            return table;
+        }
+
+        uint32_t crcUpdate(uint32_t crc, uint8_t byte)
+        {
+            return crcTable()[(crc ^ byte) & 0xFFu] ^ (crc >> 8);
+        }
+
+        constexpr int kGuestPorts = 2;
+        std::atomic<uint32_t> g_guestMotors[kGuestPorts]{}; // bit 8 = small, bits 0-7 = large
+        std::atomic<uint64_t> g_guestMotorsGeneration{0};
+
+        uint32_t packMotors(const Motors &m) { return (m.small ? 0x100u : 0u) | m.large; }
+        Motors unpackMotors(uint32_t v) { return Motors{(v & 0x100u) != 0u, static_cast<uint8_t>(v & 0xFFu)}; }
+
+        std::string lower(std::string text)
+        {
+            std::transform(text.begin(), text.end(), text.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            const size_t first = text.find_first_not_of(" \t");
+            const size_t last = text.find_last_not_of(" \t");
+            return first == std::string::npos ? std::string() : text.substr(first, last - first + 1);
+        }
+
+        bool environmentOn(const char *name)
+        {
+            const char *value = std::getenv(name);
+            return value != nullptr && value[0] != '\0' && !(value[0] == '0' && value[1] == '\0');
+        }
+    }
+
+    std::optional<Model> modelFromIds(uint16_t vendorId, uint16_t productId)
+    {
+        if (vendorId != kSonyVendorId)
+            return std::nullopt;
+        switch (productId)
+        {
+        case 0x0CE6u: // DualSense
+        case 0x0DF2u: // DualSense Edge
+            return Model::DualSense;
+        case 0x05C4u: // DualShock 4 (first model)
+        case 0x09CCu: // DualShock 4 (second model)
+        case 0x0BA0u: // DualShock 4 USB wireless adapter
+            return Model::DualShock4;
+        default:
+            return std::nullopt;
+        }
+    }
+
+    const char *modelName(Model model) { return model == Model::DualSense ? "DualSense" : "DualShock 4"; }
+    const char *linkName(Link link) { return link == Link::Usb ? "USB" : "Bluetooth"; }
+
+    const char *parseResultName(ParseResult result)
+    {
+        switch (result)
+        {
+        case ParseResult::Input: return "input";
+        case ParseResult::Ignored: return "ignored";
+        case ParseResult::TooShort: return "too-short";
+        case ParseResult::BadCrc: return "bad-crc";
+        }
+        return "?";
+    }
+
+    uint32_t bluetoothCrc(uint8_t seed, const uint8_t *data, size_t length)
+    {
+        uint32_t crc = crcUpdate(0xFFFFFFFFu, seed);
+        for (size_t i = 0; i < length; ++i)
+            crc = crcUpdate(crc, data[i]);
+        return ~crc;
+    }
+
+    bool checkBluetoothCrc(uint8_t seed, const uint8_t *report, size_t length)
+    {
+        if (!report || length < 5u)
+            return false;
+        const size_t n = length - 4u;
+        const uint32_t stored = static_cast<uint32_t>(report[n]) | (static_cast<uint32_t>(report[n + 1]) << 8) |
+                                (static_cast<uint32_t>(report[n + 2]) << 16) | (static_cast<uint32_t>(report[n + 3]) << 24);
+        return stored == bluetoothCrc(seed, report, n);
+    }
+
+    ParseResult parseInputReport(Model model, Link link, const uint8_t *report, size_t length, InputState &out, bool checkCrc)
+    {
+        if (!report || length == 0u)
+            return ParseResult::TooShort;
+        const uint8_t id = report[0];
+        size_t o = 0u;        // first data byte (left stick X)
+        size_t need = 0u;     // bytes the layout reads
+        bool full = false;    // full report (battery, motion) rather than the Bluetooth basic one
+        bool dualSenseLayout = false;
+        if (link == Link::Usb)
+        {
+            if (id != kUsbInputReport)
+                return ParseResult::Ignored;
+            o = 1u;
+            full = true;
+            dualSenseLayout = model == Model::DualSense;
+            need = o + (dualSenseLayout ? 53u : 30u); // the status byte: DualSense +52, DualShock 4 +29
+        }
+        else if (id == kBluetoothBasicReport)
+        {
+            // Until the feature read switches it, a Bluetooth pad sends this short report: the USB DualShock 4 layout's
+            // first nine bytes for both pads (sticks, three button bytes, triggers).
+            o = 1u;
+            need = o + 9u;
+        }
+        else if (model == Model::DualSense && id == kDualSenseBluetoothReport)
+        {
+            o = 2u; // report id, then a sequence/tag byte
+            full = true;
+            dualSenseLayout = true;
+            need = kBluetoothInputLength;
+        }
+        else if (model == Model::DualShock4 && id == kDualShock4BluetoothReport)
+        {
+            o = 3u; // report id, then two protocol bytes
+            full = true;
+            need = kBluetoothInputLength;
+        }
+        else
+            return ParseResult::Ignored;
+
+        if (length < need)
+            return ParseResult::TooShort;
+        // A Bluetooth full report carries a CRC32 over its first 74 bytes (ReadFile may hand back more: the collection's
+        // longest report; the CRC still sits at 74).
+        if (full && link == Link::Bluetooth && checkCrc && !checkBluetoothCrc(kCrcSeedInput, report, kBluetoothInputLength))
+            return ParseResult::BadCrc;
+
+        InputState state;
+        state.lx = report[o + 0];
+        state.ly = report[o + 1];
+        state.rx = report[o + 2];
+        state.ry = report[o + 3];
+        state.fullReport = full;
+        if (dualSenseLayout)
+        {
+            // DualSense: triggers at +4/+5, a sequence byte, then the buttons at +7.
+            state.l2 = report[o + 4];
+            state.r2 = report[o + 5];
+            state.buttons = decodeButtons(report[o + 7], report[o + 8], report[o + 9], true);
+            const uint8_t status = report[o + 52];
+            const int level = status & 0x0F;
+            const int charge = (status >> 4) & 0x0F; // 0 discharging, 1 charging, 2 full, others an error
+            state.battery = charge == 2 ? 100 : (charge <= 1 ? std::min(level * 10 + 5, 100) : -1);
+            state.charging = charge == 1;
+        }
+        else
+        {
+            // DualShock 4 (and both pads' Bluetooth basic report): buttons at +4, triggers at +7/+8.
+            state.buttons = decodeButtons(report[o + 4], report[o + 5], report[o + 6], false);
+            state.l2 = report[o + 7];
+            state.r2 = report[o + 8];
+            if (full)
+            {
+                // Status at +29 (hid-playstation): capacity in the low nibble, bit 4 = cable. On the cable 0-9 is
+                // charging, 10 charging at full, 11 full.
+                const uint8_t status = report[o + 29];
+                const int level = status & 0x0F;
+                if (status & 0x10u)
+                {
+                    state.battery = level < 10 ? level * 10 + 5 : (level <= 11 ? 100 : -1);
+                    state.charging = level <= 10;
+                }
+                else
+                    state.battery = level < 10 ? level * 10 + 5 : 100;
+            }
+        }
+        out = state;
+        return ParseResult::Input;
+    }
+
+    std::vector<uint8_t> buildOutputReport(Model model, Link link, const OutputState &state, size_t outputLength)
+    {
+        const bool bluetooth = link == Link::Bluetooth;
+        std::vector<uint8_t> buf;
+        if (model == Model::DualSense)
+        {
+            // USB report 0x02 (the collection's 48 bytes); Bluetooth 0x31, a 0x02 "state follows" byte, CRC32 (seed
+            // 0xA2). The common block (hid-playstation's dualsense_output_report_common) starts after them.
+            buf.assign(bluetooth ? kBluetoothOutputLength : std::max<size_t>(outputLength, 48u), 0u);
+            size_t c = 1u;
+            if (bluetooth)
+            {
+                buf[0] = 0x31u;
+                buf[1] = 0x02u;
+                c = 2u;
+            }
+            else
+                buf[0] = 0x02u;
+            buf[c + 0] = 0x03u; // valid_flag0: compatible vibration + haptics select (classic rumble on the actuators)
+            buf[c + 2] = state.weakMotor;   // right
+            buf[c + 3] = state.strongMotor; // left
+            if (state.lightbar || state.releaseLeds)
+            {
+                buf[c + 1] = 0x04u | 0x10u; // valid_flag1: light bar + player indicator
+                if (state.releaseLeds)
+                    buf[c + 1] |= 0x08u; // release the LEDs: the firmware's own glow comes back (our earlier launcher's exit)
+                buf[c + 43] = state.playerLeds;
+                buf[c + 44] = state.releaseLeds ? 0u : state.red;
+                buf[c + 45] = state.releaseLeds ? 0u : state.green;
+                buf[c + 46] = state.releaseLeds ? 0u : state.blue;
+            }
+            if (state.lightbarSetup && state.lightbar)
+            {
+                buf[c + 38] = 0x02u; // valid_flag2: light-bar setup control
+                buf[c + 41] = 0x02u; // light out: fade the start-up glow so the colour shows
+            }
+        }
+        else
+        {
+            // USB report 0x05 (32 bytes); Bluetooth 0x11 with DS4Windows' 0xC0 0xA0 prefix and the CRC32. The flags
+            // byte: 0x01 rumble, 0x02 light bar, 0x04 flash (SDL's choice: our earlier launcher's 0xF7 also claims the audio
+            // volume bits, which would mute a headset on the pad with the zero volumes that follow).
+            buf.assign(bluetooth ? kBluetoothOutputLength : std::max<size_t>(outputLength, 32u), 0u);
+            size_t base = 1u;
+            if (bluetooth)
+            {
+                buf[0] = 0x11u;
+                buf[1] = 0xC0u;
+                buf[2] = 0xA0u;
+                base = 3u;
+            }
+            else
+                buf[0] = 0x05u;
+            buf[base + 0] = state.lightbar ? 0x07u : 0x01u;
+            buf[base + 3] = state.weakMotor;   // right
+            buf[base + 4] = state.strongMotor; // left
+            if (state.lightbar)
+            {
+                buf[base + 5] = state.red;
+                buf[base + 6] = state.green;
+                buf[base + 7] = state.blue;
+            }
+        }
+        if (bluetooth)
+        {
+            const size_t n = buf.size() - 4u;
+            const uint32_t crc = bluetoothCrc(kCrcSeedOutput, buf.data(), n);
+            buf[n + 0] = static_cast<uint8_t>(crc);
+            buf[n + 1] = static_cast<uint8_t>(crc >> 8);
+            buf[n + 2] = static_cast<uint8_t>(crc >> 16);
+            buf[n + 3] = static_cast<uint8_t>(crc >> 24);
+        }
+        return buf;
+    }
+
+    uint8_t fullReportFeatureId(Model model) { return model == Model::DualSense ? 0x05u : 0x02u; }
+
+    Motors decodeActDirect(const uint8_t align[6], const uint8_t data[6])
+    {
+        Motors motors;
+        if (!align || !data)
+            return motors;
+        for (int i = 0; i < 6; ++i)
+        {
+            if (align[i] == 0u)
+                motors.small = motors.small || (data[i] & 0x01u) != 0u; // the small motor reads bit 0 only
+            else if (align[i] == 1u)
+                motors.large = data[i];
+        }
+        return motors;
+    }
+
+    Motors decodeVibParam(const uint8_t *profile, size_t profileBytes, const uint8_t *data, size_t dataBytes)
+    {
+        Motors motors;
+        if (!profile || !data)
+            return motors;
+        size_t bit = 0u;
+        auto take = [&](int count) {
+            uint32_t value = 0u;
+            for (int i = 0; i < count; ++i, ++bit)
+            {
+                const size_t byte = bit / 8u;
+                if (byte < dataBytes && ((data[byte] >> (bit % 8u)) & 1u))
+                    value |= 1u << i;
+            }
+            return value;
+        };
+        for (size_t p = 0; p < profileBytes; ++p)
+        {
+            for (int b = 0; b < 8; ++b)
+            {
+                if (!((profile[p] >> b) & 1u))
+                    continue;
+                const size_t actuator = p * 8u + static_cast<size_t>(b);
+                if (actuator == 0u)
+                    motors.small = take(1) != 0u;
+                else if (actuator == 1u)
+                    motors.large = static_cast<uint8_t>(take(8));
+                else
+                    return motors; // a DualShock 2 has these two; an unknown actuator's width is unknown
+            }
+        }
+        return motors;
+    }
+
+    void applyMotors(const Motors &motors, int percent, OutputState &out)
+    {
+        const int scale = std::clamp(percent, 0, 100);
+        out.weakMotor = static_cast<uint8_t>((motors.small ? 255 : 0) * scale / 100);
+        out.strongMotor = static_cast<uint8_t>(motors.large * scale / 100);
+    }
+
+    void setGuestMotors(int port, const Motors &motors)
+    {
+        if (port < 0 || port >= kGuestPorts)
+            return;
+        const uint32_t packed = packMotors(motors);
+        if (g_guestMotors[port].exchange(packed, std::memory_order_acq_rel) == packed)
+            return;
+        g_guestMotorsGeneration.fetch_add(1u, std::memory_order_acq_rel);
+        host::wake();
+    }
+
+    Motors guestMotors(int port)
+    {
+        if (port < 0 || port >= kGuestPorts)
+            return Motors{};
+        return unpackMotors(g_guestMotors[port].load(std::memory_order_acquire));
+    }
+
+    uint64_t guestMotorsGeneration() { return g_guestMotorsGeneration.load(std::memory_order_acquire); }
+
+    bool gamepadButtonDown(const InputState &state, int raylibButton)
+    {
+        uint32_t mask = 0u;
+        switch (raylibButton)
+        {
+        case GAMEPAD_BUTTON_LEFT_FACE_UP: mask = kUp; break;
+        case GAMEPAD_BUTTON_LEFT_FACE_RIGHT: mask = kRight; break;
+        case GAMEPAD_BUTTON_LEFT_FACE_DOWN: mask = kDown; break;
+        case GAMEPAD_BUTTON_LEFT_FACE_LEFT: mask = kLeft; break;
+        case GAMEPAD_BUTTON_RIGHT_FACE_UP: mask = kTriangle; break;
+        case GAMEPAD_BUTTON_RIGHT_FACE_RIGHT: mask = kCircle; break;
+        case GAMEPAD_BUTTON_RIGHT_FACE_DOWN: mask = kCross; break;
+        case GAMEPAD_BUTTON_RIGHT_FACE_LEFT: mask = kSquare; break;
+        case GAMEPAD_BUTTON_LEFT_TRIGGER_1: mask = kL1; break;
+        case GAMEPAD_BUTTON_LEFT_TRIGGER_2: mask = kL2; break;
+        case GAMEPAD_BUTTON_RIGHT_TRIGGER_1: mask = kR1; break;
+        case GAMEPAD_BUTTON_RIGHT_TRIGGER_2: mask = kR2; break;
+        case GAMEPAD_BUTTON_MIDDLE_LEFT: mask = kCreate; break;
+        case GAMEPAD_BUTTON_MIDDLE: mask = kPs; break;
+        case GAMEPAD_BUTTON_MIDDLE_RIGHT: mask = kOptions; break;
+        case GAMEPAD_BUTTON_LEFT_THUMB: mask = kL3; break;
+        case GAMEPAD_BUTTON_RIGHT_THUMB: mask = kR3; break;
+        default: return false;
+        }
+        return (state.buttons & mask) != 0u;
+    }
+
+    uint8_t gamepadButtonPressure(const InputState &state, int raylibButton)
+    {
+        if (!gamepadButtonDown(state, raylibButton))
+            return 0u;
+        // The digital L2/R2 bits fire a little into the pull; the pressure then follows the trigger.
+        if (raylibButton == GAMEPAD_BUTTON_LEFT_TRIGGER_2)
+            return std::max<uint8_t>(state.l2, 1u);
+        if (raylibButton == GAMEPAD_BUTTON_RIGHT_TRIGGER_2)
+            return std::max<uint8_t>(state.r2, 1u);
+        return 0xFFu;
+    }
+
+    const char *backendName(Backend backend)
+    {
+        switch (backend)
+        {
+        case Backend::Auto: return "auto";
+        case Backend::Glfw: return "glfw";
+        case Backend::Sony: return "sony";
+        }
+        return "auto";
+    }
+
+    std::optional<Backend> parseBackend(const std::string &text)
+    {
+        const std::string value = lower(text);
+        if (value == "auto")
+            return Backend::Auto;
+        if (value == "glfw")
+            return Backend::Glfw;
+        if (value == "sony")
+            return Backend::Sony;
+        return std::nullopt;
+    }
+
+    namespace
+    {
+        std::once_flag g_startOnce;
+        std::atomic<bool> g_started{false};
+        std::mutex g_injectedMutex;
+        std::optional<InputState> g_injected; // tests: a pad without a device
+
+        // The settings (ps2_sony_pad.h), read once.
+        struct Settings
+        {
+            Backend backend = Backend::Auto;
+            int rumble = 100;
+            bool lightbar = true;
+            uint8_t red = 0xDCu, green = 0x16u, blue = 0x16u;
+        };
+
+        const Settings &currentSettings()
+        {
+            static const Settings s = []()
+            {
+                Settings out;
+                if (const char *env = std::getenv("PS2X_GAMEPAD_BACKEND"))
+                    if (const auto backend = parseBackend(env))
+                        out.backend = *backend;
+                if (const char *env = std::getenv("PS2X_SONYPAD_RUMBLE"); env && *env)
+                    out.rumble = std::clamp(std::atoi(env), 0, 100);
+                if (const char *env = std::getenv("PS2X_SONYPAD_LIGHTBAR"); env && *env)
+                {
+                    const std::string value = lower(env);
+                    unsigned rgb = 0u;
+                    if (value == "off")
+                        out.lightbar = false;
+                    else if (value.size() == 6 && std::sscanf(value.c_str(), "%6x", &rgb) == 1)
+                    {
+                        out.red = static_cast<uint8_t>(rgb >> 16);
+                        out.green = static_cast<uint8_t>(rgb >> 8);
+                        out.blue = static_cast<uint8_t>(rgb);
+                    }
+                }
+                return out;
+            }();
+            return s;
+        }
+
+        void startOnce()
+        {
+            const Settings &settings = currentSettings();
+            const bool trace = environmentOn("PS2X_SONYPAD_TRACE");
+            if (settings.backend == Backend::Glfw)
+            {
+                std::cerr << "[sonypad] native DualSense / DualShock 4 support off (PS2X_GAMEPAD_BACKEND=glfw)" << std::endl;
+                return;
+            }
+            // A hidden window is an unattended run: never take the user's controller (light bar, rumble).
+            if (environmentOn("PS2X_WINDOW_HIDDEN"))
+            {
+                if (trace)
+                    std::cerr << "[sonypad] off: the window is hidden (PS2X_WINDOW_HIDDEN)" << std::endl;
+                return;
+            }
+            if (!host::available())
+            {
+                if (trace || settings.backend == Backend::Sony)
+                    std::cerr << "[sonypad] no native controller support on this platform: GLFW gamepads only" << std::endl;
+                return;
+            }
+            host::Config config;
+            config.rumblePercent = settings.rumble;
+            config.lightbar = settings.lightbar;
+            config.red = settings.red;
+            config.green = settings.green;
+            config.blue = settings.blue;
+            config.trace = trace;
+            host::start(config);
+            g_started.store(true, std::memory_order_release);
+        }
+    }
+
+    bool readHostPad(InputState &out)
+    {
+        {
+            std::lock_guard<std::mutex> lock(g_injectedMutex);
+            if (g_injected)
+            {
+                out = *g_injected;
+                return true;
+            }
+        }
+        // Only a game with its window open takes the controller (never a test, never before the window exists).
+        if (!g_started.load(std::memory_order_acquire) && !IsWindowReady())
+            return false;
+        std::call_once(g_startOnce, startOnce);
+        return g_started.load(std::memory_order_acquire) && host::latest(out);
+    }
+
+    void injectPadForTests(const InputState *state)
+    {
+        std::lock_guard<std::mutex> lock(g_injectedMutex);
+        if (state)
+            g_injected = *state;
+        else
+            g_injected.reset();
+    }
+
+    bool glfwGamepadsAllowed()
+    {
+        return currentSettings().backend != Backend::Sony;
+    }
+
+    void shutdown()
+    {
+        if (g_started.load(std::memory_order_acquire))
+            host::stop();
+    }
+}
