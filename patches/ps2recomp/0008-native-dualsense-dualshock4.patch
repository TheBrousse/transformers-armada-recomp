+        const int port = static_cast<int>(getRegU32(ctx, 4));
+        const uint8_t *align = getMemPtr(rdram, getRegU32(ctx, 6));
+        if (port < 0 || port >= 2 || !align)
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+        std::lock_guard<std::mutex> lock(g_actMutex);
+        std::memcpy(g_actAlign[port], align, 6);
         setReturnS32(ctx, 1);
     }
 
+    // a2 = 6 bytes of actuator values, read through the port's alignment.
     void scePadSetActDirect(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        (void)rdram;
         (void)runtime;
+        const int port = static_cast<int>(getRegU32(ctx, 4));
+        const uint8_t *data = getMemPtr(rdram, getRegU32(ctx, 6));
+        if (port < 0 || port >= 2 || !data)
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+        ps2x::sonypad::Motors motors;
+        {
+            std::lock_guard<std::mutex> lock(g_actMutex);
+            motors = ps2x::sonypad::decodeActDirect(g_actAlign[port], data);
+        }
+        ps2x::sonypad::setGuestMotors(port, motors);
         setReturnS32(ctx, 1);
     }
 
