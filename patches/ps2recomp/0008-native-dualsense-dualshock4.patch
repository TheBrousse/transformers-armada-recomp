+// Native Sony controllers (ps2_sony_pad.h), the device half: Windows HID (SetupAPI + hid.dll) on a thread of its own.
+// It finds a DualSense / DualShock 4 (USB first, then Bluetooth), switches a Bluetooth pad to its full report, reads
+// input reports with overlapped I/O, and writes the light bar and the game's vibration on the same handle. The game
+// thread only copies the latest report and posts motor values. A pad that disconnects or goes silent is dropped (the
+// pad backend falls back to GLFW) and looked for again every two seconds. Other platforms: no device half.
+#include "runtime/ps2_sony_pad.h"
+
+#if defined(_WIN32)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h> // this file never includes raylib, whose names clash with it
+#include <setupapi.h>
+#include <hidsdi.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cwctype>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace ps2x::sonypad::host
+{
+    namespace
+    {
+        constexpr DWORD kScanIntervalMs = 2000;    // no pad: look again this often
+        constexpr DWORD kWaitSliceMs = 50;          // the session loop's longest wait
+        constexpr int64_t kStaleMs = 1500;          // no report for this long: the pad no longer drives the game
+        constexpr int64_t kDeadMs = 5000;           // ... and for this long: close it and look again
+        constexpr int64_t kFirstReportMs = 3000;    // a freshly opened interface that never reports is skipped
+        constexpr int64_t kSilentHoldMs = 10000;    // ... for this long
+        constexpr int64_t kRumbleKeepAliveMs = 100; // motors on: write again this often (our earlier launcher: 80 ms)
+        constexpr int64_t kIdleKeepAliveMs = 2000;  // motors off: re-assert the light bar this often
+        constexpr DWORD kWriteTimeoutMs = 250;
+        constexpr int kTraceReports = 12;           // raw reports traced in full after a connect
+        constexpr int kTraceChanges = 200;          // parsed state changes traced per connection
+        constexpr int kCrcFailuresBeforeBypass = 32;
+        constexpr size_t kMaxReportBytes = 4096;
+
+        int64_t nowMs()
+        {
+            return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        }
+
+        void logLine(const std::string &line)
+        {
+            std::cerr << line << std::endl;
+        }
+
+        std::string hex(const uint8_t *data, size_t length, size_t max = 80)
+        {
+            std::string out;
+            char byte[4];
+            for (size_t i = 0; i < length && i < max; ++i)
+            {
+                std::snprintf(byte, sizeof(byte), "%02x", data[i]);
+                if (i)
+                    out += ' ';
+                out += byte;
+            }
+            if (length > max)
+                out += " ...";
+            return out;
+        }
+
+        std::string narrow(const std::wstring &text)
+        {
+            std::string out;
+            for (wchar_t c : text)
+                out += (c >= 0x20 && c < 0x7F) ? static_cast<char>(c) : '?';
+            return out;
+        }
+
+        std::string describeState(const InputState &s)
+        {
+            char line[200];
+            std::snprintf(line, sizeof(line), "buttons=%05x lx=%u ly=%u rx=%u ry=%u l2=%u r2=%u battery=%d%s%s",
+                          static_cast<unsigned>(s.buttons), s.lx, s.ly, s.rx, s.ry, s.l2, s.r2, s.battery,
+                          s.charging ? " charging" : "", s.fullReport ? "" : " (basic report)");
+            return line;
+        }
+
+        struct Device
+        {
+            std::wstring path;
+            Model model = Model::DualSense;
+            uint16_t productId = 0;
+            Link link = Link::Usb;
+            uint16_t inputLength = 0, outputLength = 0, featureLength = 0;
+            uint16_t usagePage = 0, usage = 0;
+        };
+
+        std::string describeDevice(const Device &d)
+        {
+            char line[200];
+            std::snprintf(line, sizeof(line), "%s (054c:%04x) over %s: input %u, output %u, feature %u bytes, usage %04x:%04x",
+                          modelName(d.model), d.productId, linkName(d.link), d.inputLength, d.outputLength, d.featureLength,
+                          d.usagePage, d.usage);
+            return line;
+        }
+
+        // Every present HID interface with Sony's vendor id and a known product id. Opens each candidate without access
+        // (attributes and capabilities only), so it never disturbs a pad someone else is reading.
+        std::vector<Device> enumerateSonyPads(size_t &interfaces)
+        {
+            std::vector<Device> devices;
+            interfaces = 0u;
+            GUID hidGuid;
+            HidD_GetHidGuid(&hidGuid);
+            HDEVINFO set = SetupDiGetClassDevsW(&hidGuid, nullptr, nullptr, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+            if (set == INVALID_HANDLE_VALUE)
+                return devices;
+            SP_DEVICE_INTERFACE_DATA iface{};
+            iface.cbSize = sizeof(iface);
+            for (DWORD i = 0; SetupDiEnumDeviceInterfaces(set, nullptr, &hidGuid, i, &iface); ++i)
+            {
+                ++interfaces;
+                DWORD needed = 0;
+                SetupDiGetDeviceInterfaceDetailW(set, &iface, nullptr, 0, &needed, nullptr);
+                if (needed < sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) || needed > 64u * 1024u)
+                    continue;
+                std::vector<uint8_t> storage(needed + sizeof(wchar_t), 0u);
+                auto *detail = reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W *>(storage.data());
+                detail->cbSize = sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W);
+                if (!SetupDiGetDeviceInterfaceDetailW(set, &iface, detail, needed, nullptr, nullptr))
+                    continue;
+                const std::wstring path(detail->DevicePath);
+                std::wstring lowered = path;
+                std::transform(lowered.begin(), lowered.end(), lowered.begin(), [](wchar_t c) { return static_cast<wchar_t>(std::towlower(c)); });
+                // Sony's vendor id is in the path (USB "vid_054c", Bluetooth "vid&0002054c"): skip the others unopened.
+                if (lowered.find(L"054c") == std::wstring::npos)
+                    continue;
+                HANDLE h = CreateFileW(path.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, 0, nullptr);
+                if (h == INVALID_HANDLE_VALUE)
+                    continue;
+                HIDD_ATTRIBUTES attributes{};
+                attributes.Size = sizeof(attributes);
+                std::optional<Model> model;
+                if (HidD_GetAttributes(h, &attributes))
+                    model = modelFromIds(attributes.VendorID, attributes.ProductID);
+                Device device;
+                if (model)
+                {
+                    PHIDP_PREPARSED_DATA preparsed = nullptr;
+                    if (HidD_GetPreparsedData(h, &preparsed) && preparsed)
+                    {
+                        HIDP_CAPS caps{};
+                        if (HidP_GetCaps(preparsed, &caps) == HIDP_STATUS_SUCCESS)
+                        {
+                            device.inputLength = caps.InputReportByteLength;
+                            device.outputLength = caps.OutputReportByteLength;
+                            device.featureLength = caps.FeatureReportByteLength;
+                            device.usagePage = caps.UsagePage;
+                            device.usage = caps.Usage;
+                        }
+                        HidD_FreePreparsedData(preparsed);
+                    }
+                }
+                CloseHandle(h);
+                if (!model || device.inputLength == 0u)
+                    continue;
+                device.path = path;
+                device.model = *model;
+                device.productId = attributes.ProductID;
+                // A Bluetooth collection declares the 78-byte full report (or longer); USB ones 64 (our earlier launcher's test).
+                device.link = device.inputLength >= kBluetoothInputLength ? Link::Bluetooth : Link::Usb;
+                devices.push_back(std::move(device));
+            }
+            SetupDiDestroyDeviceInfoList(set);
+            // Wired first: lower latency, and a pad charging on a cable while paired shows up on both.
+            std::stable_sort(devices.begin(), devices.end(), [](const Device &a, const Device &b) {
+                return a.link == Link::Usb && b.link == Link::Bluetooth;
+            });
+            return devices;
+        }
+
+        // Switches a Bluetooth pad from its basic to its full report: reading the calibration feature report does it
+        // (DualSense 0x05, DualShock 4 0x02). A handle of its own, synchronous (hid.dll's calls want one).
+        bool readFullReportFeature(const Device &device, DWORD &error)
+        {
+            error = 0;
+            HANDLE h = CreateFileW(device.path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                                   OPEN_EXISTING, 0, nullptr);
+            if (h == INVALID_HANDLE_VALUE)
+            {
+                error = GetLastError();
+                return false;
+            }
+            std::vector<uint8_t> feature(std::clamp<size_t>(device.featureLength, 64u, kMaxReportBytes), 0u);
+            feature[0] = fullReportFeatureId(device.model);
+            const bool ok = HidD_GetFeature(h, feature.data(), static_cast<ULONG>(feature.size())) != FALSE;
+            if (!ok)
+                error = GetLastError();
+            CloseHandle(h);
+            return ok;
+        }
+
+        class Host
+        {
+        public:
+            void start(const Config &config)
+            {
+                std::lock_guard<std::mutex> lock(m_lifecycle);
+                if (m_started)
+                    return;
+                m_started = true;
+                m_config = config;
+                m_stopEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                m_wakeEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+                m_doneEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                if (!m_stopEvent || !m_wakeEvent || !m_doneEvent)
+                {
+                    logLine("[sonypad] cannot create the thread's events: native controller support off");
+                    return;
+                }
+                char colour[8] = "off";
+                if (m_config.lightbar)
+                    std::snprintf(colour, sizeof(colour), "%02X%02X%02X", m_config.red, m_config.green, m_config.blue);
+                logLine("[sonypad] looking for a DualSense / DualShock 4 (rumble " + std::to_string(m_config.rumblePercent) +
+                        "%, light bar " + colour + (m_config.trace ? ", trace on" : "") + ")");
+                m_thread = std::thread([this]() { run(); });
+            }
+
+            bool latest(InputState &out)
+            {
+                std::lock_guard<std::mutex> lock(m_stateMutex);
+                if (!m_live)
+                    return false;
+                out = m_state;
+                return true;
+            }
+
+            void wake()
+            {
+                if (m_wakeEvent)
+                    SetEvent(m_wakeEvent);
+            }
+
+            void stop()
+            {
+                std::lock_guard<std::mutex> lock(m_lifecycle);
+                if (!m_started || !m_thread.joinable())
+                    return;
+                SetEvent(m_stopEvent);
+                // The thread ends within a wait slice plus the closing write; a device stuck in the driver must not
+                // hold the game's exit, so after a second it is left behind (the process is ending).
+                if (WaitForSingleObject(m_doneEvent, 1000) == WAIT_OBJECT_0)
+                    m_thread.join();
+                else
+                {
+                    logLine("[sonypad] the controller thread did not stop within a second: leaving it");
+                    m_thread.detach();
+                }
+            }
+
+        private:
+            bool stopping() const { return WaitForSingleObject(m_stopEvent, 0) == WAIT_OBJECT_0; }
+
+            void publish(const InputState &state)
+            {
+                std::lock_guard<std::mutex> lock(m_stateMutex);
+                m_state = state;
+                m_live = true;
+            }
+
+            void setLive(bool live)
+            {
+                std::lock_guard<std::mutex> lock(m_stateMutex);
+                m_live = live;
+            }
+
+            void nameThread()
+            {
+                using SetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PCWSTR);
+                if (HMODULE kernel = GetModuleHandleW(L"kernel32.dll"))
+                    if (auto fn = reinterpret_cast<SetThreadDescriptionFn>(reinterpret_cast<void *>(GetProcAddress(kernel, "SetThreadDescription"))))
+                        fn(GetCurrentThread(), L"SonyPadHid");
+            }
+
+            void run()
+            {
+                nameThread();
+                size_t lastPadCount = static_cast<size_t>(-1);
+                while (!stopping())
+                {
+                    size_t interfaces = 0u;
+                    std::vector<Device> devices = enumerateSonyPads(interfaces);
+                    if (m_config.trace && devices.size() != lastPadCount)
+                    {
+                        logLine("[sonypad] scan: " + std::to_string(interfaces) + " HID interface(s), " +
+                                std::to_string(devices.size()) + " Sony pad interface(s)");
+                        for (const Device &d : devices)
+                            logLine("[sonypad]   " + describeDevice(d) + " path=" + narrow(d.path));
+                    }
+                    lastPadCount = devices.size();
+                    const int64_t now = nowMs();
+                    const Device *chosen = nullptr;
+                    for (const Device &d : devices)
+                    {
+                        auto silent = m_silentUntil.find(d.path);
+                        if (silent != m_silentUntil.end() && silent->second > now)
+                            continue;
+                        chosen = &d;
+                        break;
+                    }
+                    if (chosen)
+                    {
+                        const Device device = *chosen;
+                        if (!session(device))
+                            m_silentUntil[device.path] = nowMs() + kSilentHoldMs;
+                        lastPadCount = static_cast<size_t>(-1); // report the next scan
+                        if (stopping())
+                            break;
+                    }
+                    WaitForSingleObject(m_stopEvent, chosen ? 500 : kScanIntervalMs);
+                }
+                setLive(false);
+                SetEvent(m_doneEvent);
+            }
+
+            // Writes one output report. Windows' rule for the length varies with the driver: our earlier launcher's exact report
+            // size works for the DualSense; hidapi pads to the collection's longest output report. The exact size is
+            // tried first, the padded one when that is refused, and whichever works is kept.
+            bool write(HANDLE h, const Device &device, std::vector<uint8_t> report, DWORD &error)
+            {
+                error = 0;
+                for (int attempt = 0; attempt < 2; ++attempt)
+                {
+                    std::vector<uint8_t> buffer = report;
+                    if (m_padWrites && buffer.size() < device.outputLength)
+                        buffer.resize(device.outputLength, 0u);
+                    OVERLAPPED overlapped{};
+                    overlapped.hEvent = m_writeEvent;
+                    ResetEvent(m_writeEvent);
+                    DWORD written = 0;
+                    BOOL ok = WriteFile(h, buffer.data(), static_cast<DWORD>(buffer.size()), &written, &overlapped);
+                    if (!ok && GetLastError() == ERROR_IO_PENDING)
+                    {
+                        if (WaitForSingleObject(m_writeEvent, kWriteTimeoutMs) != WAIT_OBJECT_0)
+                        {
+                            CancelIoEx(h, &overlapped);
+                            GetOverlappedResult(h, &overlapped, &written, TRUE);
+                            error = WAIT_TIMEOUT;
+                            return false;
+                        }
+                        ok = GetOverlappedResult(h, &overlapped, &written, FALSE);
+                    }
+                    if (ok)
+                        return true;
+                    error = GetLastError();
+                    const bool lengthRefused = error == ERROR_INVALID_PARAMETER || error == ERROR_INVALID_USER_BUFFER ||
+                                               error == ERROR_INSUFFICIENT_BUFFER;
+                    if (!lengthRefused || attempt == 1 || device.outputLength <= report.size())
+                        return false;
+                    m_padWrites = !m_padWrites;
+                    if (m_config.trace)
+                        logLine(std::string("[sonypad] write refused (error ") + std::to_string(error) + "): trying " +
+                                (m_padWrites ? "the collection's padded length" : "the exact report length"));
+                }
+                return false;
+            }
+
+            OutputState outputState(bool setup, bool release) const
+            {
+                OutputState out;
+                out.lightbar = m_config.lightbar;
+                out.red = m_config.red;
+                out.green = m_config.green;
+                out.blue = m_config.blue;
+                out.lightbarSetup = setup;
+                out.releaseLeds = release && m_config.lightbar;
+                if (setup)
+                    out.red = out.green = out.blue = 0u; // our earlier launcher's takeover: dark, the colour follows in the next write
+                if (!release)
+                    applyMotors(guestMotors(0), m_config.rumblePercent, out);
+                return out;
+            }
+
+            // One connection: true when the pad delivered input (false: it never reported, try another interface).
+            bool session(const Device &device)
+            {
+                bool canWrite = true;
+                HANDLE h = CreateFileW(device.path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                       nullptr, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, nullptr);
+                if (h == INVALID_HANDLE_VALUE)
+                {
+                    canWrite = false;
+                    h = CreateFileW(device.path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                                    FILE_FLAG_OVERLAPPED, nullptr);
+                }
+                if (h == INVALID_HANDLE_VALUE)
+                {
+                    logLine("[sonypad] cannot open the " + std::string(modelName(device.model)) + " (error " +
+                            std::to_string(GetLastError()) + "): another program may hold it");
+                    return false;
+                }
+                HidD_SetNumInputBuffers(h, 4); // a late read sees the newest reports, not a backlog
+                if (device.link == Link::Bluetooth)
+                {
+                    DWORD error = 0;
+                    const bool ok = readFullReportFeature(device, error);
+                    if (m_config.trace)
+                        logLine(std::string("[sonypad] full-report switch (feature 0x") +
+                                (device.model == Model::DualSense ? "05" : "02") + "): " +
+                                (ok ? "ok" : "failed, error " + std::to_string(error)));
+                }
+                HANDLE readEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                m_writeEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                m_padWrites = false;
+                std::vector<uint8_t> buffer(std::clamp<size_t>(device.inputLength, 64u, kMaxReportBytes), 0u);
+                OVERLAPPED overlapped{};
+                overlapped.hEvent = readEvent;
+                bool pending = false;
+                bool reported = false;
+                bool announced = false;
+                bool crcCheck = true;
+                int crcFailuresInRow = 0;
+                int tracedReports = 0, tracedChanges = 0;
+                uint64_t reports = 0, badCrc = 0, ignored = 0, tooShort = 0, writes = 0, writeFailures = 0;
+                InputState last;
+                const int64_t opened = nowMs();
+                int64_t lastReport = opened, lastWrite = 0, lastSummary = opened;
+                uint64_t writtenGeneration = guestMotorsGeneration() - 1u; // forces the first state write
+                bool writesOn = canWrite;
+                bool setupPending = canWrite && m_config.lightbar && device.model == Model::DualSense;
+                std::string endReason = "stopping";
+
+                if (!canWrite)
+                    logLine("[sonypad] the " + std::string(modelName(device.model)) +
+                            " opened read-only: input works, rumble and light bar do not");
+
+                auto handleReport = [&](DWORD length) {
+                    lastReport = nowMs();
+                    InputState state;
+                    const ParseResult result = parseInputReport(device.model, device.link, buffer.data(), length, state, crcCheck);
+                    if (m_config.trace && tracedReports < kTraceReports)
+                    {
+                        ++tracedReports;
+                        logLine("[sonypad] report " + std::to_string(length) + " bytes: " + hex(buffer.data(), length) + " -> " +
+                                parseResultName(result) + (result == ParseResult::Input ? " " + describeState(state) : std::string()));
+                    }
+                    switch (result)
+                    {
+                    case ParseResult::Input:
+                        crcFailuresInRow = 0;
+                        ++reports;
+                        reported = true;
+                        if (!announced)
+                        {
+                            announced = true;
+                            logLine("[sonypad] " + std::string(modelName(device.model)) + " connected over " +
+                                    linkName(device.link) + ": it drives the PS2 pad natively" +
+                                    (writesOn ? " (rumble and light bar too)" : ""));
+                        }
+                        if (m_config.trace && tracedChanges < kTraceChanges &&
+                            (state.buttons != last.buttons || std::abs(state.lx - last.lx) > 24 || std::abs(state.ly - last.ly) > 24 ||
+                             std::abs(state.rx - last.rx) > 24 || std::abs(state.ry - last.ry) > 24 || std::abs(state.l2 - last.l2) > 24 ||
+                             std::abs(state.r2 - last.r2) > 24))
+                        {
+                            ++tracedChanges;
+                            logLine("[sonypad] input " + describeState(state));
+                            last = state;
+                        }
+                        publish(state);
+                        break;
+                    case ParseResult::BadCrc:
+                        ++badCrc;
+                        if (++crcFailuresInRow >= kCrcFailuresBeforeBypass && crcCheck)
+                        {
+                            crcCheck = false;
+                            logLine("[sonypad] " + std::to_string(kCrcFailuresBeforeBypass) +
+                                    " Bluetooth reports in a row fail the CRC32 check: reading them without it");
+                        }
+                        break;
+                    case ParseResult::TooShort:
+                        ++tooShort;
+                        break;
+                    case ParseResult::Ignored:
+                        ++ignored;
+                        break;
+                    }
+                };
+
+                while (!stopping())
+                {
+                    if (!pending)
+                    {
+                        ResetEvent(readEvent);
+                        DWORD length = 0;
+                        if (ReadFile(h, buffer.data(), static_cast<DWORD>(buffer.size()), &length, &overlapped))
+                            handleReport(length);
+                        else if (GetLastError() == ERROR_IO_PENDING)
+                            pending = true;
+                        else
+                        {
+                            endReason = "read error " + std::to_string(GetLastError());
+                            break;
+                        }
+                    }
+                    if (pending)
+                    {
+                        HANDLE waits[3] = {readEvent, m_wakeEvent, m_stopEvent};
+                        const DWORD signalled = WaitForMultipleObjects(3, waits, FALSE, kWaitSliceMs);
+                        if (signalled == WAIT_OBJECT_0)
+                        {
+                            DWORD length = 0;
+                            if (GetOverlappedResult(h, &overlapped, &length, FALSE))
+                            {
+                                pending = false;
+                                handleReport(length);
+                            }
+                            else if (GetLastError() != ERROR_IO_INCOMPLETE)
+                            {
+                                pending = false;
+                                endReason = "read error " + std::to_string(GetLastError());
+                                break;
+                            }
+                        }
+                    }
+
+                    const int64_t now = nowMs();
+                    // Output: the light-bar takeover once, then the state on every motor change and as a keep-alive.
+                    if (writesOn)
+                    {
+                        const uint64_t generation = guestMotorsGeneration();
+                        const OutputState out = outputState(false, false);
+                        const bool rumbling = out.weakMotor != 0u || out.strongMotor != 0u;
+                        const bool due = generation != writtenGeneration ||
+                                         now - lastWrite >= (rumbling ? kRumbleKeepAliveMs : kIdleKeepAliveMs);
+                        if (setupPending || due)
+                        {
+                            const bool setup = setupPending;
+                            std::vector<uint8_t> report =
+                                buildOutputReport(device.model, device.link, setup ? outputState(true, false) : out, device.outputLength);
+                            DWORD error = 0;
+                            const bool ok = write(h, device, report, error);
+                            ++writes;
+                            lastWrite = now;
+                            if (setup)
+                                setupPending = false;
+                            else
+                                writtenGeneration = generation;
+                            if (m_config.trace && (writes <= 4 || (!setup && generation != m_tracedGeneration)))
+                            {
+                                const Motors motors = guestMotors(0);
+                                char line[160];
+                                std::snprintf(line, sizeof(line), "%s small=%s large=%u -> weak=%u strong=%u: %s",
+                                              setup ? "light-bar takeover" : "state", motors.small ? "on" : "off", motors.large,
+                                              out.weakMotor, out.strongMotor, ok ? "ok" : ("error " + std::to_string(error)).c_str());
+                                logLine("[sonypad] write " + std::to_string(report.size()) + " bytes (" + line + "): " +
+                                        hex(report.data(), report.size(), 16));
+                                if (!setup)
+                                    m_tracedGeneration = generation;
+                            }
+                            if (!ok && ++writeFailures >= 8 && writes == writeFailures)
+                            {
+                                writesOn = false;
+                                logLine("[sonypad] the " + std::string(modelName(device.model)) + " refuses output reports (error " +
+                                        std::to_string(error) + "): no rumble or light bar on this connection");
+                            }
+                        }
+                    }
+
+                    // A pad streams reports all the time; silence means it is gone (or another program switched it).
+                    if (reported && now - lastReport > kStaleMs)
+                        setLive(false);
+                    if (!reported && now - opened > kFirstReportMs)
+                    {
+                        endReason = "no input report within " + std::to_string(kFirstReportMs / 1000) + " s";
+                        break;
+                    }
+                    if (reported && now - lastReport > kDeadMs)
+                    {
+                        endReason = "no input report for " + std::to_string(kDeadMs / 1000) + " s";
+                        break;
+                    }
+                    if (m_config.trace && now - lastSummary >= 5000)
+                    {
+                        lastSummary = now;
+                        logLine("[sonypad] last 5 s: " + std::to_string(reports) + " input, " + std::to_string(ignored) +
+                                " other, " + std::to_string(badCrc) + " bad CRC, " + std::to_string(tooShort) + " short report(s); " +
+                                std::to_string(writes) + " write(s), " + std::to_string(writeFailures) + " failed");
+                        reports = ignored = badCrc = tooShort = 0;
+                    }
+                }
+
+                const bool closing = stopping();
+                if (pending)
+                {
+                    DWORD length = 0;
+                    CancelIoEx(h, &overlapped);
+                    GetOverlappedResult(h, &overlapped, &length, TRUE);
+                }
+                if (closing && writesOn)
+                {
+                    // The game is closing: motors off, the LEDs back to the firmware (our earlier launcher's exit).
+                    DWORD error = 0;
+                    write(h, device, buildOutputReport(device.model, device.link, outputState(false, true), device.outputLength), error);
+                }
+                setLive(false);
+                CloseHandle(h);
+                CloseHandle(readEvent);
+                CloseHandle(m_writeEvent);
+                m_writeEvent = nullptr;
+                if (announced && !closing)
+                    logLine("[sonypad] " + std::string(modelName(device.model)) + " disconnected (" + endReason +
+                            "): GLFW gamepad input until it is back");
+                else if (!announced && m_config.trace)
+                    logLine("[sonypad] " + describeDevice(device) + ": " + endReason);
+                return reported || closing;
+            }
+
+            std::mutex m_lifecycle;
+            bool m_started = false;
+            Config m_config;
+            std::thread m_thread;
+            HANDLE m_stopEvent = nullptr;
+            HANDLE m_wakeEvent = nullptr;
+            HANDLE m_doneEvent = nullptr;
+            HANDLE m_writeEvent = nullptr;
+            bool m_padWrites = false;
+            uint64_t m_tracedGeneration = 0;
+            std::map<std::wstring, int64_t> m_silentUntil;
+            std::mutex m_stateMutex;
+            InputState m_state;
+            bool m_live = false;
+        };
+
+        Host &instance()
+        {
+            static Host *host = new Host(); // never destroyed: main() leaves with _Exit, and a detached thread may use it
+            return *host;
+        }
+    }
+
+    bool available() { return true; }
+    void start(const Config &config) { instance().start(config); }
+    bool latest(InputState &out) { return instance().latest(out); }
+    void wake() { instance().wake(); }
+    void stop() { instance().stop(); }
+}
+
+#else
+
+namespace ps2x::sonypad::host
+{
+    bool available() { return false; }
+    void start(const Config &) {}
+    bool latest(InputState &) { return false; }
+    void wake() {}
+    void stop() {}
+}
