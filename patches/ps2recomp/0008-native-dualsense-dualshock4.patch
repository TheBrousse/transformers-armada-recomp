+        press(gamepadButtonDown(sony, GAMEPAD_BUTTON_MIDDLE_LEFT), PAD_SELECT);    // Create / Share
+        press((sony.buttons & kTouchpad) != 0u, PAD_SELECT);                       // the touchpad click too
+        press(gamepadButtonDown(sony, GAMEPAD_BUTTON_LEFT_THUMB), PAD_L3);
