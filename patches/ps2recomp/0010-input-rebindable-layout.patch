+    // The keyboard and mouse layout: a list of keys (raylib key codes) or mouse buttons
+    // (kMouseCode + raylib's button) for each pad button and stick direction. PS2X_KEYMAP, or
+    // setKeyBindings, in the form "cross=X;circle=C,BACKSPACE;r1=LEFT_ALT,MOUSE_LEFT;lup=W;...":
+    // the inputs named for an input replace its defaults, the others keep theirs.
+    constexpr int kMouseCode = 1000;
+    enum BindingInput
+    {
+        kBindUp, kBindDown, kBindLeft, kBindRight, kBindCross, kBindCircle, kBindSquare, kBindTriangle,
+        kBindL1, kBindR1, kBindL2, kBindR2, kBindL3, kBindR3, kBindStart, kBindSelect,
+        kBindLUp, kBindLDown, kBindLLeft, kBindLRight, kBindRUp, kBindRDown, kBindRLeft, kBindRRight,
+        kBindCount
+    };
+    struct BindingName
+    {
+        const char *name;
+        uint16_t mask; // the pad button (0: a stick direction)
+    };
+    constexpr BindingName kBindingNames[kBindCount] = {
+        {"up", PAD_UP},       {"down", PAD_DOWN},     {"left", PAD_LEFT},       {"right", PAD_RIGHT},
+        {"cross", PAD_CROSS}, {"circle", PAD_CIRCLE}, {"square", PAD_SQUARE},   {"triangle", PAD_TRIANGLE},
+        {"l1", PAD_L1},       {"r1", PAD_R1},         {"l2", PAD_L2},           {"r2", PAD_R2},
+        {"l3", PAD_L3},       {"r3", PAD_R3},         {"start", PAD_START},     {"select", PAD_SELECT},
+        {"lup", 0},           {"ldown", 0},           {"lleft", 0},             {"lright", 0},
+        {"rup", 0},           {"rdown", 0},           {"rleft", 0},             {"rright", 0}};
+
+    // The Transformers layout (patch 0009's): L1 jumps and is the movement Mini-Con, Triangle
+    // transforms, R1 fires, R2 and L2 are Mini-Con abilities, R3 the aiming view, Start pauses.
+    const char *const kDefaultKeymap =
+        "up=UP;down=DOWN;left=LEFT;right=RIGHT;cross=X;circle=C,BACKSPACE;square=R,KP_0;"
+        "triangle=T,V,F,KP_1;l1=SPACE,Q,MOUSE_MIDDLE;r1=LEFT_ALT,MOUSE_LEFT;l2=Z,LEFT_SHIFT;"
+        "r2=E,LEFT_CONTROL,RIGHT_SHIFT;l3=G;r3=B,MOUSE_RIGHT;start=ENTER,ESCAPE,P;select=TAB;"
+        "lup=W;ldown=S;lleft=A;lright=D;rup=I;rdown=K;rleft=J;rright=L";
+
+    struct KeyName
+    {
+        const char *name;
+        int code;
+    };
+    const KeyName kKeyNames[] = {
+        {"SPACE", KEY_SPACE}, {"ENTER", KEY_ENTER}, {"ESCAPE", KEY_ESCAPE}, {"TAB", KEY_TAB},
+        {"BACKSPACE", KEY_BACKSPACE}, {"INSERT", KEY_INSERT}, {"DELETE", KEY_DELETE}, {"HOME", KEY_HOME},
+        {"END", KEY_END}, {"PAGE_UP", KEY_PAGE_UP}, {"PAGE_DOWN", KEY_PAGE_DOWN},
+        {"UP", KEY_UP}, {"DOWN", KEY_DOWN}, {"LEFT", KEY_LEFT}, {"RIGHT", KEY_RIGHT},
+        {"LEFT_SHIFT", KEY_LEFT_SHIFT}, {"RIGHT_SHIFT", KEY_RIGHT_SHIFT}, {"LEFT_CONTROL", KEY_LEFT_CONTROL},
+        {"RIGHT_CONTROL", KEY_RIGHT_CONTROL}, {"LEFT_ALT", KEY_LEFT_ALT}, {"RIGHT_ALT", KEY_RIGHT_ALT},
+        {"CAPS_LOCK", KEY_CAPS_LOCK}, {"GRAVE", KEY_GRAVE}, {"MINUS", KEY_MINUS}, {"EQUAL", KEY_EQUAL},
+        {"LEFT_BRACKET", KEY_LEFT_BRACKET}, {"RIGHT_BRACKET", KEY_RIGHT_BRACKET}, {"BACKSLASH", KEY_BACKSLASH},
+        {"SEMICOLON", KEY_SEMICOLON}, {"APOSTROPHE", KEY_APOSTROPHE}, {"COMMA", KEY_COMMA}, {"PERIOD", KEY_PERIOD},
+        {"SLASH", KEY_SLASH}, {"KP_0", KEY_KP_0}, {"KP_1", KEY_KP_1}, {"KP_2", KEY_KP_2}, {"KP_3", KEY_KP_3},
+        {"KP_4", KEY_KP_4}, {"KP_5", KEY_KP_5}, {"KP_6", KEY_KP_6}, {"KP_7", KEY_KP_7}, {"KP_8", KEY_KP_8},
+        {"KP_9", KEY_KP_9}, {"KP_ENTER", KEY_KP_ENTER}, {"KP_ADD", KEY_KP_ADD}, {"KP_SUBTRACT", KEY_KP_SUBTRACT},
+        {"MOUSE_LEFT", kMouseCode + MOUSE_BUTTON_LEFT}, {"MOUSE_RIGHT", kMouseCode + MOUSE_BUTTON_RIGHT},
+        {"MOUSE_MIDDLE", kMouseCode + MOUSE_BUTTON_MIDDLE}, {"MOUSE_SIDE", kMouseCode + MOUSE_BUTTON_SIDE},
+        {"MOUSE_EXTRA", kMouseCode + MOUSE_BUTTON_EXTRA}};
+
+    std::string keyNameOf(int code)
+    {
+        if ((code >= KEY_A && code <= KEY_Z) || (code >= KEY_ZERO && code <= KEY_NINE))
+            return std::string(1, static_cast<char>(code));
+        if (code >= KEY_F1 && code <= KEY_F12)
+            return "F" + std::to_string(code - KEY_F1 + 1);
+        for (const KeyName &k : kKeyNames)
+            if (k.code == code)
+                return k.name;
+        return std::to_string(code);
+    }
+
+    int keyCodeOf(std::string name)
+    {
+        for (char &c : name)
+            c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+        if (name.size() == 1 && ((name[0] >= 'A' && name[0] <= 'Z') || (name[0] >= '0' && name[0] <= '9')))
+            return name[0];
+        if (name.size() >= 2 && name[0] == 'F' && std::isdigit(static_cast<unsigned char>(name[1])))
+        {
+            const int n = std::atoi(name.c_str() + 1);
+            if (n >= 1 && n <= 12)
+                return KEY_F1 + n - 1;
+        }
+        for (const KeyName &k : kKeyNames)
+            if (name == k.name)
+                return k.code;
+        if (!name.empty() && std::isdigit(static_cast<unsigned char>(name[0])))
+            return std::atoi(name.c_str());
+        return -1;
+    }
+
+    std::mutex g_bindingsMutex;
+    std::vector<int> g_bindings[kBindCount];
+    bool g_bindingsLoaded = false;
+
+    // A layout string into `into` (only the inputs it names).
+    void parseKeymap(const std::string &spec, std::vector<int> (&into)[kBindCount])
+    {
+        size_t at = 0;
+        while (at < spec.size())
+        {
+            size_t end = spec.find(';', at);
+            if (end == std::string::npos)
+                end = spec.size();
+            const std::string item = spec.substr(at, end - at);
+            at = end + 1;
+            const size_t eq = item.find('=');
+            if (eq == std::string::npos)
+                continue;
+            const std::string input = item.substr(0, eq);
+            int index = -1;
+            for (int i = 0; i < kBindCount; ++i)
+                if (input == kBindingNames[i].name)
+                    index = i;
+            if (index < 0)
+                continue;
+            std::vector<int> codes;
+            const std::string list = item.substr(eq + 1);
+            size_t p = 0;
+            while (p <= list.size())
+            {
+                size_t comma = list.find(',', p);
+                if (comma == std::string::npos)
+                    comma = list.size();
+                const int code = keyCodeOf(list.substr(p, comma - p));
+                if (code >= 0)
+                    codes.push_back(code);
+                p = comma + 1;
+            }
+            into[index] = codes;
+        }
+    }
+
+    // (with g_bindingsMutex held)
+    void loadBindingsLocked()
+    {
+        if (g_bindingsLoaded)
+            return;
+        g_bindingsLoaded = true;
+        parseKeymap(kDefaultKeymap, g_bindings);
+        if (const char *env = std::getenv("PS2X_KEYMAP"); env && *env)
+            parseKeymap(env, g_bindings);
+    }
+
+    std::string formatKeymap(const std::vector<int> (&from)[kBindCount])
+    {
+        std::string out;
+        for (int i = 0; i < kBindCount; ++i)
+        {
+            if (!out.empty())
+                out += ';';
+            out += kBindingNames[i].name;
+            out += '=';
+            for (size_t c = 0; c < from[i].size(); ++c)
+                out += (c ? "," : "") + keyNameOf(from[i][c]);
+        }
+        return out;
+    }
+
+    bool bindingDown(int code, bool mouseLive)
+    {
+        if (code >= kMouseCode)
+            return mouseLive && IsMouseButtonDown(code - kMouseCode);
+        return IsKeyDown(code);
+    }
+}
+
 namespace ps2_host_input
 {
+
+    void setKeyBindings(const std::string &layout)
+    {
+        std::lock_guard<std::mutex> lock(g_bindingsMutex);
+        g_bindingsLoaded = true;
+        for (auto &b : g_bindings)
+            b.clear();
+        parseKeymap(kDefaultKeymap, g_bindings);
+        parseKeymap(layout, g_bindings);
+    }
+
+    std::string keyBindings()
+    {
+        std::lock_guard<std::mutex> lock(g_bindingsMutex);
+        loadBindingsLocked();
+        return formatKeymap(g_bindings);
+    }
+
+    std::string defaultKeyBindings()
+    {
+        std::vector<int> defaults[kBindCount];
+        parseKeymap(kDefaultKeymap, defaults);
+        return formatKeymap(defaults);
+    }
+
+    std::string keyName(int code) { return keyNameOf(code); }
+    int keyCode(const std::string &name) { return keyCodeOf(name); }
+    int mouseButtonCode(int button) { return kMouseCode + button; }
