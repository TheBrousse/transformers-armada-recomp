+    long long bufferedFrames()
+    {
+        Stream &s = stream();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (!s.configured || s.muted)
+            return -1;
+        const bool consuming = (s.enabled && s.deviceStarted) || (s.simulateStarted && !s.enabled);
+        return consuming ? static_cast<long long>(s.count) : -1;
+    }
+
+    size_t targetFrames() { return kTargetFill; }
