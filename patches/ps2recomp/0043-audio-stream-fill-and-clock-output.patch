+    // PS2X_AUDIO_SIM: a device's pace without a device - every few milliseconds the frames of the
+    // real time gone by are taken, as a sound card's callback takes them (into nothing).
+    void simulateLoop()
+    {
+        std::vector<int16_t> scratch;
+        auto last = std::chrono::steady_clock::now();
+        double owed = 0.0;
+        for (;;)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+            const auto now = std::chrono::steady_clock::now();
+            owed += std::chrono::duration<double>(now - last).count() * kSampleRate;
+            last = now;
+            const unsigned frames = static_cast<unsigned>(std::min(owed, static_cast<double>(kSampleRate)));
+            owed -= frames;
+            if (frames == 0u)
+                continue;
+            scratch.resize(static_cast<size_t>(frames) * 2u);
+            deviceCallback(scratch.data(), frames);
+        }
     }
 
     void startDevice(Stream &s)
     {
+        if (s.simulate && !s.simulateStarted)
+        {
+            s.simulateStarted = true;
+            std::thread(simulateLoop).detach();
+            std::fprintf(stderr, "[audio] PS2X_AUDIO_SIM: the output taken by a clock at 48 kHz (no sound card)\n");
+        }
         if (s.deviceStarted || !s.enabled || !IsAudioDeviceReady())
             return;
         s.deviceStarted = true;
