+    // (FPS round 4) The leaf functions made inline at their jal sites (RecompilerConfig::inlineLeaves): a generated
+    // function of at most that many instructions whose code makes no call, no jump to another function, no loop
+    // (a backward goto: every loop has its checkpoint), no syscall/break/trap, no switch, no runtime call but the
+    // stores' (Store8..128, drainCompletedDmacHandlers), throws nothing, and ends in `jr $ra`. Its own function stays
+    // (the table, the dispatcher, other callers); each caller's file gets
+    //   leaf_<name>: the same code as a static force-inlined function, and
+    //   Ps2CallLeaf_<name>: the call - while the table entry is still <name> (not replaced): the dispatcher's
+    //     checkpoint and level for a call (PS2Runtime::leafBegin), the body, and the end of a call
+    //     (PS2Runtime::leafEnd: what dispatchGuestCall does after its call); else dispatchGuestCall.
+    // The same guest code in the same order with the same checkpoints; only the host's calls differ.
+    void PS2Recompiler::buildInlineLeaves(const std::vector<const Function *> &outputFunctions)
+    {
+        auto leaves = std::make_shared<std::unordered_map<uint32_t, CodeGenerator::InlineLeaf>>();
+        const uint32_t maxInstructions = static_cast<uint32_t>(m_config.inlineLeaves);
+        size_t considered = 0;
+        for (const Function *function : outputFunctions)
+        {
+            if (function->isStub || function->isSkipped || function->end <= function->start ||
+                (function->end - function->start) / 4u > maxInstructions)
+                continue;
+            const auto decoded = m_decodedFunctions.find(function->start);
+            if (decoded == m_decodedFunctions.end())
+                continue;
+            const std::string name = m_codeGenerator->getFunctionName(function->start);
+            const size_t suffix = name.rfind("_0x");
+            if (name.empty() || suffix == std::string::npos || suffix + 3 >= name.size() ||
+                name.find_first_not_of("0123456789abcdef", suffix + 3) != std::string::npos)
+                continue;
+            ++considered;
+            std::string text;
+            try
+            {
+                text = m_codeGenerator->generateFunction(*function, decoded->second, false);
+            }
+            catch (const std::exception &)
+            {
+                continue;
+            }
+            // (the return's diagnostics block names dispatchGuestBranch: left out of the tests)
+            std::string body;
+            static constexpr std::string_view kStrictBegin = "#if defined(PS2X_STRICT_RETURN_DIAGNOSTICS)";
+            static constexpr std::string_view kStrictElse = "#else";
+            bool returns = false;
+            for (size_t at = 0;;)
+            {
+                const size_t strict = text.find(kStrictBegin, at);
+                if (strict == std::string::npos)
+                {
+                    body.append(text, at, std::string::npos);
+                    break;
+                }
+                returns = true;
+                body.append(text, at, strict - at);
+                const size_t other = text.find(kStrictElse, strict);
+                at = other == std::string::npos ? text.size() : other + kStrictElse.size();
+            }
+            if (!returns)
+                continue;
+            bool ok = true;
+            for (std::string_view bad : {"dispatchGuest", "eeCheckpointDue", "eeLoopCheckpoint", "handleSyscall", "handleBreak", "handleTrap",
+                                         "(rdram, ctx, runtime); return;", "switch (", "Ps2Call", "throw ", "try ", "catch"})
+            {
+                if (body.find(bad) != std::string::npos)
+                {
+                    ok = false;
+                    break;
+                }
+            }
+            for (size_t at = body.find("runtime->"); ok && at != std::string::npos; at = body.find("runtime->", at + 9))
+            {
+                const std::string_view rest(body.data() + at + 9, std::min<size_t>(40, body.size() - at - 9));
+                if (!(rest.starts_with("Store8(") || rest.starts_with("Store16(") || rest.starts_with("Store32(") ||
+                      rest.starts_with("Store64(") || rest.starts_with("Store128(") ||
+                      rest.starts_with("drainCompletedDmacHandlers(")))
+                    ok = false;
+            }
+            // a backward goto (a loop): every label must come after the gotos to it
+            for (size_t at = body.find("goto label_"); ok && at != std::string::npos; at = body.find("goto label_", at + 11))
+            {
+                const size_t end = body.find(';', at);
+                if (end == std::string::npos)
+                {
+                    ok = false;
+                    break;
+                }
+                const std::string label = body.substr(at + 5, end - at - 5) + ":";
+                const size_t defined = body.find("\n" + label);
+                if (defined == std::string::npos || defined < at)
+                    ok = false;
+            }
+            if (!ok)
+                continue;
+            const std::string signature = "void " + name + "(";
+            const size_t sig = text.find(signature);
+            if (sig == std::string::npos)
+                continue;
+            std::string inlineBody = text;
+            inlineBody.replace(sig, signature.size(), "static PS2_FORCEINLINE void leaf_" + name + "(");
+            char guard[64];
+            std::snprintf(guard, sizeof(guard), "PS2X_LEAF_%08X", function->start);
+            char address[16];
+            std::snprintf(address, sizeof(address), "0x%Xu", function->start);
+            CodeGenerator::InlineLeaf leaf;
+            leaf.callName = "Ps2CallLeaf_" + name;
+            leaf.definition = std::string("#ifndef ") + guard + "\n#define " + guard + "\n" + inlineBody +
+                              "static PS2_FORCEINLINE bool " + leaf.callName +
+                              "(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, uint32_t source, uint32_t fallthrough)\n{\n"
+                              "    const PS2Runtime::RecompiledFunction fn = PS2_CALL_TARGET(" + address + ");\n"
+                              "    if (fn != &" + name + " || !g_ps2InlineLeaves) [[unlikely]]\n"
+                              "        return runtime->dispatchGuestCall(rdram, ctx, " + address + ", source, fallthrough, fn);\n"
+                              "    const uint32_t level = runtime->leafBegin(ctx, " + address + ");\n"
+                              "    if (level == 0u)\n"
+                              "        return false;\n"
+                              "    leaf_" + name + "(rdram, ctx, runtime);\n"
+                              "    return runtime->leafEnd(rdram, ctx, " + address + ", fallthrough, level);\n"
+                              "}\n#endif\n\n";
+            leaves->emplace(function->start, std::move(leaf));
+        }
+        {
+            std::ostringstream msg;
+            msg << "inline leaves (at most " << maxInstructions << " instructions): " << leaves->size() << " of "
+                << considered << " small functions";
+            m_reporter.progress(msg.str());
+        }
+        m_codeGenerator->m_inlineLeaves = std::move(leaves);
+    }
