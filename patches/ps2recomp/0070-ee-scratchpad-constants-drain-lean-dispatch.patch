diff --git a/ps2xRuntime/include/runtime/ps2_leaf_call.h b/ps2xRuntime/include/runtime/ps2_leaf_call.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_leaf_call.h
@@ -0,0 +1,91 @@
+#ifndef PS2_LEAF_CALL_H
+#define PS2_LEAF_CALL_H
+
+// (FPS round 4) The inline leaf calls' runtime part (the recompiler's inline_leaves: Ps2CallLeaf_<name> in the
+// generated code). leafBegin = PS2Runtime::callBegin and leafEnd = callEnd, inline: the generated code makes the
+// call's checkpoint (8 cycles, the dispatcher's), keeps the call's level, runs the leaf's body in place and ends
+// the call - the same EE clock and the same checkpoints as dispatchGuestCall, without the host call through the
+// function table.
+
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+PS2_FORCEINLINE uint32_t PS2Runtime::leafBegin(R5900Context *ctx, uint32_t targetPc)
+{
+    ctx->pc = targetPc;
+    EeScheduler *scheduler = eeSchedulerFast();
+    if (scheduler && scheduler->checkpointDue(EeScheduler::kGuestDispatchCycles)) [[unlikely]]
+        return 0u;
+    Ps2DispatchLevels &levels = g_ps2DispatchLevels;
+    const uint32_t level = levels.level + 1u;
+    levels.level = level;
+    if (level < Ps2DispatchLevels::kLevels) [[likely]]
+        levels.resumedByDispatcher[level] = false;
+    return level;
+}
+
+PS2_FORCEINLINE bool PS2Runtime::leafEnd(uint8_t *rdram, R5900Context *ctx, uint32_t targetPc, uint32_t fallthroughPc,
+                                         uint32_t level)
+{
+    // afterCall when the leaf came back to its caller with nothing else to do: not stopped, at the fallthrough
+    // (never 0 nor the leaf's own entry), and no caller of this level to resume.
+    Ps2DispatchLevels &levels = g_ps2DispatchLevels;
+    if (ctx->pc == fallthroughPc && !stopRequestedFast() &&
+        !(level < Ps2DispatchLevels::kLevels && levels.resumedByDispatcher[level])) [[likely]]
+    {
+        if (EeScheduler *scheduler = eeSchedulerFast())
+            scheduler->clearCheckpointUnwind();
+        --levels.level;
+        return true;
+    }
+    return callEnd(rdram, ctx, targetPc, fallthroughPc, level);
+}
+
+// A `jal` to a generated function (`known`, direct_call_sites): its table entry read here; when that is still `known`
+// (not replaced), the call made right here between leafBegin and leafEnd (what dispatchGuestCall does before and after
+// it). Else (replaced, missing) and with PS2X_DIRECT_CALLS=0 or 1: dispatchGuestCall (1: the entry read, 0: the lookup).
+static PS2_FORCEINLINE bool Ps2CallKnown(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, uint32_t target,
+                                         uint32_t source, uint32_t fallthrough, PS2Runtime::RecompiledFunction known)
+{
+    const PS2Runtime::RecompiledFunction fn = PS2_CALL_TARGET(target);
+    if (fn != known || g_ps2DirectCalls != 2) [[unlikely]]
+        return runtime->dispatchGuestCall(rdram, ctx, target, source, fallthrough, fn);
+    const uint32_t level = runtime->leafBegin(ctx, target);
+    if (level == 0u)
+        return false;
+    known(rdram, ctx, runtime);
+    return runtime->leafEnd(rdram, ctx, target, fallthrough, level);
+}
+
+PS2_FORCEINLINE bool PS2Runtime::eeLoopCheckpoint() noexcept
+{
+    if (!g_ps2InlineCheckpoints) [[unlikely]]
+        return eeCheckpointDue();
+    return m_eeScheduler->checkpointDue(EeScheduler::kGeneratedCheckpointCycles);
+}
+
+// A `jalr` (indirect_call_sites): the target's table entry read here - what dispatchGuestBranch's lookup returns -
+// and the call made here between leafBegin and leafEnd (its checkpoint, level and end, with the target as the
+// call's entry). No entry (added code, a bad address) or PS2X_INDIRECT_CALLS=0: dispatchGuestBranch as before.
+static PS2_FORCEINLINE bool Ps2CallIndirect(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, uint32_t target,
+                                            uint32_t source, uint32_t fallthrough)
+{
+    const PS2Runtime::RecompiledFunction fn = PS2_CALL_TARGET(target);
+    if (!fn || !g_ps2IndirectCallSites) [[unlikely]]
+        return runtime->dispatchGuestBranch(rdram, ctx, target, source, fallthrough, PS2Runtime::GuestBranchKind::IndirectCall,
+                                            "JALR");
+    const uint32_t level = runtime->leafBegin(ctx, target);
+    if (level == 0u)
+        return false;
+    fn(rdram, ctx, runtime);
+    return runtime->leafEnd(rdram, ctx, target, fallthrough, level);
+}
+
+PS2_FORCEINLINE void PS2Runtime::drainCompletedDmacHandlersFast(uint8_t *rdram)
+{
+    if (g_ps2DrainInline && !m_memory.m_completedDmacPending.load(std::memory_order_acquire)) [[likely]]
+        return;
+    drainCompletedDmacHandlers(rdram);
+}
+
+#endif // PS2_LEAF_CALL_H
