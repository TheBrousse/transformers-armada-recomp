+// PS2X_EE_STATS=1 (debugging aid): how often the dispatcher re-enters guest code and why.
+struct EeDispatchStats
+{
+    uint64_t reentries = 0, invocations = 0, deadlines = 0, slices = 0, timerIrqs = 0;
+    uint64_t events[8] = {};
+    static constexpr size_t kPcSlotsO = 4096;
+    uint64_t unwound = 0, transfers = 0;
+    bool originNoted = false;
+    uint64_t origKey[kPcSlotsO] = {};
+    uint64_t origCount[kPcSlotsO] = {};
+    void noteOrigin(uint32_t target, uint32_t pc)
+    {
+        if (originNoted)
+            return;
+        originNoted = true;
+        const uint64_t key = (static_cast<uint64_t>(target) << 32) | pc;
+        size_t i = static_cast<size_t>((key >> 2) * 2654435761u % kPcSlotsO);
+        for (size_t n = 0; n < 16; ++n, i = (i + 1) % kPcSlotsO)
+            if (origKey[i] == key || origCount[i] == 0)
+            {
+                origKey[i] = key;
+                ++origCount[i];
+                return;
+            }
+    }
+    static constexpr size_t kPcSlots = 4096;
+    uint32_t pcKey[kPcSlots] = {};
+    uint64_t pcCount[kPcSlots] = {};
+    void notePc(uint32_t pc, bool unwinding)
+    {
+        unwound += unwinding ? 1u : 0u;
+        originNoted = false;
+        size_t i = (pc >> 2) * 2654435761u % kPcSlots;
+        for (size_t n = 0; n < 16; ++n, i = (i + 1) % kPcSlots)
+            if (pcKey[i] == pc || pcCount[i] == 0)
+            {
+                pcKey[i] = pc;
+                ++pcCount[i];
+                return;
+            }
+    }
+    void printIfDue();
+};
