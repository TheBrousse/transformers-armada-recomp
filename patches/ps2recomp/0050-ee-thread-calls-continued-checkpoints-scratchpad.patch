+void EeDispatchStats::printIfDue()
+{
+    static const bool on = std::getenv("PS2X_EE_STATS") && *std::getenv("PS2X_EE_STATS") == '1';
+    if (!on)
+        return;
+    static auto last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    const double secs = std::chrono::duration<double>(now - last).count();
+    if (secs < 2.0)
+        return;
+    last = now;
+    std::fprintf(stderr, "[ee stats] a second: re-entries %.0f, invocations %.0f, deadlines %.0f, slices %.0f, events vbs %.0f vbe %.0f dmac %.0f wake %.0f alarm %.0f, timer irqs %.0f\n",
+                 reentries / secs, invocations / secs, deadlines / secs, slices / secs, events[1] / secs, events[2] / secs,
+                 events[3] / secs, events[4] / secs, events[5] / secs, timerIrqs / secs);
+    std::vector<std::pair<uint64_t, uint32_t>> top;
+    for (size_t i = 0; i < kPcSlots; ++i)
+        if (pcCount[i])
+            top.push_back({pcCount[i], pcKey[i]});
+    std::sort(top.rbegin(), top.rend());
+    std::fprintf(stderr, "[ee stats]   unwound-for-checkpoint %.0f; top re-entry pcs:", unwound / secs);
+    for (size_t i = 0; i < top.size() && i < 12; ++i)
+        std::fprintf(stderr, " %08x:%.0f", top[i].second, top[i].first / secs);
+    std::vector<std::pair<uint64_t, uint64_t>> orig;
+    for (size_t i = 0; i < kPcSlotsO; ++i)
+        if (origCount[i])
+            orig.push_back({origCount[i], origKey[i]});
+    std::sort(orig.rbegin(), orig.rend());
+    std::fprintf(stderr, "\n[ee stats]   dispatcher transfers (throws) %.0f; calls left to the dispatcher (callee -> pc):", transfers / secs);
+    for (size_t i = 0; i < orig.size() && i < 12; ++i)
+        std::fprintf(stderr, " %08x->%08x:%.0f", static_cast<uint32_t>(orig[i].second >> 32), static_cast<uint32_t>(orig[i].second),
+                     orig[i].first / secs);
+    std::fprintf(stderr, "\n");
+    *this = EeDispatchStats{};
+}
