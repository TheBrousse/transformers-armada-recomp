+void EeScheduler::flushHeldCycles() noexcept
+{
+    const uint64_t held = m_heldCycles;
+    m_heldCycles = 0u;
+    PS2Memory &memory = m_runtime.memory();
+    if (held != 0u)
+    {
+        // (as accountCyclesInline did at every checkpoint before: the timers, then the IOP)
+        m_pendingEeTimerInterrupts |= memory.advanceEeTimers(held);
+        m_runtime.advanceIopEeCycles(held);
+        if (m_pendingEeTimerInterrupts != 0u)
+        {
+            ++g_eeDispatchStats.timerIrqs;
+            m_checkpointPending.store(true, std::memory_order_release);
+        }
+    }
+    // The timers add cycles up without acting while they stay below their next interrupt and
+    // no GIF count is to be cleared (PS2Memory::advanceEeTimers), the IOP below its next batch.
+    const uint64_t timers = (!memory.m_gifFqcSet && memory.m_eeTimerInterrupts == 0u &&
+                             memory.m_eeTimerDue > memory.m_eeTimerCycles)
+                                ? memory.m_eeTimerDue - memory.m_eeTimerCycles
+                                : 0u;
+    m_heldLimit = std::min(timers, ps2IopHeldHeadroom());
+}
+
+bool EeScheduler::checkpointDeadlineOrSlice() noexcept
+{
+    const uint64_t nextEventCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (nextEventCycle != 0u && m_eeCycle >= nextEventCycle)
+    {
+        ++g_eeDispatchStats.deadlines;
+        m_checkpointPending.store(true, std::memory_order_release);
+        m_unwindingForCheckpoint = true;
+        return true;
+    }
+    if (m_eeCycle < m_sliceEndCycle)
+    {
+        refreshFastEnd();
+        return false;
+    }
+    const bool due = timeSliceExpired();
+    g_eeDispatchStats.slices += due ? 1u : 0u;
+    if (due)
+        m_unwindingForCheckpoint = true;
+    else
+        refreshFastEnd();
+    return due;
+}
