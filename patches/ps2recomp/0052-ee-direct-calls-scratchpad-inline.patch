+// (FPS round 3) A `jal` to a generated function (`known`): its table entry read here; when that is
+// still `known` (not replaced), the call made right here - each site its own direct call, where the
+// dispatcher had one indirect call for every target - between PS2Runtime::callBegin and callEnd,
+// which do what dispatchGuestCall does before and after it. Else (replaced, missing) and with
+// PS2X_DIRECT_CALLS=0 or 1: dispatchGuestCall (1: the entry read, 0: the lookup).
+extern const int g_ps2DirectCalls;
+static PS2_FORCEINLINE bool Ps2CallKnown(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, uint32_t target,
+                                         uint32_t source, uint32_t fallthrough, PS2Runtime::RecompiledFunction known)
+{
+    const PS2Runtime::RecompiledFunction fn = PS2_CALL_TARGET(target);
+    if (fn != known || g_ps2DirectCalls != 2) [[unlikely]]
+        return runtime->dispatchGuestCall(rdram, ctx, target, source, fallthrough, fn);
+    const uint32_t level = runtime->callBegin(ctx, target);
+    if (level == 0u)
