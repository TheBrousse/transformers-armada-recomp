+// (FPS round 3) The function-table entry of a function's address (nullptr outside the table):
+// PS2Runtime::dispatchGuestCall's target, read by the generated code for a `jal`.
+#define PS2_CALL_TARGET(address)                                                                      \
+    (static_cast<uint32_t>((address) - g_ps2RecompiledFunctionTableBase) <                            \
+             static_cast<uint32_t>(g_ps2RecompiledFunctionTableEnd - g_ps2RecompiledFunctionTableBase) \
+         ? g_ps2RecompiledFunctionTable[static_cast<uint32_t>((address) - g_ps2RecompiledFunctionTableBase) >> 2] \
