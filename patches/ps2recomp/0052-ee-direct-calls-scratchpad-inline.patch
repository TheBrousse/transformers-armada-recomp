+                                           uint32_t targetPc, uint32_t sourcePc, uint32_t fallthroughPc,
+                                           GuestBranchKind kind, const char *debugName)
+{
+    const bool isCall = true;
+    DispatchThread &thread = g_dispatchThread;
     if (!targetFn)
     {
         reportMissingFunction(rdram, ctx, targetPc, sourcePc, kind, debugName);
@@ -1891,7 +1934,14 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
         ~LevelScope() { --t.level; }
