+// (FPS round 3) The scratchpad straight from the generated code, before the special-address
+// tests and the call (PS2Runtime::Load*/Store* did the same after them): an aligned access in its
+// 16 KB, no side effect either way. PS2X_INLINE_SCRATCHPAD=0: the call as before.
+template <typename T>
+static PS2_FORCEINLINE bool Ps2ScratchpadInlineRead(uint32_t addr, T &value)
+{
+    const uint32_t offset = addr - PS2_SCRATCHPAD_BASE;
+    if (!g_ps2InlineScratchpad || offset > PS2_SCRATCHPAD_SIZE - sizeof(T) || (addr & (sizeof(T) - 1u)) != 0u)
+        return false;
+    const uint8_t *scratchpad = ps2GetScratchpadHostPtr();
+    if (!scratchpad)
+        return false;
+    std::memcpy(&value, scratchpad + offset, sizeof(T));
+    return true;
+}
+template <typename T>
+static PS2_FORCEINLINE bool Ps2ScratchpadInlineWrite(uint32_t addr, const T &value)
+{
+    const uint32_t offset = addr - PS2_SCRATCHPAD_BASE;
+    if (!g_ps2InlineScratchpad || offset > PS2_SCRATCHPAD_SIZE - sizeof(T) || (addr & (sizeof(T) - 1u)) != 0u)
+        return false;
+    uint8_t *scratchpad = ps2GetScratchpadHostPtr();
+    if (!scratchpad)
+        return false;
+    std::memcpy(scratchpad + offset, &value, sizeof(T));
+    return true;
+}
