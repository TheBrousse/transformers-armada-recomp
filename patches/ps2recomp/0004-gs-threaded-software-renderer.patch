+    bool parseHex(const std::string &text, uint64_t &value)
+    {
+        if (text.empty() || text.size() > 16)
+            return false;
+        char *end = nullptr;
+        value = std::strtoull(text.c_str(), &end, 16);
+        return end && *end == '\0';
+    }
+
+    // <hash>-<CLUT hash>-<bits> or <hash>-<bits> (region names, -r<w>x<h>-, are not used here).
+    bool parseName(const std::string &stem, gs_texture_pack::Key &key)
+    {
+        std::vector<std::string> parts;
+        size_t start = 0;
+        for (;;)
+        {
+            const size_t dash = stem.find('-', start);
+            parts.push_back(stem.substr(start, dash == std::string::npos ? std::string::npos : dash - start));
+            if (dash == std::string::npos)
+                break;
+            start = dash + 1;
+        }
+        uint64_t bits = 0u;
+        if (parts.size() == 3)
+            return parseHex(parts[0], key.hash) && parseHex(parts[1], key.clutHash) && parseHex(parts[2], bits) &&
+                   (key.bits = static_cast<uint32_t>(bits), true);
+        if (parts.size() == 2)
+            return parseHex(parts[0], key.hash) && parseHex(parts[1], bits) && (key.clutHash = 0u, key.bits = static_cast<uint32_t>(bits), true);
+        return false;
+    }
+
+    uint32_t load32(const uint8_t *p, size_t at)
+    {
+        uint32_t v;
+        std::memcpy(&v, p + at, 4);
+        return v;
+    }
+
+    // Address layouts, as the renderer numbers them.
+    enum Layout
+    {
+        kC32,
+        kZ32,
+        kC16,
+        kC16S,
+        kZ16,
+        kZ16S,
+        kP8,
+        kP4,
+    };
+
+    uint32_t pixelIndex(Layout layout, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        using namespace GSMem;
+        switch (layout)
+        {
+        case kC32:
+            return PixelStorageTraits<C32>::Address(PageTableC32, bp, bw, x, y);
+        case kZ32:
+            return PixelStorageTraits<Z32>::Address(PageTableZ32, bp, bw, x, y);
+        case kC16:
+            return PixelStorageTraits<C16>::Address(PageTableC16, bp, bw, x, y);
+        case kC16S:
+            return PixelStorageTraits<C16S>::Address(PageTableC16S, bp, bw, x, y);
+        case kZ16:
+            return PixelStorageTraits<Z16>::Address(PageTableZ16, bp, bw, x, y);
+        case kZ16S:
+            return PixelStorageTraits<Z16S>::Address(PageTableZ16S, bp, bw, x, y);
+        case kP8:
+            return PixelStorageTraits<P8>::Address(PageTableP8, bp, bw, x, y);
+        default:
+            return PixelStorageTraits<P4>::Address(PageTableP4, bp, bw, x, y);
+        }
+    }
+}
+
+namespace gs_texture_pack
+{
+    Pack::~Pack()
+    {
+        m_stop.store(true);
+        if (m_reader.joinable())
+            m_reader.join();
+    }
+
+    bool Pack::open(const std::string &folder)
+    {
+        std::error_code error;
+        if (folder.empty() || !fs::is_directory(folder, error))
+            return false;
+        for (const auto &entry : fs::directory_iterator(folder, error))
+        {
+            if (!entry.is_regular_file())
+                continue;
+            const fs::path path = entry.path();
+            std::string extension = path.extension().string();
+            std::transform(extension.begin(), extension.end(), extension.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            Key key;
+            if (extension != ".dds" || !parseName(path.stem().string(), key))
+                continue;
+            auto texture = std::make_unique<Texture>();
+            texture->path = path.string();
+            m_byKey.emplace(key, texture.get());
+            m_textures.push_back(std::move(texture));
+        }
+        if (m_textures.empty())
+            return false;
+        // The files are read in the background, so that a texture the game shows for the first
+        // time does not wait for the disk.
+        m_reader = std::thread([this]()
+                               {
+                                   for (auto &texture : m_textures)
+                                   {
+                                       if (m_stop.load())
+                                           return;
+                                       take(*texture);
+                                   } });
+        return true;
+    }
+
+    // A texture is read by whoever comes to it first - the reader thread, or find() for one the game
+    // wants before the reader got there - and nobody waits for another file than the one it needs.
+    // (One lock round every read let the GS thread wait behind file after file of the reader's, which
+    // took the lock straight back: 0.1-0.7 s, the pictures frozen, where textures were wanted early -
+    // after a state loaded, in a place not seen before.)
+    void Pack::take(Texture &t)
+    {
+        int expected = 0;
+        if (t.state.compare_exchange_strong(expected, 2, std::memory_order_acq_rel))
+            t.state.store(read(t) ? 1 : -1, std::memory_order_release);
+    }
+
+    Texture *Pack::find(const Key &key)
+    {
+        const auto it = m_byKey.find(key);
+        if (it == m_byKey.end())
+            return nullptr;
+        Texture *texture = it->second;
+        take(*texture);
+        while (texture->state.load(std::memory_order_acquire) == 2)
+            std::this_thread::yield(); // (the reader is at this one: no longer than one file)
+        return texture->state.load(std::memory_order_acquire) == 1 ? texture : nullptr;
+    }
+
+    bool Pack::read(Texture &t)
+    {
+        // (in one read: a byte at a time through a stream iterator was ten times slower)
+        std::ifstream in(t.path, std::ios::binary | std::ios::ate);
+        if (!in)
+            return false;
+        const std::streamoff size = in.tellg();
+        if (size < 128)
+            return false;
+        std::vector<uint8_t> file(static_cast<size_t>(size));
+        in.seekg(0);
+        if (!in.read(reinterpret_cast<char *>(file.data()), static_cast<std::streamsize>(size)))
+            return false;
+        if (std::memcmp(file.data(), "DDS ", 4) != 0)
+            return false;
+        const uint32_t height = load32(file.data(), 12);
+        const uint32_t width = load32(file.data(), 16);
+        const uint32_t mips = std::max<uint32_t>(1u, load32(file.data(), 28));
+        const uint32_t pfFlags = load32(file.data(), 80);
+        const uint32_t fourCC = load32(file.data(), 84);
+        const uint32_t rgbBits = load32(file.data(), 88);
+        size_t offset = 128u;
+        uint32_t blockBytes = 0u; // 0: uncompressed RGBA8
+        bool bgra = false;
+        const auto cc = [](const char *s) { return static_cast<uint32_t>(s[0]) | (static_cast<uint32_t>(s[1]) << 8) |
+                                                   (static_cast<uint32_t>(s[2]) << 16) | (static_cast<uint32_t>(s[3]) << 24); };
+        if ((pfFlags & 0x4u) != 0u) // DDPF_FOURCC
+        {
+            if (fourCC == cc("DXT1"))
+            {
+                t.glFormat = kGlBc1;
+                blockBytes = 8u;
+            }
+            else if (fourCC == cc("DXT3"))
+            {
+                t.glFormat = kGlBc2;
+                blockBytes = 16u;
+            }
+            else if (fourCC == cc("DXT5"))
+            {
+                t.glFormat = kGlBc3;
+                blockBytes = 16u;
+            }
+            else if (fourCC == cc("DX10"))
+            {
+                if (file.size() < 148u)
+                    return false;
+                const uint32_t dxgi = load32(file.data(), 128);
+                offset = 148u;
+                switch (dxgi)
+                {
+                case 71: // BC1_UNORM
+                case 72:
+                    t.glFormat = kGlBc1;
+                    blockBytes = 8u;
+                    break;
+                case 74: // BC2_UNORM
+                case 75:
+                    t.glFormat = kGlBc2;
+                    blockBytes = 16u;
+                    break;
+                case 77: // BC3_UNORM
+                case 78:
+                    t.glFormat = kGlBc3;
+                    blockBytes = 16u;
+                    break;
+                case 98: // BC7_UNORM
+                case 99:
+                    t.glFormat = kGlBc7;
+                    blockBytes = 16u;
+                    break;
+                case 28: // R8G8B8A8_UNORM
+                case 29:
+                    t.glFormat = kGlRgba8;
+                    break;
+                case 87: // B8G8R8A8_UNORM
+                case 91:
+                    t.glFormat = kGlRgba8;
+                    bgra = true;
+                    break;
+                default:
+                    return false;
+                }
+            }
+            else
+            {
+                return false;
+            }
+        }
+        else if ((pfFlags & 0x40u) != 0u && rgbBits == 32u) // DDPF_RGB, 32 bits
+        {
+            t.glFormat = kGlRgba8;
+            bgra = load32(file.data(), 92) == 0x00FF0000u; // red mask in the third byte: BGRA
+        }
+        else
+        {
+            return false;
+        }
+        t.compressed = blockBytes != 0u;
+        t.width = width;
+        t.height = height;
+        size_t at = offset;
+        uint32_t w = width, h = height;
+        for (uint32_t level = 0; level < mips; ++level)
+        {
+            const size_t size = t.compressed ? static_cast<size_t>(std::max(1u, (w + 3u) / 4u)) * std::max(1u, (h + 3u) / 4u) * blockBytes
+                                             : static_cast<size_t>(w) * h * 4u;
+            if (at + size > file.size())
+                break; // (fewer levels than the header says: use those there are)
+            t.levelOffset.push_back(at - offset);
+            t.levelSize.push_back(size);
+            t.levelWidth.push_back(w);
+            t.levelHeight.push_back(h);
+            at += size;
+            w = std::max(1u, w / 2u);
+            h = std::max(1u, h / 2u);
+        }
+        if (t.levelSize.empty())
+            return false;
+        t.data.assign(file.begin() + static_cast<std::ptrdiff_t>(offset), file.begin() + static_cast<std::ptrdiff_t>(at));
+        if (bgra)
+            for (size_t i = 0; i + 3 < t.data.size(); i += 4)
+                std::swap(t.data[i], t.data[i + 2]);
+        return true;
+    }
+
+    uint32_t nameBits(uint8_t psm, uint32_t twLog2, uint32_t thLog2, const GSTexaReg &texa)
+    {
+        uint32_t bits = (psm & 63u) | ((twLog2 & 15u) << 6) | ((thLog2 & 15u) << 10);
+        // TEXA counts for the 24- and 16-bit formats (PCSX2: no palette, fmt > 0).
+        const bool texaFormat = psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == GS_PSM_Z24 ||
+                                psm == GS_PSM_Z16 || psm == GS_PSM_Z16S;
+        if (texaFormat)
+            bits |= (static_cast<uint32_t>(texa.ta0) << 15) | ((texa.aem ? 1u : 0u) << 23) | (static_cast<uint32_t>(texa.ta1) << 24);
+        return bits;
+    }
+
+    uint64_t hashPalette(const uint32_t *colours, uint32_t count)
+    {
+        return XXH3_64bits(colours, static_cast<size_t>(count) * 4u);
+    }
+
+    uint64_t hashTexture(const uint8_t *vram, uint32_t tbp, uint32_t tbw, uint8_t psm, uint32_t tw, uint32_t th, const GSTexaReg &texa)
+    {
+        const uint32_t bw = std::max<uint32_t>(tbw, 1u);
+        Layout layout = kC32;
+        uint32_t bsx = 8u, bsy = 8u, perBlock = 64u;
+        bool fullBits = false, palette = false;
+        switch (psm)
+        {
+        case GS_PSM_CT32:
+            fullBits = true;
+            break;
+        case GS_PSM_Z32:
+            layout = kZ32;
+            fullBits = true;
+            break;
+        case GS_PSM_CT24:
+            break;
+        case GS_PSM_Z24:
+            layout = kZ32;
+            break;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            layout = psm == GS_PSM_CT16 ? kC16 : (psm == GS_PSM_CT16S ? kC16S : (psm == GS_PSM_Z16 ? kZ16 : kZ16S));
+            bsx = 16u;
+            perBlock = 128u;
+            break;
+        case GS_PSM_T8:
+            layout = kP8;
+            bsx = 16u;
+            bsy = 16u;
+            perBlock = 256u;
+            fullBits = true;
+            palette = true;
+            break;
+        case GS_PSM_T4:
+            layout = kP4;
+            bsx = 32u;
+            bsy = 16u;
+            perBlock = 512u;
+            fullBits = true;
+            palette = true;
+            break;
+        case GS_PSM_T8H:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            palette = true;
+            break;
+        default:
+            return 0u;
+        }
+
+        XXH3_state_t state;
+        XXH3_64bits_reset(&state);
+        if (tw >= bsx && th >= bsy && fullBits)
+        {
+            // Its blocks as they are in memory, row of blocks by row of blocks.
+            for (uint32_t by = 0; by < th / bsy; ++by)
+                for (uint32_t bx = 0; bx < tw / bsx; ++bx)
+                {
+                    const uint32_t block = (pixelIndex(layout, tbp, bw, bx * bsx, by * bsy) / perBlock) & 0x3FFFu;
+                    XXH3_64bits_update(&state, vram + static_cast<size_t>(block) * 256u, 256u);
+                }
+            return XXH3_64bits_digest(&state);
+        }
+
+        // Unswizzled: indices as bytes, everything else as RGBA8 (TEXA for 24 and 16 bits).
+        const uint32_t pixelBytes = palette ? 1u : 4u;
+        std::vector<uint8_t> row(static_cast<size_t>(tw) * pixelBytes);
+        const auto raw32 = [&](uint32_t x, uint32_t y)
+        {
+            uint32_t v;
+            std::memcpy(&v, vram + ((static_cast<size_t>(pixelIndex(layout, tbp, bw, x, y)) << 2u) & 0x3FFFFCu), 4);
+            return v;
+        };
+        for (uint32_t y = 0; y < th; ++y)
+        {
+            for (uint32_t x = 0; x < tw; ++x)
+            {
+                uint32_t value = 0u;
+                switch (psm)
+                {
+                case GS_PSM_CT32:
+                case GS_PSM_Z32:
+                    value = raw32(x, y);
+                    break;
+                case GS_PSM_CT24:
+                case GS_PSM_Z24:
+                {
+                    const uint32_t rgb = raw32(x, y) & 0x00FFFFFFu;
+                    value = rgb | ((texa.aem && rgb == 0u) ? 0u : (static_cast<uint32_t>(texa.ta0) << 24));
+                    break;
+                }
+                case GS_PSM_CT16:
+                case GS_PSM_CT16S:
+                case GS_PSM_Z16:
+                case GS_PSM_Z16S:
+                {
+                    uint16_t c;
+                    std::memcpy(&c, vram + ((static_cast<size_t>(pixelIndex(layout, tbp, bw, x, y)) << 1u) & 0x3FFFFEu), 2);
+                    const uint32_t rgb = ((c << 3) & 0xF8u) | ((c << 6) & 0xF800u) | ((static_cast<uint32_t>(c) << 9) & 0xF80000u);
+                    uint32_t a = (c & 0x8000u) ? texa.ta1 : texa.ta0;
+                    if (texa.aem && c == 0u)
+                        a = 0u;
+                    value = rgb | (a << 24);
+                    break;
+                }
+                case GS_PSM_T8:
+                    value = vram[pixelIndex(kP8, tbp, bw, x, y) & 0x3FFFFFu];
+                    break;
+                case GS_PSM_T4:
+                {
+                    const uint32_t nibble = pixelIndex(kP4, tbp, bw, x, y);
+                    const uint8_t byte = vram[(nibble >> 1) & 0x3FFFFFu];
+                    value = (nibble & 1u) ? (byte >> 4) : (byte & 0x0Fu);
+                    break;
+                }
+                case GS_PSM_T8H:
+                    value = raw32(x, y) >> 24;
+                    break;
+                case GS_PSM_T4HL:
+                    value = (raw32(x, y) >> 24) & 0x0Fu;
+                    break;
+                default: // GS_PSM_T4HH
+                    value = raw32(x, y) >> 28;
+                    break;
+                }
+                std::memcpy(row.data() + static_cast<size_t>(x) * pixelBytes, &value, pixelBytes);
+            }
+            XXH3_64bits_update(&state, row.data(), row.size());
+        }
+        return XXH3_64bits_digest(&state);
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_texture_pack.h b/ps2xRuntime/src/lib/gs/gs_texture_pack.h
new file mode 100644
index 0000000..2aee1d6
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_texture_pack.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include "runtime/gs/gs_types.h"
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+// Texture packs in PCSX2's format (its "replacements" folder), for the GPU renderer.
+//
+// A file is named after the texture it replaces: <hash>-<CLUT hash>-<bits>.dds (or
+// <hash>-<bits>.dds without a palette), the hashes in hex without leading zeros. The hash is
+// XXH3-64 of the texture's data in GS local memory as PCSX2 reads it
+// (GSTextureCache::HashCacheKey::Create / HashTextureLevel): its 256-byte blocks in order when
+// it is at least a block in size and its format uses all 32 bits of a pixel, else its texels
+// unswizzled row by row (8-bit indices, or RGBA8 with TEXA for 16 and 24 bits). The CLUT hash
+// is XXH3-64 of the 16 or 256 palette colours (RGBA8, 16-bit ones expanded with TEXA). The
+// bits are PSM (6), TW (4), TH (4), one unused, then for 16- and 24-bit textures TA0 (8),
+// AEM (1) and TA1 (8).
+namespace gs_texture_pack
+{
+    struct Key
+    {
+        uint64_t hash = 0u;
+        uint64_t clutHash = 0u; // 0: no palette
+        uint32_t bits = 0u;
+        bool operator==(const Key &o) const { return hash == o.hash && clutHash == o.clutHash && bits == o.bits; }
+    };
+
+    struct KeyHasher
+    {
+        size_t operator()(const Key &k) const
+        {
+            return static_cast<size_t>(k.hash ^ (k.clutHash * 0x9E3779B97F4A7C15ull) ^ (static_cast<uint64_t>(k.bits) << 17));
+        }
+    };
+
+    // A replacement texture, as its file has it: compressed (BC1, BC3, BC7) or RGBA8 levels.
+    struct Texture
+    {
+        std::string path;
+        uint32_t width = 0u, height = 0u;
+        uint32_t glFormat = 0u;   // GL internal format
+        bool compressed = true;
+        std::vector<uint8_t> data; // all levels, one after the other
+        std::vector<size_t> levelOffset, levelSize;
+        std::vector<uint32_t> levelWidth, levelHeight;
+        std::atomic<int> state{0}; // 0 not read, 2 being read, 1 read, -1 unusable
+        uint32_t glTexture = 0u;   // made on the GS thread on first use
+    };
+
+    class Pack
+    {
+    public:
+        ~Pack();
+
+        // Indexes the folder's .dds files and starts reading them in the background. False when
+        // there is none.
+        bool open(const std::string &folder);
+        bool empty() const { return m_textures.empty(); }
+        size_t size() const { return m_textures.size(); }
+
+        // The replacement for a texture, read (waiting for it if the background reader has not
+        // got to it yet), or null.
+        Texture *find(const Key &key);
+
+    private:
+        static bool read(Texture &t);
+        std::vector<std::unique_ptr<Texture>> m_textures;
+        std::unordered_map<Key, Texture *, KeyHasher> m_byKey;
+        std::thread m_reader;
+        std::atomic<bool> m_stop{false};
+        void take(Texture &t); // reads it, unless someone else has (the reader thread or find())
+    };
+
+    // PCSX2's name parts for a texture of local memory (`vram`, 4 MiB) as the GS samples it.
+    uint64_t hashTexture(const uint8_t *vram, uint32_t tbp, uint32_t tbw, uint8_t psm, uint32_t tw, uint32_t th,
+                         const GSTexaReg &texa);
+    uint64_t hashPalette(const uint32_t *colours, uint32_t count);
+    uint32_t nameBits(uint8_t psm, uint32_t twLog2, uint32_t thLog2, const GSTexaReg &texa);
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
new file mode 100644
index 0000000..3cdcb5b
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
@@ -0,0 +1,995 @@
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_draw_state.h"
+#include "runtime/gs/gs_gpu.h"
+#include "runtime/gs/gs_native_mesh.h"
+#include "runtime/ps2_host_display.h"
+#include "runtime/ps2_vif1_thread.h"
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(USE_SSE2NEON)
+#include "sse2neon.h"
+#else
+#include <immintrin.h>
+#endif
+
+#include <algorithm>
+#include <iterator>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <type_traits>
+
+namespace
+{
+    constexpr size_t kRingBytes = 32u * 1024u * 1024u;
+    constexpr uint32_t kUploadChunk = 256u * 1024u;
+    // (about 30 us of pauses before the GS thread sleeps, as the VIF1 thread waits; 20,000 kept
+    // it spinning a third of its time in a level, a core's worth of nothing)
+    constexpr uint32_t kSpinsBeforeSleep = 2000u;
+
+    struct ClutPayload
+    {
+        GSTex0Reg tex0;
+        GSTexClutReg texclut;
+    };
+
+    struct WriteVramPayload
+    {
+        uint32_t psm, base, bw, x, y, value;
+    };
+
+    struct alignas(16) UploadPayload
+    {
+        uint32_t bytes;
+    };
+
+    struct CapturePayload
+    {
+        GSTransferCommand command;
+        uint64_t number;
+    };
+
+    // A run of primitives: `count` of them with `each` vertices, which follow.
+    struct alignas(16) PrimsHeader
+    {
+        uint32_t count;
+        uint32_t each;
+    };
+
+    constexpr uint32_t kRunPrimitives = 64u; // in one record
+
+    static_assert(std::is_trivially_copyable_v<GSPrimitiveBatch>);
+    static_assert(std::is_trivially_copyable_v<GSTransferCommand>);
+    static_assert(std::is_trivially_copyable_v<ClutPayload>);
+    static_assert(std::is_trivially_copyable_v<GSPresentationRequest>);
+
+    constexpr uint64_t kPageBytes = 8192u;  // a page of GS memory: 64x32 pixels of 32 bits
+    constexpr uint64_t kBlockBytes = 256u;  // the unit of transfer and texture addresses
+    constexpr uint32_t kCaptureBytes = 256u * 1024u; // larger readbacks are not worth predicting
+
+    // The bytes of GS memory that pixels up to (x1, y1) of a buffer `width` pages wide can
+    // lie in, counted from the buffer's start: with 32-bit pixels, the format that spreads
+    // widest (every other format packs the same rectangle into fewer pages).
+    uint64_t footprintBytes(uint32_t widthPages, uint32_t x1, uint32_t y1)
+    {
+        const uint64_t width = std::max<uint32_t>(widthPages, 1u);
+        return ((y1 / 32u) * width + x1 / 64u + 1u) * kPageBytes;
+    }
+
+    uint32_t transferBits(uint8_t psm)
+    {
+        switch (psm)
+        {
+        case 0x00: case 0x30: return 32u;
+        case 0x01: case 0x31: return 24u;
+        case 0x02: case 0x0A: case 0x32: case 0x3A: return 16u;
+        case 0x13: case 0x1B: return 8u;
+        case 0x14: case 0x24: case 0x2C: return 4u;
+        default: return 32u;
+        }
+    }
+
+    bool sameTransfer(const GSTransferCommand &a, const GSTransferCommand &b)
+    {
+        return a.direction == b.direction && a.bitbltbuf.sbp == b.bitbltbuf.sbp && a.bitbltbuf.sbw == b.bitbltbuf.sbw &&
+               a.bitbltbuf.spsm == b.bitbltbuf.spsm && a.trxpos.ssax == b.trxpos.ssax && a.trxpos.ssay == b.trxpos.ssay &&
+               a.trxreg.rrw == b.trxreg.rrw && a.trxreg.rrh == b.trxreg.rrh;
+    }
+
+    inline void cpuRelax()
+    {
+#if defined(USE_SSE2NEON)
+        std::this_thread::yield();
+#else
+        _mm_pause();
+#endif
+    }
+}
+
+bool GSThreadedBackend::enabled()
+{
+    static const bool threaded = []()
+    {
+        const char *sync = std::getenv("PS2X_GS_SYNC");
+        return !(sync && *sync && *sync != '0');
+    }();
+    return threaded;
+}
+
+GSThreadedBackend::GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner)
+    : m_inner(std::move(inner)), m_ring(kRingBytes)
+{
+    m_cpu = dynamic_cast<GSCpuBackend *>(m_inner.get());
+    if (ps2_gpu::requested() && m_cpu)
+    {
+        m_gpu = std::make_unique<GSGpuRenderer>();
+        // Local memory is the software renderer's: up to date once its rasterizer threads are
+        // through (ReadVram waits for them).
+        m_gpu->setSyncHook([cpu = m_cpu]()
+                           { (void)cpu->ReadVram(0u, 0u, 1u, 0u, 0u); });
+        m_gpuOnly = !ps2_gpu::mirrored();
+    }
+    m_thread = std::thread([this]()
+                           { run(); });
+}
+
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_wakeMutex);
+        m_stop.store(true);
+    }
+    m_wake.notify_all();
+    if (m_thread.joinable())
+        m_thread.join();
+}
+
+// ------------------------------------------------------------------------------------
+// Producer side (the thread that runs the GS frontend)
+// ------------------------------------------------------------------------------------
+
+void *GSThreadedBackend::reserve(Op op, uint32_t payloadBytes)
+{
+    const uint64_t capacity = m_ring.size();
+    const uint32_t bytes = static_cast<uint32_t>((sizeof(Record) + payloadBytes + 15u) & ~static_cast<size_t>(15u));
+    const auto waitForSpace = [&](uint64_t needed)
+    {
+        for (uint32_t spin = 0u; m_writePos + needed - m_consumed.load(std::memory_order_acquire) > capacity; ++spin)
+        {
+            publish();
+            if (spin < 256u)
+                cpuRelax();
+            else
+                std::this_thread::yield();
+        }
+    };
+
+    uint64_t offset = m_writePos % capacity;
+    if (offset + bytes > capacity)
+    {
+        // Records never straddle the end of the ring: pad to it with a wrap record.
+        waitForSpace(capacity - offset);
+        Record *wrap = reinterpret_cast<Record *>(m_ring.data() + offset);
+        wrap->op = Op::Wrap;
+        wrap->bytes = static_cast<uint32_t>(capacity - offset);
+        m_writePos += capacity - offset;
+        offset = 0u;
+    }
+    waitForSpace(bytes);
+    Record *record = reinterpret_cast<Record *>(m_ring.data() + offset);
+    record->op = op;
+    record->bytes = bytes;
+    m_writePos += bytes;
+    return record + 1;
+}
+
+void GSThreadedBackend::publish() const
+{
+    m_published.store(m_writePos);
+    if (m_sleeping.load())
+    {
+        std::lock_guard<std::mutex> lock(m_wakeMutex);
+        m_wake.notify_one();
+    }
+}
+
+// The producer side for the length of a scope. A thread that has a run of primitives open
+// holds the lock already; for that thread this ends the run.
+class GSThreadedBackend::Producer
+{
+public:
+    explicit Producer(const GSThreadedBackend &backend) : m_backend(backend)
+    {
+        if (m_backend.m_runOwner.load(std::memory_order_relaxed) == std::this_thread::get_id())
+            m_backend.endRun();
+        else
+            m_backend.m_producerMutex.lock();
+    }
+    ~Producer() { m_backend.m_producerMutex.unlock(); }
+    Producer(const Producer &) = delete;
+    Producer &operator=(const Producer &) = delete;
+
+private:
+    const GSThreadedBackend &m_backend;
+};
+
+void GSThreadedBackend::drain() const
+{
+    {
+        Producer lock(*this);
+        publish();
+    }
+    waitConsumed(m_published.load());
+}
+
+void GSThreadedBackend::beginRun(uint32_t verticesEach)
+{
+    if (m_watching)
+    {
+        // What the primitives of the run may write: their frame buffer and their depth
+        // buffer, down to the last line of the scissor rectangle.
+        const GSContext &context = m_sentState.context;
+        const uint64_t frame = static_cast<uint64_t>(context.frame.fbp) * kPageBytes;
+        const uint64_t depth = static_cast<uint64_t>(context.zbuf.zbp) * kPageBytes;
+        const uint64_t reach = footprintBytes(context.frame.fbw, context.scissor.x1, context.scissor.y1);
+        const bool hits = (frame < m_watchLast && frame + reach > m_watchFirst) ||
+                          (depth < m_watchLast && depth + reach > m_watchFirst);
+        if (hits)
+            watchedRegionWritten();
+        else
+            captureIfSettled();
+    }
+    // Room for a full record; endRun() gives back what stays unused.
+    void *payload = reserve(Op::Prims, static_cast<uint32_t>(sizeof(PrimsHeader) + kRunPrimitives * verticesEach * sizeof(GSVertex)));
+    m_run = static_cast<Record *>(payload) - 1;
+    m_runStart = m_writePos - m_run->bytes;
+    m_runEach = verticesEach;
+    m_runCount = 0u;
+    m_runOwner.store(std::this_thread::get_id(), std::memory_order_relaxed);
+}
+
+void GSThreadedBackend::endRun() const
+{
+    auto *header = reinterpret_cast<PrimsHeader *>(m_run + 1);
+    header->count = m_runCount;
+    header->each = m_runEach;
+    const size_t bytes = sizeof(Record) + sizeof(PrimsHeader) + static_cast<size_t>(m_runCount) * m_runEach * sizeof(GSVertex);
+    m_run->bytes = static_cast<uint32_t>((bytes + 15u) & ~static_cast<size_t>(15u));
+    m_writePos = m_runStart + m_run->bytes;
+    m_run = nullptr;
+    m_runOwner.store(std::thread::id{}, std::memory_order_relaxed);
+    publish();
+}
+
+void GSThreadedBackend::waitConsumed(uint64_t position) const
+{
+    for (uint32_t spin = 0u; m_consumed.load(std::memory_order_acquire) < position; ++spin)
+    {
+        if (m_sleeping.load())
+        {
+            std::lock_guard<std::mutex> lock(m_wakeMutex);
+            m_wake.notify_one();
+        }
+        if (spin < 128u)
+            cpuRelax();
+        else if (spin < 2048u)
+            std::this_thread::yield();
+        else
+            std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+}
+
+void GSThreadedBackend::noteWrite(uint64_t first, uint64_t last)
+{
+    if (!m_watching)
+        return;
+    if (first < m_watchLast && last > m_watchFirst)
+        watchedRegionWritten();
+    else
+        captureIfSettled();
+}
+
+void GSThreadedBackend::watchedRegionWritten()
+{
+    m_watchWritten = true;
+    m_captureCurrent = false;
+    if (m_aheadWindow)
+    {
+        m_aheadWindow = false;
+        ps2vif1::readbackAheadFailed();
+    }
+}
+
+bool GSThreadedBackend::ReadbackAhead(const GSTransferCommand &command, uint8_t *dst, uint32_t maxBytes, uint32_t &bytes)
+{
+    uint64_t position = 0u;
+    uint64_t captureNumber = 0u;
+    {
+        Producer lock(*this);
+        if (!dst || !m_watching || !sameTransfer(command, m_watchCommand))
+            return false;
+        captureIfSettled();
+        if (!m_captureCurrent || m_watchWritten)
+            return false;
+        position = m_capturePos;
+        captureNumber = m_capturesQueued;
+        m_aheadWindow = true;
+        m_readbackPending = false;
+        publish();
+    }
+    waitCaptured(position, captureNumber);
+    {
+        std::lock_guard<std::mutex> lock(m_captureMutex);
+        bytes = std::min(maxBytes, m_capturedBytes);
+        std::memcpy(dst, m_captured.data(), bytes);
+    }
+    ++m_quickReadbacks;
+    return true;
+}
+
+void GSThreadedBackend::EndReadbackAhead()
+{
+    Producer lock(*this);
+    m_aheadWindow = false;
+}
+
+void GSThreadedBackend::captureIfSettled()
+{
+    // Not between the pieces of an upload: the capture is a transfer of its own.
+    if (!m_watching || !m_watchWritten || m_uploadBytesLeft != 0u)
+        return;
+    auto *capture = static_cast<CapturePayload *>(reserve(Op::Capture, sizeof(CapturePayload)));
+    capture->command = m_watchCommand;
+    capture->number = ++m_capturesQueued;
+    m_capturePos = m_writePos;
+    m_watchWritten = false;
+    m_captureCurrent = true;
+    publish();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    {
+        Producer lock(*this);
+        if (!m_stateSent || !gsSameDrawState(m_sentState, batch.state))
+        {
+            m_sentState = batch.state;
+            m_stateSent = true;
+            std::memcpy(reserve(Op::State, sizeof(GSDrawState)), &batch.state, sizeof(GSDrawState));
+        }
+    }
+    SubmitVertices(batch.vertices.data(), batch.vertexCount);
+}
+
+void GSThreadedBackend::SetDrawState(const GSDrawState &state)
+{
+    Producer lock(*this);
+    m_sentState = state;
+    m_stateSent = true;
+    std::memcpy(reserve(Op::State, sizeof(GSDrawState)), &state, sizeof(GSDrawState));
+}
+
+void GSThreadedBackend::SubmitVertices(const GSVertex *vertices, uint32_t count)
+{
+    if (!vertices || count == 0u || count > 3u)
+        return;
+    if (m_runOwner.load(std::memory_order_relaxed) != std::this_thread::get_id())
+    {
+        // The lock is kept until this thread ends the run (Flush, or whatever it queues next).
+        m_producerMutex.lock();
+        beginRun(count);
+    }
+    else if (m_runEach != count || m_runCount == kRunPrimitives)
+    {
+        endRun();
+        beginRun(count);
+    }
+    auto *run = reinterpret_cast<GSVertex *>(reinterpret_cast<uint8_t *>(m_run + 1) + sizeof(PrimsHeader));
+    std::memcpy(run + static_cast<size_t>(m_runCount) * count, vertices, count * sizeof(GSVertex));
+    ++m_runCount;
+}
+
+void GSThreadedBackend::SubmitMesh(const uint8_t *mesh, uint32_t bytes, uint32_t field)
+{
+    if (!mesh || bytes == 0u || bytes > 64u * 1024u)
+        return;
+    Producer lock(*this);
+    if (m_watching)
+    {
+        // What its triangles may write, as for a run of primitives (beginRun).
+        const GSContext &context = m_sentState.context;
+        const uint64_t frame = static_cast<uint64_t>(context.frame.fbp) * kPageBytes;
+        const uint64_t depth = static_cast<uint64_t>(context.zbuf.zbp) * kPageBytes;
+        const uint64_t reach = footprintBytes(context.frame.fbw, context.scissor.x1, context.scissor.y1);
+        if ((frame < m_watchLast && frame + reach > m_watchFirst) || (depth < m_watchLast && depth + reach > m_watchFirst))
+            watchedRegionWritten();
+        else
+            captureIfSettled();
+    }
+    auto *payload = static_cast<MeshPayload *>(reserve(Op::Mesh, static_cast<uint32_t>(sizeof(MeshPayload) + bytes)));
+    payload->bytes = bytes;
+    payload->field = field;
+    std::memcpy(payload + 1, mesh, bytes);
+    publish();
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Producer lock(*this);
+    const ClutPayload payload{tex0, texclut};
+    std::memcpy(reserve(Op::LoadClut, sizeof(payload)), &payload, sizeof(payload));
+    publish();
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    Producer lock(*this);
+    m_servedBytes = m_capturedBytes; // a new transfer: nothing of an earlier readback is left to hand out
+    if (command.direction == 1u)
+    {
+        // Local to host: held back until the data is asked for (ConsumeLocalToHostBytes),
+        // which decides whether the capture answers it.
+        m_readback = command;
+        m_readbackPending = true;
+        return;
+    }
+    m_readbackPending = false;
+    m_uploadBytesLeft = 0u;
+    if (command.direction == 0u || command.direction == 2u)
+    {
+        const uint64_t first = static_cast<uint64_t>(command.bitbltbuf.dbp) * kBlockBytes;
+        const uint32_t x1 = command.trxpos.dsax + std::max<uint32_t>(command.trxreg.rrw, 1u) - 1u;
+        const uint32_t y1 = command.trxpos.dsay + std::max<uint32_t>(command.trxreg.rrh, 1u) - 1u;
+        noteWrite(first, first + footprintBytes(command.bitbltbuf.dbw, x1, y1));
+        if (command.direction == 0u)
+            m_uploadBytesLeft = (static_cast<uint64_t>(command.trxreg.rrw) * command.trxreg.rrh *
+                                 transferBits(command.bitbltbuf.dpsm) + 7u) / 8u;
+    }
+    std::memcpy(reserve(Op::BeginTransfer, sizeof(command)), &command, sizeof(command));
+    publish();
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u)
+        return;
+    Producer lock(*this);
+    m_uploadBytesLeft -= std::min<uint64_t>(m_uploadBytesLeft, sizeBytes);
+    // The backend tracks transfer progress, so large uploads can arrive in pieces.
+    for (uint32_t offset = 0u; offset < sizeBytes;)
+    {
+        const uint32_t chunk = std::min(kUploadChunk, sizeBytes - offset);
+        auto *payload = static_cast<UploadPayload *>(reserve(Op::UploadImage, sizeof(UploadPayload) + chunk));
+        payload->bytes = chunk;
+        std::memcpy(payload + 1, data + offset, chunk);
+        offset += chunk;
+        publish();
+    }
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    Producer lock(*this);
+    reserve(Op::TextureFlush, 0u);
+    publish();
+}
+
+void GSThreadedBackend::SetPresentSink(PresentSink sink)
+{
+    Producer lock(*this);
+    m_presentSink = std::move(sink);
+}
+
+void GSThreadedBackend::QueuePresent(const GSPresentationRequest &request)
+{
+    Producer lock(*this);
+    captureIfSettled();
+    std::memcpy(reserve(Op::Present, sizeof(request)), &request, sizeof(request));
+    publish();
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    Producer lock(*this);
+    noteWrite(static_cast<uint64_t>(base) * kBlockBytes, static_cast<uint64_t>(base) * kBlockBytes + footprintBytes(bw, x, y));
+    const WriteVramPayload payload{psm, base, bw, x, y, value};
+    std::memcpy(reserve(Op::WriteVram, sizeof(payload)), &payload, sizeof(payload));
+    publish();
+}
+
+// ------------------------------------------------------------------------------------
+// Calls that observe the result wait for the queue first
+// ------------------------------------------------------------------------------------
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    drain();
+    {
+        Producer lock(*this);
+        m_watching = m_captureCurrent = m_readbackPending = false;
+        m_stateSent = false;
+    }
+    m_inner->Initialize(vram, vramSize);
+    if (m_gpu)
+        m_gpu->setVram(vram, vramSize); // (the GS thread is idle after the drain)
+}
+
+void GSThreadedBackend::Reset()
+{
+    drain();
+    {
+        Producer lock(*this);
+        m_watching = m_captureCurrent = m_readbackPending = false;
+        m_stateSent = false;
+    }
+    m_inner->Reset();
+    if (m_gpu)
+        m_gpu->invalidate();
+}
+
+void GSThreadedBackend::Flush()
+{
+    // Queued commands keep their order; the run of primitives this thread is collecting
+    // is handed to the GS thread.
+    if (m_runOwner.load(std::memory_order_relaxed) == std::this_thread::get_id())
+    {
+        endRun();
+        m_producerMutex.unlock();
+    }
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    // FINISH needs no wait: whatever observes the drawn frame (readbacks, presentation)
+    // synchronizes on its own.
+    if (reason == GSSyncReason::Finish)
+        return;
+    drain();
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    return m_inner->Present(request); // after Sync(Presentation); the backend locks itself
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    downloadFromGpu(); // (the clear goes to the software renderer's local memory, the GPU reads it back)
+    drain();
+    {
+        Producer lock(*this);
+        watchedRegionWritten(); // outside the queue: it may well be the region
+    }
+    if (m_gpu)
+        m_gpu->invalidate();
+    return m_inner->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    Producer lock(*this);
+    if (!dst || maxBytes == 0u)
+        return 0u;
+    publish();
+    if (!m_readbackPending)
+    {
+        // More of a readback that was answered from the capture, or of one the backend holds.
+        if (m_servedBytes < m_capturedBytes)
+        {
+            const uint32_t count = std::min(maxBytes, m_capturedBytes - m_servedBytes);
+            std::memcpy(dst, m_captured.data() + m_servedBytes, count);
+            m_servedBytes += count;
+            return count;
+        }
+        waitConsumed(m_published.load());
+        return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+    }
+    m_readbackPending = false;
+
+    static const bool stats = []
+    {
+        const char *value = std::getenv("PS2X_GS_STATS");
+        return value && *value && *value != '0';
+    }();
+    const auto report = [&]()
+    {
+        if (stats && (m_quickReadbacks + m_fullReadbacks) % 120u == 0u)
+            std::fprintf(stderr, "[gs:readback] %llu answered from a capture taken where the region was last drawn, %llu after waiting for the whole queue\n",
+                         static_cast<unsigned long long>(m_quickReadbacks), static_cast<unsigned long long>(m_fullReadbacks));
+    };
+
+    if (m_watching && m_captureCurrent && !m_watchWritten && sameTransfer(m_readback, m_watchCommand))
+    {
+        waitCaptured(m_capturePos, m_capturesQueued);
+        std::lock_guard<std::mutex> captureLock(m_captureMutex);
+        const uint32_t count = std::min(maxBytes, m_capturedBytes);
+        std::memcpy(dst, m_captured.data(), count);
+        m_servedBytes = count;
+        ++m_quickReadbacks;
+        report();
+        return count;
+    }
+
+    // The old way: the transfer where it stands in the queue, and everything before it.
+    std::memcpy(reserve(Op::BeginTransfer, sizeof(m_readback)), &m_readback, sizeof(m_readback));
+    publish();
+    waitConsumed(m_published.load());
+    const uint32_t count = m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+    ++m_fullReadbacks;
+    report();
+
+    // Watch this region from now on. What was just read is its capture until something
+    // writes there - when all of it was read and it is small enough to keep.
+    const uint64_t bytes = (static_cast<uint64_t>(m_readback.trxreg.rrw) * m_readback.trxreg.rrh *
+                            transferBits(m_readback.bitbltbuf.spsm) + 7u) / 8u;
+    m_watching = bytes != 0u && bytes <= kCaptureBytes;
+    m_watchCommand = m_readback;
+    m_watchFirst = static_cast<uint64_t>(m_readback.bitbltbuf.sbp) * kBlockBytes;
+    m_watchLast = m_watchFirst + footprintBytes(m_readback.bitbltbuf.sbw,
+                                                m_readback.trxpos.ssax + std::max<uint32_t>(m_readback.trxreg.rrw, 1u) - 1u,
+                                                m_readback.trxpos.ssay + std::max<uint32_t>(m_readback.trxreg.rrh, 1u) - 1u);
+    m_watchWritten = false;
+    m_captureCurrent = m_watching && count == bytes;
+    if (m_captureCurrent)
+    {
+        std::lock_guard<std::mutex> captureLock(m_captureMutex);
+        m_captured.assign(dst, dst + count);
+        m_capturedBytes = m_servedBytes = count;
+        m_capturePos = m_published.load();
+        captureTaken(m_capturesQueued);
+    }
+    return count;
+}
+
+void GSThreadedBackend::captureTaken(uint64_t number)
+{
+    m_capturesTaken.store(number, std::memory_order_seq_cst);
+    const uint64_t wanted = m_captureWanted.load(std::memory_order_seq_cst);
+    if (wanted != 0u && number >= wanted)
+    {
+        std::lock_guard<std::mutex> lock(m_captureWaitMutex);
+        m_captureReached.notify_all();
+    }
+}
+
+// The capture is taken behind a barrier on a rasterizer thread once the GS thread is past
+// its record. A sleep would wake the waiter up to a millisecond late (on Windows), once a
+// frame: whoever takes it wakes the waiter instead.
+void GSThreadedBackend::waitCaptured(uint64_t position, uint64_t capture) const
+{
+    (void)position; // a capture is only taken once the GS thread has got to its record
+    for (uint32_t spin = 0u; spin < 256u; ++spin)
+    {
+        if (m_capturesTaken.load(std::memory_order_acquire) >= capture)
+            return;
+        cpuRelax();
+    }
+    if (m_sleeping.load())
+    {
+        std::lock_guard<std::mutex> lock(m_wakeMutex);
+        m_wake.notify_one();
+    }
+    std::unique_lock<std::mutex> lock(m_captureWaitMutex);
+    m_captureWanted.store(capture, std::memory_order_seq_cst);
+    while (m_capturesTaken.load(std::memory_order_seq_cst) < capture)
+        m_captureReached.wait_for(lock, std::chrono::milliseconds(5));
+    m_captureWanted.store(0u, std::memory_order_relaxed);
+}
+
+// GPU-only drawing: what the GPU drew is written to the software renderer's local memory (on
+// the GS thread, in the queue's order), before something reads it from there.
+void GSThreadedBackend::downloadFromGpu()
+{
+    if (!m_gpuOnly)
+        return;
+    {
+        Producer lock(*this);
+        reserve(Op::GpuDownload, 0u);
+        publish();
+    }
+    drain();
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    const_cast<GSThreadedBackend *>(this)->downloadFromGpu();
+    drain();
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    const_cast<GSThreadedBackend *>(this)->downloadFromGpu();
+    drain();
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    return m_inner->GetTransferSnapshot(); // debug views only; may lag the queue
+}
+
+bool GSThreadedBackend::SaveState(ps2x::StateWriter &out)
+{
+    downloadFromGpu();
+    drain();
+    auto *cpu = dynamic_cast<GSCpuBackend *>(m_inner.get());
+    if (!cpu)
+        return false;
+    cpu->SaveState(out);
+    return true;
+}
+
+bool GSThreadedBackend::LoadState(ps2x::StateReader &in)
+{
+    drain();
+    {
+        Producer lock(*this);
+        m_watching = m_captureCurrent = m_readbackPending = false;
+        m_stateSent = false;
+    }
+    auto *cpu = dynamic_cast<GSCpuBackend *>(m_inner.get());
+    if (!cpu)
+        return false;
+    cpu->LoadState(in);
+    if (m_gpu)
+        m_gpu->invalidate(); // local memory changed behind the queue
+    return true;
+}
+
+// ------------------------------------------------------------------------------------
+// GS thread
+// ------------------------------------------------------------------------------------
+
+void GSThreadedBackend::run()
+{
+    const uint64_t capacity = m_ring.size();
+    uint64_t readPos = 0u;
+    // (PS2X_GPU_STALL_LOG=<ms>, debugging aid: a record of the queue - or the flush or idle between
+    // them - that takes longer is logged with what it was: where the GS thread froze.)
+    static const double stallMs = []()
+    {
+        const char *env = std::getenv("PS2X_GPU_STALL_LOG");
+        return env ? std::atof(env) : 0.0;
+    }();
+    const auto stallCheck = [](const char *what, std::chrono::steady_clock::time_point since)
+    {
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - since).count();
+        if (ms >= stallMs)
+            std::fprintf(stderr, "[gs] stall: %s took %.1f ms\n", what, ms);
+    };
+    static const char *const kOpNames[] = {"wrap", "submit", "clut", "transfer", "upload", "texture flush", "local write",
+                                           "present", "capture", "state", "primitives", "download", "mesh"};
+    for (;;)
+    {
+        uint64_t published = m_published.load();
+        if (published == readPos)
+        {
+            const auto since = stallMs > 0.0 ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+            m_inner->Flush(); // nothing more for now: what was drawn so far need not wait for a full batch
+            if (stallMs > 0.0)
+                stallCheck("flush", since);
+        }
+        for (uint32_t spin = 0u; published == readPos && spin < kSpinsBeforeSleep; ++spin)
+        {
+            if (m_stop.load())
+                return;
+            cpuRelax();
+            published = m_published.load();
+        }
+        if (published == readPos)
+        {
+            if (m_gpu)
+            {
+                const auto since = stallMs > 0.0 ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+                m_gpu->idle(); // (the producer paused: what is drawn goes to the GPU now)
+                if (stallMs > 0.0)
+                    stallCheck("idle", since);
+            }
+            std::unique_lock<std::mutex> lock(m_wakeMutex);
+            m_sleeping.store(true);
+            m_wake.wait(lock, [&]()
+                        { return m_stop.load() || m_published.load() != readPos; });
+            m_sleeping.store(false);
+            if (m_stop.load() && m_published.load() == readPos)
+                return;
+            continue;
+        }
+
+        while (readPos < published)
+        {
+            const Record *record = reinterpret_cast<const Record *>(m_ring.data() + readPos % capacity);
+            const void *payload = record + 1;
+            // The GPU draws alone once it is up; until then (no window yet) the software renderer
+            // does, and the GPU starts from its local memory.
+            const bool gpuOnly = m_gpuOnly && m_gpu->ready();
+            if (gpuOnly && !m_meshesReady.load(std::memory_order_relaxed))
+                m_meshesReady.store(true, std::memory_order_relaxed);
+            const auto recordStart = stallMs > 0.0 ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+            switch (record->op)
+            {
+            case Op::Submit:
+                if (!gpuOnly)
+                    m_inner->Submit(*static_cast<const GSPrimitiveBatch *>(payload));
+                break;
+            case Op::State:
+                if (m_gpu)
+                    m_gpu->setDrawState(*static_cast<const GSDrawState *>(payload));
+                if (gpuOnly)
+                    break;
+                if (m_cpu)
+                    m_cpu->SetDrawState(*static_cast<const GSDrawState *>(payload));
+                else
+                    m_threadState = *static_cast<const GSDrawState *>(payload);
+                break;
+            case Op::Prims:
+            {
+                const auto *header = static_cast<const PrimsHeader *>(payload);
+                const auto *vertices = reinterpret_cast<const GSVertex *>(header + 1);
+                if (m_gpu)
+                    m_gpu->drawPrimitives(vertices, header->count, header->each);
+                if (gpuOnly)
+                    break;
+                if (m_cpu)
+                {
+                    m_cpu->DrawPrimitives(vertices, header->count, header->each);
+                    break;
+                }
+                for (uint32_t i = 0; i < header->count; ++i)
+                {
+                    GSPrimitiveBatch batch{};
+                    batch.state = m_threadState;
+                    batch.vertexCount = static_cast<uint8_t>(std::min<uint32_t>(header->each, 3u));
+                    for (uint32_t k = 0; k < batch.vertexCount; ++k)
+                        batch.vertices[k] = vertices[static_cast<size_t>(i) * header->each + k];
+                    m_inner->Submit(batch);
+                }
+                break;
+            }
+            case Op::LoadClut:
+            {
+                const auto *clut = static_cast<const ClutPayload *>(payload);
+                if (!gpuOnly)
+                    m_inner->LoadClut(clut->tex0, clut->texclut);
+                if (m_gpu)
+                    m_gpu->loadClut(clut->tex0, clut->texclut);
+                break;
+            }
+            case Op::BeginTransfer:
+                if (gpuOnly)
+                    m_gpu->beforeTransfer(*static_cast<const GSTransferCommand *>(payload));
+                m_inner->BeginTransfer(*static_cast<const GSTransferCommand *>(payload));
+                if (m_gpu)
+                    m_gpu->beginTransfer(*static_cast<const GSTransferCommand *>(payload));
+                break;
+            case Op::UploadImage:
+            {
+                const auto *upload = static_cast<const UploadPayload *>(payload);
+                m_inner->UploadImage(reinterpret_cast<const uint8_t *>(upload + 1), upload->bytes);
+                if (m_gpu)
+                    m_gpu->uploadImage();
+                break;
+            }
+            case Op::TextureFlush:
+                m_inner->TextureFlush();
+                break;
+            case Op::WriteVram:
+            {
+                const auto *write = static_cast<const WriteVramPayload *>(payload);
+                if (gpuOnly)
+                    m_gpu->beforeWriteVram(write->psm, write->base, write->bw, write->x, write->y);
+                m_inner->WriteVram(write->psm, write->base, write->bw, write->x, write->y, write->value);
+                if (m_gpu)
+                    m_gpu->writeVram(write->psm, write->base, write->bw, write->x, write->y);
+                break;
+            }
+            case Op::Present:
+            {
+                const auto &request = *static_cast<const GSPresentationRequest *>(payload);
+                if (m_gpu)
+                    m_gpu->present(request);
+                if (gpuOnly)
+                {
+                    // The window shows the GPU's picture; the host display only learns that
+                    // this VBlank's picture is there.
+                    static const std::vector<uint8_t> none;
+                    ps2_host_display::publish(request.vsyncTick, none, 0u, 0u, 0u, false, 0u);
+                    break;
+                }
+                if (m_cpu)
+                {
+                    // Built by a rasterizer thread once what came before is drawn.
+                    m_cpu->PresentQueued(request, [this, tick = request.vsyncTick](PresentationFrame &&frame)
+                                         {
+                                             uint32_t firstLineParity = 0u;
+                                             const bool fieldMode = m_cpu->presentedFieldMode(firstLineParity);
+                                             ps2_host_display::publish(tick, frame.pixels, frame.width, frame.height,
+                                                                       GSCpuBackend::kFrameStride, fieldMode, firstLineParity);
+                                             if (m_presentSink)
+                                                 m_presentSink(std::move(frame)); });
+                    break;
+                }
+                PresentationFrame frame = m_inner->Present(request);
+                ps2_host_display::publish(request.vsyncTick, frame.pixels, frame.width, frame.height,
+                                          GSCpuBackend::kFrameStride, false, 0u);
+                if (m_presentSink)
+                    m_presentSink(std::move(frame));
+                break;
+            }
+            case Op::Capture:
+            {
+                // The region as it is at this point of the queue, for a readback to come.
+                const auto *capture = static_cast<const CapturePayload *>(payload);
+                const uint64_t number = capture->number;
+                if (gpuOnly)
+                    m_gpu->beforeTransfer(capture->command);
+                if (m_cpu)
+                {
+                    m_cpu->CaptureQueued(capture->command, [this, number](std::vector<uint8_t> &&bytes)
+                                         {
+                                             std::lock_guard<std::mutex> lock(m_captureMutex);
+                                             m_capturedBytes = static_cast<uint32_t>(std::min<size_t>(bytes.size(), kCaptureBytes));
+                                             m_captured.assign(bytes.begin(), bytes.begin() + m_capturedBytes);
+                                             captureTaken(number); });
+                    break;
+                }
+                m_inner->BeginTransfer(capture->command);
+                std::lock_guard<std::mutex> lock(m_captureMutex);
+                m_captured.resize(kCaptureBytes);
+                m_capturedBytes = m_inner->ConsumeLocalToHostBytes(m_captured.data(), kCaptureBytes);
+                captureTaken(number);
+                break;
+            }
+            case Op::GpuDownload:
+                if (m_gpu)
+                    m_gpu->downloadAll();
+                break;
+            case Op::Mesh:
+            {
+                const auto *mesh = static_cast<const MeshPayload *>(payload);
+                const auto *bytes = reinterpret_cast<const uint8_t *>(mesh + 1);
+                if (gpuOnly)
+                {
+                    m_gpu->drawMesh(bytes, mesh->bytes, mesh->field);
+                    break;
+                }
+                // (not the GPU alone: its triangles, made exactly, as a run of primitives)
+                gsmesh::Header header{};
+                if (!gsmesh::readHeader(bytes, mesh->bytes, header) || mesh->field >= header.fields)
+                    break;
+                GSVertex triangles[3u * 30u];
+                const uint32_t count = gsmesh::fieldTriangles(bytes, header, mesh->field, triangles);
+                if (m_gpu)
+                    m_gpu->drawPrimitives(triangles, count, 3u);
+                if (m_cpu)
+                    m_cpu->DrawPrimitives(triangles, count, 3u);
+                else
+                    for (uint32_t i = 0; i < count; ++i)
+                    {
+                        GSPrimitiveBatch batch{};
+                        batch.state = m_threadState;
+                        batch.vertexCount = 3u;
+                        for (uint32_t k = 0; k < 3u; ++k)
+                            batch.vertices[k] = triangles[3u * i + k];
+                        m_inner->Submit(batch);
+                    }
+                break;
+            }
+            case Op::Wrap:
+                break;
+            }
+            if (stallMs > 0.0)
+            {
+                const size_t op = static_cast<size_t>(record->op);
+                stallCheck(op < std::size(kOpNames) ? kOpNames[op] : "?", recordStart);
+            }
+            readPos += record->bytes;
+            m_consumed.store(readPos, std::memory_order_release);
+        }
+    }
+}
