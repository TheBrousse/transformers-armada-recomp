+#ifndef PS2_GS_RASTER_H
+#define PS2_GS_RASTER_H
+
+// The software rasterizer's data structures and scalar code, shared by gs_cpu_backend.cpp
+// and gs_raster_avx2.cpp. Everything is in an unnamed namespace: the two translation units
+// are compiled for different instruction sets and must not share out-of-line copies.
+
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/ps2_gs_common.h"
+#include "runtime/gs/ps2_gs_memory.h"
+
+#include <algorithm>
