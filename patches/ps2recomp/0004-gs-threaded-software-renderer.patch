+    inline uint32_t surfacePixelIndex(uint8_t psm, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_CT24:
+            return GSMem::PixelStorageTraits<GSMem::C32>::Address(GSMem::PageTableC32, bp, bw, x, y);
+        case GS_PSM_CT16:
+            return GSMem::PixelStorageTraits<GSMem::C16>::Address(GSMem::PageTableC16, bp, bw, x, y);
+        case GS_PSM_CT16S:
+            return GSMem::PixelStorageTraits<GSMem::C16S>::Address(GSMem::PageTableC16S, bp, bw, x, y);
+        case GS_PSM_Z32:
+        case GS_PSM_Z24:
+            return GSMem::PixelStorageTraits<GSMem::Z32>::Address(GSMem::PageTableZ32, bp, bw, x, y);
+        case GS_PSM_Z16:
+            return GSMem::PixelStorageTraits<GSMem::Z16>::Address(GSMem::PageTableZ16, bp, bw, x, y);
+        default:
+            return GSMem::PixelStorageTraits<GSMem::Z16S>::Address(GSMem::PageTableZ16S, bp, bw, x, y);
+        }
+    }
