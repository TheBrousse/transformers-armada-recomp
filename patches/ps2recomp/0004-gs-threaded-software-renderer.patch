+            ate = (ctx.test & 0x1u) != 0u;
+            atst = static_cast<uint8_t>((ctx.test >> 1u) & 0x7u);
+            aref = static_cast<int>((ctx.test >> 4u) & 0xFFu);
+            afail = static_cast<uint8_t>((ctx.test >> 12u) & 0x3u);
