+    else if (uDepthBits == 16)
+        z &= 0xFFFFu;
+    gl_FragDepth = uDepthBits == 32 ? float(z) * (1.0 / 4294967296.0) : float(z) / exp2(float(uDepthBits));
+}
+)";
+
+    // ... and back into the R32UI texture: the value bits only (the rest of a Z24 or Z16 word is
+    // the texture's: the GS leaves it).
+    inline const char *kNativePack = R"(#version 450 core
+layout(binding = 1, r32ui) uniform uimage2D uRawDepth;
+layout(binding = 1) uniform sampler2D uNativeDepth;
+uniform int uDepthBits;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float depth = texelFetch(uNativeDepth, p, 0).r;
+    uint z;
+    if (uDepthBits == 32)
+        z = depth >= 1.0 ? 0xFFFFFFFFu : uint(max(depth, 0.0) * 4294967296.0); // (2^32 - 256 the largest float below)
+    else
+    {
+        float scale = exp2(float(uDepthBits));
+        z = uint(clamp(round(depth * scale), 0.0, scale - 1.0));
+    }
+    uint old = imageLoad(uRawDepth, p).r;
+    if (uDepthBits == 24)
+        z = (old & 0xFF000000u) | z;
+    else if (uDepthBits == 16)
+        z = (old & 0xFFFF0000u) | z;
+    imageStore(uRawDepth, p, uvec4(z));
+}
+)";
+
+    inline const char *kFullscreenVertex = R"(#version 450 core
+void main()
+{
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+
+    // A frame or depth buffer the GPU keeps, (re)loaded from local memory: raw values.
+    inline const char *kLoadFragmentBody = R"(
+layout(binding = 0, r32ui) writeonly uniform uimage2D uImage;
+uniform ivec4 uLoad; // address layout, bp, bw, scale (x | y << 8)
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    uvec2 gs = uvec2(p / max(ivec2(uLoad.w & 255, uLoad.w >> 8), ivec2(1)));
+    uint kind = uint(uLoad.x);
+    uint address = gsAddress(kind, uint(uLoad.y), uint(uLoad.z), gs.x, gs.y);
+    uint raw = (kind >= 2u && kind <= 5u) ? readMem16(address) : readMem32(address);
+    imageStore(uImage, p, uvec4(raw));
+}
+)";
+
+    // A buffer the GPU drew into, written back to local memory (the pages asked for only): one
+    // fragment per GS pixel, the sample nearest its sample point (the middle of its block).
+    inline const char *kWritebackHead = "#version 450 core\n#define MEM_QUALIFIER coherent\n";
+    inline const char *kWritebackFragmentBody = R"(
+layout(binding = 0, r32ui) readonly uniform uimage2D uImage;
+uniform ivec4 uWrite;    // address layout, bp, bw, scale (x | y << 8)
+uniform uint uPages[16]; // one bit per page of local memory
+void main()
+{
+    uvec2 gs = uvec2(gl_FragCoord.xy);
+    uint kind = uint(uWrite.x);
+    uint address = gsAddress(kind, uint(uWrite.y), uint(uWrite.z), gs.x, gs.y);
+    bool sixteen = kind >= 2u && kind <= 5u;
+    uint word = (sixteen ? (address >> 1) : address) & 0xFFFFFu;
+    uint page = word >> 11;
+    if ((uPages[page >> 5] & (1u << (page & 31u))) == 0u)
+        discard;
+    ivec2 scale = max(ivec2(uWrite.w & 255, uWrite.w >> 8), ivec2(1));
+    uint value = imageLoad(uImage, ivec2(gs) * scale + (scale - 1) / 2).r;
+    if (sixteen)
+    {
+        uint shift = (address & 1u) * 16u;
+        atomicAnd(mem[word], ~(0xFFFFu << shift));
+        atomicOr(mem[word], (value & 0xFFFFu) << shift);
+    }
+    else
+    {
+        mem[word] = value;
+    }
+}
+)";
+
+    // The display: one or two circuits (GSCpuBackend::PresentFromLocalMemory), each from a
+    // frame buffer of the GPU's or from local memory.
+    inline const char *kComposeFragmentBody = R"(
+layout(binding = 0) uniform usampler2D uCrt1;
+layout(binding = 1) uniform usampler2D uCrt2;
+uniform ivec4 uShow;     // show1, show2, opaque1, -
+uniform ivec4 uOrigin1;  // x, y of the picture in the buffer, first row in the picture, rows
+uniform ivec4 uOrigin2;
+uniform ivec4 uSize;     // width1, width2, width, height (GS pixels)
+uniform ivec4 uMode;     // mmod, alp, -, output scale (x | y << 8)
+uniform ivec4 uBg;       // r, g, b, -
+uniform ivec4 uSource1;  // 0 a frame buffer of the GPU's / 1 local memory, psm, bp, bw
+uniform ivec4 uSource2;
+uniform ivec4 uScales;   // scale of circuit 1's buffer, of circuit 2's (x | y << 8)
+out vec4 oColor;
+
+ivec2 unpackScale(int packed) { return max(ivec2(packed & 255, packed >> 8), ivec2(1)); }
+
+// a / b for a >= 0 and b a scale (1 to 16), in float: integer division takes a run of slow
+// multiplies. (a + 0.5) / b is at least 1/32 from a whole number, more than the rounding.
+ivec2 divScale(ivec2 a, ivec2 b) { return ivec2((vec2(a) + 0.5) / vec2(b)); }
+
+ivec4 fetch(int circuit, ivec2 gsPixel, ivec2 sub)
+{
+    ivec4 source = circuit == 1 ? uSource1 : uSource2;
+    uint raw;
+    if (source.x == 0)
+    {
+        ivec2 scale = unpackScale(circuit == 1 ? uScales.x : uScales.y);
+        ivec2 p = gsPixel * scale + min(divScale(sub * scale, unpackScale(uMode.w)), scale - 1);
+        if (circuit == 1)
+            raw = texelFetch(uCrt1, clamp(p, ivec2(0), textureSize(uCrt1, 0) - 1), 0).r;
+        else
+            raw = texelFetch(uCrt2, clamp(p, ivec2(0), textureSize(uCrt2, 0) - 1), 0).r;
+        if (source.y == 2 || source.y == 10)
+            raw = expand5551(raw);
+    }
+    else
+    {
+        uint x = uint(gsPixel.x), y = uint(gsPixel.y), bp = uint(source.z), bw = uint(source.w);
+        if (source.y == 2)
+            raw = expand5551(readMem16(gsAddress(2u, bp, bw, x, y)));
+        else if (source.y == 10)
+            raw = expand5551(readMem16(gsAddress(3u, bp, bw, x, y)));
+        else
+            raw = readMem32(gsAddress(0u, bp, bw, x, y));
+    }
+    ivec4 c = ivec4(raw & 0xFFu, (raw >> 8) & 0xFFu, (raw >> 16) & 0xFFu, raw >> 24);
+    if (source.y == 1)
+        c.a = 0x80;
+    return c;
+}
+
+void main()
+{
+    ivec2 scale = unpackScale(uMode.w);
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    ivec2 gs = divScale(p, scale);
+    ivec2 sub = p - gs * scale;
+    if (gs.x >= uSize.z || gs.y >= uSize.w)
+    {
+        oColor = vec4(0.0, 0.0, 0.0, 1.0);
+        return;
+    }
+    ivec4 dst = ivec4(uBg.rgb, uMode.y);
+    if (uShow.y != 0)
+    {
+        int y = gs.y - uOrigin2.z;
+        if (y >= 0 && y < uOrigin2.w && gs.x < uSize.y)
+            dst = fetch(2, ivec2(gs.x + uOrigin2.x, y + uOrigin2.y), sub);
+    }
+    if (uShow.x != 0)
+    {
+        int y = gs.y - uOrigin1.z;
+        if (y >= 0 && y < uOrigin1.w && gs.x < uSize.x)
+        {
+            ivec4 src = fetch(1, ivec2(gs.x + uOrigin1.x, y + uOrigin1.y), sub);
+            if (uShow.z != 0)
+                dst = src;
+            else
+            {
+                int factor = uMode.x != 0 ? uMode.y : min(255, src.a * 2);
+                dst.rgb = clamp(dst.rgb + ((src.rgb - dst.rgb) * factor) / 255, 0, 255);
+            }
+        }
+    }
+    oColor = vec4(vec3(dst.rgb) / 255.0, 1.0);
+}
+)";
+
+    // PS2X_GPU_AA=1: the picture's edges smoothed (the FXAA way): where the luminance changes
+    // more than a little, the edge's direction from the neighbours, its two ends found along it,
+    // and the pixel moved across it by how far it is from the nearer end - plus a little of the
+    // neighbours' average where a pixel stands out alone. For the edges no draw smooths: the
+    // GS's (and the game's alpha-tested foliage) are hard, and at 4K they show as steps.
+    inline const char *kFxaa = R"(#version 450 core
+layout(binding = 0) uniform sampler2D uInput; // (linear)
+uniform vec2 uTexel;                           // 1 / its size
+out vec4 oColor;
+float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+float lumaAt(vec2 uv) { return luma(textureLod(uInput, uv, 0.0).rgb); }
+void main()
+{
+    vec2 uv = gl_FragCoord.xy * uTexel;
+    vec3 centre = textureLod(uInput, uv, 0.0).rgb;
+    float lM = luma(centre);
+    float lN = luma(textureLodOffset(uInput, uv, 0.0, ivec2(0, 1)).rgb);
+    float lS = luma(textureLodOffset(uInput, uv, 0.0, ivec2(0, -1)).rgb);
+    float lE = luma(textureLodOffset(uInput, uv, 0.0, ivec2(1, 0)).rgb);
+    float lW = luma(textureLodOffset(uInput, uv, 0.0, ivec2(-1, 0)).rgb);
+    float lMin = min(lM, min(min(lN, lS), min(lE, lW)));
+    float lMax = max(lM, max(max(lN, lS), max(lE, lW)));
+    float range = lMax - lMin;
+    if (range < max(0.0312, lMax * 0.125))
+    {
+        oColor = vec4(centre, 1.0);
+        return;
+    }
+    float lNW = luma(textureLodOffset(uInput, uv, 0.0, ivec2(-1, 1)).rgb);
+    float lNE = luma(textureLodOffset(uInput, uv, 0.0, ivec2(1, 1)).rgb);
+    float lSW = luma(textureLodOffset(uInput, uv, 0.0, ivec2(-1, -1)).rgb);
+    float lSE = luma(textureLodOffset(uInput, uv, 0.0, ivec2(1, -1)).rgb);
+    // The edge runs across (its gradient up and down) or down.
+    float across = abs(lNW + lNE - 2.0 * lN) + 2.0 * abs(lW + lE - 2.0 * lM) + abs(lSW + lSE - 2.0 * lS);
+    float down = abs(lNW + lSW - 2.0 * lW) + 2.0 * abs(lN + lS - 2.0 * lM) + abs(lNE + lSE - 2.0 * lE);
+    bool horizontal = across >= down;
+    float lNeg = horizontal ? lS : lW, lPos = horizontal ? lN : lE;
+    float gNeg = abs(lNeg - lM), gPos = abs(lPos - lM);
+    bool negSide = gNeg >= gPos;
+    float gradient = 0.25 * max(gNeg, gPos);
+    float stepLength = horizontal ? uTexel.y : uTexel.x;
+    float lLocal;
+    if (negSide)
+    {
+        stepLength = -stepLength;
+        lLocal = 0.5 * (lNeg + lM);
+    }
+    else
+        lLocal = 0.5 * (lPos + lM);
+    vec2 onEdge = uv;
+    if (horizontal)
+        onEdge.y += 0.5 * stepLength;
+    else
+        onEdge.x += 0.5 * stepLength;
+    // Its ends: along the edge each way until the luminance leaves the edge's.
+    vec2 along = horizontal ? vec2(uTexel.x, 0.0) : vec2(0.0, uTexel.y);
+    vec2 uv1 = onEdge - along, uv2 = onEdge + along;
+    float end1 = lumaAt(uv1) - lLocal, end2 = lumaAt(uv2) - lLocal;
+    bool done1 = abs(end1) >= gradient, done2 = abs(end2) >= gradient;
+    const float kSteps[10] = float[10](1.0, 1.0, 1.0, 1.5, 2.0, 2.0, 2.0, 2.0, 4.0, 8.0);
+    for (int i = 0; i < 10 && !(done1 && done2); ++i)
+    {
+        if (!done1)
+        {
+            uv1 -= along * kSteps[i];
+            end1 = lumaAt(uv1) - lLocal;
+            done1 = abs(end1) >= gradient;
+        }
+        if (!done2)
+        {
+            uv2 += along * kSteps[i];
+            end2 = lumaAt(uv2) - lLocal;
+            done2 = abs(end2) >= gradient;
+        }
+    }
+    float d1 = horizontal ? uv.x - uv1.x : uv.y - uv1.y;
+    float d2 = horizontal ? uv2.x - uv.x : uv2.y - uv.y;
+    bool nearer1 = d1 < d2;
+    float offset = 0.5 - min(d1, d2) / (d1 + d2);
+    // (only toward the side whose end differs as the centre does)
+    if (((nearer1 ? end1 : end2) < 0.0) == (lM < lLocal))
+        offset = 0.0;
+    // A pixel apart from its neighbours (a thin line): a little of their average.
+    float average = (2.0 * (lN + lS + lE + lW) + lNW + lNE + lSW + lSE) / 12.0;
+    float sub = clamp(abs(average - lM) / range, 0.0, 1.0);
+    sub = (-2.0 * sub + 3.0) * sub * sub;
+    offset = max(offset, sub * sub * 0.5);
+    vec2 result = uv;
+    if (horizontal)
+        result.y += offset * stepLength;
+    else
+        result.x += offset * stepLength;
+    oColor = vec4(textureLod(uInput, result, 0.0).rgb, 1.0);
+}
+)";
+
+    // One field per VBlank in interlaced field mode: "bob" by lines of the GS picture.
+    inline const char *kFieldFragment = R"(#version 450 core
+layout(binding = 0) uniform sampler2D uPicture;
+uniform ivec4 uField; // enabled, odd field, height in GL pixels, scale (down)
+out vec4 oColor;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    int scale = max(uField.w, 1);
+    int line = int((float(p.y) + 0.5) / float(scale)); // (p.y / scale, as divScale)
+    if (uField.x == 0 || (line & 1) == uField.y || uField.z < 2 * scale)
+    {
+        oColor = texelFetch(uPicture, p, 0);
+        return;
+    }
+    int above = line > 0 ? p.y - scale : p.y + scale;
+    int below = p.y + scale < uField.z ? p.y + scale : p.y - scale;
+    uvec4 a = uvec4(round(texelFetch(uPicture, ivec2(p.x, above), 0) * 255.0));
+    uvec4 b = uvec4(round(texelFetch(uPicture, ivec2(p.x, below), 0) * 255.0));
+    oColor = vec4((a + b + 1u) >> 1) / 255.0;
+}
+)";
+
+    // ---- Moment pictures (docs/RENDERER.md, stage 4) ----
+    //
+    // A frame's batch into the buffer of both fields, with field B drawn at the frame before's
+    // pose: its vertices at a moment t between the two, a thread a vertex, into the room kept for
+    // them after the batch's own. Each piece is a run of the batch's vertices: field A's and field
+    // B's copies of the same primitives (in the same order: the same draws made for two matrices)
+    // mixed as (1 - t) * B + t * A, B moved into field A's rows (`shift`); or one copy as it is (a
+    // = b, t = 1; field B's alone: t = 0). Window position, depth, colour, texture coordinates and
+    // fog alike, in the window's coordinates: a vertex goes along the straight line between its two
+    // places on the screen. The same two vertices make the same one, so what the game draws over
+    // the same geometry again (the shadow receivers) stays on it. At t = 1 the vertex is A's.
+    inline const char *kMomentLerp = R"(#version 450 core
+layout(local_size_x = 64) in;
+struct Vertex
+{
+    float x;
+    float y;
+    uint z;
+    uint rgba;
+    float s;
+    float t;
+    float q;
+    uint packed;
+};
+layout(std430, binding = 7) buffer Vertices { Vertex vertices[]; };
+struct Piece
+{
+    uint dst;   // its first vertex made
+    uint a;     // field A's first vertex
+    uint b;     // field B's
+    uint count;
+    uint entry; // the draw entry the made vertices take
+    float shift; // added to B's y: into A's rows
+    float t;
+    uint flags;  // 1: in perspective
+};
+layout(std430, binding = 4) readonly buffer Pieces { Piece pieces[]; };
+uniform uint uPieces;   // pieces (in order of dst)
+uniform uint uVertices; // vertices to make
+uniform uint uFirst;    // the first one's index
+
+uint mixByte(uint b, uint a, float u, float t)
+{
+    return uint(clamp(round(float(b & 0xFFu) * u + float(a & 0xFFu) * t), 0.0, 255.0));
+}
+
+void main()
+{
+    uint i = gl_GlobalInvocationID.x;
+    if (i >= uVertices)
+        return;
+    uint dst = uFirst + i;
+    uint lo = 0u, hi = uPieces;
+    while (hi - lo > 1u)
+    {
+        uint mid = (lo + hi) >> 1u;
+        if (pieces[mid].dst <= dst)
+            lo = mid;
+        else
+            hi = mid;
+    }
+    Piece p = pieces[lo];
+    uint k = dst - p.dst;
+    Vertex a = vertices[p.a + k];
+    Vertex b = vertices[p.b + k];
+    precise float t = p.t;
+    precise float u = 1.0 - t;
+    precise float by = b.y + p.shift;
+    // In perspective (an STQ texture, its Q 1/w): the vertex moves on a straight line in the scene,
+    // and its place on the screen, its depth and its texture's S, T, Q are that line's projection -
+    // the weight t * Q_B / ((1 - t) * Q_A + t * Q_B) instead of t (with the same w at both ends, t).
+    // The colours and the fog by the moment's time. The fields themselves at t = 0 and 1.
+    precise float w = t;
+    if ((p.flags & 1u) != 0u && t > 0.0 && t < 1.0 && a.q > 0.0 && b.q > 0.0)
+        w = t * b.q / (u * a.q + t * b.q);
+    precise float v = 1.0 - w;
+    Vertex o;
+    o.x = v * b.x + w * a.x;
+    o.y = v * by + w * a.y;
+    o.z = uint(clamp(round(double(b.z) * double(v) + double(a.z) * double(w)), 0.0lf, 4294967295.0lf));
+    o.rgba = mixByte(b.rgba, a.rgba, u, t) | (mixByte(b.rgba >> 8u, a.rgba >> 8u, u, t) << 8u) |
+             (mixByte(b.rgba >> 16u, a.rgba >> 16u, u, t) << 16u) | (mixByte(b.rgba >> 24u, a.rgba >> 24u, u, t) << 24u);
+    o.s = v * b.s + w * a.s;
+    o.t = v * b.t + w * a.t;
+    o.q = v * b.q + w * a.q;
+    o.packed = (p.entry & 0xFFFFFFu) | (mixByte(b.packed >> 24u, a.packed >> 24u, u, t) << 24u);
+    vertices[dst] = o;
+}
+)";
+
+    // A moment's depth as Transformers' depth fog reads the depth buffer: its shuffle puts bits 8-15
+    // of each pixel's Z24 into the top byte of the pixel's word, and the fog reads that byte (T8H)
+    // through its CLUT. Made from the moment's own depth, so the fog of each moment is its own - a
+    // GS pixel at a time, as the depth buffer reaches local memory (the sample in the middle of the
+    // pixel's block, kWritebackFragmentBody).
+    // (PS2X_MOMENT_BLOCKY=1, testing aid: a moment's depth a GS pixel at a time - the sample in the
+    // middle of each pixel's block - as the depth buffer is after it went through local memory.)
+    inline const char *kMomentBlocky = R"(#version 450 core
+layout(binding = 20) uniform sampler2D uMomentDepth;
+uniform ivec2 uScale;
+void main()
+{
+    ivec2 scale = max(uScale, ivec2(1));
+    ivec2 at = ivec2(gl_FragCoord.xy) / scale * scale + (scale - 1) / 2;
+    gl_FragDepth = texelFetch(uMomentDepth, at, 0).r;
+}
+)";
+
+    // Multisampling of the scene (PS2X_GPU_MSAA): a buffer's multisampled copy filled again from the
+    // buffer, every sample of a GL pixel the pixel's value - the colour from the R32UI texture's
+    // bytes (as its RGBA8 view reads them: R the low byte), the depth from the native depth.
+    inline const char *kMsaaFill = R"(#version 450 core
+layout(binding = 1, r32ui) readonly uniform uimage2D uRawColor;
+layout(binding = 21) uniform sampler2D uNativeDepth;
+uniform int uWhat; // 1 the colour, 2 the depth
+layout(location = 0) out vec4 oColor;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    oColor = (uWhat & 1) != 0 ? unpackUnorm4x8(imageLoad(uRawColor, p).r) : vec4(0.0);
+    gl_FragDepth = (uWhat & 2) != 0 ? texelFetch(uNativeDepth, p, 0).r : 0.0;
+}
+)";
+
+    // ... and its depth back into the native depth for a batch that tests against it (msaaResolve):
+    // the farthest of a pixel's samples, copied out of the renderbuffer (the game's depth test is
+    // GEQUAL, the nearer the larger). Within a surface never nearer than the pixel's middle, nor where
+    // two of a mesh's triangles meet - so the same mesh drawn again there by the emulated path, at the
+    // pixel's middle, tests equal or nearer (one sample, a blit's, was nearer on half of the warp gate
+    // tunnel's slopes, and its subtractive pass failed there).
+    inline const char *kMsaaDepthResolve = R"(#version 450 core
+layout(binding = 22) uniform sampler2DMS uMsDepth;
+uniform int uSamples;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float z = texelFetch(uMsDepth, p, 0).r;
+    for (int i = 1; i < uSamples; ++i)
+        z = min(z, texelFetch(uMsDepth, p, i).r);
+    gl_FragDepth = z;
+}
+)";
+
+    inline const char *kMomentFog = R"(#version 450 core
+layout(binding = 20) uniform sampler2D uMomentDepth;
+uniform float uDepthScale; // 2^bits of the depth values
+uniform ivec2 uScale;      // the layer's GL pixels a GS pixel
+out uvec4 oIndex;
+void main()
+{
+    ivec2 scale = max(uScale, ivec2(1));
+    ivec2 at = ivec2(gl_FragCoord.xy) / scale * scale + (scale - 1) / 2;
+    float d = texelFetch(uMomentDepth, at, 0).r;
+    uint z = uint(clamp(round(d * uDepthScale), 0.0, uDepthScale - 1.0));
+    oIndex = uvec4(((z >> 8u) & 0xFFu) << 24u, 0u, 0u, 0u);
+}
+)";
+}
