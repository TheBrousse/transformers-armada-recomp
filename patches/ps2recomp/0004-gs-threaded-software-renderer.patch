+bool ps2_gpu::createContext()
+{
+    if (!requested())
+        return false;
+    if (g_context)
+        return true;
+    GLFWwindow *window = glfwGetCurrentContext();
+    if (!window)
+    {
+        std::fprintf(stderr, "[gpu] no window context to share with\n");
+        return false;
+    }
+    glfwDefaultWindowHints();
+    glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE);
+    glfwWindowHint(GLFW_FOCUSED, GLFW_FALSE);
+    glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_API);
+    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+    glfwWindowHint(GLFW_OPENGL_DEBUG_CONTEXT, debugEnabled() ? GLFW_TRUE : GLFW_FALSE);
+    // 4.5 at least: GLSL 4.50 is where drivers take the pixel interlock qualifiers.
+    for (const int minor : {6, 5})
+    {
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, minor);
+        g_context = glfwCreateWindow(16, 16, "GS", nullptr, window);
+        if (g_context)
+            break;
+    }
+    glfwMakeContextCurrent(window);
+    if (!g_context)
+    {
+        std::fprintf(stderr, "[gpu] could not create an OpenGL 4.5 context sharing the window's\n");
+        return false;
+    }
+    if (!glad_glTexStorage2D || !glad_glBindBufferBase || !glad_glCopyImageSubData || !glad_glFenceSync ||
+        !glad_glWaitSync || !glad_glBindImageTexture || !glad_glMemoryBarrier || !glad_glFramebufferParameteri ||
+        !glad_glVertexAttribIPointer)
+    {
+        std::fprintf(stderr, "[gpu] the GL functions it needs are missing (raylib's loader saw an older context)\n");
+        glfwDestroyWindow(g_context);
+        g_context = nullptr;
+        return false;
+    }
+    // (drawing alone, the GPU's are the only pictures there are)
+    g_view.store(mirrored() ? envFlag("PS2X_GPU_VIEW", false) : true);
+    // The scale, across and down. PS2X_GPU_SCALE=auto (the default): about as many GL pixels
+    // as the screen the window is on has for the picture - the picture's 448 lines in the
+    // screen's height (5 on a 2160-line screen, 3 on 1440, 2 on 1080), and its 512 columns in
+    // the width of a 16:9 picture on that screen for a widescreen TV (PS2X_WIDESCREEN: 7 on 4K,
+    // 5 on 1440p, 4 on 1080p), else as many as down. Exactly halfway (4K: 7.5) goes down: at
+    // 8x5 the busiest stretch of Transformers needs 15-16 ms of an RX 9070 XT per VBlank, at
+    // 7x5 14.6. PS2X_GPU_SCALE=<n>: n both ways; <x>x<y>: x across, y down. 1 to 8 each.
+    const char *scaleEnv = std::getenv("PS2X_GPU_SCALE");
+    int scaleX = 1, scaleY = 1;
+    if (scaleEnv && *scaleEnv && std::strcmp(scaleEnv, "auto") != 0)
+    {
+        if (std::sscanf(scaleEnv, "%dx%d", &scaleX, &scaleY) != 2)
+            scaleX = scaleY = std::atoi(scaleEnv);
+    }
+    else
+    {
+        const int monitor = GetCurrentMonitor();
+        const double width = GetMonitorWidth(monitor), height = GetMonitorHeight(monitor);
+        const auto nearest = [](double v) { return static_cast<int>(std::ceil(v - 0.5)); }; // (halfway: down)
+        scaleY = nearest(height / 448.0);
+        scaleX = ps2_host_display::widescreenTv() ? nearest(std::min(width, height * 16.0 / 9.0) / 512.0) : scaleY;
+    }
+    g_scaleX.store(std::clamp(scaleX, 1, 8));
+    g_scaleY.store(std::clamp(scaleY, 1, 8));
+    std::fprintf(stderr, "[gpu] OpenGL context for the GS renderer created (%s)\n",
+                 reinterpret_cast<const char *>(glGetString(GL_RENDERER)));
+    return true;
+}
