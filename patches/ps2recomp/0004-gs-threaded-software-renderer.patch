+    // log2 of the page size in pixels, as used by the GS for page-based addressing.
+    GS_FAST_INLINE void pageShifts(uint8_t psm, uint32_t &width, uint32_t &height)
+    {
+        switch (psm)
+        {
+        case GS_PSM_T4: // 128 x 128
+            width = 7u;
+            height = 7u;
+            break;
+        case GS_PSM_T8: // 128 x 64
+            width = 7u;
+            height = 6u;
+            break;
+        case GS_PSM_CT16: // 64 x 64
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            width = 6u;
+            height = 6u;
+            break;
+        default: // 64 x 32
+            width = 6u;
+            height = 5u;
+            break;
+        }
+    }
