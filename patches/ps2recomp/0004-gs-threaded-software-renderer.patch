+            abe = state.prim.abe;
+            pabe = state.pabe;
+            asel = static_cast<uint8_t>(ctx.alpha & 0x3u);
+            bsel = static_cast<uint8_t>((ctx.alpha >> 2u) & 0x3u);
+            csel = static_cast<uint8_t>((ctx.alpha >> 4u) & 0x3u);
+            dsel = static_cast<uint8_t>((ctx.alpha >> 6u) & 0x3u);
+            fix = static_cast<int>((ctx.alpha >> 32u) & 0xFFu);
