+    // Fills the tables of a surface (base in blocks). False if its addresses turn out not
+    // to separate, in which case the tables must not be used.
+    inline bool buildSurfaceOffsets(SurfaceOffsets &offsets, uint32_t bp, uint32_t bw, uint8_t psm)
+    {
+        const uint32_t origin = surfacePixelIndex(psm, bp, bw, 0u, 0u);
+        for (uint32_t x = 0; x < SurfaceOffsets::kSize + 8u; ++x)
+            offsets.col[x] = surfacePixelIndex(psm, bp, bw, x, 0u);
+        for (uint32_t y = 0; y < SurfaceOffsets::kSize; ++y)
+            offsets.row[y] = surfacePixelIndex(psm, bp, bw, 0u, y) - origin;
+        for (uint32_t y = 0; y < SurfaceOffsets::kSize; y += 13u)
+            for (uint32_t x = 0; x < SurfaceOffsets::kSize; x += 11u)
+                if (surfacePixelIndex(psm, bp, bw, x, y) != offsets.row[y] + offsets.col[x])
+                    return false;
+        return true;
+    }
