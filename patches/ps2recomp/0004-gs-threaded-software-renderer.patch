+// draws a mesh again with its depth test passing only where it is equal - the shadow receivers)
+invariant gl_Position;
+void main()
+{
+    vec2 window = (aPos + 0.5) * uTarget.zw;
+    // The GPU's depth is the GS's Z over 2^bits (through -1 to 1 and back: exact for 24 bits -
+    // 2 z / 2^24 - 1 is a multiple of 2^-23 no larger than 1).
+    gl_Position = vec4(window / uTarget.xy * 2.0 - 1.0, min(float(aZ), uDepthRange.y) * uDepthRange.x * 2.0 - 1.0, 1.0);
+    vColor = vec4(aColor);
+    vFlat = aColor;
+    vTex = aTex;
+    vFog = float(aPacked >> 24);
+    vFlatFog = aPacked >> 24;
+    vZ = float(aZ);
+    vFlatZ = aZ;
+    uint entry = aPacked & 0xFFFFFFu;
+    vDraw = entry;
+
+    Draw d = draws[entry];
+    uint flags = d.frame.x;
+    bool bits24 = d.frame.z == 24u;
+    vState.x = min(d.tex0.y, 31u) | ((d.tex0.x & 3u) << 5) | ((d.tex2.z & 3u) << 7) | (min(d.tex2.w, 1u) << 9) |
