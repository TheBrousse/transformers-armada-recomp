+// PS2X_READBACK_LOG=1: each read-back's size and a hash of its bytes (comparing runs).
+static uint32_t logReadback(const uint8_t *data, uint32_t bytes, const char *path)
+{
+    static const bool enabled = []()
+    {
+        const char *env = std::getenv("PS2X_READBACK_LOG");
+        return env && *env && *env != '0';
+    }();
+    if (!enabled)
+        return bytes;
+    static uint64_t number = 0u;
+    uint64_t hash = 1469598103934665603ull;
+    for (uint32_t i = 0; i < bytes; ++i)
+        hash = (hash ^ data[i]) * 1099511628211ull;
+    std::fprintf(stderr, "[readback] #%llu %s %u bytes hash %016llx\n", static_cast<unsigned long long>(++number), path, bytes,
+                 static_cast<unsigned long long>(hash));
+    // PS2X_READBACK_LOG=dump: the bytes of the first few, to runs/readback_<n>.bin.
+    static const bool dump = std::strcmp(std::getenv("PS2X_READBACK_LOG"), "dump") == 0;
+    if (dump && number <= 4u)
+    {
+        char name[64];
+        std::snprintf(name, sizeof(name), "runs/readback_%llu.bin", static_cast<unsigned long long>(number));
+        if (std::FILE *file = std::fopen(name, "wb"))
