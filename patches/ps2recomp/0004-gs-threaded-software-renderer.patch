+}
+
+uvec4 unpack8888(uint c) { return uvec4(c & 0xFFu, (c >> 8) & 0xFFu, (c >> 16) & 0xFFu, c >> 24); }
+
+vec4 sampleReplacement(uint slot, vec2 uv, vec2 dx, vec2 dy)
+{
+    if (slot == 0u) return textureGrad(uReplace[0], uv, dx, dy);
+    if (slot == 1u) return textureGrad(uReplace[1], uv, dx, dy);
+    if (slot == 2u) return textureGrad(uReplace[2], uv, dx, dy);
+    if (slot == 3u) return textureGrad(uReplace[3], uv, dx, dy);
+    if (slot == 4u) return textureGrad(uReplace[4], uv, dx, dy);
+    if (slot == 5u) return textureGrad(uReplace[5], uv, dx, dy);
+    if (slot == 6u) return textureGrad(uReplace[6], uv, dx, dy);
+    if (slot == 7u) return textureGrad(uReplace[7], uv, dx, dy);
+    if (slot == 8u) return textureGrad(uReplace[8], uv, dx, dy);
+    if (slot == 9u) return textureGrad(uReplace[9], uv, dx, dy);
+    if (slot == 10u) return textureGrad(uReplace[10], uv, dx, dy);
+    if (slot == 11u) return textureGrad(uReplace[11], uv, dx, dy);
+    if (slot == 12u) return textureGrad(uReplace[12], uv, dx, dy);
+    if (slot == 13u) return textureGrad(uReplace[13], uv, dx, dy);
+    if (slot == 14u) return textureGrad(uReplace[14], uv, dx, dy);
+    return textureGrad(uReplace[15], uv, dx, dy);
+}
+
+// TexSampler::sample. u, v in 1/256 texels.
+uvec4 sampleTexture(Draw d, int u, int v)
+{
+    if (d.tex0.w == 0u)
+        return unpack8888(texel(d, u >> 8, v >> 8));
+    u -= 128;
+    v -= 128;
+    int u0 = u >> 8;
+    int v0 = v >> 8;
+    uint fx = uint(u) & 255u;
+    uint fy = uint(v) & 255u;
+    if (d.tex0.y != 0u)
+    {
+        // An image source: the four pixels' loads together, then their formats. (A pixel of
+        // weight 0 changes nothing: (c * 256 + 128) >> 8 is c.)
+        uvec4 raw = loadSource4(d.tex0.y, imagePixel(d, u0, v0), imagePixel(d, u0 + 1, v0), imagePixel(d, u0, v0 + 1),
+                                imagePixel(d, u0 + 1, v0 + 1));
+        uvec4 i00 = unpack8888(imageTexel(d, raw.x));
+        uvec4 i10 = unpack8888(imageTexel(d, raw.y));
+        uvec4 i01 = unpack8888(imageTexel(d, raw.z));
+        uvec4 i11 = unpack8888(imageTexel(d, raw.w));
+        uvec4 iTop = (i00 * (256u - fx) + i10 * fx + 128u) >> 8;
+        uvec4 iBottom = (i01 * (256u - fx) + i11 * fx + 128u) >> 8;
+        return (iTop * (256u - fy) + iBottom * fy + 128u) >> 8;
+    }
+    uvec4 c00 = unpack8888(texel(d, u0, v0));
+    if ((fx | fy) == 0u)
+        return c00;
+    // On a texel column or row the weights of the other two are 0: the same result from two.
+    // ((c * 256 + 128) >> 8 is c.)
+    if (fx == 0u)
+    {
+        uvec4 c01 = unpack8888(texel(d, u0, v0 + 1));
+        return (c00 * (256u - fy) + c01 * fy + 128u) >> 8;
+    }
+    uvec4 c10 = unpack8888(texel(d, u0 + 1, v0));
+    uvec4 top = (c00 * (256u - fx) + c10 * fx + 128u) >> 8;
+    if (fy == 0u)
+        return top;
+    uvec4 c01 = unpack8888(texel(d, u0, v0 + 1));
+    uvec4 c11 = unpack8888(texel(d, u0 + 1, v0 + 1));
+    uvec4 bottom = (c01 * (256u - fx) + c11 * fx + 128u) >> 8;
+    return (top * (256u - fy) + bottom * fy + 128u) >> 8;
+}
+
+// gs_raster.h texelFixed: 1/256 texels, saturated.
+int texelFixed(float value)
+{
+    if (!(value > -1.0e8)) return -(1 << 30);
+    if (value > 1.0e8) return 1 << 30;
+    return int(value);
+}
+
+bool alphaPasses(uint atst, int a, int aref)
+{
+    if (atst == 0u) return false;
+    if (atst == 1u) return true;
+    if (atst == 2u) return a < aref;
+    if (atst == 3u) return a <= aref;
+    if (atst == 4u) return a == aref;
+    if (atst == 5u) return a >= aref;
+    if (atst == 6u) return a > aref;
+    return a != aref;
+}
+
+int blendChannel(uint asel, uint bsel, uint dsel, int cs, int cd, int alpha)
+{
+    int a = asel == 0u ? cs : (asel == 1u ? cd : 0);
+    int b = bsel == 0u ? cs : (bsel == 1u ? cd : 0);
+    int dd = dsel == 0u ? cs : (dsel == 1u ? cd : 0);
+    return clamp(((a - b) * alpha >> 7) + dd, 0, 255);
+}
