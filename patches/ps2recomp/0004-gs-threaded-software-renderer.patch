diff --git a/ps2xRuntime/include/runtime/gs/gs_gpu.h b/ps2xRuntime/include/runtime/gs/gs_gpu.h
new file mode 100644
index 0000000..9d6c4cb
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_gpu.h
@@ -0,0 +1,101 @@
+#pragma once
+
+#include "runtime/gs/gs_types.h"
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+
+// The GS on the GPU (OpenGL 4.5 + GL_ARB_fragment_shader_interlock), beside the software
+// renderer (gs_cpu_backend.cpp).
+//
+// The way to a PC renderer for this port: draw what the game sends the GS with the GPU, at
+// any resolution, and later draw its own passes (the two fields of a frame, the depth
+// effects) the way a PC game would. The GPU keeps the frame and depth buffers the game draws
+// into (raw GS values, scale x scale pixels for each GS pixel) and a copy of local memory it
+// reads textures from with the GS's swizzle; the pixel pipeline is the software renderer's,
+// in a fragment shader (gs_gpu_shaders.h).
+//
+// PS2X_GPU=1 draws with the GPU (GSThreadedBackend sends it the GS command stream). The
+// software renderer then only keeps local memory for transfers, read-backs and save states,
+// brought up to date from the GPU before they read it; the window shows the GPU's pictures.
+// The GPU draws on a GL context of its own that shares textures with the window's, on the GS
+// thread.
+//   PS2X_GPU_MIRROR=1     the software renderer draws too (its pictures, screenshots and
+//                         golden frames; F7 switches the window between the two)
+//   PS2X_GPU_VIEW=0/1     with PS2X_GPU_MIRROR: which pictures the window starts with
+//   PS2X_GPU_SCALE=n      GL pixels per GS pixel across (1-8, default 1)
+//   PS2X_GPU_FIELDS=1     each field of an interlaced picture as a whole picture of its own
+//   PS2X_GPU_STATS=1      batches, uploads, GPU time every 2 s on stderr
+//   PS2X_GPU_DRAWLOG=<t>  the draws of the frame after VBlank t to runs/gpu_drawlog_<t>.txt
+//   PS2X_SHOT_VSYNCS      also writes runs/shot_<tick>_gpu.png
+//   PS2X_GPU_DEBUG=1      GL debug output (errors and warnings) on stderr
+namespace ps2_gpu
+{
+    bool requested();
+    bool mirrored(); // PS2X_GPU_MIRROR: the software renderer draws as well
+
+    // Main thread, the window's GL context current: creates the GPU renderer's context,
+    // sharing textures with the window's. False when GPU rendering is off or impossible.
+    bool createContext();
+
+    // Window thread. The GPU's newest picture: a GL texture of the shared context, ready to
+    // be sampled (the GPU's fence is waited for on the calling context).
+    struct Picture
+    {
+        uint32_t texture = 0u;
+        int width = 0; // the picture, from the texture's top-left corner
+        int height = 0;
+        int textureWidth = 0;
+        int textureHeight = 0;
+        uint64_t tick = 0u;
+        int64_t showsNs = 0; // the screen refresh it was made for (steady clock), or its VBlank's due time
+    };
+    bool picture(Picture &out, uint64_t tick); // that VBlank's picture, or the newest before it
+    // Showing pictures by the screen's refresh (moment pictures, ps2_host_display::setMomentFields):
+    // the newest made for the refresh at `showsNs` or one before it (`leewayNs` of slack).
+    bool pictureFor(Picture &out, int64_t showsNs, int64_t leewayNs);
+    bool viewActive();
+    void toggleView();
+    // The GL pixels per GS pixel across and down chosen at start (PS2X_GPU_SCALE, or the screen's).
+    void scale(int &x, int &y);
+}
+
+class GSGpuRenderer
+{
+public:
+    GSGpuRenderer();
+    ~GSGpuRenderer();
+
+    // All on the GS thread, in the order of the command stream.
+    bool ready(); // it draws (started on first use: false before the window exists, or when it cannot)
+    void setVram(uint8_t *vram, uint32_t size);
+    // Called before the GPU reads local memory the software renderer may still be drawing.
+    void setSyncHook(std::function<void()> hook);
+    void setDrawState(const GSDrawState &state);
+    void drawPrimitives(const GSVertex *vertices, uint32_t count, uint32_t each);
+    // One field of a native mesh (runtime/gs/gs_native_mesh.h), with the draw state set last.
+    void drawMesh(const uint8_t *mesh, uint32_t bytes, uint32_t field);
+    void loadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut);
+    void beginTransfer(const GSTransferCommand &command);
+    void uploadImage(); // more of the transfer's data has reached local memory
+    void writeVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y);
+    void present(const GSPresentationRequest &request);
+    // Nothing more queued for now (the GS thread is about to sleep): the batch drawn and what
+    // was drawn handed to the GPU (glFlush), which would otherwise wait for the next picture.
+    void idle();
+
+    // GPU-only drawing: the software renderer's local memory brought up to date from the GPU
+    // where the CPU side is about to read it or write part of a page (before a transfer, a
+    // pixel write), or everywhere (save states, snapshots).
+    void beforeTransfer(const GSTransferCommand &command);
+    void beforeWriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y);
+    void downloadAll();
+
+    // Any thread: local memory changed behind the command stream (a state was loaded).
+    void invalidate();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m;
+};
diff --git a/ps2xRuntime/include/runtime/gs/gs_native_mesh.h b/ps2xRuntime/include/runtime/gs/gs_native_mesh.h
new file mode 100644
index 0000000..ee7d839
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_native_mesh.h
@@ -0,0 +1,238 @@
+#ifndef GS_NATIVE_MESH_H
+#define GS_NATIVE_MESH_H
+
+#include "runtime/gs/gs_types.h"
+#include <cstdint>
+#include <cstring>
+#include <smmintrin.h>
+
+// A batch a game draws natively, sent over PATH1 in place of the packet its VU1 routine would
+// send (the renderer of our own, stage 2: docs/RENDERER.md). It reaches the GS front end where
+// the packet would have, the front end takes its tags and register writes through its usual
+// path, and the GPU renderer makes its vertices - on the GPU, or here, exactly as VU1 would.
+//
+// Layout, in qwords:
+//   0      marker: a GIF tag of the disabled kind (FLG 3) with the end-of-packet bit and no
+//          data, kMagic where its registers would be - nothing a game sends
+//   1      Header
+//   then per field (Header::fields of them, field A first):
+//          4   the field's matrix, as VU1 has it (rows x, y, z and the translation: vf01-vf04)
+//          4   the tags as the routine sends them: the GIF tag and the two register writes
+//              before the field's vertices, then the vertex tag (its NLOOP the vertex count)
+//   then   1   the drawing-kick masks (x: vertices 0-15, y: 16-31; vertex 0 in bit 15)
+//          3 a vertex: its ST (converted), colour (integers) and position, as uploaded
+namespace gsmesh
+{
+    constexpr uint64_t kTagLo = (1ull << 15) | (3ull << 58); // EOP, FLG 3 (disabled), NLOOP 0
+    constexpr uint64_t kMagic = 0x4853454D5446504Eull;       // "NPFTMESH"
+
+    enum Kind : uint32_t
+    {
+        // 0x1410's drawing: XYZ through the field's matrix, Q = 1/w, ST * Q, XYZ to 12.4, the
+        // registers ST, RGBAQ, XYZF2 per vertex (the vertex tag says so), a triangle strip.
+        kTransform = 1u,
+    };
+
+    struct Header
+    {
+        uint32_t kind;
+        uint32_t count;  // vertices (1-32)
+        uint32_t fields; // copies of the strip
+        uint32_t flags;  // (0)
+    };
+
+    constexpr uint32_t kFieldQwords = 8u;
+
+    inline uint64_t loadLE64(const uint8_t *p)
+    {
+        uint64_t value;
+        std::memcpy(&value, p, 8u);
+        return value;
+    }
+
+    inline bool isMesh(const uint8_t *data, uint32_t bytes)
+    {
+        return data && bytes >= 32u && loadLE64(data) == kTagLo && loadLE64(data + 8) == kMagic;
+    }
+
+    inline uint32_t qwords(uint32_t count, uint32_t fields) { return 2u + fields * kFieldQwords + 1u + 3u * count; }
+
+    // The header, checked: a kind known here, its sizes within the bytes there are.
+    inline bool readHeader(const uint8_t *mesh, uint32_t bytes, Header &header)
+    {
+        if (!isMesh(mesh, bytes))
+            return false;
+        std::memcpy(&header, mesh + 16, sizeof(header));
+        return header.kind == kTransform && header.count >= 1u && header.count <= 32u && header.fields >= 1u &&
+               header.fields <= 4u && bytes >= qwords(header.count, header.fields) * 16u;
+    }
+
+    inline const uint8_t *field(const uint8_t *mesh, uint32_t index) { return mesh + (2u + index * kFieldQwords) * 16u; }
+    inline const uint8_t *vertexTag(const uint8_t *mesh, uint32_t index) { return field(mesh, index) + 112u; }
+
+    // ---- VU1's arithmetic (as the game's native code does it) ----
+
+    // Round toward zero, denormals flushed, for the length of a scope.
+    struct VuFloatMode
+    {
+        unsigned saved;
+        VuFloatMode() : saved(_mm_getcsr()) { _mm_setcsr((saved & ~0xE040u) | 0xE040u); }
+        ~VuFloatMode() { _mm_setcsr(saved); }
+        VuFloatMode(const VuFloatMode &) = delete;
+        VuFloatMode &operator=(const VuFloatMode &) = delete;
+    };
+
+    // An FMAC operand: exponent 255 as +-FLT_MAX.
+    inline __m128 vuClamp(__m128 value)
+    {
+        __m128i bits = _mm_castps_si128(value);
+        bits = _mm_min_epu32(bits, _mm_set1_epi32(static_cast<int>(0xFF7FFFFFu)));
+        bits = _mm_min_epi32(bits, _mm_set1_epi32(0x7F7FFFFF));
+        return _mm_castsi128_ps(bits);
+    }
+
+    inline __m128 vuLane(__m128 value, int index)
+    {
+        switch (index)
+        {
+        case 0:
+            return _mm_shuffle_ps(value, value, 0x00);
+        case 1:
+            return _mm_shuffle_ps(value, value, 0x55);
+        case 2:
+            return _mm_shuffle_ps(value, value, 0xAA);
+        default:
+            return _mm_shuffle_ps(value, value, 0xFF);
+        }
+    }
+
+    // MULAw ACC, row3, VF00w; MADDAz ACC, row2, z; MADDAy ACC, row1, y; MADDx out, row0, x.
+    inline __m128 vuTransform(const __m128 (&rows)[4], __m128 x, __m128 y, __m128 z)
+    {
+        __m128 acc = _mm_mul_ps(rows[3], _mm_set1_ps(1.0f));
+        acc = _mm_add_ps(acc, _mm_mul_ps(rows[2], z));
+        acc = _mm_add_ps(acc, _mm_mul_ps(rows[1], y));
+        return _mm_add_ps(acc, _mm_mul_ps(rows[0], x));
+    }
+
+    // DIV Q, VF00w, w: 1/w, or +-FLT_MAX by w's sign for a zero w.
+    inline __m128 vuReciprocal(__m128 w)
+    {
+        const __m128 den = vuClamp(w);
+        const __m128 zero = _mm_cmpeq_ps(den, _mm_setzero_ps());
+        const __m128 limit = _mm_or_ps(_mm_and_ps(den, _mm_castsi128_ps(_mm_set1_epi32(static_cast<int>(0x80000000u)))),
+                                       _mm_castsi128_ps(_mm_set1_epi32(0x7F7FFFFF)));
+        return _mm_blendv_ps(_mm_div_ps(_mm_set1_ps(1.0f), den), limit, zero);
+    }
+
+    // FTOI4: toward zero, 2^31 and above as 0x7FFFFFFF.
+    inline __m128i vuFtoi4(__m128 value)
+    {
+        const __m128 scaled = _mm_mul_ps(vuClamp(value), _mm_set1_ps(16.0f));
+        const __m128i converted = _mm_cvttps_epi32(scaled);
+        const __m128 high = _mm_cmpge_ps(scaled, _mm_set1_ps(2147483648.0f));
+        return _mm_castps_si128(_mm_blendv_ps(_mm_castsi128_ps(converted), _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF)), high));
+    }
+
+    // The drawing-kick word of vertex v (the mask after it shifted, as 0x1410 keeps it).
+    inline int32_t kickBits(uint32_t masks0, uint32_t masks1, uint32_t v)
+    {
+        const uint32_t mask = v < 16u ? masks0 : masks1;
+        const uint32_t shift = v < 16u ? v : v - 16u;
+        return static_cast<int16_t>(shift < 16u ? (mask << shift) & 0xFFFFu : 0u);
+    }
+
+    // A vertex of one field as 0x1410 sends it: the qwords for ST (S*Q, T*Q, Q; w as uploaded),
+    // RGBAQ (the colour) and XYZF2 (12.4, the kick word in w).
+    struct Vertex
+    {
+        uint32_t st[4];
+        uint32_t rgbaq[4];
+        uint32_t xyzf[4];
+    };
+
+    // Every vertex of field `index` of a checked mesh of kind kTransform, exactly as VU1 makes it.
+    inline void transformField(const uint8_t *mesh, const Header &header, uint32_t index, Vertex *out)
+    {
+        const VuFloatMode mode;
+        const uint8_t *f = field(mesh, index);
+        const uint8_t *vertices = mesh + (2u + header.fields * kFieldQwords + 1u) * 16u;
+        uint32_t masks[2];
+        std::memcpy(masks, mesh + (2u + header.fields * kFieldQwords) * 16u, 8u);
+        __m128 rows[4];
+        for (int r = 0; r < 4; ++r)
+            rows[r] = vuClamp(_mm_loadu_ps(reinterpret_cast<const float *>(f + 16 * r)));
+        for (uint32_t v = 0; v < header.count; ++v)
+        {
+            const uint8_t *in = vertices + 48u * v;
+            const __m128 st = vuClamp(_mm_loadu_ps(reinterpret_cast<const float *>(in)));
+            const __m128 position = vuClamp(_mm_loadu_ps(reinterpret_cast<const float *>(in + 32)));
+            const __m128 clip = vuTransform(rows, vuLane(position, 0), vuLane(position, 1), vuLane(position, 2));
+            const __m128 q = vuReciprocal(vuLane(clip, 3));
+            _mm_storeu_ps(reinterpret_cast<float *>(out[v].st), _mm_blend_ps(_mm_mul_ps(st, q), st, 0x8));
+            std::memcpy(out[v].rgbaq, in + 16, 16u);
+            const __m128i xyz = _mm_insert_epi32(vuFtoi4(_mm_mul_ps(vuClamp(clip), q)), kickBits(masks[0], masks[1], v), 3);
+            _mm_storeu_si128(reinterpret_cast<__m128i *>(out[v].xyzf), xyz);
+        }
+    }
+
+    // Field `index` of a checked mesh as the GS front end makes its triangles from the packet:
+    // each vertex from its registers (x and y from 12.4, Z's 24 bits, the fog from XYZF2's F, S, T
+    // and Q - a Q of 0 as 1 - and RGBA), a triangle (the two vertices before it and it) for each
+    // vertex that kicks once three are queued. `out` has room for 3 * (count - 2) vertices; the
+    // number of triangles is returned.
+    inline uint32_t fieldTriangles(const uint8_t *mesh, const Header &header, uint32_t index, GSVertex *out)
+    {
+        Vertex made[32];
+        transformField(mesh, header, index, made);
+        GSVertex queue[3];
+        uint32_t queued = 0u, triangles = 0u;
+        for (uint32_t k = 0; k < header.count; ++k)
+        {
+            const Vertex &m = made[k];
+            GSVertex &g = queue[queued];
+            g = GSVertex{};
+            g.x = static_cast<float>(static_cast<uint16_t>(m.xyzf[0] & 0xFFFFu)) / 16.0f;
+            g.y = static_cast<float>(static_cast<uint16_t>(m.xyzf[1] & 0xFFFFu)) / 16.0f;
+            g.z = static_cast<double>((m.xyzf[2] >> 4) & 0xFFFFFFu);
+            g.fog = static_cast<uint8_t>((m.xyzf[3] >> 4) & 0xFFu);
+            std::memcpy(&g.s, &m.st[0], 4u);
+            std::memcpy(&g.t, &m.st[1], 4u);
+            std::memcpy(&g.q, &m.st[2], 4u);
+            if (g.q == 0.0f)
+                g.q = 1.0f;
+            g.r = static_cast<uint8_t>(m.rgbaq[0] & 0xFFu);
+            g.g = static_cast<uint8_t>(m.rgbaq[1] & 0xFFu);
+            g.b = static_cast<uint8_t>(m.rgbaq[2] & 0xFFu);
+            g.a = static_cast<uint8_t>(m.rgbaq[3] & 0xFFu);
+            if (++queued < 3u)
+                continue;
+            if (((m.xyzf[3] >> 15) & 1u) == 0u) // (ADC clear: it kicks)
+            {
+                out[3u * triangles] = queue[0];
+                out[3u * triangles + 1u] = queue[1];
+                out[3u * triangles + 2u] = queue[2];
+                ++triangles;
+            }
+            queue[0] = queue[1];
+            queue[1] = queue[2];
+            queued = 2u;
+        }
+        return triangles;
+    }
+
+    // Whether field `index`'s vertex tag is the one this path knows: PACKED, PRE with a triangle
+    // strip of ST (STQ, not UV), the registers ST, RGBAQ, XYZF2, NLOOP the vertex count.
+    inline bool plainStrip(const uint8_t *mesh, const Header &header, uint32_t index)
+    {
+        const uint64_t lo = loadLE64(vertexTag(mesh, index)), hi = loadLE64(vertexTag(mesh, index) + 8);
+        const uint32_t nloop = static_cast<uint32_t>(lo & 0x7FFFu);
+        const uint32_t flg = static_cast<uint32_t>((lo >> 58) & 3u), nreg = static_cast<uint32_t>((lo >> 60) & 0xFu);
+        const bool pre = ((lo >> 46) & 1u) != 0u;
+        const uint32_t prim = static_cast<uint32_t>((lo >> 47) & 0x7FFu);
+        return nloop == header.count && flg == 0u && nreg == 3u && pre && (prim & 7u) == 4u && (prim & 0x100u) == 0u &&
+               (hi & 0xFFFu) == 0x412u;
+    }
+}
+
+#endif
diff --git a/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
new file mode 100644
index 0000000..6e56280
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
@@ -0,0 +1,194 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "ps2x/state_stream.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Runs a raster backend on a thread of its own, the way the GS works alongside the EE
+// and VU1 on the console. Commands that only change GS state (draws, uploads, CLUT loads,
+// VRAM writes) are queued and return at once; calls that observe the result (VRAM reads,
+// snapshots, local-to-host transfers, presentation) first wait until the queue has been
+// processed up to that point. PS2X_GS_SYNC=1 keeps the backend on the calling thread.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void SetDrawState(const GSDrawState &state) override;
+    void SubmitVertices(const GSVertex *vertices, uint32_t count) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    // Presentation at a point of the command stream: the GS thread builds the frame once
+    // everything queued before it has been drawn, so the image always matches the display
+    // registers of the moment it was queued. The sink receives each frame on the GS thread.
+    using PresentSink = std::function<void(PresentationFrame &&frame)>;
+    void SetPresentSink(PresentSink sink); // before the first QueuePresent
+    bool HasPresentSink() const { return static_cast<bool>(m_presentSink); }
+    void QueuePresent(const GSPresentationRequest &request);
+
+    // A readback answered while what feeds the GS is still at work (see ps2_vif1_thread.h):
+    // from the capture of the watched region, when the region has been written since the
+    // last one, a capture is queued at once. False when the region is not the watched one
+    // or not settled: then only the plain way will do. A write to the region before
+    // EndReadbackAhead() means the answer came too early, and is reported.
+    bool ReadbackAhead(const GSTransferCommand &command, uint8_t *dst, uint32_t maxBytes, uint32_t &bytes);
+    void EndReadbackAhead();
+
+    // Save states: both wait for the queue, then act on the wrapped backend (see
+    // GSCpuBackend). False when that backend keeps no state of this kind.
+    bool SaveState(ps2x::StateWriter &out);
+    bool LoadState(ps2x::StateReader &in);
+
+    // Whether GS work should run on its own thread (PS2X_GS_SYNC unset).
+    static bool enabled();
+
+    // Native meshes (runtime/gs/gs_native_mesh.h): whether the GPU renderer draws alone and so
+    // takes them, and one field of a mesh, drawn with the draw state sent last.
+    bool drawsMeshes() const { return m_meshesReady.load(std::memory_order_relaxed); }
+    void SubmitMesh(const uint8_t *mesh, uint32_t bytes, uint32_t field);
+
+private:
+    enum class Op : uint32_t
+    {
+        Wrap,
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        UploadImage,
+        TextureFlush,
+        WriteVram,
+        Present,
+        Capture,
+        State,
+        Prims,
+        GpuDownload, // GPU-only drawing: local memory from the GPU, for whoever reads it next
+        Mesh,        // a field of a native mesh: MeshPayload, then the mesh
+    };
+    struct MeshPayload
+    {
+        uint32_t bytes, field, unused[2];
+    };
+    std::atomic<bool> m_meshesReady{false}; // the GPU draws alone (set by the GS thread)
+
+    struct alignas(16) Record
+    {
+        Op op;
+        uint32_t bytes; // record size including this header, a multiple of 16
+    };
+
+    void *reserve(Op op, uint32_t payloadBytes);
+    void publish() const;
+    void drain() const; // waits until everything queued so far has been processed
+    void waitConsumed(uint64_t position) const;
+    void run();
+
+    // Primitives travel in runs: a State record when the draw state changes, then Prims
+    // records that hold nothing but the vertices of the primitives drawn with it. A full
+    // copy of the state per primitive (300 bytes for a triangle of 120) was most of what
+    // crossed the queue. The record being filled is announced to the GS thread when it is
+    // closed: when it is full, when anything else is queued, and at Flush().
+    //
+    // The producer side is serialized by m_producerMutex, but not once per primitive: the
+    // thread that opens a run keeps the lock until the run is closed, which only that
+    // thread does (m_runOwner). Everything else on the producer side goes through a
+    // Producer, which ends the calling thread's own run or waits for another thread's.
+    class Producer;
+    void beginRun(uint32_t verticesEach); // with the lock held
+    void endRun() const;                  // by its owner; the lock stays held
+    mutable Record *m_run = nullptr;
+    mutable uint64_t m_runStart = 0u; // m_writePos where the record begins
+    mutable uint32_t m_runCount = 0u;
+    uint32_t m_runEach = 0u;
+    mutable std::atomic<std::thread::id> m_runOwner{};
+    bool m_stateSent = false;
+    GSDrawState m_sentState{};
+    GSDrawState m_threadState{}; // GS thread: the state of the run, for backends that take one primitive at a time
+    class GSCpuBackend *m_cpu = nullptr; // m_inner when it is the software renderer, which takes runs as they are
+
+    // Readbacks that do not wait for the whole queue. A game that draws into a small
+    // buffer early in every frame and reads it back at the end of the frame (an occlusion
+    // buffer for its own culling, here) would otherwise hold the EE up until everything
+    // it queued in between has been drawn too - the one point in a frame where the EE and
+    // the GS thread could not overlap. The region of the last readback is watched: as soon
+    // as the queued commands stop writing to it, a capture of it is queued right there,
+    // and a readback of the same region that finds nothing written to it since only waits
+    // for that capture. Anything else takes the old way (queue the transfer, wait for
+    // everything), so what a readback returns is the same either way.
+    void noteWrite(uint64_t first, uint64_t last); // bytes of GS memory a queued command may write
+    void captureIfSettled();                       // before queueing a command that leaves the region alone
+    bool m_watching = false;
+    GSTransferCommand m_watchCommand{};
+    uint64_t m_watchFirst = 0u, m_watchLast = 0u;
+    bool m_watchWritten = false;    // written by commands queued after the latest capture
+    bool m_captureCurrent = false;  // m_captured holds (or will hold, at m_capturePos) the region as it is
+    uint64_t m_capturePos = 0u;
+    uint64_t m_uploadBytesLeft = 0u; // of a host-to-local transfer whose data is still arriving
+    bool m_readbackPending = false;
+    GSTransferCommand m_readback{};
+    std::vector<uint8_t> m_captured; // filled on the GS thread at a Capture record
+    std::mutex m_captureMutex;       // a readback ahead copies it on another thread
+    // Captures are taken by a rasterizer thread behind a barrier (GSCpuBackend::CaptureQueued):
+    // the one queued last and the one taken last, numbered.
+    uint64_t m_capturesQueued = 0u;
+    std::atomic<uint64_t> m_capturesTaken{0u};
+    void waitCaptured(uint64_t position, uint64_t capture) const;
+    // Marks capture `number` taken and wakes a thread waiting for it (the one that asked
+    // publishes the number in m_captureWanted; 0 = nobody waits).
+    void captureTaken(uint64_t number);
+    mutable std::mutex m_captureWaitMutex;
+    mutable std::condition_variable m_captureReached;
+    mutable std::atomic<uint64_t> m_captureWanted{0u};
+    bool m_aheadWindow = false;      // a write to the region now means a readback was answered too early
+    void watchedRegionWritten();
+    uint32_t m_capturedBytes = 0u;
+    uint32_t m_servedBytes = 0u;
+    uint64_t m_quickReadbacks = 0u, m_fullReadbacks = 0u;
+
+    std::unique_ptr<GSRasterBackend> m_inner;
+    // PS2X_GPU=1: the GPU renderer (gs_gpu.h) gets the same command stream on the GS thread.
+    std::unique_ptr<class GSGpuRenderer> m_gpu;
+    // The GPU draws alone (PS2X_GPU without PS2X_GPU_MIRROR): the software renderer only keeps
+    // local memory for transfers and read-backs, brought up to date from the GPU first.
+    bool m_gpuOnly = false;
+    void downloadFromGpu();
+    PresentSink m_presentSink;
+    std::vector<uint8_t> m_ring;
+    mutable uint64_t m_writePos = 0u; // producer only
+    mutable std::atomic<uint64_t> m_published{0u};
+    std::atomic<uint64_t> m_consumed{0u};
+    mutable std::mutex m_producerMutex;
+
+    mutable std::mutex m_wakeMutex;
+    mutable std::condition_variable m_wake;
+    std::atomic<bool> m_sleeping{false};
+    std::atomic<bool> m_stop{false};
+    std::thread m_thread;
+};
