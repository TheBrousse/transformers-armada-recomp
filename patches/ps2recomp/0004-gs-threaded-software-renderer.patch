+    inline const char *kDrawFragmentBody = R"(
+#ifdef GS_COUNT_FRAGMENTS
+// (PS2X_GPU_PROFILE: the fragments, those the depth test failed, those the alpha test discarded)
+layout(std430, binding = 6) buffer FragmentCounts { uint fragTotal; uint fragDepthFailed; uint fragAlphaDiscarded; uint fragUnused; };
+#endif
+layout(binding = 0, r32ui) coherent uniform uimage2D uFrame;
+layout(binding = 1, r32ui) coherent uniform uimage2D uDepth;
+#ifdef GS_DUAL_FRAME
+// (The other field picture, drawn by the same fragments: the dual program.)
+layout(binding = 7, r32ui) coherent uniform uimage2D uFrame2;
+#endif
+layout(binding = 2, r32ui) readonly uniform uimage2D uSource0;
+layout(binding = 3, r32ui) readonly uniform uimage2D uSource1;
+layout(binding = 4, r32ui) readonly uniform uimage2D uSource2;
+layout(binding = 5, r32ui) readonly uniform uimage2D uSource3;
+// Texture pack replacements (sources 5 to 8): filtered by the GPU, with their mipmaps.
+layout(binding = 0) uniform sampler2D uReplace[16]; // (units 0 to 15)
+uniform vec4 uTarget; // viewport width, height (GL pixels), scale x, y (every buffer's)
+// 1 when the batch's Z only grows (every draw that writes Z tests it GEQUAL or GREATER):
+// a fragment the depth test fails already is dropped before the rest (see main).
+uniform uint uDepthEarly;
+#ifndef GS_NO_DEPTH
+// (The depth buffer again, for the early test's read: without coherence it may come from a
+// cache, and a Z left there earlier is only lower - the barrier between batches has made the
+// earlier batches' Z current.)
+layout(binding = 6, r32ui) readonly uniform uimage2D uDepthSeen;
+#endif
+noperspective in vec4 vColor;
+flat in uvec4 vFlat;
+noperspective in vec3 vTex;
+noperspective in float vFog;
+flat in uint vFlatFog;
+noperspective in float vZ;
+flat in uint vFlatZ;
+flat in uint vDraw;
+
+// a / b rounded down, for |a| < 2^20 and b from 1 to 16 (a scale): in float, as integer
+// division takes a run of slow multiplies on the GPU. With a = k b + r (0 <= r < b),
+// (a + 0.5) / b is k + (r + 0.5) / b - at least 1/32 from a whole number either way, more
+// than the division's rounding (2.5 ulp) - so its floor is k.
+int floorDiv(int a, int b) { return int(floor((float(a) + 0.5) / float(b))); }
+
+int wrapCoord(int c, int size, uint mode, int lo, int hi)
+{
+    if (mode == 0u) return c & (size - 1);
+    if (mode == 1u) return clamp(c, 0, size - 1);
+    if (mode == 2u) return clamp(c, lo, hi);
+    return (c & lo) | hi;
+}
+
+// The sources' sizes (GL pixels), as imageSize() gives them - which asks the image's
+// descriptor, a memory access of its own ahead of every load.
+uniform ivec2 uSourceSize[4];
+// ... and their scales (GL pixels a GS pixel, across and down): a buffer kept at twice the scale down
+// (PS2X_GPU_FULL_FIELDS) is read at its own.
+uniform ivec2 uSourceScale[4];
+
+uint loadSource(uint slot, ivec2 p)
+{
+    if (slot == 1u) return imageLoad(uSource0, clamp(p, ivec2(0), uSourceSize[0] - 1)).r;
+    if (slot == 2u) return imageLoad(uSource1, clamp(p, ivec2(0), uSourceSize[1] - 1)).r;
+    if (slot == 3u) return imageLoad(uSource2, clamp(p, ivec2(0), uSourceSize[2] - 1)).r;
+    return imageLoad(uSource3, clamp(p, ivec2(0), uSourceSize[3] - 1)).r;
+}
+
+// Four pixels of one source, the loads together: their waits overlap (one after the other,
+// a fragment waits four times as long).
+uvec4 loadSource4(uint slot, ivec2 a, ivec2 b, ivec2 c, ivec2 e)
+{
+    if (slot == 1u)
+    {
+        ivec2 m = uSourceSize[0] - 1;
+        return uvec4(imageLoad(uSource0, clamp(a, ivec2(0), m)).r, imageLoad(uSource0, clamp(b, ivec2(0), m)).r,
+                     imageLoad(uSource0, clamp(c, ivec2(0), m)).r, imageLoad(uSource0, clamp(e, ivec2(0), m)).r);
+    }
+    if (slot == 2u)
+    {
+        ivec2 m = uSourceSize[1] - 1;
+        return uvec4(imageLoad(uSource1, clamp(a, ivec2(0), m)).r, imageLoad(uSource1, clamp(b, ivec2(0), m)).r,
+                     imageLoad(uSource1, clamp(c, ivec2(0), m)).r, imageLoad(uSource1, clamp(e, ivec2(0), m)).r);
+    }
+    if (slot == 3u)
+    {
+        ivec2 m = uSourceSize[2] - 1;
+        return uvec4(imageLoad(uSource2, clamp(a, ivec2(0), m)).r, imageLoad(uSource2, clamp(b, ivec2(0), m)).r,
+                     imageLoad(uSource2, clamp(c, ivec2(0), m)).r, imageLoad(uSource2, clamp(e, ivec2(0), m)).r);
+    }
+    ivec2 m = uSourceSize[3] - 1;
+    return uvec4(imageLoad(uSource3, clamp(a, ivec2(0), m)).r, imageLoad(uSource3, clamp(b, ivec2(0), m)).r,
+                 imageLoad(uSource3, clamp(c, ivec2(0), m)).r, imageLoad(uSource3, clamp(e, ivec2(0), m)).r);
+}
+
+// An image source's pixel (a frame buffer the GPU keeps, at the scale) for texel coordinates
+// in its own pixels.
+ivec2 imagePixel(Draw d, int u, int v)
+{
+    ivec2 scale = uSourceScale[int(d.tex0.y) - 1];
+    int gu = floorDiv(u, scale.x);
+    int gv = floorDiv(v, scale.y);
+    int x = (wrapCoord(gu, int(d.tex1.z), d.tex2.x, int(d.region.x), int(d.region.y)) + int(d.misc.z)) * scale.x + (u - gu * scale.x);
+    int y = (wrapCoord(gv, int(d.tex1.w), d.tex2.y, int(d.region.z), int(d.region.w)) + int(d.misc.w)) * scale.y + (v - gv * scale.y);
+    return ivec2(x, y);
