+bool ps2_gpu::picture(Picture &out, uint64_t tick)
+{
+    std::lock_guard<std::mutex> lock(g_pictureMutex);
+    // The picture of that VBlank (or the newest before it); the newest when there is none.
+    const Published *best = nullptr;
+    for (const Published &p : g_published)
+        if (p.valid && p.tick <= tick && (!best || p.tick > best->tick))
+            best = &p;
+    if (!best)
+        for (const Published &p : g_published)
+            if (p.valid && (!best || p.tick > best->tick))
+                best = &p;
+    if (!best)
+        return false;
+    if (best->fence)
+        glWaitSync(best->fence, 0, GL_TIMEOUT_IGNORED);
+    out.texture = best->texture;
+    out.width = best->width;
+    out.height = best->height;
+    out.textureWidth = best->textureWidth;
+    out.textureHeight = best->textureHeight;
+    out.tick = best->tick;
+    out.showsNs = best->showsNs;
+    return true;
+}
+
+bool ps2_gpu::pictureFor(Picture &out, int64_t showsNs, int64_t leewayNs)
+{
+    std::lock_guard<std::mutex> lock(g_pictureMutex);
+    // The newest picture for that refresh or one before it (moment pictures are made for the
+    // refreshes); while there is none, the newest there is.
+    const Published *best = nullptr;
+    for (const Published &p : g_published)
+        if (p.valid && p.showsNs != 0 && p.showsNs <= showsNs + leewayNs && (!best || p.showsNs > best->showsNs))
+            best = &p;
+    if (!best)
+        for (const Published &p : g_published)
+            if (p.valid && (!best || p.tick > best->tick || (p.tick == best->tick && p.showsNs < best->showsNs)))
+                best = &p;
+    if (!best)
+        return false;
+    if (best->fence)
+        glWaitSync(best->fence, 0, GL_TIMEOUT_IGNORED);
+    out.texture = best->texture;
+    out.width = best->width;
+    out.height = best->height;
+    out.textureWidth = best->textureWidth;
+    out.textureHeight = best->textureHeight;
+    out.tick = best->tick;
+    out.showsNs = best->showsNs;
+    return true;
+}
