+    // Calls fn(page) for every 8 KiB page that holds a pixel of the rectangle.
+    template <typename Fn>
+    void forEachPage(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1, Fn &&fn)
+    {
+        x0 = std::max(x0, 0);
+        y0 = std::max(y0, 0);
+        x1 = std::min(x1, 2047);
+        y1 = std::min(y1, 2047);
+        if (x1 < x0 || y1 < y0)
+            return;
+
+        uint32_t widthShift = 0u;
+        uint32_t heightShift = 0u;
+        pageShifts(psm, widthShift, heightShift);
+        const uint32_t pagesPerRow = (bw * 64u) >> widthShift;
+        const uint32_t basePage = bp >> 5u;
+        // A base pointer inside a page spills blocks into the next one.
+        const uint32_t spill = (bp & 31u) != 0u ? 1u : 0u;
+        const uint32_t px0 = static_cast<uint32_t>(x0) >> widthShift;
+        const uint32_t px1 = static_cast<uint32_t>(x1) >> widthShift;
+        const uint32_t py1 = static_cast<uint32_t>(y1) >> heightShift;
+        for (uint32_t py = static_cast<uint32_t>(y0) >> heightShift; py <= py1; ++py)
+            for (uint32_t px = px0; px <= px1; ++px)
+                for (uint32_t k = 0u; k <= spill; ++k)
+                    fn((basePage + py * pagesPerRow + px + k) & 511u);
+    }
