+    void memoryTexture(uint32_t tbp, uint32_t tbw, Kind kind, int width, int height);
+    void extendBatch(int x0, int y0, int x1, int y1, bool zwrite);
+    void prepareDraw();
+    void appendPrimitives(const GSVertex *v, uint32_t count, uint32_t each);
+    void pushQuad(int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog);
+    void flush();
+    void presentPicture(const GSPresentationRequest &request);
+    void printStats();
+};
+
+GSGpuRenderer::GSGpuRenderer() : m(std::make_unique<Impl>())
+{
+    m->profile = envFlag("PS2X_GPU_PROFILE", false);
+    if (const char *env = std::getenv("PS2X_GPU_PROFILE"))
+        m->profileFragments = std::atoi(env) >= 2;
+    m->depthEarly = envFlag("PS2X_GPU_DEPTH_EARLY", true);
+
+    m->stats = envFlag("PS2X_GPU_STATS", false) || m->profile;
+    // (fields: decided with the scale, in init)
+    m->mirror = ps2_gpu::mirrored();
+    if (const char *env = std::getenv("PS2X_SHOT_VSYNCS"))
+    {
+        for (const char *p = env; *p;)
+        {
+            char *end = nullptr;
+            const uint64_t value = std::strtoull(p, &end, 10);
+            if (end == p)
+                break;
+            m->shotTicks.push_back(value);
+            p = (*end == ',') ? end + 1 : end;
+        }
+    }
+}
+
+GSGpuRenderer::~GSGpuRenderer() = default;
+
+void GSGpuRenderer::setSyncHook(std::function<void()> hook)
+{
+    m->syncCpu = std::move(hook);
+}
+
+bool GSGpuRenderer::Impl::init()
+{
+    if (tried)
+        return ready;
+    if (!g_context)
+        return false; // the window does not exist yet: try again later
+    tried = true;
+    glfwMakeContextCurrent(g_context);
+    if (debugEnabled() && glad_glDebugMessageCallback)
+    {
+        glEnable(GL_DEBUG_OUTPUT);
+        glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS);
+        glDebugMessageCallback(debugCallback, nullptr);
+    }
+    if (!hasExtension("GL_ARB_fragment_shader_interlock"))
+    {
+        std::fprintf(stderr, "[gpu] GL_ARB_fragment_shader_interlock is missing: the GPU renderer needs it\n");
+        return false;
+    }
+
+    // The scale, and a power-of-two viewport that holds every GS coordinate at it (exact
+    // arithmetic from GS coordinates to window coordinates).
+    GLint maxViewport[2] = {0, 0}, maxWidth = 0, maxHeight = 0, maxTexture = 0;
+    glGetIntegerv(GL_MAX_VIEWPORT_DIMS, maxViewport);
+    glGetIntegerv(GL_MAX_FRAMEBUFFER_WIDTH, &maxWidth);
+    glGetIntegerv(GL_MAX_FRAMEBUFFER_HEIGHT, &maxHeight);
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTexture);
+    const int limit = std::min({maxViewport[0], maxViewport[1], maxWidth, maxHeight, maxTexture});
+    const auto fit = [limit](int scale, int &viewport)
+    {
+        while (scale > 1 && kMaxCoord * scale > limit)
+            --scale;
+        viewport = kMaxCoord;
+        while (viewport < kMaxCoord * scale)
+            viewport *= 2;
+        viewport = std::min(viewport, limit);
+        return scale;
+    };
+    scaleX = fit(g_scaleX.load(), viewportX);
+    scaleY = fit(g_scaleY.load(), viewportY);
+    // Above the console's resolution each field is kept whole: filling lines in from their
+    // neighbours leaves stripes there.
+    fields = envFlag("PS2X_GPU_FIELDS", scaleY > 1);
+    // (on by default since 2026-10-08, the user's OK after playing with it; =0: each field at half the
+    // scale down, as the emulated path's exact pictures - check_frames.ps1 - are made)
+    fullFields = envFlag("PS2X_GPU_FULL_FIELDS", true);
+    if (fullFields)
+        std::fprintf(stderr, "[gpu] full fields on (PS2X_GPU_FULL_FIELDS): the buffer of both fields kept at twice the scale down\n");
+
+    using namespace gs_gpu_glsl;
+    for (int variant = 0; variant < 4; ++variant)
+    {
+        drawPrograms[variant] =
+            linkProgram({kDrawVertex}, {kDrawFragmentHead, profileFragments ? "#define GS_COUNT_FRAGMENTS\n" : "",
+                                        (variant & 1) ? "#define GS_NO_DEPTH\n" : "",
+                                        (variant & 2) ? "#define GS_PACK_ONLY\n" : "", kMemory, kDrawStruct, kDrawFragmentBody,
+                                        kDrawFragmentMain});
+        if (!drawPrograms[variant])
+            return false;
+        drawTargetLocations[variant] = glGetUniformLocation(drawPrograms[variant], "uTarget");
+        depthEarlyLocations[variant] = glGetUniformLocation(drawPrograms[variant], "uDepthEarly");
+        sourceSizeLocations[variant] = glGetUniformLocation(drawPrograms[variant], "uSourceSize");
+        sourceScaleLocations[variant] = glGetUniformLocation(drawPrograms[variant], "uSourceScale");
+    }
+    drawProgram = drawPrograms[0];
+    dualProgram = linkProgram({kDrawVertex}, {kDrawFragmentHead, "#define GS_NO_DEPTH\n#define GS_DUAL_FRAME\n", kMemory, kDrawStruct, kDrawFragmentBody,
+                                              kDrawFragmentMain});
+    dualEnabled = dualProgram != 0u && envFlag("PS2X_GPU_DUAL", true);
+    foldEnabled = envFlag("PS2X_GPU_FOLD", true);
+    if (dualProgram)
+    {
+        dualTargetLocation = glGetUniformLocation(dualProgram, "uTarget");
+        dualSourceSizeLocation = glGetUniformLocation(dualProgram, "uSourceSize");
+        dualSourceScaleLocation = glGetUniformLocation(dualProgram, "uSourceScale");
+    }
+    // The native pixel path (PS2X_GPU_NATIVE=1): its draw programs and the depth copies' passes.
+    // (on by default since 2026-10-08, the user's OK after playing with it; =0: the exact emulated
+    // pixel pipeline, which check_frames.ps1 and the golden frame sets keep to)
+    nativeEnabled = envFlag("PS2X_GPU_NATIVE", true) && glad_glTextureView != nullptr;
+    nativeFields = envFlag("PS2X_GPU_NATIVE_FIELDS", true);
+    if (const char *env = std::getenv("PS2X_GPU_PACK_LOG"))
+        packLogLeft = std::atoi(env);
+    if (nativeEnabled)
+    {
+        // (the multisampled variants, 2 and 3, made when the scene is: below)
+        const auto linkNative = [&](int v)
+        {
+            nativePrograms[v] = linkProgram({kVersion, kDrawStruct, kNativeVertex},
+                                            {kVersion, (v & 1) ? "#define GS_PACK_ONLY\n" : "", (v & 2) ? "#define GS_MS_DEPTH\n" : "",
+                                             kMemory, kDrawStruct, kDrawFragmentBody, kNativeFragmentMain});
+            nativeTargetLocations[v] = nativePrograms[v] ? glGetUniformLocation(nativePrograms[v], "uTarget") : -1;
+            nativeDepthLocations[v] = nativePrograms[v] ? glGetUniformLocation(nativePrograms[v], "uDepthRange") : -1;
+            nativeSourceSizeLocations[v] = nativePrograms[v] ? glGetUniformLocation(nativePrograms[v], "uSourceSize") : -1;
+            nativeSourceScaleLocations[v] = nativePrograms[v] ? glGetUniformLocation(nativePrograms[v], "uSourceScale") : -1;
+            nativeViewsLocations[v] = nativePrograms[v] ? glGetUniformLocation(nativePrograms[v], "uSourceViews") : -1;
+            return nativePrograms[v] != 0u;
+        };
+        for (int v = 0; v < 2; ++v)
+            linkNative(v);
+        nativeViews = envFlag("PS2X_GPU_NATIVE_VIEWS", true);
+        glGenSamplers(1, &viewSampler);
+        glSamplerParameteri(viewSampler, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glSamplerParameteri(viewSampler, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glSamplerParameteri(viewSampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glSamplerParameteri(viewSampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        viewDummy = makeTexture(GL_RGBA8, 1, 1, GL_NEAREST);
+        unpackProgram = linkProgram({kFullscreenVertex}, {kNativeUnpack});
+        packProgram = linkProgram({kFullscreenVertex}, {kNativePack});
+        if (!nativePrograms[0] || !nativePrograms[1] || !unpackProgram || !packProgram)
+        {
+            nativeEnabled = false;
+            std::fprintf(stderr, "[gpu] the native pixel path's programs did not build: it is off\n");
+        }
+        else
+        {
+            unpackBitsLocation = glGetUniformLocation(unpackProgram, "uDepthBits");
+            packBitsLocation = glGetUniformLocation(packProgram, "uDepthBits");
+            glGenFramebuffers(1, &nativeFbo);
+            glGenFramebuffers(1, &depthFbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, depthFbo);
+            glDrawBuffer(GL_NONE);
+            glReadBuffer(GL_NONE);
+            glBindFramebuffer(GL_FRAMEBUFFER, 0);
+            momentFogProgram = linkProgram({kFullscreenVertex}, {kMomentFog});
+            if (momentFogProgram)
+            {
+                momentFogScaleLocation = glGetUniformLocation(momentFogProgram, "uDepthScale");
+                momentFogPixelLocation = glGetUniformLocation(momentFogProgram, "uScale");
+                glGenFramebuffers(1, &momentFogFbo);
+            }
+            nativeFog = momentFogProgram != 0u && envFlag("PS2X_GPU_NATIVE_FOG", true);
+            // Multisampling of the scene (PS2X_GPU_MSAA=2/4/8, 4 by default since the user's OK on
+            // 2026-10-08, 0 off): the native batches that draw with a depth buffer - the scene - into
+            // multisampled copies of their buffers (Target::ms).
+            if (const int asked = envInt("PS2X_GPU_MSAA", 4); asked > 1 && !envFlag("PS2X_MOMENT_BLOCKY", false))
+            {
+                GLint most = 0;
+                glGetIntegerv(GL_MAX_SAMPLES, &most);
+                const int wanted = std::min(asked, static_cast<int>(most));
+                const int samples = wanted >= 8 ? 8 : (wanted >= 4 ? 4 : (wanted >= 2 ? 2 : 0));
+                if (samples > 1 && (msFillProgram = linkProgram({kFullscreenVertex}, {kMsaaFill})) != 0u &&
+                    (msDepthResolveProgram = linkProgram({kFullscreenVertex}, {kMsaaDepthResolve})) != 0u &&
+                    (!(msPixelDepth = envFlag("PS2X_GPU_MSAA_PIXEL_DEPTH", false)) || (linkNative(2) && linkNative(3))))
+                {
+                    sceneMsaa = samples;
+                    msFillWhatLocation = glGetUniformLocation(msFillProgram, "uWhat");
+                    msDepthResolveSamplesLocation = glGetUniformLocation(msDepthResolveProgram, "uSamples");
+                    glGenFramebuffers(1, &msFbo);
+                    glGenFramebuffers(1, &msOneFbo);
+                    glGenFramebuffers(1, &msResolveFbo);
+                    std::fprintf(stderr, "[gpu] the scene multisampled (PS2X_GPU_MSAA): %d samples, the depth %s\n", samples,
+                                 msPixelDepth ? "the GS's Z a pixel" : "the GPU's a sample");
+                }
+            }
+            std::fprintf(stderr, "[gpu] native pixel path on (PS2X_GPU_NATIVE): the GPU's own depth test and blending where they do\n");
+        }
+    }
+    if (profileFragments)
+    {
+        glGenBuffers(1, &fragmentCounts);
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, fragmentCounts);
+        const uint32_t zero[4] = {0u, 0u, 0u, 0u};
+        glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(zero), zero, GL_DYNAMIC_READ);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 6, fragmentCounts);
+    }
+    {
+        const char *env = std::getenv("PS2X_GPU_MESHES");
+        meshMode = env && *env ? std::atoi(env) : 2;
+        if (meshMode >= 2 && glad_glDispatchCompute)
+        {
+            const GLuint cs = compileShader(GL_COMPUTE_SHADER, {kMeshExpand});
+            if (cs)
+            {
+                meshProgram = glCreateProgram();
+                glAttachShader(meshProgram, cs);
+                glLinkProgram(meshProgram);
+                glDeleteShader(cs);
+                GLint ok = 0;
+                glGetProgramiv(meshProgram, GL_LINK_STATUS, &ok);
+                if (!ok)
+                {
+                    glDeleteProgram(meshProgram);
+                    meshProgram = 0u;
+                }
+            }
+            if (meshProgram)
+            {
+                meshTrianglesLocation = glGetUniformLocation(meshProgram, "uTriangles");
+                meshTriangleBaseLocation = glGetUniformLocation(meshProgram, "uTriangleBase");
+                meshZeroLocation = glGetUniformLocation(meshProgram, "uZero");
+                glGenBuffers(1, &meshDataBuffer);
+                glGenBuffers(1, &meshTableBuffer);
+            }
+            else
+                meshMode = 1;
+        }
+    }
+    // Moment pictures (stage 4): with the native pixel path, field pictures and no software
+    // renderer beside; used when the game asks for them (ps2_host_display::setMomentFields).
+    momentsEnabled = nativeEnabled && fields && !mirror && glad_glDispatchCompute != nullptr && envFlag("PS2X_GPU_MOMENTS", true);
+    if (momentsEnabled)
+    {
+        if (const GLuint cs = compileShader(GL_COMPUTE_SHADER, {kMomentLerp}))
+        {
+            momentLerpProgram = glCreateProgram();
+            glAttachShader(momentLerpProgram, cs);
+            glLinkProgram(momentLerpProgram);
+            glDeleteShader(cs);
+            GLint ok = 0;
+            glGetProgramiv(momentLerpProgram, GL_LINK_STATUS, &ok);
+            if (!ok)
+            {
+                glDeleteProgram(momentLerpProgram);
+                momentLerpProgram = 0u;
+            }
+        }
+        if (momentLerpProgram && momentFogProgram)
+        {
+            momentPiecesLocation = glGetUniformLocation(momentLerpProgram, "uPieces");
+            momentVerticesLocation = glGetUniformLocation(momentLerpProgram, "uVertices");
+            momentFirstLocation = glGetUniformLocation(momentLerpProgram, "uFirst");
+            glGenBuffers(1, &momentPieceBuffer);
+            momentMainToo = envFlag("PS2X_MOMENT_MAIN", false);
+            continuity = envFlag("PS2X_MOMENT_CONTINUITY", false);
+            carry = envFlag("PS2X_MOMENT_CARRY", true);
+            if (const int asked = envInt("PS2X_GPU_MSAA", 4); asked > 1 && !envFlag("PS2X_MOMENT_BLOCKY", false))
+            {
+                GLint most = 0;
+                glGetIntegerv(GL_MAX_SAMPLES, &most);
+                msaaSamples = std::min(asked, static_cast<int>(most));
+                msaaSamples = msaaSamples >= 8 ? 8 : (msaaSamples >= 4 ? 4 : (msaaSamples >= 2 ? 2 : 0));
+                if (msaaSamples)
+                    std::fprintf(stderr, "[gpu] moment pictures multisampled (PS2X_GPU_MSAA): %d samples\n", msaaSamples);
+            }
+            if (envFlag("PS2X_MOMENT_BLOCKY", false))
+            {
+                momentBlockyProgram = linkProgram({kFullscreenVertex}, {kMomentBlocky});
+                momentBlockyScaleLocation = momentBlockyProgram ? glGetUniformLocation(momentBlockyProgram, "uScale") : -1;
+            }
+            if (const char *env = std::getenv("PS2X_MOMENT_OFFSET"); env && *env)
+                momentOffsetMs = std::clamp(std::atof(env), -16.0, 50.0);
+        }
+        else
+        {
+            momentsEnabled = false;
+            std::fprintf(stderr, "[gpu] the moment pictures' programs did not build: they are off\n");
+        }
+    }
+    loadProgram = linkProgram({kFullscreenVertex}, {kVersion, kMemory, kLoadFragmentBody});
+    writebackProgram = linkProgram({kFullscreenVertex}, {kWritebackHead, kMemory, kWritebackFragmentBody});
+    composeProgram = linkProgram({kFullscreenVertex}, {kVersion, kMemory, kComposeFragmentBody});
+    fieldProgram = linkProgram({kFullscreenVertex}, {kFieldFragment});
+    if (!drawProgram || !loadProgram || !writebackProgram || !composeProgram || !fieldProgram)
+        return false;
+    drawTargetLocation = glGetUniformLocation(drawProgram, "uTarget");
+    loadLocation = glGetUniformLocation(loadProgram, "uLoad");
+    writebackLocation = glGetUniformLocation(writebackProgram, "uWrite");
+    writebackPagesLocation = glGetUniformLocation(writebackProgram, "uPages");
+
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glGenBuffers(1, &vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    const auto at = [](size_t offset) { return reinterpret_cast<void *>(offset); };
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, sizeof(GpuVertex), at(offsetof(GpuVertex, x)));
+    glEnableVertexAttribArray(1);
+    glVertexAttribIPointer(1, 1, GL_UNSIGNED_INT, sizeof(GpuVertex), at(offsetof(GpuVertex, z)));
+    glEnableVertexAttribArray(2);
+    glVertexAttribIPointer(2, 4, GL_UNSIGNED_BYTE, sizeof(GpuVertex), at(offsetof(GpuVertex, r)));
+    glEnableVertexAttribArray(3);
+    glVertexAttribPointer(3, 3, GL_FLOAT, GL_FALSE, sizeof(GpuVertex), at(offsetof(GpuVertex, s)));
+    glEnableVertexAttribArray(4);
+    glVertexAttribIPointer(4, 1, GL_UNSIGNED_INT, sizeof(GpuVertex), at(offsetof(GpuVertex, packed)));
+    glGenVertexArrays(1, &emptyVao);
+
+    // Local memory (loaded page by page as it is needed), its swizzle, the draws, the CLUTs.
+    glGenBuffers(1, &memoryBuffer);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, memoryBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, kPages * kPageBytes, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, memoryBuffer);
+    {
+        std::vector<uint32_t> table(45056u);
+        const auto fill = [&table](uint32_t base, uint32_t width, uint32_t height, const auto &pageTable)
+        {
+            for (uint32_t y = 0; y < height; ++y)
+                for (uint32_t x = 0; x < width; ++x)
+                    table[base + y * width + x] = pageTable[0][y][x];
+        };
+        fill(0u, 64u, 32u, GSMem::PageTableC32);
+        fill(2048u, 64u, 32u, GSMem::PageTableZ32);
+        fill(4096u, 64u, 64u, GSMem::PageTableC16);
+        fill(8192u, 64u, 64u, GSMem::PageTableC16S);
+        fill(12288u, 64u, 64u, GSMem::PageTableZ16);
+        fill(16384u, 64u, 64u, GSMem::PageTableZ16S);
+        fill(20480u, 128u, 64u, GSMem::PageTableP8);
+        fill(28672u, 128u, 128u, GSMem::PageTableP4);
+        glGenBuffers(1, &swizzleBuffer);
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, swizzleBuffer);
+        glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(table.size() * 4u), table.data(), GL_STATIC_DRAW);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 2, swizzleBuffer);
+    }
+    glGenBuffers(1, &drawBuffer);
+    glGenBuffers(1, &clutBuffer);
+
+    // Drawing writes images only: a framebuffer without attachments, as big as the viewport.
+    glGenFramebuffers(1, &drawFbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_WIDTH, viewportX);
+    glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_HEIGHT, viewportY);
+    glGenFramebuffers(1, &presentFbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    dummyImage = makeTexture(GL_R32UI, 1, 1, GL_NEAREST);
+
+    // The window's pictures, with mipmaps: drawn smaller than they are (a 4K picture in a
+    // window), they are filtered rather than skipped through.
+    pictureLevels = 1;
+    while (std::max(kPictureWidth * scaleX, kPictureHeight * scaleY) >> pictureLevels)
+        ++pictureLevels;
+    if (!envFlag("PS2X_GPU_PICTURE_MIPS", true))
+        pictureLevels = 1; // (testing aid: the pictures without mipmaps)
+    makePictureSlots(4u);
+    composed = makeTexture(GL_RGBA8, kPictureWidth * scaleX, kPictureHeight * scaleY, GL_LINEAR); // (the field pass fetches texels)
+    aaEnabled = envFlag("PS2X_GPU_AA", false);
+    if (aaEnabled)
+    {
+        fxaaProgram = linkProgram({gs_gpu_glsl::kFullscreenVertex}, {gs_gpu_glsl::kFxaa});
+        if (fxaaProgram)
+        {
+            fxaaTexelLocation = glGetUniformLocation(fxaaProgram, "uTexel");
+            composedFields = makeTexture(GL_RGBA8, kPictureWidth * scaleX, kPictureHeight * scaleY, GL_LINEAR);
+            std::fprintf(stderr, "[gpu] edges smoothed (PS2X_GPU_AA)\n");
+        }
+        else
+            aaEnabled = false;
+    }
+
+    // A texture pack: PS2X_TEXTURE_PACK=<folder> (0: none), else replacements/ or
+    // textures/replacements/ in the working directory.
+    {
+        std::string folder;
+        if (const char *env = std::getenv("PS2X_TEXTURE_PACK"))
+            folder = (env[0] == '0' && env[1] == '\0') ? std::string() : std::string(env);
+        else
+            folder = "replacements";
+        packOpen = pack.open(folder) || (!std::getenv("PS2X_TEXTURE_PACK") && pack.open("textures/replacements"));
+        packLog = envFlag("PS2X_TEXTURE_PACK_LOG", false);
+        if (const char *env = std::getenv("PS2X_GPU_PACK_MEMO"); env && *env)
+            replacementMemoMode = std::atoi(env);
+        textureCache = nativeEnabled && envFlag("PS2X_GPU_TEXTURE_CACHE", true); // (on by default since 2026-10-08)
+        replacements = packOpen || textureCache;
+        if (packOpen)
+            std::fprintf(stderr, "[gpu] texture pack: %zu replacement textures\n", pack.size());
+        if (textureCache)
+            std::fprintf(stderr, "[gpu] texture cache on (PS2X_GPU_TEXTURE_CACHE): textures from local memory decoded once, for the native path\n");
+        if (replacements)
+        {
+            glGenSamplers(static_cast<GLsizei>(packSamplers.size()), packSamplers.data());
+            // PS2X_GPU_ANISOTROPY=<1-16>: the replacements' anisotropic filtering (16).
+            float anisotropy = 16.0f;
+            if (const char *env = std::getenv("PS2X_GPU_ANISOTROPY"); env && *env)
+                anisotropy = std::clamp(static_cast<float>(std::atof(env)), 1.0f, 16.0f);
+            for (uint32_t i = 0; i < packSamplers.size(); ++i)
+            {
+                const GLuint sampler = packSamplers[i];
+                const bool linear = (i & 4u) != 0u;
+                glSamplerParameteri(sampler, GL_TEXTURE_WRAP_S, (i & 1u) ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+                glSamplerParameteri(sampler, GL_TEXTURE_WRAP_T, (i & 2u) ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+                glSamplerParameteri(sampler, GL_TEXTURE_MIN_FILTER, linear ? GL_LINEAR_MIPMAP_LINEAR : GL_NEAREST_MIPMAP_NEAREST);
+                glSamplerParameteri(sampler, GL_TEXTURE_MAG_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+                if (linear)
+                    glSamplerParameterf(sampler, 0x84FE /* GL_TEXTURE_MAX_ANISOTROPY */, anisotropy);
+            }
+            glGenSamplers(static_cast<GLsizei>(decodedSamplers.size()), decodedSamplers.data());
+            for (uint32_t i = 0; i < decodedSamplers.size(); ++i)
+            {
+                const GLuint sampler = decodedSamplers[i];
+                const bool linear = (i & 4u) != 0u;
+                glSamplerParameteri(sampler, GL_TEXTURE_WRAP_S, (i & 1u) ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+                glSamplerParameteri(sampler, GL_TEXTURE_WRAP_T, (i & 2u) ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+                glSamplerParameteri(sampler, GL_TEXTURE_MIN_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+                glSamplerParameteri(sampler, GL_TEXTURE_MAG_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+            }
+            packDummy = makeTexture(GL_RGBA8, 1, 1, GL_NEAREST);
+        }
+    }
+
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+    glProvokingVertex(GL_LAST_VERTEX_CONVENTION); // flat shading takes the last vertex's colour
+    ready = true;
+    if (scaleX == scaleY)
+        std::fprintf(stderr, "[gpu] renderer ready on the GS thread (%s): scale %d (%dx%d pictures)\n",
+                     reinterpret_cast<const char *>(glGetString(GL_VERSION)), scaleX, kPictureWidth * scaleX, kPictureHeight * scaleY);
+    else
+        std::fprintf(stderr, "[gpu] renderer ready on the GS thread (%s): scale %d across, %d down (%dx%d pictures)\n",
+                     reinterpret_cast<const char *>(glGetString(GL_VERSION)), scaleX, scaleY, kPictureWidth * scaleX,
+                     kPictureHeight * scaleY);
+    return true;
+}
+
+// The window's pictures, with mipmaps: drawn smaller than they are (a 4K picture in a window),
+// they are filtered rather than skipped through. (More of them once moment pictures are drawn.)
+void GSGpuRenderer::Impl::makePictureSlots(size_t count)
+{
+    count = std::min(count, pictures.size());
+    for (; pictureSlots < count; ++pictureSlots)
+    {
+        GLuint &picture = pictures[pictureSlots];
+        glGenTextures(1, &picture);
+        glBindTexture(GL_TEXTURE_2D, picture);
+        glTexStorage2D(GL_TEXTURE_2D, pictureLevels, GL_RGBA8, kPictureWidth * scaleX, kPictureHeight * scaleY);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+}
+
+bool GSGpuRenderer::Impl::begin()
+{
+    if (!init())
+        return false;
+    if (invalidatePending.load(std::memory_order_relaxed) && invalidatePending.exchange(false))
+    {
+        flush();
+        invalidateAll();
+    }
+    return vram != nullptr;
+}
+
+// Local memory changed behind the command stream (a state was loaded): everything is read
+// from it again.
+void GSGpuRenderer::Impl::invalidateAll()
+{
+    owner.fill(nullptr);
+    hostNewer.fill(1u);
+    cpuPending.fill(1u);
+    gpuNewer.fill(0u);
+    pageWritten.fill(++writeClock);
+    pageDrawn.fill(0u);
+    ++memoryEpoch;
+    for (auto &t : targets)
+    {
+        markAllStale(*t);
+        std::fill(t->depthRows.begin(), t->depthRows.end(), uint8_t{kDepthTexture}); // (its native copy is of what went before)
+        t->msNewer = false; // (and its multisampled copy)
+        t->msStale = true;
+        t->msY0 = t->msOneY0 = 1 << 30;
+        t->msY1 = t->msOneY1 = -1;
+    }
+    clutCbp[0] = clutCbp[1] = ~0u;
+}
+
+// ---- local memory: what changed, and the GPU's copy -----------------------------------------
+
+// The GPU's copy of local memory as the pages are now: what buffers drew there and have not
+// written back is written back; what the EE side wrote comes from the software renderer's copy.
+void GSGpuRenderer::Impl::makeMemoryCurrent(const PageList &pages)
+{
+    for (uint16_t first : pages)
+    {
+        Target *t = owner[first];
+        if (!t)
+            continue;
+        if (batchUses(*t) && !vertices.empty())
+            flush(); // (its draws first)
+        std::array<uint32_t, 16> mask{};
+        for (uint16_t page : pages)
+            if (owner[page] == t)
+            {
+                mask[page >> 5u] |= 1u << (page & 31u);
+                owner[page] = nullptr;
+            }
+        writeBack(*t, mask);
+    }
+    bool any = false, pending = false;
+    for (uint16_t page : pages)
+        if (hostNewer[page])
+        {
+            any = true;
+            pending = pending || cpuPending[page] != 0u;
+        }
+    if (!any)
+        return;
+    if (pending)
+    {
+        if (syncCpu)
+            syncCpu();
+        cpuPending.fill(0u);
+        ++statSyncs;
+    }
+    barrier();
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, memoryBuffer);
+    for (uint16_t page : pages)
+        if (hostNewer[page])
+        {
+            glBufferSubData(GL_SHADER_STORAGE_BUFFER, static_cast<GLintptr>(page) * kPageBytes, kPageBytes,
+                            vram + static_cast<size_t>(page) * kPageBytes);
+            hostNewer[page] = 0u;
+            ++statUploads;
+        }
+}
+
+// Drawing alone: what only the GPU has of those pages, into the software renderer's local memory
+// (which transfers, read-backs and save states go by). Waits for the GPU.
+void GSGpuRenderer::Impl::download(const PageList &pages)
+{
+    bool any = false, queued = false;
+    for (uint16_t page : pages)
+    {
+        any = any || gpuNewer[page] != 0u;
+        queued = queued || framePages.test(page) || (batchZWrite && depthPages.test(page));
+    }
+    if (queued)
+    {
+        flush(); // (the queued draws go there)
+        any = true;
+    }
+    if (!any)
+        return;
+    makeMemoryCurrent(pages);
+    barrier();
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, memoryBuffer);
+    for (uint16_t page : pages)
+        if (gpuNewer[page])
+        {
+            glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, static_cast<GLintptr>(page) * kPageBytes, kPageBytes,
+                               vram + static_cast<size_t>(page) * kPageBytes);
+            gpuNewer[page] = 0u;
+            ++statDownloads;
+        }
+}
+
+// The pages of a buffer in `mask` (a bit per page), written to the GPU's copy of local memory.
+void GSGpuRenderer::Impl::writeBack(Target &t, const std::array<uint32_t, 16> &mask)
+{
+    int top = 0, bottom = t.rows - 1;
+    if ((t.bp & 31u) == 0u)
+    {
+        // Only the rows of the cells on those pages.
+        const uint32_t perRow = std::max<uint32_t>(1u, (t.bw * 64u) / kKindPageW[t.kind]);
+        const int ph = static_cast<int>(kKindPageH[t.kind]);
+        top = t.rows;
+        bottom = -1;
+        for (uint32_t cy = 0; cy < t.cellsY; ++cy)
+            for (uint32_t cx = 0; cx < t.cellsX; ++cx)
+            {
+                const uint32_t page = ((t.bp >> 5u) + cy * perRow + cx) & (kPages - 1u);
+                if ((mask[page >> 5u] & (1u << (page & 31u))) != 0u)
+                {
+                    top = std::min(top, static_cast<int>(cy) * ph);
+                    bottom = std::max(bottom, static_cast<int>(cy + 1u) * ph - 1);
+                }
+            }
+        if (bottom < top)
+            return;
+    }
+    msaaResolve(t, 3); // (what the scene drew multisampled first)
+    {
+        // (the native depth of those rows first)
+        const uint32_t ph = kKindPageH[t.kind];
+        nativeDepthCurrent(t, 3, static_cast<uint32_t>(top) / ph, static_cast<uint32_t>(bottom) / ph);
+    }
+    barrier();
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glViewport(0, 0, viewportX, viewportY);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(0, top, t.width, bottom - top + 1); // one fragment per GS pixel
+    glUseProgram(writebackProgram);
+    glUniform4i(writebackLocation, static_cast<GLint>(t.kind), static_cast<GLint>(t.bp), static_cast<GLint>(t.bw), t.sx | (t.sy << 8));
+    glUniform1uiv(writebackPagesLocation, 16, mask.data());
+    glBindImageTexture(0, t.tex, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+    glBindVertexArray(emptyVao);
+    timeBegin(3);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    timeEnd();
+    memoryWritten = true;
+    statWriteRows += static_cast<uint64_t>(bottom - top + 1);
+}
+
+void GSGpuRenderer::Impl::markAllStale(Target &t)
+{
+    std::fill(t.staleCells.begin(), t.staleCells.end(), uint8_t{1u});
+    t.anyStale = !t.staleCells.empty();
+}
+
+// The cell of a buffer a page of local memory holds becomes stale.
+void GSGpuRenderer::Impl::markStale(Target &t, uint32_t page)
+{
+    if ((t.bp & 31u) != 0u)
+    {
+        markAllStale(t);
+        return;
+    }
+    const uint32_t perRow = std::max<uint32_t>(1u, (t.bw * 64u) / kKindPageW[t.kind]);
+    const uint32_t relative = (page - (t.bp >> 5u)) & (kPages - 1u);
+    const uint32_t cy = relative / perRow, cx = relative % perRow;
+    if (cy < t.cellsY && cx < t.cellsX)
+    {
+        t.staleCells[cy * t.cellsX + cx] = 1u;
+        t.anyStale = true;
+    }
+    else
+    {
+        markAllStale(t); // (a buffer that wraps around the end of local memory)
+    }
+}
+
+// Written from the EE side (transfers): the software renderer's copy of those pages is the
+// newest, and the buffers the GPU keeps there are stale.
+void GSGpuRenderer::Impl::markMemoryWritten(const PageList &pages)
+{
+    for (uint16_t page : pages)
+    {
+        hostNewer[page] = 1u;
+        owner[page] = nullptr;
+        pageWritten[page] = ++writeClock;
+        pageDrawn[page] = 0u;
+        for (Target *t : pageTargets[page])
+        {
+            markStale(*t, page);
+            ++t->statByUpload;
+        }
+    }
+    ++memoryEpoch;
+}
+
+// Drawn by the GPU into `drawn` (and by the software renderer into its copy): `drawn` has the
+// newest content of those pages, and the other buffers on them are stale.
+void GSGpuRenderer::Impl::markDrawn(const PageList &pages, Target *drawn)
+{
+    for (uint16_t page : pages)
+    {
+        owner[page] = drawn;
+        pageWritten[page] = ++writeClock;
+        pageDrawn[page] = 1u;
+        if (mirror)
+            cpuPending[page] = 1u;
+        else
+            gpuNewer[page] = 1u;
+        for (Target *t : pageTargets[page])
+            if (t != drawn)
+            {
+                markStale(*t, page);
+                ++t->statByDraw;
+            }
+    }
+    ++memoryEpoch;
+}
+
+// ---- frame and depth buffers ----------------------------------------------------------------
+
+GSGpuRenderer::Impl::Target *GSGpuRenderer::Impl::findTarget(uint32_t bp, uint32_t bw, Kind kind)
+{
+    bw = std::max<uint32_t>(bw, 1u);
+    for (auto &t : targets)
+        if (t->bp == bp && t->bw == bw && t->kind == kind)
+            return t.get();
+    return nullptr;
+}
+
+void GSGpuRenderer::Impl::registerPages(Target &t)
+{
+    t.pages.clear();
+    pagesOf(t.pages, t.bp, t.bw, t.kind, 0, 0, t.width - 1, t.rows - 1);
+    std::sort(t.pages.begin(), t.pages.end());
+    t.pages.erase(std::unique(t.pages.begin(), t.pages.end()), t.pages.end());
+    for (uint16_t page : t.pages)
+        pageTargets[page].push_back(&t);
+}
+
+void GSGpuRenderer::Impl::unregisterPages(Target &t)
+{
+    for (uint16_t page : t.pages)
+    {
+        auto &list = pageTargets[page];
+        list.erase(std::remove(list.begin(), list.end(), &t), list.end());
+    }
+    t.pages.clear();
+}
+
+void GSGpuRenderer::Impl::allocate(Target &t, int rows)
+{
+    if (t.tex)
+    {
+        msaaResolve(t, 4);
+        nativeDepthCurrent(t, 4); // (into the texture copied below)
+    }
+    dropNative(t);             // (made again at the new size)
+    const GLuint old = t.tex;
+    const int oldRows = t.rows;
+    t.tex = makeTexture(GL_R32UI, t.width * t.sx, rows * t.sy, GL_NEAREST);
+    if (old)
+    {
+        // What the GPU drew so far stays; the new rows come from local memory.
+        glMemoryBarrier(GL_ALL_BARRIER_BITS);
+        imagesWritten = memoryWritten = false;
+        glCopyImageSubData(old, GL_TEXTURE_2D, 0, 0, 0, 0, t.tex, GL_TEXTURE_2D, 0, 0, 0, 0, t.width * t.sx, oldRows * t.sy, 1);
+        glDeleteTextures(1, &old);
+    }
+    dropShadows(t); // (made again at their size when drawn)
+    unregisterPages(t);
+    t.rows = rows;
+    registerPages(t);
+    // The cells: rows grow at the end, so the old cells keep their places.
+    const uint32_t pw = kKindPageW[t.kind], ph = kKindPageH[t.kind];
+    t.cellsX = std::max<uint32_t>(1u, static_cast<uint32_t>(t.width) / pw);
+    const uint32_t oldCellsY = t.cellsY;
+    t.cellsY = static_cast<uint32_t>(rows) / ph;
+    t.staleCells.resize(static_cast<size_t>(t.cellsX) * t.cellsY, uint8_t{1u});
+    t.depthRows.assign(std::max<uint32_t>(t.cellsY, 1u), uint8_t{kDepthTexture}); // (no native copy: dropped above)
+    if (!old || (t.bp & 31u) != 0u)
+        markAllStale(t);
+    else if (t.cellsY > oldCellsY)
+        t.anyStale = true;
+}
+
+void GSGpuRenderer::Impl::evictTarget()
+{
+    auto victim = targets.end();
+    for (auto it = targets.begin(); it != targets.end(); ++it)
+        if (!batchUses(**it) && (victim == targets.end() || (*it)->lastUse < (*victim)->lastUse))
+            victim = it;
+    if (victim == targets.end())
+        return;
+    Target &t = **victim;
+    // What only it has goes to local memory first.
+    PageList owned;
+    for (uint16_t page : t.pages)
+        if (owner[page] == &t)
+            owned.push_back(page);
+    if (!owned.empty())
+        makeMemoryCurrent(owned);
+    unregisterPages(t);
+    dropNative(t);
+    glDeleteTextures(1, &t.tex);
+    dropShadows(t);
+    targets.erase(victim);
+}
+
+// The buffer the GPU keeps for a base, width and layout, with at least `rowsNeeded` rows
+// (created or grown; its new rows come from local memory on first use).
+GSGpuRenderer::Impl::Target *GSGpuRenderer::Impl::target(uint32_t bp, uint32_t bw, Kind kind, int rowsNeeded, int sy)
+{
+    bw = std::max<uint32_t>(bw, 1u);
+    const int ph = static_cast<int>(kKindPageH[kind]);
+    const int rows = std::clamp(((rowsNeeded + ph - 1) / ph) * ph, ph, kMaxCoord);
+    if (sy == 0)
+        sy = frameScaleY(bp, bw, kind);
+    if (Target *found = findTarget(bp, bw, kind))
+    {
+        found->lastUse = ++useClock;
+        if (found->sy != sy)
+            rescale(*found, sy);
+        if (found->rows < rows)
+        {
+            if (batchUses(*found))
+            {
+                flushWhy = 10;
+                flush(); // (its texture is replaced)
+            }
+            allocate(*found, rows);
+        }
+        return found;
+    }
+    if (targets.size() >= kMaxTargets)
+        evictTarget();
+    auto t = std::make_unique<Target>();
+    t->bp = bp;
+    t->bw = bw;
+    t->kind = kind;
+    t->width = static_cast<int>(std::min<uint32_t>(bw * 64u, kMaxCoord));
+    t->sx = scaleX;
+    t->sy = sy;
+    t->lastUse = ++useClock;
+    allocate(*t, rows);
+    targets.push_back(std::move(t));
+    return targets.back().get();
+}
+
+// A buffer at another scale down (PS2X_GPU_FULL_FIELDS): what only it has goes to local memory,
+// and it is made again, loaded from there on its next use.
+void GSGpuRenderer::Impl::rescale(Target &t, int sy)
+{
+    if (batchUses(t) && !vertices.empty())
+    {
+        flushWhy = 10;
+        flush();
+    }
+    PageList owned;
+    for (uint16_t page : t.pages)
+        if (owner[page] == &t)
+            owned.push_back(page);
+    if (!owned.empty())
+        makeMemoryCurrent(owned);
+    dropNative(t);
+    dropShadows(t);
+    if (t.tex)
+        glDeleteTextures(1, &t.tex);
+    t.tex = 0u;
+    t.sy = sy;
+    allocate(t, t.rows);
+}
+
+bool GSGpuRenderer::Impl::batchUses(const Target &t) const
+{
+    if (&t == batchFrame || &t == batchDepth)
+        return true;
+    for (uint32_t i = 0; i < sourceCount; ++i)
+        if (sources[i] == t.tex)
+            return true;
+    return false;
+}
+
+// Shader stores (to buffers' images, to the GPU's copy of local memory) are seen by what
+// comes after this.
+void GSGpuRenderer::Impl::barrier()
+{
+    GLbitfield bits = 0u;
+    if (imagesWritten)
+        bits |= GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT |
+                GL_FRAMEBUFFER_BARRIER_BIT;
+    if (memoryWritten)
+        bits |= GL_SHADER_STORAGE_BARRIER_BIT | GL_BUFFER_UPDATE_BARRIER_BIT;
+    if (bits)
+        glMemoryBarrier(bits);
+    imagesWritten = memoryWritten = false;
+}
+
+// The stale cells of a buffer, as local memory holds them.
+void GSGpuRenderer::Impl::ensureLoaded(Target &t)
+{
+    if (!t.anyStale)
+        return;
+    if (batchUses(t) && !vertices.empty())
+    {
+        flushWhy = 8;
+        flush();
+    }
+    msaaResolve(t, 5); // (what the scene drew multisampled goes under the cells first, as the native depth)
+    const bool whole = (t.bp & 31u) != 0u;
+    // The native depth of the rows whose cells are loaded first (what it drew there is in local
+    // memory then, or it is lost under what the cells bring); those rows are the texture's after.
+    std::vector<uint8_t> cellRowLoaded(t.cellsY, uint8_t{0u});
+    for (uint32_t cy = 0; cy < t.cellsY; ++cy)
+        for (uint32_t cx = 0; cx < t.cellsX; ++cx)
+            if (whole || t.staleCells[cy * t.cellsX + cx])
+                cellRowLoaded[cy] = 1u;
+    for (uint32_t cy = 0; cy < t.cellsY;)
+    {
+        if (!cellRowLoaded[cy])
+        {
+            ++cy;
+            continue;
+        }
+        uint32_t end = cy + 1u;
+        while (end < t.cellsY && cellRowLoaded[end])
+            ++end;
+        nativeDepthCurrent(t, 5, cy, end - 1u);
+        cy = end;
+    }
+    const uint32_t perRow = std::max<uint32_t>(1u, (t.bw * 64u) / kKindPageW[t.kind]);
+    PageList pages;
+    if (whole)
+        pages = t.pages;
+    else
+        for (uint32_t cy = 0; cy < t.cellsY; ++cy)
+            for (uint32_t cx = 0; cx < t.cellsX; ++cx)
+                if (t.staleCells[cy * t.cellsX + cx])
+                    pages.push_back(static_cast<uint16_t>(((t.bp >> 5u) + cy * perRow + cx) & (kPages - 1u)));
+    memoryAsker = &t;
+    memoryWhy = "loading";
+    makeMemoryCurrent(pages);
+    memoryAsker = nullptr;
+    memoryWhy = "";
+
+    barrier();
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glViewport(0, 0, viewportX, viewportY);
+    glEnable(GL_SCISSOR_TEST);
+    glUseProgram(loadProgram);
+    glUniform4i(loadLocation, static_cast<GLint>(t.kind), static_cast<GLint>(t.bp), static_cast<GLint>(t.bw), t.sx | (t.sy << 8));
+    glBindImageTexture(0, t.tex, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_R32UI);
+    glBindVertexArray(emptyVao);
+    const int pw = static_cast<int>(kKindPageW[t.kind]), ph = static_cast<int>(kKindPageH[t.kind]);
+    uint64_t rowsLoaded = 0u;
+    timeBegin(2);
+    for (uint32_t cy = 0; cy < t.cellsY; ++cy)
+    {
+        // Runs of stale cells in a row of cells, one rectangle each.
+        for (uint32_t cx = 0; cx < t.cellsX;)
+        {
+            if (!whole && !t.staleCells[cy * t.cellsX + cx])
+            {
+                ++cx;
+                continue;
+            }
+            uint32_t end = cx + 1u;
+            while (end < t.cellsX && (whole || t.staleCells[cy * t.cellsX + end]))
+                ++end;
+            const int x0 = static_cast<int>(cx) * pw;
+            const int x1 = std::min(static_cast<int>(end) * pw, t.width);
+            glScissor(x0 * t.sx, static_cast<int>(cy) * ph * t.sy, (x1 - x0) * t.sx, ph * t.sy);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            rowsLoaded += static_cast<uint64_t>(ph) * static_cast<uint64_t>(x1 - x0) / static_cast<uint64_t>(t.width);
+            cx = end;
+        }
+    }
+    timeEnd();
+    std::fill(t.staleCells.begin(), t.staleCells.end(), uint8_t{0u});
+    t.anyStale = false;
+    std::fill(std::begin(t.shadowValid), std::end(t.shadowValid), false); // (the buffer changed under its field pictures)
+    for (uint32_t cy = 0; cy < t.cellsY && cy < t.depthRows.size(); ++cy)
+        if (cellRowLoaded[cy])
+            t.depthRows[cy] = kDepthTexture; // (and under its native depth)
+    t.depthOldWhy = 1u;
+    t.alphaClock = ++alphaClock;                 // (and its alpha)
+    t.msStale = true;                            // (and its multisampled copy)
+    imagesWritten = true;
+    statLoadRows += rowsLoaded;
+    t.statLoaded += rowsLoaded;
+}
+
+// A copy of a picture of the GPU's (w x h GL pixels) in `copy`, made (again) as big as needed.
+GLuint GSGpuRenderer::Impl::copyInto(GLuint &copy, int &copyW, int &copyH, GLuint source, int w, int h)
+{
+    if (copyW != w || copyH != h)
+    {
+        if (copy)
+            glDeleteTextures(1, &copy);
+        copy = makeTexture(GL_R32UI, w, h, GL_NEAREST);
+        copyW = w;
+        copyH = h;
+    }
+    glMemoryBarrier(GL_ALL_BARRIER_BITS);
+    imagesWritten = memoryWritten = false;
+    glCopyImageSubData(source, GL_TEXTURE_2D, 0, 0, 0, 0, copy, GL_TEXTURE_2D, 0, 0, 0, 0, w, h, 1);
+    ++statFeedback;
+    return copy;
+}
+
+// Draws that sample the buffer they draw into read a copy of it as it was before them.
+GLuint GSGpuRenderer::Impl::feedbackCopy(Target &t)
+{
+    msaaResolve(t, 2);
+    nativeDepthCurrent(t, 2);
+    return copyInto(feedback, feedbackW, feedbackH, t.tex, t.width * t.sx, t.rows * t.sy);
+}
+
+// ---- the native pixel path ----------------------------------------------------------------
+
+// Whether a draw can go the native way (kNativeFragmentMain): a 32- or 24-bit frame, a Z24 or Z32
+// depth buffer or none, no field pictures, no DATE, a failed alpha test that keeps nothing (or that
+// writes less of the frame, for a draw that writes no Z), a
+// frame mask of whole bytes, and a blend whose factors for Cs and Cd stay within 0 to 1 - not -C,
+// not 1 + C - with Ad of a 32-bit frame only where the draw writes no alpha (it is read from a copy
+// of the frame made as the batch is drawn).
+bool GSGpuRenderer::Impl::nativeDraw(const Target &frame, bool usesDepth, Kind depthKind, bool fieldPicture) const
+{
+    const GSContext &ctx = state.context;
+    const uint8_t fpsm = ctx.frame.psm;
+    if (fpsm != GS_PSM_CT32 && fpsm != GS_PSM_CT24)
+        return false;
+    if (usesDepth && depthKind != kZ32)
+        return false;
+    if (!fieldPicture && fields && (frame.shadowed || (state.scanmsk & 3u) >= 2u))
+        return false;
+    if (fieldPicture && (usesDepth || (state.prim.abe && ((ctx.alpha >> 4u) & 3u) == 1u && fpsm == GS_PSM_CT32)))
+        return false; // (a field picture has no depth buffer, nor a copy for Ad)
+    if (((ctx.test >> 14u) & 1u) != 0u && fpsm == GS_PSM_CT32)
+        return false; // DATE
+    if ((ctx.test & 1u) != 0u && ((ctx.test >> 12u) & 3u) != 0u && usesDepth && !ctx.zbuf.zmask)
+        return false; // AFAIL other than KEEP, with Z written (that would be per pixel)
+    for (int k = 0; k < 4; ++k)
+    {
+        const uint32_t byte = (ctx.frame.fbmsk >> (8 * k)) & 0xFFu;
+        if (byte != 0u && byte != 0xFFu)
+            return false;
+    }
+    if (state.prim.abe)
+    {
+        const uint32_t abcd = static_cast<uint32_t>(ctx.alpha & 0xFFu);
+        const uint32_t a = abcd & 3u, b = (abcd >> 2u) & 3u, c = (abcd >> 4u) & 3u, d = (abcd >> 6u) & 3u;
+        if (a == 3u || b == 3u || c == 3u || d == 3u)
+            return false;
+        if (c == 1u && fpsm == GS_PSM_CT32 && (ctx.frame.fbmsk >> 24u) != 0xFFu)
+            return false; // (Ad, and the alpha written: it changes under the draw)
+        for (uint32_t x = 0; x < 2u; ++x) // Cs, Cd
+        {
+            const int coefficient = (a == x ? 1 : 0) - (b == x ? 1 : 0);
+            if (coefficient != 0 && (coefficient > 0) == (d == x))
+                return false; // 1 + C, or -C
+        }
+    }
+    return true;
+}
+
+void GSGpuRenderer::Impl::dropNative(Target &t)
+{
+    msaaDrop(t);
+    if ((t.view && t.view == nativeColorAttached) || (t.nativeDepth && t.nativeDepth == nativeDepthAttached))
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, nativeFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0u, 0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0u, 0);
+        nativeColorAttached = nativeDepthAttached = 0u;
+    }
+    if (alphaCopyOf == &t)
+        alphaCopyOf = nullptr;
+    t.alphaClock = ++alphaClock;
+    if (t.view)
+        glDeleteTextures(1, &t.view);
+    if (t.nativeDepth)
+        glDeleteTextures(1, &t.nativeDepth);
+    if (t.fogIndex)
+        glDeleteTextures(1, &t.fogIndex);
+    t.view = t.nativeDepth = t.fogIndex = 0u;
+    t.fogW = t.fogH = 0;
+    std::fill(t.depthRows.begin(), t.depthRows.end(), uint8_t{kDepthTexture});
+    t.depthOldWhy = 2u;
+}
+
+// (msaaSamples) A moment layer's multisampled colour and/or depth into its textures: the colour
+// the samples' average, the depth one sample (GL_NEAREST: a blit of depth takes one). The colour
+// through a plain RGBA8 texture and a copy of its bytes: a blit into the RGBA8 view of the layer's
+// R32UI texture wrote other values on the user's driver (the whole picture's colours wrong).
+void GSGpuRenderer::Impl::resolveLayer(MomentLayer &layer, bool colour, bool depth)
+{
+    const bool c = colour && layer.msColorNewer, d = depth && layer.msDepthNewer;
+    if (!c && !d)
+        return;
+    const int w = layer.width * layer.sx, h = layer.height * layer.sy;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, layer.msFbo);
+    glDisable(GL_SCISSOR_TEST);
+    if (c)
+    {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, layer.resolveFbo);
+        glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glCopyImageSubData(layer.resolved, GL_TEXTURE_2D, 0, 0, 0, 0, layer.color, GL_TEXTURE_2D, 0, 0, 0, 0, w, h, 1);
+    }
+    if (d)
+    {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, layer.fbo);
+        glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+    }
+    glEnable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+    if (c)
+        layer.msColorNewer = false;
+    if (d)
+        layer.msDepthNewer = false;
+    ++statMsaaResolves;
+}
+
+// A depth buffer's fog index from its native depth (Transformers' depth fog drawn natively,
+// nativeFog): bits 8-15 of each GL pixel's Z in its word's top byte, read as T8H by the fog's draws
+// in place of the buffer the game's shuffle made.
+void GSGpuRenderer::Impl::nativeFogIndex(Target &depth, uint32_t bits)
+{
+    msaaResolve(depth, 9); // (from the native depth: the multisampled depth into it first)
+    const int w = depth.width * depth.sx, h = depth.rows * depth.sy;
+    if (!depth.fogIndex || depth.fogW != w || depth.fogH != h)
+    {
+        if (depth.fogIndex)
+            glDeleteTextures(1, &depth.fogIndex);
+        depth.fogIndex = makeTexture(GL_R32UI, w, h, GL_NEAREST);
+        depth.fogW = w;
+        depth.fogH = h;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, momentFogFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, depth.fogIndex, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glViewport(0, 0, w, h);
+    glUseProgram(momentFogProgram);
+    glUniform1f(momentFogScaleLocation, bits >= 32u ? 4294967296.0f : static_cast<float>(1u << bits));
+    glUniform2i(momentFogPixelLocation, 1, 1);
+    glBindVertexArray(emptyVao);
+    glActiveTexture(GL_TEXTURE20);
+    glBindTexture(GL_TEXTURE_2D, depth.nativeDepth);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindTexture(GL_TEXTURE_2D, 0u);
+    glActiveTexture(GL_TEXTURE0);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0u, 0);
+    glBindVertexArray(vao);
+    glEnable(GL_SCISSOR_TEST);
+    glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+}
+
+// Rows of cells c0 to c1 of a depth buffer in `state`: each run of them drawn by the program bound
+// (the pack or the unpack) through a scissor, and the same after.
+void GSGpuRenderer::Impl::drawDepthRows(Target &t, uint8_t state, uint32_t c0, uint32_t c1)
+{
+    const int ph = static_cast<int>(kKindPageH[t.kind]);
+    const uint32_t last = std::min<uint32_t>(c1, static_cast<uint32_t>(t.depthRows.size()) - 1u);
+    for (uint32_t cy = c0; cy <= last && cy < t.depthRows.size();)
+    {
+        if (t.depthRows[cy] != state)
+        {
+            ++cy;
+            continue;
+        }
+        uint32_t end = cy + 1u;
+        while (end <= last && t.depthRows[end] == state)
+            ++end;
+        glScissor(0, static_cast<int>(cy) * ph * t.sy, t.width * t.sx, static_cast<int>(end - cy) * ph * t.sy);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        for (uint32_t k = cy; k < end; ++k)
+            t.depthRows[k] = kDepthSame;
+        cy = end;
+    }
+}
+
+// Rows y0 to y1 (GS rows) of a depth buffer now newer in `state`'s copy: their rows of cells (all of
+// them for a buffer not on a page's start, which is loaded as one).
+void GSGpuRenderer::Impl::markDepthRows(Target &t, int y0, int y1, uint8_t state)
+{
+    if (t.depthRows.empty())
+        return;
+    const int ph = static_cast<int>(kKindPageH[t.kind]);
+    uint32_t c0 = static_cast<uint32_t>(std::max(y0, 0)) / static_cast<uint32_t>(ph);
+    uint32_t c1 = static_cast<uint32_t>(std::max(y1, 0)) / static_cast<uint32_t>(ph);
+    if ((t.bp & 31u) != 0u)
+    {
+        c0 = 0u;
+        c1 = static_cast<uint32_t>(t.depthRows.size()) - 1u;
+    }
+    for (uint32_t cy = c0; cy <= c1 && cy < t.depthRows.size(); ++cy)
+        t.depthRows[cy] = state;
+}
+
+// A depth buffer's native copy, written by native batches, into its R32UI texture (the value bits):
+// the rows of cells c0 to c1 where it is newer.
+void GSGpuRenderer::Impl::nativeDepthCurrent(Target &t, int why, uint32_t c0, uint32_t c1)
+{
+    msaaResolve(t, 8); // (the scene's multisampled depth into the native depth first)
+    if (!t.nativeDepth || t.depthRows.empty())
+        return;
+    if ((t.bp & 31u) != 0u)
+    {
+        c0 = 0u;
+        c1 = ~0u;
+    }
+    bool any = false;
+    for (uint32_t cy = c0; cy <= c1 && cy < t.depthRows.size(); ++cy)
+        any = any || t.depthRows[cy] == kDepthNative;
+    if (!any)
+        return;
+    ++statPackWhy[why];
+    if (packLogLeft > 0)
+    {
+        --packLogLeft;
+        std::fprintf(stderr, "[gpu:pack] depth %u bw %u rows %d cells %u-%u (why %d) for %s %s%u bw %u kind %d\n", t.bp, t.bw, t.rows, c0,
+                     std::min<uint32_t>(c1, static_cast<uint32_t>(t.depthRows.size()) - 1u), why, memoryWhy, memoryAsker ? "" : "-",
+                     memoryAsker ? memoryAsker->bp : 0u, memoryAsker ? memoryAsker->bw : 0u, memoryAsker ? static_cast<int>(memoryAsker->kind) : -1);
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glViewport(0, 0, viewportX, viewportY);
+    glEnable(GL_SCISSOR_TEST);
+    glUseProgram(packProgram);
+    glUniform1i(packBitsLocation, static_cast<GLint>(t.nativeBits));
+    glBindImageTexture(1, t.tex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, t.nativeDepth);
+    glBindSampler(1, 0u);
+    glActiveTexture(GL_TEXTURE0);
+    glBindVertexArray(emptyVao);
+    timeBegin(3);
+    drawDepthRows(t, kDepthNative, c0, c1);
+    timeEnd();
+    imagesWritten = true;
+    ++statPacks;
+}
+
+// A depth buffer's native copy made (again) from its R32UI texture where that is newer, for a
+// native batch.
+void GSGpuRenderer::Impl::nativeDepthReady(Target &t)
+{
+    const uint32_t bits = batchNativeBits ? batchNativeBits : 24u;
+    if (!t.nativeDepth)
+    {
+        t.nativeDepth = makeTexture(GL_DEPTH_COMPONENT32F, t.width * t.sx, t.rows * t.sy, GL_NEAREST);
+        std::fill(t.depthRows.begin(), t.depthRows.end(), uint8_t{kDepthTexture});
+    }
+    if (t.nativeBits != bits)
+    {
+        nativeDepthCurrent(t, 0); // (held with other bits: through the texture, all of it)
+        std::fill(t.depthRows.begin(), t.depthRows.end(), uint8_t{kDepthTexture});
+    }
+    bool any = false;
+    for (uint8_t row : t.depthRows)
+        any = any || row == kDepthTexture;
+    if (!any)
+        return;
+    ++statUnpackWhy[t.depthOldWhy & 3u];
+    barrier();
+    glBindFramebuffer(GL_FRAMEBUFFER, depthFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, t.nativeDepth, 0);
+    glViewport(0, 0, t.width * t.sx, t.rows * t.sy);
+    glEnable(GL_SCISSOR_TEST);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_ALWAYS);
+    glDepthMask(GL_TRUE);
+    glUseProgram(unpackProgram);
+    glUniform1i(unpackBitsLocation, static_cast<GLint>(bits));
+    glBindImageTexture(1, t.tex, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+    glBindVertexArray(emptyVao);
+    timeBegin(2);
+    drawDepthRows(t, kDepthTexture, 0u, ~0u);
+    timeEnd();
+    glDisable(GL_DEPTH_TEST);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0u, 0);
+    t.nativeBits = bits;
+    ++statUnpacks;
+    t.msStale = true; // (its multisampled copy filled again before it draws)
+}
+
+// ---- multisampling of the scene (PS2X_GPU_MSAA) ------------------------------------------------
+
+// The scene's buffers: a 32- or 24-bit frame and a Z24 or Z32 depth buffer (those the native path
+// draws), not one kept as field pictures (those are the in-between's copies, drawn from the scene).
+bool GSGpuRenderer::Impl::msaaFor(const Target &t) const
+{
+    return sceneMsaa > 1 && !t.shadowed && (t.kind == kC32 || t.kind == kZ32);
+}
+
+void GSGpuRenderer::Impl::msaaEnsure(Target &t)
+{
+    if (t.ms)
+        return;
+    // (a renderbuffer, the depth's too: drawn into as a multisampled texture, 4x took the GPU about
+    // 1.5 ms more a frame at 7x5 - its samples are copied into msDepthSamples when they are read)
+    glGenRenderbuffers(1, &t.ms);
+    glBindRenderbuffer(GL_RENDERBUFFER, t.ms);
+    glRenderbufferStorageMultisample(GL_RENDERBUFFER, sceneMsaa, t.kind == kZ32 ? GL_DEPTH_COMPONENT32F : GL_RGBA8, t.width * t.sx,
+                                     t.rows * t.sy);
+    glBindRenderbuffer(GL_RENDERBUFFER, 0u);
+    t.msNewer = false;
+    t.msStale = true;
+    t.msY0 = t.msOneY0 = 1 << 30;
+    t.msY1 = t.msOneY1 = -1;
+}
+
+// The multisampled copy filled again from the buffer - its texture, or a depth buffer's native
+// depth (which nativeDepthReady has brought up to date): every sample of a GL pixel its value.
+void GSGpuRenderer::Impl::msaaFill(Target &t)
+{
+    if (!t.ms || !t.msStale)
+        return;
+    const bool depth = t.kind == kZ32;
+    if (depth && !t.nativeDepth)
+        return; // (made by nativeDepthReady first)
+    barrier();
+    glBindFramebuffer(GL_FRAMEBUFFER, msOneFbo);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, depth ? 0u : t.ms);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, depth ? t.ms : 0u);
+    glDrawBuffer(depth ? GL_NONE : GL_COLOR_ATTACHMENT0);
+    glViewport(0, 0, t.width * t.sx, t.rows * t.sy);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_BLEND);
+    if (depth)
+    {
+        glEnable(GL_DEPTH_TEST);
+        glDepthFunc(GL_ALWAYS);
+        glDepthMask(GL_TRUE);
+        glActiveTexture(GL_TEXTURE21);
+        glBindTexture(GL_TEXTURE_2D, t.nativeDepth);
+        glBindSampler(21, 0u);
+        glActiveTexture(GL_TEXTURE0);
+    }
+    else
+        glBindImageTexture(1, t.tex, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+    glUseProgram(msFillProgram);
+    glUniform1i(msFillWhatLocation, depth ? 2 : 1);
+    glBindVertexArray(emptyVao);
+    timeBegin(2);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    timeEnd();
+    glDisable(GL_DEPTH_TEST);
+    glEnable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+    t.msStale = false;
+    t.msOneY0 = 1 << 30; // (every sample the buffer's value: one of them is the pixel's)
+    t.msOneY1 = -1;
+    ++statMsFills;
+}
+
+// What only the multisampled copy has (GS rows msY0 to msY1) into the buffer: the colour the samples'
+// average, through a plain RGBA8 texture and a copy of its bytes into the R32UI texture (a blit into
+// its RGBA8 view wrote other values on the user's driver); the depth into the native depth (marked
+// newer than the texture there: packed when something needs it) - one sample a pixel, a blit's, or
+// for a batch that tests against it (`farthest`: the emulated path's, a native one not multisampled)
+// the farthest of each pixel's samples (kMsaaDepthResolve), again over rows handed back as one
+// sample. The game's every depth test is GEQUAL: one sample is nearer than the pixel's middle on half
+// of a surface's slopes, and the same mesh drawn again there - the warp gate tunnel's subtractive
+// pass, which the GPU's blend cannot do - failed (its dark middle gone on a straight-edged wedge);
+// the farthest is never nearer, within a surface or where two of a mesh's triangles meet.
+void GSGpuRenderer::Impl::msaaResolve(Target &t, int why, bool farthest)
+{
+    if (!t.ms)
+        return;
+    const bool depth = t.kind == kZ32;
+    const bool again = depth && farthest && !t.msStale && t.msOneY1 >= 0; // (the copy still the buffer's)
+    if (!t.msNewer && !again)
+        return;
+    int y0 = t.msNewer ? t.msY0 : 1 << 30, y1 = t.msNewer ? t.msY1 : -1;
+    if (again)
+    {
+        y0 = std::min(y0, t.msOneY0);
+        y1 = std::max(y1, t.msOneY1);
+    }
+    const int w = t.width * t.sx, h = t.rows * t.sy;
+    const int gy0 = std::max(0, y0) * t.sy, gy1 = std::min(h, (std::min(t.rows - 1, y1) + 1) * t.sy);
+    if (gy1 > gy0 && depth && t.nativeDepth && farthest)
+    {
+        // (the renderbuffer's samples copied into a texture to be read)
+        if (!msDepthSamples || msDepthSamplesW < w || msDepthSamplesH < h)
+        {
+            // (GL 3.2's call: the loader, run for raylib's 3.3 context, has later ones only through
+            // the extensions it lists - glTexStorage2DMultisample is not among them)
+            if (msDepthSamples)
+                glDeleteTextures(1, &msDepthSamples);
+            msDepthSamplesW = std::max(msDepthSamplesW, w);
+            msDepthSamplesH = std::max(msDepthSamplesH, h);
+            glGenTextures(1, &msDepthSamples);
+            glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, msDepthSamples);
+            glTexImage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, sceneMsaa, GL_DEPTH_COMPONENT32F, msDepthSamplesW, msDepthSamplesH, GL_TRUE);
+            glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 0u);
+        }
+        glCopyImageSubData(t.ms, GL_RENDERBUFFER, 0, 0, gy0, 0, msDepthSamples, GL_TEXTURE_2D_MULTISAMPLE, 0, 0, gy0, 0, w, gy1 - gy0, 1);
+        // (its rows by the viewport: the pass's pixels are the buffer's own; what the callers set
+        // themselves - the viewport, the program - as they had them after)
+        GLint viewport[4] = {}, program = 0;
+        glGetIntegerv(GL_VIEWPORT, viewport);
+        glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        glBindFramebuffer(GL_FRAMEBUFFER, depthFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, t.nativeDepth, 0);
+        glViewport(0, gy0, w, gy1 - gy0);
+        glDisable(GL_SCISSOR_TEST);
+        glEnable(GL_DEPTH_TEST);
+        glDepthFunc(GL_ALWAYS);
+        glDepthMask(GL_TRUE);
+        glUseProgram(msDepthResolveProgram);
+        glUniform1i(msDepthResolveSamplesLocation, sceneMsaa);
+        glActiveTexture(GL_TEXTURE22);
+        glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, msDepthSamples);
+        glActiveTexture(GL_TEXTURE0);
+        glBindVertexArray(emptyVao);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glBindVertexArray(vao);
+        glDisable(GL_DEPTH_TEST);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0u, 0);
+        glEnable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+        glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+        glUseProgram(static_cast<GLuint>(program));
+        markDepthRows(t, y0, y1, kDepthNative);
+        t.msOneY0 = 1 << 30;
+        t.msOneY1 = -1;
+        ++statMsFarthest;
+    }
+    else if (gy1 > gy0 && depth && t.nativeDepth)
+    {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, msOneFbo);
+        glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 0u);
+        glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, t.ms);
+        glReadBuffer(GL_NONE);
+        glDisable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, depthFbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, t.nativeDepth, 0);
+        glBlitFramebuffer(0, gy0, w, gy1, 0, gy0, w, gy1, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0u, 0);
+        glEnable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+        markDepthRows(t, y0, y1, kDepthNative);
+        t.msOneY0 = std::min(t.msOneY0, y0);
+        t.msOneY1 = std::max(t.msOneY1, y1);
+    }
+    else if (gy1 > gy0 && !depth)
+    {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, msOneFbo);
+        glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, t.ms);
+        glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, 0u);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glDisable(GL_SCISSOR_TEST);
+        if (!msResolveTex || msResolveW < w || msResolveH < h)
+        {
+            if (msResolveTex)
+                glDeleteTextures(1, &msResolveTex);
+            msResolveW = std::max(msResolveW, w);
+            msResolveH = std::max(msResolveH, h);
+            msResolveTex = makeTexture(GL_RGBA8, msResolveW, msResolveH, GL_NEAREST);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, msResolveFbo);
+            glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, msResolveTex, 0);
+        }
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, msResolveFbo);
+        glDrawBuffer(GL_COLOR_ATTACHMENT0);
+        glBlitFramebuffer(0, gy0, w, gy1, 0, gy0, w, gy1, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        barrier(); // (image stores into the texture finished before the copy over them)
+        glCopyImageSubData(msResolveTex, GL_TEXTURE_2D, 0, 0, gy0, 0, t.tex, GL_TEXTURE_2D, 0, 0, gy0, 0, w, gy1 - gy0, 1);
+        glEnable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+    }
+    t.msNewer = false;
+    t.msY0 = 1 << 30;
+    t.msY1 = -1;
+    ++statMsaaResolveWhy[std::clamp(why, 0, 11)];
+}
+
+void GSGpuRenderer::Impl::msaaDrop(Target &t)
+{
+    if (!t.ms)
+        return;
+    const bool depth = t.kind == kZ32;
+    if (t.ms == (depth ? msDepthAttached : msColorAttached))
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, msFbo);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 0u);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, 0u);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+        msColorAttached = msDepthAttached = 0u;
+    }
+    glDeleteRenderbuffers(1, &t.ms);
+    t.ms = 0u;
+    t.msNewer = false;
+    t.msStale = true;
+    t.msY0 = t.msOneY0 = 1 << 30;
+    t.msY1 = t.msOneY1 = -1;
+}
+
+// A field picture of a buffer, ready to be drawn into: made from the buffer as it is when it
+// has none yet or the buffer changed under it.
+void GSGpuRenderer::Impl::ensureShadow(Target &t, int k)
+{
+    if (!t.shadow[k])
+    {
+        t.shadow[k] = makeTexture(GL_R32UI, t.width * t.sx, t.rows * t.sy, GL_NEAREST);
+        t.shadowValid[k] = false;
+    }
+    if (t.shadowValid[k])
+        return;
+    if (!vertices.empty())
+    {
+        flushWhy = 6;
+        flush(); // (what is queued for the buffer is in the copy)
+    }
+    msaaResolve(t, 7);
+    glMemoryBarrier(GL_ALL_BARRIER_BITS);
+    imagesWritten = memoryWritten = false;
+    glCopyImageSubData(t.tex, GL_TEXTURE_2D, 0, 0, 0, 0, t.shadow[k], GL_TEXTURE_2D, 0, 0, 0, 0, t.width * t.sx, t.rows * t.sy, 1);
+    t.shadowValid[k] = true;
+}
+
+void GSGpuRenderer::Impl::dropShadows(Target &t)
+{
+    for (int k = 0; k < kShadows; ++k)
+    {
+        if (t.shadowView[k])
+            glDeleteTextures(1, &t.shadowView[k]);
+        t.shadowView[k] = 0u;
+        if (t.shadow[k])
+            glDeleteTextures(1, &t.shadow[k]);
+        t.shadow[k] = 0u;
+        t.shadowValid[k] = false;
+    }
+}
+
+uint32_t GSGpuRenderer::Impl::sourceSlot(GLuint texture, int width, int height, int sx, int sy, GLuint view)
+{
+    for (uint32_t i = 0; i < sourceCount; ++i)
+        if (sources[i] == texture)
+            return i;
+    if (sourceCount == sources.size())
+    {
+        flushWhy = 3;
+        flush();
+    }
+    sources[sourceCount] = texture;
+    sourceViews[sourceCount] = view;
+    sourceSizes[2u * sourceCount] = width;
+    sourceSizes[2u * sourceCount + 1u] = height;
+    sourceScales[2u * sourceCount] = sx;
+    sourceScales[2u * sourceCount + 1u] = sy;
+    return sourceCount++;
+}
+
+// A texture read from local memory: the GPU's copy of its pages is brought up to date.
+void GSGpuRenderer::Impl::memoryTexture(uint32_t tbp, uint32_t tbw, Kind kind, int width, int height)
+{
+    const uint32_t key[5] = {tbp, tbw, static_cast<uint32_t>(kind), static_cast<uint32_t>(width), static_cast<uint32_t>(height)};
+    if (checkedEpoch == memoryEpoch && std::memcmp(key, checkedKey, sizeof(key)) == 0)
+        return;
+    PageList &pages = memoryPages;
+    pages.clear();
+    pagesOf(pages, tbp, tbw, kind, 0, 0, width - 1, height - 1);
+    bool drawnHere = false, stale = false;
+    for (uint16_t page : pages)
+    {
+        drawnHere = drawnHere || framePages.test(page) || (batchZWrite && depthPages.test(page));
+        stale = stale || hostNewer[page] != 0u || owner[page] != nullptr;
+    }
+    // The draws before must see local memory as it was, and this one what they drew.
+    if ((drawnHere || stale) && !vertices.empty())
+    {
+        flushWhy = 4;
+        flush();
+    }
+    makeMemoryCurrent(pages);
+    checkedEpoch = memoryEpoch;
+    std::memcpy(checkedKey, key, sizeof(key));
+}
+
+void GSGpuRenderer::Impl::extendBatch(int x0, int y0, int x1, int y1, bool zwrite)
+{
+    const bool inside = x0 >= rect[0] && y0 >= rect[1] && x1 <= rect[2] && y1 <= rect[3];
+    if (!inside)
+    {
+        rect[0] = std::min(rect[0], x0);
+        rect[1] = std::min(rect[1], y0);
+        rect[2] = std::max(rect[2], x1);
+        rect[3] = std::max(rect[3], y1);
+    }
+    if (!inside || (zwrite && !batchZWrite))
+    {
+        batchZWrite = batchZWrite || zwrite;
+        PageList &pages = batchPages;
+        pages.clear();
+        framePages.reset();
+        pagesOf(pages, batchFrame->bp, batchFrame->bw, batchFrame->kind, rect[0], rect[1], rect[2], rect[3]);
+        for (uint16_t page : pages)
+            framePages.set(page);
+        depthPages.reset();
+        if (batchDepth && batchZWrite)
+        {
+            pages.clear();
+            pagesOf(pages, batchDepth->bp, batchDepth->bw, batchDepth->kind, rect[0], rect[1], rect[2], rect[3]);
+            for (uint16_t page : pages)
+                depthPages.set(page);
+        }
+    }
+}
+
+// ---- texture packs ---------------------------------------------------------------------------
+
+// PCSX2's GSClut::Read32: the colours a texture's indices select, as RGBA8 (16-bit ones expanded
+// with TEXA), the order its CLUT hash is taken in.
+void GSGpuRenderer::Impl::paletteColours(const GSTex0Reg &tex0, const GSTexaReg &texa, uint32_t *out, uint32_t count) const
+{
+    const bool sixteen = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        if (sixteen)
+        {
+            const uint32_t c = clut[((static_cast<uint32_t>(tex0.csa) << 4u) + i) & 511u];
+            const uint32_t rgb = ((c << 3) & 0xF8u) | ((c << 6) & 0xF800u) | ((c << 9) & 0xF80000u);
+            uint32_t a = (c & 0x8000u) ? texa.ta1 : texa.ta0;
+            if (texa.aem && c == 0u)
+                a = 0u;
+            out[i] = rgb | (a << 24);
+            continue;
+        }
+        const uint32_t base = (static_cast<uint32_t>(tex0.csa) & 15u) << 4u;
+        const uint32_t ci = count == 256u ? std::min((i & 0xF0u) + base, 240u) + (i & 0x0Fu) : base + i;
+        out[i] = clut[ci] | (static_cast<uint32_t>(clut[ci + 256u]) << 16u);
+    }
+}
+
+// The texture pack's replacement for a texture read from local memory: the slot (5 to 8) it is
+// bound to for the batch, or 0 when the pack has none. Hashed as PCSX2 hashes it, again only when
+// the texture's pages have changed.
+uint32_t GSGpuRenderer::Impl::replacementSlot(const GSTex0Reg &tex0, const GSTexaReg &texa, uint8_t wrapU, uint8_t wrapV, bool linear,
+                                              bool decode)
+{
+    const uint32_t key[12] = {tex0.tbp0, tex0.tbw, tex0.psm, tex0.tw, tex0.th, tex0.cpsm | (static_cast<uint32_t>(tex0.csm) << 8u), tex0.csa,
+                              texa.ta0, texa.ta1, texa.aem ? 1u : 0u, static_cast<uint32_t>(wrapU) | (static_cast<uint32_t>(wrapV) << 8u),
+                              (linear ? 1u : 0u) | (decode ? 2u : 0u)};
+    ReplacementMemo &memo = replacementMemo;
+    if (replacementMemoMode == 0)
+        return replacementSlotUncached(tex0, texa, wrapU, wrapV, linear, decode);
+    if (memo.valid && memo.writeClock == writeClock && memo.clutVersion == clutVersion && memo.flushSerial == flushSerial &&
+        std::memcmp(memo.key, key, sizeof(key)) == 0)
+    {
+        if (replacementMemoMode == 2)
+        {
+            ++statMemoChecked;
+            const uint32_t full = replacementSlotUncached(tex0, texa, wrapU, wrapV, linear, decode);
+            if (full != memo.slot && statMemoDiffering++ < 20u)
+                std::fprintf(stderr, "[gpu] pack memo: tbp %u psm %u gave %u, the full lookup %u\n", tex0.tbp0, tex0.psm, memo.slot, full);
+            if (memo.flushSerial != flushSerial)
+                memo.valid = false; // (the full lookup flushed: it would only differ more)
+            return full;
+        }
+        return memo.slot;
+    }
+    const uint32_t slot = replacementSlotUncached(tex0, texa, wrapU, wrapV, linear, decode);
+    memo.valid = true;
+    memo.writeClock = writeClock;
+    memo.clutVersion = clutVersion;
+    memo.flushSerial = flushSerial; // (after the call: it may have flushed, the slot is the new batch's)
+    std::memcpy(memo.key, key, sizeof(key));
+    memo.slot = slot;
+    return slot;
+}
+
+uint32_t GSGpuRenderer::Impl::replacementSlotUncached(const GSTex0Reg &tex0, const GSTexaReg &texa, uint8_t wrapU, uint8_t wrapV, bool linear,
+                                                      bool decode)
+{
+    if (tex0.tw > 10u || tex0.th > 10u || (!packOpen && !decode))
+        return 0u;
+    const Kind kind = kindOf(tex0.psm);
+    if (kind == kNoKind)
+        return 0u;
+    const uint32_t tw = 1u << tex0.tw, th = 1u << tex0.th;
+    const uint32_t tbw = std::max<uint32_t>(tex0.tbw, 1u);
+
+    // Textures the game uploaded only: not pictures the GS drew (and whose newest content the
+    // GPU may hold alone).
+    PageList &pages = replacementPages;
+    pages.clear();
+    pagesOf(pages, tex0.tbp0, tbw, kind, 0, 0, static_cast<int>(tw) - 1, static_cast<int>(th) - 1);
+    uint64_t written = 0u;
+    for (uint16_t page : pages)
+    {
+        if (pageDrawn[page])
+            return 0u;
+        written = std::max(written, pageWritten[page]);
+    }
+    const uint32_t bits = gs_texture_pack::nameBits(tex0.psm, tex0.tw, tex0.th, texa);
+    const uint64_t key = static_cast<uint64_t>(tex0.tbp0) | (static_cast<uint64_t>(tex0.tbw & 63u) << 14u) |
+                         (static_cast<uint64_t>(bits) << 20u);
+    PackHash &cached = packHashes[key];
+    if (cached.epoch == 0u || cached.epoch < written)
+    {
+        cached.hash = gs_texture_pack::hashTexture(vram, tex0.tbp0, tex0.tbw, tex0.psm, tw, th, texa);
+        cached.epoch = writeClock;
+        ++statPackHashes;
+    }
+
+    uint64_t clutHash = 0u;
+    if (isIndexed(tex0.psm))
+    {
+        const uint32_t count = isIndexed4(tex0.psm) ? 16u : 256u;
+        const bool sixteen = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+        const uint32_t texaBits = sixteen ? (texa.ta0 | (texa.aem ? 0x100u : 0u) | (static_cast<uint32_t>(texa.ta1) << 9u)) : 0u;
+        PackClut &c = packClut;
+        if (c.version != clutVersion || c.count != count || c.cpsm != tex0.cpsm || c.csa != tex0.csa || c.texaBits != texaBits)
+        {
+            uint32_t colours[256];
+            paletteColours(tex0, texa, colours, count);
+            c.hash = gs_texture_pack::hashPalette(colours, count);
+            c.version = clutVersion;
+            c.count = count;
+            c.cpsm = tex0.cpsm;
+            c.csa = tex0.csa;
+            c.texaBits = texaBits;
+        }
+        clutHash = c.hash;
+    }
+
+    gs_texture_pack::Texture *texture = packOpen ? pack.find({cached.hash, clutHash, bits}) : nullptr;
+    if (packLog)
+    {
+        const uint64_t logKey = cached.hash ^ (clutHash * 0x9E3779B97F4A7C15ull) ^ bits;
+        if (packLogged.emplace(logKey, true).second)
+            std::fprintf(stderr, "[gpu] texture %llx-%llx-%08x (tbp %u tbw %u psm %u %ux%u): %s\n",
+                         static_cast<unsigned long long>(cached.hash), static_cast<unsigned long long>(clutHash), bits, tex0.tbp0,
+                         tex0.tbw, tex0.psm, tw, th, texture ? "replaced" : "-");
+    }
+    if (!texture)
+    {
+        // (the cache's, when the native path draws it)
+        const GLuint decoded = decode ? decodedTexture(tex0, texa, cached.hash) : 0u;
+        return decoded ? replacementBound(decoded, wrapU, wrapV, linear, true) : 0u;
+    }
+    if (!texture->glTexture)
+    {
+        // Made on first use: its levels as the file has them; the CPU's copy is dropped.
+        GLuint id = 0u;
+        glGenTextures(1, &id);
+        glBindTexture(GL_TEXTURE_2D, id);
+        const GLsizei levels = static_cast<GLsizei>(texture->levelSize.size());
+        glTexStorage2D(GL_TEXTURE_2D, levels, texture->glFormat, static_cast<GLsizei>(texture->width), static_cast<GLsizei>(texture->height));
+        for (GLsizei level = 0; level < levels; ++level)
+        {
+            const uint8_t *data = texture->data.data() + texture->levelOffset[level];
+            const GLsizei w = static_cast<GLsizei>(texture->levelWidth[level]), h = static_cast<GLsizei>(texture->levelHeight[level]);
+            if (texture->compressed)
+                glCompressedTexSubImage2D(GL_TEXTURE_2D, level, 0, 0, w, h, texture->glFormat, static_cast<GLsizei>(texture->levelSize[level]), data);
+            else
+                glTexSubImage2D(GL_TEXTURE_2D, level, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, data);
+        }
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, levels - 1);
+        texture->glTexture = id;
+        std::vector<uint8_t>().swap(texture->data);
+    }
+    ++statPackDraws;
+    return replacementBound(texture->glTexture, wrapU, wrapV, linear);
+}
+
+// A replacement's slot in the batch (5 on), with the sampler of its wrapping and filtering: the one
+// it has there already, or a new one (the batch ended first when they are all taken).
+uint32_t GSGpuRenderer::Impl::replacementBound(GLuint texture, uint8_t wrapU, uint8_t wrapV, bool linear, bool decoded)
+{
+    const GLuint sampler = (decoded ? decodedSamplers : packSamplers)[(wrapU & 1u) | ((wrapV & 1u) << 1u) | (linear ? 4u : 0u)];
+    for (uint32_t i = 0; i < replaceCount; ++i)
+        if (replaceSlots[i].texture == texture && replaceSlots[i].sampler == sampler)
+            return 5u + i;
+    if (replaceCount == replaceSlots.size())
+    {
+        flushWhy = 2;
+        flush();
+    }
+    replaceSlots[replaceCount] = {texture, sampler};
+    return 5u + replaceCount++;
+}
+
+// kMemory's lookupClut: the colour of a CLUT index as the GS reads it (CSM1's 8-bit order, CSA, the
+// 16-bit entries' TEXA, a CT24 CLUT's).
+uint32_t GSGpuRenderer::Impl::clutColour(const GSTex0Reg &tex0, const GSTexaReg &texa, uint32_t index, bool fourBit) const
+{
+    const auto expand5551 = [](uint32_t c)
+    { return ((c & 0x1Fu) << 3) | (((c >> 5) & 0x1Fu) << 11) | (((c >> 10) & 0x1Fu) << 19) | (((c >> 15) & 1u) << 31); };
+    const auto applyTexa = [&](uint32_t c, uint32_t bits)
+    {
+        const bool rgbZero = (c & 0x00FFFFFFu) == 0u;
+        uint32_t a;
+        if (bits == 24u)
+            a = (texa.aem && rgbZero) ? 0u : texa.ta0;
+        else
+            a = (c & 0x80000000u) != 0u ? texa.ta1 : ((texa.aem && rgbZero) ? 0u : texa.ta0);
+        return (c & 0x00FFFFFFu) | (a << 24);
+    };
+    const uint32_t cpsm = tex0.cpsm;
+    const bool sixteen = cpsm == GS_PSM_CT16 || cpsm == GS_PSM_CT16S;
+    const uint32_t base = (static_cast<uint32_t>(tex0.csa) & (sixteen ? 0x1Fu : 0x0Fu)) << 4u;
+    const uint32_t source = fourBit ? (index & 0xFu) : index;
+    uint32_t ci = (base + source) & (sixteen ? 0x1FFu : 0xFFu);
+    if (!sixteen && tex0.csm == 0u && !fourBit)
+        ci = std::min((source & 0xF0u) + base, 240u) + (source & 0xFu);
+    if (sixteen)
+        return applyTexa(expand5551(clut[ci & 511u]), 16u);
+    const uint32_t raw = clut[ci & 511u] | (static_cast<uint32_t>(clut[(ci + 256u) & 511u]) << 16u);
+    return cpsm == GS_PSM_CT24 ? applyTexa(raw, 24u) : raw;
+}
+
+// The cache's texture for a texture in local memory (its memory's hash given): found, or decoded as
+// kMemory's texel() reads it and made; 0 for a format it does not take (a depth buffer's).
+GLuint GSGpuRenderer::Impl::decodedTexture(const GSTex0Reg &tex0, const GSTexaReg &texa, uint64_t memoryHash)
+{
+    const uint8_t psm = tex0.psm;
+    const bool indexed = psm == GS_PSM_T8 || psm == GS_PSM_T4 || psm == GS_PSM_T8H || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+    if (!indexed && psm != GS_PSM_CT32 && psm != GS_PSM_CT24 && psm != GS_PSM_CT16 && psm != GS_PSM_CT16S)
+        return 0u;
+    const bool fourBit = psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+    // (its colours: the CLUT's as read for it, or TEXA's part in a 24- or 16-bit texel)
+    uint32_t colours[256];
+    uint64_t key = memoryHash ^ (static_cast<uint64_t>(psm) << 56) ^ (static_cast<uint64_t>(tex0.tw) << 48) ^ (static_cast<uint64_t>(tex0.th) << 44);
+    if (indexed)
+    {
+        const uint32_t count = fourBit ? 16u : 256u;
+        for (uint32_t i = 0; i < count; ++i)
+            colours[i] = clutColour(tex0, texa, i, fourBit);
+        key ^= gs_texture_pack::hashPalette(colours, count) * 0x9E3779B97F4A7C15ull;
+    }
+    else if (psm != GS_PSM_CT32)
+        key ^= (static_cast<uint64_t>(texa.ta0) | (static_cast<uint64_t>(texa.ta1) << 8u) | (texa.aem ? 0x10000ull : 0u)) * 0xC2B2AE3D27D4EB4Full;
+    auto found = decodedTextures.find(key);
+    if (found != decodedTextures.end())
+    {
+        found->second.lastUse = flushSerial;
+        ++statDecodeHits;
+        return found->second.texture;
+    }
+    // (decoded from the CPU's copy of local memory, which is the GS's as this draw comes)
+    const uint32_t tw = 1u << tex0.tw, th = 1u << tex0.th;
+    const uint32_t tbw = std::max<uint32_t>(tex0.tbw, 1u);
+    decodeScratch.resize(static_cast<size_t>(tw) * th);
+    const auto read32 = [&](uint32_t address)
+    {
+        uint32_t v;
+        std::memcpy(&v, vram + (address & 0x3FFFFCu), 4u);
+        return v;
+    };
+    const auto expand5551 = [](uint32_t c)
+    { return ((c & 0x1Fu) << 3) | (((c >> 5) & 0x1Fu) << 11) | (((c >> 10) & 0x1Fu) << 19) | (((c >> 15) & 1u) << 31); };
+    const auto applyTexa = [&](uint32_t c, uint32_t bits)
+    {
+        const bool rgbZero = (c & 0x00FFFFFFu) == 0u;
+        uint32_t a;
+        if (bits == 24u)
+            a = (texa.aem && rgbZero) ? 0u : texa.ta0;
+        else
+            a = (c & 0x80000000u) != 0u ? texa.ta1 : ((texa.aem && rgbZero) ? 0u : texa.ta0);
+        return (c & 0x00FFFFFFu) | (a << 24);
+    };
+    for (uint32_t y = 0; y < th; ++y)
+    {
+        uint32_t *row = decodeScratch.data() + static_cast<size_t>(y) * tw;
+        for (uint32_t x = 0; x < tw; ++x)
+        {
+            uint32_t c = 0u;
+            switch (psm)
+            {
+            case GS_PSM_CT32:
+                c = read32(GSPSMCT32::addrPSMCT32(tex0.tbp0, tbw, x, y));
+                break;
+            case GS_PSM_CT24:
+                c = applyTexa(read32(GSPSMCT32::addrPSMCT32(tex0.tbp0, tbw, x, y)), 24u);
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            {
+                const uint32_t address = (psm == GS_PSM_CT16 ? GSPSMCT16::addrPSMCT16(tex0.tbp0, tbw, x, y)
+                                                             : GSPSMCT16::addrPSMCT16S(tex0.tbp0, tbw, x, y)) & 0x3FFFFEu;
+                c = applyTexa(expand5551(static_cast<uint32_t>(vram[address]) | (static_cast<uint32_t>(vram[address + 1u]) << 8u)), 16u);
+                break;
+            }
+            case GS_PSM_T8:
+                c = colours[vram[GSPSMT8::addrPSMT8(tex0.tbp0, tbw, x, y) & 0x3FFFFFu]];
+                break;
+            case GS_PSM_T4:
+            {
+                const uint32_t nibble = GSPSMT4::addrPSMT4(tex0.tbp0, tbw, x, y) & 0x7FFFFFu;
+                c = colours[(vram[nibble >> 1u] >> ((nibble & 1u) * 4u)) & 0xFu];
+                break;
+            }
+            case GS_PSM_T8H:
+                c = colours[read32(GSPSMCT32::addrPSMCT32(tex0.tbp0, tbw, x, y)) >> 24];
+                break;
+            case GS_PSM_T4HL:
+                c = colours[(read32(GSPSMCT32::addrPSMCT32(tex0.tbp0, tbw, x, y)) >> 24) & 0xFu];
+                break;
+            default: // GS_PSM_T4HH
+                c = colours[read32(GSPSMCT32::addrPSMCT32(tex0.tbp0, tbw, x, y)) >> 28];
+                break;
+            }
+            row[x] = c;
+        }
+    }
+    // (the least used go first once there are too many - not one the batch being made has)
+    if (decodedTextures.size() >= kDecodedMost)
+    {
+        std::vector<std::pair<uint64_t, uint64_t>> ages;
+        ages.reserve(decodedTextures.size());
+        for (const auto &entry : decodedTextures)
+            if (entry.second.lastUse != flushSerial)
+                ages.emplace_back(entry.second.lastUse, entry.first);
+        const size_t drop = std::min(ages.size(), kDecodedMost / 4u);
+        std::nth_element(ages.begin(), ages.begin() + static_cast<std::ptrdiff_t>(drop), ages.end());
+        for (size_t i = 0; i < drop; ++i)
+        {
+            auto it = decodedTextures.find(ages[i].second);
+            glDeleteTextures(1, &it->second.texture);
+            decodedTextures.erase(it);
+            ++statDecodeDropped;
+        }
+    }
+    GLuint id = 0u;
+    glGenTextures(1, &id);
+    glBindTexture(GL_TEXTURE_2D, id);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, static_cast<GLsizei>(tw), static_cast<GLsizei>(th));
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, static_cast<GLsizei>(tw), static_cast<GLsizei>(th), GL_RGBA, GL_UNSIGNED_BYTE, decodeScratch.data());
+    glBindTexture(GL_TEXTURE_2D, 0u);
+    decodedTextures[key] = {id, flushSerial};
+    ++statDecodeMade;
+    return id;
+}
+
+// ---- drawing -----------------------------------------------------------------------------------
+
+// The current draw state becomes an entry of the batch (flushing the batch first when the draw
+// cannot join it).
+void GSGpuRenderer::Impl::prepareDraw()
+{
+    drawUsable = false;
+    struct Done
+    {
+        Impl &r;
+        ~Done() { r.stateDirty = false; }
+    } done{*this};
+
+    const GSContext &ctx = state.context;
+    const uint8_t fpsm = ctx.frame.psm;
+    const Kind frameKind = kindOf(fpsm);
+    if (!isBufferKind(frameKind))
+        return;
+    const uint32_t ztst = static_cast<uint32_t>((ctx.test >> 17u) & 0x3u);
+    if (ztst == 0u)
+        return; // NEVER
+    // Transformers' depth shuffle while its fog is drawn natively (nativeFog): a depth buffer
+    // drawn through a depth format's view while it reads its own block (bits 8-15 of each Z into
+    // the word's top byte, which only the fog reads, and the fog reads the native depth's fog index
+    // instead) is not drawn - the depth no longer goes through local memory there and back, a GS
+    // pixel a value (blocky at a high scale: a rough light line round what stands before the
+    // fogged distance), nor is it packed for it.
+    // (its texture anywhere in the buffer the frame's scissor covers: the shuffle's halves read
+    // from two bases, 7168 and 8960 for the buffer at 7168)
+    if (nativeEnabled && nativeFog && (frameKind == kZ32 || frameKind == kZ16 || frameKind == kZ16S) && state.prim.tme)
+    {
+        const uint32_t frameBlock = ctx.frame.fbp * 32u;
+        const uint32_t pageRows = (static_cast<uint32_t>(ctx.scissor.y1) + kKindPageH[frameKind]) / kKindPageH[frameKind];
+        const uint32_t frameBlocks = std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u / kKindPageW[frameKind] * pageRows * 32u;
+        if (ctx.tex0.tbp0 >= frameBlock && ctx.tex0.tbp0 < frameBlock + frameBlocks)
+        {
+            ++statFogShufflesLeftOut;
+            return;
+        }
+    }
+    const bool zwrite = !ctx.zbuf.zmask;
+    const Kind depthKind = kindOf(ctx.zbuf.psm);
+    const bool depthPsm = depthKind == kZ32 || depthKind == kZ16 || depthKind == kZ16S;
+    const bool usesDepth = ztst >= 2u || zwrite;
+    if (usesDepth && !depthPsm)
+        return;
