+    {
+        uint64_t epoch = 0u; // writeClock when hashed
+        uint64_t hash = 0u;
+    };
+    std::unordered_map<uint64_t, PackHash> packHashes; // by base, width and name bits
+    struct PackClut
+    {
+        uint64_t version = 0u;
+        uint32_t count = 0u, cpsm = 0u, csa = 0u, texaBits = 0u;
+        uint64_t hash = 0u;
+    } packClut;
+    std::unordered_map<uint64_t, bool> packLogged;
+    std::array<uint64_t, kPages> pageWritten{}; // writeClock of a page's last change
+    std::array<uint8_t, kPages> pageDrawn{};    // drawn since the EE last wrote it
+    uint64_t writeClock = 1u;
+    uint64_t flushSerial = 0u;              // flush() calls: the batch a replacement slot belongs to
+    PageList replacementPages, memoryPages, batchPages, drawnPages; // (scratch: kept to spare an allocation a call)
+    // The last replacementSlot answer, for the same texture asked again before anything it
+    // depends on changes: no page written or drawn (writeClock), the same CLUT (clutVersion), the
+    // same batch (its slots). Its inputs as they are read.
+    // PS2X_GPU_PACK_MEMO: 0 off, 1 on (the default), 2 on and each answer it gives checked against
+    // the full lookup.
+    int replacementMemoMode = 1;
+    uint64_t statMemoChecked = 0u, statMemoDiffering = 0u;
+    struct ReplacementMemo
+    {
+        bool valid = false;
+        uint64_t writeClock = 0u, clutVersion = 0u, flushSerial = 0u;
+        uint32_t key[12] = {};
+        uint32_t slot = 0u;
+    } replacementMemo;
+    uint32_t replacementSlotUncached(const GSTex0Reg &tex0, const GSTexaReg &texa, uint8_t wrapU, uint8_t wrapV, bool linear, bool decode);
+    std::array<GLuint, 8> packSamplers{};       // by wrap U, wrap V (repeat / clamp) and filtering
+    std::array<GLuint, 8> decodedSamplers{};    // ... the cache's: one sample, as the GS takes (no anisotropy)
+    GLuint packDummy = 0u;
+    struct ReplaceSlot
+    {
+        GLuint texture = 0u;
+        GLuint sampler = 0u;
+    };
+    std::array<ReplaceSlot, 16> replaceSlots{}; // (a batch's replacements: more of them, fewer batches)
+    uint32_t replaceCount = 0u;
+    uint64_t statPackHashes = 0u, statPackDraws = 0u;
+    uint32_t replacementSlot(const GSTex0Reg &tex0, const GSTexaReg &texa, uint8_t wrapU, uint8_t wrapV, bool linear, bool decode);
+    uint32_t replacementBound(GLuint texture, uint8_t wrapU, uint8_t wrapV, bool linear, bool decoded = false);
+
+    // ---- the texture cache (PS2X_GPU_TEXTURE_CACHE=1, with the native path) ----
+    // A texture read from local memory that the pack has nothing for, decoded once into an RGBA8
+    // texture of its own - its texels as the GS has them (kMemory's texel(): the CLUT as the GS reads
+    // it, TEXA) - found again by PCSX2's hash of its memory (as the pack's are) and the colours it
+    // takes from the CLUT, and sampled by the native path as a replacement is: the texture unit's
+    // filtering instead of four reads of local memory a pixel, and no batch ended where the game
+    // wrote the texture's pages since (the native path's cost without a pack: about three times a
+    // moment's with one). The game streams its textures through local memory every frame: found
+    // again each frame, decoded when new. Not exact (the unit's filtering), so not for the emulated
+    // path, and off until compared and agreed.
+    bool textureCache = false;
+    bool replacements = false; // (packOpen || textureCache: the slots and their samplers)
+    struct DecodedTexture
+    {
+        GLuint texture = 0u;
+        uint64_t lastUse = 0u; // (flushSerial)
+    };
+    std::unordered_map<uint64_t, DecodedTexture> decodedTextures;
+    std::vector<uint32_t> decodeScratch;
+    static constexpr size_t kDecodedMost = 3072u;
+    uint64_t statDecodeHits = 0u, statDecodeMade = 0u, statDecodeDropped = 0u;
+    GLuint decodedTexture(const GSTex0Reg &tex0, const GSTexaReg &texa, uint64_t memoryHash);
+    uint32_t clutColour(const GSTex0Reg &tex0, const GSTexaReg &texa, uint32_t index, bool fourBit) const;
+    void paletteColours(const GSTex0Reg &tex0, const GSTexaReg &texa, uint32_t *out, uint32_t count) const;
+
+    // ---- moment pictures (docs/RENDERER.md, stage 4) ----
+    // A game that draws each frame's field B at the frame before's pose (TF_MOMENTS=1:
+    // ps2_host_display::setMomentFields) has every scene draw as two copies, field A's and field
+    // B's, one after the other. For the screen's refreshes while a frame is up, the frame is drawn
+    // at those moments instead, each into a layer of its own (colour and depth, field A's rows),
+    // batch by batch as the scene comes - its textures are in local memory only then: field A's and
+    // field B's copies of each draw mixed vertex by vertex on the GPU (kMomentLerp), draws with no
+    // twin from the nearer field, draws over both fields (clears, the fog, the tint) into every
+    // layer. The scene buffer itself is not drawn. The copy of field A into the display buffer
+    // (SCANMSK 3) makes a picture of each moment from its layer, what goes over both field pictures
+    // after (the glow, the HUD) goes over each, and the pictures are shown by the screen's refresh.
+    // Needs the native pixel path; PS2X_GPU_MOMENTS=0 turns it off (the game's field B is then the
+    // frame before, shown in turn with field A).
+    bool momentsEnabled = false;
+    bool momentsActive = false; // the frame being drawn draws its moments
+    int momentCount = 0;
+    float momentT[kMaxMoments] = {};
+    int64_t momentShowsNs[kMaxMoments] = {};
+    uint64_t momentFrame = 0u; // frames given moments so far
+    uint64_t lastFlipTick = 0u;
+    // As a cap (as the two pictures a frame of the in-between: the game never waits for the GPU's
+    // pictures). Behind is judged as shares over about 20 frames: three frames in ten whose pictures
+    // the GS thread waited more than 4 ms for, or a fifth of the moments handed over after their
+    // refresh (ps2_host_display::momentsMissed: in a scene too much for the GPU the driver holds this
+    // thread back before the wait ever comes, and the game slowed to 30 a second with every moment
+    // still drawn). Twice behind within about 20 frames, and the frames after draw a moment less,
+    // down to one (the shares judged afresh then). `momentCalmNeeded` frames on, one more again: a
+    // second, twice as long each time the one put back is taken off again within two seconds (up to
+    // ten), a second again once one has stayed for ten. Not judged: the first two seconds of moments
+    // (a level starting: its textures coming in) and the ten frames after one is taken off (the GPU's
+    // backlog going down). Only a moment taken off starts the calm again, and none is counted while
+    // there are no moments (the game holding its in-between pictures off: they come back at the cap
+    // they went at). A hitch or a wait now and then - another program on the GPU, the GPU clocking
+    // down - is not behind: counted one by one they kept the cap at one moment a frame for good, and
+    // took it 170, 120, 60 a second by turns where the user walked into the Mini-Con's clearing. A
+    // refresh without a moment of its own shows the one before. The game's frame-rate logic sees the
+    // cap (ps2_host_display::momentCap): it lets the in-between pictures go only once it is at one.
+    int momentCap = kMaxMoments;
+    int momentCalm = 0;
+    int momentCalmNeeded = 60;
+    int momentSinceRaise = 1 << 30; // (frames since the cap last went up)
+    int momentQuiet = 0;            // (frames left whose strikes do not count)
+    bool momentsWereActive = false;
+    float momentStrikes = 0.0f;
+    float momentLate = 0.0f;  // (the share of a frame's moments handed over late, over about 20 frames)
+    float momentWaits = 0.0f; // (the share of frames whose pictures were waited for, the same)
+    uint64_t statMomentMissed = 0u;
+    uint64_t statMomentCapped = 0u, statMomentBehind = 0u;
+    double statMomentWaitMs = 0.0, statMomentWaitMost = 0.0;
+    uint32_t momentFirstRow = 224u, momentLastRow = 447u, momentBlock = 0u;
+    float momentShift = -224.5f; // field B's rows into field A's (the last pair's), for a field B draw alone
+    double momentOffsetMs = 5.0;  // PS2X_MOMENT_OFFSET: from the flip's VBlank to the frame before's pose shown
+    struct MomentLayer
+    {
+        GLuint color = 0u, view = 0u, depth = 0u, fbo = 0u, alphaCopy = 0u, fogIndex = 0u;
+        int width = 0, height = 0, sx = 0, sy = 0; // GS pixels, and the scale
+        uint64_t alphaClock = 1u, alphaCopyClock = 0u;
+        // (multisampled, PS2X_GPU_MSAA: the layer drawn into these, resolved into color and depth
+        // for what reads them - resolveLayer)
+        GLuint msColor = 0u, msDepth = 0u, msFbo = 0u;
+        GLuint resolved = 0u, resolveFbo = 0u; // (the colour resolved into a plain RGBA8 texture, then its bytes copied into color)
+        bool msColorNewer = false, msDepthNewer = false;
+    };
+    // Moment pictures multisampled (PS2X_GPU_MSAA=2, 4 or 8; off by default, not exact): each
+    // layer drawn into multisampled colour and depth, and resolved - the colour the samples'
+    // average, the depth one sample, as one GS pixel has one value - before what reads it: the
+    // copy of the frame's alpha for blends by Ad, the depth fog's index, the copy into the
+    // picture. Geometry's edges smoothed (an alpha-tested edge is a texture's: not by this).
+    int msaaSamples = 0;
+    uint64_t statMsaaResolves = 0u;
+    void resolveLayer(MomentLayer &layer, bool colour, bool depth);
+    std::array<MomentLayer, kMaxMoments> momentLayers;
+    bool batchMoments = false; // the batch draws the moments (into the buffer of both fields)
+    bool momentMainToo = false; // PS2X_MOMENT_MAIN=1 (debugging aid): the buffer of both fields drawn as well
+    // PS2X_MOMENT_BLOCKY=1 (testing aid): at the depth fog, each moment's depth made a GS pixel at a
+    // time, as the scene's depth buffer is there after its shuffle went through local memory - so
+    // that a moment at t = 1 is field A's picture exactly.
+    GLuint momentBlockyProgram = 0u, momentDepthCopy = 0u;
+    GLint momentBlockyScaleLocation = -1;
+    int momentDepthCopyW = 0, momentDepthCopyH = 0;
+    struct MomentSegment
+    {
+        uint32_t entry, first, count; // a run of the batch's vertices with one draw entry
+        float ofy;                    // ... its XYOFFSET down
+        bool mesh;                    // ... made on the GPU (kMeshExpand)
+    };
+    std::vector<MomentSegment> momentSegments;
+    int momentFogSlot = -1; // the batch's source slot read as the depth's fog index: the moments' own, or the native depth's (Transformers' depth fog)
+    // Transformers' depth fog in a native batch (PS2X_GPU_NATIVE_FOG=0: as it is, through local
+    // memory): the depth buffer's top bytes it reads - bits 8-15 of each pixel's Z24, put there by
+    // the game's shuffle through local memory, a GS pixel at a time - made from the native depth
+    // a GL pixel at a time instead (kMomentFog), as the moments make theirs. At a high scale the
+    // GS pixel's value was the depth at its middle for all of its 35 or 70 GL pixels: where a rock
+    // stood before the fogged distance, the part of its edge in such a block took the distance's
+    // fog - a rough white line around it, which the user saw.
+    bool nativeFog = true;
+    void nativeFogIndex(Target &depth, uint32_t bits);
+    struct MomentPiece
+    {
+        uint32_t dst, a, b, count, entry;
+        float shift, t;
+        uint32_t flags; // 1: mixed in perspective (an STQ texture: Q is 1/w)
+    };
+    static_assert(sizeof(MomentPiece) == 32, "piece layout");
+    std::array<std::vector<MomentPiece>, kMaxMoments> momentPieces;
+    std::vector<MomentPiece> momentPieceList;
+    std::array<std::vector<NativeRun>, kMaxMoments> momentRuns;
+    GLuint momentLerpProgram = 0u, momentFogProgram = 0u, momentPieceBuffer = 0u, momentFogFbo = 0u;
+    GLint momentPiecesLocation = -1, momentVerticesLocation = -1, momentFirstLocation = -1, momentFogScaleLocation = -1,
+          momentFogPixelLocation = -1;
+    uint64_t statMomentAligned = 0u; // (twin runs not as long, matched primitive by primitive)
+    uint64_t statMomentFrames = 0u, statMomentPictures = 0u, statMomentBatches = 0u, statMomentVertices = 0u, statMomentPairs = 0u,
+             statMomentMismatched = 0u, statMomentLoneA = 0u, statMomentLoneB = 0u, statMomentWhole = 0u, statMomentApprox = 0u,
+             statMomentFogs = 0u;
+    // What the game does not carry to its in-between (particles: a piece's field B is where it is
+    // now, seen from the frame before's view) starts from where the frame before left it - its field
+    // A then - so that it moves at every moment, not 60 times a second (PS2X_MOMENT_CARRY=0: as the
+    // game has it). Each paired run of a packet's (a mesh's are made on the GPU, and the game carries
+    // them: TF_MOMENTS_CHECK) leaves a note for the next frame: its kind (what stays the same frame to
+    // frame) and its first vertex; a kind of which a run is found moved from where the frame before
+    // left one - not far (kCarryReach), not merely new - is carried from then on, and its runs' field
+    // A vertices are kept too (carryStore). A run of a carried kind's field B not where the frame
+    // before left any takes the one nearest it, by its first vertex and then by all, when that is
+    // near and no other nearly as near. Kinds of many runs a frame (kCarryDense: the grass, whose
+    // blades sway less than a pixel a frame and come and go with the view) are left as they are.
+    struct CarryRun
+    {
+        uint64_t key;
+        float x, y;      // its first vertex
+        uint32_t stored; // where its vertices are in the frame's carryStore (~0u: not kept)
+        uint32_t count;
+    };
+    // (a kind's runs of the frame before, in the order they came: carryOrder[first .. first + count))
+    struct CarrySlot
+    {
+        uint64_t key = 0u; // (0: free - a kind's key is never 0)
+        uint32_t first = 0u, count = 0u, seen = 0u, pad = 0u;
+    };
+    static constexpr float kCarryReach = 32.0f; // GS pixels
+    static constexpr uint32_t kCarryDense = 128u; // runs of a kind a frame
+    static constexpr uint32_t kCarrySlots = 4096u, kCarryKindSlots = 1024u;
+    bool carry = true;
+    int carryNow = 0;
+    std::vector<CarryRun> carryRuns[2];
+    std::vector<GpuVertex> carryStore[2];
+    std::vector<uint32_t> carryOrder;
+    std::vector<CarrySlot> carrySlots = std::vector<CarrySlot>(kCarrySlots);
+    std::vector<uint32_t> carrySlotsUsed;
+    std::vector<uint64_t> carryKinds = std::vector<uint64_t>(kCarryKindSlots); // kinds found not carried by the game (0: free)
+    size_t carryKindCount = 0u;
+    bool carryKind(uint64_t key, bool add);
+    uint64_t statCarryKept = 0u, statCarried = 0u, statCarryLeft = 0u, statCarryNew = 0u;
+    CarrySlot *carrySlot(uint64_t key, bool make);
+    void carrySwap();
+    // (PS2X_MOMENT_CONTINUITY=1, testing aid: the kinds of the runs left as the game has them)
+    bool continuity = false;
+    struct ContinuityKind
+    {
+        uint64_t runs = 0u, vertices = 0u;
+        uint64_t apart[4] = {}; // (runs up to 1 px off, 4, 16, more)
+        double most = 0.0;
+        std::string what;
+    };
+    std::unordered_map<uint64_t, ContinuityKind> continuityKinds;
+    bool carryFrom(const MomentSegment &a, const MomentSegment &b, float shift, uint32_t &from);
+    void pickMoments(uint64_t flipTick);
+    void ensureMomentLayers();
+    void noteMomentSegment(size_t first, size_t count, bool mesh = false);
+    size_t prepareMoments();
+    void drawMoments(size_t made);
+    std::array<uint32_t, kMaxMoments> momentEnds{}; // (each moment's vertices end here: prepareMoments)
+
+    // ---- statistics (PS2X_GPU_STATS) ----
+    bool stats = false;
+    uint64_t statBatches = 0u, statDraws = 0u, statPrims = 0u, statVertices = 0u, statSkipped = 0u, statCulled = 0u, statUploads = 0u,
+             statLoadRows = 0u, statWriteRows = 0u, statFeedback = 0u, statSyncs = 0u, statDownloads = 0u, statReadbacks = 0u, statReadbackPages = 0u;
+    std::chrono::steady_clock::time_point statStart = std::chrono::steady_clock::now();
+    // GPU time of the passes (elapsed-time queries, read when they are done): draws, field
+    // pictures, loads from local memory, write-backs, presentation.
+    std::vector<GLuint> queryPool;
+    struct PendingQuery
+    {
+        GLuint query = 0u;
+        int kind = 0;
+        int pass = -1;          // PS2X_GPU_PROFILE: the pass's entry
+        GLuint invocations = 0u; // ... and its fragment shader invocations
+    };
+    std::vector<PendingQuery> queryPending;
+    double gpuMs[5] = {};
+    uint64_t statPresents = 0u;
+    uint64_t statFlips = 0u; // (frames: the GPU's time a frame, whatever the pictures a frame)
+    bool timing = false;
+    // PS2X_GPU_PROFILE=1 (debugging aid, with the statistics): the GPU time of the batches by
+    // pass - the frame buffer drawn (and depth buffer, field picture), the batch's rectangle -
+    // the busiest printed with the statistics.
+    bool profile = false;
+    bool profileFragments = false; // PS2X_GPU_PROFILE=2: the fragments counted too (stalls the GPU a batch)
+    struct PassTime
+    {
+        std::string name;
+        double ms = 0.0;
+        uint64_t batches = 0u, vertices = 0u, pixels = 0u, fragments = 0u;
+        uint64_t counted = 0u, depthFailed = 0u, alphaDiscarded = 0u; // (the shader's own count)
+    };
+    GLuint fragmentCounts = 0u; // (PS2X_GPU_PROFILE: the shader's counters, read after each batch)
+    std::vector<PassTime> passTimes;
+    std::unordered_map<std::string, int> passIndex;
+    // (and why batches ended)
+    int flushWhy = 0;
+    uint64_t flushCounts[12] = {};
+    static constexpr const char *kFlushWhy[12] = {"other", "target", "replacement slots", "source slots", "memory texture",
+                                                  "self texture", "shadow", "transfer", "load", "field sources", "grow", "native"};
+    int passEntry(const std::string &name)
+    {
+        const auto found = passIndex.find(name);
+        if (found != passIndex.end())
+            return found->second;
+        passTimes.push_back(PassTime{name});
+        passIndex.emplace(name, static_cast<int>(passTimes.size() - 1u));
+        return static_cast<int>(passTimes.size() - 1u);
+    }
+    void timeBegin(int kind, int pass = -1)
+    {
+        if (!stats)
+            return;
+        GLuint query = 0u;
+        if (queryPool.empty())
+            glGenQueries(1, &query);
+        else
+        {
+            query = queryPool.back();
+            queryPool.pop_back();
+        }
+        glBeginQuery(GL_TIME_ELAPSED, query);
+        GLuint invocations = 0u;
+        if (pass >= 0 && profileFragments && GLAD_GL_ARB_pipeline_statistics_query)
+        {
+            if (queryPool.empty())
+                glGenQueries(1, &invocations);
+            else
+            {
+                invocations = queryPool.back();
+                queryPool.pop_back();
+            }
+            glBeginQuery(GL_FRAGMENT_SHADER_INVOCATIONS, invocations);
+        }
+        queryPending.push_back(PendingQuery{query, kind, pass, invocations});
+        timing = true;
+    }
+    void timeEnd()
+    {
+        if (!timing)
+            return;
+        glEndQuery(GL_TIME_ELAPSED);
+        if (queryPending.back().invocations)
+            glEndQuery(GL_FRAGMENT_SHADER_INVOCATIONS);
+        timing = false;
+    }
+    void collectTimes()
+    {
+        size_t done = 0u;
+        for (; done < queryPending.size(); ++done)
+        {
+            const GLuint query = queryPending[done].query;
+            GLint ready = 0;
+            glGetQueryObjectiv(query, GL_QUERY_RESULT_AVAILABLE, &ready);
+            if (!ready)
+                break;
+            GLuint64 ns = 0u;
+            glGetQueryObjectui64v(query, GL_QUERY_RESULT, &ns);
+            gpuMs[queryPending[done].kind] += static_cast<double>(ns) / 1.0e6;
+            if (queryPending[done].pass >= 0)
+                passTimes[static_cast<size_t>(queryPending[done].pass)].ms += static_cast<double>(ns) / 1.0e6;
+            if (const GLuint invocations = queryPending[done].invocations)
+            {
+                GLuint64 count = 0u;
+                glGetQueryObjectui64v(invocations, GL_QUERY_RESULT, &count); // (done with the time, which ended last)
+                passTimes[static_cast<size_t>(queryPending[done].pass)].fragments += count;
+                queryPool.push_back(invocations);
+            }
+            queryPool.push_back(query);
+        }
+        queryPending.erase(queryPending.begin(), queryPending.begin() + static_cast<std::ptrdiff_t>(done));
+    }
+
+    bool init();
+    bool begin();
+    void invalidateAll();
+    void makeMemoryCurrent(const PageList &pages);
+    void download(const PageList &pages);
+    void writeBack(Target &t, const std::array<uint32_t, 16> &mask);
+    void markMemoryWritten(const PageList &pages);
+    void markDrawn(const PageList &pages, Target *drawn);
+    void markStale(Target &t, uint32_t page);
+    static void markAllStale(Target &t);
