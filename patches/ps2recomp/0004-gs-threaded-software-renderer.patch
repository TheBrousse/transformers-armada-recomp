+#pragma once
+
+#include "runtime/gs/gs_types.h"
+
+#include <cstring>
+
+// Whether two draw states are the same. The structures carry padding, so bytes that differ
+// do not prove a difference: then the fields decide.
+inline bool gsSameDrawState(const GSDrawState &a, const GSDrawState &b)
+{
+    if (std::memcmp(&a, &b, sizeof(GSDrawState)) == 0)
+        return true;
+
+    const GSContext &x = a.context;
+    const GSContext &y = b.context;
+    return x.frame.fbp == y.frame.fbp && x.frame.fbw == y.frame.fbw && x.frame.psm == y.frame.psm &&
+           x.frame.fbmsk == y.frame.fbmsk &&
+           x.scissor.x0 == y.scissor.x0 && x.scissor.x1 == y.scissor.x1 && x.scissor.y0 == y.scissor.y0 &&
+           x.scissor.y1 == y.scissor.y1 &&
+           x.tex0.tbp0 == y.tex0.tbp0 && x.tex0.tbw == y.tex0.tbw && x.tex0.psm == y.tex0.psm && x.tex0.tw == y.tex0.tw &&
+           x.tex0.th == y.tex0.th && x.tex0.tcc == y.tex0.tcc && x.tex0.tfx == y.tex0.tfx && x.tex0.cbp == y.tex0.cbp &&
+           x.tex0.cpsm == y.tex0.cpsm && x.tex0.csm == y.tex0.csm && x.tex0.csa == y.tex0.csa && x.tex0.cld == y.tex0.cld &&
+           x.xyoffset.ofx == y.xyoffset.ofx && x.xyoffset.ofy == y.xyoffset.ofy &&
+           x.zbuf.zbp == y.zbuf.zbp && x.zbuf.psm == y.zbuf.psm && x.zbuf.zmask == y.zbuf.zmask &&
+           x.tex1 == y.tex1 && x.miptbp1 == y.miptbp1 && x.miptbp2 == y.miptbp2 && x.clamp == y.clamp &&
+           x.alpha == y.alpha && x.test == y.test && x.fba == y.fba &&
+           a.prim.type == b.prim.type && a.prim.iip == b.prim.iip && a.prim.tme == b.prim.tme && a.prim.fge == b.prim.fge &&
+           a.prim.abe == b.prim.abe && a.prim.aa1 == b.prim.aa1 && a.prim.fst == b.prim.fst && a.prim.ctxt == b.prim.ctxt &&
+           a.prim.fix == b.prim.fix &&
+           a.texa.ta0 == b.texa.ta0 && a.texa.aem == b.texa.aem && a.texa.ta1 == b.texa.ta1 &&
+           a.texclut.cbw == b.texclut.cbw && a.texclut.cou == b.texclut.cou && a.texclut.cov == b.texclut.cov &&
+           a.pabe == b.pabe && a.scanmsk == b.scanmsk && a.dimx == b.dimx && a.dthe == b.dthe && a.colclamp == b.colclamp &&
+           a.fogR == b.fogR && a.fogG == b.fogG && a.fogB == b.fogB && a.textureWidth == b.textureWidth &&
+           a.textureHeight == b.textureHeight && a.linearFilter == b.linearFilter;
+}
