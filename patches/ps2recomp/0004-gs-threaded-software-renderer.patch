+    inline const char *kDrawFragmentMain = R"(
+void main()
+{
+    Draw d = draws[vDraw];
+    // A replacement is sampled over the texture's size (0 to 1 across it); how that changes from
+    // pixel to pixel picks its mipmap, so it is worked out before any pixel is discarded.
