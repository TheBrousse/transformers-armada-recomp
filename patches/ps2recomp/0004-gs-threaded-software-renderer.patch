+    GS_FAST_INLINE bool alphaTestPasses(uint8_t atst, int alpha, int aref)
+    {
+        switch (atst)
+        {
+        case 0:
+            return false;
+        case 1:
+            return true;
+        case 2:
+            return alpha < aref;
+        case 3:
+            return alpha <= aref;
+        case 4:
+            return alpha == aref;
+        case 5:
+            return alpha >= aref;
+        case 6:
+            return alpha > aref;
+        default:
+            return alpha != aref;
+        }
+    }
