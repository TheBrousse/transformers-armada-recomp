+flat out vec4 vScissor;
+// The blend's factors: Cs's (A - B: 1, 0 or -1), Cd's (likewise, times C), Cs again (D is Cs), Cd
+// again (D is Cd).
+flat out vec4 vBlend;
+// A frame byte masked (the destination's kept: r, g, b), and the alpha kept (a 24-bit frame, or
+// its byte masked).
+flat out vec4 vKeep;
+// A replacement's coordinates (0 to 1) over the divisor: S, T over Q, or U, V (1/256 texels) over
+// 256 times the texture's size, over 1.
+noperspective out vec3 vPack;
