+
+// An image source's value as RGBA8 (TEXA and the CLUT applied).
+uint imageTexel(Draw d, uint raw)
+{
+    uint psm = d.tex0.z;
+    uint ta0 = d.texa.x, ta1 = d.texa.y, aem = d.texa.z;
+    if (d.texScale.z == 16.0)
+        raw = expand5551(raw);
+    if (psm == 1u || psm == 49u) return applyTexa(raw, 24u, ta0, ta1, aem);
+    if (psm == 2u || psm == 10u || psm == 50u || psm == 58u) return applyTexa(raw, 16u, ta0, ta1, aem);
+    if (psm == 27u) return lookupClut(d.clut, raw >> 24, false, ta0, ta1, aem);
+    if (psm == 36u) return lookupClut(d.clut, (raw >> 24) & 0xFu, true, ta0, ta1, aem);
+    if (psm == 44u) return lookupClut(d.clut, raw >> 28, true, ta0, ta1, aem);
+    return raw;
+}
+
+// A texel as RGBA8 (TEXA and the CLUT applied) at integer texel coordinates; for an image
+// source (a frame buffer the GPU keeps, at the scale) in its own pixels.
+uint texel(Draw d, int u, int v)
+{
+    uint psm = d.tex0.z;
+    uint ta0 = d.texa.x, ta1 = d.texa.y, aem = d.texa.z;
+    if (d.tex0.y != 0u)
+        return imageTexel(d, loadSource(d.tex0.y, imagePixel(d, u, v)));
+    uint x = uint(wrapCoord(u, int(d.tex1.z), d.tex2.x, int(d.region.x), int(d.region.y)));
+    uint y = uint(wrapCoord(v, int(d.tex1.w), d.tex2.y, int(d.region.z), int(d.region.w)));
+    uint bp = d.tex1.x, bw = d.tex1.y;
+    if (psm == 0u) return readMem32(gsAddress(0u, bp, bw, x, y));
+    if (psm == 48u) return readMem32(gsAddress(1u, bp, bw, x, y));
+    if (psm == 1u) return applyTexa(readMem32(gsAddress(0u, bp, bw, x, y)), 24u, ta0, ta1, aem);
+    if (psm == 49u) return applyTexa(readMem32(gsAddress(1u, bp, bw, x, y)), 24u, ta0, ta1, aem);
+    if (psm == 2u) return applyTexa(expand5551(readMem16(gsAddress(2u, bp, bw, x, y))), 16u, ta0, ta1, aem);
+    if (psm == 10u) return applyTexa(expand5551(readMem16(gsAddress(3u, bp, bw, x, y))), 16u, ta0, ta1, aem);
+    if (psm == 50u) return applyTexa(expand5551(readMem16(gsAddress(4u, bp, bw, x, y))), 16u, ta0, ta1, aem);
+    if (psm == 58u) return applyTexa(expand5551(readMem16(gsAddress(5u, bp, bw, x, y))), 16u, ta0, ta1, aem);
+    if (psm == 19u) return lookupClut(d.clut, readMem8(gsAddress(6u, bp, bw, x, y)), false, ta0, ta1, aem);
+    if (psm == 20u) return lookupClut(d.clut, readMem4(gsAddress(7u, bp, bw, x, y)), true, ta0, ta1, aem);
+    if (psm == 27u) return lookupClut(d.clut, readMem32(gsAddress(0u, bp, bw, x, y)) >> 24, false, ta0, ta1, aem);
+    if (psm == 36u) return lookupClut(d.clut, (readMem32(gsAddress(0u, bp, bw, x, y)) >> 24) & 0xFu, true, ta0, ta1, aem);
+    if (psm == 44u) return lookupClut(d.clut, readMem32(gsAddress(0u, bp, bw, x, y)) >> 28, true, ta0, ta1, aem);
