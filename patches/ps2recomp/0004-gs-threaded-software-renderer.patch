+uniform vec4 uTarget;                 // viewport width, height (GL pixels), scale x, y
+uniform vec2 uDepthRange;             // 1 / 2^bits of the batch's depth values, the largest value
+noperspective out vec4 vColor;
+flat out uvec4 vFlat;
+noperspective out vec3 vTex;
+noperspective out float vFog;
+flat out uint vFlatFog;
+noperspective out float vZ;
+flat out uint vFlatZ;
+flat out uint vDraw;
+// The draw's registers as its pixels use them, worked out here a vertex rather than by every pixel
+// (each pixel loaded them one after another from the draw's entry, waiting for each, and decided
+// the same things again; Radeon GPU Analyzer, tools/rga_stats.py):
+//   x: source (5 bits) | mode << 5 (2) | tfx << 7 (2) | tcc << 9 | gouraud << 10 | flat << 11 |
+//      fog << 12 | ate << 13 | atst << 14 (3) | afail << 17 (2) | abe << 19 | pabe << 20 |
+//      scanmsk << 21 (2) | FBA << 23 | RGB_ONLY keeps alpha << 24
+//   y: aref | C as a constant << 8 (FIX; Ad of a 24-bit frame) | where C is << 16 (2: 0 As, 1 the
+//      constant, 2 Ad from the frame) | repeats << 24 (foldRepeats)
+//   z: -
+//   w: the fog colour (r | g << 8 | b << 16)
+flat out uvec4 vState;
