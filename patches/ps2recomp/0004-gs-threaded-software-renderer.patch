+void GSGpuRenderer::Impl::pushQuad(int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    GpuVertex v{};
+    v.z = z;
+    v.r = r;
+    v.g = g;
+    v.b = b;
+    v.a = a;
+    v.packed = drawIndex | (static_cast<uint32_t>(fog) << 24u);
+    // The pixel's square, [x - 0.5, x + 0.5): its whole block at any scale.
+    const float x0 = static_cast<float>(x) - 0.5f, y0 = static_cast<float>(y) - 0.5f;
+    const float corners[6][2] = {{x0, y0}, {x0 + 1.0f, y0}, {x0 + 1.0f, y0 + 1.0f}, {x0, y0}, {x0 + 1.0f, y0 + 1.0f}, {x0, y0 + 1.0f}};
+    for (const auto &corner : corners)
+    {
+        v.x = corner[0];
+        v.y = corner[1];
+        vertices.push_back(v);
+    }
+}
+
+void GSGpuRenderer::Impl::appendPrimitives(const GSVertex *in, uint32_t count, uint32_t each)
+{
+    const auto clampU8 = [](int value) { return static_cast<uint8_t>(std::clamp(value, 0, 255)); };
+    const auto rawZ = [](double z) { return z <= 0.0 ? 0u : (z >= 4294967295.0 ? 0xFFFFFFFFu : static_cast<uint32_t>(z)); };
+    // (window coordinates, GS pixels)
+    const auto outside = [this](float x0, float y0, float x1, float y1)
+    { return x1 < cullX0 || y1 < cullY0 || x0 > cullX1 || y0 > cullY1; };
+    switch (primKind)
+    {
+    case kTriangles:
+    {
+        if (each < 3u)
+            return;
+        // (The members in locals - the compiler cannot tell that writing vertices leaves them as
+        // they are, and read them again for each - and room for the call's vertices at once: the
+        // scene's triangles, 450,000 vertices a frame, were half of the GS thread's time.)
+        const float offsetX = ofx, offsetY = ofy;
+        const float minX = cullX0, minY = cullY0, maxX = cullX1, maxY = cullY1;
+        const uint32_t draw = drawIndex;
+        const int mode = texMode;
+        if (const size_t needed = vertices.size() + static_cast<size_t>(count) * 3u; needed > vertices.capacity())
+            vertices.reserve(std::max(needed, vertices.capacity() * 2u)); // (growing as push_back would)
+        uint64_t culled = 0u;
+        for (uint32_t p = 0; p < count; ++p)
+        {
+            const GSVertex *v = in + static_cast<size_t>(p) * each;
+            const float x0 = std::min(v[0].x, std::min(v[1].x, v[2].x)) - offsetX;
+            const float y0 = std::min(v[0].y, std::min(v[1].y, v[2].y)) - offsetY;
+            const float x1 = std::max(v[0].x, std::max(v[1].x, v[2].x)) - offsetX;
+            const float y1 = std::max(v[0].y, std::max(v[1].y, v[2].y)) - offsetY;
+            if (x1 < minX || y1 < minY || x0 > maxX || y0 > maxY)
+            {
+                ++culled;
+                continue;
+            }
+            for (uint32_t k = 0; k < 3u; ++k)
+            {
+                const GSVertex &s = v[k];
+                GpuVertex out;
+                out.x = s.x - offsetX;
+                out.y = s.y - offsetY;
+                out.z = rawZ(s.z);
+                out.r = s.r;
+                out.g = s.g;
+                out.b = s.b;
+                out.a = s.a;
+                if (mode == 1)
+                {
+                    out.s = static_cast<float>(s.u * 16.0);
+                    out.t = static_cast<float>(s.v * 16.0);
+                    out.q = 1.0f;
+                }
+                else if (mode == 2)
+                {
+                    out.s = s.s;
+                    out.t = s.t;
+                    out.q = s.q;
+                }
+                else
+                {
+                    out.s = 0.0f;
+                    out.t = 0.0f;
+                    out.q = 0.0f;
+                }
+                out.packed = draw | (static_cast<uint32_t>(s.fog) << 24u);
+                vertices.push_back(out);
+            }
+        }
+        statCulled += culled;
+        break;
+    }
+    case kSprites:
+    {
+        if (each < 2u)
+            return;
+        for (uint32_t p = 0; p < count; ++p)
+        {
+            const GSVertex &a = in[static_cast<size_t>(p) * each];
+            const GSVertex &b = in[static_cast<size_t>(p) * each + 1u];
+            if ((a.x == b.x || a.y == b.y) && !batchMoments)
+                continue; // (kept for the moments: paired with the other field's, which may have a size)
+            const float xa = a.x - ofx, ya = a.y - ofy, xb = b.x - ofx, yb = b.y - ofy;
+            if (outside(std::min(xa, xb), std::min(ya, yb), std::max(xa, xb), std::max(ya, yb)))
+            {
+                ++statCulled;
+                continue;
+            }
+            // The second vertex's colour, depth and fog (gs_raster.h setupSprite).
+            double u0 = 0.0, u1 = 0.0, t0 = 0.0, t1 = 0.0;
+            if (texMode != 0)
+            {
+                if (state.prim.fst)
+                {
+                    u0 = a.u * 16.0;
+                    u1 = b.u * 16.0;
+                    t0 = a.v * 16.0;
+                    t1 = b.v * 16.0;
+                }
+                else
+                {
+                    const double q0 = std::fabs(a.q) > 1.0e-8f ? a.q : 1.0;
+                    const double q1 = std::fabs(b.q) > 1.0e-8f ? b.q : 1.0;
+                    u0 = a.s / q0 * scaleU;
+                    u1 = b.s / q1 * scaleU;
+                    t0 = a.t / q0 * scaleV;
+                    t1 = b.t / q1 * scaleV;
+                }
+            }
+            GpuVertex corner{};
+            corner.z = static_cast<uint32_t>(std::min(std::max(b.z, 0.0), static_cast<double>(zmax)));
+            corner.r = b.r;
+            corner.g = b.g;
+            corner.b = b.b;
+            corner.a = b.a;
+            corner.q = 1.0f;
+            corner.packed = drawIndex | (static_cast<uint32_t>(b.fog) << 24u);
+            const auto put = [&](float x, float y, double u, double t)
+            {
+                corner.x = x;
+                corner.y = y;
+                corner.s = static_cast<float>(u);
+                corner.t = static_cast<float>(t);
+                vertices.push_back(corner);
+            };
+            // An edge on a whole coordinate covers the GS pixels from that one on (their sample
+            // points are whole): moved back half a pixel it covers their whole blocks at a scale
+            // above 1, as an edge on a half coordinate does (the game's own 2D), the texture
+            // coordinates moved along (at scale 1 the same pixels either way: left as they are).
+            // Without it a fill from 0 to 640 left the first part of the first row and column as it
+            // was (the SDK's clears: the warp gate's loading screen kept a line of old colour at the
+            // top). By default for sprites without a texture; PS2X_GPU_SPRITE_EDGES=2 for all (in a
+            // level 0.09% of the pixels at 3x change, by a level or two: the user's to compare), 0
+            // for none.
+            static const int wholeEdges = []()
+            {
+                const char *env = std::getenv("PS2X_GPU_SPRITE_EDGES");
+                return env ? std::atoi(env) : 1;
+            }();
+            float sxa = xa, sxb = xb, sya = ya, syb = yb;
+            if (wholeEdges >= 2 || (wholeEdges == 1 && texMode == 0))
+            {
+                const auto onWhole = [](float v) { return v == std::floor(v); };
+                const float dxa = scaleX > 1 && onWhole(xa) ? -0.5f : 0.0f, dxb = scaleX > 1 && onWhole(xb) ? -0.5f : 0.0f;
+                const float dya = scaleY > 1 && onWhole(ya) ? -0.5f : 0.0f, dyb = scaleY > 1 && onWhole(yb) ? -0.5f : 0.0f;
+                if (xb != xa && (dxa != 0.0f || dxb != 0.0f))
+                {
+                    const double slope = (u1 - u0) / static_cast<double>(xb - xa);
+                    u0 += dxa * slope;
+                    u1 += dxb * slope;
+                    sxa += dxa;
+                    sxb += dxb;
+                }
+                if (yb != ya && (dya != 0.0f || dyb != 0.0f))
+                {
+                    const double slope = (t1 - t0) / static_cast<double>(yb - ya);
+                    t0 += dya * slope;
+                    t1 += dyb * slope;
+                    sya += dya;
+                    syb += dyb;
+                }
+            }
+            put(sxa, sya, u0, t0);
+            put(sxb, sya, u1, t0);
+            put(sxb, syb, u1, t1);
+            put(sxa, sya, u0, t0);
+            put(sxb, syb, u1, t1);
+            put(sxa, syb, u0, t1);
+        }
+        break;
+    }
+    case kLines:
+    {
+        if (each < 2u)
+            return;
+        // GSCpuBackend::DrawLine: Bresenham between whole pixels, both ends drawn.
+        for (uint32_t p = 0; p < count; ++p)
+        {
+            const GSVertex &v0 = in[static_cast<size_t>(p) * each];
+            const GSVertex &v1 = in[static_cast<size_t>(p) * each + 1u];
+            int x0 = static_cast<int>(v0.x) - ofxPixels;
+            int y0 = static_cast<int>(v0.y) - ofyPixels;
+            const int x1 = static_cast<int>(v1.x) - ofxPixels;
+            const int y1 = static_cast<int>(v1.y) - ofyPixels;
+            const int dx = std::abs(x1 - x0);
+            const int dy = -std::abs(y1 - y0);
+            const int sx = x0 < x1 ? 1 : -1;
+            const int sy = y0 < y1 ? 1 : -1;
+            int err = dx + dy;
+            int totalSteps = std::max(std::abs(x1 - x0), std::abs(y1 - y0));
+            if (totalSteps == 0)
+                totalSteps = 1;
+            for (int step = 0; step <= 4096; ++step)
+            {
+                const float t = static_cast<float>(step) / static_cast<float>(totalSteps);
+                uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a;
+                if (state.prim.iip)
+                {
+                    r = clampU8(static_cast<int>(v0.r + (v1.r - v0.r) * t));
+                    g = clampU8(static_cast<int>(v0.g + (v1.g - v0.g) * t));
+                    b = clampU8(static_cast<int>(v0.b + (v1.b - v0.b) * t));
+                    a = clampU8(static_cast<int>(v0.a + (v1.a - v0.a) * t));
+                }
+                const double z = v0.z + (v1.z - v0.z) * t;
+                const uint8_t fog = clampU8(static_cast<int>(v0.fog + (v1.fog - v0.fog) * t));
+                pushQuad(x0, y0, rawZ(z), r, g, b, a, fog);
+                if (x0 == x1 && y0 == y1)
+                    break;
+                const int e2 = 2 * err;
+                if (e2 >= dy)
+                {
+                    err += dy;
+                    x0 += sx;
+                }
+                if (e2 <= dx)
+                {
+                    err += dx;
+                    y0 += sy;
+                }
+            }
+        }
+        break;
+    }
+    case kPoints:
+        for (uint32_t p = 0; p < count; ++p)
+        {
+            const GSVertex &v = in[static_cast<size_t>(p) * each];
+            pushQuad(static_cast<int>(v.x) - ofxPixels, static_cast<int>(v.y) - ofyPixels, rawZ(v.z), v.r, v.g, v.b, v.a, v.fog);
+        }
+        break;
+    }
+}
+
+// A run of one draw entry that is the same primitives over and over (Transformers draws its
+// glow four times over the screen): one copy, its fragments blending that many times (the
+// entry's texa[3], kDrawFragmentMain) - for a draw that adds the same each time (A = Cs, B = 0,
+// D = Cd, C = As or FIX: in any order) or writes without blending (again is the same), with no
+// depth test or write and no destination alpha test. PS2X_GPU_FOLD=0 leaves them as they are.
+bool GSGpuRenderer::Impl::repeatable(const GpuDraw &d) const
+{
+    if (d.depth[0] != 1u || d.depth[1] != 0u || (d.frame[0] & kDate) != 0u)
+        return false;
+    if (d.blend[0] == 0u)
+        return true;
+    const uint32_t abcd = d.blend[1];
+    return (abcd & 3u) == 0u && ((abcd >> 2) & 3u) == 2u && ((abcd >> 6) & 3u) == 1u && ((abcd >> 4) & 3u) != 1u;
+}
+
+// (candidates: the entries that may fold and where their primitives begin in the list, noted
+// as the entries were made - the batch's other runs are not looked at.)
+void GSGpuRenderer::Impl::foldRepeats(std::vector<GpuVertex> &list, std::vector<FoldCandidate> &candidates)
+{
+    struct Cut
+    {
+        size_t from, to; // [from, to) left out
+    };
+    std::vector<Cut> cuts;
+    for (const FoldCandidate &c : candidates)
+    {
+        const size_t i = c.start;
+        size_t j = i;
+        while (j < list.size() && (list[j].packed & 0xFFFFFFu) == c.entry)
+            ++j;
+        const size_t length = j - i;
+        if (length < 6u)
+            continue;
+        // The period: where the run's first triangle comes again; every one after the same.
+        size_t period = 0u;
+        for (size_t at = 3u; at + 3u <= length; at += 3u)
+            if (std::memcmp(&list[i + at], &list[i], 3u * sizeof(GpuVertex)) == 0)
+            {
+                period = at;
+                break;
+            }
+        if (period == 0u || length % period != 0u ||
+            std::memcmp(&list[i + period], &list[i], (length - period) * sizeof(GpuVertex)) != 0)
+            continue;
+        if (draws[c.entry].blend[0] != 0u)
+            draws[c.entry].texa[3] = static_cast<uint32_t>(length / period);
+        cuts.push_back({i + period, j});
+        ++statFolded;
+    }
+    candidates.clear();
+    if (cuts.empty())
+        return;
+    // (in order: the candidates were noted as the list grew)
+    size_t to = cuts.front().from;
+    for (size_t k = 0u; k < cuts.size(); ++k)
+    {
+        const size_t next = k + 1u < cuts.size() ? cuts[k + 1u].from : list.size();
+        for (size_t from = cuts[k].to; from < next; ++from)
+            list[to++] = list[from];
+    }
+    list.resize(to);
+}
+
+void GSGpuRenderer::Impl::flush()
+{
+    ++flushSerial;
+    if (profile && !vertices.empty())
+        ++flushCounts[flushWhy];
+    flushWhy = 0;
+    stateDirty = true; // the next primitives need an entry in the next batch
+    if (vertices.empty() || !batchFrame)
+    {
+        vertices.clear();
+        draws.clear();
+        cluts.clear();
+        batchClutVersion = 0u;
+        sourceCount = 0u;
+        replaceCount = 0u;
+        foldCandidates.clear();
+        meshWords.clear();
+        meshJobs.clear();
+        meshTriangles.clear();
+        meshExpected.clear();
+        meshInputs.clear();
+        nativeRuns.clear();
+        momentSegments.clear();
+        momentFogSlot = -1;
+        for (ShadowBatch &b : shadowBatches)
+        {
+            b.vertices.clear();
+            b.foldCandidates.clear();
+            b.sourceCount = 0u;
+            b.drawIndex = -1;
+        }
+        return;
+    }
+    // A batch of the frame's moments: what each moment draws, after the batch's own vertices (its
+    // draw entries made first: the moments' own go after the batch's). The buffer of both fields
+    // and its depth buffer are not drawn.
+    const size_t momentVertices = batchMoments ? prepareMoments() : 0u;
+    // The depth buffer as the batch draws it: its native copy, or its texture.
+    const bool drawMain = !batchMoments || momentMainToo;
+    // Multisampling (sceneMsaa): the scene's native batches - those with a depth buffer - into the
+    // multisampled copies of their buffers, filled first where something else wrote the buffers; any
+    // other batch into such a buffer has what those drew resolved into the buffer first.
+    const bool msBatch = drawMain && batchNative && batchDepth && msaaFor(*batchFrame) && msaaFor(*batchDepth);
+    if (drawMain && !msBatch)
+    {
+        msaaResolve(*batchFrame, 0);
+        if (batchDepth)
+            msaaResolve(*batchDepth, 0, true); // (tested against: the farthest sample)
+    }
+    if (batchDepth && drawMain)
+    {
+        if (batchNative)
+            nativeDepthReady(*batchDepth);
+        else
+            nativeDepthCurrent(*batchDepth, 0);
+    }
+    if (msBatch)
+    {
+        msaaEnsure(*batchFrame);
+        msaaEnsure(*batchDepth);
+        msaaFill(*batchFrame);
+        msaaFill(*batchDepth);
+    }
+    if (!meshTriangles.empty())
+        foldCandidates.clear(); // (the slots kept for the meshes are not filled yet: nothing to compare)
+    if (!foldCandidates.empty())
+        foldRepeats(vertices, foldCandidates);
+    // (field pictures drawn natively too: kNativeFragmentMain adds a folded draw's part its count
+    // of times)
+    const bool shadowsNative = fields && batchFrame->shadowed && ps2_host_display::fieldsAsMoments() && batchShadowNative && nativeEnabled && nativeFields;
+    for (ShadowBatch &b : shadowBatches)
+        if (!b.foldCandidates.empty())
+            foldRepeats(b.vertices, b.foldCandidates);
+    glBindVertexArray(vao);
+    glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    if (momentVertices != 0u)
+    {
+        glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>((vertices.size() + momentVertices) * sizeof(GpuVertex)), nullptr, GL_STREAM_DRAW);
+        glBufferSubData(GL_ARRAY_BUFFER, 0, static_cast<GLsizeiptr>(vertices.size() * sizeof(GpuVertex)), vertices.data());
+    }
+    else
+        glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(vertices.size() * sizeof(GpuVertex)), vertices.data(), GL_STREAM_DRAW);
+    if (!meshTriangles.empty())
+        expandMeshes();
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, drawBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(draws.size() * sizeof(GpuDraw)), draws.data(), GL_STREAM_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, drawBuffer);
+    if (cluts.empty())
+        cluts.assign(256u, 0u);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, clutBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(cluts.size() * sizeof(uint32_t)), cluts.data(), GL_STREAM_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 3, clutBuffer);
+
+    const GLuint frameImage = (batchNative || !drawMain) ? dummyImage : batchFrame->tex; // (a native batch draws through the GPU's own)
+    const GLuint depthImage = (batchDepth && !batchNative && drawMain) ? batchDepth->tex : dummyImage;
+    glBindImageTexture(0, frameImage, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    glBindImageTexture(1, depthImage, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    glBindImageTexture(6, depthImage, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI); // (early test)
+    for (uint32_t i = 0; i < sources.size(); ++i)
+        glBindImageTexture(2u + i, i < sourceCount && sources[i] ? sources[i] : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+    // Texture pack replacements (and the cache's), with the samplers of their wrapping and filtering.
+    if (replacements)
+    {
+        for (uint32_t i = 0; i < replaceSlots.size(); ++i)
+        {
+            glActiveTexture(GL_TEXTURE0 + i);
+            glBindTexture(GL_TEXTURE_2D, i < replaceCount ? replaceSlots[i].texture : packDummy);
+            glBindSampler(i, i < replaceCount ? replaceSlots[i].sampler : 0u);
+        }
+        glActiveTexture(GL_TEXTURE0);
+    }
+
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glViewport(0, 0, viewportX, viewportY);
+    glEnable(GL_SCISSOR_TEST);
+    const int x0 = std::clamp(rect[0], 0, batchFrame->width - 1), y0 = std::clamp(rect[1], 0, batchFrame->rows - 1);
+    const int x1 = std::clamp(rect[2], x0, batchFrame->width - 1), y1 = std::clamp(rect[3], y0, batchFrame->rows - 1);
+    const int bsx = batchFrame->sx, bsy = batchFrame->sy;
+    glScissor(x0 * bsx, y0 * bsy, (x1 - x0 + 1) * bsx, (y1 - y0 + 1) * bsy);
+    useDrawProgram((batchDepth ? 0 : 1) | (batchGsTextures ? 0 : 2), batchDepthGrows, bsx, bsy);
+    if (sourceSizeLocations[currentVariant] >= 0)
+        glUniform2iv(sourceSizeLocations[currentVariant], 4, sourceSizes.data());
+    if (sourceScaleLocations[currentVariant] >= 0)
+        glUniform2iv(sourceScaleLocations[currentVariant], 4, sourceScales.data());
+    barrier();
+    // (PS2X_GPU_PROFILE: the pass - frame buffer, depth buffer, field picture, rectangle)
+    const auto passOf = [&](int field)
+    {
+        if (!profile)
+            return -1;
+        char name[160];
+        std::snprintf(name, sizeof(name), "frame %u/%u k%d depth %d %s %d,%d-%d,%d", batchFrame->bp, batchFrame->bw,
+                      static_cast<int>(batchFrame->kind), batchDepth ? static_cast<int>(batchDepth->bp) : -1,
+                      field < 0 ? (batchNative ? "native" : "buffer") : (field == 0 ? "field0" : (field == 1 ? "field1" : "moment")), x0, y0, x1, y1);
+        const int pass = passEntry(name);
+        PassTime &t = passTimes[static_cast<size_t>(pass)];
+        ++t.batches;
+        t.vertices += field < 0 ? vertices.size() : shadowBatches[static_cast<size_t>(field)].vertices.size();
+        t.pixels += static_cast<uint64_t>(x1 - x0 + 1) * static_cast<uint64_t>(y1 - y0 + 1);
+        return pass;
+    };
+    // (Field pictures as the buffer: those alone, below.)
+    const bool momentsBatch = fields && batchFrame->shadowed && ps2_host_display::fieldsAsMoments();
+    const int mainPass = (momentsBatch || !drawMain) ? -1 : passOf(-1);
+    if (drawMain && batchNative)
+    {
+        // Into the frame's RGBA8 view (its own bytes) and the depth buffer's native copy, with the
+        // GPU's blending (the shader's two outputs: the source's part, the destination's factor)
+        // and depth test, run by run.
+        if (!batchFrame->view)
+        {
+            glGenTextures(1, &batchFrame->view);
+            glTextureView(batchFrame->view, GL_TEXTURE_2D, batchFrame->tex, GL_RGBA8, 0, 1, 0, 1);
+        }
+        if (batchReadsAlpha && (alphaCopyOf != batchFrame || alphaCopyClock != batchFrame->alphaClock))
+        {
+            msaaResolve(*batchFrame, 10); // (the alpha it reads: what the multisampled copy has too)
+            copyInto(alphaCopy, alphaCopyW, alphaCopyH, batchFrame->tex, batchFrame->width * batchFrame->sx, batchFrame->rows * batchFrame->sy);
+            alphaCopyOf = batchFrame;
+            alphaCopyClock = batchFrame->alphaClock;
+            ++statAlphaCopies;
+        }
+        glBindImageTexture(7, batchReadsAlpha ? alphaCopy : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+        const GLuint batchFbo = msBatch ? msFbo : nativeFbo;
+        glBindFramebuffer(GL_FRAMEBUFFER, batchFbo);
+        if (msBatch)
+        {
+            if (msColorAttached != batchFrame->ms)
+            {
+                glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, batchFrame->ms);
+                msColorAttached = batchFrame->ms;
+            }
+            if (msDepthAttached != batchDepth->ms)
+            {
+                glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, batchDepth->ms);
+                msDepthAttached = batchDepth->ms;
+            }
+        }
+        else
+        {
+            const GLuint depthTexture = batchDepth ? batchDepth->nativeDepth : 0u;
+            if (nativeColorAttached != batchFrame->view)
+            {
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, batchFrame->view, 0);
+                nativeColorAttached = batchFrame->view;
+            }
+            if (nativeDepthAttached != depthTexture)
+            {
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depthTexture, 0);
+                nativeDepthAttached = depthTexture;
+            }
+        }
+        const int v = (batchGsTextures ? 0 : 1) | (msBatch && msPixelDepth ? 2 : 0); // (PS2X_GPU_MSAA_PIXEL_DEPTH)
+        const uint32_t bits = batchNativeBits ? batchNativeBits : 24u;
+        // (the depth fog: the slot's buffer read as the depth buffer's fog index, made now)
+        std::array<GLint, 8> sizes = sourceSizes, scales = sourceScales;
+        const bool fogNow = momentFogSlot >= 0 && !batchMoments && batchDepth && batchDepth->nativeDepth;
+        if (fogNow)
+        {
+            nativeFogIndex(*batchDepth, bits);
+            glBindFramebuffer(GL_FRAMEBUFFER, batchFbo);
+            glViewport(0, 0, viewportX, viewportY);
+            const size_t slot = static_cast<size_t>(momentFogSlot);
+            glBindImageTexture(2u + static_cast<GLuint>(slot), batchDepth->fogIndex, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+            sizes[2u * slot] = batchDepth->fogW;
+            sizes[2u * slot + 1u] = batchDepth->fogH;
+            scales[2u * slot] = batchDepth->sx;
+            scales[2u * slot + 1u] = batchDepth->sy;
+            ++statNativeFogs;
+        }
+        glUseProgram(nativePrograms[v]);
+        bindSourceViews(v, sourceViews, sourceCount);
+        glUniform4f(nativeTargetLocations[v], static_cast<float>(viewportX), static_cast<float>(viewportY), static_cast<float>(bsx),
+                    static_cast<float>(bsy));
+        glUniform2f(nativeDepthLocations[v], bits >= 32u ? 1.0f / 4294967296.0f : 1.0f / static_cast<float>(1u << bits),
+                    bits >= 32u ? 4294967295.0f : static_cast<float>((1u << bits) - 1u));
+        if (nativeSourceSizeLocations[v] >= 0)
+            glUniform2iv(nativeSourceSizeLocations[v], 4, sizes.data());
+        if (nativeSourceScaleLocations[v] >= 0)
+            glUniform2iv(nativeSourceScaleLocations[v], 4, scales.data());
+        glEnable(GL_BLEND);
+        glDisable(GL_DITHER); // (on by default: the GS does not dither here)
+        glBlendEquation(GL_FUNC_ADD);
+        glBlendFuncSeparate(GL_ONE, GL_SRC1_COLOR, GL_ONE, GL_SRC1_ALPHA);
+        if (batchDepth)
+            glEnable(GL_DEPTH_TEST);
+        timeBegin(0, mainPass);
+        for (size_t i = 0; i < nativeRuns.size(); ++i)
+        {
+            const uint32_t first = nativeRuns[i].first;
+            const uint32_t end = i + 1u < nativeRuns.size() ? nativeRuns[i + 1u].first : static_cast<uint32_t>(vertices.size());
+            if (end <= first)
+                continue;
+            if (batchDepth)
+            {
+                const uint32_t ztst = nativeRuns[i].key & 3u;
+                glDepthFunc(ztst == 2u ? GL_GEQUAL : (ztst == 3u ? GL_GREATER : GL_ALWAYS));
+                glDepthMask((nativeRuns[i].key & 4u) != 0u ? GL_TRUE : GL_FALSE);
+            }
+            glDrawArrays(GL_TRIANGLES, static_cast<GLint>(first), static_cast<GLsizei>(end - first));
+            ++statNativeRuns;
+        }
+        timeEnd();
+        glDisable(GL_BLEND);
+        glEnable(GL_DITHER); // (as the presentation passes had it)
+        glDisable(GL_DEPTH_TEST);
+        glDepthMask(GL_TRUE);
+        if (msBatch)
+        {
+            // (into the multisampled copies: resolved into the buffers when something else uses them)
+            batchFrame->msNewer = true;
+            batchFrame->msY0 = std::min(batchFrame->msY0, y0);
+            batchFrame->msY1 = std::max(batchFrame->msY1, y1);
+            if (batchZWrite)
+            {
+                batchDepth->msNewer = true;
+                batchDepth->msY0 = std::min(batchDepth->msY0, y0);
+                batchDepth->msY1 = std::max(batchDepth->msY1, y1);
+            }
+        }
+        else
+        {
+            if (batchDepth && batchZWrite)
+                markDepthRows(*batchDepth, y0, y1, kDepthNative);
+            if (batchFrame->ms)
+                batchFrame->msStale = true; // (drawn past its multisampled copy)
+            if (batchDepth && batchZWrite && batchDepth->ms)
+                batchDepth->msStale = true;
+        }
+        if (batchWritesAlpha)
+            batchFrame->alphaClock = ++alphaClock;
+        if (fogNow)
+            glBindImageTexture(2u + static_cast<GLuint>(momentFogSlot), sources[static_cast<size_t>(momentFogSlot)], 0, GL_FALSE, 0,
+                               GL_READ_ONLY, GL_R32UI);
+        ++statNativeBatches;
+    }
+    else if (drawMain && !momentsBatch)
+    {
+        timeBegin(0, mainPass);
+        glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(vertices.size()));
+        timeEnd();
+        if (batchDepth && batchZWrite)
+        {
+            markDepthRows(*batchDepth, y0, y1, kDepthTexture); // (its texture newer than a native copy)
+            batchDepth->depthOldWhy = 0u;
+            batchDepth->msStale = true; // (and than a multisampled one)
+        }
+        batchFrame->alphaClock = ++alphaClock; // (and its alpha may have changed)
+        batchFrame->msStale = true;
+    }
+    if (batchMoments)
+        drawMoments(momentVertices);
+    if (profile && mainPass >= 0 && fragmentCounts)
+    {
+        // (a stall a batch: profiling only)
+        glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT | GL_SHADER_STORAGE_BARRIER_BIT);
+        uint32_t counts[4] = {};
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, fragmentCounts);
+        glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, sizeof(counts), counts);
+        const uint32_t zero[4] = {0u, 0u, 0u, 0u};
+        glBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, sizeof(zero), zero);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 6, fragmentCounts);
+        PassTime &t = passTimes[static_cast<size_t>(mainPass)];
+        t.counted += counts[0];
+        t.depthFailed += counts[1];
+        t.alphaDiscarded += counts[2];
+    }
+    imagesWritten = true;
+    ++statBatches;
+    ++batchFrame->statBatches;
+    statDraws += draws.size();
+    statVertices += vertices.size();
+
+    // The same draws into the buffer's field pictures (no depth buffer: none of them uses one) -
+    // natively (field pictures as the buffer, every draw the native path's); else into both at
+    // once when they are the same draws (shadowDual).
+    if (shadowsNative)
+    {
+        if (!shadowFbo)
+            glGenFramebuffers(1, &shadowFbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, shadowFbo);
+        glUseProgram(nativePrograms[0]);
+        glUniform4f(nativeTargetLocations[0], static_cast<float>(viewportX), static_cast<float>(viewportY), static_cast<float>(bsx),
+                    static_cast<float>(bsy));
+        glUniform2f(nativeDepthLocations[0], 1.0f / 16777216.0f, 16777215.0f);
+        glBindImageTexture(7, dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+        glEnable(GL_BLEND);
+        glDisable(GL_DITHER);
+        glBlendEquation(GL_FUNC_ADD);
+        glBlendFuncSeparate(GL_ONE, GL_SRC1_COLOR, GL_ONE, GL_SRC1_ALPHA);
+        for (int k = 0; k < kShadows; ++k)
+        {
+            ShadowBatch &b = shadowBatches[k];
+            if (b.vertices.empty() || !batchFrame->shadow[k])
+                continue;
+            if (!batchFrame->shadowView[k])
+            {
+                glGenTextures(1, &batchFrame->shadowView[k]);
+                glTextureView(batchFrame->shadowView[k], GL_TEXTURE_2D, batchFrame->shadow[k], GL_RGBA8, 0, 1, 0, 1);
+            }
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, batchFrame->shadowView[k], 0);
+            if (nativeSourceSizeLocations[0] >= 0)
+                glUniform2iv(nativeSourceSizeLocations[0], 4, b.sizes.data());
+            if (nativeSourceScaleLocations[0] >= 0)
+                glUniform2iv(nativeSourceScaleLocations[0], 4, b.scales.data());
+            glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(b.vertices.size() * sizeof(GpuVertex)), b.vertices.data(), GL_STREAM_DRAW);
+            for (uint32_t i = 0; i < b.sources.size(); ++i)
+                glBindImageTexture(2u + i, i < b.sourceCount && b.sources[i] ? b.sources[i] : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY,
+                                   GL_R32UI);
+            bindSourceViews(0, b.views, b.sourceCount);
+            timeBegin(1, passOf(k));
+            glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(b.vertices.size()));
+            timeEnd();
+            ++statBatches;
+            ++statNativeBatches;
+            b.vertices.clear();
+        }
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0u, 0);
+        glDisable(GL_BLEND);
+        glEnable(GL_DITHER);
+    }
+    if (dualEnabled && shadowDual && !shadowBatches[0].vertices.empty() &&
+        shadowBatches[0].vertices.size() == shadowBatches[1].vertices.size() && batchFrame->shadow[0] && batchFrame->shadow[1])
+    {
+        ShadowBatch &b = shadowBatches[0];
+        glUseProgram(dualProgram);
+        glUniform4f(dualTargetLocation, static_cast<float>(viewportX), static_cast<float>(viewportY), static_cast<float>(bsx),
+                    static_cast<float>(bsy));
+        if (dualSourceSizeLocation >= 0)
+            glUniform2iv(dualSourceSizeLocation, 4, b.sizes.data());
+        if (dualSourceScaleLocation >= 0)
+            glUniform2iv(dualSourceScaleLocation, 4, b.scales.data());
+        glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(b.vertices.size() * sizeof(GpuVertex)), b.vertices.data(), GL_STREAM_DRAW);
+        glBindImageTexture(0, batchFrame->shadow[0], 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+        glBindImageTexture(7, batchFrame->shadow[1], 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+        glBindImageTexture(1, dummyImage, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+        for (uint32_t i = 0; i < b.sources.size(); ++i)
+            glBindImageTexture(2u + i, i < b.sourceCount && b.sources[i] ? b.sources[i] : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY,
+                               GL_R32UI);
+        timeBegin(1, passOf(0));
+        glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(b.vertices.size()));
+        timeEnd();
+        ++statBatches;
+        for (ShadowBatch &both : shadowBatches)
+            both.vertices.clear();
+    }
+    bool fieldProgramSet = false;
+    for (int k = 0; k < kShadows; ++k)
+    {
+        ShadowBatch &b = shadowBatches[k];
+        if (!b.vertices.empty() && batchFrame->shadow[k])
+        {
+            if (!fieldProgramSet)
+            {
+                useDrawProgram(1, false, bsx, bsy);
+                fieldProgramSet = true;
+            }
+            if (sourceSizeLocations[currentVariant] >= 0)
+                glUniform2iv(sourceSizeLocations[currentVariant], 4, b.sizes.data());
+            if (sourceScaleLocations[currentVariant] >= 0)
+                glUniform2iv(sourceScaleLocations[currentVariant], 4, b.scales.data());
+            glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(b.vertices.size() * sizeof(GpuVertex)), b.vertices.data(),
+                         GL_STREAM_DRAW);
+            glBindImageTexture(0, batchFrame->shadow[k], 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+            glBindImageTexture(1, dummyImage, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+            for (uint32_t i = 0; i < b.sources.size(); ++i)
+                glBindImageTexture(2u + i, i < b.sourceCount && b.sources[i] ? b.sources[i] : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY,
+                                   GL_R32UI);
+            timeBegin(1, passOf(k));
+            glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(b.vertices.size()));
+            timeEnd();
+            ++statBatches;
+        }
+        b.vertices.clear();
+        b.sourceCount = 0u;
+        b.drawIndex = -1;
+    }
+    if (replacements && replaceCount)
+    {
+        // (the presentation passes sample integer textures on these units: no samplers there)
+        for (uint32_t i = 0; i < replaceCount; ++i)
+            glBindSampler(i, 0u);
+        replaceCount = 0u;
+    }
+
+    // What was drawn: the software renderer draws it into local memory too.
+    PageList &pages = drawnPages;
+    pages.clear();
+    if (!momentsBatch && drawMain)
+    {
+        pagesOf(pages, batchFrame->bp, batchFrame->bw, batchFrame->kind, x0, y0, x1, y1);
+        markDrawn(pages, batchFrame);
+    }
+    if (batchDepth && batchZWrite && drawMain)
+    {
+        pages.clear();
+        pagesOf(pages, batchDepth->bp, batchDepth->bw, batchDepth->kind, x0, y0, x1, y1);
+        markDrawn(pages, batchDepth);
+    }
+
+    vertices.clear();
+    draws.clear();
+    cluts.clear();
+    nativeRuns.clear();
+    momentSegments.clear();
+    momentFogSlot = -1;
+    batchClutVersion = 0u;
+    sourceCount = 0u;
+    rect[0] = rect[1] = kMaxCoord;
+    rect[2] = rect[3] = -1;
+    batchZWrite = false;
+    framePages.reset();
+    depthPages.reset();
+}
+
+// ---- moment pictures ---------------------------------------------------------------------
+
+// The moments of the frame the game draws next (it just flipped at VBlank `flipTick`): the screen's
+// refreshes while that frame is up - from its own flip, as many VBlanks on as the last frame took,
+// for as long - each as how far it is from the frame before's pose (0) to the frame's own (1).
+// A little later than the flip (PS2X_MOMENT_OFFSET, 5 ms): the pictures are made by then.
+void GSGpuRenderer::Impl::pickMoments(uint64_t flipTick)
+{
+    using Clock = std::chrono::steady_clock;
+    const uint64_t perFrame = (lastFlipTick != 0u && flipTick > lastFlipTick && flipTick - lastFlipTick <= 4u) ? flipTick - lastFlipTick : 2u;
+    lastFlipTick = flipTick;
+    momentsActive = false;
+    momentCount = 0;
+    carrySwap();
+    uint32_t firstRow = 0u, lastRow = 0u, block = 0u;
+    if (!momentsEnabled || !ps2_host_display::momentFields(firstRow, lastRow) || !ps2_host_display::fieldsBuffer(block) || firstRow == 0u ||
+        lastRow < firstRow)
+        return;
+    Clock::time_point due{};
+    if (!ps2_host_display::vblankDue(flipTick, due))
+        return;
+    const Clock::duration period = ps2_host_display::vblankPeriodNow();
+    const Clock::duration span = period * static_cast<int64_t>(perFrame);
+    const Clock::time_point start =
+        due + span + std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double, std::milli>(momentOffsetMs));
+    const auto ns = [](Clock::time_point t) { return std::chrono::duration_cast<std::chrono::nanoseconds>(t.time_since_epoch()).count(); };
+    const double spanSeconds = std::chrono::duration<double>(span).count();
+    Clock::time_point vblank{};
+    Clock::duration refresh{};
+    int count = 0;
+    // (PS2X_MOMENT_FIXED=0.25,0.5,0.75,1, testing aid: those moments every frame, whatever the screen)
+    static const std::vector<float> fixedMoments = []()
+    {
+        std::vector<float> list;
+        if (const char *env = std::getenv("PS2X_MOMENT_FIXED"))
+            for (const char *at = env; *at && list.size() < static_cast<size_t>(kMaxMoments);)
+            {
+                char *end = nullptr;
+                const float t = std::strtof(at, &end);
+                if (end == at)
+                    break;
+                list.push_back(std::clamp(t, 0.0f, 1.0f));
+                at = *end == ',' ? end + 1 : end;
+            }
+        return list;
+    }();
+    if (!fixedMoments.empty())
+    {
+        for (const float t : fixedMoments)
+        {
+            momentT[count] = t;
+            momentShowsNs[count] = ns(start + std::chrono::duration_cast<Clock::duration>(span * static_cast<double>(t)));
+            ++count;
+        }
+    }
+    else if (ps2_host_display::screenTiming(vblank, refresh) && refresh > std::chrono::milliseconds(2))
+    {
+        // (the refreshes after the start, to its end)
+        const double first = std::floor(std::chrono::duration<double>(start - vblank) / std::chrono::duration<double>(refresh)) + 1.0;
+        for (Clock::time_point at = vblank + std::chrono::duration_cast<Clock::duration>(refresh * first);
+             at <= start + span && count < kMaxMoments; at += refresh)
+        {
+            momentT[count] = static_cast<float>(std::clamp(std::chrono::duration<double>(at - start).count() / spanSeconds, 0.0, 1.0));
+            momentShowsNs[count] = ns(at);
+            ++count;
+        }
+    }
+    else
+    {
+        // (no word of the screen's refresh: a moment a VBlank)
+        for (uint64_t k = 1u; k <= perFrame && count < kMaxMoments; ++k)
+        {
+            momentT[count] = static_cast<float>(k) / static_cast<float>(perFrame);
+            momentShowsNs[count] = ns(start + period * static_cast<int64_t>(k));
+            ++count;
+        }
+    }
+    if (count == 0)
+    {
+        // (a screen slower than the frames: the frame's own pose, as its time ends)
+        momentT[0] = 1.0f;
+        momentShowsNs[0] = ns(start + span);
+        count = 1;
+    }
+    if (count > momentCap && fixedMoments.empty())
+    {
+        // (as many as the cap, spread over the frame and the last one kept: refreshes between show the
+        // one before them again)
+        float t[kMaxMoments];
+        int64_t shows[kMaxMoments];
+        for (int i = 0; i < momentCap; ++i)
+        {
+            const int from = static_cast<int>(std::lround(static_cast<double>(i + 1) * count / momentCap)) - 1;
+            t[i] = momentT[from];
+            shows[i] = momentShowsNs[from];
+        }
+        std::copy(t, t + momentCap, momentT);
+        std::copy(shows, shows + momentCap, momentShowsNs);
+        count = momentCap;
+        ++statMomentCapped;
+    }
+    momentCount = count;
+    momentsActive = true;
+    static int logLeft = []() { const char *env = std::getenv("PS2X_MOMENT_LOG"); return env ? std::atoi(env) : 0; }();
+    if (logLeft > 0)
+    {
+        --logLeft;
+        const int64_t nowNs = ns(Clock::now());
+        std::fprintf(stderr, "[gpu:moments] flip %llu (%llu VBlanks a frame): %d moments -", static_cast<unsigned long long>(flipTick),
+                     static_cast<unsigned long long>(perFrame), count);
+        for (int m = 0; m < count; ++m)
+            std::fprintf(stderr, " t %.3f in %.2f ms;", static_cast<double>(momentT[m]), static_cast<double>(momentShowsNs[m] - nowNs) / 1e6);
+        std::fprintf(stderr, "\n");
+    }
+    momentFirstRow = firstRow;
+    momentLastRow = lastRow;
+    momentBlock = block;
+    ++momentFrame;
+    ++statMomentFrames;
+    makePictureSlots(kMaxPictures);
+}
+
+// The moments' layers, the size of the buffer of both fields' field A (its rows above field B's)
+// at its scale: colour (R32UI, drawn through an RGBA8 view as the buffer is), depth, and copies.
+void GSGpuRenderer::Impl::ensureMomentLayers()
+{
+    const int w = batchFrame->width, h = static_cast<int>(momentFirstRow), sx = batchFrame->sx, sy = batchFrame->sy;
+    for (int m = 0; m < momentCount; ++m)
+    {
+        MomentLayer &layer = momentLayers[static_cast<size_t>(m)];
+        if (layer.color && layer.width == w && layer.height == h && layer.sx == sx && layer.sy == sy)
+            continue;
+        const GLuint textures[5] = {layer.view, layer.color, layer.depth, layer.alphaCopy, layer.fogIndex};
+        const GLuint renderbuffers[2] = {layer.msColor, layer.msDepth};
+        for (GLuint renderbuffer : renderbuffers)
+            if (renderbuffer)
+                glDeleteRenderbuffers(1, &renderbuffer);
+        if (layer.msFbo)
+            glDeleteFramebuffers(1, &layer.msFbo);
+        if (layer.resolved)
+            glDeleteTextures(1, &layer.resolved);
+        if (layer.resolveFbo)
+            glDeleteFramebuffers(1, &layer.resolveFbo);
+        layer.msColor = layer.msDepth = layer.msFbo = layer.resolved = layer.resolveFbo = 0u;
+        layer.msColorNewer = layer.msDepthNewer = false;
+        for (GLuint texture : textures)
+            if (texture)
+                glDeleteTextures(1, &texture);
+        if (layer.fbo)
+            glDeleteFramebuffers(1, &layer.fbo);
+        layer.color = makeTexture(GL_R32UI, w * sx, h * sy, GL_NEAREST);
+        glGenTextures(1, &layer.view);
+        glTextureView(layer.view, GL_TEXTURE_2D, layer.color, GL_RGBA8, 0, 1, 0, 1);
+        layer.depth = makeTexture(GL_DEPTH_COMPONENT32F, w * sx, h * sy, GL_NEAREST);
+        layer.alphaCopy = makeTexture(GL_R32UI, w * sx, h * sy, GL_NEAREST);
+        layer.fogIndex = makeTexture(GL_R32UI, w * sx, h * sy, GL_NEAREST);
+        glGenFramebuffers(1, &layer.fbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, layer.fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, layer.view, 0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, layer.depth, 0);
+        if (msaaSamples > 1)
+        {
+            glGenRenderbuffers(1, &layer.msColor);
+            glBindRenderbuffer(GL_RENDERBUFFER, layer.msColor);
+            glRenderbufferStorageMultisample(GL_RENDERBUFFER, msaaSamples, GL_RGBA8, w * sx, h * sy);
+            glGenRenderbuffers(1, &layer.msDepth);
+            glBindRenderbuffer(GL_RENDERBUFFER, layer.msDepth);
+            glRenderbufferStorageMultisample(GL_RENDERBUFFER, msaaSamples, GL_DEPTH_COMPONENT32F, w * sx, h * sy);
+            glBindRenderbuffer(GL_RENDERBUFFER, 0u);
+            glGenFramebuffers(1, &layer.msFbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, layer.msFbo);
+            glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, layer.msColor);
+            glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, layer.msDepth);
+            layer.resolved = makeTexture(GL_RGBA8, w * sx, h * sy, GL_NEAREST);
+            glGenFramebuffers(1, &layer.resolveFbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, layer.resolveFbo);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, layer.resolved, 0);
+        }
+        layer.width = w;
+        layer.height = h;
+        layer.sx = sx;
+        layer.sy = sy;
+        layer.alphaClock = ++alphaClock;
+        layer.alphaCopyClock = 0u;
+    }
+}
+
+// A run of the batch's vertices with the current draw entry (the moments pair field A's runs with
+// field B's).
+void GSGpuRenderer::Impl::noteMomentSegment(size_t first, size_t count, bool mesh)
+{
+    if (count == 0u)
+        return;
+    if (!momentSegments.empty())
+    {
+        MomentSegment &last = momentSegments.back();
+        if (last.entry == drawIndex && last.mesh == mesh && static_cast<size_t>(last.first) + last.count == first)
+        {
+            last.count += static_cast<uint32_t>(count);
+            return;
+        }
+    }
+    momentSegments.push_back({drawIndex, static_cast<uint32_t>(first), static_cast<uint32_t>(count), ofy, mesh});
+}
+
+// What each moment of the frame draws of the batch: its runs of vertices, in order, as pieces for
+GSGpuRenderer::Impl::CarrySlot *GSGpuRenderer::Impl::carrySlot(uint64_t key, bool make)
+{
+    uint32_t at = static_cast<uint32_t>(key ^ (key >> 29)) & (kCarrySlots - 1u);
+    for (uint32_t probe = 0; probe < kCarrySlots / 2u; ++probe, at = (at + 1u) & (kCarrySlots - 1u))
+    {
+        CarrySlot &slot = carrySlots[at];
+        if (slot.key == key)
+            return &slot;
+        if (slot.key == 0u)
+        {
+            if (!make)
+                return nullptr;
+            slot = CarrySlot{key, 0u, 0u, 0u, 0u};
+            carrySlotsUsed.push_back(at);
+            return &slot;
+        }
+    }
+    return nullptr; // (too many kinds in a frame: the rest new each frame)
+}
+
+bool GSGpuRenderer::Impl::carryKind(uint64_t key, bool add)
+{
+    uint32_t at = static_cast<uint32_t>(key ^ (key >> 31)) & (kCarryKindSlots - 1u);
+    for (uint32_t probe = 0; probe < kCarryKindSlots / 2u; ++probe, at = (at + 1u) & (kCarryKindSlots - 1u))
+    {
+        if (carryKinds[at] == key)
+            return true;
+        if (carryKinds[at] == 0u)
+        {
+            if (add && carryKindCount < kCarryKindSlots / 2u)
+            {
+                carryKinds[at] = key;
+                ++carryKindCount;
+                return true;
+            }
+            return false;
+        }
+    }
+    return false;
+}
+
+// At each flip: the frame just drawn's notes become the frame before's, each kind's in the order they
+// came (counted, then placed: no sorting, no allocation once the vectors have grown).
+void GSGpuRenderer::Impl::carrySwap()
+{
+    for (const uint32_t at : carrySlotsUsed)
+        carrySlots[at].key = 0u;
+    carrySlotsUsed.clear();
+    carryNow = 1 - carryNow;
+    carryRuns[carryNow].clear();
+    carryStore[carryNow].clear();
+    const std::vector<CarryRun> &before = carryRuns[1 - carryNow];
+    for (const CarryRun &r : before)
+        if (CarrySlot *slot = carrySlot(r.key, true))
+            ++slot->count;
+    uint32_t next = 0u;
+    for (const uint32_t at : carrySlotsUsed)
+    {
+        CarrySlot &slot = carrySlots[at];
+        slot.first = next;
+        next += slot.count;
+        slot.count = 0u;
+    }
+    carryOrder.resize(before.size());
+    for (uint32_t i = 0; i < before.size(); ++i)
+    {
+        CarrySlot *slot = carrySlot(before[i].key, false);
+        carryOrder[slot->first + slot->count++] = i;
+    }
+}
+
+bool GSGpuRenderer::Impl::carryFrom(const MomentSegment &a, const MomentSegment &b, float shift, uint32_t &from)
+{
+    const GpuDraw &d = draws[a.entry];
+    // (what stays the same frame to frame: not the batch's slots - the texture's, the CLUT's)
+    uint64_t key = 1469598103934665603ull;
+    const auto mix = [&](uint64_t v)
+    {
+        key ^= v;
+        key *= 1099511628211ull;
+    };
+    mix(d.tex0[0] | (d.tex0[2] << 4u) | (static_cast<uint64_t>(d.tex1[2]) << 16u) | (static_cast<uint64_t>(d.tex1[3]) << 40u));
+    mix(d.blend[0] | (d.blend[1] << 1u) | (static_cast<uint64_t>(d.blend[2]) << 9u) | (static_cast<uint64_t>(d.test[0]) << 17u) |
+        (static_cast<uint64_t>(d.test[1]) << 18u) | (static_cast<uint64_t>(d.test[2] & 0xFFu) << 21u) | (static_cast<uint64_t>(d.depth[0]) << 29u) |
+        (static_cast<uint64_t>(d.depth[1]) << 31u) | (static_cast<uint64_t>(d.misc[1]) << 32u) | (static_cast<uint64_t>(d.fog[0]) << 33u));
+    mix(d.frame[1] | (static_cast<uint64_t>(a.count) << 32u));
+    key |= key == 0u ? 1u : 0u;
+    const bool kept = carryKind(key, false);
+    std::vector<CarryRun> &now = carryRuns[carryNow];
+    std::vector<GpuVertex> &store = carryStore[carryNow];
+    uint32_t stored = ~0u;
+    if (kept)
+    {
+        stored = static_cast<uint32_t>(store.size());
+        store.insert(store.end(), vertices.begin() + a.first, vertices.begin() + a.first + a.count);
+    }
+    now.push_back({key, vertices[a.first].x, vertices[a.first].y, stored, a.count});
+    CarrySlot *slot = carrySlot(key, false);
+    if (!slot || slot->count == 0u)
+    {
+        ++statCarryNew;
+        return false;
+    }
+    const uint32_t seen = slot->seen++;
+    if (slot->count > kCarryDense)
+        return false; // (as it is: neither looked for nor counted)
+    const std::vector<CarryRun> &before = carryRuns[1 - carryNow];
+    const std::vector<GpuVertex> &beforeStore = carryStore[1 - carryNow];
+    const float bx = vertices[b.first].x, by = vertices[b.first].y + shift;
+    const auto near = [&](const CarryRun &r) { return std::max(std::fabs(r.x - bx), std::fabs(r.y - by)); };
+    constexpr float kSame = 0.13f; // (the GS's sixteenths of a pixel, twice)
+    // The one in the same place among them first: nearly always the same piece, where it was.
+    if (seen < slot->count && near(before[carryOrder[slot->first + seen]]) <= kSame)
+    {
+        ++statCarryKept;
+        return false;
+    }
+    // The four nearest by the first vertex, then by all of them (where they were kept): the one whose
+    // whole run is nearest, when no other is nearly as near (a neighbouring blade of grass has another
+    // shape too).
+    constexpr int kAsk = 4;
+    float firstOff[kAsk];
+    uint32_t asked[kAsk];
+    int askedCount = 0;
+    for (uint32_t k = 0; k < slot->count; ++k)
+    {
+        const uint32_t index = carryOrder[slot->first + k];
+        const float distance = near(before[index]);
+        if (distance > kCarryReach || (askedCount == kAsk && distance >= firstOff[kAsk - 1]))
+            continue;
+        int at = askedCount < kAsk ? askedCount++ : kAsk - 1;
+        while (at > 0 && firstOff[at - 1] > distance)
+        {
+            firstOff[at] = firstOff[at - 1];
+            asked[at] = asked[at - 1];
+            --at;
+        }
+        firstOff[at] = distance;
+        asked[at] = index;
+    }
+    if (askedCount > 0 && firstOff[0] <= kSame)
+    {
+        ++statCarryKept; // (where the frame before left one: another order)
+        return false;
+    }
+    // (moved from where one was left: a kind carried from now on)
+    if (!kept)
+    {
+        if (askedCount > 0)
+            carryKind(key, true);
+        ++statCarryLeft;
+        return false;
+    }
+    const auto apart = [&](const CarryRun &r)
+    {
+        float most = 0.0f;
+        for (uint32_t i = 0; i < b.count; ++i)
+        {
+            const GpuVertex &v = vertices[b.first + i], &w = beforeStore[r.stored + i];
+            most = std::max(most, std::max(std::fabs(v.x - w.x), std::fabs(v.y + shift - w.y)));
+        }
+        return most;
+    };
+    float d1 = 1.0e30f, d2 = 1.0e30f;
+    uint32_t best = ~0u;
+    for (int i = 0; i < askedCount; ++i)
+    {
+        const CarryRun &r = before[asked[i]];
+        if (r.stored == ~0u)
+            continue;
+        const float distance = apart(r);
+        if (distance < d1)
+        {
+            d2 = d1;
+            d1 = distance;
+            best = asked[i];
+        }
+        else if (distance < d2)
+            d2 = distance;
+    }
+    if (best == ~0u || d1 > kCarryReach || d2 < 4.0f * d1 + 1.0f)
+    {
+        ++statCarryLeft;
+        if (continuity)
+        {
+            const uint64_t kind = key;
+            ContinuityKind &k = continuityKinds[kind];
+            if (k.what.empty())
+            {
+                char text[200];
+                std::snprintf(text, sizeof(text), "%s %u vertices, tex %s psm %u %ux%u, blend %s%02x fix %u, atst %u ztst %u zwrite %u fbmsk %08x",
+                              d.misc[1] != 0u ? "sprites" : "triangles", b.count,
+                              d.tex0[0] == 0u ? "-" : (d.tex0[1] >= 5u ? "pack" : (d.tex0[1] >= 1u ? "buffer" : "memory")), d.tex0[2], d.tex1[2],
+                              d.tex1[3], d.blend[0] ? "" : "off ", d.blend[1], d.blend[2], d.test[0] ? d.test[1] : 9u, d.depth[0], d.depth[1],
+                              d.frame[1]);
+                k.what = text;
+            }
+            const double off = best != ~0u ? static_cast<double>(std::min(d1, 1.0e6f)) : 1.0e6;
+            ++k.runs;
+            k.vertices += b.count;
+            k.most = std::max(k.most, off);
+            ++k.apart[off <= 1.0 ? 0 : (off <= 4.0 ? 1 : (off <= 16.0 ? 2 : 3))];
+        }
+        return false;
+    }
+    // (field B where the frame before left it: its field A then, already in field A's rows)
+    const CarryRun &r = before[best];
+    from = static_cast<uint32_t>(vertices.size());
+    vertices.insert(vertices.end(), beforeStore.begin() + r.stored, beforeStore.begin() + r.stored + r.count);
+    ++statCarried;
+    return true;
+}
+
+// kMomentLerp - field A's run and field B's of the same draws (draw entries the same but for the
+// rows of the scissor, as many vertices) mixed at the moment; field A's alone at the moments in the
+// frame's second half, field B's alone in its first (moved into field A's rows, with an entry for
+// those rows); what goes over both fields at every moment. Returns how many vertices they make.
+size_t GSGpuRenderer::Impl::prepareMoments()
+{
+    for (int m = 0; m < kMaxMoments; ++m)
+    {
+        momentPieces[static_cast<size_t>(m)].clear();
+        momentRuns[static_cast<size_t>(m)].clear();
+    }
+    momentPieceList.clear();
+    uint32_t sizes[kMaxMoments] = {};
+    const int firstRow = static_cast<int>(momentFirstRow), lastRow = static_cast<int>(momentLastRow);
+    const auto fieldOf = [&](uint32_t entry)
+    {
+        const GpuDraw &d = draws[entry];
+        if (d.scissor[3] < firstRow)
+            return 0; // field A
+        if (d.scissor[1] >= firstRow && d.scissor[3] <= lastRow)
+            return 1; // field B
+        return 2;     // both
+    };
+    const auto twins = [&](uint32_t a, uint32_t b)
+    {
+        GpuDraw x = draws[a];
+        const GpuDraw &y = draws[b];
+        if (y.scissor[1] != x.scissor[1] + firstRow || y.scissor[3] != x.scissor[3] + firstRow)
+            return false;
+        x.scissor[1] = y.scissor[1];
+        x.scissor[3] = y.scissor[3];
+        return std::memcmp(&x, &y, sizeof(GpuDraw)) == 0;
+    };
+    const auto put = [&](int m, uint32_t a, uint32_t b, uint32_t count, uint32_t entry, float shift, float t)
+    {
+        const GpuDraw &d = draws[entry];
+        const uint32_t key = (batchDepth ? d.depth[0] : 1u) | ((batchDepth && d.depth[1] != 0u) ? 4u : 0u);
+        auto &runs = momentRuns[static_cast<size_t>(m)];
+        if (runs.empty() || runs.back().key != key)
+            runs.push_back({sizes[m], key});
+        // Every piece mixed on the screen's straight line. PS2X_MOMENT_PERSPECTIVE=1 mixes a draw
+        // with an STQ texture in perspective instead (its vertices' paths in the scene) - but only
+        // those draws have the Q for it, and a piece beside them that has none is mixed on the
+        // straight line: at the moments halfway the two part along their shared edges (the user
+        // saw parts of the player's model jump, a dark wedge between chest and shoulder, and the
+        // water; 2026-10-08). Off by default since.
+        static const bool perspective = envFlag("PS2X_MOMENT_PERSPECTIVE", false);
+        const uint32_t flags = perspective && d.tex0[0] == 2u ? 1u : 0u;
+        momentPieces[static_cast<size_t>(m)].push_back({sizes[m], a, b, count, entry, shift, t, flags});
+        sizes[m] += count;
+    };
+    static int pairLogLeft = []()
+    {
+        const char *env = std::getenv("PS2X_MOMENT_LOG_PAIRS");
+        return env ? std::atoi(env) : 0;
+    }();
+    static const std::pair<uint64_t, uint64_t> runLogTicks = []()
+    {
+        unsigned long long from = 0u, to = 0u;
+        if (const char *env = std::getenv("PS2X_MOMENT_LOG_RUNS"))
+            std::sscanf(env, "%llu-%llu", &from, &to);
+        return std::pair<uint64_t, uint64_t>(from, to);
+    }();
+    const bool logRuns = lastFlipTick >= runLogTicks.first && lastFlipTick <= runLogTicks.second && runLogTicks.second != 0u;
+    static const std::array<float, 4> logBox = []()
+    {
+        std::array<float, 4> box{-1.0e30f, -1.0e30f, 1.0e30f, 1.0e30f};
+        if (const char *env = std::getenv("PS2X_MOMENT_LOG_BOX"))
+            std::sscanf(env, "%f,%f,%f,%f", &box[0], &box[1], &box[2], &box[3]);
+        return box;
+    }();
+    const auto logRun = [&](const char *what, const MomentSegment &a, const MomentSegment *b)
+    {
+        if (!logRuns)
+            return;
+        {
+            float x0 = 1.0e30f, y0 = 1.0e30f, x1 = -1.0e30f, y1 = -1.0e30f;
+            for (uint32_t v = 0; v < a.count; ++v)
+            {
+                const GpuVertex &q = vertices[a.first + v];
+                x0 = std::min(x0, q.x);
+                y0 = std::min(y0, q.y);
+                x1 = std::max(x1, q.x);
+                y1 = std::max(y1, q.y);
+            }
+            if (x1 < logBox[0] || x0 > logBox[2] || y1 < logBox[1] || y0 > logBox[3])
+                return;
+        }
+        const auto box = [&](const MomentSegment &r, float *out)
+        {
+            out[0] = out[1] = 1.0e30f;
+            out[2] = out[3] = -1.0e30f;
+            for (uint32_t v = 0; v < r.count; ++v)
+            {
+                const GpuVertex &q = vertices[r.first + v];
+                out[0] = std::min(out[0], q.x);
+                out[1] = std::min(out[1], q.y);
+                out[2] = std::max(out[2], q.x);
+                out[3] = std::max(out[3], q.y);
+            }
+        };
+        float ba[4], bb[4] = {0, 0, 0, 0};
+        box(a, ba);
+        if (b)
+            box(*b, bb);
+        const GpuDraw &d = draws[a.entry];
+        std::fprintf(stderr,
+                     "[gpu:runs] flip %llu %s: A %u vertices x %.0f-%.0f y %.0f-%.0f%s; B %u vertices x %.0f-%.0f y %.0f-%.0f; tex %s psm %u, "
+                     "blend %02x, atst %u, ztst %u zwrite %u, prim %s%s\n",
+                     static_cast<unsigned long long>(lastFlipTick), what, a.count, ba[0], ba[2], ba[1], ba[3], a.mesh ? " (mesh)" : "",
+                     b ? b->count : 0u, bb[0], bb[2], bb[1], bb[3],
+                     d.tex0[0] == 0u ? "-" : (d.tex0[1] >= 5u ? "pack" : (d.tex0[1] >= 1u ? "buffer" : "memory")), d.tex0[2],
+                     d.blend[0] ? d.blend[1] : 0u, d.test[0] ? d.test[1] : 9u, d.depth[0], d.depth[1], d.misc[1] != 0u ? "sprites" : "triangles",
+                     b && b->mesh ? " (B mesh)" : "");
+        // (with a box: the first vertices of both fields)
+        if (logBox[0] > -1.0e29f)
+            for (uint32_t v = 0; v < std::min<uint32_t>(a.count, 6u); ++v)
+            {
+                const GpuVertex &p = vertices[a.first + v];
+                std::fprintf(stderr, "[gpu:runs]   A%u x %.2f y %.2f z %.0f s %.4f t %.4f q %.5f rgba %u %u %u %u", v, p.x, p.y, static_cast<double>(p.z), p.s,
+                             p.t, p.q, p.r, p.g, p.b, p.a);
+                if (b && v < b->count)
+                {
+                    const GpuVertex &q = vertices[b->first + v];
+                    std::fprintf(stderr, " | B x %.2f y %.2f z %.0f s %.4f t %.4f q %.5f rgba %u %u %u %u", q.x, q.y, static_cast<double>(q.z), q.s, q.t,
+                                 q.q, q.r, q.g, q.b, q.a);
+                }
+                std::fprintf(stderr, "\n");
+            }
+    };
+    // Twin runs with not as many vertices (a primitive one field leaves out and the other does not
+    // - in Transformers a blade of grass past the screen's edge in one field): matched primitive by
+    // primitive (three vertices a triangle, six a sprite's quad), in order, by what does not move
+    // between the fields - colour and texture coordinates - and by being near (B in A's rows); runs
+    // of matched ones mixed, what one field alone has drawn from that field. False when they do not
+    // match well enough (then the nearer field's run, as before).
+    const auto alignRuns = [&](const MomentSegment &a, const MomentSegment &b, float shift)
+    {
+        const uint32_t size = draws[a.entry].misc[1] != 0u ? 6u : 3u;
+        if (a.count % size != 0u || b.count % size != 0u)
+            return false;
+        const uint32_t na = a.count / size, nb = b.count / size;
+        const auto texel = [](const GpuVertex &v, int k)
+        {
+            const float q = std::fabs(v.q) > 1.0e-20f ? v.q : 1.0f;
+            return std::lround(static_cast<double>(k == 0 ? v.s : v.t) / q * 16.0);
+        };
+        const auto same = [&](uint32_t i, uint32_t j)
+        {
+            for (uint32_t k = 0; k < size; ++k)
+            {
+                const GpuVertex &p = vertices[a.first + i * size + k], &q = vertices[b.first + j * size + k];
+                if (p.r != q.r || p.g != q.g || p.b != q.b || p.a != q.a || texel(p, 0) != texel(q, 0) || texel(p, 1) != texel(q, 1) ||
+                    std::fabs(p.x - q.x) + std::fabs(p.y - (q.y + shift)) > 32.0f)
+                    return false;
+            }
+            return true;
+        };
+        // (i, j) pairs matched, in order; the rest of either alone
+        thread_local std::vector<std::pair<uint32_t, uint32_t>> matched;
+        matched.clear();
+        uint32_t i = 0u, j = 0u;
+        while (i < na && j < nb)
+        {
+            if (same(i, j))
+            {
+                matched.emplace_back(i++, j++);
+                continue;
+            }
+            // (one or more left out of the other field: look a few ahead)
+            bool found = false;
+            for (uint32_t ahead = 1u; ahead <= 4u && !found; ++ahead)
+            {
+                if (j + ahead < nb && same(i, j + ahead))
+                {
+                    j += ahead;
+                    found = true;
+                }
+                else if (i + ahead < na && same(i + ahead, j))
+                {
+                    i += ahead;
+                    found = true;
+                }
+            }
+            if (!found)
+            {
+                ++i;
+                ++j;
+            }
+        }
+        if (matched.size() * 2u < std::min(na, nb))
+            return false;
+        // the pieces, in field A's order: runs of matched primitives mixed, A's alone in the frame's
+        // second half, B's alone in its first (each where it falls among the matched ones)
+        uint32_t ai = 0u, bj = 0u;
+        size_t at = 0u;
+        while (ai < na || bj < nb)
+        {
+            if (at < matched.size() && matched[at].first == ai && matched[at].second == bj)
+            {
+                size_t end = at + 1u;
+                while (end < matched.size() && matched[end].first == matched[end - 1u].first + 1u &&
+                       matched[end].second == matched[end - 1u].second + 1u)
+                    ++end;
+                const uint32_t run = static_cast<uint32_t>(end - at);
+                for (int m = 0; m < momentCount; ++m)
+                    put(m, a.first + ai * size, b.first + bj * size, run * size, a.entry, shift, momentT[m]);
+                ai += run;
+                bj += run;
+                at = end;
+                continue;
+            }
+            const uint32_t nextA = at < matched.size() ? matched[at].first : na;
+            const uint32_t nextB = at < matched.size() ? matched[at].second : nb;
+            if (ai < nextA)
+            {
+                for (int m = 0; m < momentCount; ++m)
+                    if (momentT[m] >= 0.5f)
+                        put(m, a.first + ai * size, a.first + ai * size, (nextA - ai) * size, a.entry, 0.0f, 1.0f);
+                ai = nextA;
+            }
+            if (bj < nextB)
+            {
+                for (int m = 0; m < momentCount; ++m)
+                    if (momentT[m] < 0.5f)
+                        put(m, b.first + bj * size, b.first + bj * size, (nextB - bj) * size, a.entry, shift, 0.0f);
+                bj = nextB;
+            }
+        }
+        return true;
+    };
+    for (size_t i = 0; i < momentSegments.size(); ++i)
+    {
+        const MomentSegment s = momentSegments[i];
+        const int field = fieldOf(s.entry);
+        // A run of field A's pieces followed by as many of field B's, each the twin of the one
+        // in A's run (a batch the clipper split: its polygons, then its strip, field by field).
+        if (field == 0 && i + 1u < momentSegments.size() && fieldOf(momentSegments[i + 1u].entry) == 0)
+        {
+            size_t aEnd = i;
+            while (aEnd < momentSegments.size() && fieldOf(momentSegments[aEnd].entry) == 0)
+                ++aEnd;
+            const size_t length = aEnd - i;
+            bool block = aEnd + length <= momentSegments.size();
+            for (size_t k = 0; block && k < length; ++k)
+            {
+                const MomentSegment &a = momentSegments[i + k], &b = momentSegments[aEnd + k];
+                block = fieldOf(b.entry) == 1 && a.count == b.count && twins(a.entry, b.entry);
+            }
+            if (block)
+            {
+                for (size_t k = 0; k < length; ++k)
+                {
+                    const MomentSegment &a = momentSegments[i + k], &b = momentSegments[aEnd + k];
+                    const float shift = b.ofy - a.ofy;
+                    momentShift = shift;
+                    for (int m = 0; m < momentCount; ++m)
+                        put(m, a.first, b.first, a.count, a.entry, shift, momentT[m]);
+                    ++statMomentPairs;
+                }
+                i = aEnd + length - 1u;
+                continue;
+            }
+        }
+        if (pairLogLeft > 0 && field == 0 && i + 1u < momentSegments.size() && fieldOf(momentSegments[i + 1u].entry) == 1 &&
+            (!twins(s.entry, momentSegments[i + 1u].entry) || momentSegments[i + 1u].count != s.count))
+        {
+            --pairLogLeft;
+            const MomentSegment &n = momentSegments[i + 1u];
+            uint32_t x[56], y[56];
+            std::memcpy(x, &draws[s.entry], sizeof(GpuDraw));
+            std::memcpy(y, &draws[n.entry], sizeof(GpuDraw));
+            std::string differ;
+            static const char *kWords[14] = {"tex0", "tex1", "tex2", "region", "texScale", "clut", "texa", "fog", "test", "depth", "blend",
+                                             "frame", "scissor", "misc"};
+            for (int w = 0; w < 56; ++w)
+                if (x[w] != y[w])
+                {
+                    char text[64];
+                    std::snprintf(text, sizeof(text), " %s[%d] %x|%x", kWords[w / 4], w % 4, x[w], y[w]);
+                    differ += text;
+                }
+            const GpuDraw &d = draws[s.entry];
+            std::fprintf(stderr, "[gpu:pairs] A %u vertices, B %u vertices; differ:%s; draw: tex %s psm %u, blend %02x, atst %u/%u, ztst %u zwrite %u, frame bits %u fbmsk %08x%s%s\n",
+                         s.count, n.count, differ.c_str(),
+                         d.tex0[0] == 0u ? "-" : (d.tex0[1] >= 5u ? "pack" : (d.tex0[1] >= 1u ? "buffer" : "memory")), d.tex0[2],
+                         d.blend[0] ? d.blend[1] : 0u, d.test[0] ? d.test[1] : 9u, d.test[2], d.depth[0], d.depth[1], d.frame[2], d.frame[1],
+                         s.mesh ? " (mesh A)" : "", n.mesh ? " (mesh B)" : "");
+        }
+        if (field == 0 && i + 1u < momentSegments.size() && fieldOf(momentSegments[i + 1u].entry) == 1 &&
+            twins(s.entry, momentSegments[i + 1u].entry))
+        {
+            const MomentSegment b = momentSegments[++i];
+            const float shift = b.ofy - s.ofy;
+            momentShift = shift;
+            static const bool allNearest = envFlag("PS2X_MOMENT_NEAREST", false); // (testing aid: no pair mixed)
+            if (b.count == s.count && !allNearest)
+            {
+                logRun("pair", s, &b);
+                uint32_t from = b.first;
+                float fromShift = shift;
+                if (carry && !momentMainToo && !s.mesh && !b.mesh && carryFrom(s, b, shift, from))
+                    fromShift = 0.0f;
+                for (int m = 0; m < momentCount; ++m)
+                    put(m, s.first, from, s.count, s.entry, fromShift, momentT[m]);
+                ++statMomentPairs;
+            }
+            else if (!allNearest && alignRuns(s, b, shift))
+            {
+                ++statMomentAligned;
+                logRun("aligned", s, &b);
+            }
+            else
+            {
+                logRun("NEARER FIELD", s, &b);
+                // (not the same primitives - a clipped batch: the nearer field's)
+                for (int m = 0; m < momentCount; ++m)
+                {
+                    if (momentT[m] >= 0.5f)
+                        put(m, s.first, s.first, s.count, s.entry, 0.0f, 1.0f);
+                    else
+                        put(m, b.first, b.first, b.count, s.entry, shift, 0.0f);
+                }
+                ++statMomentMismatched;
+            }
+            continue;
+        }
+        if (field == 2)
+        {
+            for (int m = 0; m < momentCount; ++m)
+                put(m, s.first, s.first, s.count, s.entry, 0.0f, 1.0f);
+            ++statMomentWhole;
+            logRun("both fields", s, nullptr);
+            continue;
+        }
+        if (field == 0)
+        {
+            for (int m = 0; m < momentCount; ++m)
+                if (momentT[m] >= 0.5f)
+                    put(m, s.first, s.first, s.count, s.entry, 0.0f, 1.0f);
+            ++statMomentLoneA;
+            logRun("A ALONE", s, nullptr);
+            continue;
+        }
+        logRun("B ALONE", s, nullptr);
+        // field B's alone: an entry of its own for field A's rows
+        GpuDraw twin = draws[s.entry];
+        twin.scissor[1] = std::max(0, twin.scissor[1] - firstRow);
+        twin.scissor[3] = twin.scissor[3] - firstRow;
+        const uint32_t entry = static_cast<uint32_t>(draws.size());
+        draws.push_back(twin);
+        for (int m = 0; m < momentCount; ++m)
+            if (momentT[m] < 0.5f)
+                put(m, s.first, s.first, s.count, entry, momentShift, 0.0f);
+        ++statMomentLoneB;
+    }
+    // (each moment's after the batch's own vertices and the moments' before it)
+    uint32_t base = static_cast<uint32_t>(vertices.size());
+    for (int m = 0; m < kMaxMoments; ++m)
+    {
+        for (MomentPiece piece : momentPieces[static_cast<size_t>(m)])
+        {
+            piece.dst += base;
+            momentPieceList.push_back(piece);
+        }
+        for (NativeRun &run : momentRuns[static_cast<size_t>(m)])
+            run.first += base;
+        base += sizes[m];
+        momentEnds[static_cast<size_t>(m)] = base;
+    }
+    return base - vertices.size();
+}
+
+// The batch at the frame's moments: their vertices made (kMomentLerp), then each moment drawn into
+// its layer as the native path draws (the layer's own depth; Ad from a copy of the layer's colour;
+// the depth fog reading the moment's own depth).
+void GSGpuRenderer::Impl::drawMoments(size_t made)
+{
+    if (made == 0u || momentPieceList.empty())
+        return;
+    const uint32_t first = static_cast<uint32_t>(vertices.size());
+    glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT); // (the meshes' vertices, made by kMeshExpand)
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, momentPieceBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(momentPieceList.size() * sizeof(MomentPiece)), momentPieceList.data(),
+                 GL_STREAM_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 4, momentPieceBuffer);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 7, vbo);
+    glUseProgram(momentLerpProgram);
+    glUniform1ui(momentPiecesLocation, static_cast<GLuint>(momentPieceList.size()));
+    glUniform1ui(momentVerticesLocation, static_cast<GLuint>(made));
+    glUniform1ui(momentFirstLocation, first);
+    glDispatchCompute(static_cast<GLuint>((made + 63u) / 64u), 1u, 1u);
+    glMemoryBarrier(GL_VERTEX_ATTRIB_ARRAY_BARRIER_BIT);
+    ensureMomentLayers();
+    const uint32_t bits = batchNativeBits ? batchNativeBits : 24u;
+
+    // Transformers' depth fog: each moment's depth as the fog reads the depth buffer.
+    if (momentFogSlot >= 0)
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, momentFogFbo);
+        glDisable(GL_SCISSOR_TEST);
+        glUseProgram(momentFogProgram);
+        glUniform1f(momentFogScaleLocation, bits >= 32u ? 4294967296.0f : static_cast<float>(1u << bits));
+        glBindVertexArray(emptyVao);
+        glActiveTexture(GL_TEXTURE20);
+        for (int m = 0; m < momentCount; ++m)
+        {
+            MomentLayer &layer = momentLayers[static_cast<size_t>(m)];
+            if (layer.msDepthNewer)
+            {
+                resolveLayer(layer, false, true);
+                glBindFramebuffer(GL_FRAMEBUFFER, momentFogFbo);
+                glDisable(GL_SCISSOR_TEST);
+            }
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, layer.fogIndex, 0);
+            glViewport(0, 0, layer.width * layer.sx, layer.height * layer.sy);
+            glUniform2i(momentFogPixelLocation, momentBlockyProgram ? layer.sx : 1, momentBlockyProgram ? layer.sy : 1);
+            glBindTexture(GL_TEXTURE_2D, layer.depth);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+        }
+        glBindTexture(GL_TEXTURE_2D, 0u);
+        glActiveTexture(GL_TEXTURE0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0u, 0);
+        if (momentBlockyProgram)
+        {
+            glUseProgram(momentBlockyProgram);
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(GL_ALWAYS);
+            glDepthMask(GL_TRUE);
+            glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+            glActiveTexture(GL_TEXTURE20);
+            for (int m = 0; m < momentCount; ++m)
+            {
+                const MomentLayer &layer = momentLayers[static_cast<size_t>(m)];
+                const int w = layer.width * layer.sx, h = layer.height * layer.sy;
+                if (momentDepthCopyW != w || momentDepthCopyH != h)
+                {
+                    if (momentDepthCopy)
+                        glDeleteTextures(1, &momentDepthCopy);
+                    momentDepthCopy = makeTexture(GL_DEPTH_COMPONENT32F, w, h, GL_NEAREST);
+                    momentDepthCopyW = w;
+                    momentDepthCopyH = h;
+                }
+                glCopyImageSubData(layer.depth, GL_TEXTURE_2D, 0, 0, 0, 0, momentDepthCopy, GL_TEXTURE_2D, 0, 0, 0, 0, w, h, 1);
+                glBindFramebuffer(GL_FRAMEBUFFER, layer.fbo);
+                glViewport(0, 0, w, h);
+                glUniform2i(momentBlockyScaleLocation, layer.sx, layer.sy);
+                glBindTexture(GL_TEXTURE_2D, momentDepthCopy);
+                glDrawArrays(GL_TRIANGLES, 0, 3);
+            }
+            glBindTexture(GL_TEXTURE_2D, 0u);
+            glActiveTexture(GL_TEXTURE0);
+            glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+            glDisable(GL_DEPTH_TEST);
+        }
+        glBindVertexArray(vao);
+        glEnable(GL_SCISSOR_TEST);
+        ++statMomentFogs;
+    }
+
+    glViewport(0, 0, viewportX, viewportY);
+    const int v = batchGsTextures ? 0 : 1;
+    glUseProgram(nativePrograms[v]);
+    bindSourceViews(v, sourceViews, sourceCount); // (the depth fog's slot is T8H: never read through a view)
+    glUniform4f(nativeTargetLocations[v], static_cast<float>(viewportX), static_cast<float>(viewportY), static_cast<float>(batchFrame->sx),
+                static_cast<float>(batchFrame->sy));
+    glUniform2f(nativeDepthLocations[v], bits >= 32u ? 1.0f / 4294967296.0f : 1.0f / static_cast<float>(1u << bits),
+                bits >= 32u ? 4294967295.0f : static_cast<float>((1u << bits) - 1u));
+    glEnable(GL_BLEND);
+    glDisable(GL_DITHER);
+    glBlendEquation(GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_ONE, GL_SRC1_COLOR, GL_ONE, GL_SRC1_ALPHA);
+    if (batchDepth)
+        glEnable(GL_DEPTH_TEST);
+    int pass = -1;
+    if (profile && !momentPieceList.empty())
+    {
+        // (PS2X_GPU_PROFILE: by the kind of the batch's first draw - textured from memory, a
+        // replacement or a buffer; the blend; the alpha test; the depth test and write)
+        const GpuDraw &d = draws[momentPieceList.front().entry];
+        char name[160];
+        std::snprintf(name, sizeof(name), "moments: tex %s psm %u, blend %s %02x, atst %u/%u, ztst %u zwrite %u, %zu pieces",
+                      d.tex0[0] == 0u ? "-" : (d.tex0[1] >= 5u ? "pack" : (d.tex0[1] >= 1u ? "buffer" : "memory")), d.tex0[2],
+                      d.blend[0] ? "on" : "off", d.blend[1], d.test[0] ? d.test[1] : 9u, d.test[2], d.depth[0], d.depth[1],
+                      momentPieceList.size() > 4000u ? size_t(4000) : (momentPieceList.size() / 500u) * 500u);
+        pass = passEntry(name);
+        PassTime &t = passTimes[static_cast<size_t>(pass)];
+        ++t.batches;
+        t.vertices += made;
+    }
+    timeBegin(0, pass);
+    for (int m = 0; m < momentCount; ++m)
+    {
+        const auto &runs = momentRuns[static_cast<size_t>(m)];
+        if (runs.empty())
+            continue;
+        MomentLayer &layer = momentLayers[static_cast<size_t>(m)];
+        if (batchReadsAlpha && layer.alphaCopyClock != layer.alphaClock)
+        {
+            resolveLayer(layer, true, false);
+            glCopyImageSubData(layer.color, GL_TEXTURE_2D, 0, 0, 0, 0, layer.alphaCopy, GL_TEXTURE_2D, 0, 0, 0, 0, layer.width * layer.sx,
+                               layer.height * layer.sy, 1);
+            layer.alphaCopyClock = layer.alphaClock;
+            ++statAlphaCopies;
+        }
+        glBindFramebuffer(GL_FRAMEBUFFER, layer.msFbo ? layer.msFbo : layer.fbo);
+        glScissor(0, 0, layer.width * layer.sx, layer.height * layer.sy);
+        glBindImageTexture(7, batchReadsAlpha ? layer.alphaCopy : dummyImage, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+        std::array<GLint, 8> sizes = sourceSizes, scales = sourceScales;
+        if (momentFogSlot >= 0)
+        {
+            const size_t slot = static_cast<size_t>(momentFogSlot);
+            glBindImageTexture(2u + static_cast<GLuint>(slot), layer.fogIndex, 0, GL_FALSE, 0, GL_READ_ONLY, GL_R32UI);
+            sizes[2u * slot] = layer.width * layer.sx;
+            sizes[2u * slot + 1u] = layer.height * layer.sy;
+            scales[2u * slot] = layer.sx;
+            scales[2u * slot + 1u] = layer.sy;
+        }
+        if (nativeSourceSizeLocations[v] >= 0)
+            glUniform2iv(nativeSourceSizeLocations[v], 4, sizes.data());
+        if (nativeSourceScaleLocations[v] >= 0)
+            glUniform2iv(nativeSourceScaleLocations[v], 4, scales.data());
+        for (size_t i = 0; i < runs.size(); ++i)
+        {
+            const uint32_t from = runs[i].first;
+            const uint32_t to = i + 1u < runs.size() ? runs[i + 1u].first : momentEnds[static_cast<size_t>(m)];
+            if (to <= from)
+                continue;
+            if (batchDepth)
+            {
+                const uint32_t ztst = runs[i].key & 3u;
+                glDepthFunc(ztst == 2u ? GL_GEQUAL : (ztst == 3u ? GL_GREATER : GL_ALWAYS));
+                glDepthMask((runs[i].key & 4u) != 0u ? GL_TRUE : GL_FALSE);
+            }
+            glDrawArrays(GL_TRIANGLES, static_cast<GLint>(from), static_cast<GLsizei>(to - from));
+        }
+        if (batchWritesAlpha)
+            layer.alphaClock = ++alphaClock;
+        if (layer.msFbo)
+            layer.msColorNewer = layer.msDepthNewer = true;
+    }
+    timeEnd();
+    if (momentFogSlot >= 0)
+        glBindImageTexture(2u + static_cast<GLuint>(momentFogSlot), sources[static_cast<size_t>(momentFogSlot)], 0, GL_FALSE, 0, GL_READ_ONLY,
+                           GL_R32UI);
+    glDisable(GL_BLEND);
+    glEnable(GL_DITHER);
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_TRUE);
+    ++statMomentBatches;
+    statMomentVertices += made;
+}
+
+// ---- presentation ------------------------------------------------------------------------
+
+void GSGpuRenderer::Impl::presentPicture(const GSPresentationRequest &request)
+{
+    const auto bits = [](uint64_t v, int shift, uint64_t mask) { return static_cast<uint32_t>((v >> shift) & mask); };
+    const bool en1 = (request.pmode & 0x1u) != 0u;
+    const bool en2 = (request.pmode & 0x2u) != 0u;
+    const bool mmod = (request.pmode & 0x20u) != 0u;
+    const bool amod = (request.pmode & 0x40u) != 0u;
+    const bool slbg = (request.pmode & 0x80u) != 0u;
+    const uint32_t alp = bits(request.pmode, 8, 0xFF);
+    const bool fieldMode = (request.smode2 & 0x1u) != 0u && (request.smode2 & 0x2u) == 0u;
+    // Interlaced frame mode (FFMD 1): each field reads its lines one after the other, so a display
+    // DH + 1 lines of the whole picture high shows half as many rows of the buffer, and DY counts
+    // the picture's lines too (the SDK's double buffers of 224 rows for 448 lines; in Transformers
+    // the warp gate's loading screen alone).
+    const bool frameLines = (request.smode2 & 0x3u) == 0x3u;
+
+    struct Circuit
+    {
+        bool valid = false;
+        uint32_t fbp = 0, fbw = 0, x = 0, y = 0, width = 0, height = 0, dy = 0;
+        uint8_t psm = 0;
+    };
+    const auto decode = [&](uint64_t dispfb, uint64_t display, bool enabled)
+    {
+        Circuit c;
+        c.fbp = bits(dispfb, 0, 0x1FF);
+        c.fbw = bits(dispfb, 9, 0x3F);
+        c.psm = static_cast<uint8_t>(bits(dispfb, 15, 0x1F));
+        c.x = bits(dispfb, 32, 0x7FF);
+        c.y = bits(dispfb, 43, 0x7FF);
+        const uint32_t dw = bits(display, 32, 0xFFF), dh = bits(display, 44, 0x7FF), magh = bits(display, 23, 0xF);
+        c.width = (dw + 1u) / (magh + 1u);
+        c.height = dh + 1u;
+        if (c.width < 64u || c.height < 64u)
+        {
+            c.width = 640u;
+            c.height = 448u;
+        }
+        c.width = std::min<uint32_t>(c.width, kPictureWidth);
+        c.height = std::min<uint32_t>(c.height, kPictureHeight);
+        c.dy = bits(display, 12, 0x7FF);
+        if (frameLines)
+        {
+            c.height = (c.height + 1u) / 2u;
+            c.dy /= 2u;
+        }
+        c.valid = enabled && (c.fbw != 0u || dw != 0u || dh != 0u || magh != 0u);
+        return c;
+    };
+    const Circuit c1 = decode(request.dispfb1, request.display1, en1);
+    const Circuit c2 = decode(request.dispfb2, request.display2, en2);
+    if (!c1.valid && !c2.valid)
+        return;
+
+    const bool both = c1.valid && c2.valid;
+    const bool show1 = c1.valid && !(both && mmod && alp == 0u);
+    const bool show2 = c2.valid && (!both || !slbg);
+    uint32_t top = 0u, width = 0u, height = 0u, fieldPhase = 0u;
+    if (both)
+    {
+        top = (show1 && show2) ? std::min(c1.dy, c2.dy) : (show1 ? c1.dy : c2.dy);
+        width = std::max(show1 ? c1.width : 0u, show2 ? c2.width : 0u);
+        height = std::min<uint32_t>(kPictureHeight, std::max(show1 ? c1.height + (c1.dy - top) : 0u,
+                                                              show2 ? c2.height + (c2.dy - top) : 0u));
+        fieldPhase = top & 1u;
+    }
+    else
+    {
+        const Circuit &c = c1.valid ? c1 : c2;
+        top = c.dy;
+        width = c.width;
+        height = c.height;
+        fieldPhase = c.dy & 1u;
+    }
+    if (width == 0u || height == 0u)
+        return;
+
+    const bool opaque1 = show1 && both && !mmod && !amod && c1.psm == GS_PSM_CT24;
+    const uint32_t row1 = show1 ? c1.dy - top : 0u, row2 = show2 ? c2.dy - top : 0u;
+    // The picture's lines this VBlank shows (the others are filled in): with field pictures,
+    // the whole picture of the field whose buffer rows those are. With one field shown always
+    // (ps2_host_display::setShownField), the buffer holds that field as a whole picture.
+    const uint32_t shownParity = static_cast<uint32_t>((request.vsyncTick ^ fieldPhase) & 1u);
+    const bool wholePicture = ps2_host_display::shownField() >= 0;
+
+    // Each circuit from the buffer the GPU keeps for it, else from local memory (a movie, an
+    // upload). `field`: the field picture to take instead when the buffer has them (0 the
+    // field of the even buffer rows).
+    struct Source
+    {
+        GLuint texture = 0u;
+        int params[4] = {1, 0, 0, 1};
+        bool field = false; // a whole field picture
+        int scale = 0;      // (its buffer's scale, x | y << 8; 0: the pictures')
+    };
+    // Moment pictures (stage 4): a display buffer whose frame was drawn at its moments shows them,
+    // each a picture of its own for the screen refresh it was made for, all as the frame flips;
+    // the VBlanks after show nothing new.
+    Target *momentTarget = nullptr;
+    if (fields && fieldMode && !wholePicture)
+        for (const Circuit *c : {show1 ? &c1 : nullptr, show2 ? &c2 : nullptr})
+        {
+            if (!c || kindOf(c->psm) != kC32)
+                continue;
+            Target *t = findTarget(GSInternal::framePageBaseToBlock(c->fbp), std::max<uint32_t>(c->fbw, 1u), kC32);
+            if (t && t->shadowed && t->momentCount > 0)
+            {
+                momentTarget = t;
+                break;
+            }
+        }
+    int pictureTotal = 1;
+    if (momentTarget)
+    {
+        if (momentTarget->momentPublished == momentTarget->momentFrame)
+            return; // (shown as it flipped)
+        momentTarget->momentPublished = momentTarget->momentFrame;
+        pictureTotal = momentTarget->momentCount;
+        statMomentPictures += static_cast<uint64_t>(pictureTotal);
+    }
+    // (a VBlank's picture is for the VBlank's due time)
+    int64_t vblankShowsNs = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    {
+        std::chrono::steady_clock::time_point due{};
+        if (ps2_host_display::vblankDue(request.vsyncTick, due))
+            vblankShowsNs = std::chrono::duration_cast<std::chrono::nanoseconds>(due.time_since_epoch()).count();
+    }
+    const auto circuitSource = [&](const Circuit &c, int field, int moment)
+    {
+        Source s;
+        const uint32_t bp = GSInternal::framePageBaseToBlock(c.fbp);
+        const uint32_t bw = std::max<uint32_t>(c.fbw, 1u);
+        const Kind kind = kindOf(c.psm);
+        s.params[1] = c.psm;
+        s.params[2] = static_cast<int>(bp);
+        s.params[3] = static_cast<int>(bw);
+        Target *t = (kind == kC32 || kind == kC16 || kind == kC16S) ? findTarget(bp, bw, kind) : nullptr;
+        if (t)
+        {
+            t = target(bp, bw, kind, static_cast<int>(c.y + c.height));
+            ensureLoaded(*t);
+            msaaResolve(*t, 6);
+            s.texture = t->tex;
+            s.params[0] = 0;
+            s.scale = t->sx | (t->sy << 8);
+            // (A frame that left its second field out shows its first at both VBlanks: the
+            // second's picture was not drawn, and is not valid when the buffer's memory was used
+            // for something else since - Transformers' next depth buffer. The buffer itself is
+            // not kept with field pictures as moments: never shown.)
+            const bool secondStale = secondFieldStale(*t);
+            if (moment >= 0 && t == momentTarget && t->shadowValid[2 + moment])
+            {
+                s.texture = t->shadow[2 + moment];
+                s.field = true;
+            }
+            else if (fields && fieldMode && !wholePicture && t->shadowed && t->shadowValid[0] && (t->shadowValid[1] || secondStale))
+            {
+                s.texture = t->shadow[(field & 1) != 0 && !secondStale ? 1 : 0];
+                s.field = true;
+            }
+            return s;
+        }
+        PageList pages;
+        pagesOf(pages, bp, bw, kind == kNoKind ? kC32 : kind, static_cast<int>(c.x), static_cast<int>(c.y),
+                static_cast<int>(c.x + c.width) - 1, static_cast<int>(c.y + c.height) - 1);
+        makeMemoryCurrent(pages);
+        s.texture = dummyImage;
+        return s;
+    };
+    int lastSlot = -1;
+    for (int picture = 0; picture < pictureTotal; ++picture)
+    {
+        const int moment = momentTarget ? picture : -1;
+        // (Picture line L is buffer row L - row + y.)
+        Source s1, s2;
+        if (show1)
+            s1 = circuitSource(c1, static_cast<int>((shownParity + c1.y + row1) & 1u), moment);
+        if (show2)
+            s2 = circuitSource(c2, static_cast<int>((shownParity + c2.y + row2) & 1u), moment);
+        const bool wholeFields = (!show1 || s1.field) && (!show2 || s2.field);
+        // The lines of the other field filled in (the field pass), or not: then the picture is
+        // composed straight into this VBlank's picture (the field pass would copy it).
+        const bool fieldPass = fieldMode && !wholeFields && !wholePicture;
+
+        // This VBlank's picture (or this moment's).
+        const uint32_t slot = static_cast<uint32_t>(nextPicture++ % pictureSlots);
+        {
+            std::lock_guard<std::mutex> lock(g_pictureMutex);
+            g_published[slot].valid = false; // (drawn into again)
+            if (pictureFences[slot])
+            {
+                glDeleteSync(pictureFences[slot]);
+                pictureFences[slot] = nullptr;
+            }
+        }
+
+        imagesWritten = true; // (a barrier before sampling what draws stored)
+        barrier();
+        glBindFramebuffer(GL_FRAMEBUFFER, presentFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, (fieldPass || aaEnabled) ? composed : pictures[slot], 0);
+        glViewport(0, 0, kPictureWidth * scaleX, kPictureHeight * scaleY);
+        glDisable(GL_SCISSOR_TEST);
+        glUseProgram(composeProgram);
+        glBindVertexArray(emptyVao);
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, s1.texture ? s1.texture : dummyImage);
+        glActiveTexture(GL_TEXTURE1);
+        glBindTexture(GL_TEXTURE_2D, s2.texture ? s2.texture : dummyImage);
+        glActiveTexture(GL_TEXTURE0);
+        const auto set4 = [&](const char *name, int a, int b, int c, int d)
+        { glUniform4i(glGetUniformLocation(composeProgram, name), a, b, c, d); };
+        set4("uShow", show1 ? 1 : 0, show2 ? 1 : 0, opaque1 ? 1 : 0, 0);
+        set4("uOrigin1", static_cast<int>(c1.x), static_cast<int>(c1.y), static_cast<int>(row1),
+             static_cast<int>(std::min(c1.height, height - std::min(height, row1))));
+        set4("uOrigin2", static_cast<int>(c2.x), static_cast<int>(c2.y), static_cast<int>(row2),
+             static_cast<int>(std::min(c2.height, height - std::min(height, row2))));
+        set4("uSize", static_cast<int>(c1.width), static_cast<int>(c2.width), static_cast<int>(width), static_cast<int>(height));
+        set4("uMode", mmod ? 1 : 0, static_cast<int>(alp), 0, packedScale());
+        set4("uBg", static_cast<int>(request.bgcolor & 0xFFu), static_cast<int>((request.bgcolor >> 8u) & 0xFFu),
+             static_cast<int>((request.bgcolor >> 16u) & 0xFFu), 0);
+        set4("uSource1", s1.params[0], s1.params[1], s1.params[2], s1.params[3]);
+        set4("uSource2", s2.params[0], s2.params[1], s2.params[2], s2.params[3]);
+        set4("uScales", s1.scale ? s1.scale : packedScale(), s2.scale ? s2.scale : packedScale(), 0, 0);
+        timeBegin(4);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        GLuint made = composed; // (what the smoothing reads)
+        if (fieldPass)
+        {
+            made = aaEnabled ? composedFields : pictures[slot];
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, made, 0);
+            glUseProgram(fieldProgram);
+            glBindTexture(GL_TEXTURE_2D, composed);
+            glUniform4i(glGetUniformLocation(fieldProgram, "uField"), 1, static_cast<int>(shownParity),
+                        static_cast<int>(height) * scaleY, scaleY);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+        }
+        if (aaEnabled)
+        {
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, pictures[slot], 0);
+            glUseProgram(fxaaProgram);
+            glBindTexture(GL_TEXTURE_2D, made);
+            glBindSampler(0, 0u);
+            glUniform2f(fxaaTexelLocation, 1.0f / static_cast<float>(kPictureWidth * scaleX), 1.0f / static_cast<float>(kPictureHeight * scaleY));
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+        }
+        if (pictureLevels > 1)
+        {
+            glBindTexture(GL_TEXTURE_2D, pictures[slot]);
+            glGenerateMipmap(GL_TEXTURE_2D);
+        }
+        timeEnd();
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        ++statPresents;
+        if (stats)
+            collectTimes();
+
+        const GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        glFlush();
+        const int pictureWidth = static_cast<int>(width) * scaleX, pictureHeight = static_cast<int>(height) * scaleY;
+        {
+            std::lock_guard<std::mutex> lock(g_pictureMutex);
+            pictureFences[slot] = fence;
+            Published &p = g_published[slot];
+            p.texture = pictures[slot];
+            p.fence = fence;
+            p.width = pictureWidth;
+            p.height = pictureHeight;
+            p.textureWidth = kPictureWidth * scaleX;
+            p.textureHeight = kPictureHeight * scaleY;
+            p.tick = request.vsyncTick;
+            p.showsNs = moment >= 0 ? momentTarget->momentShowsNs[moment] : vblankShowsNs;
+            p.valid = true;
+        }
+        if (moment >= 0)
+            ps2_host_display::noteMomentMade(momentTarget->momentShowsNs[moment]);
+        lastSlot = static_cast<int>(slot);
+
+        // PS2X_SHOT_VSYNCS: the GPU's picture next to the software renderer's (and each moment's).
+        if (std::find(shotTicks.begin(), shotTicks.end(), request.vsyncTick) != shotTicks.end())
+        {
+            const int fullWidth = kPictureWidth * scaleX;
+            std::vector<uint8_t> pixels(static_cast<size_t>(fullWidth) * kPictureHeight * scaleY * 4u);
+            glBindTexture(GL_TEXTURE_2D, pictures[slot]);
+            glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+            std::vector<uint8_t> packed(static_cast<size_t>(pictureWidth) * pictureHeight * 4u);
+            for (int y = 0; y < pictureHeight; ++y)
+                std::memcpy(packed.data() + static_cast<size_t>(y) * pictureWidth * 4u,
+                            pixels.data() + static_cast<size_t>(y) * fullWidth * 4u, static_cast<size_t>(pictureWidth) * 4u);
+            for (size_t i = 3; i < packed.size(); i += 4)
+                packed[i] = 0xFFu;
+            Image shot{packed.data(), pictureWidth, pictureHeight, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+            // (drawing alone it is the only picture: the shot; beside the software renderer, next to its)
+            const std::string path = "runs/shot_" + std::to_string(request.vsyncTick) + (moment >= 0 ? "_m" + std::to_string(moment) : std::string()) +
+                                     (mirror ? "_gpu.png" : ".png");
+            ExportImage(shot, path.c_str());
+        }
+    }
+
+    // At most two presentations' pictures in flight (a VBlank's, or a frame's moments): the GS
+    // thread waits for the GPU to finish the one before last. Nothing held it back before, and a
+    // GPU slower than the game (8x5 in a busy scene) let the window's pictures fall further and
+    // further behind - 120 ms late, most VBlanks never shown. Now the game waits for the GPU instead.
+    if (lastSlot >= 0)
+    {
+        const int older = presentedSlots[0];
+        presentedSlots[0] = presentedSlots[1];
+        presentedSlots[1] = lastSlot;
+        GLsync olderFence = nullptr;
+        if (older >= 0)
+        {
+            std::lock_guard<std::mutex> lock(g_pictureMutex);
+            olderFence = pictureFences[static_cast<size_t>(older)];
+        }
+        if (olderFence && glClientWaitSync(olderFence, 0, 0u) == GL_TIMEOUT_EXPIRED)
+        {
+            // (Behind: noted for the cap on two pictures a frame, present().)
+            const auto waitStart = std::chrono::steady_clock::now();
+            glClientWaitSync(olderFence, 0, 100'000'000u); // (at most 100 ms)
+            pictureWaited = true;
+            pictureWaitMs += std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - waitStart).count();
+        }
+    }
+}
+
+void GSGpuRenderer::Impl::printStats()
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (now - statStart < std::chrono::seconds(2))
+        return;
+    std::fprintf(stderr,
+                 "[gpu] 2 s: %llu batches, %llu draws, %llu primitives (%llu not drawn, %llu outside the scissor), %llu vertices, "
+                 "%llu pages uploaded, "
+                 "%llu rows loaded, %llu rows written back, %llu feedback copies, %llu waits for the software renderer, %llu pages "
+                 "downloaded, %zu buffers\n",
+                 static_cast<unsigned long long>(statBatches), static_cast<unsigned long long>(statDraws),
+                 static_cast<unsigned long long>(statPrims), static_cast<unsigned long long>(statSkipped),
+                 static_cast<unsigned long long>(statCulled), static_cast<unsigned long long>(statVertices),
+                 static_cast<unsigned long long>(statUploads),
+                 static_cast<unsigned long long>(statLoadRows), static_cast<unsigned long long>(statWriteRows),
+                 static_cast<unsigned long long>(statFeedback), static_cast<unsigned long long>(statSyncs),
+                 static_cast<unsigned long long>(statDownloads), targets.size());
+    std::fprintf(stderr, "[gpu]   read-backs and local copies: %llu, %llu of their pages drawn by the GPU\n",
+                 static_cast<unsigned long long>(statReadbacks), static_cast<unsigned long long>(statReadbackPages));
+    statReadbacks = statReadbackPages = 0u;
+    if (statPresents)
+        std::fprintf(stderr, "[gpu]   GPU ms per VBlank: draws %.2f, field pictures %.2f, loads %.2f, write-backs %.2f, presentation %.2f\n",
+                     gpuMs[0] / statPresents, gpuMs[1] / statPresents, gpuMs[2] / statPresents, gpuMs[3] / statPresents,
+                     gpuMs[4] / statPresents);
+    if (statFlips)
+        std::fprintf(stderr, "[gpu]   GPU ms a frame: %.2f (%llu frames)\n", (gpuMs[0] + gpuMs[1] + gpuMs[2] + gpuMs[3] + gpuMs[4]) / statFlips,
+                     static_cast<unsigned long long>(statFlips));
+    if (profile && statPresents)
+    {
+        std::vector<const PassTime *> order;
+        double total = 0.0;
+        for (const PassTime &t : passTimes)
+        {
+            order.push_back(&t);
+            total += t.ms;
+        }
+        std::sort(order.begin(), order.end(), [](const PassTime *a, const PassTime *b) { return a->ms > b->ms; });
+        std::fprintf(stderr,
+                     "[gpu]   passes, GPU ms per VBlank (of %.2f): batches, vertices, GS pixels and fragments (millions) per VBlank\n",
+                     total / statPresents);
+        for (size_t i = 0; i < order.size() && i < 24u; ++i)
+            std::fprintf(stderr, "[gpu]     %6.3f  %5.1f %7.0f %9.0f %7.2f  %s  (counted %.2f M: %.1f%% failed depth, %.1f%% alpha discarded)\n",
+                         order[i]->ms / statPresents, static_cast<double>(order[i]->batches) / statPresents,
+                         static_cast<double>(order[i]->vertices) / statPresents, static_cast<double>(order[i]->pixels) / statPresents,
+                         static_cast<double>(order[i]->fragments) / statPresents / 1.0e6, order[i]->name.c_str(),
+                         static_cast<double>(order[i]->counted) / statPresents / 1.0e6,
+                         order[i]->counted ? 100.0 * static_cast<double>(order[i]->depthFailed) / static_cast<double>(order[i]->counted) : 0.0,
+                         order[i]->counted ? 100.0 * static_cast<double>(order[i]->alphaDiscarded) / static_cast<double>(order[i]->counted) : 0.0);
+        std::fprintf(stderr, "[gpu]     batches ended, per VBlank:");
+        for (int i = 0; i < 12; ++i)
+            if (flushCounts[i])
+                std::fprintf(stderr, " %s %.1f", kFlushWhy[i], static_cast<double>(flushCounts[i]) / statPresents);
+        std::fprintf(stderr, "\n");
+        std::fill(std::begin(flushCounts), std::end(flushCounts), 0u);
+        for (PassTime &t : passTimes) // (kept: queries still out name them)
+        {
+            t.ms = 0.0;
+            t.batches = t.vertices = t.pixels = t.fragments = 0u;
+            t.counted = t.depthFailed = t.alphaDiscarded = 0u;
+        }
+    }
+    std::fill(std::begin(gpuMs), std::end(gpuMs), 0.0);
+    statPresents = 0u;
+    statFlips = 0u;
+    if (packOpen)
+        std::fprintf(stderr, "[gpu]   texture pack: %llu draws took a replacement, %llu textures hashed\n",
+                     static_cast<unsigned long long>(statPackDraws), static_cast<unsigned long long>(statPackHashes));
+    if (textureCache)
+    {
+        std::fprintf(stderr, "[gpu]   texture cache: %llu found, %llu decoded, %llu dropped; %zu kept\n",
+                     static_cast<unsigned long long>(statDecodeHits), static_cast<unsigned long long>(statDecodeMade),
+                     static_cast<unsigned long long>(statDecodeDropped), decodedTextures.size());
+        statDecodeHits = statDecodeMade = statDecodeDropped = 0u;
+    }
+    if (nativeEnabled)
+    {
+        std::fprintf(stderr,
+                     "[gpu]   native: %llu batches in %llu runs, %llu draws (%llu emulated), depth copies %llu packed, %llu unpacked, %llu "
+                     "alpha copies, %llu depth fogs (%llu shuffles for them left out)\n",
+                     static_cast<unsigned long long>(statNativeBatches), static_cast<unsigned long long>(statNativeRuns),
+                     static_cast<unsigned long long>(statNativeDraws), static_cast<unsigned long long>(statEmulatedDraws),
+                     static_cast<unsigned long long>(statPacks), static_cast<unsigned long long>(statUnpacks),
+                     static_cast<unsigned long long>(statAlphaCopies), static_cast<unsigned long long>(statNativeFogs),
+                     static_cast<unsigned long long>(statFogShufflesLeftOut));
+        statNativeFogs = statFogShufflesLeftOut = 0u;
+        std::fprintf(stderr, "[gpu]   native depth packed for: emulated batch %llu, texture %llu, feedback %llu, write-back %llu, growing %llu, loading %llu; unpacked after: emulated batch %llu, cells loaded %llu, new size %llu, new %llu\n",
+                     static_cast<unsigned long long>(statPackWhy[0]), static_cast<unsigned long long>(statPackWhy[1]),
+                     static_cast<unsigned long long>(statPackWhy[2]), static_cast<unsigned long long>(statPackWhy[3]),
+                     static_cast<unsigned long long>(statPackWhy[4]), static_cast<unsigned long long>(statPackWhy[5]),
+                     static_cast<unsigned long long>(statUnpackWhy[0]), static_cast<unsigned long long>(statUnpackWhy[1]),
+                     static_cast<unsigned long long>(statUnpackWhy[2]), static_cast<unsigned long long>(statUnpackWhy[3]));
+        std::fill(std::begin(statPackWhy), std::end(statPackWhy), 0ull);
+        std::fill(std::begin(statUnpackWhy), std::end(statUnpackWhy), 0ull);
+        if (sceneMsaa > 1)
+        {
+            const auto u = [](uint64_t v) { return static_cast<unsigned long long>(v); };
+            const uint64_t *w = statMsaaResolveWhy;
+            std::fprintf(stderr,
+                         "[gpu]   the scene multisampled: %llu fills; resolved for: another batch %llu, texture %llu, feedback %llu, "
+                         "write-back %llu, growing %llu, loading %llu, shown %llu, field picture %llu, depth packed %llu, fog %llu, "
+                         "alpha %llu; the depth as the farthest sample %llu\n",
+                         u(statMsFills), u(w[0]), u(w[1]), u(w[2]), u(w[3]), u(w[4]), u(w[5]), u(w[6]), u(w[7]), u(w[8]), u(w[9]), u(w[10]),
+                         u(statMsFarthest));
+            statMsFills = statMsFarthest = 0u;
+            std::fill(std::begin(statMsaaResolveWhy), std::end(statMsaaResolveWhy), 0ull);
+        }
+        statNativeBatches = statNativeRuns = statNativeDraws = statEmulatedDraws = statPacks = statUnpacks = statAlphaCopies = 0u;
+    }
+    if (statMomentFrames != 0u)
+    {
+        const auto u = [](uint64_t v) { return static_cast<unsigned long long>(v); };
+        std::fprintf(stderr,
+                     "[gpu]   moments: %llu frames, %llu pictures; %llu batches, %llu vertices made; runs of draws: %llu pairs of fields mixed, "
+                     "%llu matched primitive by primitive, %llu pairs not the same (nearer field), %llu field A alone, %llu field B alone, %llu over both; %llu draws not native "
+                     "drawn natively; %llu depth fogs; %llu frames with fewer moments (the GPU behind at %llu flips, waited for %.2f ms on "
+                     "average, most %.2f; %llu handed over late; at most %d a frame now)\n",
+                     u(statMomentFrames), u(statMomentPictures), u(statMomentBatches), u(statMomentVertices), u(statMomentPairs),
+                     u(statMomentAligned), u(statMomentMismatched), u(statMomentLoneA), u(statMomentLoneB), u(statMomentWhole), u(statMomentApprox), u(statMomentFogs),
+                     u(statMomentCapped), u(statMomentBehind), statMomentBehind ? statMomentWaitMs / statMomentBehind : 0.0, statMomentWaitMost,
+                     u(statMomentMissed), momentCap);
+        statMomentMissed = 0u;
+        if (carry)
+        {
+            std::fprintf(stderr,
+                         "[gpu]   carried: %llu runs where the frame before left them, %llu from where it left them (particles), %llu left "
+                         "as they are, %llu new; %zu kinds carried\n",
+                         u(statCarryKept), u(statCarried), u(statCarryLeft), u(statCarryNew), carryKindCount);
+            statCarryKept = statCarried = statCarryLeft = statCarryNew = 0u;
+        }
+        if (continuity)
+        {
+            std::vector<const ContinuityKind *> kinds;
+            for (const auto &entry : continuityKinds)
+                kinds.push_back(&entry.second);
+            std::sort(kinds.begin(), kinds.end(), [](const ContinuityKind *x, const ContinuityKind *y) { return x->vertices > y->vertices; });
+            for (size_t i = 0; i < kinds.size() && i < 12u; ++i)
+                std::fprintf(stderr, "[gpu]     left: %llu runs (%llu/%llu/%llu/%llu up to 1/4/16/more px), %llu vertices: %s\n", u(kinds[i]->runs),
+                             u(kinds[i]->apart[0]), u(kinds[i]->apart[1]), u(kinds[i]->apart[2]), u(kinds[i]->apart[3]), u(kinds[i]->vertices),
+                             kinds[i]->what.c_str());
+            continuityKinds.clear();
+        }
+        statMomentFrames = statMomentPictures = statMomentBatches = statMomentVertices = statMomentPairs = statMomentMismatched = statMomentLoneA =
+            statMomentLoneB = statMomentWhole = statMomentApprox = statMomentFogs = statMomentCapped = statMomentBehind = statMomentAligned = 0u;
+        statMomentWaitMs = statMomentWaitMost = 0.0;
+    }
+    if (packOpen && replacementMemoMode == 2)
+        std::fprintf(stderr, "[gpu]   texture pack memo: %llu answers checked, %llu differ\n",
+                     static_cast<unsigned long long>(statMemoChecked), static_cast<unsigned long long>(statMemoDiffering));
+    statPackDraws = statPackHashes = 0u;
+    statBatches = statDraws = statPrims = statSkipped = statCulled = statVertices = statUploads = statLoadRows = statWriteRows = statFeedback =
+        statSyncs = statDownloads = 0u;
+    statStart = now;
+    static const char *kKindNames[8] = {"C32", "Z32", "C16", "C16S", "Z16", "Z16S", "P8", "P4"};
+    for (auto &t : targets)
+    {
+        if (t->statLoaded || t->statBatches || t->statByUpload || t->statByDraw)
+            std::fprintf(stderr, "[gpu]   buffer bp %u bw %u %s, %d rows: %llu batches, %llu rows loaded, stale pages: %llu uploads, %llu draws\n",
+                         t->bp, t->bw, kKindNames[t->kind], t->rows, static_cast<unsigned long long>(t->statBatches),
+                         static_cast<unsigned long long>(t->statLoaded), static_cast<unsigned long long>(t->statByUpload),
+                         static_cast<unsigned long long>(t->statByDraw));
+        t->statLoaded = t->statBatches = t->statByUpload = t->statByDraw = 0u;
+    }
+}
