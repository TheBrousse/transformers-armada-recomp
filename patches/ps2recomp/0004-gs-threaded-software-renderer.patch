+// ---- PS2X_GPU_DRAWLOG=<tick>: what the game draws from that VBlank's presentation for two
+// VBlanks (a frame), one line per run of primitives with one draw state, to
+// runs/gpu_drawlog_<tick>.txt.
+namespace
+{
+    struct DrawLog
+    {
+        uint64_t tick = 0u;
+        uint64_t until = 0u;
+        std::FILE *file = nullptr;
+        bool open = false; // a line is being counted
+        std::string line;
+        uint64_t prims = 0u;
+        float x0 = 0.0f, y0 = 0.0f, x1 = 0.0f, y1 = 0.0f;
+
+        void finish()
+        {
+            if (!file || !open)
+                return;
+            std::fprintf(file, "%6llu prims  x %.1f..%.1f y %.1f..%.1f  %s\n", static_cast<unsigned long long>(prims), x0, x1, y0, y1,
+                         line.c_str());
+            open = false;
+        }
+
+        void begin(const GSDrawState &s)
+        {
+            finish();
+            const GSContext &c = s.context;
+            static const char *kPrims[8] = {"point", "line", "linestrip", "tri", "tristrip", "trifan", "sprite", "?"};
+            char text[512];
+            std::snprintf(text, sizeof(text),
+                          "%s%s%s%s%s frame bp %u bw %u psm %u msk %08x | z bp %u psm %u %s ztst %u | sc %u,%u-%u,%u off %.2f,%.2f | "
+                          "tex bp %u bw %u psm %u %ux%u tfx %u tcc %u clamp %llx %s | alpha %02llx fix %llu | test ate %llu atst %llu "
+                          "aref %llu afail %llu date %llu | scanmsk %llu fba %llu",
+                          kPrims[s.prim.type & 7u], s.prim.tme ? " tex" : "", s.prim.abe ? " blend" : "", s.prim.fge ? " fog" : "",
+                          s.prim.iip ? " gouraud" : "", GSInternal::framePageBaseToBlock(c.frame.fbp), c.frame.fbw, c.frame.psm,
+                          c.frame.fbmsk, GSInternal::framePageBaseToBlock(c.zbuf.zbp), c.zbuf.psm, c.zbuf.zmask ? "nowrite" : "write",
+                          static_cast<unsigned>((c.test >> 17u) & 3u), c.scissor.x0, c.scissor.y0, c.scissor.x1, c.scissor.y1,
+                          c.xyoffset.ofx / 16.0, c.xyoffset.ofy / 16.0, c.tex0.tbp0, c.tex0.tbw, c.tex0.psm, 1u << c.tex0.tw,
+                          1u << c.tex0.th, c.tex0.tfx, c.tex0.tcc, static_cast<unsigned long long>(c.clamp),
+                          s.linearFilter ? "linear" : "nearest", static_cast<unsigned long long>(c.alpha & 0xFFu),
+                          static_cast<unsigned long long>((c.alpha >> 32u) & 0xFFu), static_cast<unsigned long long>(c.test & 1u),
+                          static_cast<unsigned long long>((c.test >> 1u) & 7u), static_cast<unsigned long long>((c.test >> 4u) & 0xFFu),
+                          static_cast<unsigned long long>((c.test >> 12u) & 3u), static_cast<unsigned long long>((c.test >> 14u) & 1u),
+                          static_cast<unsigned long long>(s.scanmsk & 3u), static_cast<unsigned long long>(c.fba & 1u));
+            line = text;
+            prims = 0u;
+            x0 = y0 = 1.0e9f;
+            x1 = y1 = -1.0e9f;
+            open = true;
+        }
+
+        void add(const GSDrawState &s, const GSVertex *v, uint32_t count, uint32_t each)
+        {
+            prims += count;
+            const float ox = s.context.xyoffset.ofx / 16.0f, oy = s.context.xyoffset.ofy / 16.0f;
+            for (size_t i = 0; i < static_cast<size_t>(count) * each; ++i)
+            {
+                x0 = std::min(x0, v[i].x - ox);
+                x1 = std::max(x1, v[i].x - ox);
+                y0 = std::min(y0, v[i].y - oy);
+                y1 = std::max(y1, v[i].y - oy);
+            }
+        }
+    };
+    DrawLog g_drawLog;
+}
+
+void GSGpuRenderer::setDrawState(const GSDrawState &state)
+{
+    m->state = state;
+    m->stateDirty = true;
+    m->stateLeftOut = m->secondFieldLeftOut && m->secondFieldDraw(state);
+    if (g_drawLog.file)
+        g_drawLog.begin(state);
+}
+
+// A field of a native mesh as a job for kMeshExpand: its data, its entry, and three vertex slots
+// kept for each triangle - one for each vertex from the third whose kick word's ADC is clear.
+void GSGpuRenderer::Impl::addMeshJob(const uint8_t *mesh, const gsmesh::Header &header, uint32_t field)
+{
+    uint32_t masks[2];
+    std::memcpy(masks, mesh + (2u + header.fields * gsmesh::kFieldQwords) * 16u, 8u);
+    const uint32_t job = static_cast<uint32_t>(meshJobs.size() / 4u);
+    const uint32_t data = static_cast<uint32_t>(meshWords.size());
+    const size_t words = 20u + 12u * header.count;
+    meshWords.resize(data + words);
+    std::memcpy(meshWords.data() + data, gsmesh::field(mesh, field), 64u);
+    meshWords[data + 16u] = masks[0];
+    meshWords[data + 17u] = masks[1];
+    meshWords[data + 18u] = meshWords[data + 19u] = 0u;
+    std::memcpy(meshWords.data() + data + 20u, mesh + (2u + header.fields * gsmesh::kFieldQwords + 1u) * 16u, 48u * header.count);
+    uint32_t ofxBits, ofyBits;
+    std::memcpy(&ofxBits, &ofx, 4u);
+    std::memcpy(&ofyBits, &ofy, 4u);
+    meshJobs.insert(meshJobs.end(), {data, drawIndex | (texMode == 2 ? 1u << 24 : 0u), ofxBits, ofyBits});
+    const size_t firstSlot = vertices.size();
+    uint32_t made = 0u;
+    for (uint32_t v = 2u; v < header.count; ++v)
+    {
+        if (((static_cast<uint32_t>(gsmesh::kickBits(masks[0], masks[1], v)) >> 15) & 1u) != 0u)
+            continue; // (ADC: it does not kick)
+        meshTriangles.push_back(static_cast<uint32_t>(firstSlot + 3u * made));
+        meshTriangles.push_back(job << 5 | v);
+        ++made;
+    }
+    vertices.resize(firstSlot + 3u * made);
+    statPrims += made;
+    if (batchMoments)
+        noteMomentSegment(firstSlot, 3u * made, true);
+    if (meshMode == 3)
+    {
+        GSVertex made[3u * 30u];
+        const uint32_t count = gsmesh::fieldTriangles(mesh, header, field, made);
+        for (uint32_t i = 0; i < 3u * count; ++i)
+        {
+            const GSVertex &g = made[i];
+            GpuVertex e{};
+            e.x = g.x - ofx;
+            e.y = g.y - ofy;
+            e.z = g.z <= 0.0 ? 0u : (g.z >= 4294967295.0 ? 0xFFFFFFFFu : static_cast<uint32_t>(g.z));
+            e.r = g.r;
+            e.g = g.g;
+            e.b = g.b;
+            e.a = g.a;
+            if (texMode == 2)
+            {
+                e.s = g.s;
+                e.t = g.t;
+                e.q = g.q;
+            }
+            e.packed = drawIndex | (static_cast<uint32_t>(g.fog) << 24u);
+            meshExpected.emplace_back(static_cast<uint32_t>(firstSlot + i), e);
+        }
+        // the inputs of each corner, for the report
+        uint32_t corner = 0u;
+        for (uint32_t v = 2u; v < header.count; ++v)
+        {
+            if (((static_cast<uint32_t>(gsmesh::kickBits(masks[0], masks[1], v)) >> 15) & 1u) != 0u)
+                continue;
+            for (uint32_t c = 0; c < 3u; ++c, ++corner)
+            {
+                const uint32_t k = v - 2u + c;
+                const uint8_t *in = mesh + (2u + header.fields * gsmesh::kFieldQwords + 1u) * 16u + 48u * k;
+                const gsmesh::VuFloatMode mode;
+                __m128 rows[4];
+                for (int r = 0; r < 4; ++r)
+                    rows[r] = gsmesh::vuClamp(_mm_loadu_ps(reinterpret_cast<const float *>(gsmesh::field(mesh, field) + 16 * r)));
+                const __m128 position = gsmesh::vuClamp(_mm_loadu_ps(reinterpret_cast<const float *>(in + 32)));
+                const __m128 clip = gsmesh::vuTransform(rows, gsmesh::vuLane(position, 0), gsmesh::vuLane(position, 1), gsmesh::vuLane(position, 2));
+                const __m128 q = gsmesh::vuReciprocal(gsmesh::vuLane(clip, 3));
+                std::array<uint32_t, 4> inputs{};
+                std::memcpy(&inputs[0], in, 8u);
+                inputs[2] = static_cast<uint32_t>(_mm_extract_ps(clip, 3));
+                inputs[3] = static_cast<uint32_t>(_mm_extract_ps(q, 0));
+                meshInputs.push_back(inputs);
+            }
+        }
+    }
+}
+
+void GSGpuRenderer::Impl::expandMeshes()
+{
+    const uint32_t triangles = static_cast<uint32_t>(meshTriangles.size() / 2u);
+    const uint32_t base = static_cast<uint32_t>(meshJobs.size());
+    meshJobs.insert(meshJobs.end(), meshTriangles.begin(), meshTriangles.end());
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, meshDataBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(meshWords.size() * 4u), meshWords.data(), GL_STREAM_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 4, meshDataBuffer);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, meshTableBuffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(meshJobs.size() * 4u), meshJobs.data(), GL_STREAM_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 5, meshTableBuffer);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 7, vbo);
+    glUseProgram(meshProgram);
+    glUniform1ui(meshTrianglesLocation, triangles);
+    glUniform1ui(meshTriangleBaseLocation, base);
+    glUniform1ui(meshZeroLocation, 0u);
+    glDispatchCompute((triangles + 63u) / 64u, 1u, 1u);
+    glMemoryBarrier(GL_VERTEX_ATTRIB_ARRAY_BARRIER_BIT);
+    statMeshTriangles += triangles;
+    if (meshMode == 3 && !meshExpected.empty())
+    {
+        glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+        std::vector<GpuVertex> got(vertices.size());
+        glBindBuffer(GL_ARRAY_BUFFER, vbo);
+        glGetBufferSubData(GL_ARRAY_BUFFER, 0, static_cast<GLsizeiptr>(got.size() * sizeof(GpuVertex)), got.data());
+        static const char *names[8] = {"x", "y", "z", "rgba", "s", "t", "q", "packed"};
+        size_t index = 0;
+        for (const auto &[slot, expected] : meshExpected)
+        {
+            const std::array<uint32_t, 4> inputs = index < meshInputs.size() ? meshInputs[index] : std::array<uint32_t, 4>{};
+            ++index;
+            ++meshChecked;
+            uint32_t a[8], b[8];
+            std::memcpy(a, &expected, 32u);
+            std::memcpy(b, &got[slot], 32u);
+            if (std::memcmp(a, b, 32u) == 0)
+                continue;
+            ++meshDiffering;
+            if (meshReports < 40)
+            {
+                ++meshReports;
+                std::string line = "[gpu:mesh] slot " + std::to_string(slot) + ":";
+                for (int w = 0; w < 8; ++w)
+                    if (a[w] != b[w])
+                    {
+                        char text[96];
+                        std::snprintf(text, sizeof(text), " %s %08x|%08x", names[w], a[w], b[w]);
+                        line += text;
+                    }
+                std::fprintf(stderr, "%s (here|GPU) st %08x %08x w %08x q %08x\n", line.c_str(), inputs[0], inputs[1], inputs[2], inputs[3]);
+            }
+        }
+        if ((meshChecked & ~0xFFFFull) != ((meshChecked - meshExpected.size()) & ~0xFFFFull))
+            std::fprintf(stderr, "[gpu:mesh] %llu vertices checked, %llu differ\n", static_cast<unsigned long long>(meshChecked),
+                         static_cast<unsigned long long>(meshDiffering));
+        meshExpected.clear();
+        meshInputs.clear();
+    }
+    meshWords.clear();
+    meshJobs.clear();
+    meshTriangles.clear();
+}
+
+// A field of a native mesh: with PS2X_GPU_MESHES=2 its vertices made on the GPU (when the draw
+// goes to no field picture and its coordinates are STQ or none); otherwise its triangles made
+// here exactly as the GS front end would make them from the packet its routine sends
+// (gsmesh::fieldTriangles), drawn as those would be.
+void GSGpuRenderer::drawMesh(const uint8_t *mesh, uint32_t bytes, uint32_t field)
+{
+    gsmesh::Header header{};
+    if (!gsmesh::readHeader(mesh, bytes, header) || field >= header.fields)
+        return;
+    Impl &r = *m;
+    if (r.meshMode >= 2 && r.meshProgram)
+    {
+        if (r.stateLeftOut || !r.begin())
+            return;
+        if (r.stateDirty)
+            r.prepareDraw();
+        if (!r.drawUsable)
+            return;
+        bool shadowed = false;
+        for (const auto &b : r.shadowBatches)
+            shadowed = shadowed || b.drawIndex >= 0;
+        if (!shadowed && (r.texMode == 2 || r.texMode == 0))
+        {
+            r.addMeshJob(mesh, header, field);
+            return;
+        }
+    }
+    GSVertex triangles[3u * 30u];
+    const uint32_t count = gsmesh::fieldTriangles(mesh, header, field, triangles);
+    if (count != 0u)
+        drawPrimitives(triangles, count, 3u);
+}
+
+void GSGpuRenderer::drawPrimitives(const GSVertex *vertices, uint32_t count, uint32_t each)
+{
+    Impl &r = *m;
+    if (!vertices || count == 0u || r.stateLeftOut || !r.begin())
+        return;
+    if (g_drawLog.file && g_drawLog.open)
+        g_drawLog.add(r.state, vertices, count, each);
+    if (r.stateDirty)
+        r.prepareDraw();
+    r.statPrims += count;
+    if (!r.drawUsable)
+    {
+        r.statSkipped += count;
+        return;
+    }
+    const size_t first = r.vertices.size();
+    r.appendPrimitives(vertices, count, each);
+    if (r.batchMoments)
+        r.noteMomentSegment(first, r.vertices.size() - first);
+    // The same primitives for the field pictures, with their own draw entries.
+    for (auto &b : r.shadowBatches)
+        if (b.drawIndex >= 0)
+            for (size_t i = first; i < r.vertices.size(); ++i)
+            {
+                GpuVertex v = r.vertices[i];
+                v.packed = (v.packed & 0xFF000000u) | static_cast<uint32_t>(b.drawIndex);
+                b.vertices.push_back(v);
+            }
+}
+
+void GSGpuRenderer::loadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Impl &r = *m;
+    if (!r.begin() || !isIndexed(tex0.psm))
+        return;
+    switch (tex0.cld)
+    {
+    case 1u:
+        break;
+    case 2u:
+        r.clutCbp[0] = tex0.cbp;
+        break;
+    case 3u:
+        r.clutCbp[1] = tex0.cbp;
+        break;
+    case 4u:
+        if (r.clutCbp[0] == tex0.cbp)
+            return;
+        r.clutCbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (r.clutCbp[1] == tex0.cbp)
+            return;
+        r.clutCbp[1] = tex0.cbp;
+        break;
+    default:
+        return;
+    }
+    const bool fourBit = isIndexed4(tex0.psm);
+    const bool sixteenBit = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    const bool thirtyTwoBit = tex0.cpsm == GS_PSM_CT32 || tex0.cpsm == GS_PSM_CT24;
+    if (!sixteenBit && !thirtyTwoBit)
+        return;
+    // The CLUT comes from local memory, which the software renderer may still be drawing (or
+    // which, drawing alone, the GPU may have the newest of).
+    {
+        PageList pages;
+        const uint32_t cbw = (tex0.csm == 0u) ? 1u : std::max<uint32_t>(texclut.cbw, 1u);
+        pagesOf(pages, tex0.cbp, cbw, kindOf(tex0.cpsm), 0, 0, tex0.csm == 0u ? 15 : 1023, tex0.csm == 0u ? 15 : texclut.cov);
+        if (!r.mirror)
+            r.download(pages);
+        bool pending = false;
+        for (uint16_t page : pages)
+            pending = pending || r.cpuPending[page] != 0u;
+        if (pending)
+        {
+            if (r.syncCpu)
+                r.syncCpu();
+            r.cpuPending.fill(0u);
+            ++r.statSyncs;
+        }
+    }
+    const uint32_t entryCount = fourBit ? 16u : 256u;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t destinationBase = (static_cast<uint32_t>(tex0.csa) & csaMask) << 4u;
+    const bool loadCsm1Suffix = tex0.csm == 0u && thirtyTwoBit && !fourBit;
+    const uint32_t firstEntry = loadCsm1Suffix ? destinationBase : 0u;
+    for (uint32_t entry = firstEntry; entry < entryCount; ++entry)
+    {
+        uint32_t sourceX = 0u, sourceY = 0u, sourceWidth = 1u;
+        if (tex0.csm == 0u)
+        {
+            const uint32_t sourceIndex = swizzleClutIndexCSM1(entry);
+            sourceX = sourceIndex & 0x0Fu;
+            sourceY = sourceIndex >> 4u;
+        }
+        else
+        {
+            sourceWidth = texclut.cbw != 0u ? static_cast<uint32_t>(texclut.cbw) : 1u;
+            sourceX = (static_cast<uint32_t>(texclut.cou) << 4u) + entry;
+            sourceY = static_cast<uint32_t>(texclut.cov);
+        }
+        const uint32_t raw = readPixel(r.vram, tex0.cpsm, tex0.cbp, sourceWidth, sourceX, sourceY);
+        const uint32_t destination = (loadCsm1Suffix ? entry : destinationBase + entry) & (sixteenBit ? 0x1FFu : 0x0FFu);
+        if (sixteenBit)
+        {
+            r.clut[destination] = static_cast<uint16_t>(raw);
+        }
+        else
+        {
+            r.clut[destination] = static_cast<uint16_t>(raw & 0xFFFFu);
+            r.clut[(destination + 256u) & 511u] = static_cast<uint16_t>(raw >> 16u);
+        }
+    }
+    ++r.clutVersion;
+    r.stateDirty = true; // the next draws take a copy of the new CLUT
+}
+
+void GSGpuRenderer::beginTransfer(const GSTransferCommand &command)
+{
+    Impl &r = *m;
+    if (!r.begin())
+        return;
+    r.transferPages.clear();
+    if (command.direction != 0u && command.direction != 2u)
+        return; // local to host: nothing changes
+    r.flushWhy = 7;
+    r.flush();
+    const GSBitBltBuf &b = command.bitbltbuf;
+    const int x0 = command.trxpos.dsax, y0 = command.trxpos.dsay;
+    const int x1 = x0 + std::max<int>(command.trxreg.rrw, 1) - 1;
+    const int y1 = y0 + std::max<int>(command.trxreg.rrh, 1) - 1;
+    pagesOf(r.transferPages, b.dbp, std::max<uint32_t>(b.dbw, 1u), kindOf(b.dpsm), x0, y0, x1, y1);
+    r.markMemoryWritten(r.transferPages);
+}
+
+void GSGpuRenderer::uploadImage()
+{
+    Impl &r = *m;
+    if (!r.begin() || r.transferPages.empty())
+        return;
+    r.flush();
+    r.markMemoryWritten(r.transferPages); // (what the GPU copied of it before this part came is stale)
+}
+
+void GSGpuRenderer::writeVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+{
+    Impl &r = *m;
+    if (!r.begin())
+        return;
+    r.flush();
+    PageList pages;
+    pagesOf(pages, base, std::max<uint32_t>(bw, 1u), kindOf(static_cast<uint8_t>(psm)), static_cast<int>(x), static_cast<int>(y),
+            static_cast<int>(x), static_cast<int>(y));
+    r.markMemoryWritten(pages);
+}
+
+void GSGpuRenderer::present(const GSPresentationRequest &request)
+{
+    Impl &r = *m;
+    if (!r.begin())
+        return;
+    // PS2X_DISPLAY_LOG=1: the display registers whenever they change but for the buffers' pages,
+    // which flips change (debugging aid).
+    static const bool displayLog = envFlag("PS2X_DISPLAY_LOG", false);
+    if (displayLog)
+    {
+        static uint64_t last[6] = {~0ull, ~0ull, ~0ull, ~0ull, ~0ull, ~0ull};
+        const uint64_t now[6] = {request.pmode, request.smode2, request.dispfb1, request.display1, request.dispfb2, request.display2};
+        const uint64_t key[6] = {now[0], now[1], now[2] & ~0x1FFull, now[3], now[4] & ~0x1FFull, now[5]};
+        if (std::memcmp(last, key, sizeof(key)) != 0)
+        {
+            std::memcpy(last, key, sizeof(key));
+            std::fprintf(stderr, "[display] tick %llu pmode %llx smode2 %llx dispfb1 %llx display1 %llx dispfb2 %llx display2 %llx\n",
+                         static_cast<unsigned long long>(request.vsyncTick), static_cast<unsigned long long>(now[0]),
+                         static_cast<unsigned long long>(now[1]), static_cast<unsigned long long>(now[2]),
+                         static_cast<unsigned long long>(now[3]), static_cast<unsigned long long>(now[4]),
+                         static_cast<unsigned long long>(now[5]));
+        }
+    }
+    if (g_drawLog.file)
+    {
+        g_drawLog.finish();
+        std::fprintf(g_drawLog.file, "---- present tick %llu: pmode %llx smode2 %llx dispfb1 %llx display1 %llx dispfb2 %llx display2 %llx\n",
+                     static_cast<unsigned long long>(request.vsyncTick), static_cast<unsigned long long>(request.pmode),
+                     static_cast<unsigned long long>(request.smode2), static_cast<unsigned long long>(request.dispfb1),
+                     static_cast<unsigned long long>(request.display1), static_cast<unsigned long long>(request.dispfb2),
+                     static_cast<unsigned long long>(request.display2));
+        if (request.vsyncTick >= g_drawLog.until)
+        {
+            std::fclose(g_drawLog.file);
+            g_drawLog.file = nullptr;
+        }
+        else
+        {
+            g_drawLog.begin(r.state);
+        }
+    }
+    else if (const char *env = std::getenv("PS2X_GPU_DRAWLOG"); env && request.vsyncTick == std::strtoull(env, nullptr, 10))
+    {
+        const std::string path = "runs/gpu_drawlog_" + std::to_string(request.vsyncTick) + ".txt";
+        g_drawLog.file = std::fopen(path.c_str(), "w");
+        g_drawLog.until = request.vsyncTick + 2u;
+        if (g_drawLog.file)
+            g_drawLog.begin(r.state);
+    }
+    r.flush();
+    r.presentPicture(request);
+    // The game flipped: the frame it draws now leaves its second field out if a picture had to
+    // wait for the GPU since the last flip - after a frame that left its own out only when the
+    // wait was long (more than half a frame): the GPU is about a frame behind the GS thread, and
+    // that frame's saving has not reached it yet (one wait a time left about twice as many out
+    // as the GPU needed).
+    if (request.dispfb1 != r.lastDispfb[0] || request.dispfb2 != r.lastDispfb[1])
+    {
+        r.lastDispfb[0] = request.dispfb1;
+        r.lastDispfb[1] = request.dispfb2;
+        uint32_t block = 0u, firstRow = 0u, lastRow = 0u;
+        bool behind = r.pictureWaited && (!r.secondFieldLeftOut || r.pictureWaitMs > 8.0f);
+        // (PS2X_SECOND_FIELD_DROP=<n>, testing aid: every n-th frame leaves it out as well.)
+        static const uint64_t dropEvery = []()
+        {
+            const char *env = std::getenv("PS2X_SECOND_FIELD_DROP");
+            return env ? std::strtoull(env, nullptr, 10) : 0ull;
+        }();
+        static uint64_t flips = 0u;
+        if (dropEvery != 0u && ++flips % dropEvery == 0u)
+            behind = true;
+        // The moments of the frame the game draws now (moment pictures; its field B is needed for
+        // them, so not left out): fewer of them while the GPU is behind (momentCap).
+        if (r.pictureWaited && r.momentsActive)
+        {
+            ++r.statMomentBehind;
+            r.statMomentWaitMs += r.pictureWaitMs;
+            r.statMomentWaitMost = std::max(r.statMomentWaitMost, static_cast<double>(r.pictureWaitMs));
+        }
+        const uint32_t missed = ps2_host_display::momentsMissed(); // (read every flip: none kept from before the moments)
+        if (r.momentsActive)
+            r.statMomentMissed += missed; // (moments handed over late)
+        if (r.momentsActive && !r.momentsWereActive)
+            r.momentQuiet = 120;
+        r.momentsWereActive = r.momentsActive;
+        const bool quiet = r.momentQuiet > 0;
+        if (quiet)
+            --r.momentQuiet;
+        // (Behind is judged as shares over about 20 frames: of frames whose pictures this thread waited
+        // more than 4 ms for, and of moments handed over late. A hitch - a few frames late together -
+        // and short waits now and then on a GPU other programs share are not the GPU short of time
+        // and are not helped by a moment less; counted one by one they took the cap 170, 120, 60 a
+        // second by turns where the user walked into the Mini-Con's clearing: 4 of 340 moments late,
+        // waits of 3-5 ms in a fifth of the frames, the GPU at 12 ms of 16.7 and RuneLite on it.)
+        const float lateShare = r.momentsActive && r.momentCount > 0
+                                    ? std::min(1.0f, static_cast<float>(missed) / static_cast<float>(r.momentCount))
+                                    : 0.0f;
+        r.momentLate = r.momentLate * 0.95f + lateShare * 0.05f;
+        r.momentWaits = r.momentWaits * 0.95f + (r.pictureWaited && r.pictureWaitMs > 4.0f ? 0.05f : 0.0f);
+        const bool strike = !quiet && (r.momentWaits > 0.3f || r.momentLate > 0.2f);
+        r.momentStrikes = r.momentStrikes * 0.9f + (strike ? 1.0f : 0.0f);
+        ++r.momentSinceRaise;
+        if (strike && r.momentStrikes > 1.5f)
+        {
+            // (The calm before a moment more is tried starts again only when one is taken off. A strike
+            // alone - a moment a few ms late, a wait - comes now and then at any cap, at one moment a
+            // frame as at four: it kept a cap that a freeze or a level's first frames had taken down
+            // there for good - 60 pictures a second where the GPU had room for 170.)
+            // (At one moment a frame there is none to take off: the next try at two still comes - a
+            // GPU shared with other programs has room again later - only seldom where it fails.)
+            if (r.momentCap > 1)
+            {
+                r.momentCalm = 0;
+                if (r.momentSinceRaise < 120)
+                    r.momentCalmNeeded = std::min(r.momentCalmNeeded * 2, 600);
+                --r.momentCap;
+            }
+            r.momentStrikes = 0.0f;
+            r.momentLate = r.momentWaits = 0.0f; // (judged afresh at the new cap: not one more off for the same)
+            r.momentQuiet = 10;
+        }
+        else if (r.momentsActive && ++r.momentCalm >= r.momentCalmNeeded && r.momentCap < kMaxMoments)
+        {
+            ++r.momentCap;
+            r.momentCalm = 0;
+            r.momentSinceRaise = 0;
+        }
+        if (r.momentSinceRaise == 600)
+            r.momentCalmNeeded = 60;
+        ps2_host_display::noteMomentCap(r.momentCap);
+        r.pickMoments(request.vsyncTick);
+        ++r.statFlips;
+        r.secondFieldLeftOut = behind && !r.momentsActive && ps2_host_display::fieldsAsMoments() &&
+                               ps2_host_display::secondFieldDraws(block, firstRow, lastRow);
+        r.pictureWaited = false;
+        r.pictureWaitMs = 0.0f;
+        r.stateLeftOut = r.secondFieldLeftOut && r.secondFieldDraw(r.state);
+        if (r.secondFieldLeftOut)
+            ps2_host_display::noteSecondFieldLeftOut();
+    }
+    if (r.stats)
+        r.printStats();
+}
+
+bool GSGpuRenderer::ready()
+{
+    return m->begin();
+}
+
+// A frame's draws reach the GS thread over a few ms of the frame, its pictures at the end of
+// it, after the game's next flip (Transformers: both VBlanks' latches together, just before
+// the next frame's draws). The driver kept what was drawn until the picture's glFlush: the
+// GPU started a frame's work most of a frame late, and with two pictures a frame at 4K it
+// had less time than the frame for it.
+void GSGpuRenderer::idle()
+{
+    Impl &r = *m;
+    if (!r.tried || !r.ready || !r.vram)
+        return;
+    r.flush();
+    glFlush();
+}
+
+void GSGpuRenderer::beforeTransfer(const GSTransferCommand &command)
+{
+    Impl &r = *m;
+    if (r.mirror || !r.begin())
+        return;
+    PageList pages;
+    const GSBitBltBuf &b = command.bitbltbuf;
+    const int w = std::max<int>(command.trxreg.rrw, 1), h = std::max<int>(command.trxreg.rrh, 1);
+    if (command.direction == 1u || command.direction == 2u) // reads the source
+    {
+        pagesOf(pages, b.sbp, std::max<uint32_t>(b.sbw, 1u), kindOf(b.spsm), command.trxpos.ssax, command.trxpos.ssay,
+                command.trxpos.ssax + w - 1, command.trxpos.ssay + h - 1);
+        ++r.statReadbacks;
+        for (uint16_t page : pages)
+            r.statReadbackPages += (r.gpuNewer[page] || r.owner[page] || r.framePages.test(page)) ? 1u : 0u;
+        static int logged = 0;
+        if (r.stats && logged < 12)
+        {
+            ++logged;
+            std::fprintf(stderr, "[gpu] transfer dir %u: sbp %u sbw %u spsm %u at %u,%u size %ux%u -> dbp %u dbw %u dpsm %u at %u,%u\n",
+                         command.direction, b.sbp, b.sbw, b.spsm, command.trxpos.ssax, command.trxpos.ssay, command.trxreg.rrw,
+                         command.trxreg.rrh, b.dbp, b.dbw, b.dpsm, command.trxpos.dsax, command.trxpos.dsay);
+        }
+    }
+    if (command.direction == 0u || command.direction == 2u) // writes part of the destination's pages
+        pagesOf(pages, b.dbp, std::max<uint32_t>(b.dbw, 1u), kindOf(b.dpsm), command.trxpos.dsax, command.trxpos.dsay,
+                command.trxpos.dsax + w - 1, command.trxpos.dsay + h - 1);
+    r.download(pages);
+}
+
+void GSGpuRenderer::beforeWriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+{
+    Impl &r = *m;
+    if (r.mirror || !r.begin())
+        return;
+    PageList pages;
+    pagesOf(pages, base, std::max<uint32_t>(bw, 1u), kindOf(static_cast<uint8_t>(psm)), static_cast<int>(x), static_cast<int>(y),
+            static_cast<int>(x), static_cast<int>(y));
+    r.download(pages);
+}
+
+void GSGpuRenderer::downloadAll()
+{
+    Impl &r = *m;
+    if (r.mirror || !r.begin())
+        return;
+    PageList pages(kPages);
+    for (uint32_t page = 0; page < kPages; ++page)
+        pages[page] = static_cast<uint16_t>(page);
+    r.download(pages);
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_gpu_shaders.h b/ps2xRuntime/src/lib/gs/gs_gpu_shaders.h
new file mode 100644
index 0000000..b8b7ba9
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gpu_shaders.h
@@ -0,0 +1,1656 @@
+#pragma once
+
+// GLSL of the GPU renderer (gs_gpu.cpp).
+//
+// Drawing follows the software renderer (gs_raster.h: TexSampler, combineTexel,
+// PixelPipe::shade) after rasterization. Frame and depth buffers are R32UI images holding the
+// GS's own pixel values; the fragment shader reads and writes them inside a pixel interlock
+// (GL_ARB_fragment_shader_interlock) in primitive order, so blending, the depth, alpha and
+// destination alpha tests and the frame mask are the GS's, and all the draws of a run share
+// one pipeline state: each draw's registers are an entry of a buffer, and a run of them is
+// one draw call. Textures are read from a GPU copy of GS local memory with the GS's swizzle.
+//
+// Scale: a GS pixel is scaleX x scaleY GL pixels (more across than down for a picture shown
+// 16:9); vertex positions are multiplied by them, so the GL picture is what a GS of that many
+// times the resolution would draw. Uniforms that carry both pack them as scaleX | scaleY << 8.
+
+namespace gs_gpu_glsl
+{
+    inline const char *kVersion = "#version 450 core\n";
+
+    // Local memory, its swizzle and the CLUTs; shared by the programs that read local memory
+    // (and the one that writes buffers back to it, which defines MEM_QUALIFIER first).
+    inline const char *kMemory = R"(
+#ifndef MEM_QUALIFIER
+#define MEM_QUALIFIER readonly
+#endif
+layout(std430, binding = 1) MEM_QUALIFIER buffer GsMemory { uint mem[]; };
+layout(std430, binding = 2) readonly buffer GsSwizzle { uint swizzle[]; };
+layout(std430, binding = 3) readonly buffer GsCluts { uint cluts[]; };
+
+// Address layouts: 0 C32 (also C24, P8H, P4HL, P4HH), 1 Z32 (Z24), 2 C16, 3 C16S, 4 Z16,
+// 5 Z16S, 6 P8, 7 P4. The swizzle table holds the address of each pixel of a page that
+// starts at block 0 (GSMem's page tables, block 0).
+const uint kPageW[8] = uint[8](64u, 64u, 64u, 64u, 64u, 64u, 128u, 128u);
+const uint kPageH[8] = uint[8](32u, 32u, 64u, 64u, 64u, 64u, 64u, 128u);
+// (their logarithms: the page sizes are powers of two, so the divisions below are shifts -
+// integer division by a size not known when compiling takes a run of slow multiplies)
+const uint kPageWShift[8] = uint[8](6u, 6u, 6u, 6u, 6u, 6u, 7u, 7u);
+const uint kPageHShift[8] = uint[8](5u, 5u, 6u, 6u, 6u, 6u, 6u, 7u);
+const uint kTableBase[8] = uint[8](0u, 2048u, 4096u, 8192u, 12288u, 16384u, 20480u, 28672u);
+
+// GSMem::PixelStorageTraits::Address: the pixel's index in units of its own size.
+uint gsAddress(uint kind, uint bp, uint bw, uint x, uint y)
+{
+    uint ws = kPageWShift[kind];
+    uint hs = kPageHShift[kind];
+    uint pw = 1u << ws;
+    uint ph = 1u << hs;
+    uint page = (bp >> 5) + (y >> hs) * ((max(bw, 1u) * 64u) >> ws) + (x >> ws);
+    uint local = swizzle[kTableBase[kind] + ((y & (ph - 1u)) << ws) + (x & (pw - 1u))] + (bp & 31u) * (1u << (ws + hs - 5u));
+    return ((page << ws) << hs) + local;
+}
+
+uint readMem32(uint pixel) { return mem[pixel & 0xFFFFFu]; }
+uint readMem16(uint pixel)
+{
+    uint word = mem[(pixel >> 1) & 0xFFFFFu];
+    return (pixel & 1u) != 0u ? (word >> 16) : (word & 0xFFFFu);
+}
+uint readMem8(uint pixel) { return (mem[(pixel >> 2) & 0xFFFFFu] >> ((pixel & 3u) * 8u)) & 0xFFu; }
+uint readMem4(uint pixel) { return (mem[(pixel >> 3) & 0xFFFFFu] >> ((pixel & 7u) * 4u)) & 0xFu; }
+
+uint expand5551(uint c)
+{
+    return ((c & 0x1Fu) << 3) | (((c >> 5) & 0x1Fu) << 11) | (((c >> 10) & 0x1Fu) << 19) | (((c >> 15) & 1u) << 31);
+}
+
+uint pack5551(uint c)
+{
+    return ((c & 0xFFu) >> 3) | ((((c >> 8) & 0xFFu) >> 3) << 5) | ((((c >> 16) & 0xFFu) >> 3) << 10) | ((c >> 31) << 15);
+}
+
+// TEXA: the alpha of RGB24 texels (bits 24) and RGBA16 ones (bits 16, expanded).
+uint applyTexa(uint c, uint bits, uint ta0, uint ta1, uint aem)
+{
+    bool rgbZero = (c & 0x00FFFFFFu) == 0u;
+    uint a;
+    if (bits == 24u)
+        a = (aem != 0u && rgbZero) ? 0u : ta0;
+    else
+        a = (c & 0x80000000u) != 0u ? ta1 : ((aem != 0u && rgbZero) ? 0u : ta0);
+    return (c & 0x00FFFFFFu) | (a << 24);
+}
+
+uint clutHalf(uint slot, uint index)
+{
+    uint word = cluts[slot * 256u + ((index & 511u) >> 1)];
+    return (index & 1u) != 0u ? (word >> 16) : (word & 0xFFFFu);
+}
+
+// GSCpuBackend::LookupCLUT. clut: slot of the copy, cpsm, csm, csa.
+uint lookupClut(uvec4 clut, uint index, bool fourBit, uint ta0, uint ta1, uint aem)
+{
+    uint cpsm = clut.y;
+    bool sixteen = cpsm == 2u || cpsm == 10u;
+    uint base = (clut.w & (sixteen ? 0x1Fu : 0x0Fu)) << 4;
+    uint source = fourBit ? (index & 0xFu) : index;
+    uint ci = (base + source) & (sixteen ? 0x1FFu : 0xFFu);
+    if (!sixteen && clut.z == 0u && !fourBit)
+        ci = min((source & 0xF0u) + base, 240u) + (source & 0xFu);
+    if (sixteen)
+        return applyTexa(expand5551(clutHalf(clut.x, ci)), 16u, ta0, ta1, aem);
+    uint raw = clutHalf(clut.x, ci) | (clutHalf(clut.x, ci + 256u) << 16);
+    if (cpsm == 1u)
+        return applyTexa(raw, 24u, ta0, ta1, aem);
+    return raw;
+}
+)";
+
+    inline const char *kDrawVertex = R"(#version 450 core
+layout(location = 0) in vec2 aPos;
+layout(location = 1) in uint aZ;
+layout(location = 2) in uvec4 aColor;
+layout(location = 3) in vec3 aTex;
+layout(location = 4) in uint aPacked; // draw index (24 bits), fog (8 bits)
+uniform vec4 uTarget;                 // viewport width, height (GL pixels), scale x, y
+noperspective out vec4 vColor;
+flat out uvec4 vFlat;
+noperspective out vec3 vTex;
+noperspective out float vFog;
+flat out uint vFlatFog;
+noperspective out float vZ;
+flat out uint vFlatZ;
+flat out uint vDraw;
+void main()
+{
+    // GS coordinate x is GL coordinate (x + 0.5) * scaleX (y likewise): a GS pixel's block is
+    // centred on its sample point (a whole coordinate), so it stands for [x - 0.5, x + 0.5).
+    // At scale 1 the sample points are pixel centres. The game draws its 2D and its screen
+    // passes with edges on half coordinates (-0.5 to 511.5): they cover whole blocks, and a
+    // copy of a buffer at the scale lands pixel for pixel.
+    vec2 window = (aPos + 0.5) * uTarget.zw;
+    gl_Position = vec4(window / uTarget.xy * 2.0 - 1.0, 0.0, 1.0);
+    vColor = vec4(aColor);
+    vFlat = aColor;
+    vTex = aTex;
+    vFog = float(aPacked >> 24);
+    vFlatFog = aPacked >> 24;
+    vZ = float(aZ);
+    vFlatZ = aZ;
+    vDraw = aPacked & 0xFFFFFFu;
+}
+)";
+
+    // Native meshes (runtime/gs/gs_native_mesh.h), their vertices made on the GPU: a thread a
+    // triangle, its three corners as 0x1410 and the GS front end make them - through the field's
+    // matrix, Q = 1/w, XYZ to 12.4 and back, less the XYOFFSET, Z's 24 bits, the fog from the kick
+    // word, ST * Q (a Q of 0 as 1) - into the slots of the batch's vertices kept for them. In VU1's
+    // arithmetic, to the bit: each product, sum and the reciprocal rounded toward zero (the GPU
+    // rounds to nearest: the exact error of each says which way it went and the result is stepped
+    // back where it went away from zero - a product's error in double precision, where the product
+    // of two floats is exact: the driver's fma was not fused), results below the smallest normal
+    // as zero, past the largest as the largest.
+    inline const char *kMeshExpand = R"(#version 450 core
+layout(local_size_x = 64) in;
+struct Vertex
+{
+    float x;
+    float y;
+    uint z;
+    uint rgba;
+    float s;
+    float t;
+    float q;
+    uint packed;
+};
+layout(std430, binding = 7) writeonly buffer Vertices { Vertex vertices[]; };
+layout(std430, binding = 4) readonly buffer MeshWords { uint words[]; };
+layout(std430, binding = 5) readonly buffer MeshTable { uint table[]; };
+uniform uint uTriangles;    // triangles to make
+uniform uint uTriangleBase; // where their entries begin in the table (after the jobs, four words each)
+uniform uint uZero;         // 0: what `opaque` hides from the compiler
+
+const float kMax = 3.4028234663852886e38;
+
+// The value as it is, where the compiler cannot see it is the same: an error term such as
+// fma(a, b, -(a * b)) is not to be simplified to 0, `precise` or not.
+float opaque(float value) { return uintBitsToFloat(floatBitsToUint(value) ^ uZero); }
+const float kMin = 1.1754943508222875e-38;
+
+float wordFloat(uint i) { return uintBitsToFloat(words[i]); }
+
+// One step toward zero (from a nonzero finite value).
+float towardZero(float value) { return uintBitsToFloat(floatBitsToUint(value) - 1u); }
+
+// A result rounded to nearest, made the one rounded toward zero: `error` is the exact value less
+// the result. Overflow as +-the largest float, results below the smallest normal as a signed zero.
+float rz(float result, float error)
+{
+    if (isinf(result))
+        return result > 0.0 ? kMax : -kMax;
+    if (error != 0.0 && (error < 0.0) != (result < 0.0))
+        result = towardZero(result);
+    if (abs(result) < kMin)
+        return uintBitsToFloat(floatBitsToUint(result) & 0x80000000u);
+    return result;
+}
+
+float mulRz(float a, float b)
+{
+    precise float product = a * b;
+    if (isinf(product))
+        return rz(product, 0.0);
+    precise double exact = double(a) * double(b);
+    precise double error = exact - double(opaque(product));
+    return rz(product, error < 0.0lf ? -1.0 : (error > 0.0lf ? 1.0 : 0.0));
+}
+
+float addRz(float a, float b)
+{
+    precise float sum = a + b;
+    if (isinf(sum))
+        return sum > 0.0 ? kMax : -kMax;
+    precise float bPart = opaque(sum) - a;
+    precise float aPart = opaque(sum) - opaque(bPart);
+    precise float error = (a - opaque(aPart)) + (b - opaque(bPart));
+    return rz(sum, error);
+}
+
+// DIV Q, VF00w, w: 1/w toward zero, or +-the largest float by w's sign for a zero (or denormal) w.
+float reciprocalRz(float w)
+{
+    if (abs(w) < kMin)
+        return (floatBitsToUint(w) & 0x80000000u) != 0u ? -kMax : kMax;
+    float magnitude = abs(w);
+    float r = 1.0 / magnitude;
+    // the largest r with magnitude * r <= 1 (the sign of 1 - magnitude * r, fused - which GLSL
+    // promises only for a result kept in a precise variable - is exact)
+    // (1 - magnitude * r in double precision: the product exact, the difference too)
+    for (int i = 0; i < 4; ++i)
+    {
+        precise double residual = 1.0lf - double(magnitude) * double(opaque(r));
+        if (residual >= 0.0lf)
+            break;
+        r = towardZero(r);
+    }
+    for (int i = 0; i < 4; ++i)
+    {
+        float up = uintBitsToFloat(floatBitsToUint(r) + 1u);
+        precise double residual = 1.0lf - double(magnitude) * double(opaque(up));
+        if (residual < 0.0lf)
+            break;
+        r = up;
+    }
+    return w < 0.0 ? -r : r;
+}
+
+// FTOI4: toward zero, from 2^31 as 0x7FFFFFFF, below -2^31 as 0x80000000.
+int ftoi4(float value)
+{
+    float scaled = mulRz(value, 16.0);
+    if (scaled >= 2147483648.0)
+        return 0x7FFFFFFF;
+    if (scaled < -2147483648.0)
+        return int(0x80000000u);
+    return int(scaled);
+}
+
+void main()
+{
+    uint t = gl_GlobalInvocationID.x;
+    if (t >= uTriangles)
+        return;
+    uint slot = table[uTriangleBase + 2u * t];
+    uint jobAndVertex = table[uTriangleBase + 2u * t + 1u];
+    uint job = jobAndVertex >> 5u, last = jobAndVertex & 31u;
+    uint data = table[4u * job], entry = table[4u * job + 1u];
+    float ofx = uintBitsToFloat(table[4u * job + 2u]), ofy = uintBitsToFloat(table[4u * job + 3u]);
+    bool textured = (entry >> 24u) != 0u;
+    float m[16];
+    for (uint i = 0u; i < 16u; ++i)
+        m[i] = wordFloat(data + i);
+    uint masks0 = words[data + 16u], masks1 = words[data + 17u];
+    for (uint c = 0u; c < 3u; ++c)
+    {
+        uint k = last - 2u + c;
+        uint at = data + 20u + 12u * k;
+        float px = wordFloat(at + 8u), py = wordFloat(at + 9u), pz = wordFloat(at + 10u);
+        // MULAw ACC, row3, 1; MADDAz ACC, row2, z; MADDAy ACC, row1, y; MADDx clip, row0, x
+        float clip[4];
+        for (uint l = 0u; l < 4u; ++l)
+        {
+            float acc = mulRz(m[12u + l], 1.0);
+            acc = addRz(acc, mulRz(m[8u + l], pz));
+            acc = addRz(acc, mulRz(m[4u + l], py));
+            clip[l] = addRz(acc, mulRz(m[l], px));
+        }
+        float q = reciprocalRz(clip[3]);
+        int x16 = ftoi4(mulRz(clip[0], q)), y16 = ftoi4(mulRz(clip[1], q)), z16 = ftoi4(mulRz(clip[2], q));
+        uint mask = k < 16u ? masks0 : masks1;
+        uint shift = k < 16u ? k : k - 16u;
+        uint kick = shift < 16u ? (mask << shift) & 0xFFFFu : 0u;
+        Vertex v;
+        v.x = float(uint(x16) & 0xFFFFu) / 16.0 - ofx;
+        v.y = float(uint(y16) & 0xFFFFu) / 16.0 - ofy;
+        v.z = (uint(z16) >> 4u) & 0xFFFFFFu;
+        v.rgba = (words[at + 4u] & 0xFFu) | ((words[at + 5u] & 0xFFu) << 8u) | ((words[at + 6u] & 0xFFu) << 16u) |
+                 ((words[at + 7u] & 0xFFu) << 24u);
+        if (textured)
+        {
+            v.s = mulRz(wordFloat(at), q);
+            v.t = mulRz(wordFloat(at + 1u), q);
+            float qq = mulRz(wordFloat(at + 2u), q);
+            v.q = qq == 0.0 ? 1.0 : qq;
+        }
+        else
+        {
+            v.s = 0.0;
+            v.t = 0.0;
+            v.q = 0.0;
+        }
+        v.packed = (entry & 0xFFFFFFu) | (((kick >> 4u) & 0xFFu) << 24u);
+        vertices[slot + c] = v;
+    }
+}
+)";
+
+    inline const char *kDrawFragmentHead = R"(#version 450 core
+#extension GL_ARB_fragment_shader_interlock : require
+layout(pixel_interlock_ordered) in;
+)";
+
+    // A draw's registers (GpuDraw), as the draw programs read them - and the native path's vertex
+    // shader, which hands the pixels what they need of them (kNativeVertex).
+    inline const char *kDrawStruct = R"(
+struct Draw
+{
+    uvec4 tex0;     // mode (0 none, 1 coordinates in 1/256 texels, 2 STQ), source (0 memory, 1-4 image), psm, linear
+    uvec4 tex1;     // tbp, tbw, texW, texH
+    uvec4 tex2;     // wrapU, wrapV, tfx, tcc
+    uvec4 region;   // minU, maxU, minV, maxV
+    vec4 texScale;  // STQ to 1/256 texels (U, V); an image source's value bits (32, 16), -
+    uvec4 clut;     // slot of the CLUT copy, cpsm, csm, csa
+    uvec4 texa;     // ta0, ta1, aem, -
+    uvec4 fog;      // fge, r, g, b
+    uvec4 test;     // ate, atst, aref, afail
+    uvec4 depth;    // ztst (1-3), zwrite, zmax, depth value bits (32, 24, 16)
