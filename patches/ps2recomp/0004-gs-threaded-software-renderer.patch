+namespace
+{
+    constexpr uint32_t kPages = 512u;
+    constexpr uint32_t kPageBytes = 8192u;
+    constexpr int kMaxCoord = 2048; // GS coordinates are below this
+    constexpr int kPictureWidth = 640;
+    constexpr int kPictureHeight = 512;
+    constexpr size_t kMaxTargets = 64u;
+    // Moment pictures (docs/RENDERER.md, stage 4): up to four a frame (240 Hz at 60 frames), each
+    // a field picture of the display buffer after the two fields' (Target::shadow).
+    constexpr int kMaxMoments = 4;
+    constexpr int kShadows = 2 + kMaxMoments;
+
+    using PageList = std::vector<uint16_t>;
+    using PageSet = std::bitset<kPages>;
+
+    // Address layouts of local memory, numbered as the shaders do.
+    enum Kind : uint8_t
+    {
+        kC32 = 0, // also CT24 and the H formats
+        kZ32 = 1, // also Z24
+        kC16 = 2,
+        kC16S = 3,
+        kZ16 = 4,
+        kZ16S = 5,
+        kP8 = 6,
+        kP4 = 7,
+        kNoKind = 0xFF,
+    };
+    constexpr uint32_t kKindPageW[8] = {64u, 64u, 64u, 64u, 64u, 64u, 128u, 128u};
+    constexpr uint32_t kKindPageH[8] = {32u, 32u, 64u, 64u, 64u, 64u, 64u, 128u};
+
+    Kind kindOf(uint8_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_CT24:
+        case GS_PSM_T8H:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            return kC32;
+        case GS_PSM_Z32:
+        case GS_PSM_Z24:
+            return kZ32;
+        case GS_PSM_CT16:
+            return kC16;
+        case GS_PSM_CT16S:
+            return kC16S;
+        case GS_PSM_Z16:
+            return kZ16;
+        case GS_PSM_Z16S:
+            return kZ16S;
+        case GS_PSM_T8:
+            return kP8;
+        case GS_PSM_T4:
+            return kP4;
+        default:
+            return kNoKind;
+        }
+    }
+
+    bool isBufferKind(Kind kind) { return kind <= kZ16S; } // layouts of frame and depth buffers
+    bool is16Kind(Kind kind) { return kind >= kC16 && kind <= kZ16S; }
+    bool isIndexed4(uint8_t psm) { return psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH; }
+    bool isIndexed(uint8_t psm) { return isIndexed4(psm) || psm == GS_PSM_T8 || psm == GS_PSM_T8H; }
+
+    // Bits of a frame or depth buffer's values: 32, 24 (the top byte is not the buffer's), 16.
+    uint32_t valueBits(uint8_t psm)
+    {
+        if (psm == GS_PSM_CT24 || psm == GS_PSM_Z24)
+            return 24u;
+        return is16Kind(kindOf(psm)) ? 16u : 32u;
+    }
+
+    // The pages of local memory a rectangle of a buffer or texture covers (PageId, and the
+    // next page for a base that is not page aligned).
+    void pagesOf(PageList &out, uint32_t bp, uint32_t bw, Kind kind, int x0, int y0, int x1, int y1)
+    {
+        if (kind == kNoKind)
+            return;
+        x0 = std::max(x0, 0);
+        y0 = std::max(y0, 0);
+        x1 = std::min(x1, kMaxCoord - 1);
+        y1 = std::min(y1, kMaxCoord - 1);
+        if (x1 < x0 || y1 < y0)
+            return;
+        const uint32_t pw = kKindPageW[kind], ph = kKindPageH[kind];
+        const uint32_t perRow = (std::max<uint32_t>(bw, 1u) * 64u) / pw;
+        const uint32_t base = bp >> 5u;
+        const uint32_t spill = (bp & 31u) != 0u ? 1u : 0u;
+        for (uint32_t py = static_cast<uint32_t>(y0) / ph; py <= static_cast<uint32_t>(y1) / ph; ++py)
+            for (uint32_t px = static_cast<uint32_t>(x0) / pw; px <= static_cast<uint32_t>(x1) / pw; ++px)
+                for (uint32_t k = 0u; k <= spill; ++k)
+                    out.push_back(static_cast<uint16_t>((base + py * perRow + px + k) & (kPages - 1u)));
+    }
+
+    // A pixel of local memory in the given format (raw bits), for the CLUT.
+    uint32_t readPixel(const uint8_t *vram, uint8_t psm, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        using namespace GSMem;
+        bw = std::max<uint32_t>(bw, 1u);
+        const auto load32 = [vram](uint32_t byteOffset)
+        {
+            uint32_t v;
+            std::memcpy(&v, vram + (byteOffset & 0x3FFFFCu), 4);
+            return v;
+        };
+        const auto load16 = [vram](uint32_t byteOffset)
+        {
+            uint16_t v;
+            std::memcpy(&v, vram + (byteOffset & 0x3FFFFEu), 2);
+            return static_cast<uint32_t>(v);
+        };
+        switch (psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_CT24:
+            return load32(PixelStorageTraits<C32>::Address(PageTableC32, bp, bw, x, y) << 2u);
+        case GS_PSM_CT16:
+            return load16(PixelStorageTraits<C16>::Address(PageTableC16, bp, bw, x, y) << 1u);
+        case GS_PSM_CT16S:
+            return load16(PixelStorageTraits<C16S>::Address(PageTableC16S, bp, bw, x, y) << 1u);
+        default:
+            return 0u;
+        }
+    }
+
+    // CSM1 swaps address bits 3 and 4.
+    uint32_t swizzleClutIndexCSM1(uint32_t index)
+    {
+        return (index & ~0x18u) | ((index & 0x08u) << 1u) | ((index & 0x10u) >> 1u);
+    }
+
+    int decodeExtent(int size, uint8_t mode, int lo, int hi)
+    {
+        if (mode == 2u)
+            return std::max(size, hi + 1);
+        if (mode == 3u)
+            return std::max(size, (lo | hi) + 1);
+        return size;
+    }
