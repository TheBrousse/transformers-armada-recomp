+    // The first and last page a rectangle can touch, before they wrap around at 512.
+    GS_FAST_INLINE void pageBounds(uint32_t bp, uint32_t bw, uint8_t psm, int x0, int y0, int x1, int y1, uint32_t &first,
+                                   uint32_t &last)
+    {
+        uint32_t widthShift = 0u;
+        uint32_t heightShift = 0u;
+        pageShifts(psm, widthShift, heightShift);
+        const uint32_t pagesPerRow = (bw * 64u) >> widthShift;
+        const uint32_t basePage = bp >> 5u;
+        first = basePage + (static_cast<uint32_t>(std::max(y0, 0)) >> heightShift) * pagesPerRow +
+                (static_cast<uint32_t>(std::max(x0, 0)) >> widthShift);
+        last = basePage + (static_cast<uint32_t>(std::max(y1, 0)) >> heightShift) * pagesPerRow +
+               (static_cast<uint32_t>(std::max(x1, 0)) >> widthShift) + 1u;
+    }
