+        GpuDraw field = d;
+        field.frame[3] = 0u;
+        field.depth[0] = 1u;
+        field.depth[1] = 0u;
+        if (field.tex0[1] >= 1u && field.tex0[1] <= 4u) // (a buffer's picture; replacements stay)
