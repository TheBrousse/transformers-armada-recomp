new file mode 100644
index 0000000..f422467
--- /dev/null
+++ b/ps2xRecomp/include/ps2recomp/register_cache.h
@@ -0,0 +1,27 @@
+#ifndef PS2RECOMP_REGISTER_CACHE_H
+#define PS2RECOMP_REGISTER_CACHE_H
+
+#include <string>
+#include <string_view>
+
+namespace ps2recomp
+{
+    // The register cache (ps2_register_cache.h in the runtime): a generated function keeps the low
+    // 64 bits of each general register it names in a C++ local instead of going through the
+    // context at every instruction, so the C++ compiler can keep them in host registers. The
+    // locals go back to the context before anything else can look at it (a call, a syscall, a
+    // return) and are loaded again after a call comes back.
+    //
+    // `functionText` is FunctionEmitter's output for one function and is rewritten in place.
+    // False when it is left as it is: nothing to cache (`whyNot` empty), or something the rewrite
+    // does not know (`whyNot` says what).
+    bool applyRegisterCache(std::string &functionText, std::string &whyNot);
+
+    // Whether an instruction's C++ (one or more lines) can look at ctx->pc or the delay slot's
+    // state: it hands the context to the runtime or another function, raises an exception,
+    // returns or jumps. Register, FPU and memory macros do not (a load or store that faults sets
+    // COP0 from the pc, but the guest code goes on as it was).
+    bool translationObservesPc(std::string_view code);
+}
+
+#endif // PS2RECOMP_REGISTER_CACHE_H
