diff --git a/ps2xRecomp/src/lib/register_cache.cpp b/ps2xRecomp/src/lib/register_cache.cpp
new file mode 100644
index 0000000..16ec0ba
--- /dev/null
+++ b/ps2xRecomp/src/lib/register_cache.cpp
@@ -0,0 +1,715 @@
+#include "ps2recomp/register_cache.h"
+
+#include <algorithm>
+#include <bitset>
+#include <cctype>
+#include <string_view>
+#include <vector>
+
+// The FPU's registers the same way: ctx->f[n] becomes the local rf_<n>.
+//
+// Writes go through to the context at once (RC_SET_*, and RC_FST after a line that writes an
+// FPU register), so the context is always current and nothing has to be written back before a
+// call or a return; reads come from the locals. After anything that may change the context's
+// registers - a call, a syscall, a stub - the locals are loaded again (the C++ compiler drops
+// the loads of the ones not read before they are written).
+//
+// The rewrite works on FunctionEmitter's text, whose shapes it knows (ControlFlowEmitter): a call
+// is `if (!runtime->dispatchGuestBranch(rdram, ctx, ...)) {` + `return;` + `}`, a tail jump
+// `name(rdram, ctx, runtime); return;`, a syscall or stub one statement on its line. A function
+// with anything it cannot place is left as it was.
+
+namespace ps2recomp
+{
+    namespace
+    {
+        bool isIdentChar(char c)
+        {
+            return std::isalnum(static_cast<unsigned char>(c)) != 0 || c == '_';
+        }
+
+        std::string_view trim(std::string_view s)
+        {
+            size_t start = 0;
+            while (start < s.size() && (s[start] == ' ' || s[start] == '\t' || s[start] == '\r'))
+                ++start;
+            size_t end = s.size();
+            while (end > start && (s[end - 1] == ' ' || s[end - 1] == '\t' || s[end - 1] == '\r'))
+                --end;
+            return s.substr(start, end - start);
+        }
+
+        std::string_view indentOf(std::string_view line)
+        {
+            size_t n = 0;
+            while (n < line.size() && (line[n] == ' ' || line[n] == '\t'))
+                ++n;
+            return line.substr(0, n);
+        }
+
+        // 1 for the line's code, 0 inside comments and string or character literals.
+        void markCode(std::string_view line, std::vector<char> &code)
+        {
+            code.assign(line.size(), 1);
+            size_t i = 0;
+            while (i < line.size())
+            {
+                const char c = line[i];
+                if (c == '/' && i + 1 < line.size() && line[i + 1] == '/')
+                {
+                    std::fill(code.begin() + static_cast<std::ptrdiff_t>(i), code.end(), 0);
+                    return;
+                }
+                if (c == '"' || c == '\'')
+                {
+                    const size_t start = i++;
+                    while (i < line.size() && line[i] != c)
+                        i += line[i] == '\\' ? 2 : 1;
+                    i = std::min(i + 1, line.size());
+                    std::fill(code.begin() + static_cast<std::ptrdiff_t>(start),
+                              code.begin() + static_cast<std::ptrdiff_t>(i), 0);
+                    continue;
+                }
+                ++i;
+            }
+        }
+
+        struct GprMacro
+        {
+            std::string_view name;
+            std::string_view cached;
+            bool write;
+        };
+
+        // ps2_runtime_macros.h's accessors (getRegU32: ps2_runtime.h) and their cached forms
+        // (ps2_register_cache.h).
+        constexpr GprMacro kGprMacros[] = {
+            {"GPR_U32", "RC_U32", false},
+            {"GPR_S32", "RC_S32", false},
+            {"GPR_U64", "RC_U64", false},
+            {"GPR_S64", "RC_S64", false},
+            {"GPR_VEC", "RC_VEC", false},
+            {"getRegU32", "RC_U32", false},
+            {"SET_GPR_U32", "RC_SET_U32", true},
+            {"SET_GPR_S32", "RC_SET_S32", true},
+            {"SET_GPR_ZE32", "RC_SET_ZE32", true},
+            {"SET_GPR_U64", "RC_SET_U64", true},
+            {"SET_GPR_S64", "RC_SET_S64", true},
+            {"SET_GPR_VEC", "RC_SET_VEC", true},
+        };
+
+        // Calls given the context that never touch its general registers: the accessors left on
+        // register 0 (a constant, a dropped write), the FPU's control word and accumulator,
+        // memory (the I/O behind it queues interrupts and DMA handlers instead of running them,
+        // and a bad address only sets COP0 and the pc), the write trace (a no-op), the LL bit.
+        constexpr std::string_view kContextSafeCalls[] = {
+            "GPR_U32",
+            "GPR_S32",
+            "GPR_U64",
+            "GPR_S64",
+            "GPR_VEC",
+            "getRegU32",
+            "SET_GPR_U32",
+            "SET_GPR_S32",
+            "SET_GPR_ZE32",
+            "SET_GPR_U64",
+            "SET_GPR_S64",
+            "SET_GPR_VEC",
+            "FPU_SET_ACC",
+            "FPU_DIV_S",
+            "FPU_SQRT_S",
+            "FPU_RSQRT_S",
+            "ps2TraceGuestWrite",
+            "runtime->Load8",
+            "runtime->Load16",
+            "runtime->Load32",
+            "runtime->Load64",
+            "runtime->Load128",
+            "runtime->Store8",
+            "runtime->Store16",
+            "runtime->Store32",
+            "runtime->Store64",
+            "runtime->Store128",
+            "runtime->SignalException",
+            "runtime->clearLLBit",
+        };
+
+        struct Registers
+        {
+            std::bitset<32> used;     // general registers named
+            std::bitset<32> written;
+            std::bitset<32> fpUsed;   // FPU registers
+            std::bitset<32> fpWritten;
+        };
+
+        // Whether the text after an lvalue at `at` assigns to it (=, op=, ++, --).
+        bool assignsAfter(std::string_view line, size_t at)
+        {
+            while (at < line.size() && line[at] == ' ')
+                ++at;
+            const std::string_view rest = line.substr(at);
+            if (rest.starts_with("++") || rest.starts_with("--") || rest.starts_with("<<=") || rest.starts_with(">>="))
+                return true;
+            if (rest.starts_with("=") && !rest.starts_with("=="))
+                return true;
+            return rest.size() >= 2 && rest[1] == '=' && std::string_view("+-*/%&|^").find(rest[0]) != std::string_view::npos;
+        }
+
+        // GPR_*(ctx, n) and SET_GPR_*(ctx, n, value) become RC_*(n) and RC_SET_*(n, value).
+        // Register 0 keeps the macros (their constant 0, and a write dropped unevaluated).
+        // ctx->f[n] becomes rf_<n> (written when assigned or its address taken).
+        bool rewriteLine(std::string_view line, const std::vector<char> &code, std::string &out,
+                         Registers &regs, std::bitset<32> &fpWrites, std::string &whyNot)
+        {
+            fpWrites.reset();
+            out.clear();
+            size_t i = 0;
+            while (i < line.size())
+            {
+                if (!code[i] || !isIdentChar(line[i]))
+                {
+                    out.push_back(line[i++]);
+                    continue;
+                }
+                size_t end = i;
+                while (end < line.size() && isIdentChar(line[end]))
+                    ++end;
+                const std::string_view word = line.substr(i, end - i);
+                const GprMacro *macro = nullptr;
+                for (const GprMacro &candidate : kGprMacros)
+                {
+                    if (candidate.name == word)
+                    {
+                        macro = &candidate;
+                        break;
+                    }
+                }
+                if (!macro && word == "ctx" && line.substr(end, 4) == "->f[")
+                {
+                    size_t p = end + 4;
+                    const size_t digits = p;
+                    while (p < line.size() && p - digits < 2 && std::isdigit(static_cast<unsigned char>(line[p])))
+                        ++p;
+                    if (p > digits && p < line.size() && line[p] == ']')
+                    {
+                        const int reg = std::stoi(std::string(line.substr(digits, p - digits)));
+                        ++p;
+                        if (reg < 32)
+                        {
+                            size_t before = out.size();
+                            while (before > 0 && out[before - 1] == ' ')
+                                --before;
+                            const bool addressTaken = before > 0 && out[before - 1] == '&' &&
+                                                      (before < 2 || out[before - 2] != '&');
+                            regs.fpUsed.set(static_cast<size_t>(reg));
+                            if (addressTaken || assignsAfter(line, p))
+                            {
+                                regs.fpWritten.set(static_cast<size_t>(reg));
+                                fpWrites.set(static_cast<size_t>(reg));
+                            }
+                            out.append("rf_").append(std::to_string(reg));
+                            i = p;
+                            continue;
+                        }
+                    }
+                }
+                if (!macro)
+                {
+                    out.append(word);
+                    i = end;
+                    continue;
+                }
+
+                size_t p = end;
+                auto expect = [&](std::string_view token)
+                {
+                    while (p < line.size() && line[p] == ' ')
+                        ++p;
+                    if (line.substr(p, token.size()) != token)
+                        return false;
+                    p += token.size();
+                    return true;
+                };
+                int reg = -1;
+                if (expect("(") && expect("ctx") && expect(","))
+                {
+                    while (p < line.size() && line[p] == ' ')
+                        ++p;
+                    const size_t digits = p;
+                    while (p < line.size() && p - digits < 2 && std::isdigit(static_cast<unsigned char>(line[p])))
+                        ++p;
+                    if (p > digits)
+                        reg = std::stoi(std::string(line.substr(digits, p - digits)));
+                }
+                if (reg < 0 || reg > 31 || !expect(macro->write ? "," : ")"))
+                {
+                    whyNot = "unexpected " + std::string(word) + ": " + std::string(trim(line));
+                    return false;
+                }
+                if (reg == 0)
+                {
+                    out.append(line.substr(i, p - i));
+                }
+                else
+                {
+                    out.append(macro->cached);
+                    out.push_back('(');
+                    out.append(std::to_string(reg));
+                    out.append(macro->write ? "," : ")"); // (the value keeps its space)
+                    regs.used.set(static_cast<size_t>(reg));
+                    if (macro->write)
+                        regs.written.set(static_cast<size_t>(reg));
+                }
+                i = p;
+            }
+            return true;
+        }
+
+        // std::memcpy(&A, &B, sizeof(C)) moving bits into or out of an FPU register (mtc1, mfc1,
+        // cvt.w.s, cvt.s.w) becomes a std::bit_cast, so that no register's address is taken.
+        std::string bitCastFpMoves(std::string_view line)
+        {
+            static constexpr std::string_view kOpen = "std::memcpy(&";
+            auto isFp = [](std::string_view v) { return v.starts_with("ctx->f[") && v.ends_with("]"); };
+            auto isName = [](std::string_view v)
+            { return !v.empty() && std::all_of(v.begin(), v.end(), [](char c) { return isIdentChar(c); }); };
+            std::string out;
+            size_t at = 0;
+            for (;;)
+            {
+                const size_t p = line.find(kOpen, at);
+                if (p == std::string_view::npos)
+                    break;
+                const size_t a = p + kOpen.size();
+                const size_t aEnd = line.find(", &", a);
+                const size_t bEnd = aEnd == std::string_view::npos ? aEnd : line.find(", sizeof(", aEnd + 3);
+                const size_t cEnd = bEnd == std::string_view::npos ? bEnd : line.find("));", bEnd + 9);
+                if (cEnd == std::string_view::npos)
+                    break;
+                const std::string_view to = line.substr(a, aEnd - a);
+                const std::string_view from = line.substr(aEnd + 3, bEnd - aEnd - 3);
+                const std::string_view size = line.substr(bEnd + 9, cEnd - bEnd - 9);
+                std::string cast;
+                if (isFp(to) && isName(from) && size == from)
+                    cast = std::string(to) + " = std::bit_cast<float>(" + std::string(from) + ");";
+                else if (isFp(from) && isName(to) && size == to)
+                    cast = std::string(to) + " = std::bit_cast<decltype(" + std::string(to) + ")>(" + std::string(from) + ");";
+                out.append(line.substr(at, (cast.empty() ? cEnd + 3 : p) - at));
+                out.append(cast);
+                at = cEnd + 3;
+            }
+            out.append(line.substr(at));
+            return out;
+        }
+
+        // The function or macro a context argument at `argument` is passed to.
+        std::string_view calleeOf(std::string_view line, const std::vector<char> &code, size_t argument)
+        {
+            int depth = 0;
+            for (size_t i = argument; i-- > 0;)
+            {
+                if (!code[i])
+                    continue;
+                if (line[i] == ')')
+                {
+                    ++depth;
+                }
+                else if (line[i] == '(')
+                {
+                    if (depth > 0)
+                    {
+                        --depth;
+                        continue;
+                    }
+                    size_t end = i;
+                    while (end > 0 && line[end - 1] == ' ')
+                        --end;
+                    size_t start = end;
+                    while (start > 0)
+                    {
+                        const char c = line[start - 1];
+                        if (isIdentChar(c) || c == ':' || c == '.')
+                            --start;
+                        else if (c == '>' && start >= 2 && line[start - 2] == '-')
+                            start -= 2;
+                        else
+                            break;
+                    }
+                    return line.substr(start, end - start);
+                }
+            }
+            return {};
+        }
+
+        struct LineFacts
+        {
+            bool cached = false;   // RC_* (the locals)
+            bool hasReturn = false;
+            bool hasGoto = false;
+            bool dispatch = false; // runtime->dispatchGuestBranch given the context
+            bool call = false;     // another call given the context
+            std::string_view callee;
+            int braces = 0;        // '{' less '}'
+            std::string whyNot;
+        };
+
+        LineFacts analyzeLine(std::string_view line, const std::vector<char> &code)
+        {
+            LineFacts facts;
+            size_t i = 0;
+            while (i < line.size())
+            {
+                const char c = line[i];
+                if (!code[i] || !isIdentChar(c))
+                {
+                    if (code[i] && c == '{')
+                        ++facts.braces;
+                    else if (code[i] && c == '}')
+                        --facts.braces;
+                    ++i;
+                    continue;
+                }
+                size_t end = i;
+                while (end < line.size() && isIdentChar(line[end]))
+                    ++end;
+                const std::string_view word = line.substr(i, end - i);
+                if (word.starts_with("RC_") || word.starts_with("rf_"))
+                {
+                    facts.cached = true;
+                }
+                else if (word == "return")
+                {
+                    facts.hasReturn = true;
+                }
+                else if (word == "goto")
+                {
+                    facts.hasGoto = true;
+                }
+                else if (word == "ctx")
+                {
+                    if (line.substr(end, 2) == "->")
+                    {
+                        size_t fieldEnd = end + 2;
+                        while (fieldEnd < line.size() && isIdentChar(line[fieldEnd]))
+                            ++fieldEnd;
+                        const std::string_view field = line.substr(end + 2, fieldEnd - end - 2);
+                        if (field == "r")
+                            facts.whyNot = "the context's registers used directly";
+                        else if (field == "f")
+                            facts.whyNot = "an FPU register with a computed number";
+                    }
+                    else
+                    {
+                        const std::string_view callee = calleeOf(line, code, i);
+                        if (callee == "runtime->dispatchGuestBranch")
+                        {
+                            facts.dispatch = true;
+                        }
+                        else if (std::find(std::begin(kContextSafeCalls), std::end(kContextSafeCalls), callee) !=
+                                 std::end(kContextSafeCalls))
+                        {
+                        }
+                        else if (callee.empty() || callee == "if" || callee == "while" || callee == "for" ||
+                                 callee == "switch" || callee == "return" || callee == "sizeof")
+                        {
+                            facts.whyNot = "the context used as a value";
+                        }
+                        else
+                        {
+                            facts.call = true;
+                            facts.callee = callee;
+                        }
+                    }
+                }
+                i = end;
+            }
+            return facts;
+        }
+    }
+
+    bool translationObservesPc(std::string_view text)
+    {
+        static constexpr std::string_view kQuietCalls[] = {
+            "GPR_U32", "GPR_S32", "GPR_U64", "GPR_S64", "GPR_VEC", "getRegU32",
+            "SET_GPR_U32", "SET_GPR_S32", "SET_GPR_ZE32", "SET_GPR_U64", "SET_GPR_S64", "SET_GPR_VEC",
+            "FPU_SET_ACC", "FPU_DIV_S", "FPU_SQRT_S", "FPU_RSQRT_S", "ps2TraceGuestWrite",
+        };
+        std::vector<char> code;
+        size_t at = 0;
+        while (at < text.size())
+        {
+            const size_t nl = text.find('\n', at);
+            const std::string_view line = text.substr(at, (nl == std::string_view::npos ? text.size() : nl) - at);
+            at = nl == std::string_view::npos ? text.size() : nl + 1;
+            markCode(line, code);
+            size_t i = 0;
+            while (i < line.size())
+            {
+                if (!code[i] || !isIdentChar(line[i]))
+                {
+                    ++i;
+                    continue;
+                }
+                size_t end = i;
+                while (end < line.size() && isIdentChar(line[end]))
+                    ++end;
+                const std::string_view word = line.substr(i, end - i);
+                if (word == "runtime" || word == "ps2_syscalls" || word == "ps2_stubs" || word == "throw" ||
+                    word == "return" || word == "goto")
+                    return true;
+                if (word == "ctx")
+                {
+                    if (line.substr(end, 2) == "->")
+                    {
+                        size_t fieldEnd = end + 2;
+                        while (fieldEnd < line.size() && isIdentChar(line[fieldEnd]))
+                            ++fieldEnd;
+                        const std::string_view field = line.substr(end + 2, fieldEnd - end - 2);
+                        if (field == "pc" || field == "in_delay_slot" || field == "branch_pc")
+                            return true;
+                    }
+                    else if (std::find(std::begin(kQuietCalls), std::end(kQuietCalls), calleeOf(line, code, i)) ==
+                             std::end(kQuietCalls))
+                    {
+                        return true;
+                    }
+                }
+                i = end;
+            }
+        }
+        return false;
+    }
+
+    bool applyRegisterCache(std::string &functionText, std::string &whyNot)
+    {
+        whyNot.clear();
+        static constexpr std::string_view kSignatureEnd =
+            "(uint8_t* rdram, R5900Context* ctx, PS2Runtime *runtime) {\n";
+        const size_t signature = functionText.find(kSignatureEnd);
+        const size_t close = functionText.rfind("\n}");
+        if (signature == std::string::npos || close == std::string::npos || close < signature)
+        {
+            whyNot = "no function body";
+            return false;
+        }
+        const size_t bodyStart = signature + kSignatureEnd.size();
+
+        std::vector<std::string_view> lines;
+        {
+            const std::string_view body = std::string_view(functionText).substr(bodyStart, close + 1 - bodyStart);
+            size_t at = 0;
+            while (at < body.size())
+            {
+                const size_t nl = body.find('\n', at);
+                const size_t end = nl == std::string_view::npos ? body.size() : nl;
+                lines.push_back(body.substr(at, end - at));
+                at = end + 1;
+            }
+        }
+
+        // The registers named, and the text with the locals.
+        Registers regs;
+        std::vector<std::string> rewritten(lines.size());
+        std::vector<std::bitset<32>> fpWrites(lines.size());
+        std::vector<char> code;
+        for (size_t n = 0; n < lines.size(); ++n)
+        {
+            const std::string line = bitCastFpMoves(lines[n]);
+            markCode(line, code);
+            if (!rewriteLine(line, code, rewritten[n], regs, fpWrites[n], whyNot))
+                return false;
+        }
+        if (regs.used.none() && regs.fpUsed.none())
+            return false;
+
+        std::string declare;
+        std::string reload;
+        auto add = [](std::string &list, const char *macro, int reg)
+        {
+            if (!list.empty())
+                list.push_back(' ');
+            list.append(macro).append("(").append(std::to_string(reg)).append(");");
+        };
+        for (int reg = 1; reg < 32; ++reg)
+        {
+            if (regs.used.test(static_cast<size_t>(reg)))
+            {
+                add(declare, "RC_DECL", reg);
+                add(reload, "RC_LD", reg);
+            }
+        }
+        for (int reg = 0; reg < 32; ++reg)
+        {
+            if (regs.fpUsed.test(static_cast<size_t>(reg)))
+            {
+                add(declare, "RC_FDECL", reg);
+                add(reload, "RC_FLD", reg);
+            }
+        }
+
+        std::string out;
+        out.reserve(functionText.size() + functionText.size() / 4);
+        const size_t header = functionText.rfind("// Function: ", signature);
+        const size_t includeAt = header == std::string::npos ? 0 : header;
+        out.append(functionText, 0, includeAt);
+        out.append("#include \"ps2_register_cache.h\"\n");
+        out.append(functionText, includeAt, bodyStart - includeAt);
+        out.append("    ").append(declare).append("\n");
+
+        // Whether the locals hold the registers: false after a call or jump handed the context
+        // over, until the code after it or a label (only unreachable code reads them there).
+        bool valid = true;
+        enum class Expect
+        {
+            None,
+            Return, // after `if (!runtime->dispatchGuestBranch(...)) {`
+            Close,
+        } expect = Expect::None;
+        std::vector<bool> strictRegions; // the #if nesting: true for PS2X_STRICT_RETURN_DIAGNOSTICS
+
+        auto fail = [&](std::string_view why, std::string_view line)
+        {
+            whyNot = std::string(why) + ": " + std::string(trim(line));
+            return false;
+        };
+        auto putLine = [&](std::string_view indent, const std::string &text)
+        {
+            out.append(indent).append(text).push_back('\n');
+        };
+        // A line, then the FPU registers it wrote to the context.
+        auto putCode = [&](size_t n, std::string_view indent)
+        {
+            out.append(rewritten[n]).push_back('\n');
+            if (fpWrites[n].none())
+                return;
+            std::string stores;
+            for (int reg = 0; reg < 32; ++reg)
+            {
+                if (fpWrites[n].test(static_cast<size_t>(reg)))
+                    add(stores, "RC_FST", reg);
+            }
+            putLine(indent, stores);
+        };
+
+        for (size_t n = 0; n < rewritten.size(); ++n)
+        {
+            const std::string &line = rewritten[n];
+            const std::string_view t = trim(line);
+            const std::string_view indent = indentOf(line);
+
+            if (t.empty() || t.starts_with("//"))
+            {
+                out.append(line).push_back('\n');
+                continue;
+            }
+            if (t.front() == '#')
+            {
+                if (t.starts_with("#if"))
+                {
+                    const bool strict = t.find("PS2X_STRICT_RETURN_DIAGNOSTICS") != std::string_view::npos;
+                    if (strict)
+                    {
+                        // Both ways return: the dispatch, or ctx->pc and return.
+                        if (expect != Expect::None)
+                            return fail("a return inside a call's unwind", t);
+                        valid = false;
+                    }
+                    strictRegions.push_back(strict);
+                }
+                else if (t.starts_with("#endif"))
+                {
+                    if (strictRegions.empty())
+                        return fail("an #endif without #if", t);
+                    strictRegions.pop_back();
+                }
+                out.append(line).push_back('\n');
+                continue;
+            }
+            if (t.starts_with("label_") && t.back() == ':')
+            {
+                if (expect != Expect::None)
+                    return fail("a label inside a call's unwind", t);
+                valid = true;
+                out.append(line).push_back('\n');
+                continue;
+            }
+
+            markCode(line, code);
+            const LineFacts facts = analyzeLine(line, code);
+            if (!facts.whyNot.empty())
+                return fail(facts.whyNot, t);
+            if (fpWrites[n].any() && t.back() != ';' && t.back() != '}')
+                return fail("an FPU register written in an unknown statement", t);
+
+            if (expect == Expect::Return)
+            {
+                if (t != "return;")
+                    return fail("not a return after a call", t);
+                out.append(line).push_back('\n');
+                expect = Expect::Close;
+                continue;
+            }
+            if (expect == Expect::Close)
+            {
+                if (t != "}")
+                    return fail("not the end of a call", t);
+                out.append(line).push_back('\n');
+                putLine(indent, reload);
+                valid = true;
+                expect = Expect::None;
+                continue;
+            }
+
+            if (facts.dispatch)
+            {
+                if (facts.call)
+                    return fail("a call beside a branch", t);
+                if (t.starts_with("if (!runtime->dispatchGuestBranch(") && t.ends_with(")) {"))
+                {
+                    if (!valid)
+                        return fail("a call after a transfer", t);
+                    out.append(line).push_back('\n');
+                    valid = false;
+                    expect = Expect::Return;
+                    continue;
+                }
+                if (t.starts_with("(void)runtime->dispatchGuestBranch(") && t.ends_with(");") &&
+                    !strictRegions.empty() && strictRegions.back() && !valid)
+                {
+                    out.append(line).push_back('\n');
+                    continue;
+                }
+                return fail("an unknown branch", t);
+            }
+
+            if (facts.call)
+            {
+                if (!valid)
+                    return fail("a call after a transfer", t);
+                if (facts.cached)
+                    return fail("a call beside a register", t);
+                if (t == std::string(facts.callee) + "(rdram, ctx, runtime); return;")
+                {
+                    // A jump to another function: it has the context from here on.
+                    out.append(line).push_back('\n');
+                    valid = false;
+                    continue;
+                }
+                if (facts.hasReturn || facts.hasGoto || facts.braces != 0 || (t.back() != ';' && t.back() != '}'))
+                    return fail("an unknown call", t);
+                out.append(line).push_back('\n');
+                putLine(indent, reload);
+                continue;
+            }
+
+            if (!valid && (facts.cached || facts.hasGoto))
+                return fail("registers used after a transfer", t);
+            putCode(n, indent);
+        }
+        if (expect != Expect::None || !strictRegions.empty())
+            return fail("the function ends inside a call or #if", "");
+        out.append(functionText, close + 1, std::string::npos);
+        functionText = std::move(out);
+        return true;
+    }
+}
