         [[nodiscard]] bool isMemoryRange(uint32_t address, size_t size) const;
+        // The disc's sectors for the host (sectors * 2048 bytes), as the IOP's CD reads see them.
+        [[nodiscard]] bool readDiscSectors(uint32_t lsn, uint32_t sectors, void *destination);
 
         [[nodiscard]] DebugSnapshot debugSnapshot() const;
 
