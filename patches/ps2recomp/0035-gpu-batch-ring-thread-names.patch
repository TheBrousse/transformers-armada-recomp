+
+    // ---- the batches' data into one ring (PS2X_GPU_RING, on by default) ----
+    // A batch's vertices, draws, CLUTs and mesh/moment inputs were each glBufferData'd fresh: three
+    // to six new buffer stores a batch, 10-20 thousand a second at 60 frames in a level, each a new
+    // allocation for the driver to make (and, on AMD's, often fresh video memory). The ring is one
+    // persistently mapped buffer made once: each upload a copy into its next free stretch, eight
+    // segments fenced in turn. (Looked at for the "whole PC stutters" report, 2026-10-24: it was not
+    // that report's cause; it stays as the cheaper way to stream the batches.)
+    struct StreamRing
+    {
+        static constexpr size_t kSegments = 8u;
+        GLuint buffer = 0u;
+        uint8_t *data = nullptr;
+        size_t size = 0u, segment = 0u, head = 0u, current = 0u;
+        std::array<GLsync, kSegments> fences{};
+        uint64_t waits = 0u;
+
+        bool open(size_t bytes)
+        {
+            const GLbitfield flags = GL_MAP_WRITE_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+            glGenBuffers(1, &buffer);
+            glBindBuffer(GL_COPY_WRITE_BUFFER, buffer);
+            glBufferStorage(GL_COPY_WRITE_BUFFER, static_cast<GLsizeiptr>(bytes), nullptr, flags);
+            data = static_cast<uint8_t *>(glMapBufferRange(GL_COPY_WRITE_BUFFER, 0, static_cast<GLsizeiptr>(bytes), flags));
+            glBindBuffer(GL_COPY_WRITE_BUFFER, 0u);
+            if (!data)
+            {
+                glDeleteBuffers(1, &buffer);
+                buffer = 0u;
+                return false;
+            }
+            size = bytes;
+            segment = bytes / kSegments;
+            return true;
+        }
+
+        // A stretch of `bytes` aligned to `align` (never across a segment): its offset, or SIZE_MAX
+        // when it is bigger than a segment. Entering a segment fences the one left and waits for the
+        // GPU to be done with the commands that last used the one entered.
+        size_t take(size_t bytes, size_t align)
+        {
+            bytes = std::max(bytes, align);
+            if (bytes > segment)
+                return SIZE_MAX;
+            size_t off = (head + align - 1u) / align * align;
+            if (off >= size || off / segment != (off + bytes - 1u) / segment)
+                off = ((off / segment) + 1u) % kSegments * segment;
+            const size_t seg = off / segment;
+            if (seg != current)
+            {
+                if (fences[current])
+                    glDeleteSync(fences[current]);
+                fences[current] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+                if (GLsync f = fences[seg])
+                {
+                    if (glClientWaitSync(f, 0, 0u) == GL_TIMEOUT_EXPIRED)
+                    {
+                        ++waits;
+                        while (glClientWaitSync(f, GL_SYNC_FLUSH_COMMANDS_BIT, 1'000'000'000u) == GL_TIMEOUT_EXPIRED)
+                        {
+                        }
+                    }
+                    glDeleteSync(f);
+                    fences[seg] = nullptr;
+                }
+                current = seg;
+            }
+            head = off + bytes;
+            return off;
+        }
+    };
+    StreamRing ring;
+    bool ringEnabled = false;
+    size_t ringAlign = 256u;
+    // The batch's vertices where they are now (the ring's stretch or vbo), for the attributes and
+    // the compute passes that write moment/mesh vertices into them (binding 7).
+    GLuint vertexBuffer = 0u;
+    size_t vertexOffset = 0u, vertexBytes = 0u;
+    GLuint pointedBuffer = 0u;
+    size_t pointedOffset = SIZE_MAX;
+
+    void pointVertices(GLuint buffer, size_t offset)
+    {
+        glBindVertexArray(vao);
+        glBindBuffer(GL_ARRAY_BUFFER, buffer);
+        if (buffer == pointedBuffer && offset == pointedOffset)
+            return;
+        const auto at = [offset](size_t field) { return reinterpret_cast<void *>(offset + field); };
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, sizeof(GpuVertex), at(offsetof(GpuVertex, x)));
+        glVertexAttribIPointer(1, 1, GL_UNSIGNED_INT, sizeof(GpuVertex), at(offsetof(GpuVertex, z)));
+        glVertexAttribIPointer(2, 4, GL_UNSIGNED_BYTE, sizeof(GpuVertex), at(offsetof(GpuVertex, r)));
+        glVertexAttribPointer(3, 3, GL_FLOAT, GL_FALSE, sizeof(GpuVertex), at(offsetof(GpuVertex, s)));
+        glVertexAttribIPointer(4, 1, GL_UNSIGNED_INT, sizeof(GpuVertex), at(offsetof(GpuVertex, packed)));
+        pointedBuffer = buffer;
+        pointedOffset = offset;
+    }
+
+    // `count` vertices, room for `total` (the rest written on the GPU), the vertex source.
+    void uploadVertices(const GpuVertex *v, size_t count, size_t total)
+    {
+        const size_t bytes = total * sizeof(GpuVertex);
+        if (ringEnabled)
+        {
+            const size_t off = ring.take(bytes, ringAlign);
+            if (off != SIZE_MAX)
+            {
+                if (count)
+                    std::memcpy(ring.data + off, v, count * sizeof(GpuVertex));
+                vertexBuffer = ring.buffer;
+                vertexOffset = off;
+                vertexBytes = std::max(bytes, ringAlign);
+                pointVertices(ring.buffer, off);
+                return;
+            }
+        }
+        glBindBuffer(GL_ARRAY_BUFFER, vbo);
+        if (total != count)
+        {
+            glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(bytes), nullptr, GL_STREAM_DRAW);
+            glBufferSubData(GL_ARRAY_BUFFER, 0, static_cast<GLsizeiptr>(count * sizeof(GpuVertex)), v);
+        }
+        else
+            glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(bytes), v, GL_STREAM_DRAW);
+        vertexBuffer = vbo;
+        vertexOffset = 0u;
+        vertexBytes = bytes;
+        pointVertices(vbo, 0u);
+    }
+
+    void bindVertexStorage()
+    {
+        if (vertexBuffer == vbo || vertexBytes == 0u)
+            glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 7, vertexBuffer ? vertexBuffer : vbo);
+        else
+            glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 7, vertexBuffer, static_cast<GLintptr>(vertexOffset),
+                              static_cast<GLsizeiptr>(vertexBytes));
+    }
+
+    // A shader storage block's data: the ring's next stretch bound to `binding`, else `fallback`.
+    void uploadStorage(GLuint fallback, GLuint binding, const void *data, size_t bytes)
+    {
+        if (ringEnabled && bytes)
+        {
+            const size_t off = ring.take(bytes, ringAlign);
+            if (off != SIZE_MAX)
+            {
+                std::memcpy(ring.data + off, data, bytes);
+                glBindBufferRange(GL_SHADER_STORAGE_BUFFER, binding, ring.buffer, static_cast<GLintptr>(off), static_cast<GLsizeiptr>(bytes));
+                return;
+            }
+        }
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, fallback);
+        glBufferData(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(bytes), data, GL_STREAM_DRAW);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, binding, fallback);
+    }
