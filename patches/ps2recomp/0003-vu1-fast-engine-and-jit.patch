+    // Sets round-toward-zero, flush-to-zero and denormals-are-zero for the VU's arithmetic.
+    struct VuFloatMode
+    {
+        unsigned int saved;
+        VuFloatMode() : saved(_mm_getcsr()) { _mm_setcsr((saved & ~0xE040u) | 0xE040u); }
+        ~VuFloatMode() { _mm_setcsr(saved); }
+    };
+
+    // PS2X_VU1_PROFILE=1 (debugging aid): the instruction pairs compiled blocks ran, by code
+    // image (its hash, as hashCode makes it) and the block's first pair, printed every 2 s
+    // with the most run first.
+    struct BlockKey
+    {
+        uint64_t image;
+        uint32_t pc;
+        bool operator==(const BlockKey &other) const { return image == other.image && pc == other.pc; }
+    };
+    struct BlockKeyHash
+    {
+        size_t operator()(const BlockKey &key) const { return static_cast<size_t>(key.image ^ (key.pc * 0x9E3779B97F4A7C15ull)); }
+    };
+
+    void profileBlock(const Engine &e, uint32_t pc, uint32_t pairs)
+    {
+        static std::unordered_map<BlockKey, uint64_t, BlockKeyHash> counts;
+        static auto since = std::chrono::steady_clock::now();
+        static uint32_t calls = 0u;
+        counts[{e.image->hash, pc}] += pairs;
+        if ((++calls & 1023u) != 0u)
+            return;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - since < std::chrono::seconds(2))
+            return;
+        std::vector<std::pair<BlockKey, uint64_t>> sorted(counts.begin(), counts.end());
+        std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+        uint64_t total = 0u;
+        for (const auto &entry : sorted)
+            total += entry.second;
+        const double seconds = std::chrono::duration<double>(now - since).count();
+        std::fprintf(stderr, "[vu1:profile] %.1fM pairs a second in %zu blocks; the most run:\n", total / seconds / 1.0e6,
+                     sorted.size());
+        for (size_t i = 0; i < sorted.size() && i < 40u; ++i)
+            std::fprintf(stderr, "[vu1:profile]   image %016llx pc %04x: %5.2f%% %.2fM pairs/s\n",
+                         static_cast<unsigned long long>(sorted[i].first.image), sorted[i].first.pc,
+                         100.0 * static_cast<double>(sorted[i].second) / static_cast<double>(std::max<uint64_t>(total, 1u)),
+                         sorted[i].second / seconds / 1.0e6);
+        counts.clear();
+        since = now;
+    }
