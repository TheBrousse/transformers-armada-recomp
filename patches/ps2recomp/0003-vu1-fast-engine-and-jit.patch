+    void lowerMove(Engine &e, const Pair &p) { writeVf(e, p.lft, loadVf(e, p.lfs), p.ldest); }
+
+    void lowerMr32(Engine &e, const Pair &p)
+    {
+        const __m128 v = loadVf(e, p.lfs);
