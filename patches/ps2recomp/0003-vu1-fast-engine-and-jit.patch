+    Engine &engineFor(const void *owner)
+    {
+        // (the same owner run after run: VU1)
+        static thread_local const void *lastOwner = nullptr;
+        static thread_local Engine *lastEngine = nullptr;
+        if (owner == lastOwner && lastEngine)
+            return *lastEngine;
+        std::unique_ptr<Engine> &slot = engines()[owner];
+        if (!slot)
+        {
+            slot = std::make_unique<Engine>();
+#if PS2X_VU1_JIT
+            jitInitEngine(*slot);
+#endif
+        }
+        lastOwner = owner;
+        lastEngine = slot.get();
+        return *slot;
+    }
