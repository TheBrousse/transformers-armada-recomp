+    void clearPipelines(Engine &e, uint32_t clip)
+    {
+        for (__m128i &lanes : e.vfReady)
+            lanes = _mm_setzero_si128();
+        std::memset(e.viReady, 0, sizeof(e.viReady));
+        e.cycleBase = 0;
+        e.lastWriteReady = 0;
+        e.qPending = false;
+        for (EfuEntry &entry : e.efu)
+            entry = {};
+        e.efuResourceReady = 0;
+        e.flagHead = e.flagCount = 0;
+        e.workingClip = clip;
+        e.kickActive = false;
+        e.kickWatch = 0u;
+        clearKickLog(e);
+        e.backupValid = false;
+        e.nextEvent = kNever;
+        e.reservedReported = false;
+    }
