+    template <bool Max>
+    void maxMini(float *dst, const float *vs, const float *vt, int broadcast, uint8_t dest)
+    {
+        for (int c = 0; c < 4; c++)
+        {
+            if ((dest & (8u >> c)) == 0u)
+                continue;
+            int32_t a = 0, b = 0;
+            std::memcpy(&a, &vs[c], 4);
+            std::memcpy(&b, &vt[broadcast < 0 ? c : broadcast], 4);
+            const int32_t r = Max ? vuMaxBits(a, b) : vuMinBits(a, b);
+            std::memcpy(&dst[c], &r, 4);
+        }
+    }
