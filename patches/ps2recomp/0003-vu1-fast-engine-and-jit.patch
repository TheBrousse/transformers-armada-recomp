+    void lowerDiv(Engine &e, const Pair &p)
+    {
+        const float num = normScalar(e.st->vf[p.lfs][p.fsf]);
+        const float den = normScalar(e.st->vf[p.lft][p.ftf]);
+        uint32_t statusDi = 0u;
+        float result = 0.0f;
+        if (den == 0.0f)
+        {
+            statusDi = num == 0.0f ? 0x10u : 0x20u;
+            result = std::signbit(num) != std::signbit(den) ? -kFloatMax : kFloatMax;
+        }
+        else
+        {
+            result = num / den;
+        }
+        queueQ(e, result, 7u, statusDi);
+    }
+
+    void lowerSqrt(Engine &e, const Pair &p)
+    {
+        const float value = normScalar(e.st->vf[p.lft][p.ftf]);
+        queueQ(e, std::sqrt(std::fabs(value)), 7u, value < 0.0f ? 0x10u : 0u);
+    }
+
+    void lowerRsqrt(Engine &e, const Pair &p)
+    {
+        const float num = normScalar(e.st->vf[p.lfs][p.fsf]);
+        const float radicand = normScalar(e.st->vf[p.lft][p.ftf]);
+        const float den = std::sqrt(std::fabs(radicand));
+        uint32_t statusDi = radicand < 0.0f ? 0x10u : 0u;
+        float result = 0.0f;
+        if (den != 0.0f)
+        {
+            result = num / den;
+        }
+        else
+        {
+            statusDi = num == 0.0f ? 0x10u : 0x20u;
+            result = std::signbit(num) ? -kFloatMax : kFloatMax;
+        }
+        queueQ(e, result, 13u, statusDi);
+    }
