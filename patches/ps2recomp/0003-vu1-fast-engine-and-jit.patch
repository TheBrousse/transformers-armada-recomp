+    }
+
+    void lowerJalr(Engine &e, const Pair &p)
+    {
+        const uint32_t target = (static_cast<uint32_t>(static_cast<uint16_t>(branchVi(e, p.lis))) * 8u) & 0x3FFFu;
+        writeVi(e, p.lit, static_cast<int32_t>((e.st->pc + 16u) / 8u));
