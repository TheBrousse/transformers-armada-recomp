+            return v;
+        const __m128i fixed = _mm_or_si128(_mm_and_si128(bits, kSignMask), kMaxMagnitude);
+        return _mm_castsi128_ps(_mm_blendv_epi8(bits, fixed, special));
+    }
+
+    // As norm(), and denormals become signed zeros explicitly: MAX, MINI and ABS pass an
+    // operand through instead of computing with it.
+    inline __m128 normFull(__m128 v)
+    {
+        v = norm(v);
+        const __m128i bits = _mm_castps_si128(v);
+        const __m128i denormal = _mm_andnot_si128(
+            _mm_cmpeq_epi32(_mm_andnot_si128(kSignMask, bits), _mm_setzero_si128()),
+            _mm_cmpeq_epi32(_mm_and_si128(bits, kExpMask), _mm_setzero_si128()));
+        if (_mm_movemask_epi8(denormal) == 0)
+            return v;
+        return _mm_castsi128_ps(_mm_blendv_epi8(bits, _mm_and_si128(bits, kSignMask), denormal));
+    }
+
+    inline float normScalar(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        if (exponent == 0u)
+            bits &= 0x80000000u;
+        else if (exponent == 0xFFu)
+            bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    }
+
+    // Result normalization for Q and P (the reference's normalizeResult, flags unused).
+    inline float normResult(float value) { return normScalar(value); }
+
+    inline __m128 loadVf(const Engine &e, uint8_t reg) { return _mm_loadu_ps(e.st->vf[reg]); }
+
+    inline void writeVf(Engine &e, uint8_t reg, __m128 value, uint8_t dest)
+    {
+        if (reg == 0u || dest == 0u)
+            return;
+        if (dest == 0xFu)
+        {
+            _mm_storeu_ps(e.st->vf[reg], value);
+            return;
+        }
+        _mm_storeu_ps(e.st->vf[reg], _mm_blendv_ps(_mm_loadu_ps(e.st->vf[reg]), value, kDestMask[dest]));
+    }
+
+    inline void writeVi(Engine &e, uint8_t reg, int32_t value)
+    {
+        if (reg != 0u)
+            e.st->vi[reg] = static_cast<int16_t>(value);
+    }
+
+    inline int32_t branchVi(const Engine &e, uint8_t reg)
+    {
+        if (reg == 0u)
+            return 0;
+        if (e.backupValid && e.backupReg == reg)
+            return e.backupValue;
+        return e.st->vi[reg];
+    }
+
+    inline void setBranch(Engine &e, uint32_t target)
+    {
+        e.st->branchPending = true;
+        e.st->branchTarget = target;
+        e.st->branchDelay = 1;
+    }
+
+    inline uint32_t branchTarget(const Engine &e, const Pair &p)
+    {
+        return (e.st->pc + 8u + static_cast<uint32_t>(p.imm * 8)) & 0x3FFFu;
+    }
+
+    void reportReserved(Engine &e, bool upper, uint32_t instruction);
+
+    // ------------------------------------------------------------------------------
+    // Timed state: flags, Q, P
+    // ------------------------------------------------------------------------------
+
+    void updateNextEvent(Engine &e)
+    {
+        uint64_t next = kNever;
+        if (e.flagCount != 0u)
+            next = e.flags[e.flagHead].ready;
+        if (e.qPending)
+            next = std::min(next, e.qReady);
+        for (const EfuEntry &entry : e.efu)
+            if (entry.valid)
+                next = std::min(next, entry.ready);
+        e.nextEvent = next;
+    }
+
+    // Commits everything due at or before `now`, in the order the cycles they became due in
+    // (compiled code commits only before a pair that can see them, so several cycles' worth
+    // can be due at once), and within a cycle in the reference's order: flags, Q, P.
+    void commitEvents(Engine &e, uint64_t now)
+    {
+        VU1State &st = *e.st;
+        // Most often a DIV's Q is all there is.
+        if (e.flagCount == 0u && !e.efu[0].valid && !e.efu[1].valid && e.qPending && e.qReady <= now)
+        {
+            st.q = e.qValue;
+            const uint32_t di = e.qStatusDi & 0x30u;
+            st.status = (st.status & 0xFCFu) | di | (di << 6);
+            e.qPending = false;
+            e.nextEvent = kNever;
+            return;
+        }
+        for (;;)
+        {
+            uint64_t when = kNever;
+            int kind = -1; // 0: the flag FIFO's head, 1: Q, 2 + k: EFU entry k
+            if (e.flagCount != 0u && e.flags[e.flagHead].ready <= now)
+            {
+                when = e.flags[e.flagHead].ready;
+                kind = 0;
+            }
+            if (e.qPending && e.qReady <= now && e.qReady < when)
+            {
+                when = e.qReady;
+                kind = 1;
+            }
+            for (int k = 0; k < 2; ++k)
+            {
+                if (e.efu[k].valid && e.efu[k].ready <= now && e.efu[k].ready < when)
+                {
+                    when = e.efu[k].ready;
+                    kind = 2 + k;
+                }
+            }
+            if (kind < 0)
+                break;
+            if (kind == 0)
+            {
+                const FlagEntry &entry = e.flags[e.flagHead];
+                if (entry.writesMac)
+                    st.mac = entry.mac;
+                if (entry.writesStatus)
+                {
+                    const uint32_t current = entry.status & 0xFu;
+                    st.status = (st.status & 0xFF0u) | current | ((current | entry.extraSticky) << 6);
+                }
+                if (entry.writesSticky)
+                    st.status = (st.status & 0x03Fu) | (entry.status & 0xFC0u);
+                if (entry.writesClip)
+                    st.clip = entry.clip;
+                e.flagHead = (e.flagHead + 1u) & 15u;
+                --e.flagCount;
+            }
+            else if (kind == 1)
+            {
+                st.q = e.qValue;
+                const uint32_t di = e.qStatusDi & 0x30u;
+                st.status = (st.status & 0xFCFu) | di | (di << 6);
+                e.qPending = false;
+            }
+            else
+            {
+                EfuEntry &entry = e.efu[kind - 2];
+                st.p = entry.value;
+                entry.valid = false;
+            }
+        }
+        updateNextEvent(e);
+    }
+
+#if defined(_MSC_VER)
+#define VU1_NOINLINE __declspec(noinline)
+#define VU1_INLINE __forceinline
+#else
+#define VU1_NOINLINE __attribute__((noinline))
+#define VU1_INLINE inline __attribute__((always_inline))
+#endif
+
+    VU1_NOINLINE void reportFlagOverflow(Engine &e) { reportReserved(e, true, 0xFFFFFFFFu); }
+
+    // A new entry of the flag pipeline (called for every CLIP and every FMAC instruction
+    // whose flags can be read).
+    VU1_INLINE FlagEntry *pushFlag(Engine &e)
+    {
+        if (e.flagCount >= 16u)
+        {
+            reportFlagOverflow(e);
+            return nullptr;
+        }
+        FlagEntry &entry = e.flags[(e.flagHead + e.flagCount) & 15u];
+        ++e.flagCount;
+        entry = {};
+        entry.issue = e.cycle;
+        entry.ready = e.cycle + kFmacLatency;
+        if (e.flagCount == 1u)
+            e.nextEvent = std::min(e.nextEvent, entry.ready);
+        return &entry;
+    }
+
+    void queueQ(Engine &e, float value, uint32_t latency, uint32_t statusDi)
+    {
+        e.qPending = true;
+        e.qReady = e.cycle + latency;
+        e.qValue = normResult(value);
+        e.qStatusDi = statusDi & 0x30u;
+        e.nextEvent = std::min(e.nextEvent, e.qReady);
+        e.lastWriteReady = std::max(e.lastWriteReady, e.qReady);
+    }
+
+    void queueP(Engine &e, float value, uint32_t latency)
+    {
+        for (EfuEntry &entry : e.efu)
+        {
+            if (!entry.valid)
+            {
+                entry.valid = true;
+                entry.ready = e.cycle + latency;
+                entry.value = normResult(value);
+                e.efuResourceReady = e.cycle + (latency > 0u ? latency - 1u : 0u);
+                e.nextEvent = std::min(e.nextEvent, entry.ready);
+                e.lastWriteReady = std::max(e.lastWriteReady, entry.ready);
+                return;
+            }
+        }
+        reportReserved(e, false, 0xFFFFFFF9u);
+    }
+
+    // ------------------------------------------------------------------------------
+    // XGKICK
+    // ------------------------------------------------------------------------------
+
+    // PATH1 reads qword k of the packet at cycle issue + 1 + 2k, so a store issued at
+    // cycle s reaches it only if s <= issue + 2k. Rather than copying VU memory at every
+    // XGKICK, stores made while a transfer is pending log the qword they overwrite; the
+    // packet is read from current memory with the stores it could not see undone.
+    inline bool kickSawStore(const Engine &e, uint32_t offset, uint64_t storeCycle)
+    {
+        return storeCycle <= e.kickIssue + 2u * (offset / 16u);
+    }
+
+    inline bool kickLogHas(const Engine &e, uint32_t address)
+    {
+        return ((e.kickLogged[(address >> 10) & 15u] >> ((address >> 4) & 63u)) & 1u) != 0u;
+    }
+
+    inline void clearKickLog(Engine &e)
+    {
+        if (!e.kickLog.empty())
+        {
+            e.kickLog.clear();
+            e.kickLogged.fill(0u);
+        }
+        e.kickBytesLog = SIZE_MAX;
+    }
+
+    // The packets of the batch PS2X_VU1_CAPTURE is saving (run()), or null.
+    std::vector<uint8_t> *g_batchPackets = nullptr;
+
+    // The qword at byte `offset` of the packet as the transfer read it.
+    void kickQword(const Engine &e, uint32_t offset, uint8_t out[16])
+    {
+        const uint32_t address = (e.kickSource + offset) & e.dataMask;
+        std::memcpy(out, e.data + address, 16u);
+        if (!kickLogHas(e, address))
+            return;
+        // The earliest store the transfer did not see holds what it read: apply the log
+        // backwards so that one is written last.
+        for (size_t i = e.kickLog.size(); i-- > 0;)
+        {
+            const Engine::KickStore &store = e.kickLog[i];
+            if (store.address == address && !kickSawStore(e, offset, store.cycle))
+                std::memcpy(out, store.old.data(), 16u);
+        }
+    }
+
+    // Size of the packet at the transfer source, walking its GIF tags like PATH1 does.
+    // Returns 0 if it would not fit the transfer buffer (the reference reports that).
+    // Worked out again only when a store was logged since (or in another run() call).
+    uint32_t walkKickPacket(const Engine &e);
+
+    uint32_t kickPacketBytes(Engine &e)
+    {
+        if (e.kickBytesLog == e.kickLog.size())
+            return e.kickBytes;
+        e.kickBytes = walkKickPacket(e);
+        e.kickBytesLog = e.kickLog.size();
+        return e.kickBytes;
+    }
+
+    uint32_t walkKickPacket(const Engine &e)
+    {
+        uint32_t offset = 0;
+        for (;;)
+        {
+            if (offset > kPacketLimit - 16u)
+                return 0u;
+            uint8_t tag[16];
+            kickQword(e, offset, tag);
+            uint64_t tagLo = 0;
+            std::memcpy(&tagLo, tag, sizeof(tagLo));
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const uint32_t format = static_cast<uint32_t>((tagLo >> 58) & 0x3u);
+            uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+            uint64_t tagBytes = 16u;
+            if (format == 0u)
+                tagBytes += static_cast<uint64_t>(nloop) * nreg * 16u;
+            else if (format == 1u)
+                tagBytes += ((static_cast<uint64_t>(nloop) * nreg + 1u) & ~1ull) * 8u;
+            else
+                tagBytes += static_cast<uint64_t>(nloop) * 16u;
+            if (tagBytes > kPacketLimit - offset)
+                return 0u;
+            offset += static_cast<uint32_t>(tagBytes);
+            if ((tagLo >> 15) & 1u)
+                return offset;
+        }
+    }
+
+    // Cycle at which the active transfer delivers its last qword.
+    uint64_t kickCompletion(Engine &e)
+    {
+        const uint32_t bytes = kickPacketBytes(e);
+        const uint64_t qwords = bytes ? bytes / 16u : 1u;
+        return e.kickIssue + 2u * qwords - 1u;
+    }
+
+    void submitKickPacket(Engine &e, uint32_t bytes);
+
+    void finishKick(Engine &e)
+    {
+        if (!e.kickActive)
+            return;
+        e.kickActive = false;
+        e.kickWatch = 0u;
+        const uint32_t bytes = kickPacketBytes(e);
+        if (bytes == 0u)
+        {
+            clearKickLog(e);
+            reportReserved(e, false, 0xFFFFFFFBu);
+            return;
+        }
+        // The packet may wrap around the end of VU memory; copy it out in order.
+        const uint32_t size = e.dataMask + 1u;
+        e.kickPacket.resize(bytes);
+        for (uint32_t done = 0; done < bytes;)
+        {
+            const uint32_t source = (e.kickSource + done) & e.dataMask;
+            const uint32_t chunk = std::min(bytes - done, size - source);
+            std::memcpy(e.kickPacket.data() + done, e.data + source, chunk);
+            done += chunk;
+        }
+        for (size_t i = e.kickLog.size(); i-- > 0;)
+        {
+            const Engine::KickStore &store = e.kickLog[i];
+            const uint32_t offset = (store.address - e.kickSource) & e.dataMask;
+            if (offset < bytes && !kickSawStore(e, offset, store.cycle))
+                std::memcpy(e.kickPacket.data() + offset, store.old.data(), 16u);
+        }
+        clearKickLog(e);
+        submitKickPacket(e, bytes);
+    }
+
+    // Hands the packet in e.kickPacket to the GIF (or the capture), as PATH1 delivers it.
+    void submitKickPacket(Engine &e, uint32_t bytes)
+    {
+        ++g_ps2Vu1XgkickPackets;
+        g_ps2Vu1XgkickBytes += bytes;
+        static const bool timed = std::getenv("PS2X_VIF_STATS") != nullptr;
+        const auto start = timed ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        if (g_batchPackets) // PS2X_VU1_CAPTURE: a copy, with its size first
+        {
+            const uint32_t size = bytes;
+            const uint8_t *sizeBytes = reinterpret_cast<const uint8_t *>(&size);
+            g_batchPackets->insert(g_batchPackets->end(), sizeBytes, sizeBytes + 4u);
+            g_batchPackets->insert(g_batchPackets->end(), e.kickPacket.begin(), e.kickPacket.end());
+        }
+        if (e.capture)
+            e.capture->insert(e.capture->end(), e.kickPacket.begin(), e.kickPacket.end());
+        else if (e.memory)
+            e.memory->submitGifPacket(GifPathId::Path1, e.kickPacket.data(), bytes);
+        else if (e.gs)
+            e.gs->processGIFPacket(e.kickPacket.data(), bytes);
+        if (timed)
+            ps2vu1fast::stats().kickNanoseconds += static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+    }
+
+    // The packet's extent as the transfer reads it (after a store into it, again).
+    void updateKickWatch(Engine &e)
+    {
+        if (!e.kickActive)
+        {
+            e.kickWatch = 0u;
+            return;
+        }
+        const uint32_t bytes = kickPacketBytes(e);
+        e.kickWatch = bytes != 0u ? bytes : ~0u;
+    }
+
+    void startKick(Engine &e, uint32_t qwordAddress)
+    {
+        e.kickActive = true;
+        e.kickIssue = e.cycle;
+        e.kickSource = (qwordAddress * 16u) & e.dataMask;
+        clearKickLog(e);
+        updateKickWatch(e);
+    }
+
+    inline void storeToVu(Engine &e, uint32_t address, const uint32_t words[4], uint8_t dest)
+    {
+        uint8_t *target = e.data + address;
+        const bool logged = ((address - e.kickSource) & e.dataMask) < e.kickWatch;
+        if (logged)
+        {
+            Engine::KickStore &store = e.kickLog.emplace_back();
+            e.kickLogged[(address >> 10) & 15u] |= 1ull << ((address >> 4) & 63u);
+            store.address = address;
+            store.cycle = e.cycle;
+            std::memcpy(store.old.data(), target, 16u);
+        }
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (dest & laneBit(c))
+                std::memcpy(target + 4u * c, &words[c], 4u);
+        e.lastWriteReady = std::max(e.lastWriteReady, e.cycle + 1u);
+        if (logged)
+            updateKickWatch(e);
+    }
+
+    // ------------------------------------------------------------------------------
+    // MAC/status flags (only for the instructions whose flags can be read, see
+    // analyzeFlagDemand)
+    // ------------------------------------------------------------------------------
+
+    uint8_t classify(double exact)
+    {
+        uint8_t flags = std::signbit(exact) ? 0x2u : 0u;
+        const double magnitude = std::fabs(exact);
+        if (magnitude == 0.0)
+            flags |= 0x1u;
+        else if (magnitude > static_cast<double>(kFloatMax))
+            flags |= 0x8u;
+        else if (magnitude < static_cast<double>(std::numeric_limits<float>::min()))
+            flags |= 0x5u;
+        return flags;
+    }
+
+    // classify() of four results, as masks with bit c for component c: zero (or underflow),
+    // sign, underflow, overflow. The results come as two pairs of doubles, x y and z w.
+    struct LaneClasses
+    {
+        uint32_t zero = 0, sign = 0, under = 0, over = 0;
+    };
+
+    inline LaneClasses classifyLanes(__m128d xy, __m128d zw)
+    {
+        const __m128d signBit = _mm_set1_pd(-0.0);
+        const __m128d floatMax = _mm_set1_pd(static_cast<double>(kFloatMax));
+        const __m128d floatMin = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()));
+        const __m128d magXy = _mm_andnot_pd(signBit, xy);
+        const __m128d magZw = _mm_andnot_pd(signBit, zw);
+        const __m128d zeroD = _mm_setzero_pd();
+        const uint32_t zero = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpeq_pd(magXy, zeroD)) |
+                                                    (_mm_movemask_pd(_mm_cmpeq_pd(magZw, zeroD)) << 2));
+        const uint32_t tiny = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmplt_pd(magXy, floatMin)) |
+                                                    (_mm_movemask_pd(_mm_cmplt_pd(magZw, floatMin)) << 2));
+        LaneClasses out;
+        out.sign = static_cast<uint32_t>(_mm_movemask_pd(xy) | (_mm_movemask_pd(zw) << 2));
+        out.over = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpgt_pd(magXy, floatMax)) |
+                                         (_mm_movemask_pd(_mm_cmpgt_pd(magZw, floatMax)) << 2));
+        out.under = tiny & ~zero;
+        out.zero = zero | out.under;
+        return out;
+    }
+
+    // Component masks (bit c = component c) to the flag registers' order (x is bit 3).
+    constexpr uint8_t kLaneOrder[16] = {0x0, 0x8, 0x4, 0xC, 0x2, 0xA, 0x6, 0xE, 0x1, 0x9, 0x5, 0xD, 0x3, 0xB, 0x7, 0xF};
+
+    // The flags of an FMAC result: the exact result (in double precision, from the operands
+    // as the upper reads them) classified per component, four at a time.
+    void pushFmacFlags(Engine &e, const Pair &p)
+    {
+        const VU1State &st = *e.st;
+        const __m128 vs = normFull(_mm_loadu_ps(st.vf[p.fs]));
+        __m128 right;
+        switch (p.operand)
+        {
+        case OBc:
+            right = _mm_set1_ps(normScalar(st.vf[p.ft][p.bc]));
+            break;
+        case OQ:
+            right = _mm_set1_ps(normScalar(st.q));
+            break;
+        case OI:
+            right = _mm_set1_ps(normScalar(st.i));
+            break;
+        default:
+            right = normFull(_mm_loadu_ps(st.vf[p.ft]));
+            break;
+        }
+        const bool outer = p.arith == AOpmula || p.arith == AOpmsub;
+        __m128 left = vs;
+        if (outer)
+        {
+            left = _mm_shuffle_ps(vs, vs, _MM_SHUFFLE(3, 0, 2, 1));          // y z x w
+            right = _mm_shuffle_ps(right, right, _MM_SHUFFLE(3, 1, 0, 2));   // z x y w
+        }
+        const __m128d leftXy = _mm_cvtps_pd(left);
+        const __m128d leftZw = _mm_cvtps_pd(_mm_movehl_ps(left, left));
+        const __m128d rightXy = _mm_cvtps_pd(right);
+        const __m128d rightZw = _mm_cvtps_pd(_mm_movehl_ps(right, right));
+        const __m128d productXy = _mm_mul_pd(leftXy, rightXy);
+        const __m128d productZw = _mm_mul_pd(leftZw, rightZw);
+        __m128d accXy = _mm_setzero_pd(), accZw = _mm_setzero_pd();
+        if (p.arith == AMadd || p.arith == AMsub || p.arith == AOpmsub)
+        {
+            const __m128 acc = normFull(_mm_loadu_ps(st.acc));
+            accXy = _mm_cvtps_pd(acc);
+            accZw = _mm_cvtps_pd(_mm_movehl_ps(acc, acc));
+        }
+
+        __m128d exactXy = _mm_setzero_pd(), exactZw = _mm_setzero_pd();
+        switch (p.arith)
+        {
+        case AAdd:
+            exactXy = _mm_add_pd(leftXy, rightXy);
+            exactZw = _mm_add_pd(leftZw, rightZw);
+            break;
+        case ASub:
+            exactXy = _mm_sub_pd(leftXy, rightXy);
+            exactZw = _mm_sub_pd(leftZw, rightZw);
+            break;
+        case AMul:
+            exactXy = productXy;
+            exactZw = productZw;
+            break;
+        case AMadd:
+            exactXy = _mm_add_pd(accXy, productXy);
+            exactZw = _mm_add_pd(accZw, productZw);
+            break;
+        case AMsub:
+            exactXy = _mm_sub_pd(accXy, productXy);
+            exactZw = _mm_sub_pd(accZw, productZw);
+            break;
+        case AOpmula:
+            exactXy = productXy;
+            exactZw = _mm_unpacklo_pd(productZw, _mm_setzero_pd()); // w = +0
+            break;
+        case AOpmsub:
+            exactXy = _mm_sub_pd(accXy, productXy);
+            exactZw = _mm_unpacklo_pd(_mm_sub_pd(accZw, productZw), _mm_setzero_pd());
+            break;
+        default:
+            break;
+        }
+
+        const uint32_t dest = kLaneOrder[p.dest & 0xFu]; // the written components, bit c = component c
+        const LaneClasses result = classifyLanes(exactXy, exactZw);
+        const uint32_t zero = result.zero & dest, sign = result.sign & dest;
+        const uint32_t under = result.under & dest, over = result.over & dest;
+        const uint32_t mac = kLaneOrder[zero] | (static_cast<uint32_t>(kLaneOrder[sign]) << 4) |
+                             (static_cast<uint32_t>(kLaneOrder[under]) << 8) | (static_cast<uint32_t>(kLaneOrder[over]) << 12);
+        const uint32_t status = (zero ? 0x1u : 0u) | (sign ? 0x2u : 0u) | (under ? 0x4u : 0u) | (over ? 0x8u : 0u);
+        uint32_t sticky = 0;
+        if (p.arith == AMadd || p.arith == AMsub || p.arith == AOpmsub)
+        {
+            const LaneClasses product = classifyLanes(productXy, productZw);
+            sticky = ((product.zero & dest) ? 0x1u : 0u) | ((product.sign & dest) ? 0x2u : 0u) |
+                     ((product.under & dest) ? 0x4u : 0u) | ((product.over & dest) ? 0x8u : 0u);
+        }
+        if (FlagEntry *entry = pushFlag(e))
+        {
+            entry->mac = mac;
+            entry->status = status;
+            entry->extraSticky = sticky;
+            entry->writesMac = true;
+            entry->writesStatus = true;
+        }
+    }
+
+    // ------------------------------------------------------------------------------
+    // Upper instructions: compute into e.upResult; run() commits after the lower.
+    // ------------------------------------------------------------------------------
+
+    template <Arith A>
+    inline __m128 operandNorm(__m128 v)
+    {
+        if constexpr (A == AMax || A == AMini)
+            return v; // compared as raw bits
+        else
+            return norm(v);
+    }
+
+    // MAX/MINI compare bit patterns as sign-magnitude integers (see the reference's
+    // vuMaxBits): signed-integer max, except min when both operands are negative.
+    template <bool Max>
+    inline __m128 maxMiniBits(__m128 a, __m128 b)
+    {
+        const __m128i ai = _mm_castps_si128(a);
+        const __m128i bi = _mm_castps_si128(b);
+        const __m128i larger = _mm_max_epi32(ai, bi);
+        const __m128i smaller = _mm_min_epi32(ai, bi);
+        const __m128i bothNegative = _mm_srai_epi32(_mm_and_si128(ai, bi), 31);
+        return _mm_castsi128_ps(Max ? _mm_blendv_epi8(larger, smaller, bothNegative)
+                                    : _mm_blendv_epi8(smaller, larger, bothNegative));
+    }
+
+    template <Arith A, Operand O>
+    void upperArith(Engine &e, const Pair &p)
+    {
+        const __m128 a = operandNorm<A>(loadVf(e, p.fs));
+        __m128 b;
+        if constexpr (O == OBc)
+            b = operandNorm<A>(_mm_set1_ps(e.st->vf[p.ft][p.bc]));
+        else if constexpr (O == OQ)
+            b = operandNorm<A>(_mm_set1_ps(e.st->q));
+        else if constexpr (O == OI)
+            b = operandNorm<A>(_mm_set1_ps(e.st->i));
+        else
+            b = operandNorm<A>(loadVf(e, p.ft));
+
+        __m128 r;
+        if constexpr (A == AAdd)
+            r = _mm_add_ps(a, b);
+        else if constexpr (A == ASub)
+            r = _mm_sub_ps(a, b);
+        else if constexpr (A == AMul)
+            r = _mm_mul_ps(a, b);
+        else if constexpr (A == AMadd)
+            r = _mm_add_ps(norm(_mm_loadu_ps(e.st->acc)), _mm_mul_ps(a, b));
+        else if constexpr (A == AMsub)
+            r = _mm_sub_ps(norm(_mm_loadu_ps(e.st->acc)), _mm_mul_ps(a, b));
+        else if constexpr (A == AMax)
+            r = maxMiniBits<true>(a, b);
+        else if constexpr (A == AMini)
+            r = maxMiniBits<false>(a, b);
+        else
+        {
+            const __m128 ayzx = _mm_shuffle_ps(a, a, _MM_SHUFFLE(3, 0, 2, 1));
+            const __m128 bzxy = _mm_shuffle_ps(b, b, _MM_SHUFFLE(3, 1, 0, 2));
+            const __m128 product = _mm_mul_ps(ayzx, bzxy);
+            if constexpr (A == AOpmula)
+                r = product;
+            else
+                r = _mm_sub_ps(norm(_mm_loadu_ps(e.st->acc)), product);
+            r = _mm_and_ps(r, kXyzMask); // w = +0
+        }
+        e.upResult = r;
+        if constexpr (A != AMax && A != AMini)
+        {
+            if (p.flags & PfFmacFlags)
+                pushFmacFlags(e, p);
+        }
+    }
+
+    template <int Shift>
+    void upperItof(Engine &e, const Pair &p)
+    {
+        __m128 r = _mm_cvtepi32_ps(_mm_castps_si128(loadVf(e, p.fs)));
+        if constexpr (Shift != 0)
+            r = _mm_mul_ps(r, _mm_set1_ps(1.0f / static_cast<float>(1 << Shift)));
+        e.upResult = r;
+    }
+
+    template <int Shift>
+    void upperFtoi(Engine &e, const Pair &p)
+    {
+        __m128 scaled = norm(loadVf(e, p.fs));
+        if constexpr (Shift != 0)
+            scaled = _mm_mul_ps(scaled, _mm_set1_ps(static_cast<float>(1 << Shift)));
+        const __m128i truncated = _mm_cvttps_epi32(scaled);
+        const __m128 positiveOverflow = _mm_cmpge_ps(scaled, _mm_set1_ps(2147483648.0f));
+        e.upResult = _mm_blendv_ps(_mm_castsi128_ps(truncated),
+                                   _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF)), positiveOverflow);
+    }
+
+    void upperAbs(Engine &e, const Pair &p)
+    {
+        e.upResult = _mm_andnot_ps(_mm_castsi128_ps(kSignMask), normFull(loadVf(e, p.fs)));
+    }
+
+    void upperClip(Engine &e, const Pair &p)
+    {
+        uint32_t wBits = 0;
+        std::memcpy(&wBits, &e.st->vf[p.ft][3], sizeof(wBits));
+        const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+        const __m128i value = _mm_castps_si128(loadVf(e, p.fs));
+        const __m128i bound = _mm_set1_epi32(limit);
+        const int above = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(value, bound)));
+        const int below = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(_mm_xor_si128(value, kSignMask), bound)));
+        const uint32_t flags = ((above & 1) ? 0x01u : 0u) | ((below & 1) ? 0x02u : 0u) |
+                               ((above & 2) ? 0x04u : 0u) | ((below & 2) ? 0x08u : 0u) |
+                               ((above & 4) ? 0x10u : 0u) | ((below & 4) ? 0x20u : 0u);
+        e.workingClip = ((e.workingClip << 6) | flags) & 0xFFFFFFu;
+        if (FlagEntry *entry = pushFlag(e))
+        {
+            entry->clip = e.workingClip;
+            entry->writesClip = true;
+        }
+    }
+
+    void upperNop(Engine &, const Pair &) {}
+
+    void upperReserved(Engine &e, const Pair &p) { reportReserved(e, true, p.upperWord); }
+
+    // ------------------------------------------------------------------------------
+    // Lower instructions
+    // ------------------------------------------------------------------------------
+
+    inline uint32_t vuAddress(const Engine &e, int32_t base, int32_t offset)
+    {
+        return (static_cast<uint32_t>(base + offset) * 16u) & e.dataMask;
+    }
+
+    inline uint32_t lane(const Pair &p)
+    {
+        const uint8_t d = p.ldest;
+        return (d & 0x8u) ? 0u : (d & 0x4u) ? 1u : (d & 0x2u) ? 2u : 3u;
+    }
+
+    void lowerNop(Engine &, const Pair &) {}
+    void lowerReserved(Engine &e, const Pair &p) { reportReserved(e, false, p.lowerWord); }
+
+    void lowerLoi(Engine &e, const Pair &p)
+    {
+        float immediate = 0.0f;
+        std::memcpy(&immediate, &p.lowerWord, sizeof(immediate));
+        e.st->i = immediate; // raw bits; FMAC operations normalize I when they use it
+    }
+
+    void lowerLq(Engine &e, const Pair &p)
+    {
+        const uint32_t address = vuAddress(e, e.st->vi[p.lis], p.imm);
+        writeVf(e, p.lft, _mm_loadu_ps(reinterpret_cast<const float *>(e.data + address)), p.ldest);
+    }
+
+    void lowerSq(Engine &e, const Pair &p)
+    {
+        const uint32_t address = vuAddress(e, e.st->vi[p.lit], p.imm);
+        uint32_t words[4];
+        std::memcpy(words, e.st->vf[p.lfs], sizeof(words));
+        storeToVu(e, address, words, p.ldest);
+    }
+
+    void lowerIlw(Engine &e, const Pair &p)
+    {
+        const uint32_t address = vuAddress(e, e.st->vi[p.lis], p.imm);
+        uint32_t value = 0;
+        std::memcpy(&value, e.data + address + lane(p) * 4u, 4u);
+        writeVi(e, p.lit, static_cast<int16_t>(value & 0xFFFFu));
+    }
+
+    void lowerIsw(Engine &e, const Pair &p)
+    {
+        const uint32_t address = vuAddress(e, e.st->vi[p.lis], p.imm);
+        const uint32_t value = static_cast<uint16_t>(e.st->vi[p.lit]);
+        const uint32_t words[4] = {value, value, value, value};
+        storeToVu(e, address, words, p.ldest);
+    }
+
+    void lowerIaddiu(Engine &e, const Pair &p) { writeVi(e, p.lit, e.st->vi[p.lis] + p.imm); }
+    void lowerIsubiu(Engine &e, const Pair &p) { writeVi(e, p.lit, e.st->vi[p.lis] - p.imm); }
+
+    void lowerFceq(Engine &e, const Pair &p)
+    {
+        e.st->vi[1] = ((e.st->clip & 0xFFFFFFu) == (p.lowerWord & 0xFFFFFFu)) ? 1 : 0;
+    }
+
+    void lowerFcset(Engine &e, const Pair &p)
+    {
+        e.workingClip = p.lowerWord & 0xFFFFFFu;
+        for (uint32_t i = 0; i < e.flagCount; ++i)
+        {
+            FlagEntry &entry = e.flags[(e.flagHead + i) & 15u];
+            if (entry.issue == e.cycle)
+                entry.writesClip = false;
+        }
+        if (FlagEntry *entry = pushFlag(e))
+        {
+            entry->clip = e.workingClip;
+            entry->writesClip = true;
+        }
+    }
+
+    void lowerFcand(Engine &e, const Pair &p)
+    {
+        e.st->vi[1] = ((e.st->clip & (p.lowerWord & 0xFFFFFFu)) != 0u) ? 1 : 0;
+    }
+
+    void lowerFcor(Engine &e, const Pair &p)
+    {
+        e.st->vi[1] = ((e.st->clip | (p.lowerWord & 0xFFFFFFu)) == 0xFFFFFFu) ? 1 : 0;
+    }
+
+    inline uint32_t imm12(const Pair &p)
+    {
+        return (((p.lowerWord >> 21) & 0x1u) << 11) | (p.lowerWord & 0x7FFu);
+    }
+
+    void lowerFseq(Engine &e, const Pair &p) { writeVi(e, p.lit, ((e.st->status & 0xFFFu) == imm12(p)) ? 1 : 0); }
+    void lowerFsand(Engine &e, const Pair &p) { writeVi(e, p.lit, static_cast<int32_t>((e.st->status & 0xFFFu) & imm12(p))); }
+    void lowerFsor(Engine &e, const Pair &p) { writeVi(e, p.lit, static_cast<int32_t>((e.st->status & 0xFFFu) | imm12(p))); }
+
+    void lowerFsset(Engine &e, const Pair &p)
+    {
+        for (uint32_t i = 0; i < e.flagCount; ++i)
+        {
+            FlagEntry &entry = e.flags[(e.flagHead + i) & 15u];
+            if (entry.issue == e.cycle)
+                entry.writesStatus = false;
+        }
+        if (FlagEntry *entry = pushFlag(e))
