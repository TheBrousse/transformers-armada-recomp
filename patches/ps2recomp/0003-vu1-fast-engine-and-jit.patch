+
+    void lowerIadd(Engine &e, const Pair &p) { writeVi(e, p.lid, e.st->vi[p.lis] + e.st->vi[p.lit]); }
+    void lowerIsub(Engine &e, const Pair &p) { writeVi(e, p.lid, e.st->vi[p.lis] - e.st->vi[p.lit]); }
+    void lowerIaddi(Engine &e, const Pair &p) { writeVi(e, p.lit, e.st->vi[p.lis] + p.imm); }
+    void lowerIand(Engine &e, const Pair &p)
+    {
+        if (p.lid != 0u)
+            e.st->vi[p.lid] = e.st->vi[p.lis] & e.st->vi[p.lit];
+    }
+    void lowerIor(Engine &e, const Pair &p)
+    {
