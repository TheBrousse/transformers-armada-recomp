+// PS2X_VU1_HISTORY=<pairs>: with PS2X_VU1_REFERENCE=1, records the last <pairs> executed
+// instruction pairs of VU1 (pc and VI registers), every program start and every VIF1
+// UNPACK; the first reserved instruction or XGKICK error writes them to
+// runs/vu1_history.txt (a flight recorder for "how did the program get here").
+namespace
+{
+    struct Vu1HistoryEntry
+    {
+        uint64_t cycle = 0;
+        uint32_t extra = 0;
+        uint16_t pc = 0;
+        uint8_t kind = 0; // 0 pair, 1 MSCAL, 2 MSCNT, 3 UNPACK
+        uint16_t vi[16] = {};
+    };
+
+    std::vector<Vu1HistoryEntry> g_vu1History;
+    size_t g_vu1HistoryCount = 0;
+    bool g_vu1HistoryDumped = false;
+
+    size_t vu1HistoryCapacity()
+    {
+        static const size_t capacity = []()
+        {
+            const char *env = std::getenv("PS2X_VU1_HISTORY");
+            return env ? static_cast<size_t>(std::strtoull(env, nullptr, 10)) : size_t{0};
+        }();
+        return capacity;
+    }
+
+    void vu1HistoryPush(uint8_t kind, uint64_t cycle, uint32_t pc, const VU1State *state, uint32_t extra)
+    {
+        const size_t capacity = vu1HistoryCapacity();
+        if (capacity == 0u || g_vu1HistoryDumped)
+            return;
+        if (g_vu1History.size() < capacity)
+            g_vu1History.resize(capacity);
+        Vu1HistoryEntry &entry = g_vu1History[g_vu1HistoryCount++ % capacity];
+        entry.cycle = cycle;
+        entry.extra = extra;
+        entry.pc = static_cast<uint16_t>(pc);
+        entry.kind = kind;
+        if (state)
+        {
+            for (int reg = 0; reg < 16; ++reg)
+                entry.vi[reg] = static_cast<uint16_t>(state->vi[reg]);
+        }
+    }
+
+    void vu1HistoryDump(const char *reason, uint32_t pc)
+    {
+        const size_t capacity = vu1HistoryCapacity();
+        if (capacity == 0u || g_vu1HistoryDumped)
+            return;
+        g_vu1HistoryDumped = true;
+        std::FILE *file = std::fopen("runs/vu1_history.txt", "w");
+        if (!file)
+            return;
+        const size_t count = std::min(g_vu1HistoryCount, capacity);
+        for (size_t i = 0; i < count; ++i)
+        {
+            const Vu1HistoryEntry &entry = g_vu1History[(g_vu1HistoryCount - count + i) % capacity];
+            if (entry.kind == 3u)
+            {
+                std::fprintf(file, "UNPACK q%03x num=%u\n", entry.pc, entry.extra);
+                continue;
+            }
+            if (entry.kind != 0u)
+                std::fprintf(file, "%s pc=%04x itop=%03x top=%03x\n", entry.kind == 1u ? "MSCAL" : "MSCNT", entry.pc,
+                             entry.extra & 0xFFFFu, entry.extra >> 16);
+            else
+                std::fprintf(file, "%llu %04x", static_cast<unsigned long long>(entry.cycle), entry.pc);
+            if (entry.kind == 0u)
+            {
+                for (int reg = 1; reg < 16; ++reg)
+                    std::fprintf(file, " %x", entry.vi[reg]);
+                std::fprintf(file, "\n");
+            }
+        }
+        std::fprintf(file, "%s at pc=%04x\n", reason, pc);
+        std::fclose(file);
+    }
+}
+
+void ps2Vu1HistoryUnpack(uint32_t qword, uint32_t count)
+{
+    vu1HistoryPush(3u, 0u, qword, nullptr, count);
+}
