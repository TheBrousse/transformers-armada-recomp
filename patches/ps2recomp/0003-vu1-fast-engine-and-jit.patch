+
+    void addRead(Pair &p, uint8_t reg, uint8_t lanes)
+    {
+        if (reg == 0u || lanes == 0u)
+            return;
+        for (uint32_t i = 0; i < p.readCount; ++i)
+        {
+            if (p.readReg[i] == reg)
+            {
+                p.readLanes[i] |= lanes;
+                return;
+            }
+        }
+        if (p.readCount < 4u)
+        {
+            p.readReg[p.readCount] = reg;
+            p.readLanes[p.readCount] = lanes;
+            ++p.readCount;
+        }
+    }
+
+    template <Arith A>
+    OpFn arithFn(Operand operand)
+    {
+        switch (operand)
+        {
+        case OBc:
+            return &upperArith<A, OBc>;
+        case OQ:
+            return &upperArith<A, OQ>;
+        case OI:
+            return &upperArith<A, OI>;
+        default:
+            return &upperArith<A, OVec>;
+        }
+    }
+
+    OpFn arithHandler(Arith arith, Operand operand)
+    {
+        switch (arith)
+        {
+        case AAdd:
+            return arithFn<AAdd>(operand);
+        case ASub:
+            return arithFn<ASub>(operand);
+        case AMul:
+            return arithFn<AMul>(operand);
+        case AMadd:
+            return arithFn<AMadd>(operand);
+        case AMsub:
+            return arithFn<AMsub>(operand);
+        case AMax:
+            return arithFn<AMax>(operand);
+        case AMini:
+            return arithFn<AMini>(operand);
+        case AOpmula:
+            return &upperArith<AOpmula, OVec>;
+        default:
+            return &upperArith<AOpmsub, OVec>;
+        }
+    }
+
+    // Upper op / special code -> arithmetic kind and second operand.
+    bool upperArithKind(uint8_t code, bool special, Arith &arith, Operand &operand)
+    {
+        if (code <= 0x1Bu && !(code >= 0x10u && code <= 0x17u && special))
+        {
+            static constexpr Arith bcKinds[7] = {AAdd, ASub, AMadd, AMsub, AMax, AMini, AMul};
+            arith = bcKinds[code >> 2];
+            operand = OBc;
+            return true;
+        }
+        switch (code)
+        {
+        case 0x1Cu: arith = AMul; operand = OQ; return true;
+        case 0x1Du: if (special) return false; arith = AMax; operand = OI; return true;
+        case 0x1Eu: arith = AMul; operand = OI; return true;
+        case 0x1Fu: if (special) return false; arith = AMini; operand = OI; return true;
+        case 0x20u: arith = AAdd; operand = OQ; return true;
+        case 0x21u: arith = AMadd; operand = OQ; return true;
+        case 0x22u: arith = AAdd; operand = OI; return true;
+        case 0x23u: arith = AMadd; operand = OI; return true;
+        case 0x24u: arith = ASub; operand = OQ; return true;
+        case 0x25u: arith = AMsub; operand = OQ; return true;
+        case 0x26u: arith = ASub; operand = OI; return true;
+        case 0x27u: arith = AMsub; operand = OI; return true;
+        case 0x28u: arith = AAdd; operand = OVec; return true;
+        case 0x29u: arith = AMadd; operand = OVec; return true;
+        case 0x2Au: arith = AMul; operand = OVec; return true;
+        case 0x2Bu: if (special) return false; arith = AMax; operand = OVec; return true;
+        case 0x2Cu: arith = ASub; operand = OVec; return true;
+        case 0x2Du: arith = AMsub; operand = OVec; return true;
+        case 0x2Eu: arith = special ? AOpmula : AOpmsub; operand = OVec; return true;
+        case 0x2Fu: if (special) return false; arith = AMini; operand = OVec; return true;
+        default: return false;
+        }
+    }
+
+    void decodeUpper(const Engine &e, Pair &p, uint32_t upper, uint32_t index)
+    {
+        p.dest = DEST(upper);
+        p.fs = FS(upper);
+        p.ft = FT(upper);
+        p.fd = FD(upper);
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        const bool special = op >= 0x3Cu;
+        const uint8_t code = special ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+
+        Arith arith = AAdd;
+        Operand operand = OVec;
+        if ((special || op <= 0x2Fu) && upperArithKind(code, special, arith, operand))
+        {
+            p.arith = arith;
+            p.operand = operand;
+            p.bc = static_cast<uint8_t>(code & 3u);
+            p.upper = arithHandler(arith, operand);
+            addRead(p, p.fs, p.dest);
+            if (operand == OBc)
+                addRead(p, p.ft, laneBit(p.bc));
+            else if (operand == OVec)
+                addRead(p, p.ft, (arith == AOpmula || arith == AOpmsub) ? 0xEu : p.dest);
+            if (special)
+            {
+                p.upTarget = UtAcc; // ACC is forwarded to the next upper: no interlock
+            }
+            else
+            {
+                p.upTarget = UtVf;
+                p.upReg = p.fd;
+            }
+            if (e.needFlags && e.needFlags[index] != 0u && p.dest != 0u && arith != AMax && arith != AMini)
+                p.flags |= PfFmacFlags;
+            return;
+        }
+        if (special && code >= 0x10u && code <= 0x17u)
+        {
+            static constexpr OpFn converts[8] = {&upperItof<0>, &upperItof<4>, &upperItof<12>, &upperItof<15>,
+                                                 &upperFtoi<0>, &upperFtoi<4>, &upperFtoi<12>, &upperFtoi<15>};
+            p.upper = converts[code - 0x10u];
+            addRead(p, p.fs, p.dest);
+            p.upTarget = UtVf;
+            p.upReg = p.ft;
+            return;
+        }
+        if (special && code == 0x1Du) // ABS
+        {
+            p.upper = &upperAbs;
+            addRead(p, p.fs, p.dest);
+            p.upTarget = UtVf;
+            p.upReg = p.ft;
+            return;
+        }
+        if (special && code == 0x1Fu) // CLIP
+        {
+            p.upper = &upperClip;
+            addRead(p, p.fs, 0xEu);
+            addRead(p, p.ft, 0x1u);
+            return;
+        }
+        if (special && (code == 0x2Fu || code == 0x30u)) // NOP
+        {
+            p.upper = &upperNop;
+            return;
+        }
+        p.upper = &upperReserved;
+        p.flags |= PfReserved;
+    }
+
+    void decodeLower(Pair &p, uint32_t lower, uint8_t &loReads, uint8_t loReadRegs[2])
+    {
+        p.lower = &lowerNop;
+        if (lower == 0u || lower == 0x8000033Cu)
+            return;
+
+        p.lfs = FS(lower);
+        p.lft = FT(lower);
+        p.lis = VIS(lower);
+        p.lit = VIT(lower);
+        p.lid = VID(lower);
+        p.ldest = DEST(lower);
+        p.fsf = static_cast<uint8_t>((lower >> 21) & 3u);
+        p.ftf = static_cast<uint8_t>((lower >> 23) & 3u);
+        const auto readVi = [&](uint8_t reg)
+        {
+            if (reg != 0u)
+                p.viReads |= static_cast<uint16_t>(1u << reg);
+        };
+        const auto writeViReg = [&](uint8_t reg, uint8_t latency)
+        {
+            if (reg != 0u)
+            {
+                p.viWriteReg = reg;
+                p.viLatency = latency;
+            }
+        };
+        const auto readVf = [&](uint8_t reg, uint8_t lanes)
+        {
+            addRead(p, reg, lanes);
+            if (reg != 0u && lanes != 0u && loReads < 2u)
+                loReadRegs[loReads++] = reg;
+        };
+        const auto writeVfReg = [&](uint8_t reg, uint8_t lanes, uint8_t latency)
+        {
+            p.loWriteReg = reg;
+            p.loWriteLanes = lanes;
+            p.loLatency = latency;
+        };
+
+        const uint8_t opHi = static_cast<uint8_t>((lower >> 25) & 0x7Fu);
+        switch (opHi)
+        {
+        case 0x00:
+            p.lower = &lowerLq;
+            p.imm = IMM11(lower);
+            readVi(p.lis);
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x01:
+            p.lower = &lowerSq;
+            p.imm = IMM11(lower);
+            p.flags |= PfStore;
+            readVi(p.lit);
+            readVf(p.lfs, p.ldest);
+            return;
+        case 0x04:
+            p.lower = &lowerIlw;
+            p.imm = IMM11(lower);
+            readVi(p.lis);
+            writeViReg(p.lit, 4u);
+            return;
+        case 0x05:
+            p.lower = &lowerIsw;
+            p.imm = IMM11(lower);
+            p.flags |= PfStore;
+            readVi(p.lis);
+            readVi(p.lit);
+            return;
+        case 0x08:
+        case 0x09:
+            p.lower = opHi == 0x08 ? &lowerIaddiu : &lowerIsubiu;
+            p.imm = static_cast<int32_t>((lower & 0x7FFu) | ((lower >> 10) & 0x7800u));
+            p.flags |= PfBranchBackup;
+            readVi(p.lis);
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x10:
+            p.lower = &lowerFceq;
+            writeViReg(1u, 1u);
+            return;
+        case 0x11:
+            p.lower = &lowerFcset;
+            return;
+        case 0x12:
+            p.lower = &lowerFcand;
+            writeViReg(1u, 1u);
+            return;
+        case 0x13:
+            p.lower = &lowerFcor;
+            writeViReg(1u, 1u);
+            return;
+        case 0x14:
+        case 0x16:
+        case 0x17:
+            p.lower = opHi == 0x14 ? &lowerFseq : opHi == 0x16 ? &lowerFsand : &lowerFsor;
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x15:
+            p.lower = &lowerFsset;
+            return;
+        case 0x18:
+        case 0x1A:
+        case 0x1B:
+            p.lower = opHi == 0x18 ? &lowerFmeq : opHi == 0x1A ? &lowerFmand : &lowerFmor;
+            readVi(p.lis);
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x1C:
+            p.lower = &lowerFcget;
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x20:
+            p.lower = &lowerB;
+            p.imm = IMM11(lower);
+            p.flags |= PfBranch;
+            return;
+        case 0x21:
+            p.lower = &lowerBal;
+            p.imm = IMM11(lower);
+            p.flags |= PfBranch;
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x24:
+            p.lower = &lowerJr;
+            p.flags |= PfBranch;
+            readVi(p.lis);
+            return;
+        case 0x25:
+            p.lower = &lowerJalr;
+            p.flags |= PfBranch;
+            readVi(p.lis);
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x28:
+        case 0x29:
+            p.lower = opHi == 0x28 ? &lowerIbeq : &lowerIbne;
+            p.imm = IMM11(lower);
+            p.flags |= PfBranch;
+            readVi(p.lis);
+            readVi(p.lit);
+            return;
+        case 0x2C:
+        case 0x2D:
+        case 0x2E:
+        case 0x2F:
+        {
+            static constexpr OpFn branches[4] = {&lowerIbltz, &lowerIbgtz, &lowerIblez, &lowerIbgez};
+            p.lower = branches[opHi - 0x2C];
+            p.imm = IMM11(lower);
+            p.flags |= PfBranch;
+            readVi(p.lis);
+            return;
+        }
+        case 0x40:
+            break;
+        default:
+            p.lower = &lowerReserved;
+            p.flags |= PfReserved;
+            return;
+        }
+
+        const uint8_t direct = static_cast<uint8_t>(lower & 0x3Fu);
+        switch (direct)
+        {
+        case 0x30:
+        case 0x31:
+        case 0x34:
+        case 0x35:
+            p.lower = direct == 0x30 ? &lowerIadd : direct == 0x31 ? &lowerIsub : direct == 0x34 ? &lowerIand : &lowerIor;
+            p.flags |= PfBranchBackup;
+            readVi(p.lis);
+            readVi(p.lit);
+            writeViReg(p.lid, 1u);
+            return;
+        case 0x32:
+            p.lower = &lowerIaddi;
+            p.imm = static_cast<int16_t>(static_cast<int32_t>((lower >> 6) & 0x1Fu) << 27 >> 27);
+            p.flags |= PfBranchBackup;
+            readVi(p.lis);
+            writeViReg(p.lit, 1u);
+            return;
+        default:
+            break;
+        }
+        if (direct < 0x3Cu)
+        {
+            p.lower = &lowerReserved;
+            p.flags |= PfReserved;
+            return;
+        }
+
+        const uint8_t special = static_cast<uint8_t>((lower & 3u) | ((lower >> 4) & 0x7Cu));
+        switch (special)
+        {
+        case 0x30:
+            p.lower = &lowerMove;
+            readVf(p.lfs, p.ldest);
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x31:
+            p.lower = &lowerMr32;
+            readVf(p.lfs, 0xFu);
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x34:
+        case 0x36:
+            p.lower = special == 0x34 ? &lowerLqi : &lowerLqd;
+            p.flags |= PfBranchBackup;
+            readVi(p.lis);
+            writeViReg(p.lis, 1u);
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x35:
+        case 0x37:
+            p.lower = special == 0x35 ? &lowerSqi : &lowerSqd;
+            p.flags |= PfBranchBackup | PfStore;
+            readVi(p.lit);
+            writeViReg(p.lit, 1u);
+            readVf(p.lfs, p.ldest);
+            return;
+        case 0x38:
+            p.lower = &lowerDiv;
+            p.resource = ResFdiv;
+            readVf(p.lfs, laneBit(p.fsf));
+            readVf(p.lft, laneBit(p.ftf));
+            return;
+        case 0x39:
+            p.lower = &lowerSqrt;
+            p.resource = ResFdiv;
+            readVf(p.lft, laneBit(p.ftf));
+            return;
+        case 0x3A:
+            p.lower = &lowerRsqrt;
+            p.resource = ResFdiv;
+            readVf(p.lfs, laneBit(p.fsf));
+            readVf(p.lft, laneBit(p.ftf));
+            return;
+        case 0x3B:
+            p.lower = &lowerNop; // WAITQ
+            p.resource = ResWaitQ;
+            return;
+        case 0x3C:
+            p.lower = &lowerMtir;
+            p.flags |= PfBranchBackup;
+            readVf(p.lfs, laneBit(p.fsf));
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x3D:
+            p.lower = &lowerMfir;
+            readVi(p.lis);
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x3E:
+            p.lower = &lowerIlwr;
+            readVi(p.lis);
+            writeViReg(p.lit, 4u);
+            return;
+        case 0x3F:
+            p.lower = &lowerIswr;
+            p.flags |= PfStore;
+            readVi(p.lis);
+            readVi(p.lit);
+            return;
+        case 0x40:
+        case 0x41:
+            p.lower = special == 0x40 ? &lowerRnext : &lowerRget;
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x42:
+        case 0x43:
+            p.lower = special == 0x42 ? &lowerRinit : &lowerRxor;
+            readVf(p.lfs, laneBit(p.fsf));
+            return;
+        case 0x64:
+            p.lower = &lowerMfp;
+            writeVfReg(p.lft, p.ldest, 4u);
+            return;
+        case 0x68:
+        case 0x69:
+            p.lower = special == 0x68 ? &lowerXtop : &lowerXitop;
+            writeViReg(p.lit, 1u);
+            return;
+        case 0x6C:
+            p.lower = &lowerXgkick;
+            p.resource = ResXgkick;
+            readVi(p.lis);
+            return;
+        case 0x7B:
+            p.lower = &lowerNop; // WAITP
+            p.resource = ResWaitP;
+            return;
+        default:
+            break;
+        }
+
+        struct EfuOp
+        {
+            uint8_t code;
+            OpFn fn;
+            uint8_t latency;
+            uint8_t lanes; // 0 = the fsf component
+        };
+        static constexpr EfuOp efuOps[] = {
+            {0x70, &lowerEfu<0x70>, 11, 0xE}, {0x71, &lowerEfu<0x71>, 18, 0xE}, {0x72, &lowerEfu<0x72>, 18, 0xE},
+            {0x73, &lowerEfu<0x73>, 24, 0xE}, {0x74, &lowerEfu<0x74>, 54, 0xC}, {0x75, &lowerEfu<0x75>, 54, 0xA},
+            {0x76, &lowerEfu<0x76>, 12, 0xF}, {0x78, &lowerEfu<0x78>, 12, 0}, {0x79, &lowerEfu<0x79>, 18, 0},
+            {0x7A, &lowerEfu<0x7A>, 12, 0}, {0x7C, &lowerEfu<0x7C>, 29, 0}, {0x7D, &lowerEfu<0x7D>, 54, 0},
+            {0x7E, &lowerEfu<0x7E>, 44, 0}};
+        for (const EfuOp &op : efuOps)
+        {
+            if (op.code == special)
+            {
+                p.lower = op.fn;
+                p.resource = ResEfu;
+                p.efuLatency = op.latency;
+                readVf(p.lfs, op.lanes ? op.lanes : laneBit(p.fsf));
+                return;
+            }
+        }
+        p.lower = &lowerReserved;
+        p.flags |= PfReserved;
+    }
+
+    void decodePairCore(const Engine &e, Pair &p, const uint8_t *code, uint32_t pc)
+    {
+        p = Pair{};
+        p.epoch = e.epoch;
+        std::memcpy(&p.lowerWord, code + pc, 4u);
+        std::memcpy(&p.upperWord, code + pc + 4u, 4u);
+        const uint32_t upper = p.upperWord;
+        if (upper & 0x80000000u)
+            p.flags |= PfIBit;
+        if (upper & 0x40000000u)
+            p.flags |= PfEBit;
+        if (upper & 0x10000000u)
+            p.flags |= PfDBit;
+        if (upper & 0x08000000u)
+            p.flags |= PfTBit;
+
+        decodeUpper(e, p, upper, (pc / 8u) & (kMaxPairs - 1u));
+        uint8_t loReads = 0;
+        uint8_t loReadRegs[2] = {};
+        if (p.flags & PfIBit)
+            p.lower = &lowerLoi;
+        else
+            decodeLower(p, p.lowerWord, loReads, loReadRegs);
+
+        if (p.upTarget == UtVf && p.upReg != 0u)
+        {
+            bool shadow = p.loWriteReg == p.upReg;
+            for (uint32_t i = 0; i < loReads; ++i)
+                shadow = shadow || loReadRegs[i] == p.upReg;
+            if (shadow)
+                p.flags |= PfShadow;
+        }
+    }
+
+    // Lanes of `reg` the pair writes with an interlock (VF only; ACC never stalls).
+    uint8_t vfWriteLanes(const Pair &p, uint8_t reg)
+    {
+        uint8_t lanes = 0u;
+        if (p.upTarget == UtVf && p.upReg == reg)
+            lanes |= p.dest;
+        if (p.loWriteReg == reg)
+            lanes |= p.loWriteLanes;
+        return lanes;
+    }
+
+    void decodePair(const Engine &e, Pair &p, const uint8_t *code, uint32_t pc)
+    {
+        decodePairCore(e, p, code, pc);
+        if (pc < 24u || (p.flags & PfReserved))
+            return;
+        for (uint32_t back = 1u; back <= 3u; ++back)
+        {
+            Pair previous;
+            decodePairCore(e, previous, code, pc - 8u * back);
+            for (uint32_t i = 0; i < p.readCount; ++i)
+                if (vfWriteLanes(previous, p.readReg[i]) & p.readLanes[i])
+                    return;
+            if (previous.viWriteReg != 0u && (p.viReads & (1u << previous.viWriteReg)))
+                return;
+        }
+        p.flags |= PfNoHazard;
+    }
+
+    // Whether the upper instruction is FMAC arithmetic that sets the MAC/status flags.
+    bool upperWritesMacFlags(uint32_t upper)
+    {
+        if (DEST(upper) == 0u)
+            return false;
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        const bool special = op >= 0x3Cu;
+        const uint8_t code = special ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+        Arith arith = AAdd;
+        Operand operand = OVec;
+        return (special || op <= 0x2Fu) && upperArithKind(code, special, arith, operand) && arith != AMax &&
+               arith != AMini;
+    }
+
+    // Finds the FMAC instructions whose flags a reader (FSxx / FMxx) can observe; the engine
+    // computes flags for those only.
+    //
+    // A reader sees the flags of the last FMAC instruction issued at least four cycles before
+    // it. Walking back from a reader along every way execution can reach it, an FMAC
+    // instruction fewer than four pairs away may be that one (a stall lets it complete), and
+    // from four pairs on the first one found is, and hides everything before it. An indirect
+    // jump can lead to any pair, so every JR/JALR delay slot counts as running right before a
+    // reader. The end of a program drains the flag pipeline, so its last FMAC instruction
+    // stays visible to whatever runs next.
+    //
+    // The sticky status bits accumulate over every FMAC instruction: code that reads them
+    // (FSEQ, FSOR, FSAND with bits 6-9) gets flags everywhere. PS2X_VU1_ALL_FLAGS=1 forces
+    // that for all code with a reader.
+    void analyzeFlagDemand(CodeImage &image, const uint8_t *code)
+    {
+        constexpr uint32_t kPairMask = kMaxPairs - 1u;
+        constexpr uint8_t kNoDemand = 5u;
+        image.needFlags.assign(kMaxPairs, 0u);
+        image.flagTracking = ps2vu1fast::FlagsNone;
+
+        std::vector<uint8_t> writer(kMaxPairs, 0u);
+        std::vector<uint8_t> demand(kMaxPairs, kNoDemand); // pairs between this one and a reader after it
+        std::vector<std::vector<uint16_t>> branchesTo(kMaxPairs); // delay slots of the static branches to a pair
+        std::vector<uint32_t> work;
+        const auto raise = [&](uint32_t pair, uint8_t distance)
+        {
+            if (distance < demand[pair])
+            {
+                demand[pair] = distance;
+                work.push_back(pair);
+            }
+        };
+
+        std::vector<uint32_t> readers;
+        bool sticky = false;
+        for (uint32_t index = 0; index < kMaxPairs; ++index)
+        {
+            uint32_t lower = 0, upper = 0;
+            std::memcpy(&lower, code + index * 8u, 4u);
+            std::memcpy(&upper, code + index * 8u + 4u, 4u);
+            writer[index] = upperWritesMacFlags(upper) ? 1u : 0u;
+            if (upper & 0x40000000u)
+                raise((index + 1u) & kPairMask, 4u); // the pair after the E bit ends the program
+            if (upper & 0x80000000u)
+                continue; // the lower word is the I register's value
+            const uint32_t op = (lower >> 25) & 0x7Fu;
+            switch (op)
+            {
+            case 0x16u: // FSAND
+                readers.push_back(index);
+                sticky = sticky || ((((lower >> 21) & 0x1u) << 11 | (lower & 0x7FFu)) & 0x3C0u) != 0u;
+                break;
+            case 0x14u: // FSEQ
+            case 0x17u: // FSOR
+                readers.push_back(index);
+                sticky = true;
+                break;
+            case 0x18u: // FMEQ
+            case 0x1Au: // FMAND
+            case 0x1Bu: // FMOR
+                readers.push_back(index);
+                break;
+            case 0x20u: // B
+            case 0x21u: // BAL
+            case 0x28u: // IBEQ
+            case 0x29u: // IBNE
+            case 0x2Cu: // IBLTZ
+            case 0x2Du: // IBGTZ
+            case 0x2Eu: // IBLEZ
+            case 0x2Fu: // IBGEZ
+                branchesTo[(index + 1u + static_cast<uint32_t>(IMM11(lower))) & kPairMask].push_back(
+                    static_cast<uint16_t>((index + 1u) & kPairMask));
+                break;
+            case 0x24u: // JR
+            case 0x25u: // JALR
+                raise((index + 1u) & kPairMask, 1u);
+                break;
+            default:
+                break;
+            }
+        }
+        if (readers.empty())
+            return;
+
+        static const bool allFlags = std::getenv("PS2X_VU1_ALL_FLAGS") != nullptr;
+        if (sticky || allFlags)
+        {
+            image.flagTracking = ps2vu1fast::FlagsAll;
+            image.needFlags.assign(kMaxPairs, 1u);
+            return;
+        }
+
+        image.flagTracking = ps2vu1fast::FlagsObserved;
+        // What can run right before a pair: the pair in front of it, and the delay slot of
+        // every static branch to it.
+        const auto forEachPredecessor = [&](uint32_t pair, uint8_t distance)
+        {
+            raise((pair - 1u) & kPairMask, distance);
+            for (const uint16_t delaySlot : branchesTo[pair])
+                raise(delaySlot, distance);
+        };
+        for (const uint32_t reader : readers)
+            forEachPredecessor(reader, 1u);
+        while (!work.empty())
+        {
+            const uint32_t pair = work.back();
+            work.pop_back();
+            const uint8_t distance = demand[pair];
+            if (writer[pair])
+            {
+                image.needFlags[pair] = 1u;
+                if (distance >= 4u)
+                    continue;
+            }
+            forEachPredecessor(pair, static_cast<uint8_t>(std::min<uint32_t>(distance + 1u, 4u)));
+        }
+    }
+
+    uint64_t hashCode(const uint8_t *code)
+    {
+        uint64_t hash = 0x9E3779B97F4A7C15ull;
+        for (uint32_t offset = 0; offset < kCodeBytes; offset += 8u)
+        {
+            uint64_t word = 0;
+            std::memcpy(&word, code + offset, 8u);
+            hash = (hash ^ word) * 0xFF51AFD7ED558CCDull;
+            hash ^= hash >> 32;
+        }
+        return hash;
+    }
+
+    // Switches to the decoded (and compiled) code of the current code memory image.
+    void selectImage(Engine &e, const uint8_t *code)
+    {
+        constexpr size_t kMaxImages = 32u;
+        const uint64_t hash = hashCode(code);
+        CodeImage *found = nullptr;
+        for (const std::unique_ptr<CodeImage> &image : e.images)
+        {
+            if (image->hash == hash && std::memcmp(image->bytes.data(), code, kCodeBytes) == 0)
+            {
+                found = image.get();
+                break;
+            }
+        }
+        if (!found)
+        {
+            if (e.images.size() >= kMaxImages)
+            {
+                auto oldest = std::min_element(e.images.begin(), e.images.end(), [](const auto &a, const auto &b)
+                                               { return a->lastUse < b->lastUse; });
+                e.images.erase(oldest);
+            }
+            auto image = std::make_unique<CodeImage>();
+            image->hash = hash;
+            image->bytes.assign(code, code + kCodeBytes);
+            image->epoch = ++e.imageEpochs;
+            analyzeFlagDemand(*image, code);
+            found = image.get();
+            e.images.push_back(std::move(image));
+
+            // PS2X_VU1_DUMP_IMAGES=1 writes every new code image to runs/vu1_image_<n>.bin.
+            static const bool dumpImages = std::getenv("PS2X_VU1_DUMP_IMAGES") != nullptr;
+            static uint32_t dumpedImages = 0u;
+            if (dumpImages && dumpedImages < 64u)
+            {
+                const std::string path = "runs/vu1_image_" + std::to_string(dumpedImages++) + ".bin";
+                if (std::FILE *file = std::fopen(path.c_str(), "wb"))
+                {
+                    std::fwrite(code, 1u, kCodeBytes, file);
+                    std::fclose(file);
+                }
+            }
+        }
+        found->lastUse = ++e.imageClock;
+        e.image = found;
+#if PS2X_VU1_JIT
+        e.jitSlots = found->slots.data();
+#endif
+        e.pairs = found->pairs.get();
+        e.epoch = found->epoch;
+        e.needFlags = found->needFlags.data();
+    }
+
+    void syncCode(Engine &e, const uint8_t *code, PS2Memory *memory)
+    {
+        const uint64_t generation = memory ? memory->getVU1CodeGeneration() : kNever - 1u;
+        if (memory && generation == e.decodedGeneration && code == e.decodedCode)
+            return;
+        e.decodedGeneration = generation;
+        e.decodedCode = code;
+        selectImage(e, code);
+
+        static const bool counted = std::getenv("PS2X_VIF_STATS") != nullptr;
+        if (counted)
+        {
+            // How the code changes between runs (decides how compiled code is cached).
+            static std::vector<uint8_t> previous(kCodeBytes, 0u);
+            static std::unordered_map<uint64_t, uint32_t> images;
+            ps2vu1fast::Stats &totals = ps2vu1fast::stats();
+            ++totals.codeChanges;
+            uint64_t hash = 1469598103934665603ull;
+            for (uint32_t pc = 0; pc < kCodeBytes; pc += 8u)
+            {
+                uint64_t word = 0;
+                std::memcpy(&word, code + pc, 8u);
+                if (std::memcmp(previous.data() + pc, code + pc, 8u) != 0)
+                    ++totals.changedPairs;
+                hash = (hash ^ word) * 1099511628211ull;
+                hash ^= hash >> 29;
+            }
+            std::memcpy(previous.data(), code, kCodeBytes);
+            if (images.emplace(hash, 0u).second)
+                totals.distinctImages = images.size();
+        }
+    }
+
+#if PS2X_VU1_JIT
+#include "ps2_vu1_jit.inl"
+#endif
+
+    // A reserved instruction stops the program, like the reference interpreter.
+    // PS2X_VU1_RESERVED_DUMP=1 also prints where the run started and the VI registers,
+    // and writes the code and data memory of the first few distinct code images that
+    // do it to runs/vu1_reserved_<n>_{code,data}.bin.
+    void reportReserved(Engine &e, bool upper, uint32_t instruction)
+    {
+        if (!e.reservedReported)
+        {
+            std::fprintf(stderr, "[VU1 fast reserved %s] pc=0x%x instruction=0x%x\n",
+                         upper ? "upper" : "lower", e.st->pc, instruction);
+            e.reservedReported = true;
+
+            static const bool dump = std::getenv("PS2X_VU1_RESERVED_DUMP") != nullptr;
+            static std::vector<uint64_t> dumped;
+            if (dump && e.image && dumped.size() < 6u &&
+                std::find(dumped.begin(), dumped.end(), e.image->hash) == dumped.end())
+            {
+                dumped.push_back(e.image->hash);
+                const uint32_t pc = e.st->pc;
+                uint32_t pair[2] = {};
+                std::memcpy(pair, e.image->bytes.data() + (pc & (kCodeBytes - 8u)), sizeof(pair));
+                std::fprintf(stderr, "[VU1 fast reserved]   image %zu: run started at 0x%x, pair lower=%08x upper=%08x, "
+                                     "last XGKICK from 0x%x, vi:",
+                             dumped.size(), e.runStartPc, pair[0], pair[1], e.kickSource);
+                for (int reg = 0; reg < 16; ++reg)
+                    std::fprintf(stderr, " %x", static_cast<unsigned>(e.st->vi[reg]) & 0xFFFFu);
+                std::fprintf(stderr, "\n");
+                if (e.decodedCode)
+                {
+                    uint32_t live[2] = {};
+                    std::memcpy(live, e.decodedCode + (pc & (kCodeBytes - 8u)), sizeof(live));
+                    uint32_t differing = 0u;
+                    for (uint32_t at = 0; at < kCodeBytes; at += 8u)
+                        differing += std::memcmp(e.decodedCode + at, e.image->bytes.data() + at, 8u) != 0 ? 1u : 0u;
+                    std::fprintf(stderr, "[VU1 fast reserved]   live pair lower=%08x upper=%08x, %u pairs differ from the image, "
+                                         "generation %llu (decoded %llu)\n",
+                                 live[0], live[1], differing,
+                                 static_cast<unsigned long long>(e.memory ? e.memory->getVU1CodeGeneration() : 0u),
+                                 static_cast<unsigned long long>(e.decodedGeneration));
+                }
+                const std::string base = "runs/vu1_reserved_" + std::to_string(dumped.size());
+                if (std::FILE *file = std::fopen((base + "_code.bin").c_str(), "wb"))
+                {
+                    std::fwrite(e.image->bytes.data(), 1u, e.image->bytes.size(), file);
+                    std::fclose(file);
+                }
+                if (std::FILE *file = std::fopen((base + "_data.bin").c_str(), "wb"))
+                {
+                    std::fwrite(e.data, 1u, static_cast<size_t>(e.dataMask) + 1u, file);
+                    std::fclose(file);
+                }
+            }
+        }
+        *e.stop = true;
+    }
