+
+static void reportVerifiedRun(uint32_t startPc, const VU1State &reference, const VU1State &fast,
+                              uint64_t referenceCycles, uint64_t fastCycles,
+                              const uint8_t *referenceData, const uint8_t *fastData, uint32_t dataSize,
+                              const std::vector<uint8_t> &referencePackets, const std::vector<uint8_t> &fastPackets,
+                              ps2vu1fast::FlagTracking flagTracking)
+{
+    static uint64_t runs = 0u, mismatches = 0u, timingMismatches = 0u;
+    static uint32_t reports = 0u;
+    static auto windowStart = std::chrono::steady_clock::now();
+    ++runs;
+
+    char detail[512];
+    int length = 0;
+    const auto note = [&](const char *format, auto... args)
+    {
+        if (length < static_cast<int>(sizeof(detail)) - 1)
+            length += std::snprintf(detail + length, sizeof(detail) - static_cast<size_t>(length), format, args...);
+    };
+    for (uint32_t reg = 1; reg < 32u; ++reg)
+        if (std::memcmp(reference.vf[reg], fast.vf[reg], sizeof(reference.vf[reg])) != 0)
+            note(" vf%02u(%g %g %g %g|%g %g %g %g)", reg, reference.vf[reg][0], reference.vf[reg][1], reference.vf[reg][2],
+                 reference.vf[reg][3], fast.vf[reg][0], fast.vf[reg][1], fast.vf[reg][2], fast.vf[reg][3]);
+    for (uint32_t reg = 1; reg < 16u; ++reg)
+        if (reference.vi[reg] != fast.vi[reg])
+            note(" vi%02u(%x|%x)", reg, reference.vi[reg], fast.vi[reg]);
+    if (std::memcmp(reference.acc, fast.acc, sizeof(reference.acc)) != 0)
+        note(" acc");
+    if (std::memcmp(&reference.q, &fast.q, sizeof(float)) != 0)
+        note(" q(%g|%g)", reference.q, fast.q);
+    if (std::memcmp(&reference.p, &fast.p, sizeof(float)) != 0)
+        note(" p(%g|%g)", reference.p, fast.p);
+    if (std::memcmp(&reference.i, &fast.i, sizeof(float)) != 0)
+        note(" i");
+    if (reference.r != fast.r)
+        note(" r");
+    if (reference.clip != fast.clip)
+        note(" clip(%x|%x)", reference.clip, fast.clip);
+    // The D/I bits are always tracked; the sticky Z/S/U/O bits only when every FMAC
+    // instruction computes its flags.
+    const uint32_t statusMask = flagTracking == ps2vu1fast::FlagsAll ? 0xFFFu
+                                : flagTracking == ps2vu1fast::FlagsObserved ? 0xC3Fu : 0xC30u;
+    if ((reference.status & statusMask) != (fast.status & statusMask))
+        note(" status(%x|%x)", reference.status, fast.status);
+    if (flagTracking != ps2vu1fast::FlagsNone && reference.mac != fast.mac)
+        note(" mac(%x|%x)", reference.mac, fast.mac);
+    if (reference.pc != fast.pc || reference.ebit != fast.ebit || reference.branchPending != fast.branchPending ||
+        reference.haltAfterDelaySlot != fast.haltAfterDelaySlot)
+        note(" pc(%x|%x)", reference.pc, fast.pc);
+    for (uint32_t offset = 0; offset < dataSize; offset += 16u)
+    {
+        if (std::memcmp(referenceData + offset, fastData + offset, 16u) != 0)
+        {
+            note(" mem@%03x", offset / 16u);
+            break;
+        }
+    }
+    if (referencePackets != fastPackets)
+    {
+        size_t at = 0;
+        while (at < referencePackets.size() && at < fastPackets.size() && referencePackets[at] == fastPackets[at])
+            ++at;
+        note(" packets(%zu|%zu bytes, first difference at %zu)", referencePackets.size(), fastPackets.size(), at);
+    }
+
+    const bool mismatch = length > 0;
+    const bool timing = referenceCycles != fastCycles;
+    mismatches += mismatch ? 1u : 0u;
+    timingMismatches += timing ? 1u : 0u;
+    if ((mismatch || timing) && reports < 40u)
+    {
+        ++reports;
+        std::fprintf(stderr, "[vu1:verify] run from pc=%04x: cycles %llu|%llu%s\n", startPc,
+                     static_cast<unsigned long long>(referenceCycles), static_cast<unsigned long long>(fastCycles),
+                     mismatch ? detail : " (state matches)");
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - windowStart >= std::chrono::seconds(2))
+    {
+        std::fprintf(stderr, "[vu1:verify] %llu runs, %llu with state differences, %llu with cycle differences\n",
+                     static_cast<unsigned long long>(runs), static_cast<unsigned long long>(mismatches),
+                     static_cast<unsigned long long>(timingMismatches));
+        windowStart = now;
+    }
+}
