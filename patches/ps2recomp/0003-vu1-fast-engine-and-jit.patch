+
+    // Copies `qwords` from data memory at `qword` (wrapping like XGKICK) into `out`.
+    void copyPacket(const uint8_t *data, uint32_t dataMask, uint32_t qword, uint32_t qwords, std::vector<uint8_t> &out)
+    {
+        const uint32_t bytes = qwords * 16u;
+        const uint32_t start = (qword * 16u) & dataMask;
+        out.resize(bytes);
+        for (uint32_t done = 0; done < bytes;)
+        {
+            const uint32_t source = (start + done) & dataMask;
+            const uint32_t chunk = std::min(bytes - done, dataMask + 1u - source);
+            std::memcpy(out.data() + done, data + source, chunk);
+            done += chunk;
+        }
+    }
+
+    void nativeSend(void *context, uint32_t qword, uint32_t qwords)
+    {
+        Engine &e = *static_cast<Engine *>(context);
+        copyPacket(e.data, e.dataMask, qword, qwords, e.kickPacket);
+        submitKickPacket(e, qwords * 16u);
+    }
+
+    // A packet from outside VU memory (a native mesh, runtime/gs/gs_native_mesh.h), over PATH1.
+    void nativeSendBytes(void *context, const uint8_t *data, uint32_t bytes)
+    {
+        Engine &e = *static_cast<Engine *>(context);
+        e.kickPacket.assign(data, data + bytes);
+        submitKickPacket(e, bytes);
+    }
+
+    // PS2X_VU1_NATIVE=check: the hook's run on copies, to be compared with the microcode's.
+    struct NativeCheck
+    {
+        VU1State state{};
+        std::vector<uint8_t> data;
+        std::vector<uint8_t> packets; // each with its size first, as g_batchPackets
+        uint32_t dataMask = 0;
+        uint64_t runs = 0, packetDifferences = 0, memoryDifferences = 0, pcDifferences = 0, registerDifferences = 0;
+        int reports = 0;
+    };
+
+    NativeCheck &nativeCheck()
+    {
+        static NativeCheck check;
+        return check;
+    }
+
+    void nativeCheckSend(void *context, uint32_t qword, uint32_t qwords)
+    {
+        NativeCheck &check = *static_cast<NativeCheck *>(context);
+        std::vector<uint8_t> packet;
+        copyPacket(check.data.data(), check.dataMask, qword, qwords, packet);
+        const uint32_t size = qwords * 16u;
+        const uint8_t *sizeBytes = reinterpret_cast<const uint8_t *>(&size);
+        check.packets.insert(check.packets.end(), sizeBytes, sizeBytes + 4u);
+        check.packets.insert(check.packets.end(), packet.begin(), packet.end());
+    }
+
+    void compareNativeRun(const VU1State &state, const uint8_t *data, uint32_t dataSize,
+                          const std::vector<uint8_t> &microcodePackets, uint32_t startPc, uint32_t itop)
+    {
+        NativeCheck &check = nativeCheck();
+        static const int reportLimit = []()
+        {
+            const char *env = std::getenv("PS2X_VU1_NATIVE_REPORT");
+            return env ? std::atoi(env) : 8;
+        }();
+        ++check.runs;
+        const bool packetsDiffer = check.packets != microcodePackets;
+        uint32_t firstMemory = ~0u;
+        for (uint32_t offset = 0; offset < dataSize; offset += 4u)
+        {
+            if (std::memcmp(check.data.data() + offset, data + offset, 4u) != 0)
+            {
+                firstMemory = offset;
+                break;
+            }
+        }
+        const bool pcDiffers = check.state.pc != state.pc;
+        // The registers a later run of the game's microcode reads before writing
+        // (tools/vu1_liveness.py): the routine count, 0x0480's stack pointer, field A's matrix.
+        const bool registersDiffer = check.state.vi[13] != state.vi[13] || check.state.vi[14] != state.vi[14] ||
+                                     std::memcmp(check.state.vf[1], state.vf[1], sizeof(float) * 16u) != 0;
+        check.packetDifferences += packetsDiffer ? 1u : 0u;
+        check.memoryDifferences += firstMemory != ~0u ? 1u : 0u;
+        check.pcDifferences += pcDiffers ? 1u : 0u;
+        check.registerDifferences += registersDiffer ? 1u : 0u;
+        if ((packetsDiffer || firstMemory != ~0u || pcDiffers || registersDiffer) && check.reports < reportLimit)
+        {
+            ++check.reports;
+            size_t at = 0;
+            while (at < check.packets.size() && at < microcodePackets.size() && check.packets[at] == microcodePackets[at])
+                ++at;
+            std::fprintf(stderr,
+                         "[vu1:native] run from pc %04x, ITOP q%x: packets %zu|%zu bytes%s (first difference at %zu), "
+                         "memory %s, end pc %04x|%04x, vi13 %d|%d, vi14 %d|%d%s\n",
+                         startPc, itop, check.packets.size(), microcodePackets.size(), packetsDiffer ? " DIFFER" : " match",
+                         at, firstMemory == ~0u ? "matches" : "DIFFERS", check.state.pc, state.pc, check.state.vi[13],
+                         state.vi[13], check.state.vi[14], state.vi[14], registersDiffer ? " (registers DIFFER)" : "");
+            if (firstMemory != ~0u)
+            {
+                const uint32_t q = firstMemory / 16u;
+                const uint32_t *mine = reinterpret_cast<const uint32_t *>(check.data.data() + q * 16u);
+                const uint32_t *theirs = reinterpret_cast<const uint32_t *>(data + q * 16u);
+                std::fprintf(stderr, "[vu1:native]   first memory difference q%x: %08x %08x %08x %08x | %08x %08x %08x %08x\n", q,
+                             mine[0], mine[1], mine[2], mine[3], theirs[0], theirs[1], theirs[2], theirs[3]);
+            }
+        }
+        static auto since = std::chrono::steady_clock::now();
+        const auto now = std::chrono::steady_clock::now();
+        if (now - since >= std::chrono::seconds(2))
+        {
+            since = now;
+            std::fprintf(stderr,
+                         "[vu1:native] check: %llu runs done natively, packets differ in %llu, memory in %llu, end pc in %llu, "
+                         "registers in %llu\n",
+                         static_cast<unsigned long long>(check.runs), static_cast<unsigned long long>(check.packetDifferences),
+                         static_cast<unsigned long long>(check.memoryDifferences),
+                         static_cast<unsigned long long>(check.pcDifferences),
+                         static_cast<unsigned long long>(check.registerDifferences));
+        }
+    }
+
+    // PS2X_VU1_ROUTINES=1 (debugging aid). The game's microcode starts with a dispatcher that
+    // runs, for the batch at ITOP, the routines listed from data qword 5 on (q4.x of them, each
+    // with a data block in .y), or one of four fixed paths for the batch type in the header's
+    // y. Every 2 s: by code image, start pc, batch type and routine list, the batches,
+    // vertices (header x), instruction pairs and XGKICK bytes a second.
+    struct RoutineKey
+    {
+        uint64_t image = 0;
+        std::array<uint16_t, 16> fields{}; // start pc, type, count, then routine/block pairs
+        bool operator<(const RoutineKey &other) const
+        {
+            return std::tie(image, fields) < std::tie(other.image, other.fields);
+        }
+    };
+
+    struct RoutineTotals
+    {
+        uint64_t batches = 0, vertices = 0, pairs = 0, bytes = 0;
+    };
+
+    RoutineKey routineKey(const Engine &e, const VU1State &state, const uint8_t *data, uint32_t dataSize,
+                          uint32_t &vertices)
+    {
+        const auto word = [&](uint32_t qword, uint32_t lane)
+        {
+            uint32_t value = 0;
+            std::memcpy(&value, data + ((qword * 16u + lane * 4u) & (dataSize - 1u)), 4u);
+            return value;
+        };
+        RoutineKey key;
+        key.image = e.image ? e.image->hash : 0u;
+        const uint32_t header = state.itop & 0x3FFu;
+        vertices = word(header, 0) & 0x7FFFu;
+        const uint32_t count = word(4, 0) & 0xFFFFu;
+        key.fields[0] = static_cast<uint16_t>(state.pc);
+        key.fields[1] = static_cast<uint16_t>(word(header, 1));
+        key.fields[2] = static_cast<uint16_t>(count);
+        for (uint32_t k = 0; k < count && k < 6u; ++k)
+        {
+            key.fields[3u + 2u * k] = static_cast<uint16_t>((word(5u + k, 0) & 0x7FFu) * 8u);
+            key.fields[4u + 2u * k] = static_cast<uint16_t>(word(5u + k, 1));
+        }
+        return key;
+    }
+
+    // "1410/q35 0480/qd": the routine table of a batch kind, as both options write it.
+    std::string routineText(const RoutineKey &key)
+    {
+        std::string text;
+        char item[16];
+        for (uint32_t r = 0; r < key.fields[2] && r < 6u; ++r)
+        {
+            std::snprintf(item, sizeof(item), "%s%04x/q%x", r ? " " : "", key.fields[3u + 2u * r], key.fields[4u + 2u * r]);
+            text += item;
+        }
+        return text;
+    }
+
+    // PS2X_VU1_CAPTURE=<routine table>[@<image>][#<type>][:<count>] (debugging aid): the first
+    // batches (8 unless given) whose routine table reads like that ("1410/q35 0480/qd", as
+    // PS2X_VU1_ROUTINES prints it) - of an image whose hash starts with <image> (hex), of batch
+    // type <type> (hex), if given - are saved to runs/vu1_batch_<n>.bin for tools/vu1_batch.py:
+    // VU1's registers and data memory before the batch, both again after it, and the packets
+    // it sent.
+    struct BatchCapture
+    {
+        std::string routines;
+        std::string image; // a prefix of the image's hash in hex, or empty
+        int type = -1;     // the batch type, or -1
+        int left = 0;
+        int written = 0;
+
+        bool matches(const RoutineKey &key, const std::string &text) const
+        {
+            if (left <= 0 || text != routines || (type >= 0 && key.fields[1] != static_cast<uint16_t>(type)))
+                return false;
+            char hash[17];
+            std::snprintf(hash, sizeof(hash), "%016llx", static_cast<unsigned long long>(key.image));
+            return image.empty() || std::string(hash).compare(0, image.size(), image) == 0;
+        }
+    };
+
+    BatchCapture &batchCapture()
+    {
+        static BatchCapture capture = []()
+        {
+            BatchCapture spec;
+            if (const char *env = std::getenv("PS2X_VU1_CAPTURE"))
+            {
+                spec.routines = env;
+                spec.left = 8;
+                const size_t colon = spec.routines.rfind(':');
+                if (colon != std::string::npos)
+                {
+                    spec.left = std::atoi(spec.routines.c_str() + colon + 1);
+                    spec.routines.resize(colon);
+                }
+                const size_t hash = spec.routines.rfind('#');
+                if (hash != std::string::npos)
+                {
+                    spec.type = static_cast<int>(std::strtol(spec.routines.c_str() + hash + 1, nullptr, 16));
+                    spec.routines.resize(hash);
+                }
+                const size_t at = spec.routines.rfind('@');
+                if (at != std::string::npos)
+                {
+                    spec.image = spec.routines.substr(at + 1);
+                    spec.routines.resize(at);
+                }
+            }
+            return spec;
+        }();
+        return capture;
+    }
+
+    void appendRegisters(std::vector<uint8_t> &out, const VU1State &state)
+    {
+        const auto put = [&](const void *data, size_t size)
+        {
+            const uint8_t *bytes = static_cast<const uint8_t *>(data);
+            out.insert(out.end(), bytes, bytes + size);
+        };
+        put(state.vf, sizeof(state.vf));
+        put(state.vi, sizeof(state.vi));
+        put(state.acc, sizeof(state.acc));
+        put(&state.q, 4u);
+        put(&state.p, 4u);
+        put(&state.i, 4u);
+        put(&state.status, 4u);
+        put(&state.mac, 4u);
+        put(&state.clip, 4u);
+    }
+
+    // The file: "VU1B", version 2, image hash, start pc, ITOP, TOP, the routine table (64
+    // bytes of text); registers before (vf, vi, acc, q, p, i, status, mac, clip: 616 bytes),
+    // data memory before; registers and data memory after; the code (16 KB); the packets,
+    // each with its size.
+    void writeBatch(const Engine &e, const VU1State &state, const std::string &routines, uint32_t startPc,
+                    uint32_t itop, uint32_t top, const std::vector<uint8_t> &before, const uint8_t *data,
+                    uint32_t dataSize, const uint8_t *code, const std::vector<uint8_t> &packets)
+    {
+        BatchCapture &capture = batchCapture();
+        std::vector<uint8_t> out;
+        const auto put = [&](const void *bytes, size_t size)
+        {
+            const uint8_t *p = static_cast<const uint8_t *>(bytes);
+            out.insert(out.end(), p, p + size);
+        };
+        const uint32_t version = 2u;
+        const uint64_t hash = e.image ? e.image->hash : 0u;
+        put("VU1B", 4u);
+        put(&version, 4u);
+        put(&hash, 8u);
+        put(&startPc, 4u);
+        put(&itop, 4u);
+        put(&top, 4u);
+        char text[64] = {};
+        std::snprintf(text, sizeof(text), "%s", routines.c_str());
+        put(text, sizeof(text));
+        out.insert(out.end(), before.begin(), before.end());
+        appendRegisters(out, state);
+        put(data, dataSize);
+        put(code, kCodeBytes);
+        out.insert(out.end(), packets.begin(), packets.end());
+        const std::string path = "runs/vu1_batch_" + std::to_string(capture.written++) + ".bin";
+        if (std::FILE *file = std::fopen(path.c_str(), "wb"))
+        {
+            std::fwrite(out.data(), 1u, out.size(), file);
+            std::fclose(file);
+        }
+    }
+
+    void countRoutines(const RoutineKey &key, uint32_t vertices, uint64_t pairs, uint64_t bytes)
+    {
+        static std::map<RoutineKey, RoutineTotals> totals;
+        static auto since = std::chrono::steady_clock::now();
+        RoutineTotals &entry = totals[key];
+        ++entry.batches;
+        entry.vertices += vertices;
+        entry.pairs += pairs;
+        entry.bytes += bytes;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - since < std::chrono::seconds(2))
+            return;
+        std::vector<std::pair<RoutineKey, RoutineTotals>> sorted(totals.begin(), totals.end());
+        std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.second.pairs > b.second.pairs; });
+        uint64_t all = 0u;
+        for (const auto &item : sorted)
+            all += item.second.pairs;
+        const double seconds = std::chrono::duration<double>(now - since).count();
+        std::fprintf(stderr, "[vu1:routines] %.1fM pairs a second in %zu kinds of batch; the most run:\n",
+                     all / seconds / 1.0e6, sorted.size());
+        for (size_t i = 0; i < sorted.size() && i < 24u; ++i)
+        {
+            const RoutineKey &k = sorted[i].first;
+            const RoutineTotals &t = sorted[i].second;
+            const std::string routines = routineText(k);
+            std::fprintf(stderr,
+                         "[vu1:routines]   %5.1f%% image %016llx pc %04x type %u routines %s: %.0f batches/s, %.1f vertices "
+                         "a batch, %.1fM pairs/s, %.0f pairs a vertex, %.1f MB/s packets\n",
+                         100.0 * static_cast<double>(t.pairs) / static_cast<double>(std::max<uint64_t>(all, 1u)),
+                         static_cast<unsigned long long>(k.image), k.fields[0], k.fields[1], routines.c_str(),
+                         t.batches / seconds, static_cast<double>(t.vertices) / static_cast<double>(std::max<uint64_t>(t.batches, 1u)),
+                         t.pairs / seconds / 1.0e6,
+                         static_cast<double>(t.pairs) / static_cast<double>(std::max<uint64_t>(t.vertices, 1u)),
+                         t.bytes / seconds / 1.0e6);
+        }
+        totals.clear();
+        since = now;
+    }
+}
+
+namespace ps2vu1native
+{
+    void setHook(Hook hook) { g_nativeHook = hook; }
+
+    namespace
+    {
+        std::atomic<bool> g_meshesWanted{false};
+    }
+    void setMeshesWanted(bool wanted) { g_meshesWanted.store(wanted, std::memory_order_relaxed); }
+    bool meshesWanted() { return g_meshesWanted.load(std::memory_order_relaxed); }
+}
+
+namespace ps2vu1fast
+{
+    Mode mode()
+    {
+        static const Mode selected = []()
+        {
+            const auto enabled = [](const char *name)
+            {
+                const char *value = std::getenv(name);
+                return value && *value && *value != '0';
+            };
+            if (enabled("PS2X_VU1_VERIFY"))
+                return Mode::Verify;
+            if (enabled("PS2X_VU1_REFERENCE") || enabled("PS2X_VU1_TRACE"))
+                return Mode::Reference;
+            return Mode::Fast;
+        }();
+        return selected;
+    }
+
+    Stats &stats()
+    {
+        static Stats totals;
+        return totals;
+    }
+
+    void resetPipelines(const void *owner, const VU1State &state)
+    {
+        clearPipelines(engineFor(owner), state.clip);
+    }
+
+    FlagTracking flagTracking(const void *owner)
+    {
+        const Engine &e = engineFor(owner);
+        return e.image ? static_cast<FlagTracking>(e.image->flagTracking) : FlagsNone;
+    }
+
+    void run(const void *owner, VU1State &state, uint64_t &cycle, bool &stopRequested,
+             const uint8_t *code, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+             GS &gs, PS2Memory *memory, uint32_t maxCycles, std::vector<uint8_t> *capture)
+    {
+        Engine &e = engineFor(owner);
+        e.st = &state;
+        e.data = data;
+        e.dataMask = dataSize - 1u;
+        e.cycle = cycle;
+        e.gs = &gs;
+        e.memory = memory;
+        e.capture = capture;
+        e.stop = &stopRequested;
+        // Interlock cycles are 32-bit, relative to cycleBase: rebase long before they wrap.
+        if (e.cycle - e.cycleBase > 0x40000000u)
+        {
+            const uint64_t delta = e.cycle - e.cycleBase;
+            const uint32_t shift = static_cast<uint32_t>(std::min<uint64_t>(delta, 0xFFFFFFFFu));
+            const __m128i shiftLanes = _mm_set1_epi32(static_cast<int>(shift));
+            for (__m128i &lanes : e.vfReady)
+                lanes = _mm_sub_epi32(_mm_max_epu32(lanes, shiftLanes), shiftLanes);
+            for (uint32_t &ready : e.viReady)
+                ready = ready > shift ? ready - shift : 0u;
+            e.cycleBase = e.cycle;
+        }
+        syncCode(e, code, memory);
+        if (e.cycle >= e.nextEvent)
+            commitEvents(e, e.cycle);
+        e.runStartPc = state.pc;
+        e.kickBytesLog = SIZE_MAX; // VU memory may have been written between runs
+        static const bool routineStats = std::getenv("PS2X_VU1_ROUTINES") != nullptr;
+        RoutineKey batchKind;
+        uint32_t batchVertices = 0u;
+        const uint64_t batchBytes = g_ps2Vu1XgkickBytes;
+        if (routineStats || batchCapture().left > 0)
+            batchKind = routineKey(e, state, data, dataSize, batchVertices);
+        // PS2X_VU1_CAPTURE: the state before the batch, and its packets.
+        std::vector<uint8_t> capturedBefore, capturedPackets;
+        const bool capturing = batchCapture().left > 0 && batchCapture().matches(batchKind, routineText(batchKind));
+        const uint32_t capturedPc = state.pc, capturedItop = state.itop, capturedTop = state.top;
+        if (capturing)
+        {
+            appendRegisters(capturedBefore, state);
+            capturedBefore.insert(capturedBefore.end(), data, data + dataSize);
+            g_batchPackets = &capturedPackets;
+        }
+
+        const VuFloatMode floatMode;
+
+        // A program the game does itself (ps2vu1native) - not in PS2X_VU1_VERIFY's comparison
+        // run (`capture`), which checks the microcode engines.
+        std::vector<uint8_t> microcodePackets;
+        bool nativeChecked = false;
+        if (g_nativeHook && nativeMode() != NativeMode::Off && !capturing && !capture)
+        {
+            if (nativeMode() == NativeMode::On)
+            {
+                ps2vu1native::Run native{&state, data, dataSize, code, e.image ? e.image->hash : 0u, &e, &nativeSend};
+                if (ps2vu1native::meshesWanted())
+                    native.sendBytes = &nativeSendBytes;
+                if (g_nativeHook(native))
+                {
+                    e.cycle += 1u; // (no later run can tell how long it took)
+                    state.cycles = e.cycle;
+                    cycle = e.cycle;
+                    return;
+                }
+            }
+            else
+            {
+                NativeCheck &check = nativeCheck();
+                check.state = state;
+                check.data.assign(data, data + dataSize);
+                check.dataMask = dataSize - 1u;
+                check.packets.clear();
+                ps2vu1native::Run native{&check.state, check.data.data(), dataSize, code, e.image ? e.image->hash : 0u,
+                                         &check, &nativeCheckSend};
+                nativeChecked = g_nativeHook(native);
+                if (nativeChecked)
+                    g_batchPackets = &microcodePackets;
+            }
+        }
+
+        e.sequential = 0u;
+        uint64_t executed = 0u;
+        const uint64_t budgetEnd = e.cycle + maxCycles;
+        bool programEnded = false;
+        Pair *const pairs = e.pairs;
+#if PS2X_VU1_JIT
+        const bool useJit = jitEnabled() && e.dataMask == kJitDataMask && codeSize == kCodeBytes;
+        static const bool profiling = std::getenv("PS2X_VU1_PROFILE") != nullptr;
+#endif
+
+        while (e.cycle < budgetEnd && !stopRequested)
+        {
+            uint32_t pc = state.pc;
+#if PS2X_VU1_JIT
+            if (useJit && !state.branchPending && !state.ebit && !state.haltAfterDelaySlot && pc + 8u <= codeSize)
+            {
+                JitSlot &slot = e.image->slots[pc >> 3];
+                if (slot.state == JitUntried)
+                    jitCompile(e, code, pc);
+                if (slot.state == JitCompiled && e.cycle + slot.pairs <= budgetEnd)
+                {
+                    const uint32_t exit = slot.fn(&e, budgetEnd);
+                    // The pairs it ran (and those it went on into, which profiling stops).
+                    const uint64_t ran = e.jitLoopPairs;
+                    e.jitLoopPairs = 0u;
+                    executed += ran;
+                    if (exit != JitInterpretOne && profiling)
+                        profileBlock(e, pc, static_cast<uint32_t>(ran));
+                    if (exit == JitProgramEnded)
+                    {
+                        programEnded = true;
+                        break;
+                    }
+                    if (exit == JitContinue)
+                        continue;
+                    pc = state.pc; // JitInterpretOne: the interpreter runs this pair
+                }
+            }
+#endif
+            if (pc + 8u > codeSize)
+                break;
+            Pair &p = pairs[pc >> 3];
+            if (p.epoch != e.epoch)
+                decodePair(e, p, code, pc);
+            if (p.flags & PfReserved)
+            {
+                if (p.upper == &upperReserved)
+                    reportReserved(e, true, p.upperWord);
+                else
+                    reportReserved(e, false, p.lowerWord);
+                break;
+            }
+
+            // Interlocks: the latest ready cycle over the lanes this pair reads. Only the
+            // three pairs before can still be in flight, so after three sequential pairs a
+            // pair that reads nothing they write cannot stall.
+            uint64_t ready = e.cycle;
+            if (e.sequential < 3u || !(p.flags & PfNoHazard))
+            {
+                __m128i laneReady = _mm_setzero_si128();
+                for (uint32_t i = 0; i < p.readCount; ++i)
+                    laneReady = _mm_max_epu32(laneReady, _mm_and_si128(e.vfReady[p.readReg[i]],
+                                                                       _mm_castps_si128(kDestMask[p.readLanes[i]])));
+                laneReady = _mm_max_epu32(laneReady, _mm_shuffle_epi32(laneReady, _MM_SHUFFLE(1, 0, 3, 2)));
+                laneReady = _mm_max_epu32(laneReady, _mm_shuffle_epi32(laneReady, _MM_SHUFFLE(2, 3, 0, 1)));
+                uint32_t readyRelative = static_cast<uint32_t>(_mm_cvtsi128_si32(laneReady));
+                for (uint32_t reads = p.viReads; reads != 0u; reads &= reads - 1u)
+                {
+                    unsigned long reg = 0;
+#if defined(_MSC_VER)
+                    _BitScanForward(&reg, reads);
+#else
+                    reg = static_cast<unsigned long>(__builtin_ctz(reads));
+#endif
+                    readyRelative = std::max(readyRelative, e.viReady[reg]);
+                }
+                ready = std::max(ready, e.cycleBase + readyRelative);
+            }
+            switch (p.resource)
+            {
+            case ResFdiv:
+            case ResWaitQ:
+                if (e.qPending)
+                    ready = std::max(ready, e.qReady);
+                break;
+            case ResEfu:
+                ready = std::max(ready, e.efuResourceReady);
+                break;
+            case ResWaitP:
+                for (const EfuEntry &entry : e.efu)
+                    if (entry.valid)
+                        ready = std::max(ready, entry.ready);
+                break;
+            case ResXgkick:
+                if (e.kickActive)
+                    ready = std::max(ready, kickCompletion(e));
+                break;
+            default:
+                break;
+            }
+            if (ready > e.cycle)
+            {
+                if (ready >= budgetEnd)
+                {
+                    e.cycle = budgetEnd;
+                    commitEvents(e, e.cycle);
+                    break;
+                }
+                e.cycle = ready;
+                if (e.cycle >= e.nextEvent)
+                    commitEvents(e, e.cycle);
+            }
+
+            // Execute: the upper computes from the pre-pair state, the lower runs, then the
+            // upper's result lands (a lower write to the same register is discarded).
+            p.upper(e, p);
+            __m128 shadowed{};
+            if (p.flags & PfShadow)
+                shadowed = loadVf(e, p.upReg);
+            int32_t oldVi = 0;
+            if (p.viWriteReg != 0u)
+                oldVi = state.vi[p.viWriteReg];
+            p.lower(e, p);
+            if (p.flags & PfShadow)
+                _mm_storeu_ps(state.vf[p.upReg], shadowed);
+            if (p.upTarget == UtVf)
+                writeVf(e, p.upReg, e.upResult, p.dest);
+            else if (p.upTarget == UtAcc && p.dest != 0u)
+            {
+                _mm_storeu_ps(state.acc, _mm_blendv_ps(_mm_loadu_ps(state.acc), e.upResult, kDestMask[p.dest]));
+                e.lastWriteReady = std::max(e.lastWriteReady, e.cycle + 1u);
+            }
+
+            // A branch in the next pair reads the value this IALU write replaced.
+            e.backupValid = false;
+            if (p.viWriteReg != 0u && (p.flags & PfBranchBackup))
+            {
+                e.backupValid = true;
+                e.backupReg = p.viWriteReg;
+                e.backupValue = oldVi;
+            }
+
+            // Interlock bookkeeping.
+            if (p.upTarget == UtVf && p.upReg != 0u && p.dest != 0u)
+            {
+                const uint64_t at = e.cycle + kFmacLatency;
+                e.vfReady[p.upReg] = _mm_blendv_epi8(e.vfReady[p.upReg],
+                                                     _mm_set1_epi32(static_cast<int>(at - e.cycleBase)),
+                                                     _mm_castps_si128(kDestMask[p.dest]));
+                e.lastWriteReady = std::max(e.lastWriteReady, at);
+            }
+            if (p.loWriteReg != 0u && p.loWriteLanes != 0u && !(p.flags & PfShadow && p.loWriteReg == p.upReg))
+            {
+                const uint64_t at = e.cycle + p.loLatency;
+                e.vfReady[p.loWriteReg] = _mm_blendv_epi8(e.vfReady[p.loWriteReg],
+                                                          _mm_set1_epi32(static_cast<int>(at - e.cycleBase)),
+                                                          _mm_castps_si128(kDestMask[p.loWriteLanes]));
+                e.lastWriteReady = std::max(e.lastWriteReady, at);
+            }
+            if (p.viWriteReg != 0u)
+            {
+                const uint64_t at = e.cycle + p.viLatency;
+                e.viReady[p.viWriteReg] = static_cast<uint32_t>(at - e.cycleBase);
+                e.lastWriteReady = std::max(e.lastWriteReady, at);
+            }
+
+            // Program flow (same rules as the reference).
+            uint32_t nextPc = pc + 8u;
+            if (nextPc >= codeSize)
+                nextPc = 0u;
+            state.pc = nextPc;
+            if (state.branchPending)
+            {
+                if (state.branchDelay == 0u)
+                {
+                    state.pc = state.branchTarget & 0x3FFFu;
+                    state.branchPending = false;
+                }
+                else
+                {
+                    --state.branchDelay;
+                }
+            }
+            e.sequential = state.pc == pc + 8u ? e.sequential + 1u : 0u;
+
+            const bool dHalt = (p.flags & PfDBit) && state.dBitEnabled;
+            const bool tHalt = (p.flags & PfTBit) && state.tBitEnabled;
+            const bool haltBit = dHalt || tHalt;
+            const bool haltBranch = haltBit && (p.flags & PfBranch);
+            if (state.haltAfterDelaySlot)
+            {
+                programEnded = true;
+            }
+            else if (state.ebit)
+            {
+                programEnded = true;
+            }
+            else if (haltBit && !haltBranch)
+            {
+                state.stoppedByD = dHalt;
+                state.stoppedByT = tHalt;
+                programEnded = true;
+            }
+            else if (p.flags & PfEBit)
+            {
+                state.ebit = true;
+            }
+            else if (haltBranch)
+            {
+                state.haltAfterDelaySlot = true;
+                state.stoppedByD = dHalt;
+                state.stoppedByT = tHalt;
+            }
+
+            ++e.cycle;
+            ++executed;
+            if (e.cycle >= e.nextEvent)
+                commitEvents(e, e.cycle);
+            if (programEnded)
+                break;
+        }
+        stats().pairs += executed;
+
+        if (programEnded)
+        {
+            // Drain like the reference's flushPipelines: pending writes, Q, P, flags, PATH1.
+            uint64_t end = std::max(e.cycle, e.lastWriteReady);
+            if (e.flagCount != 0u)
+                end = std::max(end, e.flags[(e.flagHead + e.flagCount - 1u) & 15u].ready);
+            if (e.qPending)
+                end = std::max(end, e.qReady);
+            for (const EfuEntry &entry : e.efu)
+                if (entry.valid)
+                    end = std::max(end, entry.ready);
+            if (e.kickActive)
+                end = std::max(end, kickCompletion(e));
+            e.cycle = end;
+            if (e.cycle >= e.nextEvent)
+                commitEvents(e, e.cycle);
+            finishKick(e);
+            state.ebit = false;
+            state.haltAfterDelaySlot = false;
+            e.backupValid = false;
+        }
+        state.cycles = e.cycle;
+        cycle = e.cycle;
+        if (routineStats)
+            countRoutines(batchKind, batchVertices, executed, g_ps2Vu1XgkickBytes - batchBytes);
+        if (nativeChecked)
+        {
+            g_batchPackets = nullptr;
+            compareNativeRun(state, data, dataSize, microcodePackets, capturedPc, capturedItop);
+        }
+        if (capturing)
+        {
+            g_batchPackets = nullptr;
+            --batchCapture().left;
+            writeBatch(e, state, batchCapture().routines, capturedPc, capturedItop, capturedTop, capturedBefore, data,
+                       dataSize, code, capturedPackets);
+        }
+    }
+}
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_fast.h b/ps2xRuntime/src/lib/vu/ps2_vu1_fast.h
new file mode 100644
index 0000000..0ec110a
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_fast.h
@@ -0,0 +1,67 @@
+#ifndef PS2_VU1_FAST_H
+#define PS2_VU1_FAST_H
+
+#include <cstdint>
+#include <vector>
+
+class GS;
+class PS2Memory;
+struct VU1State;
+
+// Fast VU1 execution engine, used by VU1Interpreter::run() for the VU1 unit.
+//
+// The reference interpreter models every pipeline stage cycle by cycle (~200 ns per
+// instruction pair). This engine keeps the same observable behaviour at a fraction of
+// the cost: pairs are decoded once per code upload, register writes take effect at
+// issue (every VU register read of an in-flight result interlocks, and all VF producers
+// share one latency, so only the stall cycles depend on write timing), and the state a
+// program can observe early or late without an interlock - Q, P, the MAC/status/clip
+// flags and the PATH1 transfer of XGKICK - keeps its exact latency.
+//
+// PS2X_VU1_REFERENCE=1 selects the reference interpreter; PS2X_VU1_VERIFY=1 runs both on
+// every VU1 program and reports differences (see VU1Interpreter::run).
+namespace ps2vu1fast
+{
+    enum class Mode : uint8_t
+    {
+        Reference,
+        Fast,
+        Verify,
+    };
+
+    Mode mode();
+
+    // Runs the program at state.pc until it ends (E bit, flushed like the reference) or
+    // `maxCycles` pass. `owner` keys the engine's pipeline state (one per VU1 instance).
+    // With `capture` set, XGKICK packets are appended there instead of being submitted.
+    void run(const void *owner, VU1State &state, uint64_t &cycle, bool &stopRequested,
+             const uint8_t *code, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+             GS &gs, PS2Memory *memory, uint32_t maxCycles, std::vector<uint8_t> *capture);
+
+    // Empties the pipelines (VU1Interpreter::resetScheduler, i.e. MSCAL and reset).
+    void resetPipelines(const void *owner, const VU1State &state);
+
+    // How far the engine computes the MAC/status flags for the loaded code.
+    enum FlagTracking : uint8_t
+    {
+        FlagsNone,     // the code never reads them
+        FlagsObserved, // only for the FMAC instructions a reader can see; the sticky status
+                       // bits (6-9) are not kept
+        FlagsAll,      // for every FMAC instruction
+    };
+    FlagTracking flagTracking(const void *owner);
+
+    // Totals for PS2X_VIF_STATS: executed pairs, and host time spent handing XGKICK
+    // packets to the GIF (counted only while the stats are enabled).
+    struct Stats
+    {
+        uint64_t pairs = 0;
+        uint64_t kickNanoseconds = 0;
+        uint64_t codeChanges = 0;    // code generations seen by the engine
+        uint64_t changedPairs = 0;   // pairs that differ from the previous generation
+        uint64_t distinctImages = 0; // different code memory images so far (cumulative)
+    };
+    Stats &stats();
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_jit.inl b/ps2xRuntime/src/lib/vu/ps2_vu1_jit.inl
new file mode 100644
index 0000000..98d9c39
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_jit.inl
@@ -0,0 +1,2863 @@
+// VU1 JIT for x86-64 (AVX), built on xbyak. Included by ps2_vu1_fast.cpp inside its
+// anonymous namespace, after the decoder and the instruction handlers.
+//
+// A compiled block runs the pairs from an entry pc up to a branch (or E bit) and its
+// delay slot. It keeps the fast engine's model exactly - PS2X_VU1_VERIFY=1 checks it
+// against the reference interpreter - but resolves at compile time what the
+// interpreter loop decides for every pair: operands, lane masks, latencies, program
+// flow, which register interlocks can stall at all, and which operands need no clamp
+// ("Lanes known to be finite"). Q, P and the flag pipeline keep the interpreter's state;
+// stores during an XGKICK and the rarer instructions go through its handlers. Anything
+// a block does not handle (a stall that would
+// cross the cycle budget, D/T bits, reserved instructions) leaves the block at a pair
+// boundary with the state the interpreter expects there.
+//
+// Register use inside a block (callee-saved on Windows and System V):
+//   rbx = Engine *, rbp = VU1State *, r12 = VU data memory, r13 = current cycle,
+//   r14 = cycle budget end, r15 = target of the block's branch (~0 = not taken).
+// xmm5 holds the upper instruction's result until the lower instruction has run.
+// xmm6..xmm15 hold the VF registers (and ACC) the block uses most, from its start to
+// wherever it is left (see "The VF register cache").
+
+    constexpr uint32_t kJitMaxPairs = 128u;
+    constexpr size_t kJitArenaBytes = size_t(32) << 20;
+    constexpr uint32_t kJitDataMask = 0x3FFFu;
+
+    enum JitExit : uint32_t
+    {
+        JitContinue = 0,     // state.pc is the next pair to run
+        JitInterpretOne = 1, // the interpreter runs the pair at state.pc first
+        JitProgramEnded = 2, // the E bit's delay slot ran: the program is over
+    };
+
+    bool jitEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *env = std::getenv("PS2X_VU1_JIT");
+            if (env && env[0] == '0')
+                return false;
+            const Xbyak::util::Cpu cpu;
+            if (!cpu.has(Xbyak::util::Cpu::tAVX))
+            {
+                std::fprintf(stderr, "[vu1:jit] no AVX: VU1 microcode is interpreted\n");
+                return false;
+            }
+            return true;
+        }();
+        return enabled;
+    }
+
+    void jitInitEngine(Engine &e)
+    {
+        const auto bits = [&](JitConst index, uint32_t value)
+        { e.jitConst[index] = _mm_set1_epi32(static_cast<int>(value)); };
+        const auto real = [&](JitConst index, float value)
+        { e.jitConst[index] = _mm_castps_si128(_mm_set1_ps(value)); };
+        bits(JcExp, 0x7F800000u);
+        bits(JcSign, 0x80000000u);
+        bits(JcMaxMagnitude, 0x7F7FFFFFu);
+        bits(JcNegMax, 0xFF7FFFFFu);
+        e.jitConst[JcXyz] = _mm_castps_si128(kXyzMask);
+        real(JcFtoiLimit, 2147483648.0f);
+        bits(JcIntMax, 0x7FFFFFFFu);
+        real(JcItof4, 1.0f / 16.0f);
+        real(JcItof12, 1.0f / 4096.0f);
+        real(JcItof15, 1.0f / 32768.0f);
+        real(JcFtoi4, 16.0f);
+        real(JcFtoi12, 4096.0f);
+        real(JcFtoi15, 32768.0f);
+        e.jitConst[JcFlagLimits] = _mm_castpd_si128(_mm_set_pd(static_cast<double>(kFloatMax), -0.0));
+        e.jitConst[JcFlagMin] = _mm_castpd_si128(_mm_set_pd(0.0, static_cast<double>(std::numeric_limits<float>::min())));
+        real(JcOne, 1.0f);
+        for (uint32_t dest = 0; dest < 16u; ++dest)
+            e.jitConst[JcLanes + dest] = _mm_castps_si128(kDestMask[dest]);
+    }
+
+    // Entry points the generated code calls.
+    void jitCommitEvents(Engine *e) { commitEvents(*e, e->cycle); }
+    void jitFlagOverflow(Engine *e) { reportFlagOverflow(*e); }
+    uint64_t jitKickCompletion(Engine *e) { return kickCompletion(*e); }
+    void jitStore(Engine *e, uint32_t address, const uint32_t *words, uint32_t dest)
+    {
+        storeToVu(*e, address, words, static_cast<uint8_t>(dest));
+    }
+
+    inline uint32_t laneCount(uint8_t lanes)
+    {
+        return ((lanes >> 3) & 1u) + ((lanes >> 2) & 1u) + ((lanes >> 1) & 1u) + (lanes & 1u);
+    }
+
+    // vblendps immediate that takes the lanes in `lanes` (x = 8) from the second source.
+    inline uint8_t blendImm(uint8_t lanes)
+    {
+        return static_cast<uint8_t>(((lanes >> 3) & 1u) | (((lanes >> 2) & 1u) << 1) | (((lanes >> 1) & 1u) << 2) |
+                                    ((lanes & 1u) << 3));
+    }
+
+    inline bool backupProducer(const Pair &p) { return (p.flags & PfBranchBackup) && p.viWriteReg != 0u; }
+
+    Pair &jitPairAt(Engine &e, const uint8_t *code, uint32_t pc)
+    {
+        Pair &p = e.pairs[pc >> 3];
+        if (p.epoch != e.epoch)
+            decodePair(e, p, code, pc);
+        return p;
+    }
+
+    // Number of pairs a block starting at `pc` runs (0: the interpreter runs this pair).
+    uint32_t jitBlockPairs(Engine &e, const uint8_t *code, uint32_t pc, bool &endsProgram)
+    {
+        endsProgram = false;
+        const auto delaySlotOk = [&](uint32_t at)
+        {
+            if (at + 8u > kCodeBytes)
+                return false;
+            const Pair &slot = jitPairAt(e, code, at);
+            return !(slot.flags & (PfReserved | PfDBit | PfTBit | PfBranch | PfEBit));
+        };
+        uint32_t count = 0;
+        for (uint32_t at = pc; at + 8u <= kCodeBytes && count < kJitMaxPairs; at += 8u)
+        {
+            const Pair &p = jitPairAt(e, code, at);
+            if (p.flags & (PfReserved | PfDBit | PfTBit))
+                break;
+            if (p.flags & (PfBranch | PfEBit))
+            {
+                if ((p.flags & PfBranch) && (p.flags & PfEBit))
+                    break;
+                if (!delaySlotOk(at + 8u))
+                    break;
+                endsProgram = (p.flags & PfEBit) != 0u;
+                return count + 2u;
+            }
+            ++count;
+        }
+        return count;
+    }
+
+    class JitBlockCompiler : public Xbyak::CodeGenerator
+    {
+    public:
+        JitBlockCompiler(Engine &e, const uint8_t *code, uint32_t pc, uint32_t count, bool endsProgram,
+                         uint8_t *where, size_t room)
+            : Xbyak::CodeGenerator(room, where), m_e(e), m_pc0(pc), m_n(count), m_endsProgram(endsProgram)
+        {
+            setDefaultJmpNEAR(true);
+            for (uint32_t i = 0; i < m_n; ++i)
+                m_p.push_back(&jitPairAt(e, code, m_pc0 + 8u * i));
+            measureOffsets();
+            analyze();
+            emitBlock();
+        }
+
+        static constexpr int kFrame = 264;    // keeps rsp 16-byte aligned at calls
+
+        // The block's entry for the block before it (emitChain()).
+        const uint8_t *chainEntry() const { return m_chainEntry.getAddress(); }
+
+    private:
+        // Stack frame: [0, 32) home space, then spill slots.
+        static constexpr int kSpillUp = 32;  // xmm5 across calls
+        static constexpr int kStoreData = 48; // qword handed to jitStore
+        static constexpr int kReady = 64;     // stall cycle across the XGKICK helper
+        static constexpr int kBackup = 72;    // VI value a branch backup producer replaced
+        static constexpr int kShadow = 80;    // VF the upper writes, across a lower handler
+        static constexpr int kXmmSave = 96;   // the caller's xmm6..xmm15 while the VF cache has them
+
+        Engine &m_e;
+        const uint32_t m_pc0;
+        const uint32_t m_n;
+        const bool m_endsProgram;
+        std::vector<const Pair *> m_p;
+
+        // Engine field offsets (Engine is not standard layout: measured on the instance).
+        int m_cycle = 0, m_st = 0, m_data = 0, m_vfReady = 0, m_viReady = 0, m_cycleBase = 0;
+        int m_lastWriteReady = 0, m_qPending = 0, m_qReady = 0, m_efuResourceReady = 0;
+        int m_efuValid[2] = {}, m_efuReady[2] = {}, m_efuValue[2] = {};
+        int m_kickActive = 0, m_nextEvent = 0, m_backupValid = 0, m_backupReg = 0, m_backupValue = 0;
+        int m_kickSource = 0, m_kickWatch = 0;
+        int m_sequential = 0, m_stop = 0, m_upResult = 0, m_const = 0;
+        int m_qValue = 0, m_qStatusDi = 0, m_flags = 0, m_flagHead = 0, m_flagCount = 0, m_workingClip = 0;
+        int m_loopPairs = 0, m_slots = 0;
+
+        // Per-pair analysis.
+        std::vector<uint8_t> m_regCheck;  // register interlocks can stall this pair
+        std::vector<uint8_t> m_check;     // any stall check (registers or a resource)
+        std::vector<uint8_t> m_callsOut;  // runs a handler that can request a stop
+        std::vector<uint8_t> m_exitNear;  // an exit point lies within 3 pairs after it
+        // A block that goes round on itself has a second copy of its first three pairs for
+        // the way round, where the three pairs before are its own last ones: their register
+        // checks there (m_loopRegCheck) are those that can find a write not yet done.
+        bool m_loopHead = false;
+        std::vector<uint8_t> m_loopRegCheck;
+        bool m_emittingLoopHead = false;
+
+        // The VF register cache. Registers the block uses most live in xmm6 + slot from the
+        // block's start (loaded after the prologue, kept while it goes round on itself) to
+        // the epilogue, which every way out passes through; ACC counts as register kAcc.
+        // xmm6..xmm15 are callee-saved on Windows, so calls keep them: a register the
+        // block writes is written back to the state at the epilogue and before a handler
+        // (which reads the state), and one a lower handler can write is read again after.
+        static constexpr uint32_t kAcc = 32u;
+        static constexpr uint32_t kCacheSlots = 10u;
+        int8_t m_slot[33] = {};
+        uint8_t m_cached[kCacheSlots] = {};
+        uint32_t m_cachedCount = 0u;
+        bool m_cacheWrites[33] = {};
+
+        // Lanes known to be finite. The clamp of an operand (emitNorm) only changes lanes
+        // with exponent 255, so a lane known to hold none is read as it is: VF0; what the
+        // block's arithmetic writes (in the VU float mode a result is finite: its operands
+        // are clamped and overflow rounds to FLT_MAX); ITOF and ABS results; copies of such
+        // lanes (MOVE, MR32, MAX/MINI of two of them); I after a LOI of a finite immediate.
+        // A block that goes round on itself checks at its start that the lanes it reads
+        // before writing them are finite (the interpreter runs its first pair if not), so
+        // those count too, all the way round; in other blocks what comes from before the
+        // block is unknown.
+        static constexpr uint32_t kRegI = 33u; // I, for clampedReads()
+        struct FiniteLanes
+        {
+            uint8_t vf[33] = {}; // by register (x = 8), ACC as kAcc
+            bool i = false;
+            bool operator==(const FiniteLanes &other) const
+            {
+                return std::memcmp(vf, other.vf, sizeof(vf)) == 0 && i == other.i;
+            }
+            void meet(const FiniteLanes &other)
+            {
+                for (uint32_t r = 0; r < 33u; ++r)
+                    vf[r] &= other.vf[r];
+                i = i && other.i;
+            }
+        };
+        std::vector<FiniteLanes> m_finite;        // before each pair, on the way in
+        FiniteLanes m_finiteHead[3];              // before the way round's copy of the first pairs
+        FiniteLanes m_entryChecked;               // what the start of a block that goes round checks
+        const FiniteLanes *m_finiteNow = nullptr; // before the pair being emitted
+
+        bool m_upLive = false;
+        std::deque<Xbyak::Label> m_labels;
+        std::vector<std::function<void()>> m_cold;
+        std::vector<std::pair<uint32_t, Xbyak::Label *>> m_stallExits, m_stopExits;
+        Xbyak::Label m_epilogue;
+        Xbyak::Label m_loopEntry; // after the prologue: where a block that loops on itself goes round
+        Xbyak::Label m_chainEntry; // after the prologue's saves: where the block before goes on into this one
+
+        Xbyak::Label &newLabel()
+        {
+            m_labels.emplace_back();
+            return m_labels.back();
+        }
+
+        template <typename T>
+        int offsetOf(const T &field) const
+        {
+            return static_cast<int>(reinterpret_cast<const uint8_t *>(&field) - reinterpret_cast<const uint8_t *>(&m_e));
+        }
+
+        void measureOffsets()
+        {
+            m_cycle = offsetOf(m_e.cycle);
+            m_st = offsetOf(m_e.st);
+            m_data = offsetOf(m_e.data);
+            m_vfReady = offsetOf(m_e.vfReady);
+            m_viReady = offsetOf(m_e.viReady);
+            m_cycleBase = offsetOf(m_e.cycleBase);
+            m_lastWriteReady = offsetOf(m_e.lastWriteReady);
+            m_qPending = offsetOf(m_e.qPending);
+            m_qReady = offsetOf(m_e.qReady);
+            m_efuResourceReady = offsetOf(m_e.efuResourceReady);
+            for (int k = 0; k < 2; ++k)
+            {
+                m_efuValid[k] = offsetOf(m_e.efu[k].valid);
+                m_efuReady[k] = offsetOf(m_e.efu[k].ready);
+                m_efuValue[k] = offsetOf(m_e.efu[k].value);
+            }
+            m_kickActive = offsetOf(m_e.kickActive);
+            m_kickSource = offsetOf(m_e.kickSource);
+            m_kickWatch = offsetOf(m_e.kickWatch);
+            m_nextEvent = offsetOf(m_e.nextEvent);
+            m_backupValid = offsetOf(m_e.backupValid);
+            m_backupReg = offsetOf(m_e.backupReg);
+            m_backupValue = offsetOf(m_e.backupValue);
+            m_sequential = offsetOf(m_e.sequential);
+            m_stop = offsetOf(m_e.stop);
+            m_upResult = offsetOf(m_e.upResult);
+            m_const = offsetOf(m_e.jitConst);
+            m_qValue = offsetOf(m_e.qValue);
+            m_qStatusDi = offsetOf(m_e.qStatusDi);
+            m_flags = offsetOf(m_e.flags);
+            m_flagHead = offsetOf(m_e.flagHead);
+            m_flagCount = offsetOf(m_e.flagCount);
+            m_workingClip = offsetOf(m_e.workingClip);
+            m_loopPairs = offsetOf(m_e.jitLoopPairs);
+            m_slots = offsetOf(m_e.jitSlots);
+        }
+
+        // ABI argument registers.
+#if defined(_WIN32)
+        const Xbyak::Reg64 &arg0() const { return rcx; }
+        const Xbyak::Reg64 &arg1() const { return rdx; }
+        const Xbyak::Reg64 &arg2() const { return r8; }
+        const Xbyak::Reg64 &arg3() const { return r9; }
+#else
+        const Xbyak::Reg64 &arg0() const { return rdi; }
+        const Xbyak::Reg64 &arg1() const { return rsi; }
+        const Xbyak::Reg64 &arg2() const { return rdx; }
+        const Xbyak::Reg64 &arg3() const { return rcx; }
+#endif
+
+        static int st(size_t offset) { return static_cast<int>(offset); }
+        Xbyak::Address vf(uint32_t reg, uint32_t lane = 0u) { return ptr[rbp + st(offsetof(VU1State, vf) + reg * 16u + lane * 4u)]; }
+        Xbyak::Address vfWord(uint32_t reg, uint32_t lane) { return word[rbp + st(offsetof(VU1State, vf) + reg * 16u + lane * 4u)]; }
+        Xbyak::Address vi(uint32_t reg) { return dword[rbp + st(offsetof(VU1State, vi) + reg * 4u)]; }
+        Xbyak::Address viWord(uint32_t reg) { return word[rbp + st(offsetof(VU1State, vi) + reg * 4u)]; }
+        Xbyak::Address stateDword(size_t offset) { return dword[rbp + st(offset)]; }
+        Xbyak::Address constant(uint32_t index) { return ptr[rbx + m_const + static_cast<int>(index * 16u)]; }
+        Xbyak::Address vfReady(uint32_t reg, uint32_t lane) { return dword[rbx + m_vfReady + static_cast<int>(reg * 16u + lane * 4u)]; }
+
+        // ---------------------------------------------------------------------------
+        // Analysis
+        // ---------------------------------------------------------------------------
+
+        bool readsVf(const Pair &p, uint8_t reg, uint8_t lanes) const
+        {
+            for (uint32_t r = 0; r < p.readCount; ++r)
+                if (p.readReg[r] == reg && (p.readLanes[r] & lanes))
+                    return true;
+            return false;
+        }
+
+        // A write at pair i must reach vfReady/viReady only if a later pair can still
+        // stall on it: one of the next three pairs of the block reads it, or the block
+        // ends before its latency has passed.
+        bool recordVf(uint32_t i, uint8_t reg, uint8_t lanes) const
+        {
+            if (i + 3u >= m_n)
+                return true;
+            for (uint32_t j = i + 1u; j <= i + 3u; ++j)
+                if (readsVf(*m_p[j], reg, lanes))
+                    return true;
+            return false;
+        }
+
+        bool recordVi(uint32_t i, uint8_t reg) const
+        {
+            if (i + 3u >= m_n)
+                return true;
+            for (uint32_t j = i + 1u; j <= i + 3u; ++j)
+                if (m_p[j]->viReads & (1u << reg))
+                    return true;
+            return false;
+        }
+
+        // The latency with which pair `w` writes something pair `r` reads (0: nothing).
+        static uint32_t readLatency(const Pair &w, const Pair &r)
+        {
+            uint32_t latency = 0u;
+            for (uint32_t k = 0; k < r.readCount; ++k)
+            {
+                if (w.upTarget == UtVf && w.upReg != 0u && w.upReg == r.readReg[k] && (w.dest & r.readLanes[k]))
+                    latency = std::max(latency, kFmacLatency);
+                if (w.loWriteReg != 0u && w.loWriteReg == r.readReg[k] && (w.loWriteLanes & r.readLanes[k]))
+                    latency = std::max<uint32_t>(latency, w.loLatency);
+            }
+            if (w.viWriteReg != 0u && (r.viReads & (1u << w.viWriteReg)))
+                latency = std::max<uint32_t>(latency, w.viLatency);
+            return latency;
+        }
+
+        // Whether pair `i` can find a register write of the three pairs before it not yet
+        // done; `before(d, i)` is the index of the pair d before it (~0: not the block's).
+        template <typename Before>
+        bool mayStall(uint32_t i, Before before) const
+        {
+            for (uint32_t d = 1u; d <= 3u; ++d)
+            {
+                const uint32_t w = before(d, i);
+                if (w >= m_n)
+                    return true;
+                if (readLatency(*m_p[w], *m_p[i]) > d)
+                    return true;
+            }
+            return false;
+        }
+
+        static bool lowerIsInline(const Pair &p)
+        {
+            static const OpFn inlined[] = {
+                &lowerNop, &lowerLoi, &lowerLq, &lowerSq, &lowerIlw, &lowerIsw, &lowerIaddiu, &lowerIsubiu,
+                &lowerIaddi, &lowerIadd, &lowerIsub, &lowerIand, &lowerIor, &lowerMove, &lowerMr32, &lowerLqi,
+                &lowerSqi, &lowerLqd, &lowerSqd, &lowerMtir, &lowerMfir, &lowerIlwr, &lowerIswr, &lowerMfp,
+                &lowerXtop, &lowerXitop, &lowerFcand, &lowerFceq, &lowerFcor, &lowerFcget, &lowerFsand,
+                &lowerFseq, &lowerFsor, &lowerFmand, &lowerFmeq, &lowerFmor, &lowerB, &lowerBal, &lowerJr,
+                &lowerJalr, &lowerIbeq, &lowerIbne, &lowerIbltz, &lowerIbgtz, &lowerIblez, &lowerIbgez, &lowerDiv};
+            for (OpFn fn : inlined)
+                if (p.lower == fn)
+                    return true;
+            return (inlineQp() && (p.lower == &lowerSqrt || p.lower == &lowerRsqrt)) || efuCode(p) != 0u;
+        }
+
+        // Whether SQRT, RSQRT and the EFU instructions efuCode() names are compiled inline
+        // (PS2X_VU1_JIT_QP=0: through their handlers).
+        static bool inlineQp()
+        {
+            static const bool enabled = []()
+            {
+                const char *env = std::getenv("PS2X_VU1_JIT_QP");
+                return !env || env[0] != '0';
+            }();
+            return enabled;
+        }
+
+        // The EFU instruction the pair's lower is, if the block computes it inline (0: not
+        // one of those; the trigonometric and exponential ones go through their handlers).
+        static uint8_t efuCode(const Pair &p)
+        {
+            static const struct
+            {
+                OpFn fn;
+                uint8_t code;
+            } inlined[] = {{&lowerEfu<0x70>, 0x70u}, {&lowerEfu<0x71>, 0x71u}, {&lowerEfu<0x72>, 0x72u},
+                           {&lowerEfu<0x73>, 0x73u}, {&lowerEfu<0x76>, 0x76u}, {&lowerEfu<0x78>, 0x78u},
+                           {&lowerEfu<0x79>, 0x79u}, {&lowerEfu<0x7A>, 0x7Au}};
+            if (!inlineQp())
+                return 0u;
+            for (const auto &op : inlined)
+                if (p.lower == op.fn)
+                    return op.code;
+            return 0u;
+        }
+
+        void analyze()
+        {
+            m_regCheck.assign(m_n, 0u);
+            m_check.assign(m_n, 0u);
+            m_callsOut.assign(m_n, 0u);
+            m_exitNear.assign(m_n, 0u);
+            for (uint32_t i = 0; i < m_n; ++i)
+            {
+                const Pair &p = *m_p[i];
+                const bool reads = p.readCount != 0u || p.viReads != 0u;
+                // Past the third pair, the three pairs before are the block's own: a check
+                // only where one of them writes what this one reads with a latency longer
+                // than the pairs in between (a stall only puts them further apart).
+                m_regCheck[i] = reads && (i < 3u || mayStall(i, [this](uint32_t d, uint32_t at) { return at >= d ? at - d : ~0u; }));
+                m_check[i] = m_regCheck[i] || p.resource != ResNone;
+                // (an inline EFU instruction runs its handler when the pipeline is full)
+                m_callsOut[i] = !upperIsInline(p) || !lowerIsInline(p) || efuCode(p) != 0u;
+            }
+            // The way round: before pair k < 3 come pairs k-1.. and then the block's last.
+            m_loopHead = m_n >= 6u && loopsOnItself();
+            m_loopRegCheck.assign(m_n, 0u);
+            if (m_loopHead)
+                for (uint32_t i = 0; i < 3u; ++i)
+                {
+                    const Pair &p = *m_p[i];
+                    const bool reads = p.readCount != 0u || p.viReads != 0u;
+                    m_loopRegCheck[i] = reads && mayStall(i, [this](uint32_t d, uint32_t at) { return at >= d ? at - d : m_n + at - d; });
+                }
+            // Exits: before a pair that can stall (to the interpreter), after one that can
+            // request a stop, and at the end of the block.
+            std::vector<uint8_t> exitBefore(m_n + 1u, 0u);
+            exitBefore[m_n] = 1u;
+            for (uint32_t k = 0; k < m_n; ++k)
+            {
+                if (m_check[k])
+                    exitBefore[k] = 1u;
+                if (m_callsOut[k])
+                    exitBefore[k + 1u] = 1u;
+            }
+            for (uint32_t i = 0; i < m_n; ++i)
+                for (uint32_t k = i + 1u; k <= std::min(i + 3u, m_n); ++k)
+                    if (exitBefore[k])
+                        m_exitNear[i] = 1u;
+            chooseCached();
+            analyzeFinite();
+        }
+
+        // ---- Lanes known to be finite (see m_finite) ----
+        static bool isArith(const Pair &p)
+        {
+            return p.upper == arithHandler(static_cast<Arith>(p.arith), static_cast<Operand>(p.operand));
+        }
+
+        static bool isFtoi(const Pair &p)
+        {
+            return p.upper == &upperFtoi<0> || p.upper == &upperFtoi<4> || p.upper == &upperFtoi<12> ||
+                   p.upper == &upperFtoi<15>;
+        }
+
+        static bool isItof(const Pair &p)
+        {
+            return p.upper == &upperItof<0> || p.upper == &upperItof<4> || p.upper == &upperItof<12> ||
+                   p.upper == &upperItof<15>;
+        }
+
+        // Whether the upper writes a register (emitUpper() emits nothing otherwise).
+        static bool upperWrites(const Pair &p)
+        {
+            return (p.upTarget == UtVf && p.upReg != 0u && p.dest != 0u) || (p.upTarget == UtAcc && p.dest != 0u);
+        }
+
+        // The lanes of an arithmetic upper's operands that its result keeps.
+        static uint8_t keptLanes(const Pair &p)
+        {
+            return (p.arith == AOpmula || p.arith == AOpmsub) ? 0xEu : static_cast<uint8_t>(p.dest & 0xFu);
+        }
+
+        bool isFinite(uint32_t reg, uint8_t lanes) const
+        {
+            return reg == kRegI ? m_finiteNow->i : (m_finiteNow->vf[reg] & lanes) == lanes;
+        }
+
+        // The operand lanes the pair clamps unless known finite: visit(reg, lanes), I as kRegI.
+        template <typename Visit>
+        void clampedReads(const Pair &p, Visit visit) const
+        {
+            if (upperIsInline(p) && upperWrites(p))
+            {
+                if (isArith(p) && p.arith != AMax && p.arith != AMini)
+                {
+                    const uint8_t kept = keptLanes(p);
+                    visit(p.fs, kept);
+                    if (p.operand == OBc)
+                        visit(p.ft, laneBit(p.bc));
+                    else if (p.operand == OVec)
+                        visit(p.ft, kept);
+                    else if (p.operand == OI)
+                        visit(kRegI, 0xFu);
+                    if (p.arith == AMadd || p.arith == AMsub || p.arith == AOpmsub)
+                        visit(kAcc, kept);
+                }
+                else if (isFtoi(p) || p.upper == &upperAbs)
+                {
+                    visit(p.fs, p.dest);
+                }
+            }
+            const bool rsqrt = inlineQp() && p.lower == &lowerRsqrt;
+            if (p.lower == &lowerDiv || rsqrt)
+                visit(p.lfs, laneBit(p.fsf));
+            if (p.lower == &lowerDiv || rsqrt || (inlineQp() && p.lower == &lowerSqrt))
+                visit(p.lft, laneBit(p.ftf));
+            switch (efuCode(p))
+            {
+            case 0x70u:
+            case 0x71u:
+            case 0x72u:
+            case 0x73u:
+                visit(p.lfs, 0xEu);
+                break;
+            case 0x76u:
+                visit(p.lfs, 0xFu);
+                break;
+            case 0x78u:
+            case 0x79u:
+            case 0x7Au:
+                visit(p.lfs, laneBit(p.fsf));
+                break;
+            default:
+                break;
+            }
+        }
+
+        // The pair's register writes: write(reg, lanes, finite lanes among them), I as kRegI.
+        template <typename Write>
+        static void pairWrites(const Pair &p, const FiniteLanes &before, Write write)
+        {
+            // The lower's VF write is lost when the upper writes the same register.
+            const bool loVfWrite = !((p.flags & PfShadow) && p.loWriteReg == p.upReg);
+            if (loVfWrite && p.loWriteReg != 0u && p.loWriteLanes != 0u)
+            {
+                uint8_t finite = 0u;
+                if (p.lower == &lowerMove)
+                    finite = before.vf[p.lfs];
+                else if (p.lower == &lowerMr32) // x <- y, y <- z, z <- w, w <- x
+                    finite = static_cast<uint8_t>(((before.vf[p.lfs] << 1) & 0xEu) | ((before.vf[p.lfs] >> 3) & 1u));
+                write(p.loWriteReg, p.loWriteLanes, finite);
+            }
+            if (p.flags & PfIBit)
+                write(kRegI, 0xFu, ((p.lowerWord >> 23) & 0xFFu) != 0xFFu ? 0xFu : 0u);
+            if (upperWrites(p))
+            {
+                uint8_t finite = 0u;
+                if (!upperIsInline(p) || isFtoi(p))
+                    finite = 0u;
+                else if (isArith(p) && (p.arith == AMax || p.arith == AMini))
+                {
+                    // One of the two operands, as bits.
+                    uint8_t other = 0u;
+                    if (p.operand == OVec)
+                        other = before.vf[p.ft];
+                    else if (p.operand == OBc)
+                        other = (before.vf[p.ft] & laneBit(p.bc)) ? 0xFu : 0u;
+                    else if (p.operand == OI)
+                        other = before.i ? 0xFu : 0u;
+                    finite = before.vf[p.fs] & other;
+                }
+                else if (isArith(p) || isItof(p) || p.upper == &upperAbs)
+                    finite = 0xFu;
+                write(p.upTarget == UtAcc ? kAcc : p.upReg, p.dest, finite);
+            }
+        }
+
+        static void finiteStep(const Pair &p, FiniteLanes &s)
+        {
+            const FiniteLanes before = s;
+            pairWrites(p, before, [&](uint32_t reg, uint8_t lanes, uint8_t finite)
+                       {
+                           if (reg == kRegI)
+                               s.i = finite != 0u;
+                           else if (reg != 0u)
+                               s.vf[reg] = static_cast<uint8_t>((s.vf[reg] & ~lanes) | (finite & lanes)); });
+            s.vf[0] = 0xFu;
+        }
+
+        void analyzeFinite()
+        {
+            static const bool enabled = []()
+            {
+                const char *env = std::getenv("PS2X_VU1_JIT_FINITE"); // 0: every operand clamped
+                return !env || env[0] != '0';
+            }();
+            FiniteLanes entry{};
+            entry.vf[0] = 0xFu;
+            m_entryChecked = FiniteLanes{};
+            const bool loops = loopsOnItself();
+            if (enabled && loops)
+            {
+                // What the first time round reads before writing it.
+                FiniteLanes written{};
+                for (uint32_t i = 0; i < m_n; ++i)
+                {
+                    const Pair &p = *m_p[i];
+                    clampedReads(p, [&](uint32_t reg, uint8_t lanes)
+                                 {
+                                     if (reg == kRegI)
+                                         m_entryChecked.i = m_entryChecked.i || !written.i;
+                                     else if (reg != 0u)
+                                         m_entryChecked.vf[reg] |= static_cast<uint8_t>(lanes & ~written.vf[reg]); });
+                    pairWrites(p, written, [&](uint32_t reg, uint8_t lanes, uint8_t)
+                               {
+                                   if (reg == kRegI)
+                                       written.i = true;
+                                   else
+                                       written.vf[reg] |= lanes; });
+                }
+                for (uint32_t r = 1; r < 33u; ++r)
+                    entry.vf[r] = m_entryChecked.vf[r];
+                entry.i = m_entryChecked.i;
+            }
+            m_finite.assign(m_n, FiniteLanes{});
+            if (!enabled)
+            {
+                for (FiniteLanes &head : m_finiteHead)
+                    head = FiniteLanes{};
+                return;
+            }
+            // The way in, then (a block that goes round) the way round, whose state meets
+            // the way in's at the start of the code both share, until nothing changes.
+            const uint32_t shared = m_loopHead ? 3u : 0u;
+            FiniteLanes in = entry;
+            for (uint32_t i = 0; i < shared; ++i)
+            {
+                m_finite[i] = in;
+                finiteStep(*m_p[i], in);
+            }
+            FiniteLanes start = in;
+            for (;;)
+            {
+                FiniteLanes s = start;
+                for (uint32_t i = shared; i < m_n; ++i)
+                {
+                    m_finite[i] = s;
+                    finiteStep(*m_p[i], s);
+                }
+                if (!loops)
+                    break;
+                for (uint32_t i = 0; i < shared; ++i)
+                {
+                    m_finiteHead[i] = s;
+                    finiteStep(*m_p[i], s);
+                }
+                FiniteLanes next = in;
+                next.meet(s);
+                if (next == start)
+                    break;
+                start = next;
+            }
+        }
+
+        // Which registers the cache keeps: in a block that goes round on itself every one
+        // it uses (each use saves a load or a store every time round), in a long one those
+        // used at least three times; the most used first, up to the slots there are.
+        void chooseCached()
+        {
+            std::fill(std::begin(m_slot), std::end(m_slot), static_cast<int8_t>(-1));
+            std::fill(std::begin(m_cacheWrites), std::end(m_cacheWrites), false);
+            m_cachedCount = 0u;
+            static const bool enabled = []()
+            {
+                const char *env = std::getenv("PS2X_VU1_JIT_CACHE"); // 0: VF registers in memory
+                return !env || env[0] != '0';
+            }();
+            const bool loops = loopsOnItself();
+            if (!enabled || (!loops && m_n < 16u))
+                return;
+            uint32_t uses[33] = {};
+            bool writes[33] = {};
+            for (uint32_t i = 0; i < m_n; ++i)
+            {
+                const Pair &p = *m_p[i];
+                for (uint32_t r = 0; r < p.readCount; ++r)
+                    ++uses[p.readReg[r]];
+                const bool arithmetic = p.upper == arithHandler(static_cast<Arith>(p.arith), static_cast<Operand>(p.operand));
+                if (arithmetic && (p.arith == AMadd || p.arith == AMsub || p.arith == AOpmsub))
+                    ++uses[kAcc];
+                if (p.upTarget == UtVf && p.upReg != 0u && p.dest != 0u)
+                {
+                    ++uses[p.upReg];
+                    writes[p.upReg] = true;
+                }
+                if (p.upTarget == UtAcc && p.dest != 0u)
+                {
+                    ++uses[kAcc];
+                    writes[kAcc] = true;
+                }
+                if (p.loWriteReg != 0u && p.loWriteLanes != 0u)
+                {
+                    ++uses[p.loWriteReg];
+                    writes[p.loWriteReg] = true;
+                }
+            }
+            const uint32_t least = loops ? 1u : 3u;
+            for (uint32_t taken = 0; taken < kCacheSlots; ++taken)
+            {
+                uint32_t best = 33u;
+                for (uint32_t reg = 0; reg < 33u; ++reg)
+                    if (m_slot[reg] < 0 && uses[reg] >= least && (best == 33u || uses[reg] > uses[best]))
+                        best = reg;
+                if (best == 33u)
+                    break;
+                m_slot[best] = static_cast<int8_t>(m_cachedCount);
+                m_cached[m_cachedCount++] = static_cast<uint8_t>(best);
+                m_cacheWrites[best] = writes[best] && best != 0u;
+            }
+        }
+
+        static bool upperIsInline(const Pair &p)
+        {
+            if (p.upper == &upperNop || p.upper == &upperClip || p.upper == &upperAbs)
+                return true;
+            static const OpFn converts[] = {&upperItof<0>, &upperItof<4>, &upperItof<12>, &upperItof<15>,
+                                            &upperFtoi<0>, &upperFtoi<4>, &upperFtoi<12>, &upperFtoi<15>};
+            for (OpFn fn : converts)
+                if (p.upper == fn)
+                    return true;
+            return p.upper == arithHandler(static_cast<Arith>(p.arith), static_cast<Operand>(p.operand));
+        }
+
+        // ---------------------------------------------------------------------------
+        // Emission helpers
+        // ---------------------------------------------------------------------------
+
+        void spill(bool upLive)
+        {
+            if (upLive)
+                vmovups(ptr[rsp + kSpillUp], xmm5);
+        }
+
+        void reload(bool upLive)
+        {
+            if (upLive)
+                vmovups(xmm5, ptr[rsp + kSpillUp]);
+        }
+
+        void callFunction(const void *fn)
+        {
+            mov(rax, reinterpret_cast<size_t>(fn));
+            call(rax);
+        }
+
+        // Runs an interpreter handler for the pair (it sees the current cycle and pc).
+        void callHandler(OpFn fn, const Pair &p, uint32_t pc) { callHandler(fn, p, pc, m_upLive); }
+
+        // ... with xmm5 holding the upper's result or not (`upLive`; out-of-line code knows).
+        void callHandler(OpFn fn, const Pair &p, uint32_t pc, bool upLive)
+        {
+            flushCache();
+            spill(upLive);
+            mov(qword[rbx + m_cycle], r13);
+            mov(stateDword(offsetof(VU1State, pc)), pc);
+            mov(arg0(), rbx);
+            mov(arg1(), reinterpret_cast<size_t>(&p));
+            callFunction(reinterpret_cast<const void *>(fn));
+            reload(upLive);
+        }
+
+        // norm(): exponent 255 reads as +/-FLT_MAX (denormals are zero through DAZ). On the
+        // bits as integers: a negative value's clamped (unsigned) to those of -FLT_MAX, then
+        // a positive value's (signed; the negative ones are below it) to those of FLT_MAX.
+        void emitNorm(const Xbyak::Xmm &v, const Xbyak::Xmm &, const Xbyak::Xmm &)
+        {
+            vpminud(v, v, constant(JcNegMax));
+            vpminsd(v, v, constant(JcMaxMagnitude));
+        }
+
+        // writeVf(): `value` into VF `reg`, lanes `dest`.
+        void storeVf(uint32_t reg, const Xbyak::Xmm &value, uint8_t dest, const Xbyak::Xmm &temp)
+        {
+            if (reg == 0u || dest == 0u)
+                return;
+            if (cached(reg))
+            {
+                storeCached(reg, value, dest);
+                return;
+            }
+            if (dest == 0xFu)
+            {
+                vmovups(vf(reg), value);
+                return;
+            }
+            vblendps(temp, value, vf(reg), blendImm(static_cast<uint8_t>(~dest & 0xFu)));
+            vmovups(vf(reg), temp);
+        }
+
+        // ACC, lanes `dest`.
+        void storeAcc(const Xbyak::Xmm &value, uint8_t dest, const Xbyak::Xmm &temp)
+        {
+            if (dest == 0u)
+                return;
+            if (cached(kAcc))
+            {
+                storeCached(kAcc, value, dest);
+                return;
+            }
+            if (dest == 0xFu)
+            {
+                vmovups(ptr[rbp + st(offsetof(VU1State, acc))], value);
+                return;
+            }
+            vblendps(temp, value, ptr[rbp + st(offsetof(VU1State, acc))], blendImm(static_cast<uint8_t>(~dest & 0xFu)));
+            vmovups(ptr[rbp + st(offsetof(VU1State, acc))], temp);
+        }
+
+        // ---- the VF register cache ----
+        bool cached(uint32_t reg) const { return m_slot[reg] >= 0; }
+        Xbyak::Xmm cacheXmm(uint32_t reg) const { return Xbyak::Xmm(6 + m_slot[reg]); }
+        Xbyak::Address stateOf(uint32_t reg) { return reg == kAcc ? ptr[rbp + st(offsetof(VU1State, acc))] : vf(reg); }
+
+        void storeCached(uint32_t reg, const Xbyak::Xmm &value, uint8_t dest)
+        {
+            if (dest == 0xFu)
+                vmovaps(cacheXmm(reg), value);
+            else
+                vblendps(cacheXmm(reg), cacheXmm(reg), value, blendImm(dest));
+        }
+
+        // VF `reg` (four lanes) into `target`.
+        void loadVf(const Xbyak::Xmm &target, uint32_t reg)
+        {
+            if (cached(reg))
+                vmovaps(target, cacheXmm(reg));
+            else
+                vmovups(target, vf(reg));
+        }
+
+        void loadAcc(const Xbyak::Xmm &target)
+        {
+            if (cached(kAcc))
+                vmovaps(target, cacheXmm(kAcc));
+            else
+                vmovups(target, ptr[rbp + st(offsetof(VU1State, acc))]);
+        }
+
+        // VF `reg` (or ACC) as an operand: its cache register itself when it needs no clamp,
+        // else the register loaded into `scratch` and clamped (emitNorm) there.
+        Xbyak::Xmm operandVf(const Xbyak::Xmm &scratch, uint32_t reg, bool clamp)
+        {
+            if (cached(reg))
+            {
+                if (!clamp)
+                    return cacheXmm(reg);
+                vpminud(scratch, cacheXmm(reg), constant(JcNegMax));
+                vpminsd(scratch, scratch, constant(JcMaxMagnitude));
+                return scratch;
+            }
+            vmovups(scratch, stateOf(reg));
+            if (clamp)
+                emitNorm(scratch, scratch, scratch);
+            return scratch;
+        }
+
+        // Lane `lane` of VF `reg` in every lane of `target`.
+        void loadVfLane(const Xbyak::Xmm &target, uint32_t reg, uint32_t lane)
+        {
+            if (cached(reg))
+                vpermilps(target, cacheXmm(reg), static_cast<uint8_t>(lane * 0x55u));
+            else
+                vbroadcastss(target, dword[rbp + st(offsetof(VU1State, vf) + reg * 16u + lane * 4u)]);
+        }
+
+        void loadVfLaneDword(const Xbyak::Reg32 &target, uint32_t reg, uint32_t lane)
+        {
+            if (cached(reg))
+                vpextrd(target, cacheXmm(reg), static_cast<uint8_t>(lane));
+            else
+                mov(target, dword[rbp + st(offsetof(VU1State, vf) + reg * 16u + lane * 4u)]);
+        }
+
+        // The low 16 bits of lane `lane`, sign-extended.
+        void loadVfLaneWord(const Xbyak::Reg32 &target, uint32_t reg, uint32_t lane)
+        {
+            if (cached(reg))
+            {
+                vpextrw(target, cacheXmm(reg), static_cast<uint8_t>(lane * 2u));
+                movsx(target, target.cvt16());
+            }
+            else
+            {
+                movsx(target, vfWord(reg, lane));
+            }
+        }
+
+        // The registers the block writes, into the state (before a handler, at the epilogue).
+        void flushCache()
+        {
+            for (uint32_t s = 0; s < m_cachedCount; ++s)
+                if (m_cacheWrites[m_cached[s]])
+                    vmovups(stateOf(m_cached[s]), Xbyak::Xmm(6 + static_cast<int>(s)));
+        }
+
+        // A register a handler may have written, from the state again.
+        void reloadCached(uint32_t reg)
+        {
+            if (reg < 33u && cached(reg))
+                vmovups(cacheXmm(reg), stateOf(reg));
+        }
+
+        // writeVi(): sign-extends the low 16 bits of `value` into VI `reg`.
+        void storeVi(uint32_t reg, const Xbyak::Reg32 &value)
+        {
+            if (reg == 0u)
+                return;
+            movsx(value, value.cvt16());
+            mov(vi(reg), value);
+        }
+
+        // eax = (VI[base] + offset) * 16 & mask, or with the base as unsigned 16 bits.
+        void vuAddressSigned(uint32_t base, int32_t offset)
+        {
+            mov(eax, vi(base));
+            if (offset != 0)
+                add(eax, offset);
+            shl(eax, 4);
+            and_(eax, kJitDataMask);
+        }
+
+        void vuAddressUnsigned(uint32_t base)
+        {
+            movzx(eax, viWord(base));
+            shl(eax, 4);
+            and_(eax, kJitDataMask);
+        }
+
+        // storeToVu() with the address in eax: the plain write inline, a store into the
+        // packet of an XGKICK transfer in flight (Engine::kickWatch) through the handler.
+        void emitStore(const Xbyak::Xmm &value, uint8_t dest, uint32_t pc)
+        {
+            Xbyak::Label &slow = newLabel();
+            Xbyak::Label &done = newLabel();
+            mov(ecx, eax);
+            sub(ecx, dword[rbx + m_kickSource]);
+            and_(ecx, kJitDataMask);
+            cmp(ecx, dword[rbx + m_kickWatch]);
+            jb(slow);
+            if (dest == 0xFu)
+            {
+                vmovups(ptr[r12 + rax], value);
+            }
+            else if (dest != 0u)
+            {
+                vblendps(xmm2, value, ptr[r12 + rax], blendImm(static_cast<uint8_t>(~dest & 0xFu)));
+                vmovups(ptr[r12 + rax], xmm2);
+            }
+            L(done);
+            const bool upLive = m_upLive;
+            m_cold.push_back([this, &slow, &done, value, dest, pc, upLive]()
+                             {
+                                 L(slow);
+                                 vmovups(ptr[rsp + kStoreData], value);
+                                 spill(upLive);
+                                 mov(qword[rbx + m_cycle], r13);
+                                 mov(stateDword(offsetof(VU1State, pc)), pc);
+                                 mov(arg1().cvt32(), eax);
+                                 mov(arg0(), rbx);
+                                 lea(arg2(), ptr[rsp + kStoreData]);
+                                 mov(arg3().cvt32(), static_cast<uint32_t>(dest));
+                                 callFunction(reinterpret_cast<const void *>(&jitStore));
+                                 reload(upLive);
+                                 jmp(done); });
+        }
+
+        // pushFlag(): the next FIFO entry, ready kFmacLatency cycles from now, for a CLIP
+        // (`fmac` false: the clip flags in edx) or an FMAC instruction (MAC in r9d, status
+        // in r10d, extra sticky bits in r11d). A full FIFO is reported and the entry
+        // dropped, as pushFlag() does.
+        void emitPushFlag(bool fmac, uint32_t pc)
+        {
+            static_assert(offsetof(FlagEntry, writesStatus) == offsetof(FlagEntry, writesMac) + 1u &&
+                              offsetof(FlagEntry, writesSticky) == offsetof(FlagEntry, writesMac) + 2u &&
+                              offsetof(FlagEntry, writesClip) == offsetof(FlagEntry, writesMac) + 3u &&
+                              offsetof(FlagEntry, status) == offsetof(FlagEntry, mac) + 4u,
+                          "flag entry layout");
+            Xbyak::Label &full = newLabel();
+            Xbyak::Label &done = newLabel();
+            mov(ecx, dword[rbx + m_flagCount]);
+            cmp(ecx, 16);
+            jae(full);
+            mov(eax, dword[rbx + m_flagHead]);
+            add(eax, ecx);
+            and_(eax, 15);
+            imul(eax, eax, static_cast<int>(sizeof(FlagEntry)));
+            lea(rax, ptr[rbx + rax + m_flags]);
+            lea(r8, ptr[r13 + static_cast<int>(kFmacLatency)]);
+            mov(qword[rax + static_cast<int>(offsetof(FlagEntry, ready))], r8);
+            mov(qword[rax + static_cast<int>(offsetof(FlagEntry, issue))], r13);
+            if (fmac)
+            {
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, mac))], r9d);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, status))], r10d);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, extraSticky))], r11d);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, clip))], 0);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, writesMac))], 0x00000101); // MAC and status
+            }
+            else
+            {
+                mov(qword[rax + static_cast<int>(offsetof(FlagEntry, mac))], 0);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, extraSticky))], 0);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, clip))], edx);
+                mov(dword[rax + static_cast<int>(offsetof(FlagEntry, writesMac))], 0x01000000); // clip only
+            }
+            inc(ecx);
+            mov(dword[rbx + m_flagCount], ecx);
+            cmp(ecx, 1);
+            jne(done);
+            cmp(r8, qword[rbx + m_nextEvent]);
+            jae(done);
+            mov(qword[rbx + m_nextEvent], r8);
+            L(done);
+            m_cold.push_back([this, &full, &done, pc]()
+                             {
+                                 L(full);
+                                 flushCache(); // (a report can dump the state)
+                                 mov(qword[rbx + m_cycle], r13);
+                                 mov(stateDword(offsetof(VU1State, pc)), pc);
+                                 mov(arg0(), rbx);
+                                 callFunction(reinterpret_cast<const void *>(&jitFlagOverflow));
+                                 jmp(done); });
+        }
+
+        // upperClip(): fs.xyz against +-|ft.w| (an exponent of 0 counts as the smallest
+        // non-zero magnitude), six flags shifted into the working clip flags, which go
+        // down the flag pipeline. Runs before the pair, like the handler did.
+        void emitClip(const Pair &p, uint32_t pc)
+        {
+            loadVfLaneDword(eax, p.ft, 3u);
+            mov(ecx, eax);
+            and_(ecx, 0x7FFFFFFF);
+            mov(edx, 0x007FFFFF);
+            test(eax, 0x7F800000);
+            cmovz(ecx, edx);
+            vmovd(xmm1, ecx);
+            vpshufd(xmm1, xmm1, 0);
+            loadVf(xmm0, p.fs);
+            vpcmpgtd(xmm2, xmm0, xmm1);         // above +|w|
+            vpxor(xmm3, xmm0, constant(JcSign));
+            vpcmpgtd(xmm3, xmm3, xmm1);         // below -|w|
+            vpunpckldq(xmm4, xmm2, xmm3);       // x+ x- y+ y-
+            vpunpckhdq(xmm2, xmm2, xmm3);       // z+ z- w+ w-
+            vmovmskps(eax, xmm4);
+            vmovmskps(ecx, xmm2);
+            and_(ecx, 3);
+            shl(ecx, 4);
+            or_(eax, ecx);
+            mov(edx, dword[rbx + m_workingClip]);
+            shl(edx, 6);
+            or_(edx, eax);
+            and_(edx, 0xFFFFFF);
+            mov(dword[rbx + m_workingClip], edx);
+            emitPushFlag(false, pc);
+        }
+
+        // normScalar() on four lanes: exponent 255 reads as +-FLT_MAX, denormals as signed zeros.
+        void emitNormFull(const Xbyak::Xmm &v, const Xbyak::Xmm &t1, const Xbyak::Xmm &t2)
+        {
+            emitNorm(v, t1, t2);
+            vpand(t1, v, constant(JcExp));
+            vpxor(t2, t2, t2);
+            vpcmpeqd(t1, t1, t2);
+            vpand(t2, v, constant(JcSign));
+            vblendvps(v, v, t2, t1);
+        }
+
+        // classify() of the four doubles in `values` (lanes w z y x, so the masks come out
+        // in the flag registers' order): eax = zero (or underflow), ecx = sign, edx =
+        // underflow, r8d = overflow, `dest` lanes only. Uses ymm4, ymm5 and r9d.
+        void emitClassify(const Xbyak::Ymm &values, uint8_t dest)
+        {
+            const int limits = m_const + static_cast<int>(JcFlagLimits * 16u);
+            const int minimum = m_const + static_cast<int>(JcFlagMin * 16u);
+            vbroadcastsd(ymm4, qword[rbx + limits]); // -0.0
+            vandnpd(ymm5, ymm4, values);              // magnitude
+            vmovmskpd(ecx, values);
+            vxorpd(ymm4, ymm4, ymm4);
+            vcmppd(ymm4, ymm5, ymm4, 0x00);          // == 0
+            vmovmskpd(eax, ymm4);
+            vbroadcastsd(ymm4, qword[rbx + minimum]);
+            vcmppd(ymm4, ymm5, ymm4, 0x01);          // < FLT_MIN
+            vmovmskpd(edx, ymm4);
+            vbroadcastsd(ymm4, qword[rbx + limits + 8]);
+            vcmppd(ymm4, ymm5, ymm4, 0x0E);          // > FLT_MAX
+            vmovmskpd(r8d, ymm4);
+            mov(r9d, eax);
+            not_(r9d);
+            and_(edx, r9d); // underflow: below FLT_MIN but not zero
+            or_(eax, edx);  // which reads as zero too
+            and_(eax, dest);
+            and_(ecx, dest);
+            and_(edx, dest);
+            and_(r8d, dest);
+        }
+
+        // Z S U O status bits of the classify() masks into `out` (r10d), r9d as scratch.
+        void emitStatusBits(const Xbyak::Reg32 &out)
+        {
+            xor_(out, out);
+            test(eax, eax);
+            setnz(out.cvt8());
+            xor_(r9d, r9d);
+            test(ecx, ecx);
+            setnz(r9b);
+            lea(out, ptr[out.cvt64() + r9 * 2]);
+            xor_(r9d, r9d);
+            test(edx, edx);
+            setnz(r9b);
+            lea(out, ptr[out.cvt64() + r9 * 4]);
+            xor_(r9d, r9d);
+            test(r8d, r8d);
+            setnz(r9b);
+            lea(out, ptr[out.cvt64() + r9 * 8]);
+        }
+
+        // pushFmacFlags(): the MAC and status flags of the pair's FMAC result, from the
+        // exact result in double precision of the operands as the upper reads them (before
+        // the pair, like the handler did).
+        void emitFmacFlags(const Pair &p, uint32_t pc)
+        {
+            const bool outer = p.arith == AOpmula || p.arith == AOpmsub;
+            const bool productSum = p.arith == AMadd || p.arith == AMsub || p.arith == AOpmsub;
+            loadVf(xmm0, p.fs);
+            emitNormFull(xmm0, xmm2, xmm3);
+            switch (p.operand)
+            {
+            case OBc:
+                loadVfLane(xmm1, p.ft, p.bc);
+                break;
+            case OQ:
+                vbroadcastss(xmm1, stateDword(offsetof(VU1State, q)));
+                break;
+            case OI:
+                vbroadcastss(xmm1, stateDword(offsetof(VU1State, i)));
+                break;
+            default:
+                loadVf(xmm1, p.ft);
+                break;
+            }
+            emitNormFull(xmm1, xmm2, xmm3);
+            // Lanes w z y x (outer products: their cross terms in that order).
+            vpermilps(xmm0, xmm0, outer ? 0x63 : 0x1B); // w x z y : w z y x
+            vpermilps(xmm1, xmm1, outer ? 0x87 : 0x1B); // w y x z : w z y x
+            vcvtps2pd(ymm0, xmm0);
+            vcvtps2pd(ymm1, xmm1);
+            vmulpd(ymm2, ymm0, ymm1); // the product
+            if (productSum)
+            {
+                loadAcc(xmm3);
+                emitNormFull(xmm3, xmm4, xmm5);
+                vpermilps(xmm3, xmm3, 0x1B);
+                vcvtps2pd(ymm3, xmm3);
+            }
+            switch (p.arith)
+            {
+            case AAdd:
+                vaddpd(ymm3, ymm0, ymm1);
+                break;
+            case ASub:
+                vsubpd(ymm3, ymm0, ymm1);
+                break;
+            case AMul:
+                vmovapd(ymm3, ymm2);
+                break;
+            case AMadd:
+                vaddpd(ymm3, ymm3, ymm2);
+                break;
+            case AMsub:
+                vsubpd(ymm3, ymm3, ymm2);
+                break;
+            case AOpmula:
+                vxorpd(ymm4, ymm4, ymm4);
+                vblendpd(ymm3, ymm2, ymm4, 0x1); // w = +0
+                break;
+            case AOpmsub:
+                vsubpd(ymm3, ymm3, ymm2);
+                vxorpd(ymm4, ymm4, ymm4);
+                vblendpd(ymm3, ymm3, ymm4, 0x1); // w = +0
+                break;
+            default:
+                vxorpd(ymm3, ymm3, ymm3);
+                break;
+            }
+            const uint8_t dest = static_cast<uint8_t>(p.dest & 0xFu);
+            xor_(r11d, r11d);
+            if (productSum)
+            {
+                // Extra sticky bits from the product alone.
+                emitClassify(ymm2, dest);
+                emitStatusBits(r10d);
+                mov(r11d, r10d);
+            }
+            emitClassify(ymm3, dest);
+            emitStatusBits(r10d);
+            shl(ecx, 4);
+            shl(edx, 8);
+            shl(r8d, 12);
+            or_(eax, ecx);
+            or_(eax, edx);
+            or_(eax, r8d);
+            mov(r9d, eax);
+            vzeroupper();
+            emitPushFlag(true, pc);
+        }
+
+        // lowerDiv(): Q = fs.fsf / ft.ftf, 7 cycles from now (queueQ()). The block runs in
+        // the VU float mode (round to zero, FTZ, DAZ): denormal operands read as zero and
+        // the quotient never needs normResult() - overflow gives FLT_MAX, underflow 0.
+        void emitDiv(const Pair &p)
+        {
+            loadVfLane(xmm0, p.lfs, p.fsf);
+            loadVfLane(xmm1, p.lft, p.ftf);
+            if (!isFinite(p.lfs, laneBit(p.fsf)))
+                emitNorm(xmm0, xmm2, xmm3);
+            if (!isFinite(p.lft, laneBit(p.ftf)))
+                emitNorm(xmm1, xmm2, xmm3);
+            Xbyak::Label &byZero = newLabel();
+            Xbyak::Label &queue = newLabel();
+            vxorps(xmm2, xmm2, xmm2);
+            vucomiss(xmm1, xmm2);
+            je(byZero);
+            vdivss(xmm0, xmm0, xmm1);
+            xor_(ecx, ecx);
+            L(queue);
+            emitQueueQ(7u);
+            m_cold.push_back([this, &byZero, &queue]()
+                             {
+                                 // Division by zero: D (0/0: I) and +-FLT_MAX by the signs.
+                                 L(byZero);
+                                 mov(ecx, 0x20);
+                                 mov(edx, 0x10);
+                                 vucomiss(xmm0, xmm2);
+                                 cmove(ecx, edx);
+                                 vmovd(eax, xmm0);
+                                 vmovd(edx, xmm1);
+                                 xor_(eax, edx);
+                                 and_(eax, 0x80000000);
+                                 or_(eax, 0x7F7FFFFF);
+                                 vmovd(xmm0, eax);
+                                 jmp(queue); });
+        }
+
+        // queueQ() of the value in xmm0 with the D/I status bits in ecx, `latency` cycles
+        // from now.
+        void emitQueueQ(uint32_t latency)
+        {
+            mov(byte[rbx + m_qPending], 1);
+            lea(rax, ptr[r13 + static_cast<int>(latency)]);
+            mov(qword[rbx + m_qReady], rax);
+            vmovss(dword[rbx + m_qValue], xmm0);
+            mov(dword[rbx + m_qStatusDi], ecx);
+            Xbyak::Label &eventSet = newLabel();
+            Xbyak::Label &flushSet = newLabel();
+            cmp(rax, qword[rbx + m_nextEvent]);
+            jae(eventSet);
+            mov(qword[rbx + m_nextEvent], rax);
+            L(eventSet);
+            cmp(rax, qword[rbx + m_lastWriteReady]);
+            jbe(flushSet);
+            mov(qword[rbx + m_lastWriteReady], rax);
+            L(flushSet);
+        }
+
+        // lowerSqrt(): Q = sqrt(|ft.ftf|), 7 cycles from now; I for a negative operand. (A
+        // square root is never denormal or out of range: no normResult().)
+        void emitSqrt(const Pair &p)
+        {
+            loadVfLane(xmm1, p.lft, p.ftf);
+            if (!isFinite(p.lft, laneBit(p.ftf)))
+                emitNorm(xmm1, xmm2, xmm3);
+            xor_(ecx, ecx);
+            mov(edx, 0x10);
+            vxorps(xmm2, xmm2, xmm2);
+            vucomiss(xmm2, xmm1); // 0 > ft
+            cmova(ecx, edx);
+            vmovdqu(xmm3, constant(JcSign));
+            vandnps(xmm0, xmm3, xmm1);
+            vsqrtss(xmm0, xmm0, xmm0);
+            emitQueueQ(7u);
+        }
+
+        // lowerRsqrt(): Q = fs.fsf / sqrt(|ft.ftf|), 13 cycles from now; I for a negative
+        // radicand; a zero root as DIV's division by zero, by the numerator's sign alone.
+        void emitRsqrt(const Pair &p)
+        {
+            loadVfLane(xmm0, p.lfs, p.fsf);
+            loadVfLane(xmm1, p.lft, p.ftf);
+            if (!isFinite(p.lfs, laneBit(p.fsf)))
+                emitNorm(xmm0, xmm2, xmm3);
+            if (!isFinite(p.lft, laneBit(p.ftf)))
+                emitNorm(xmm1, xmm2, xmm3);
+            xor_(ecx, ecx);
+            mov(edx, 0x10);
+            vxorps(xmm2, xmm2, xmm2);
+            vucomiss(xmm2, xmm1); // 0 > ft
+            cmova(ecx, edx);
+            vmovdqu(xmm3, constant(JcSign));
+            vandnps(xmm3, xmm3, xmm1);
+            vsqrtss(xmm3, xmm3, xmm3);
+            Xbyak::Label &byZero = newLabel();
+            Xbyak::Label &queue = newLabel();
+            vucomiss(xmm3, xmm2);
+            je(byZero);
+            vdivss(xmm0, xmm0, xmm3);
+            L(queue);
+            emitQueueQ(13u);
+            m_cold.push_back([this, &byZero, &queue]()
+                             {
+                                 L(byZero);
+                                 mov(ecx, 0x20);
+                                 mov(edx, 0x10);
+                                 vucomiss(xmm0, xmm2);
+                                 cmove(ecx, edx);
+                                 vmovd(eax, xmm0);
+                                 and_(eax, 0x80000000);
+                                 or_(eax, 0x7F7FFFFF);
+                                 vmovd(xmm0, eax);
+                                 jmp(queue); });
+        }
+
+        // Lane 0 of `v` replaced by its reciprocal unless it is zero (xmm3 as scratch).
+        void emitReciprocalUnlessZero(const Xbyak::Xmm &v)
+        {
+            Xbyak::Label &zero = newLabel();
+            vxorps(xmm3, xmm3, xmm3);
+            vucomiss(v, xmm3);
+            je(zero);
+            vmovss(xmm3, dword[rbx + m_const + static_cast<int>(JcOne * 16u)]);
+            vdivss(v, xmm3, v);
+            L(zero);
+        }
+
+        // lowerEfu() for the instructions efuCode() names: P in xmm0, then queueP(). The
+        // same operations in the same order as the handlers (the sums left to right), in
+        // the VU float mode, which keeps every result finite and normal or zero: no
+        // normResult(). Denormal operands read as zero through DAZ; where the handler
+        // passes an operand on unchanged (ERCPR of zero) its clamped value is a signed zero.
+        void emitEfu(const Pair &p, uint32_t pc)
+        {
+            const uint8_t code = efuCode(p);
+            switch (code)
+            {
+            case 0x70u: // ESADD, ERSADD, ELENG, ERLENG: x*x + y*y + z*z, ...
+            case 0x71u:
+            case 0x72u:
+            case 0x73u:
+            {
+                const Xbyak::Xmm v = operandVf(xmm1, p.lfs, !isFinite(p.lfs, 0xEu));
+                vmulps(xmm1, v, v);
+                vmovshdup(xmm2, xmm1);
+                vaddss(xmm0, xmm1, xmm2);
+                vmovhlps(xmm2, xmm1, xmm1);
+                vaddss(xmm0, xmm0, xmm2);
+                if (code == 0x72u || code == 0x73u)
+                    vsqrtss(xmm0, xmm0, xmm0);
+                if (code == 0x71u || code == 0x73u)
+                    emitReciprocalUnlessZero(xmm0);
+                break;
+            }
+            case 0x76u: // ESUM: 0 + x + y + z + w
+            {
+                const Xbyak::Xmm v = operandVf(xmm1, p.lfs, !isFinite(p.lfs, 0xFu));
+                vxorps(xmm0, xmm0, xmm0);
+                vaddss(xmm0, xmm0, v);
+                vmovshdup(xmm2, v);
+                vaddss(xmm0, xmm0, xmm2);
+                vmovhlps(xmm2, v, v);
+                vaddss(xmm0, xmm0, xmm2);
+                vpermilps(xmm2, v, 0xFF);
+                vaddss(xmm0, xmm0, xmm2);
+                break;
+            }
+            default: // ESQRT, ERSQRT, ERCPR of fs.fsf
+            {
+                loadVfLane(xmm0, p.lfs, p.fsf);
+                if (!isFinite(p.lfs, laneBit(p.fsf)))
+                    emitNorm(xmm0, xmm2, xmm3);
+                Xbyak::Label &done = newLabel();
+                vxorps(xmm2, xmm2, xmm2);
+                if (code == 0x7Au)
+                {
+                    Xbyak::Label &zero = newLabel();
+                    vucomiss(xmm0, xmm2);
+                    je(zero);
+                    vmovss(xmm3, dword[rbx + m_const + static_cast<int>(JcOne * 16u)]);
+                    vdivss(xmm0, xmm3, xmm0);
+                    jmp(done);
+                    L(zero);
+                    vandps(xmm0, xmm0, constant(JcSign));
+                }
+                else
+                {
+                    vcomiss(xmm0, xmm2);
+                    jb(done); // negative: passed on
+                    vsqrtss(xmm0, xmm0, xmm0);
+                    if (code == 0x79u)
+                        emitReciprocalUnlessZero(xmm0);
+                }
+                L(done);
+                break;
+            }
+            }
+            emitQueueP(p, pc);
+        }
+
+        // queueP() of the value in xmm0: into the first free entry of the EFU pipeline; with
+        // none free the handler runs instead (to report it and stop).
+        void emitQueueP(const Pair &p, uint32_t pc)
+        {
+            const int stride = m_efuValid[1] - m_efuValid[0];
+            const uint32_t latency = p.efuLatency;
+            Xbyak::Label &found = newLabel();
+            Xbyak::Label &full = newLabel();
+            Xbyak::Label &done = newLabel();
+            xor_(ecx, ecx);
+            cmp(byte[rbx + m_efuValid[0]], 0);
+            je(found);
+            mov(ecx, stride);
+            cmp(byte[rbx + m_efuValid[1]], 0);
+            jne(full);
+            L(found);
+            mov(byte[rbx + rcx + m_efuValid[0]], 1);
+            lea(rax, ptr[r13 + static_cast<int>(latency)]);
+            mov(qword[rbx + rcx + m_efuReady[0]], rax);
+            vmovss(dword[rbx + rcx + m_efuValue[0]], xmm0);
+            lea(rdx, ptr[r13 + static_cast<int>(latency > 0u ? latency - 1u : 0u)]);
+            mov(qword[rbx + m_efuResourceReady], rdx);
+            Xbyak::Label &eventSet = newLabel();
+            cmp(rax, qword[rbx + m_nextEvent]);
+            jae(eventSet);
+            mov(qword[rbx + m_nextEvent], rax);
+            L(eventSet);
+            cmp(rax, qword[rbx + m_lastWriteReady]);
+            jbe(done);
+            mov(qword[rbx + m_lastWriteReady], rax);
+            L(done);
+            const bool upLive = m_upLive;
+            m_cold.push_back([this, &full, &done, &p, pc, upLive]()
+                             {
+                                 L(full);
+                                 callHandler(p.lower, p, pc, upLive);
+                                 jmp(done); });
+        }
+
+        // commitEvents() at cycle r13, then on to `back`. The commonest cases are committed
+        // here: one Q or P result due, or flag entries and nothing else (CLIP and FMAC
+        // flags); several kinds at once go through the function (PS2X_VU1_JIT_COMMIT=0:
+        // everything).
+        void emitCommit(Xbyak::Label &back)
+        {
+            static const bool inlined = []()
+            {
+                const char *env = std::getenv("PS2X_VU1_JIT_COMMIT");
+                return !env || env[0] != '0';
+            }();
+            Xbyak::Label &slow = newLabel();
+            if (inlined)
+            {
+                static_assert(offsetof(FlagEntry, writesStatus) == offsetof(FlagEntry, writesMac) + 1u &&
+                                  offsetof(FlagEntry, writesSticky) == offsetof(FlagEntry, writesMac) + 2u &&
+                                  offsetof(FlagEntry, writesClip) == offsetof(FlagEntry, writesMac) + 3u,
+                              "flag entry layout");
+                const int entrySize = static_cast<int>(sizeof(FlagEntry));
+                const int ready = m_flags + static_cast<int>(offsetof(FlagEntry, ready));
+                Xbyak::Label &commitQ = newLabel();
+                Xbyak::Label &commitP0 = newLabel();
+                Xbyak::Label &commitFlags = newLabel();
+                Xbyak::Label &update = newLabel();
+                // Due: bit 0 Q, bit 1 P entry 0, bit 2 P entry 1, bit 3 the flag FIFO's head.
+                xor_(edx, edx);
+                {
+                    Xbyak::Label &notDue = newLabel();
+                    cmp(dword[rbx + m_flagCount], 0);
+                    je(notDue);
+                    mov(eax, dword[rbx + m_flagHead]);
+                    imul(eax, eax, entrySize);
+                    cmp(r13, qword[rbx + rax + ready]);
+                    jb(notDue);
+                    or_(edx, 8);
+                    L(notDue);
+                }
+                {
+                    Xbyak::Label &notDue = newLabel();
+                    cmp(byte[rbx + m_qPending], 0);
+                    je(notDue);
+                    cmp(r13, qword[rbx + m_qReady]);
+                    jb(notDue);
+                    or_(edx, 1);
+                    L(notDue);
+                }
+                for (int k = 0; k < 2; ++k)
+                {
+                    Xbyak::Label &notDue = newLabel();
+                    cmp(byte[rbx + m_efuValid[k]], 0);
+                    je(notDue);
+                    cmp(r13, qword[rbx + m_efuReady[k]]);
+                    jb(notDue);
+                    or_(edx, 2 << k);
+                    L(notDue);
+                }
+                cmp(edx, 8);
+                je(commitFlags);
+                cmp(edx, 1);
+                je(commitQ);
+                cmp(edx, 2);
+                je(commitP0);
+                cmp(edx, 4);
+                jne(slow);
+                mov(eax, dword[rbx + m_efuValue[1]]);
+                mov(stateDword(offsetof(VU1State, p)), eax);
+                mov(byte[rbx + m_efuValid[1]], 0);
+                jmp(update);
+                L(commitP0);
+                mov(eax, dword[rbx + m_efuValue[0]]);
+                mov(stateDword(offsetof(VU1State, p)), eax);
+                mov(byte[rbx + m_efuValid[0]], 0);
+                jmp(update);
+                L(commitQ);
+                mov(eax, dword[rbx + m_qValue]);
+                mov(stateDword(offsetof(VU1State, q)), eax);
+                mov(eax, dword[rbx + m_qStatusDi]);
+                and_(eax, 0x30);
+                mov(ecx, stateDword(offsetof(VU1State, status)));
+                and_(ecx, 0xFCF);
+                or_(ecx, eax);
+                shl(eax, 6);
+                or_(ecx, eax);
+                mov(stateDword(offsetof(VU1State, status)), ecx);
+                mov(byte[rbx + m_qPending], 0);
+                jmp(update);
+
+                // The due entries of the flag FIFO, oldest first.
+                L(commitFlags);
+                {
+                    Xbyak::Label &entry = newLabel();
+                    Xbyak::Label &noMac = newLabel();
+                    Xbyak::Label &noStatus = newLabel();
+                    Xbyak::Label &noSticky = newLabel();
+                    Xbyak::Label &noClip = newLabel();
+                    L(entry);
+                    mov(eax, dword[rbx + m_flagHead]);
+                    imul(eax, eax, entrySize);
+                    lea(rax, ptr[rbx + rax + m_flags]);
+                    mov(ecx, dword[rax + static_cast<int>(offsetof(FlagEntry, writesMac))]); // the four writes*
+                    test(cl, cl);
+                    jz(noMac);
+                    mov(edx, dword[rax + static_cast<int>(offsetof(FlagEntry, mac))]);
+                    mov(stateDword(offsetof(VU1State, mac)), edx);
+                    L(noMac);
+                    test(ch, ch);
+                    jz(noStatus);
+                    mov(edx, dword[rax + static_cast<int>(offsetof(FlagEntry, status))]);
+                    and_(edx, 0xF);
+                    mov(r8d, dword[rax + static_cast<int>(offsetof(FlagEntry, extraSticky))]);
+                    or_(r8d, edx);
+                    shl(r8d, 6);
+                    mov(r9d, stateDword(offsetof(VU1State, status)));
+                    and_(r9d, 0xFF0);
+                    or_(r9d, edx);
+                    or_(r9d, r8d);
+                    mov(stateDword(offsetof(VU1State, status)), r9d);
+                    L(noStatus);
+                    test(ecx, 0x00FF0000);
+                    jz(noSticky);
+                    mov(edx, dword[rax + static_cast<int>(offsetof(FlagEntry, status))]);
+                    and_(edx, 0xFC0);
+                    mov(r9d, stateDword(offsetof(VU1State, status)));
+                    and_(r9d, 0x03F);
+                    or_(r9d, edx);
+                    mov(stateDword(offsetof(VU1State, status)), r9d);
+                    L(noSticky);
+                    test(ecx, 0xFF000000);
+                    jz(noClip);
+                    mov(edx, dword[rax + static_cast<int>(offsetof(FlagEntry, clip))]);
+                    mov(stateDword(offsetof(VU1State, clip)), edx);
+                    L(noClip);
+                    mov(eax, dword[rbx + m_flagHead]);
+                    inc(eax);
+                    and_(eax, 15);
+                    mov(dword[rbx + m_flagHead], eax);
+                    dec(dword[rbx + m_flagCount]);
+                    jz(update);
+                    imul(eax, eax, entrySize);
+                    cmp(r13, qword[rbx + rax + ready]);
+                    jae(entry);
+                }
+
+                // updateNextEvent().
+                L(update);
+                mov(rax, static_cast<uint64_t>(kNever));
+                {
+                    Xbyak::Label &skip = newLabel();
+                    cmp(dword[rbx + m_flagCount], 0);
+                    je(skip);
+                    mov(ecx, dword[rbx + m_flagHead]);
+                    imul(ecx, ecx, entrySize);
+                    mov(rax, qword[rbx + rcx + ready]);
+                    L(skip);
+                }
+                {
+                    Xbyak::Label &skip = newLabel();
+                    cmp(byte[rbx + m_qPending], 0);
+                    je(skip);
+                    cmp(rax, qword[rbx + m_qReady]);
+                    cmova(rax, qword[rbx + m_qReady]);
+                    L(skip);
+                }
+                for (int k = 0; k < 2; ++k)
+                {
+                    Xbyak::Label &skip = newLabel();
+                    cmp(byte[rbx + m_efuValid[k]], 0);
+                    je(skip);
+                    cmp(rax, qword[rbx + m_efuReady[k]]);
+                    cmova(rax, qword[rbx + m_efuReady[k]]);
+                    L(skip);
+                }
+                mov(qword[rbx + m_nextEvent], rax);
+                jmp(back);
+            }
+            L(slow);
+            mov(qword[rbx + m_cycle], r13);
+            mov(arg0(), rbx);
+            callFunction(reinterpret_cast<const void *>(&jitCommitEvents));
+            jmp(back);
+        }
+
+        // ---------------------------------------------------------------------------
+        // Stalls
+        // ---------------------------------------------------------------------------
+
+        void emitStallCheck(uint32_t i)
+        {
+            const Pair &p = *m_p[i];
+            if (m_emittingLoopHead ? m_loopRegCheck[i] : m_regCheck[i])
+            {
+                xor_(eax, eax);
+                bool vector = false;
+                for (uint32_t r = 0; r < p.readCount; ++r)
+                {
+                    const uint8_t reg = p.readReg[r];
+                    const uint8_t lanes = p.readLanes[r];
+                    if (laneCount(lanes) <= 2u)
+                    {
+                        for (uint32_t c = 0; c < 4u; ++c)
+                        {
+                            if (!(lanes & laneBit(c)))
+                                continue;
+                            mov(ecx, vfReady(reg, c));
+                            cmp(eax, ecx);
+                            cmovb(eax, ecx);
+                        }
+                        continue;
+                    }
+                    const Xbyak::Xmm &target = vector ? xmm1 : xmm0;
+                    if (lanes == 0xFu)
+                    {
+                        vmovdqu(target, ptr[rbx + m_vfReady + static_cast<int>(reg * 16u)]);
+                    }
+                    else
+                    {
+                        vmovdqu(target, constant(JcLanes + lanes));
+                        vpand(target, target, ptr[rbx + m_vfReady + static_cast<int>(reg * 16u)]);
+                    }
+                    if (vector)
+                        vpmaxud(xmm0, xmm0, xmm1);
+                    vector = true;
+                }
+                if (vector)
+                {
+                    vpshufd(xmm1, xmm0, 0x4E);
+                    vpmaxud(xmm0, xmm0, xmm1);
+                    vpshufd(xmm1, xmm0, 0xB1);
+                    vpmaxud(xmm0, xmm0, xmm1);
+                    vmovd(ecx, xmm0);
+                    cmp(eax, ecx);
+                    cmovb(eax, ecx);
+                }
+                for (uint32_t reads = p.viReads; reads != 0u; reads &= reads - 1u)
+                {
+                    uint32_t reg = 0;
+                    while (!(reads & (1u << reg)))
+                        ++reg;
+                    mov(ecx, dword[rbx + m_viReady + static_cast<int>(reg * 4u)]);
+                    cmp(eax, ecx);
+                    cmovb(eax, ecx);
+                }
+                add(rax, qword[rbx + m_cycleBase]);
+            }
+            else
+            {
+                xor_(eax, eax);
+            }
+
+            switch (p.resource)
+            {
+            case ResFdiv:
+            case ResWaitQ:
+            {
+                Xbyak::Label &skip = newLabel();
+                cmp(byte[rbx + m_qPending], 0);
+                je(skip);
+                mov(rcx, qword[rbx + m_qReady]);
+                cmp(rax, rcx);
+                cmovb(rax, rcx);
+                L(skip);
+                break;
+            }
+            case ResEfu:
+                mov(rcx, qword[rbx + m_efuResourceReady]);
+                cmp(rax, rcx);
+                cmovb(rax, rcx);
+                break;
+            case ResWaitP:
+                for (int k = 0; k < 2; ++k)
+                {
+                    Xbyak::Label &skip = newLabel();
+                    cmp(byte[rbx + m_efuValid[k]], 0);
+                    je(skip);
+                    mov(rcx, qword[rbx + m_efuReady[k]]);
+                    cmp(rax, rcx);
+                    cmovb(rax, rcx);
+                    L(skip);
+                }
+                break;
+            case ResXgkick:
+            {
+                Xbyak::Label &skip = newLabel();
+                cmp(byte[rbx + m_kickActive], 0);
+                je(skip);
+                mov(qword[rsp + kReady], rax);
+                mov(arg0(), rbx);
+                callFunction(reinterpret_cast<const void *>(&jitKickCompletion));
+                mov(rcx, qword[rsp + kReady]);
+                cmp(rax, rcx);
+                cmovb(rax, rcx);
+                L(skip);
+                break;
+            }
+            default:
+                break;
+            }
+
+            Xbyak::Label &stall = newLabel();
+            Xbyak::Label &resume = newLabel();
+            cmp(rax, r13);
+            ja(stall);
+            L(resume);
+            Xbyak::Label &exit = stallExit(i);
+            const uint32_t remaining = m_n - i;
+            m_cold.push_back([this, &stall, &resume, &exit, remaining]()
+                             {
+                                 L(stall);
+                                 // Past the budget: the interpreter stalls (or stops) there.
+                                 lea(rcx, ptr[rax + remaining]);
+                                 cmp(rcx, r14);
+                                 ja(exit);
+                                 mov(r13, rax);
+                                 cmp(r13, qword[rbx + m_nextEvent]);
+                                 jb(resume);
+                                 emitCommit(resume); });
+        }
+
+        // A block that goes round on itself counts on the lanes it reads before writing them
+        // being finite (m_entryChecked): if one is not, the interpreter runs its first pair.
+        void emitEntryCheck()
+        {
+            bool any = false;
+            for (uint32_t reg = 1; reg < 33u; ++reg)
+            {
+                const uint8_t lanes = m_entryChecked.vf[reg];
+                if (lanes == 0u)
+                    continue;
+                if (cached(reg))
+                {
+                    vpand(xmm0, cacheXmm(reg), constant(JcExp));
+                }
+                else
+                {
+                    vmovups(xmm0, stateOf(reg));
+                    vpand(xmm0, xmm0, constant(JcExp));
+                }
+                vpcmpeqd(xmm0, xmm0, constant(JcExp)); // exponent 255
+                if (lanes != 0xFu)
+                    vpand(xmm0, xmm0, constant(JcLanes + lanes));
+                if (any)
+                    vpor(xmm1, xmm1, xmm0);
+                else
+                    vmovdqa(xmm1, xmm0);
+                any = true;
+            }
+            if (any)
+            {
+                vptest(xmm1, xmm1);
+                jnz(stallExit(0u));
+            }
+            if (m_entryChecked.i)
+            {
+                mov(eax, stateDword(offsetof(VU1State, i)));
+                and_(eax, 0x7F800000);
+                cmp(eax, 0x7F800000);
+                je(stallExit(0u));
+            }
+        }
+
+        // Whether a block that ends goes on into the next compiled one itself rather than
+        // through run() (PS2X_VU1_JIT_CHAIN=0: never; nor while PS2X_VU1_PROFILE counts blocks).
+        static bool chaining()
+        {
+            static const bool enabled = []()
+            {
+                const char *env = std::getenv("PS2X_VU1_JIT_CHAIN");
+                return (!env || env[0] != '0') && std::getenv("PS2X_VU1_PROFILE") == nullptr;
+            }();
+            return enabled;
+        }
+
+        // At the end of the block, with state.pc the next pair and the state written back as
+        // for a return: goes on into the block compiled there when run() would call it next
+        // (no stop asked for, within the cycle budget), at its entry after the prologue's
+        // saves - every block has the same frame. Falls through otherwise.
+        void emitChain()
+        {
+            Xbyak::Label &no = newLabel();
+            mov(rax, qword[rbx + m_stop]);
+            cmp(byte[rax], 0);
+            jne(no);
+            mov(ecx, stateDword(offsetof(VU1State, pc)));
+            shr(ecx, 3);
+            imul(ecx, ecx, static_cast<int>(sizeof(JitSlot)));
+            add(rcx, qword[rbx + m_slots]);
+            cmp(byte[rcx + static_cast<int>(offsetof(JitSlot, state))], JitCompiled);
+            jne(no);
+            movzx(edx, word[rcx + static_cast<int>(offsetof(JitSlot, pairs))]);
+            add(rdx, r13);
+            cmp(rdx, r14);
+            ja(no);
+            flushCache();
+            mov(rax, qword[rcx + static_cast<int>(offsetof(JitSlot, chain))]);
+            jmp(rax);
+            L(no);
+        }
+
+        Xbyak::Label &stallExit(uint32_t k)
+        {
+            Xbyak::Label &label = newLabel();
+            m_stallExits.emplace_back(k, &label);
+            return label;
+        }
+
+        Xbyak::Label &stopExit(uint32_t k)
+        {
+            Xbyak::Label &label = newLabel();
+            m_stopExits.emplace_back(k, &label);
+            return label;
+        }
+
+        // ---------------------------------------------------------------------------
+        // Upper instructions (result in xmm5; returns whether it must be written back)
+        // ---------------------------------------------------------------------------
+
+        bool emitUpper(const Pair &p, uint32_t pc)
+        {
+            const bool writes = (p.upTarget == UtVf && p.upReg != 0u && p.dest != 0u) ||
+                                (p.upTarget == UtAcc && p.dest != 0u);
+            if (!writes)
+                return false;
+            if (!upperIsInline(p))
+            {
+                callHandler(p.upper, p, pc);
+                vmovups(xmm5, ptr[rbx + m_upResult]);
+                return true;
+            }
+            if (p.upper == &upperAbs)
+            {
+                const Xbyak::Xmm value = operandVf(xmm0, p.fs, !isFinite(p.fs, p.dest));
+                vmovdqu(xmm1, constant(JcSign));
+                vandnps(xmm5, xmm1, value);
+                vpand(xmm1, xmm5, constant(JcExp)); // denormals pass through as +0
+                vpxor(xmm2, xmm2, xmm2);
+                vpcmpeqd(xmm1, xmm1, xmm2);
+                vpandn(xmm5, xmm1, xmm5);
+                return true;
+            }
+            static const OpFn itofs[] = {&upperItof<0>, &upperItof<4>, &upperItof<12>, &upperItof<15>};
+            static const OpFn ftois[] = {&upperFtoi<0>, &upperFtoi<4>, &upperFtoi<12>, &upperFtoi<15>};
+            static const uint32_t itofScale[] = {0u, JcItof4, JcItof12, JcItof15};
+            static const uint32_t ftoiScale[] = {0u, JcFtoi4, JcFtoi12, JcFtoi15};
+            for (uint32_t k = 0; k < 4u; ++k)
+            {
+                if (p.upper == itofs[k])
+                {
+                    loadVf(xmm5, p.fs);
+                    vcvtdq2ps(xmm5, xmm5);
+                    if (k != 0u)
+                        vmulps(xmm5, xmm5, constant(itofScale[k]));
+                    return true;
+                }
+                if (p.upper == ftois[k])
+                {
+                    Xbyak::Xmm value = operandVf(xmm0, p.fs, !isFinite(p.fs, p.dest));
+                    if (k != 0u)
+                    {
+                        vmulps(xmm0, value, constant(ftoiScale[k]));
+                        value = xmm0;
+                    }
+                    vcvttps2dq(xmm1, value);
+                    vcmpps(xmm2, value, constant(JcFtoiLimit), 0x0D); // >= 2^31
+                    vblendvps(xmm5, xmm1, constant(JcIntMax), xmm2);
+                    return true;
+                }
+            }
+            emitArith(p);
+            return true;
+        }
+
+        void emitArith(const Pair &p)
+        {
+            const bool raw = p.arith == AMax || p.arith == AMini; // compared as bits
+            const uint8_t kept = keptLanes(p);
+            const Xbyak::Xmm a = operandVf(xmm0, p.fs, !raw && !isFinite(p.fs, kept));
+            Xbyak::Xmm b = xmm1;
+            switch (p.operand)
+            {
+            case OBc:
+                loadVfLane(xmm1, p.ft, p.bc);
+                if (!raw && !isFinite(p.ft, laneBit(p.bc)))
+                    emitNorm(xmm1, xmm2, xmm3);
+                break;
+            case OQ:
+                vbroadcastss(xmm1, stateDword(offsetof(VU1State, q)));
+                if (!raw)
+                    emitNorm(xmm1, xmm2, xmm3);
+                break;
+            case OI:
+                vbroadcastss(xmm1, stateDword(offsetof(VU1State, i)));
+                if (!raw && !isFinite(kRegI, 0xFu))
+                    emitNorm(xmm1, xmm2, xmm3);
+                break;
+            default:
+                b = operandVf(xmm1, p.ft, !raw && !isFinite(p.ft, kept));
+                break;
+            }
+            switch (p.arith)
+            {
+            case AAdd:
+                vaddps(xmm5, a, b);
+                break;
+            case ASub:
+                vsubps(xmm5, a, b);
+                break;
+            case AMul:
+                vmulps(xmm5, a, b);
+                break;
+            case AMadd:
+            case AMsub:
+            {
+                const Xbyak::Xmm acc = operandVf(xmm2, kAcc, !isFinite(kAcc, kept));
+                vmulps(xmm3, a, b);
+                if (p.arith == AMadd)
+                    vaddps(xmm5, acc, xmm3);
+                else
+                    vsubps(xmm5, acc, xmm3);
+                break;
+            }
+            case AMax:
+            case AMini:
+                vpmaxsd(xmm2, a, b);
+                vpminsd(xmm3, a, b);
+                vpand(xmm4, a, b);
+                vpsrad(xmm4, xmm4, 31);
+                if (p.arith == AMax)
+                    vpblendvb(xmm5, xmm2, xmm3, xmm4);
+                else
+                    vpblendvb(xmm5, xmm3, xmm2, xmm4);
+                break;
+            default: // OPMULA / OPMSUB
+                vshufps(xmm2, a, a, 0xC9); // y z x
+                vshufps(xmm3, b, b, 0xD2); // z x y
+                vmulps(xmm3, xmm2, xmm3);
+                if (p.arith == AOpmula)
+                {
+                    vandps(xmm5, xmm3, constant(JcXyz));
+                }
+                else
+                {
+                    const Xbyak::Xmm acc = operandVf(xmm2, kAcc, !isFinite(kAcc, kept));
+                    vsubps(xmm5, acc, xmm3);
+                    vandps(xmm5, xmm5, constant(JcXyz));
+                }
+                break;
+            }
+        }
+
+        // ---------------------------------------------------------------------------
+        // Lower instructions
+        // ---------------------------------------------------------------------------
+
+        // branchVi(): a branch right after an IALU write of the same VI reads its old value.
+        void loadBranchVi(uint32_t i, const Xbyak::Reg32 &target, uint8_t reg)
+        {
+            if (reg == 0u)
+            {
+                xor_(target, target);
+                return;
+            }
+            if (i > 0u)
+            {
+                const Pair &previous = *m_p[i - 1u];
+                if (backupProducer(previous) && previous.viWriteReg == reg)
+                    mov(target, dword[rsp + kBackup]);
+                else
+                    mov(target, vi(reg));
+                return;
+            }
+            Xbyak::Label &normal = newLabel();
+            Xbyak::Label &done = newLabel();
+            cmp(byte[rbx + m_backupValid], 0);
+            je(normal);
+            cmp(byte[rbx + m_backupReg], reg);
+            jne(normal);
+            mov(target, dword[rbx + m_backupValue]);
+            jmp(done);
+            L(normal);
+            mov(target, vi(reg));
+            L(done);
+        }
+
+        void emitBranch(uint32_t i, const Pair &p, uint32_t pc)
+        {
+            const uint32_t target = (pc + 8u + static_cast<uint32_t>(p.imm * 8)) & 0x3FFFu;
+            const uint32_t link = (pc + 16u) / 8u;
+            const auto conditional = [&](bool twoRegs, void (Xbyak::CodeGenerator::*takeIf)(const Xbyak::Reg &, const Xbyak::Operand &))
+            {
+                loadBranchVi(i, eax, p.lis);
+                movsx(eax, ax);
+                if (twoRegs)
+                {
+                    loadBranchVi(i, ecx, p.lit);
+                    movsx(ecx, cx);
+                }
+                mov(r15d, 0xFFFFFFFFu);
+                mov(edx, target);
+                if (twoRegs)
+                    cmp(eax, ecx);
+                else
+                    test(eax, eax);
+                (this->*takeIf)(r15d, edx);
+            };
+            if (p.lower == &lowerB)
+            {
+                mov(r15d, target);
+            }
+            else if (p.lower == &lowerBal)
+            {
+                mov(r15d, target);
+                if (p.lit != 0u)
+                    mov(vi(p.lit), link);
+            }
+            else if (p.lower == &lowerJr || p.lower == &lowerJalr)
+            {
+                loadBranchVi(i, eax, p.lis);
+                movzx(eax, ax);
+                shl(eax, 3);
+                and_(eax, 0x3FFFu);
+                mov(r15d, eax);
+                if (p.lower == &lowerJalr && p.lit != 0u)
+                    mov(vi(p.lit), link);
+            }
+            else if (p.lower == &lowerIbeq)
+                conditional(true, &Xbyak::CodeGenerator::cmove);
+            else if (p.lower == &lowerIbne)
+                conditional(true, &Xbyak::CodeGenerator::cmovne);
+            else if (p.lower == &lowerIbltz)
+                conditional(false, &Xbyak::CodeGenerator::cmovl);
+            else if (p.lower == &lowerIbgtz)
+                conditional(false, &Xbyak::CodeGenerator::cmovg);
+            else if (p.lower == &lowerIblez)
+                conditional(false, &Xbyak::CodeGenerator::cmovle);
+            else
+                conditional(false, &Xbyak::CodeGenerator::cmovge);
+        }
+
+        // `vfWrite`: false when the lower's VF write is discarded (the upper writes the
+        // same register in this pair).
+        void emitLower(uint32_t i, const Pair &p, uint32_t pc, bool vfWrite)
+        {
+            const OpFn fn = p.lower;
+            const bool loadsVf = vfWrite && p.lft != 0u && p.ldest != 0u;
+            if (fn == &lowerNop)
+                return;
+            if (p.flags & PfBranch)
+            {
+                emitBranch(i, p, pc);
+                return;
+            }
+            if (fn == &lowerLoi)
+            {
+                mov(stateDword(offsetof(VU1State, i)), p.lowerWord);
+            }
+            else if (fn == &lowerLq)
+            {
+                vuAddressSigned(p.lis, p.imm);
+                if (loadsVf)
+                {
+                    vmovups(xmm1, ptr[r12 + rax]);
+                    storeVf(p.lft, xmm1, p.ldest, xmm2);
+                }
+            }
+            else if (fn == &lowerSq)
+            {
+                vuAddressSigned(p.lit, p.imm);
+                loadVf(xmm1, p.lfs);
+                emitStore(xmm1, p.ldest, pc);
+            }
+            else if (fn == &lowerIlw || fn == &lowerIlwr)
+            {
+                if (fn == &lowerIlw)
+                    vuAddressSigned(p.lis, p.imm);
+                else
+                    vuAddressUnsigned(p.lis);
+                if (p.lit != 0u)
+                {
+                    movsx(ecx, word[r12 + rax + static_cast<int>(lane(p) * 4u)]);
+                    mov(vi(p.lit), ecx);
+                }
+            }
+            else if (fn == &lowerIsw || fn == &lowerIswr)
+            {
+                if (fn == &lowerIsw)
+                    vuAddressSigned(p.lis, p.imm);
+                else
+                    vuAddressUnsigned(p.lis);
+                movzx(ecx, viWord(p.lit));
+                vmovd(xmm1, ecx);
+                vpshufd(xmm1, xmm1, 0);
+                emitStore(xmm1, p.ldest, pc);
+            }
+            else if (fn == &lowerIaddiu || fn == &lowerIsubiu || fn == &lowerIaddi)
+            {
+                if (p.lit != 0u)
+                {
+                    mov(eax, vi(p.lis));
+                    if (fn == &lowerIsubiu)
+                        sub(eax, p.imm);
+                    else
+                        add(eax, p.imm);
+                    storeVi(p.lit, eax);
+                }
+            }
+            else if (fn == &lowerIadd || fn == &lowerIsub)
+            {
+                if (p.lid != 0u)
+                {
+                    mov(eax, vi(p.lis));
+                    if (fn == &lowerIadd)
+                        add(eax, vi(p.lit));
+                    else
+                        sub(eax, vi(p.lit));
+                    storeVi(p.lid, eax);
+                }
+            }
+            else if (fn == &lowerIand || fn == &lowerIor)
+            {
+                if (p.lid != 0u)
+                {
+                    mov(eax, vi(p.lis));
+                    if (fn == &lowerIand)
+                        and_(eax, vi(p.lit));
+                    else
+                        or_(eax, vi(p.lit));
+                    mov(vi(p.lid), eax);
+                }
+            }
+            else if (fn == &lowerMove || fn == &lowerMr32)
+            {
+                if (loadsVf)
+                {
+                    loadVf(xmm1, p.lfs);
+                    if (fn == &lowerMr32)
+                        vshufps(xmm1, xmm1, xmm1, 0x39); // y z w x
+                    storeVf(p.lft, xmm1, p.ldest, xmm2);
+                }
+            }
+            else if (fn == &lowerLqi || fn == &lowerLqd)
+            {
+                if (fn == &lowerLqd && p.lis != 0u)
+                {
+                    mov(eax, vi(p.lis));
+                    dec(eax);
+                    storeVi(p.lis, eax);
+                }
+                vuAddressUnsigned(p.lis);
+                if (loadsVf)
+                {
+                    vmovups(xmm1, ptr[r12 + rax]);
+                    storeVf(p.lft, xmm1, p.ldest, xmm2);
+                }
+                if (fn == &lowerLqi && p.lis != 0u)
+                {
+                    mov(eax, vi(p.lis));
+                    inc(eax);
+                    storeVi(p.lis, eax);
+                }
+            }
+            else if (fn == &lowerSqi || fn == &lowerSqd)
+            {
+                if (fn == &lowerSqd && p.lit != 0u)
+                {
+                    mov(eax, vi(p.lit));
+                    dec(eax);
+                    storeVi(p.lit, eax);
+                }
+                vuAddressUnsigned(p.lit);
+                loadVf(xmm1, p.lfs);
+                emitStore(xmm1, p.ldest, pc);
+                if (fn == &lowerSqi && p.lit != 0u)
+                {
+                    mov(eax, vi(p.lit));
+                    inc(eax);
+                    storeVi(p.lit, eax);
+                }
+            }
+            else if (fn == &lowerMtir)
+            {
+                if (p.lit != 0u)
+                {
+                    loadVfLaneWord(eax, p.lfs, p.fsf);
+                    mov(vi(p.lit), eax);
+                }
+            }
+            else if (fn == &lowerMfir)
+            {
+                if (loadsVf)
+                {
+                    movsx(eax, viWord(p.lis));
+                    vmovd(xmm1, eax);
+                    vpshufd(xmm1, xmm1, 0);
+                    storeVf(p.lft, xmm1, p.ldest, xmm2);
+                }
+            }
+            else if (fn == &lowerMfp)
+            {
+                if (loadsVf)
+                {
+                    vbroadcastss(xmm1, stateDword(offsetof(VU1State, p)));
+                    storeVf(p.lft, xmm1, p.ldest, xmm2);
+                }
+            }
+            else if (fn == &lowerXtop || fn == &lowerXitop)
+            {
+                if (p.lit != 0u)
+                {
+                    mov(eax, stateDword(fn == &lowerXtop ? offsetof(VU1State, top) : offsetof(VU1State, itop)));
+                    and_(eax, 0x3FFu);
+                    mov(vi(p.lit), eax);
+                }
+            }
+            else if (fn == &lowerFcand || fn == &lowerFceq || fn == &lowerFcor)
+            {
+                const uint32_t immediate = p.lowerWord & 0xFFFFFFu;
+                mov(eax, stateDword(offsetof(VU1State, clip)));
+                xor_(ecx, ecx);
+                if (fn == &lowerFcand)
+                {
+                    test(eax, immediate);
+                    setne(cl);
+                }
+                else if (fn == &lowerFceq)
+                {
+                    and_(eax, 0xFFFFFFu);
+                    cmp(eax, immediate);
+                    sete(cl);
+                }
+                else
+                {
+                    or_(eax, immediate);
+                    cmp(eax, 0xFFFFFFu);
+                    sete(cl);
+                }
+                mov(vi(1), ecx);
+            }
+            else if (fn == &lowerFcget)
+            {
+                if (p.lit != 0u)
+                {
+                    mov(eax, stateDword(offsetof(VU1State, clip)));
+                    and_(eax, 0xFFFu);
+                    mov(vi(p.lit), eax);
+                }
+            }
+            else if (fn == &lowerFsand || fn == &lowerFsor || fn == &lowerFseq)
+            {
+                if (p.lit != 0u)
+                {
+                    const uint32_t immediate = imm12(p);
+                    mov(eax, stateDword(offsetof(VU1State, status)));
+                    and_(eax, 0xFFFu);
+                    if (fn == &lowerFsand)
+                    {
+                        and_(eax, immediate);
+                    }
+                    else if (fn == &lowerFsor)
+                    {
+                        or_(eax, immediate);
+                    }
+                    else
+                    {
+                        xor_(ecx, ecx);
+                        cmp(eax, immediate);
+                        sete(cl);
+                        mov(eax, ecx);
+                    }
+                    mov(vi(p.lit), eax);
+                }
+            }
+            else if (fn == &lowerFmand || fn == &lowerFmor || fn == &lowerFmeq)
+            {
+                if (p.lit != 0u)
+                {
+                    movzx(ecx, viWord(p.lis));
+                    mov(eax, stateDword(offsetof(VU1State, mac)));
+                    if (fn == &lowerFmand)
+                    {
+                        and_(eax, ecx);
+                        storeVi(p.lit, eax);
+                    }
+                    else if (fn == &lowerFmor)
+                    {
+                        or_(eax, ecx);
+                        storeVi(p.lit, eax);
+                    }
+                    else
+                    {
+                        and_(eax, 0xFFFFu);
+                        xor_(edx, edx);
+                        cmp(eax, ecx);
+                        sete(dl);
+                        mov(vi(p.lit), edx);
+                    }
+                }
+            }
+            else if (fn == &lowerDiv)
+            {
+                emitDiv(p);
+            }
+            else if (inlineQp() && fn == &lowerSqrt)
+            {
+                emitSqrt(p);
+            }
+            else if (inlineQp() && fn == &lowerRsqrt)
+            {
+                emitRsqrt(p);
+            }
+            else if (efuCode(p) != 0u)
+            {
+                emitEfu(p, pc);
+            }
+            else
+            {
+                // Handler: SQRT/RSQRT, EFU, XGKICK, FCSET/FSSET, R register.
+                const bool keepUpper = !vfWrite && p.loWriteReg != 0u;
+                if (keepUpper && !cached(p.upReg))
+                {
+                    vmovups(xmm0, vf(p.upReg));
+                    vmovups(ptr[rsp + kShadow], xmm0);
+                }
+                callHandler(fn, p, pc);
+                if (keepUpper)
+                {
+                    // (cached: the register still has its value; the state gets it back)
+                    if (cached(p.upReg))
+                    {
+                        vmovups(vf(p.upReg), cacheXmm(p.upReg));
+                    }
+                    else
+                    {
+                        vmovups(xmm0, ptr[rsp + kShadow]);
+                        vmovups(vf(p.upReg), xmm0);
+                    }
+                }
+                else
+                {
+                    reloadCached(p.loWriteReg);
+                }
+            }
+        }
+
+        // ---------------------------------------------------------------------------
+        // Pairs and the block
+        // ---------------------------------------------------------------------------
+
+        void emitBookkeeping(uint32_t i, const Pair &p, bool loVfWrite)
+        {
+            const bool upVf = p.upTarget == UtVf && p.upReg != 0u && p.dest != 0u;
+            const bool loVf = loVfWrite && p.loWriteReg != 0u && p.loWriteLanes != 0u;
+            const bool recUp = upVf && recordVf(i, p.upReg, p.dest);
+            const bool recLo = loVf && recordVf(i, p.loWriteReg, p.loWriteLanes);
+            const bool recVi = p.viWriteReg != 0u && recordVi(i, p.viWriteReg);
+            if (recUp || recLo || recVi)
+            {
+                mov(edx, r13d);
+                sub(edx, dword[rbx + m_cycleBase]);
+            }
+            const auto lanes = [&](uint8_t reg, uint8_t mask, uint32_t latency)
+            {
+                lea(eax, ptr[rdx + static_cast<int>(latency)]);
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (mask & laneBit(c))
+                        mov(vfReady(reg, c), eax);
+            };
+            if (recUp)
+                lanes(p.upReg, p.dest, kFmacLatency);
+            if (recLo)
+                lanes(p.loWriteReg, p.loWriteLanes, p.loLatency);
+            if (recVi)
+            {
+                lea(eax, ptr[rdx + static_cast<int>(p.viLatency)]);
+                mov(dword[rbx + m_viReady + static_cast<int>(p.viWriteReg * 4u)], eax);
+            }
+            // lastWriteReady only decides when an ending program is flushed: writes with
+            // latency 1 never outlast the pair after them, and latency-4 writes only
+            // matter within three pairs of the point the block (or program) can end.
+            const bool longWrite = upVf || (loVf && p.loLatency > 1u) || (p.viWriteReg != 0u && p.viLatency > 1u);
+            if (longWrite && m_exitNear[i])
+            {
+                Xbyak::Label &skip = newLabel();
+                lea(rax, ptr[r13 + 4]);
+                cmp(rax, qword[rbx + m_lastWriteReady]);
+                jbe(skip);
+                mov(qword[rbx + m_lastWriteReady], rax);
+                L(skip);
+            }
+        }
+
+        void emitPair(uint32_t i)
+        {
+            const Pair &p = *m_p[i];
+            const uint32_t pc = m_pc0 + 8u * i;
+            m_finiteNow = m_emittingLoopHead ? &m_finiteHead[i] : &m_finite[i];
+
+            if (m_emittingLoopHead ? (m_loopRegCheck[i] || p.resource != ResNone) : m_check[i])
+                emitStallCheck(i);
+
+            // Flag producers read the state before the pair, like the upper itself.
+            if (p.flags & PfFmacFlags)
+                emitFmacFlags(p, pc);
+            if (p.upper == &upperClip)
+                emitClip(p, pc);
+
+            m_upLive = emitUpper(p, pc);
+
+            if (backupProducer(p))
+            {
+                mov(eax, vi(p.viWriteReg));
+                mov(dword[rsp + kBackup], eax);
+            }
+
+            // A lower write to the register the upper writes in the same pair is lost.
+            const bool loVfWrite = !((p.flags & PfShadow) && p.loWriteReg == p.upReg);
+            emitLower(i, p, pc, loVfWrite);
+
+            if (m_upLive)
+            {
+                if (p.upTarget == UtVf)
+                {
+                    storeVf(p.upReg, xmm5, p.dest, xmm0);
+                }
+                else
+                {
+                    storeAcc(xmm5, p.dest, xmm0);
+                }
+                m_upLive = false;
+            }
+
+            emitBookkeeping(i, p, loVfWrite);
+
+            if (p.flags & PfEBit)
+                mov(byte[rbp + st(offsetof(VU1State, ebit))], 1);
+
+            // The events due by the next cycle are committed before a pair that can see
+            // them, and before the block is left; the others wait (committing later changes
+            // nothing as long as nothing reads what they bring up to date).
+            inc(r13);
+            if (i + 1u >= m_n || needsEventsBefore(*m_p[i + 1u]))
+            {
+                Xbyak::Label &event = newLabel();
+                Xbyak::Label &back = newLabel();
+                cmp(r13, qword[rbx + m_nextEvent]);
+                jae(event);
+                L(back);
+                m_cold.push_back([this, &event, &back]()
+                                 {
+                                     L(event);
+                                     emitCommit(back); });
+            }
+
+            if (m_callsOut[i] && i + 1u < m_n)
+            {
+                mov(rax, qword[rbx + m_stop]);
+                cmp(byte[rax], 0);
+                jne(stopExit(i + 1u));
+            }
+        }
+
+        // Whether a pair reads or replaces what commitEvents() brings up to date - Q, P and
+        // the MAC, status and clip flags - or pushes onto the flag pipeline (16 entries), or
+        // runs a handler, which sees the whole state.
+        bool needsEventsBefore(const Pair &p) const
+        {
+            if (!upperIsInline(p) || !lowerIsInline(p))
+                return true;
+            if ((p.flags & PfFmacFlags) || p.upper == &upperClip)
+                return true;
+            if (p.upper == arithHandler(static_cast<Arith>(p.arith), static_cast<Operand>(p.operand)) && p.operand == OQ)
+                return true;
+            // (SQRT and RSQRT replace Q as DIV does; an EFU instruction takes a free entry
+            // of the P pipeline, which a due result still holds until committed.)
+            static const OpFn readers[] = {&lowerDiv, &lowerSqrt, &lowerRsqrt, &lowerMfp, &lowerFcand, &lowerFceq,
+                                           &lowerFcor, &lowerFcget, &lowerFsand, &lowerFsor, &lowerFseq, &lowerFmand,
+                                           &lowerFmor, &lowerFmeq};
+            return efuCode(p) != 0u || std::find(std::begin(readers), std::end(readers), p.lower) != std::end(readers);
+        }
+
+        // Whether the block ends with a branch (and its delay slot) whose target is the
+        // block's own first pair: b or a conditional branch, which link nothing.
+        bool loopsOnItself() const
+        {
+            if (m_n < 2u || m_endsProgram)
+                return false;
+            const Pair &p = *m_p[m_n - 2u];
+            if (!(p.flags & PfBranch))
+                return false;
+            const OpFn plain[] = {&lowerB, &lowerIbeq, &lowerIbne, &lowerIbltz, &lowerIbgtz, &lowerIblez, &lowerIbgez};
+            if (std::find(std::begin(plain), std::end(plain), p.lower) == std::end(plain))
+                return false;
+            const uint32_t pc = m_pc0 + 8u * (m_n - 2u);
+            return ((pc + 8u + static_cast<uint32_t>(p.imm * 8)) & 0x3FFFu) == m_pc0;
+        }
+
+        // The branch backup state for the pair after `last` (branchVi()).
+        void emitBackupState(uint32_t count)
+        {
+            if (count == 0u)
+                return;
+            const Pair &last = *m_p[count - 1u];
+            if (backupProducer(last))
+            {
+                mov(byte[rbx + m_backupValid], 1);
+                mov(byte[rbx + m_backupReg], last.viWriteReg);
+                mov(eax, dword[rsp + kBackup]);
+                mov(dword[rbx + m_backupValue], eax);
+            }
+            else
+            {
+                mov(byte[rbx + m_backupValid], 0);
+            }
+        }
+
+        // Leaves the block before pair k (k < m_n) with the interpreter's state there.
+        void emitExitBefore(uint32_t k, uint32_t code)
+        {
+            mov(stateDword(offsetof(VU1State, pc)), m_pc0 + 8u * k);
+            if (k > 0u && (m_p[k - 1u]->flags & PfBranch))
+            {
+                // Between the branch and its delay slot.
+                Xbyak::Label &notTaken = newLabel();
+                cmp(r15d, 0xFFFFFFFFu);
+                je(notTaken);
+                mov(byte[rbp + st(offsetof(VU1State, branchPending))], 1);
+                mov(stateDword(offsetof(VU1State, branchTarget)), r15d);
+                mov(stateDword(offsetof(VU1State, branchDelay)), 0);
+                L(notTaken);
+            }
+            emitBackupState(k);
+            mov(dword[rbx + m_sequential], 0);
+            mov(qword[rbx + m_cycle], r13);
+            mov(eax, code);
+            jmp(m_epilogue);
+        }
+
+        void emitBlock()
+        {
+            push(rbx);
+            push(rbp);
+            push(r12);
+            push(r13);
+            push(r14);
+            push(r15);
+            sub(rsp, kFrame);
+            // (blocks that go on into each other save and restore all of xmm6..xmm15: the
+            // last one restores what the first one saved)
+            const uint32_t saved = chaining() ? kCacheSlots : m_cachedCount;
+            for (uint32_t s = 0; s < saved; ++s)
+                vmovdqu(ptr[rsp + kXmmSave + static_cast<int>(16u * s)], Xbyak::Xmm(6 + static_cast<int>(s)));
+            mov(rbx, arg0());
+            mov(r14, arg1());
+            L(m_chainEntry);
+            mov(rbp, qword[rbx + m_st]);
+            mov(r12, qword[rbx + m_data]);
+            mov(r13, qword[rbx + m_cycle]);
+            mov(r15d, 0xFFFFFFFFu);
+            for (uint32_t s = 0; s < m_cachedCount; ++s)
+                vmovups(Xbyak::Xmm(6 + static_cast<int>(s)), stateOf(m_cached[s]));
+            emitEntryCheck();
+            L(m_loopEntry);
+
+            Xbyak::Label &afterHead = newLabel();
+            Xbyak::Label &loopHead = newLabel();
+            for (uint32_t i = 0; i < m_n; ++i)
+            {
+                if (m_loopHead && i == 3u)
+                    L(afterHead);
+                emitPair(i);
+            }
+
+            // End of the block.
+            const uint32_t lastPc = m_pc0 + 8u * (m_n - 1u);
+            const uint32_t fallThrough = lastPc + 8u >= kCodeBytes ? 0u : lastPc + 8u;
+            if (loopsOnItself())
+            {
+                // A branch back to the block's start that is taken goes round again here,
+                // as the run's loop would call the block again: within the budget, no stop
+                // asked for, the program not ending; with the state an exit leaves.
+                Xbyak::Label &leave = newLabel();
+                cmp(r15d, m_pc0);
+                jne(leave);
+                lea(rax, ptr[r13 + static_cast<int>(m_n)]);
+                cmp(rax, r14);
+                ja(leave);
+                mov(rax, qword[rbx + m_stop]);
+                cmp(byte[rax], 0);
+                jne(leave);
+                cmp(byte[rbp + st(offsetof(VU1State, ebit))], 0);
+                jne(leave);
+                cmp(byte[rbp + st(offsetof(VU1State, haltAfterDelaySlot))], 0);
+                jne(leave);
+                emitBackupState(m_n);
+                mov(dword[rbx + m_sequential], 0);
+                add(qword[rbx + m_loopPairs], static_cast<int>(m_n));
+                mov(r15d, 0xFFFFFFFFu);
+                if (m_loopHead)
+                    jmp(loopHead);
+                else
+                    jmp(m_loopEntry);
+                L(leave);
+            }
+            if (m_n >= 2u && (m_p[m_n - 2u]->flags & PfBranch))
+            {
+                mov(eax, fallThrough);
+                cmp(r15d, 0xFFFFFFFFu);
+                cmovne(eax, r15d);
+                mov(stateDword(offsetof(VU1State, pc)), eax);
+            }
+            else
+            {
+                mov(stateDword(offsetof(VU1State, pc)), fallThrough);
+            }
+            emitBackupState(m_n);
+            mov(dword[rbx + m_sequential], 0);
+            mov(qword[rbx + m_cycle], r13);
+            add(qword[rbx + m_loopPairs], static_cast<int>(m_n));
+            if (!m_endsProgram && chaining())
+                emitChain();
+            mov(eax, m_endsProgram ? JitProgramEnded : JitContinue);
+            L(m_epilogue);
+            flushCache();
+            for (uint32_t s = 0; s < saved; ++s)
+                vmovdqu(Xbyak::Xmm(6 + static_cast<int>(s)), ptr[rsp + kXmmSave + static_cast<int>(16u * s)]);
+            add(rsp, kFrame);
+            pop(r15);
+            pop(r14);
+            pop(r13);
+            pop(r12);
+            pop(rbp);
+            pop(rbx);
+            ret();
+
+            // The way round's copy of the first three pairs.
+            if (m_loopHead)
+            {
+                L(loopHead);
+                m_emittingLoopHead = true;
+                for (uint32_t i = 0; i < 3u; ++i)
+                    emitPair(i);
+                m_emittingLoopHead = false;
+                jmp(afterHead);
+            }
+
+            // Out-of-line paths (the cold list can grow while it is emitted).
+            for (size_t k = 0; k < m_cold.size(); ++k)
+                m_cold[k]();
+            for (const auto &[k, label] : m_stallExits)
+            {
+                L(*label);
+                emitExitBefore(k, JitInterpretOne);
+            }
+            for (const auto &[k, label] : m_stopExits)
+            {
+                L(*label);
+                emitExitBefore(k, JitContinue);
+            }
+        }
+    };
+
+    // Tells the system how to unwind through a compiled block, so that a debugger and the
+    // sampling profiler (TF_PROFILE_STACKS) can see who called the code a block calls.
+    // Every block has the frame of emitBlock: one entry describes the whole arena, and the
+    // few instructions of a block's prologue and epilogue pass for its body.
+    void jitDescribeFrames(JitArena &arena)
+    {
+#if defined(_WIN64)
+        struct UnwindInfo
+        {
+            uint8_t versionAndFlags;
+            uint8_t prologBytes;
+            uint8_t codeCount;
+            uint8_t frameRegister;
+            uint8_t codes[16]; // pairs of: offset in the prologue, operation | operand << 4
+        };
+        static_assert(sizeof(RUNTIME_FUNCTION) + sizeof(UnwindInfo) <= kJitArenaHeader, "the arena header holds the unwind data");
+        UnwindInfo info{};
+        info.versionAndFlags = 1u;
+        info.codeCount = 8u;
+        const auto code = [&](int index, unsigned operation, unsigned operand)
+        {
+            info.codes[index * 2] = 0u; // from the first instruction on
+            info.codes[index * 2 + 1] = static_cast<uint8_t>((operand << 4u) | operation);
+        };
+        // In the reverse order of the prologue: sub rsp, kFrame (more than 128 bytes: the
+        // size in 8-byte units in the next slot); push r15, r14, r13, r12, rbp, rbx. (The
+        // xmm registers a block saves in its frame need no entry to walk the stack.)
+        static_assert(JitBlockCompiler::kFrame % 8 == 0 && JitBlockCompiler::kFrame / 8 < 0x10000, "frame size");
+        code(0, 1u /* UWOP_ALLOC_LARGE */, 0u);
+        info.codes[2] = static_cast<uint8_t>((JitBlockCompiler::kFrame / 8) & 0xFF);
+        info.codes[3] = static_cast<uint8_t>((JitBlockCompiler::kFrame / 8) >> 8);
+        code(2, 0u /* UWOP_PUSH_NONVOL */, 15u);
+        code(3, 0u, 14u);
+        code(4, 0u, 13u);
+        code(5, 0u, 12u);
+        code(6, 0u, 5u);
+        code(7, 0u, 3u);
+        RUNTIME_FUNCTION function{};
+        function.BeginAddress = static_cast<DWORD>(kJitArenaHeader);
+        function.EndAddress = static_cast<DWORD>(arena.size);
+        function.UnwindData = static_cast<DWORD>(sizeof(RUNTIME_FUNCTION));
+        std::memcpy(arena.base, &function, sizeof(function));
+        std::memcpy(arena.base + sizeof(function), &info, sizeof(info));
+        arena.described = RtlAddFunctionTable(reinterpret_cast<PRUNTIME_FUNCTION>(arena.base), 1u,
+                                              reinterpret_cast<DWORD64>(arena.base)) != 0;
+#else
+        (void)arena;
+#endif
+    }
+
+    // Compiles the block that starts at `pc` into the engine's arena (or marks the pair
+    // for the interpreter).
+    void jitCompile(Engine &e, const uint8_t *code, uint32_t pc)
+    {
+        JitSlot &slot = e.image->slots[pc >> 3];
+        bool endsProgram = false;
+        const uint32_t count = jitBlockPairs(e, code, pc, endsProgram);
+        if (count == 0u)
+        {
+            slot.state = JitInterpret;
+            return;
+        }
+        if (!e.jit.memory)
+        {
+            e.jit.memory = std::make_unique<Xbyak::CodeGenerator>(kJitArenaBytes);
+            e.jit.base = const_cast<uint8_t *>(e.jit.memory->getCode());
+            e.jit.size = kJitArenaBytes;
+            e.jit.used = kJitArenaHeader;
+            jitDescribeFrames(e.jit);
+        }
+        for (int attempt = 0; attempt < 2; ++attempt)
+        {
+            uint8_t *where = e.jit.base + e.jit.used;
+            const size_t room = e.jit.size - e.jit.used;
+            try
+            {
+                JitBlockCompiler compiler(e, code, pc, count, endsProgram, where, room);
+                // PS2X_VU1_JIT_DUMP=<pc, hex> (debugging aid): the code compiled for the
+                // blocks that start there, to runs/vu1_jit_<pc>_<n>.bin.
+                static const long dumpPc = []()
+                {
+                    const char *env = std::getenv("PS2X_VU1_JIT_DUMP");
+                    return env ? std::strtol(env, nullptr, 16) : -1L;
+                }();
+                static uint32_t dumped = 0u;
+                if (dumpPc == static_cast<long>(pc) && dumped < 8u)
+                {
+                    char path[64];
+                    std::snprintf(path, sizeof(path), "runs/vu1_jit_%04x_%u.bin", pc, dumped++);
+                    if (std::FILE *file = std::fopen(path, "wb"))
+                    {
+                        std::fwrite(where, 1u, compiler.getSize(), file);
+                        std::fclose(file);
+                    }
+                }
+                e.jit.used += (compiler.getSize() + 15u) & ~size_t(15);
+                slot.fn = reinterpret_cast<JitBlockFn>(where);
+                slot.chain = compiler.chainEntry();
+                slot.pairs = static_cast<uint16_t>(count);
+                slot.state = JitCompiled;
+                return;
+            }
+            catch (const Xbyak::Error &error)
+            {
+                if (attempt == 0 && e.jit.used != kJitArenaHeader && error == Xbyak::ERR_CODE_IS_TOO_BIG)
+                {
+                    // Arena full: drop every compiled block and start over.
+                    for (const std::unique_ptr<CodeImage> &image : e.images)
+                        for (JitSlot &other : image->slots)
+                            if (other.state == JitCompiled)
+                                other = JitSlot{};
+                    e.jit.used = kJitArenaHeader;
+                    continue;
+                }
+                std::fprintf(stderr, "[vu1:jit] block at pc=0x%04x not compiled: %s\n", pc, error.what());
+                slot = JitSlot{};
+                slot.state = JitInterpret;
+                return;
+            }
+        }
+    }
