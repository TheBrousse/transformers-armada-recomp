+    // MAX and MINI compare operand bit patterns as sign-magnitude integers, without the
+    // FMAC operand normalization: games use them to move integer data (vertex colours)
+    // between fields, e.g. MAXw.xyz vf13, vf00, vf14w (as PCSX2's vuMax/vuMin).
+    int32_t vuMaxBits(int32_t a, int32_t b)
+    {
+        return (a < 0 && b < 0) ? std::min(a, b) : std::max(a, b);
+    }
+
+    int32_t vuMinBits(int32_t a, int32_t b)
+    {
+        return (a < 0 && b < 0) ? std::max(a, b) : std::min(a, b);
+    }
