+    void lowerXgkick(Engine &e, const Pair &p)
+    {
+        finishKick(e); // run() waited for the previous transfer to complete
+        startKick(e, static_cast<uint32_t>(static_cast<uint16_t>(e.st->vi[p.lis])));
+    }
+
+    float vuEatan(float value)
+    {
+        constexpr float coefficients[] = {
+            0.999999344348907f, -0.333298563957214f, 0.199465364217758f, -0.13085337519646f,
+            0.096420042216778f, -0.055909886956215f, 0.021861229091883f, -0.004054057877511f};
+        constexpr float quarterPi = 0.785398185253143f;
+        const float squared = value * value;
+        float polynomial = coefficients[7];
+        for (int index = 6; index >= 0; --index)
+            polynomial = coefficients[index] + squared * polynomial;
+        return quarterPi + value * polynomial;
+    }
+
+    float vuEsin(float value)
+    {
+        constexpr float coefficients[] = {
+            1.0f, -0.166666567325592f, 0.008333025500178f, -0.000198074136279f, 0.000002601886990f};
+        const float squared = value * value;
+        float polynomial = coefficients[4];
+        for (int index = 3; index >= 0; --index)
+            polynomial = coefficients[index] + squared * polynomial;
+        return value * polynomial;
+    }
+
+    float vuEexp(float value)
+    {
+        constexpr float coefficients[] = {
+            0.249998688697815f, 0.031257584691048f, 0.002591371303424f,
+            0.000171562001924f, 0.000005430199963f, 0.000000690600018f};
+        float polynomial = coefficients[5];
+        for (int index = 4; index >= 0; --index)
+            polynomial = coefficients[index] + value * polynomial;
+        polynomial = 1.0f + value * polynomial;
+        polynomial *= polynomial;
+        polynomial *= polynomial;
+        return polynomial != 0.0f ? 1.0f / polynomial : kFloatMax;
+    }
+
+    template <uint8_t Special>
+    void lowerEfu(Engine &e, const Pair &p)
+    {
+        const float *vs = e.st->vf[p.lfs];
+        const float x = normScalar(vs[0]), y = normScalar(vs[1]), z = normScalar(vs[2]);
+        const float component = normScalar(vs[p.fsf]);
+        float result = 0.0f;
+        if constexpr (Special == 0x70) // ESADD
+            result = x * x + y * y + z * z;
+        else if constexpr (Special == 0x71) // ERSADD
+        {
+            const float sum = x * x + y * y + z * z;
+            result = sum != 0.0f ? 1.0f / sum : sum;
+        }
+        else if constexpr (Special == 0x72) // ELENG
+            result = std::sqrt(x * x + y * y + z * z);
+        else if constexpr (Special == 0x73) // ERLENG
+        {
+            const float length = std::sqrt(x * x + y * y + z * z);
+            result = length != 0.0f ? 1.0f / length : length;
+        }
+        else if constexpr (Special == 0x74) // EATANxy
+            result = x != 0.0f ? vuEatan(y / x) : 0.0f;
+        else if constexpr (Special == 0x75) // EATANxz
+            result = x != 0.0f ? vuEatan(z / x) : 0.0f;
+        else if constexpr (Special == 0x76) // ESUM
+        {
+            float sum = 0.0f;
+            for (uint32_t c = 0; c < 4u; ++c)
+                sum += normScalar(vs[c]);
+            result = sum;
+        }
+        else if constexpr (Special == 0x78) // ESQRT
+            result = component >= 0.0f ? std::sqrt(component) : component;
+        else if constexpr (Special == 0x79) // ERSQRT
+        {
+            result = component;
+            if (result >= 0.0f)
+            {
+                result = std::sqrt(result);
+                if (result != 0.0f)
+                    result = 1.0f / result;
+            }
+        }
+        else if constexpr (Special == 0x7A) // ERCPR
+            result = component != 0.0f ? 1.0f / component : component;
+        else if constexpr (Special == 0x7C) // ESIN
+            result = vuEsin(component);
+        else if constexpr (Special == 0x7D) // EATAN
+            result = vuEatan(component);
+        else if constexpr (Special == 0x7E) // EEXP
+            result = vuEexp(component);
+        queueP(e, result, p.efuLatency);
+    }
