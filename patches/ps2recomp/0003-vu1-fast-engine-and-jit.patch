+
+    void lowerSqd(Engine &e, const Pair &p)
+    {
+        writeVi(e, p.lit, e.st->vi[p.lit] - 1);
+        const uint32_t address = (static_cast<uint32_t>(static_cast<uint16_t>(e.st->vi[p.lit])) * 16u) & e.dataMask;
+        uint32_t words[4];
