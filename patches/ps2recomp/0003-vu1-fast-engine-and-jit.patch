+// PS2X_VU1_VERIFY: every VU1 run executes on the reference interpreter and again on the
+// fast engine (ps2_vu1_fast.cpp) from the same starting state; differences are reported.
+static std::vector<uint8_t> *g_vu1ReferencePackets = nullptr;
+static bool g_vu1RunningReference = false;
