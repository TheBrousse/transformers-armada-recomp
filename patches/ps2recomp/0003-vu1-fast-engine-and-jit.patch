+// PS2X_VU1_WATCH=<first qword>[,<last qword>] (hex): logs every write to that range of VU1
+// data memory - VIF1 UNPACK and, with PS2X_VU1_REFERENCE=1, the microprogram's stores.
+bool ps2Vu1WatchHit(uint32_t qword)
+{
+    static const std::pair<uint32_t, uint32_t> range = []()
+    {
+        const char *env = std::getenv("PS2X_VU1_WATCH");
+        if (!env)
+            return std::pair<uint32_t, uint32_t>{1u, 0u};
+        char *end = nullptr;
+        const uint32_t first = static_cast<uint32_t>(std::strtoul(env, &end, 16));
+        return std::pair<uint32_t, uint32_t>{first, (end && *end == ',') ? static_cast<uint32_t>(std::strtoul(end + 1, nullptr, 16)) : first};
+    }();
+    return qword >= range.first && qword <= range.second;
+}
