+
+    NativeMode nativeMode()
+    {
+        static const NativeMode mode = []()
+        {
+            const char *env = std::getenv("PS2X_VU1_NATIVE");
+            if (env && env[0] == '0')
+                return NativeMode::Off;
+            if (env && std::strcmp(env, "check") == 0)
+                return NativeMode::Check;
+            return NativeMode::On;
+        }();
+        return mode;
