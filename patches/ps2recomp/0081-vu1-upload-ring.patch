@@ -324,6 +325,112 @@ bool g_ps2VifTraceActive = false;
 bool ps2Vu1WatchHit(uint32_t qword); // PS2X_VU1_WATCH (ps2_vu1_core.cpp)
 void ps2Vu1HistoryUnpack(uint32_t qword, uint32_t count); // PS2X_VU1_HISTORY (ps2_vu1_core.cpp)
 
+// VU1's microcode uploads and program starts, the last 256 of each (always on, a few stores each): what wrote the code
+// a program then ran, when VU1 meets a reserved instruction - ps2Vu1RingDump writes them to runs/vu1_uploads_<n>.txt
+// (the first 4 times in a session), beside PS2X_VU1_HISTORY's vu1_history.txt. Uploads: every MPG that changed the
+// code (with an FNV hash of its bytes) or was dropped (its data past the transfer); an unchanged upload only counted on
+// the last entry for the same place. Program starts: MSCAL / MSCALF / MSCNT, a run of the same start counted on one
+// entry. One sequence number orders both.
+namespace
+{
+    struct Vu1RingEntry
+    {
+        uint64_t seq;
+        uint32_t kind; // uploads: 0 changed, 1 dropped; starts: 0 MSCAL, 1 MSCALF, 2 MSCNT
+        uint32_t addr; // the code address (uploads: where; starts: the pc, ~0 for MSCNT)
+        uint32_t bytes;
+        uint32_t first;
+        uint32_t hash;
+        uint32_t count; // the same again (uploads unchanged since, starts repeated)
+        uint64_t lastSeq;
+    };
+    constexpr uint32_t kVu1Ring = 256u;
+    Vu1RingEntry g_vu1Uploads[kVu1Ring] = {}, g_vu1Starts[kVu1Ring] = {};
+    uint32_t g_vu1UploadsAt = 0u, g_vu1StartsAt = 0u;
+    uint64_t g_vu1RingSeq = 0u;
+
+    void vu1RingUpload(uint32_t kind, uint32_t addr, const uint8_t *data, uint32_t bytes)
+    {
+        const uint64_t seq = ++g_vu1RingSeq;
+        uint32_t hash = 2166136261u;
+        for (uint32_t i = 0; i < bytes; ++i)
+            hash = (hash ^ data[i]) * 16777619u;
+        uint32_t first = 0u;
+        if (bytes >= 4u)
+            std::memcpy(&first, data, 4u);
+        g_vu1Uploads[g_vu1UploadsAt++ % kVu1Ring] = Vu1RingEntry{seq, kind, addr, bytes, first, hash, 1u, seq};
+    }
+    // (an upload that changed nothing: the newest entry for that place counts it; otherwise no entry)
+    void vu1RingSame(uint32_t addr)
+    {
+        const uint64_t seq = ++g_vu1RingSeq;
+        if (g_vu1UploadsAt == 0u)
+            return;
+        Vu1RingEntry &e = g_vu1Uploads[(g_vu1UploadsAt - 1u) % kVu1Ring];
+        if (e.addr == addr)
+            ++e.count, e.lastSeq = seq;
+    }
+    void vu1RingStart(uint32_t kind, uint32_t pc)
+    {
+        const uint64_t seq = ++g_vu1RingSeq;
+        if (g_vu1StartsAt != 0u)
+        {
+            Vu1RingEntry &e = g_vu1Starts[(g_vu1StartsAt - 1u) % kVu1Ring];
+            if (e.kind == kind && e.addr == pc)
+            {
+                ++e.count, e.lastSeq = seq;
+                return;
+            }
+        }
+        g_vu1Starts[g_vu1StartsAt++ % kVu1Ring] = Vu1RingEntry{seq, kind, pc, 0u, 0u, 0u, 1u, seq};
+    }
+}
+
+void ps2Vu1RingDump(const char *reason, uint32_t pc, const uint8_t *code)
+{
+    static int dumps = 0;
+    if (dumps >= 4)
+        return;
+    const std::string name = "runs/vu1_uploads_" + std::to_string(++dumps) + ".txt";
+    std::FILE *file = std::fopen(name.c_str(), "w");
+    if (!file)
+        return;
+    std::fprintf(file, "%s at pc %04x (sequence %llu)\n", reason, pc, static_cast<unsigned long long>(g_vu1RingSeq));
+    if (code)
+    {
+        std::fprintf(file, "code around it:");
+        for (uint32_t a = (pc & 0x3FF8u) >= 32u ? (pc & 0x3FF8u) - 32u : 0u; a < (pc & 0x3FF8u) + 40u && a < 0x4000u; a += 4u)
+        {
+            uint32_t w = 0u;
+            std::memcpy(&w, code + a, 4u);
+            std::fprintf(file, "%s%08x", (a & 7u) ? " " : (a % 32u == 0u ? "\n  " : "  "), w);
+        }
+        std::fprintf(file, "\n");
+    }
+    std::fprintf(file, "uploads (oldest first): seq kind dest bytes first hash [unchanged again, to seq]\n");
+    for (uint32_t i = g_vu1UploadsAt > kVu1Ring ? g_vu1UploadsAt - kVu1Ring : 0u; i < g_vu1UploadsAt; ++i)
+    {
+        const Vu1RingEntry &e = g_vu1Uploads[i % kVu1Ring];
+        std::fprintf(file, "  %llu %s %04x %u %08x %08x", static_cast<unsigned long long>(e.seq), e.kind ? "DROPPED" : "changed", e.addr, e.bytes,
+                     e.first, e.hash);
+        if (e.count > 1u)
+            std::fprintf(file, " [%u, to %llu]", e.count - 1u, static_cast<unsigned long long>(e.lastSeq));
+        std::fprintf(file, "\n");
+    }
+    std::fprintf(file, "program starts (oldest first): seq kind pc [times, to seq]\n");
+    for (uint32_t i = g_vu1StartsAt > kVu1Ring ? g_vu1StartsAt - kVu1Ring : 0u; i < g_vu1StartsAt; ++i)
+    {
+        const Vu1RingEntry &e = g_vu1Starts[i % kVu1Ring];
+        std::fprintf(file, "  %llu %s %04x", static_cast<unsigned long long>(e.seq), e.kind == 0u ? "MSCAL" : e.kind == 1u ? "MSCALF" : "MSCNT",
+                     e.addr);
+        if (e.count > 1u)
+            std::fprintf(file, " [%u, to %llu]", e.count, static_cast<unsigned long long>(e.lastSeq));
+        std::fprintf(file, "\n");
+    }
+    std::fclose(file);
+    std::fprintf(stderr, "[VU1] %s at pc %04x: its last microcode uploads and program starts in %s\n", reason, pc, name.c_str());
+}
