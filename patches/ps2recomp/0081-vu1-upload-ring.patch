         else if (opcode == VIF_MSCAL || opcode == VIF_MSCALF)
         {
             uint32_t startPC = (uint32_t)imm * 8u;
+            vu1RingStart(opcode == VIF_MSCAL ? 0u : 1u, startPC);
 
             const uint32_t runTop = vif1_regs.tops & 0x3FFu;
             const uint32_t runItop = vif1_regs.itops & 0x3FFu;
@@ -692,6 +800,7 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
         }
         else if (opcode == VIF_MSCNT)
         {
+            vu1RingStart(2u, ~0u);
             const uint32_t runTop = vif1_regs.tops & 0x3FFu;
             const uint32_t runItop = vif1_regs.itops & 0x3FFu;
             vif1_regs.top = runTop;
@@ -753,12 +862,16 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
                         std::memcpy(m_vu1Code + destAddr, data + pos, copyBytes);
                         markVU1CodeModified();
                         ++g_ps2VifMpgChanged;
+                        vu1RingUpload(0u, destAddr, data + pos, copyBytes);
                     }
+                    else
+                        vu1RingSame(destAddr);
                     ++g_ps2VifMpgUploads;
                 }
                 else
                 {
                     ++g_ps2VifMpgDropped;
+                    vu1RingUpload(1u, destAddr, data + pos, static_cast<uint32_t>(std::min<uint64_t>(copyBytes, sizeBytes > pos ? sizeBytes - pos : 0u)));
                 }
             }
             pos += mpgBytes;
