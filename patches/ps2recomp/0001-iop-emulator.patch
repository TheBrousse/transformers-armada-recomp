+    {
+        m_registers.fill(0u);
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        for (Core &core : m_cores)
+            core = Core{};
+        for (ReverbHistory &history : m_reverb)
+            history = ReverbHistory{};
+        m_cycle = 0u;
+        m_outPosition = 0u;
+        m_finishedStreams = 0u;
+        m_interruptRaised[0] = m_interruptRaised[1] = false;
+        m_interruptPending = false;
+        m_output.clear();
+    }
+
+    uint32_t IopSpu2::pair(uint32_t offset) const noexcept
+    {
+        return static_cast<uint32_t>(reg(offset)) | (static_cast<uint32_t>(reg(offset + 2u)) << 16u);
+    }
+
+    uint32_t IopSpu2::addressPair(uint32_t offset) const noexcept
+    {
+        return ((static_cast<uint32_t>(reg(offset)) << 16u) | reg(offset + 2u)) & kAddressMask;
+    }
+
+    void IopSpu2::checkInterruptAddress(uint32_t address)
+    {
+        if (((reg(kAttributes) | reg(0x400u + kAttributes)) & kAttrInterrupt) == 0u)
+            return; // (neither core's interrupt on: the common case, several dozen times a sample)
+        // Either core reports an access to its address, whichever core made it.
+        for (int core = 0; core < 2; ++core)
+        {
+            const uint32_t base = static_cast<uint32_t>(core) * 0x400u;
+            if (m_interruptRaised[core] || (reg(base + kAttributes) & kAttrInterrupt) == 0u ||
+                addressPair(base + kInterruptAddress) != address)
+                continue;
+            m_interruptRaised[core] = true;
+            reg(kInterruptInfo) = static_cast<uint16_t>(reg(kInterruptInfo) | (4u << core));
+            m_interruptPending = true;
+        }
+    }
+
+    void IopSpu2::writeRam(uint32_t address, uint16_t value)
+    {
+        address &= kAddressMask;
+        checkInterruptAddress(address);
+        m_ram[address] = value;
+    }
+
+    void IopSpu2::writeCapture(uint32_t address, int32_t value)
+    {
+        address &= kAddressMask;
+        checkInterruptAddress(address);
+        m_ram[address] = static_cast<uint16_t>(clamp16(value));
+    }
+
+    void IopSpu2::setSlide(Slide &slide, uint16_t value)
+    {
+        slide.reg = value;
+        if ((value & 0x8000u) == 0u)
+            slide.value = static_cast<int16_t>(value << 1u); // 15 bits, signed
+        else
+            slide.counter = 0u;
+    }
+
+    void IopSpu2::stepSlide(Slide &slide)
+    {
+        if ((slide.reg & 0x8000u) == 0u)
+            return;
+        const bool decreasing = (slide.reg & 0x2000u) != 0u;
+        int step = 7 - static_cast<int>(slide.reg & 3u);
+        if (decreasing)
+            step = ~step;
+        stepLevel(slide.value, slide.counter, (slide.reg >> 2u) & 0x1Fu, step, (slide.reg & 0x4000u) != 0u, decreasing);
+    }
+
+    void IopSpu2::stepEnvelope(Voice &voice)
+    {
+        int shift = 0;
+        int step = 0;
+        bool exponential = false;
+        bool decreasing = false;
+        int32_t target = 0;
+        switch (voice.phase)
+        {
+        case Attack:
+        {
+            const int rate = (voice.adsr1 >> 8u) & 0x7Fu;
+            shift = rate >> 2;
+            step = 7 - (rate & 3);
+            exponential = (voice.adsr1 & 0x8000u) != 0u;
+            target = 0x7FFF;
+            break;
+        }
+        case Decay:
+            shift = (voice.adsr1 >> 4u) & 0xFu;
+            step = -8;
+            exponential = true;
+            decreasing = true;
+            target = static_cast<int32_t>((voice.adsr1 & 0xFu) + 1u) << 11;
+            break;
+        case Sustain:
+        {
+            const int rate = (voice.adsr2 >> 6u) & 0x7Fu;
+            shift = rate >> 2;
+            step = 7 - (rate & 3);
+            exponential = (voice.adsr2 & 0x8000u) != 0u;
+            decreasing = (voice.adsr2 & 0x4000u) != 0u;
+            if (decreasing)
+                step = ~step;
+            break;
+        }
+        case Release:
+            shift = voice.adsr2 & 0x1Fu;
+            step = -8;
+            exponential = (voice.adsr2 & 0x20u) != 0u;
+            decreasing = true;
+            break;
+        default:
+            return;
+        }
+
+        stepLevel(voice.envelope, voice.envelopeCounter, shift, step, exponential, decreasing);
+
+        if (voice.phase == Sustain)
+        {
+            // Sustain lasts until the key is released, or until it has faded out.
+            if (voice.envelope == 0 && decreasing)
+                voice.phase = Stopped;
+            return;
+        }
+        if (decreasing ? voice.envelope <= target : voice.envelope >= target)
+        {
+            if (voice.phase == Release)
+            {
+                voice.phase = Stopped;
+                voice.envelope = 0;
+            }
+            else
+            {
+                ++voice.phase;
+            }
+        }
+    }
+
+    void IopSpu2::keyOn(int coreIndex, int voiceIndex)
+    {
+        Core &core = m_cores[coreIndex];
+        Voice &voice = core.voices[voiceIndex];
+        voice.phase = Attack;
+        voice.envelope = 0;
+        voice.envelopeCounter = 0u;
+        voice.flags = 0u;
+        voice.loopWritten = 0u;
+        voice.loop = voice.start & kBlockMask;
+        // The first block is the one after "the block before the start".
+        voice.block = ((voice.start & kBlockMask) - 8u) & kBlockMask;
+        voice.next = voice.start & kBlockMask;
+        voice.position = 28u;
+        voice.counter = 0u;
+        voice.previous1 = voice.previous2 = 0;
+        std::fill(std::begin(voice.history), std::end(voice.history), int16_t{0});
+        voice.out = 0;
+        core.endx &= ~(1u << voiceIndex);
+    }
+
+    void IopSpu2::keyOff(int coreIndex, int voiceIndex)
+    {
+        Voice &voice = m_cores[coreIndex].voices[voiceIndex];
+        if (voice.phase != Stopped)
+            voice.phase = Release;
+    }
+
+    void IopSpu2::decodeBlock(Voice &voice)
+    {
+        static constexpr int32_t kFilters[16][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+        const uint16_t header = m_ram[voice.block & kAddressMask];
+        const int shift = (header & 0xFu) + 16;
+        const int32_t filter1 = kFilters[(header >> 4u) & 0xFu][0];
+        const int32_t filter2 = kFilters[(header >> 4u) & 0xFu][1];
+        int32_t previous1 = voice.previous1;
+        int32_t previous2 = voice.previous2;
+        for (uint32_t i = 0; i < 28u; ++i)
+        {
+            const uint16_t word = m_ram[(voice.block + 1u + (i >> 2u)) & kAddressMask];
+            const uint32_t nibble = (word >> ((i & 3u) * 4u)) & 0xFu;
+            const int32_t delta = static_cast<int32_t>(nibble << 28u) >> shift;
+            const int32_t sample = clamp16(delta + ((filter1 * previous1 + filter2 * previous2 + 32) >> 6));
+            voice.decoded[i] = static_cast<int16_t>(sample);
+            previous2 = previous1;
+            previous1 = sample;
+        }
+        voice.previous1 = static_cast<int16_t>(previous1);
+        voice.previous2 = static_cast<int16_t>(previous2);
+    }
+
+    void IopSpu2::nextSample(int coreIndex, int voiceIndex)
+    {
+        Core &core = m_cores[coreIndex];
+        Voice &voice = core.voices[voiceIndex];
+        if (voice.position >= 28u)
+        {
+            uint32_t block = (voice.block + 8u) & kBlockMask;
+            if ((voice.flags & kBlockEnd) != 0u)
+            {
+                core.endx |= 1u << voiceIndex;
+                block = voice.loop & kBlockMask;
+                if ((voice.flags & kBlockRepeat) == 0u)
+                {
+                    voice.phase = Stopped;
+                    voice.envelope = 0;
+                    voice.next = block;
+                    voice.flags = 0u;
+                    voice.block = (block - 8u) & kBlockMask;
+                    return;
+                }
+            }
+            voice.block = block;
+            checkInterruptAddress(block);
+            voice.flags = static_cast<uint8_t>(m_ram[block] >> 8u);
+            if ((voice.flags & kBlockLoopStart) != 0u && voice.loopWritten == 0u)
+                voice.loop = block;
+            decodeBlock(voice);
+            voice.position = 0u;
+        }
+        if ((voice.position & 3u) == 0u)
+        {
+            voice.next = (voice.block + 1u + (voice.position >> 2u)) & kAddressMask;
+            checkInterruptAddress(voice.next);
+        }
+        voice.history[0] = voice.history[1];
+        voice.history[1] = voice.history[2];
+        voice.history[2] = voice.history[3];
+        voice.history[3] = voice.decoded[voice.position++];
+    }
+
+    void IopSpu2::mixVoices(int coreIndex, int32_t &dryLeft, int32_t &dryRight, int32_t &wetLeft, int32_t &wetRight)
+    {
+        static const bool cubic = []()
+        {
+            const char *value = std::getenv("PS2X_SPU2_INTERPOLATION");
+            return value != nullptr && std::strcmp(value, "cubic") == 0;
+        }();
+        Core &core = m_cores[coreIndex];
+        const uint32_t base = static_cast<uint32_t>(coreIndex) * 0x400u;
+        const uint32_t modulated = pair(base + kPitchModulation);
+        const uint32_t noisy = pair(base + kNoise);
+        const uint32_t toLeft = pair(base + kMixLeft);
+        const uint32_t toRight = pair(base + kMixRight);
+        const uint32_t toWetLeft = pair(base + kWetLeft);
+        const uint32_t toWetRight = pair(base + kWetRight);
+
+        if (noisy != 0u)
+        {
+            const uint32_t clock = (reg(base + kAttributes) >> 8u) & 0x3Fu;
+            core.noiseTimer -= static_cast<int32_t>(4u + (clock & 3u));
+            if (core.noiseTimer < 0)
+            {
+                const uint32_t level = core.noiseLevel;
+                const uint32_t parity = ((level >> 15u) ^ (level >> 12u) ^ (level >> 11u) ^ (level >> 10u) ^ 1u) & 1u;
+                core.noiseLevel = ((level << 1u) | parity) & 0xFFFFu;
+                const int32_t reload = static_cast<int32_t>(0x20000u >> (clock >> 2u));
+                core.noiseTimer += reload;
+                if (core.noiseTimer < 0)
+                    core.noiseTimer += reload;
+            }
+        }
+
+        int32_t previousOut = 0;
+        for (int index = 0; index < 24; ++index)
+        {
+            Voice &voice = core.voices[index];
+            if (voice.phase == Stopped)
+            {
+                previousOut = voice.out = 0;
+                continue;
+            }
+
+            uint32_t step = voice.pitch;
+            if (index > 0 && ((modulated >> index) & 1u) != 0u)
+                step = static_cast<uint32_t>((static_cast<int64_t>(step) * (0x8000 + previousOut)) >> 15);
+            voice.counter += std::min<uint32_t>(step, 0x3FFFu);
+            while (voice.counter >= 0x1000u && voice.phase != Stopped)
+            {
+                voice.counter -= 0x1000u;
+                nextSample(coreIndex, index);
+            }
+            if (voice.phase == Stopped)
+            {
+                previousOut = voice.out = 0;
+                continue;
+            }
+
+            int32_t sample = ((noisy >> index) & 1u) != 0u ? static_cast<int16_t>(core.noiseLevel)
+                             : cubic                       ? interpolateCubic(voice.history, voice.counter)
+                                                           : interpolate(voice.history, voice.counter);
+            stepEnvelope(voice);
+            sample = (sample * voice.envelope) >> 15;
+            previousOut = voice.out = sample;
+
+            stepSlide(voice.volumeLeft);
+            stepSlide(voice.volumeRight);
+            const int32_t left = (sample * voice.volumeLeft.value) >> 15;
+            const int32_t right = (sample * voice.volumeRight.value) >> 15;
+            if (((toLeft >> index) & 1u) != 0u)
+                dryLeft += left;
+            if (((toRight >> index) & 1u) != 0u)
+                dryRight += right;
+            if (((toWetLeft >> index) & 1u) != 0u)
+                wetLeft += left;
+            if (((toWetRight >> index) & 1u) != 0u)
+                wetRight += right;
+        }
+        writeCapture(kCaptureVoice1[coreIndex] + m_outPosition, core.voices[1].out);
+        writeCapture(kCaptureVoice3[coreIndex] + m_outPosition, core.voices[3].out);
+    }
+
+    void IopSpu2::reverb(int coreIndex, int32_t inLeft, int32_t inRight, int32_t &outLeft, int32_t &outRight)
+    {
+        ReverbHistory &history = m_reverb[coreIndex];
+        const uint32_t base = static_cast<uint32_t>(coreIndex) * 0x400u;
+        const uint32_t volumes = kCoreVolumes + static_cast<uint32_t>(coreIndex) * kCoreVolumesStep;
+
+        // Both channels' input every sample; the effect takes one channel a sample, left then
+        // right, and gives back that channel's sample (zeros between, for the output filter).
+        history.position = (history.position + 1u) & 63u;
+        const uint32_t at = history.position;
+        history.input[0][at] = history.input[0][at + 64u] = static_cast<int16_t>(inLeft);
+        history.input[1][at] = history.input[1][at + 64u] = static_cast<int16_t>(inRight);
+        const uint64_t sample = m_cycle / kCyclesPerSample;
+        const uint32_t right = static_cast<uint32_t>(sample & 1u);
+        const uint32_t first = (at - 38u) & 63u; // (the filters read 39 in a row from here)
+
+        const uint32_t start = addressPair(base + kEffectStart);
+        const uint32_t end = ((static_cast<uint32_t>(reg(base + kEffectEnd)) & 0xFu) << 16u) | 0xFFFFu;
+        int32_t value = 0;
+        if (start != 0u && end > start)
+        {
+            const auto coefficient = [&](uint32_t which) { return static_cast<int32_t>(static_cast<int16_t>(reg(volumes + which))); };
+            const auto offset = [&](uint32_t which) { return static_cast<int64_t>(addressPair(base + kEffectAddresses + which * 4u)); };
+            // An address relative to the area's position (a word further every second sample),
+            // wrapped within the area.
+            const int64_t size = static_cast<int64_t>(end - start) + 1;
+            const int64_t position = static_cast<int64_t>((sample >> 1u) % static_cast<uint64_t>(size));
+            const auto address = [&](int64_t relative)
+            {
+                int64_t within = position + relative;
+                if (within >= size || within < 0)
+                {
+                    within %= size;
+                    if (within < 0)
+                        within += size;
+                }
+                return (start + static_cast<uint32_t>(within)) & kAddressMask;
+            };
+            const auto read = [&](int64_t relative)
+            {
+                const uint32_t where = address(relative);
+                checkInterruptAddress(where);
+                return static_cast<int32_t>(static_cast<int16_t>(m_ram[where]));
+            };
+            // With ATTR bit 7 clear the writes become reads: nothing is stored.
+            const bool writes = (reg(base + kAttributes) & kAttrEffects) != 0u;
+            const auto write = [&](int64_t relative, int32_t written)
+            {
+                const uint32_t where = address(relative);
+                checkInterruptAddress(where);
+                if (writes)
+                    m_ram[where] = static_cast<uint16_t>(written);
+            };
+            const auto mul = [](int32_t a, int32_t b) { return (a * b) >> 15; };
+
+            const int32_t in = clamp16(mul(clamp16(reverbFilter(&history.input[right][first]) >> 15),
+                                           coefficient(right != 0u ? vRIN : vLIN)));
+
+            // In the hardware's order of accesses (psx-spx, "Reverb Computation Order"), every
+            // step saturated to 16 bits. vIIR at -8000h negates what the reflections store.
+            const int32_t iir = coefficient(vIIR), wall = coefficient(vWALL);
+            const auto reflect = [&](int32_t input, int32_t reflected, int32_t previous)
+            {
+                const int32_t mixed = clamp16(input + mul(reflected, wall));
+                const int32_t stored = clamp16(mul(clamp16(mixed - previous), iir) + previous);
+                return iir == -0x8000 ? clamp16(-stored) : stored;
+            };
+            const int64_t sameDst = offset(right != 0u ? mRSAME : mLSAME);
+            const int64_t diffDst = offset(right != 0u ? mRDIFF : mLDIFF);
+            const int32_t sameSrc = read(offset(right != 0u ? dRSAME : dLSAME));
+            const int32_t samePrev = read(sameDst - 1);
+            const int32_t diffSrc = read(offset(right != 0u ? dLDIFF : dRDIFF)); // (the other side's)
+            write(sameDst, reflect(in, sameSrc, samePrev));
+            const int32_t diffPrev = read(diffDst - 1);
+            const int32_t comb1 = read(offset(right != 0u ? mRCOMB1 : mLCOMB1));
+            write(diffDst, reflect(in, diffSrc, diffPrev));
+            const int32_t comb2 = read(offset(right != 0u ? mRCOMB2 : mLCOMB2));
+            const int32_t comb3 = read(offset(right != 0u ? mRCOMB3 : mLCOMB3));
+            const int32_t comb4 = read(offset(right != 0u ? mRCOMB4 : mLCOMB4));
+            const int64_t apf1Dst = offset(right != 0u ? mRAPF1 : mLAPF1);
+            const int64_t apf2Dst = offset(right != 0u ? mRAPF2 : mLAPF2);
+            const int32_t apf1Old = read(apf1Dst - offset(dAPF1));
+            const int32_t apf2Old = read(apf2Dst - offset(dAPF2));
+
+            int32_t out = clamp16(mul(comb1, coefficient(vCOMB1)) + mul(comb2, coefficient(vCOMB2)) +
+                                  mul(comb3, coefficient(vCOMB3)) + mul(comb4, coefficient(vCOMB4)));
+            const int32_t apf1Volume = coefficient(vAPF1), apf2Volume = coefficient(vAPF2);
+            const int32_t apf1 = clamp16(out - mul(apf1Volume, apf1Old));
+            out = clamp16(mul(apf1, apf1Volume) + apf1Old);
+            const int32_t apf2 = clamp16(out - mul(apf2Volume, apf2Old));
+            out = clamp16(mul(apf2, apf2Volume) + apf2Old);
+            write(apf1Dst, apf1);
+            write(apf2Dst, apf2);
+            value = out;
+        }
+
+        history.output[right][at] = history.output[right][at + 64u] = static_cast<int16_t>(value);
+        history.output[right ^ 1u][at] = history.output[right ^ 1u][at + 64u] = 0;
+        // (twice the filter's gain: every other sample of each channel is a zero)
+        outLeft = clamp16(reverbFilter(&history.output[0][first]) >> 14);
+        outRight = clamp16(reverbFilter(&history.output[1][first]) >> 14);
+    }
+
+    void IopSpu2::refillStream(int coreIndex, uint32_t half)
+    {
+        Core &core = m_cores[coreIndex];
+        const uint32_t control = reg(static_cast<uint32_t>(coreIndex) * 0x400u + kStreamControl);
+        if ((control & (1u << coreIndex)) == 0u && core.stream.active == 0u)
+            return;
+
+        // The stream alternates 256 samples for the left and 256 for the right channel.
+        constexpr uint32_t kChunkBytes = kStreamHalf * 2u;
+        const uint32_t left = kStreamArea + static_cast<uint32_t>(coreIndex) * kStreamAreaStep + half * kStreamHalf;
+        const uint32_t right = left + 0x200u;
+        Stream &stream = core.stream;
+        if (stream.active != 0u && stream.remaining >= 2u * kChunkBytes && m_iopRam != nullptr &&
+            static_cast<size_t>(stream.address) + 2u * kChunkBytes <= m_iopRamSize)
+        {
+            std::memcpy(&m_ram[left], m_iopRam + stream.address, kChunkBytes);
+            std::memcpy(&m_ram[right], m_iopRam + stream.address + kChunkBytes, kChunkBytes);
+            stream.address += 2u * kChunkBytes;
+            stream.remaining -= 2u * kChunkBytes;
+            if (stream.remaining < 2u * kChunkBytes)
+            {
+                stream.active = 0u;
+                m_finishedStreams |= 1u << coreIndex;
+            }
+            return;
+        }
+        if (stream.active != 0u)
+        {
+            // Too little left for a block: the transfer is over.
+            stream.active = 0u;
+            m_finishedStreams |= 1u << coreIndex;
+        }
+        std::memset(&m_ram[left], 0, kChunkBytes);
+        std::memset(&m_ram[right], 0, kChunkBytes);
+    }
+
+    void IopSpu2::mixSample()
+    {
+        // PS2X_SPU2_REVERB=0: without the reverb (as the model was before), for comparison.
+        static const bool reverbOn = !envOff("PS2X_SPU2_REVERB");
+        int32_t external[2] = {0, 0};
+        int32_t result[2] = {0, 0};
+        for (int coreIndex = 0; coreIndex < 2; ++coreIndex)
+        {
+            Core &core = m_cores[coreIndex];
+            const uint32_t base = static_cast<uint32_t>(coreIndex) * 0x400u;
+            const uint32_t volumes = kCoreVolumes + static_cast<uint32_t>(coreIndex) * kCoreVolumesStep;
+            const uint16_t mixer = reg(base + kMixer);
+
+            int32_t dryLeft = 0, dryRight = 0, wetLeft = 0, wetRight = 0;
+            mixVoices(coreIndex, dryLeft, dryRight, wetLeft, wetRight);
+            dryLeft = clamp16(dryLeft);
+            dryRight = clamp16(dryRight);
+            wetLeft = clamp16(wetLeft);
+            wetRight = clamp16(wetRight);
+            const uint32_t mixes = kCaptureMix[coreIndex] + m_outPosition;
+            writeCapture(mixes, dryLeft);
+            writeCapture(mixes + 0x200u, dryRight);
+            writeCapture(mixes + 0x400u, wetLeft);
+            writeCapture(mixes + 0x600u, wetRight);
+
+            // The samples streamed from DMA (BVOL), and core 0's output for core 1 (AVOL).
+            int32_t streamLeft = 0, streamRight = 0, externalLeft = 0, externalRight = 0;
+            if ((mixer & 0xF0u) != 0u)
+            {
+                const uint32_t area = kStreamArea + static_cast<uint32_t>(coreIndex) * kStreamAreaStep + m_outPosition;
+                streamLeft = (static_cast<int16_t>(m_ram[area]) * static_cast<int16_t>(reg(volumes + kStreamLeft))) >> 15;
+                streamRight = (static_cast<int16_t>(m_ram[area + 0x200u]) * static_cast<int16_t>(reg(volumes + kStreamRight))) >> 15;
+            }
+            if (coreIndex == 1)
+            {
+                externalLeft = (external[0] * static_cast<int16_t>(reg(volumes + kExternalLeft))) >> 15;
+                externalRight = (external[1] * static_cast<int16_t>(reg(volumes + kExternalRight))) >> 15;
+            }
+
+            int32_t left = 0, right = 0;
+            left += (mixer & kVoicesDryLeft) != 0u ? dryLeft : 0;
+            right += (mixer & kVoicesDryRight) != 0u ? dryRight : 0;
+            left += (mixer & kStreamDryLeft) != 0u ? streamLeft : 0;
+            right += (mixer & kStreamDryRight) != 0u ? streamRight : 0;
+            left += (mixer & kExternalDryLeft) != 0u ? externalLeft : 0;
+            right += (mixer & kExternalDryRight) != 0u ? externalRight : 0;
+
+            int32_t sendLeft = 0, sendRight = 0;
+            sendLeft += (mixer & kVoicesWetLeft) != 0u ? wetLeft : 0;
+            sendRight += (mixer & kVoicesWetRight) != 0u ? wetRight : 0;
+            sendLeft += (mixer & kStreamWetLeft) != 0u ? streamLeft : 0;
+            sendRight += (mixer & kStreamWetRight) != 0u ? streamRight : 0;
+            sendLeft += (mixer & kExternalWetLeft) != 0u ? externalLeft : 0;
+            sendRight += (mixer & kExternalWetRight) != 0u ? externalRight : 0;
+            if (reverbOn)
+            {
+                int32_t effectLeft = 0, effectRight = 0;
+                reverb(coreIndex, clamp16(sendLeft), clamp16(sendRight), effectLeft, effectRight);
+                left += (effectLeft * static_cast<int16_t>(reg(volumes + kEffectVolumeLeft))) >> 15;
+                right += (effectRight * static_cast<int16_t>(reg(volumes + kEffectVolumeRight))) >> 15;
+            }
+            left = clamp16(left);
+            right = clamp16(right);
+            if (coreIndex == 0)
+            {
+                writeCapture(kCaptureOutput + m_outPosition, left);
+                writeCapture(kCaptureOutput + 0x200u + m_outPosition, right);
+            }
+
+            stepSlide(core.masterLeft);
+            stepSlide(core.masterRight);
+            left = clamp16((left * core.masterLeft.value) >> 15);
+            right = clamp16((right * core.masterRight.value) >> 15);
+            if (coreIndex == 0)
+            {
+                external[0] = left;
+                external[1] = right;
+            }
+            else
+            {
+                result[0] = left;
+                result[1] = right;
+            }
+        }
+        m_output.push_back(static_cast<int16_t>(result[0]));
+        m_output.push_back(static_cast<int16_t>(result[1]));
+
+        // The half of the stream areas that has just been played takes the next samples.
+        m_outPosition = (m_outPosition + 1u) & 0x1FFu;
+        if ((m_outPosition & 0xFFu) == 0u)
+        {
+            const uint32_t played = m_outPosition == 0u ? 1u : 0u;
+            refillStream(0, played);
+            refillStream(1, played);
+        }
+    }
+
+    void IopSpu2::advance(uint64_t cycle)
+    {
+        while (cycle >= m_cycle + kCyclesPerSample)
+        {
+            m_cycle += kCyclesPerSample;
+            mixSample();
+        }
+    }
+
+    uint32_t IopSpu2::takeFinishedStreams() noexcept
+    {
+        const uint32_t finished = m_finishedStreams;
+        m_finishedStreams = 0u;
+        return finished;
+    }
+
+    bool IopSpu2::takeInterrupt() noexcept
+    {
+        const bool pending = m_interruptPending;
+        m_interruptPending = false;
+        return pending;
+    }
+
+    uint16_t IopSpu2::read(uint32_t offset, uint64_t cycle)
+    {
+        advance(cycle);
+        offset &= 0x7FEu;
+        if (offset >= kCoreVolumes)
+            return reg(offset);
+
+        const int coreIndex = offset >= 0x400u ? 1 : 0;
+        const Core &core = m_cores[coreIndex];
+        const uint32_t local = offset & 0x3FFu;
+        if (local < kPitchModulation)
+        {
+            const Voice &voice = core.voices[local >> 4u];
+            switch (local & 0xEu)
+            {
+            case kEnvelope:
+                return static_cast<uint16_t>(voice.envelope);
+            case kCurrentLeft:
+                return static_cast<uint16_t>(voice.volumeLeft.value >> 1);
+            case kCurrentRight:
+                return static_cast<uint16_t>(voice.volumeRight.value >> 1);
+            default:
+                return reg(offset);
+            }
+        }
+        if (local >= kVoiceAddresses && local < kVoiceAddresses + 24u * 12u)
+        {
+            const Voice &voice = core.voices[(local - kVoiceAddresses) / 12u];
+            switch ((local - kVoiceAddresses) % 12u)
+            {
+            case 4u:
+                return static_cast<uint16_t>(voice.loop >> 16u);
+            case 6u:
+                return static_cast<uint16_t>(voice.loop);
+            case 8u:
+                return static_cast<uint16_t>(voice.next >> 16u);
+            case 10u:
+                return static_cast<uint16_t>(voice.next);
+            default:
+                return reg(offset);
+            }
+        }
+        switch (local)
+        {
+        case kTransferAddress:
+            return static_cast<uint16_t>(core.transferAddress >> 16u);
+        case kTransferAddress + 2u:
+            return static_cast<uint16_t>(core.transferAddress);
+        case kEndPoints:
+            return static_cast<uint16_t>(core.endx);
+        case kEndPoints + 2u:
+            return static_cast<uint16_t>(core.endx >> 16u);
+        case kStatus:
+            return cycle < core.dmaBusyUntil ? kStatusBusy : kStatusReady;
+        default:
+            return reg(offset);
+        }
+    }
+
+    void IopSpu2::write(uint32_t offset, uint16_t value, uint64_t cycle)
+    {
+        advance(cycle);
+        offset &= 0x7FEu;
+        // PS2X_SPU2_LOG=1: the reverb's set-up as the game writes it (its area, addresses,
+        // coefficients, output volume and the mixer).
+        static const bool logged = []()
+        {
+            const char *env = std::getenv("PS2X_SPU2_LOG");
+            return env != nullptr && env[0] == '1';
+        }();
+        if (logged)
+        {
+            const uint32_t local = offset & 0x3FFu;
+            const bool volume = offset >= kCoreVolumes && offset < kCoreVolumes + 2u * kCoreVolumesStep &&
+                                ((offset - kCoreVolumes) % kCoreVolumesStep >= vIIR ||
+                                 (offset - kCoreVolumes) % kCoreVolumesStep == kEffectVolumeLeft ||
+                                 (offset - kCoreVolumes) % kCoreVolumesStep == kEffectVolumeRight);
+            if (volume || (offset < kCoreVolumes && ((local >= kEffectStart && local <= kEffectEnd) || local == kMixer ||
+                                                     local == kAttributes || local == kWetLeft || local == kWetLeft + 2u ||
+                                                     local == kWetRight || local == kWetRight + 2u)))
+                std::fprintf(stderr, "[spu2] %03x = %04x (core %d)\n", offset, value,
+                             offset >= kCoreVolumes ? static_cast<int>((offset - kCoreVolumes) / kCoreVolumesStep)
+                                                    : (offset >= 0x400u ? 1 : 0));
+        }
+        if (offset >= kCoreVolumes)
+        {
+            reg(offset) = value;
+            for (int coreIndex = 0; coreIndex < 2; ++coreIndex)
+            {
+                const uint32_t volumes = kCoreVolumes + static_cast<uint32_t>(coreIndex) * kCoreVolumesStep;
+                if (offset == volumes + kMasterLeft)
+                    setSlide(m_cores[coreIndex].masterLeft, value);
+                else if (offset == volumes + kMasterRight)
+                    setSlide(m_cores[coreIndex].masterRight, value);
+            }
+            return;
+        }
+
+        const int coreIndex = offset >= 0x400u ? 1 : 0;
+        Core &core = m_cores[coreIndex];
+        const uint32_t base = static_cast<uint32_t>(coreIndex) * 0x400u;
+        const uint32_t local = offset & 0x3FFu;
+        if (local < kPitchModulation)
+        {
+            Voice &voice = core.voices[local >> 4u];
+            reg(offset) = value;
+            switch (local & 0xEu)
+            {
+            case kVolumeLeft:
+                setSlide(voice.volumeLeft, value);
+                break;
+            case kVolumeRight:
+                setSlide(voice.volumeRight, value);
+                break;
+            case kPitch:
+                voice.pitch = value;
+                break;
+            case kAdsr1:
+                voice.adsr1 = value;
+                break;
+            case kAdsr2:
+                voice.adsr2 = value;
+                break;
+            default:
+                break;
+            }
+            return;
+        }
+        if (local >= kVoiceAddresses && local < kVoiceAddresses + 24u * 12u)
+        {
+            const uint32_t voiceBase = base + kVoiceAddresses + ((local - kVoiceAddresses) / 12u) * 12u;
+            Voice &voice = core.voices[(local - kVoiceAddresses) / 12u];
+            reg(offset) = value;
+            switch ((local - kVoiceAddresses) % 12u)
+            {
+            case 0u:
+            case 2u:
+                voice.start = addressPair(voiceBase);
+                break;
+            case 4u:
+            case 6u:
+                voice.loop = addressPair(voiceBase + 4u);
+                voice.loopWritten = 1u;
+                break;
+            default: // NAX is the voice's own
+                break;
+            }
+            return;
+        }
+
+        switch (local)
+        {
+        case kAttributes:
+            reg(offset) = value;
+            if ((value & kAttrInterrupt) == 0u)
+            {
+                // Taking the enable away acknowledges the interrupt.
+                m_interruptRaised[coreIndex] = false;
+                reg(kInterruptInfo) = static_cast<uint16_t>(reg(kInterruptInfo) & ~(4u << coreIndex));
+            }
+            return;
+        case kKeyOn:
+        case kKeyOn + 2u:
+        {
+            reg(offset) = value;
+            const int first = local == kKeyOn ? 0 : 16;
+            for (int bit = 0; bit < 16 && first + bit < 24; ++bit)
+                if (((value >> bit) & 1u) != 0u)
+                    keyOn(coreIndex, first + bit);
+            return;
+        }
+        case kKeyOff:
+        case kKeyOff + 2u:
+        {
+            reg(offset) = value;
+            const int first = local == kKeyOff ? 0 : 16;
+            for (int bit = 0; bit < 16 && first + bit < 24; ++bit)
+                if (((value >> bit) & 1u) != 0u)
+                    keyOff(coreIndex, first + bit);
+            return;
+        }
+        case kTransferAddress:
+        case kTransferAddress + 2u:
+            reg(offset) = value;
+            core.transferAddress = addressPair(base + kTransferAddress);
+            return;
+        case kData:
+            reg(offset) = value;
+            writeRam(core.transferAddress, value);
+            core.transferAddress = (core.transferAddress + 1u) & kAddressMask;
+            return;
+        case kStreamControl:
+            reg(offset) = value;
+            if ((value & (1u << coreIndex)) == 0u)
+                stopDma(coreIndex);
+            return;
+        case kEndPoints: // any write clears them
+            core.endx &= 0xFF0000u;
+            return;
+        case kEndPoints + 2u:
+            core.endx &= 0x00FFFFu;
+            return;
+        case kStatus:
+            return;
+        default:
+            reg(offset) = value;
+            return;
+        }
+    }
+
+    uint64_t IopSpu2::startDma(int coreIndex, bool toSpu, uint8_t *data, uint32_t address, uint32_t bytes, uint64_t cycle)
+    {
+        advance(cycle);
+        coreIndex &= 1;
+        Core &core = m_cores[coreIndex];
+        const uint32_t base = static_cast<uint32_t>(coreIndex) * 0x400u;
+        if (toSpu && (reg(base + kStreamControl) & (1u << coreIndex)) != 0u)
+        {
+            // Samples to play: taken from IOP memory as they are played.
+            core.stream.active = 1u;
+            core.stream.address = address;
+            core.stream.remaining = bytes;
+            return kDmaStreams;
+        }
+
+        const uint32_t words = bytes / 2u;
+        if (data != nullptr)
+        {
+            for (uint32_t i = 0; i < words; ++i)
+            {
+                if (toSpu)
+                {
+                    writeRam(core.transferAddress, static_cast<uint16_t>(data[2u * i] | (data[2u * i + 1u] << 8u)));
+                }
+                else
+                {
+                    const uint16_t value = m_ram[core.transferAddress];
+                    checkInterruptAddress(core.transferAddress);
+                    data[2u * i] = static_cast<uint8_t>(value);
+                    data[2u * i + 1u] = static_cast<uint8_t>(value >> 8u);
+                }
+                core.transferAddress = (core.transferAddress + 1u) & kAddressMask;
+            }
+        }
+        const uint64_t cycles = std::max<uint64_t>(static_cast<uint64_t>(words) * kCyclesPerDmaWord, 64u);
+        core.dmaBusyUntil = cycle + cycles;
+        return cycles;
+    }
+
+    void IopSpu2::stopDma(int coreIndex)
+    {
+        Core &core = m_cores[coreIndex & 1];
+        core.stream.active = 0u;
+        core.stream.remaining = 0u;
+    }
+
+    void IopSpu2::saveState(StateWriter &out) const
+    {
+        out.pod(m_registers);
+        out.blob(m_ram.data(), m_ram.size() * sizeof(uint16_t));
+        out.pod(m_cores);
+        out.u64(m_cycle);
+        out.u32(m_outPosition);
+        out.u32(m_finishedStreams);
+        out.boolean(m_interruptRaised[0]);
+        out.boolean(m_interruptRaised[1]);
+        out.boolean(m_interruptPending);
+    }
+
+    void IopSpu2::loadState(StateReader &in)
+    {
+        in.pod(m_registers);
+        in.blob(m_ram.data(), m_ram.size() * sizeof(uint16_t));
+        in.pod(m_cores);
+        m_cycle = in.u64();
+        m_outPosition = in.u32();
+        m_finishedStreams = in.u32();
+        m_interruptRaised[0] = in.boolean();
+        m_interruptRaised[1] = in.boolean();
+        m_interruptPending = in.boolean();
+        m_output.clear();
+        for (ReverbHistory &history : m_reverb)
+            history = ReverbHistory{}; // (loadReverbState next, when the state has it)
+    }
+
+    void IopSpu2::saveReverbState(StateWriter &out) const
+    {
+        out.pod(m_reverb);
+    }
+
+    void IopSpu2::loadReverbState(StateReader &in)
+    {
+        in.pod(m_reverb);
+        for (ReverbHistory &history : m_reverb)
+            history.position &= 63u;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..f19f089
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,193 @@
+#pragma once
+
+#include "ps2x/state_stream.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // The SPU2 sound processor: two cores of 24 ADPCM voices each over 2 MiB of sample
+    // memory. Core 0's output is core 1's external input and core 1's output is what the
+    // console plays, at 48 kHz (one sample every 768 cycles of the IOP clock).
+    //
+    // Modelled: the voices (ADPCM decoding with loops, the 4-point "gaussian" interpolation of
+    // the hardware's table, pitch and pitch modulation, noise, ADSR envelopes, volume sweeps),
+    // the mixer's dry and wet paths with their gates and volumes, each core's reverb (the
+    // effect area in sample memory, its two resampling filters, left and right on alternate
+    // samples), the capture areas (voices 1 and 3, the cores' mixes and core 0's output written
+    // to sample memory each sample), sample memory through the data port and through DMA in both
+    // directions, the address interrupt (data, voices, reverb and capture accesses), and the
+    // stream of 16-bit samples a core takes straight from DMA ("AutoDMA", which movies and
+    // streamed PCM use).
+    //
+    // Not modelled: the optical output modes.
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t kBase = 0x1F900000u;
+        static constexpr uint32_t kRegisterBytes = 0x800u;
+        static constexpr uint32_t kRamWords = 0x100000u;
+        static constexpr uint64_t kCyclesPerSample = 768u;
+        // What startDma returns for a stream that ends when its samples have been played.
+        static constexpr uint64_t kDmaStreams = ~0ull;
+
+        IopSpu2();
+
+        void reset();
+
+        // Registers, by offset from kBase (16 bits each). The sound is brought up to
+        // `cycle` first, so that a program reads and changes the state of that moment.
+        [[nodiscard]] uint16_t read(uint32_t offset, uint64_t cycle);
+        void write(uint32_t offset, uint16_t value, uint64_t cycle);
+
+        // A DMA transfer of a core (DMA channel 4 is core 0, channel 7 core 1) between
+        // `bytes` of IOP memory at `data` and sample memory. Returns how many IOP cycles it
+        // takes, or kDmaStreams for a stream of samples: its end is then reported by
+        // takeFinishedStreams, and streamAddress follows it through IOP memory.
+        [[nodiscard]] uint64_t startDma(int core, bool toSpu, uint8_t *data, uint32_t address, uint32_t bytes,
+                                        uint64_t cycle);
+        void stopDma(int core);
+        [[nodiscard]] bool streaming(int core) const noexcept { return m_cores[core & 1].stream.active; }
+        [[nodiscard]] uint32_t streamAddress(int core) const noexcept { return m_cores[core & 1].stream.address; }
+
+        // Generates the samples up to `cycle`.
+        void advance(uint64_t cycle);
+
+        // Bit n: core n's stream has ended since the last call (its DMA interrupt is due).
+        [[nodiscard]] uint32_t takeFinishedStreams() noexcept;
+        // True once after a core has raised the address interrupt.
+        [[nodiscard]] bool takeInterrupt() noexcept;
+
+        // The samples generated since the last clearOutput(), left and right interleaved.
+        [[nodiscard]] const std::vector<int16_t> &output() const noexcept { return m_output; }
+        void clearOutput() noexcept { m_output.clear(); }
+
+        // The IOP memory the streams read from (they are consumed while they play).
+        void setIopRam(const uint8_t *ram, size_t size) noexcept
+        {
+            m_iopRam = ram;
+            m_iopRamSize = size;
+        }
+
+        // Sets the clock without generating anything (a loaded state continues from here).
+        void setCycle(uint64_t cycle) noexcept { m_cycle = cycle; }
+
+        void saveState(StateWriter &out) const;
+        void loadState(StateReader &in);
+        // The reverb's resampling history, kept apart (a section of its own in a save state:
+        // states made before it load with the history empty, 0.8 ms of the effect).
+        void saveReverbState(StateWriter &out) const;
+        void loadReverbState(StateReader &in);
+
+    private:
+        // A volume register: a fixed level, or a level that sweeps towards an end.
+        struct Slide
+        {
+            int32_t value = 0; // -0x8000..0x7FFF
+            uint32_t counter = 0;
+            uint16_t reg = 0;
+        };
+
+        enum Phase : uint8_t
+        {
+            Stopped,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Voice
+        {
+            Slide volumeLeft;
+            Slide volumeRight;
+            uint16_t pitch = 0;
+            uint16_t adsr1 = 0;
+            uint16_t adsr2 = 0;
+            uint32_t start = 0; // SSA
+            uint32_t loop = 0;  // LSAX
+            uint32_t next = 0;  // NAX: the word being played
+            int32_t envelope = 0;
+            uint32_t envelopeCounter = 0;
+            uint8_t phase = Stopped;
+            uint8_t flags = 0;      // of the block being played
+            uint8_t loopWritten = 0; // LSAX was written since the key on: the blocks' loop marks do not move it
+            uint8_t position = 28;  // sample within the block; 28: the next block is due
+            uint32_t block = 0;     // word address of the block being played
+            uint32_t counter = 0;   // position between two samples, in 1/4096
+            int16_t decoded[28]{};
+            int16_t previous1 = 0;
+            int16_t previous2 = 0;
+            int16_t history[4]{};
+            int32_t out = 0; // the last sample after the envelope: modulates the next voice
+        };
+
+        // The 16-bit samples a core plays straight from a DMA transfer.
+        struct Stream
+        {
+            uint8_t active = 0;
+            uint32_t address = 0;   // in IOP memory
+            uint32_t remaining = 0; // bytes
+        };
+
+        struct Core
+        {
+            Voice voices[24];
+            Slide masterLeft;
+            Slide masterRight;
+            uint32_t endx = 0;
+            uint32_t transferAddress = 0; // where the data port and DMA write next
+            uint64_t dmaBusyUntil = 0;
+            uint32_t noiseLevel = 1;
+            int32_t noiseTimer = 0;
+            Stream stream;
+        };
+
+        // A core's reverb resamplers: the 48 kHz input the effect reads at half the rate, and
+        // what it gives back, a sample on alternate cycles for each channel (zeros between),
+        // through the same 39-tap filter. Each history a ring of 64, mirrored above it so that
+        // the filter reads 39 in a row.
+        struct ReverbHistory
+        {
+            int16_t input[2][128]{};
+            int16_t output[2][128]{};
+            uint32_t position = 0; // 0..63: where the newest sample went
+        };
+
+        [[nodiscard]] uint16_t &reg(uint32_t offset) noexcept { return m_registers[(offset & 0x7FEu) >> 1u]; }
+        [[nodiscard]] uint16_t reg(uint32_t offset) const noexcept { return m_registers[(offset & 0x7FEu) >> 1u]; }
+        [[nodiscard]] uint32_t pair(uint32_t offset) const noexcept; // two registers: low word first
+        [[nodiscard]] uint32_t addressPair(uint32_t offset) const noexcept; // an address: high word first
+
+        void keyOn(int core, int voice);
+        void keyOff(int core, int voice);
+        void setSlide(Slide &slide, uint16_t value);
+        static void stepSlide(Slide &slide);
+        void stepEnvelope(Voice &voice);
+        void nextSample(int core, int voiceIndex);
+        void decodeBlock(Voice &voice);
+        void checkInterruptAddress(uint32_t address);
+        void writeRam(uint32_t address, uint16_t value);
+        void refillStream(int core, uint32_t half);
+        void mixSample();
+        void mixVoices(int core, int32_t &dryLeft, int32_t &dryRight, int32_t &wetLeft, int32_t &wetRight);
+        void reverb(int core, int32_t inLeft, int32_t inRight, int32_t &outLeft, int32_t &outRight);
+        void writeCapture(uint32_t address, int32_t value);
+
+        std::array<uint16_t, kRegisterBytes / 2u> m_registers{};
+        std::vector<uint16_t> m_ram;
+        Core m_cores[2];
+        ReverbHistory m_reverb[2];
+        uint64_t m_cycle = 0;
+        uint32_t m_outPosition = 0; // where the cores read their streams, 0..0x1FF
+        uint32_t m_finishedStreams = 0;
+        bool m_interruptRaised[2]{};
+        bool m_interruptPending = false;
+        std::vector<int16_t> m_output;
+        const uint8_t *m_iopRam = nullptr;
+        size_t m_iopRamSize = 0;
+    };
+}
