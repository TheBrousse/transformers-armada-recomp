diff --git a/ps2xIOP/src/emulator/imports/iop_printf.h b/ps2xIOP/src/emulator/imports/iop_printf.h
new file mode 100644
index 0000000..d283781
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_printf.h
@@ -0,0 +1,163 @@
+#pragma once
+
+// printf-style formatting for the IOP library functions the emulator implements itself
+// (sysclib sprintf/vsprintf, sysmem Kprintf, stdio printf).
+
+#include "../core/iop_memory.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    // Variadic arguments of an o32 call: 4-byte slots, 64-bit values in two slots that
+    // start on an 8-byte boundary.
+    struct GuestPrintfArgs
+    {
+        std::function<uint32_t(uint32_t slot)> read; // value of slot n
+        uint32_t slot = 0;                           // next slot to read
+        uint32_t evenBias = 0;                       // 1 if slot 0 is not 8-byte aligned
+
+        uint32_t next() { return read(slot++); }
+        uint64_t next64()
+        {
+            if ((slot + evenBias) & 1u)
+                ++slot;
+            const uint64_t low = read(slot++);
+            const uint64_t high = read(slot++);
+            return low | (high << 32);
+        }
+    };
+
+    // Registers a1..a3 and the caller's stack: slot n of a call is a<n> or sp + 4n.
+    inline GuestPrintfArgs registerPrintfArgs(const uint32_t *gpr, const IopMemory &memory, uint32_t firstSlot)
+    {
+        const uint32_t sp = gpr[29];
+        const uint32_t a[4] = {gpr[4], gpr[5], gpr[6], gpr[7]};
+        GuestPrintfArgs args;
+        args.read = [a, sp, &memory](uint32_t slot)
+        { return slot < 4u ? a[slot] : memory.read32(sp + 4u * slot); };
+        args.slot = firstSlot;
+        return args;
+    }
+
+    // A va_list: slots in memory from `list`.
+    inline GuestPrintfArgs listPrintfArgs(uint32_t list, const IopMemory &memory)
+    {
+        GuestPrintfArgs args;
+        args.read = [list, &memory](uint32_t slot)
+        { return memory.read32(list + 4u * slot); };
+        args.evenBias = (list >> 2) & 1u;
+        return args;
+    }
+
+    inline std::string formatGuestPrintf(const std::string &format, const IopMemory &memory, GuestPrintfArgs args)
+    {
+        std::string out;
+        for (size_t i = 0; i < format.size(); ++i)
+        {
+            if (format[i] != '%')
+            {
+                out.push_back(format[i]);
+                continue;
+            }
+            const size_t start = i++;
+            std::string spec = "%";
+            while (i < format.size() && std::strchr("-+ #0", format[i]))
+                spec.push_back(format[i++]);
+            // Width and precision, either of which may come from an argument.
+            for (int part = 0; part < 2; ++part)
+            {
+                if (part == 1)
+                {
+                    if (i >= format.size() || format[i] != '.')
+                        break;
+                    spec.push_back(format[i++]);
+                }
+                if (i < format.size() && format[i] == '*')
+                {
+                    spec += std::to_string(static_cast<int32_t>(args.next()));
+                    ++i;
+                }
+                else
+                {
+                    while (i < format.size() && format[i] >= '0' && format[i] <= '9')
+                        spec.push_back(format[i++]);
+                }
+            }
+            bool wide = false;
+            while (i < format.size() && std::strchr("hlLqjzt", format[i]))
+            {
+                wide = wide || format[i] == 'L' || format[i] == 'q' || (format[i] == 'l' && i > 0 && format[i - 1] == 'l');
+                ++i;
+            }
+            if (i >= format.size())
+            {
+                out += format.substr(start);
+                break;
+            }
+
+            char buffer[128];
+            const char conversion = format[i];
+            switch (conversion)
+            {
+            case '%':
+                out.push_back('%');
+                break;
+            case 's':
+            {
+                const uint32_t address = args.next();
+                const std::string text = address != 0u ? memory.readString(address, 1024u) : std::string("(null)");
+                const std::string full = spec + "s";
+                const int length = std::snprintf(nullptr, 0, full.c_str(), text.c_str());
+                if (length > 0)
+                {
+                    std::string formatted(static_cast<size_t>(length) + 1u, '\0');
+                    std::snprintf(formatted.data(), formatted.size(), full.c_str(), text.c_str());
+                    formatted.resize(static_cast<size_t>(length));
+                    out += formatted;
+                }
+                break;
+            }
+            case 'c':
+                std::snprintf(buffer, sizeof(buffer), (spec + "c").c_str(), static_cast<int>(args.next() & 0xFFu));
+                out += buffer;
+                break;
+            case 'd':
+            case 'i':
+                if (wide)
+                    std::snprintf(buffer, sizeof(buffer), (spec + "lld").c_str(), static_cast<long long>(args.next64()));
+                else
+                    std::snprintf(buffer, sizeof(buffer), (spec + "d").c_str(), static_cast<int32_t>(args.next()));
+                out += buffer;
+                break;
+            case 'u':
+            case 'x':
+            case 'X':
+            case 'o':
+                if (wide)
+                    std::snprintf(buffer, sizeof(buffer), (spec + "ll" + conversion).c_str(),
+                                  static_cast<unsigned long long>(args.next64()));
+                else
+                    std::snprintf(buffer, sizeof(buffer), (spec + conversion).c_str(), args.next());
+                out += buffer;
+                break;
+            case 'p':
+                std::snprintf(buffer, sizeof(buffer), "%08x", args.next());
+                out += buffer;
+                break;
+            case 'n':
+                (void)args.next();
+                break;
+            default:
+                // Unknown conversion (the IOP has no FPU, so no %f): keep it as written.
+                out += format.substr(start, i - start + 1u);
+                break;
+            }
+        }
+        return out;
+    }
+}
