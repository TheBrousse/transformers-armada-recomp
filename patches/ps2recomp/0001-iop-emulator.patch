+    // An IRX whose start routine calls SearchModuleByAddress(0x10000) and stores the id at 0x10300, then
+    // ReferModuleStatus(id, 0x10400), as SIRENS3 does; it stays resident (returns 0).
+    void writeModuleStatusIrx(TestHost &host, uint32_t address)
+    {
+        writeRpcServerIrx(host, address);
+        constexpr uint32_t codeOffset = 0x100u;
+        const uint32_t start[] = {
+            0x27BDFFE0u, // addiu sp, sp, -0x20
+            0xAFBF001Cu, // sw    ra, 0x1c(sp)
+            0x3C040001u, // lui   a0, 1             0x10000: this module
+            0x0C00401Du, // jal   0x10074           SearchModuleByAddress
+            0x00000000u, // nop
+            0x3C080001u, // lui   t0, 1
+            0xAD020300u, // sw    v0, 0x300(t0)
+            0x00402021u, // addu  a0, v0, zero      id
+            0x3C050001u, // lui   a1, 1
+            0x34A50400u, // ori   a1, a1, 0x400     ModuleStatus
+            0x0C00401Fu, // jal   0x1007c           ReferModuleStatus
+            0x00000000u, // nop
+            0x8FBF001Cu, // lw    ra, 0x1c(sp)
+            0x00001021u, // addu  v0, zero, zero    resident
+            0x03E00008u, // jr    ra
+            0x27BD0020u, // addiu sp, sp, 0x20
+        };
+        const uint32_t importTable[] = {
+            0x41E00000u, 0x00000000u, 0x00000106u, 0x6C646F6Du, 0x0064616Fu, // "modload"
+            0x03E00008u, 0x24000017u, // SearchModuleByAddress (23)
+            0x03E00008u, 0x24000011u, // ReferModuleStatus (17)
+            0x00000000u, 0x00000000u,
+        };
+        std::fill(host.guest.begin() + address + codeOffset, host.guest.begin() + address + codeOffset + 0x100u, 0u);
+        std::memcpy(host.guest.data() + address + codeOffset, start, sizeof(start));
+        std::memcpy(host.guest.data() + address + codeOffset + 0x60u, importTable, sizeof(importTable));
+    }
