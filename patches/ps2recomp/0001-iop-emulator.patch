+namespace ps2x::iop::detail
+{
+    void IopModuleManager::saveState(StateWriter &out) const
+    {
+        std::map<int32_t, const Record *> records;
+        for (const auto &[id, record] : m_records)
+            records.emplace(id, &record);
+        out.u64(records.size());
+        for (const auto &[id, record] : records)
+        {
+            out.i32(id);
+            out.string(record->key);
+            out.u32(record->references);
+            out.boolean(record->physical);
+        }
+
+        const std::map<std::string, int32_t> hleIds(m_hleIdsByKey.begin(), m_hleIdsByKey.end());
+        out.u64(hleIds.size());
+        for (const auto &[key, id] : hleIds)
+        {
+            out.string(key);
+            out.i32(id);
+        }
+
+        const std::map<std::string, uint32_t> references(m_loadedKeyReferences.begin(), m_loadedKeyReferences.end());
+        out.u64(references.size());
+        for (const auto &[key, count] : references)
+        {
+            out.string(key);
+            out.u32(count);
+        }
+        out.i32(m_nextHleId);
+    }
+
+    void IopModuleManager::loadState(StateReader &in)
+    {
+        m_records.clear();
+        m_hleIdsByKey.clear();
+        m_loadedKeyReferences.clear();
+
+        const size_t records = in.count(13u);
+        for (size_t i = 0; i < records; ++i)
+        {
+            const int32_t id = in.i32();
+            Record record;
+            record.key = in.string();
+            record.references = in.u32();
+            record.physical = in.boolean();
+            m_records.emplace(id, std::move(record));
+        }
+
+        const size_t hleIds = in.count(8u);
+        for (size_t i = 0; i < hleIds; ++i)
+        {
+            std::string key = in.string();
+            const int32_t id = in.i32();
+            m_hleIdsByKey.emplace(std::move(key), id);
+        }
+
+        const size_t references = in.count(8u);
+        for (size_t i = 0; i < references; ++i)
+        {
+            std::string key = in.string();
+            const uint32_t count = in.u32();
+            m_loadedKeyReferences.emplace(std::move(key), count);
+        }
+        m_nextHleId = in.i32();
+    }
+}
