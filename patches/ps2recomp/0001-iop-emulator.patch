@@ -742,3 +756,30 @@ namespace ps2x::iop::detail
         }
     }
 }
+
+namespace ps2x::iop::detail
+{
+    void IopKernel::saveState(StateWriter &out) const
+    {
+        out.podMap(m_threads);
+        out.podMap(m_semaphores);
+        out.podMap(m_eventFlags);
+        out.u32(m_nextThreadId);
+        out.u32(m_nextSemaphoreId);
+        out.u32(m_nextEventFlagId);
+        out.i32(m_currentThread ? m_currentThread->id : 0);
+    }
+
+    void IopKernel::loadState(StateReader &in)
+    {
+        in.podMap(m_threads);
+        in.podMap(m_semaphores);
+        in.podMap(m_eventFlags);
+        m_nextThreadId = in.u32();
+        m_nextSemaphoreId = in.u32();
+        m_nextEventFlagId = in.u32();
+        const int current = in.i32();
+        const auto found = m_threads.find(current);
+        m_currentThread = current != 0 && found != m_threads.end() ? &found->second : nullptr;
+    }
+}
