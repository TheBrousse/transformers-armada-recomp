diff --git a/ps2xIOP/include/ps2x/state_stream.h b/ps2xIOP/include/ps2x/state_stream.h
new file mode 100644
index 0000000..73fa97a
--- /dev/null
+++ b/ps2xIOP/include/ps2x/state_stream.h
@@ -0,0 +1,228 @@
+#pragma once
+
+// Byte streams used by save states. A state is a list of sections, each written by
+// the component that owns the data; values are stored in host byte order.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace ps2x
+{
+    class StateWriter
+    {
+    public:
+        void bytes(const void *data, size_t size)
+        {
+            if (size == 0u)
+                return;
+            const auto *begin = static_cast<const uint8_t *>(data);
+            m_data.insert(m_data.end(), begin, begin + size);
+        }
+
+        template <typename T>
+        void pod(const T &value)
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "pod() needs a trivially copyable type");
+            bytes(&value, sizeof(T));
+        }
+
+        void u8(uint8_t value) { pod(value); }
+        void u16(uint16_t value) { pod(value); }
+        void u32(uint32_t value) { pod(value); }
+        void u64(uint64_t value) { pod(value); }
+        void i32(int32_t value) { pod(value); }
+        void i64(int64_t value) { pod(value); }
+        void boolean(bool value) { u8(value ? 1u : 0u); }
+
+        void string(std::string_view text)
+        {
+            u32(static_cast<uint32_t>(text.size()));
+            bytes(text.data(), text.size());
+        }
+
+        void blob(const void *data, size_t size)
+        {
+            u64(size);
+            bytes(data, size);
+        }
+
+        template <typename T>
+        void podVector(const std::vector<T> &values)
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "podVector() needs a trivially copyable type");
+            u64(values.size());
+            bytes(values.data(), values.size() * sizeof(T));
+        }
+
+        // Keyed containers of trivially copyable keys and values, in key order so that
+        // the same state always produces the same bytes.
+        template <typename Map>
+        void podMap(const Map &values)
+        {
+            std::map<typename Map::key_type, const typename Map::mapped_type *> ordered;
+            for (const auto &[key, value] : values)
+                ordered.emplace(key, &value);
+            u64(ordered.size());
+            for (const auto &[key, value] : ordered)
+            {
+                pod(key);
+                pod(*value);
+            }
+        }
+
+        [[nodiscard]] const std::vector<uint8_t> &data() const noexcept { return m_data; }
+        [[nodiscard]] std::vector<uint8_t> &data() noexcept { return m_data; }
+
+    private:
+        std::vector<uint8_t> m_data;
+    };
+
+    // Reads what StateWriter wrote. A read past the end, or a value that fails a
+    // check, marks the reader as failed; later reads then return zeros, so a loader
+    // can read everything and test ok() once.
+    class StateReader
+    {
+    public:
+        StateReader() = default;
+        StateReader(const uint8_t *data, size_t size) : m_data(data), m_size(size) {}
+
+        bool bytes(void *destination, size_t size)
+        {
+            if (m_failed || size > m_size - m_position)
+            {
+                m_failed = true;
+                if (size != 0u)
+                    std::memset(destination, 0, size);
+                return false;
+            }
+            if (size != 0u)
+                std::memcpy(destination, m_data + m_position, size);
+            m_position += size;
+            return true;
+        }
+
+        template <typename T>
+        void pod(T &value)
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "pod() needs a trivially copyable type");
+            bytes(&value, sizeof(T));
+        }
+
+        template <typename T>
+        [[nodiscard]] T get()
+        {
+            T value{};
+            pod(value);
+            return value;
+        }
+
+        [[nodiscard]] uint8_t u8() { return get<uint8_t>(); }
+        [[nodiscard]] uint16_t u16() { return get<uint16_t>(); }
+        [[nodiscard]] uint32_t u32() { return get<uint32_t>(); }
+        [[nodiscard]] uint64_t u64() { return get<uint64_t>(); }
+        [[nodiscard]] int32_t i32() { return get<int32_t>(); }
+        [[nodiscard]] int64_t i64() { return get<int64_t>(); }
+        [[nodiscard]] bool boolean() { return u8() != 0u; }
+
+        [[nodiscard]] std::string string()
+        {
+            const uint32_t size = u32();
+            if (m_failed || size > m_size - m_position)
+            {
+                m_failed = true;
+                return {};
+            }
+            std::string text(reinterpret_cast<const char *>(m_data + m_position), size);
+            m_position += size;
+            return text;
+        }
+
+        // A blob of exactly `size` bytes; any other stored size fails the reader.
+        bool blob(void *destination, size_t size)
+        {
+            const uint64_t stored = u64();
+            if (stored != size)
+            {
+                m_failed = true;
+                return false;
+            }
+            return bytes(destination, size);
+        }
+
+        [[nodiscard]] std::vector<uint8_t> blob()
+        {
+            const uint64_t stored = u64();
+            if (m_failed || stored > m_size - m_position)
+            {
+                m_failed = true;
+                return {};
+            }
+            std::vector<uint8_t> result(m_data + m_position, m_data + m_position + static_cast<size_t>(stored));
+            m_position += static_cast<size_t>(stored);
+            return result;
+        }
+
+        template <typename T>
+        void podVector(std::vector<T> &values)
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "podVector() needs a trivially copyable type");
+            const uint64_t count = u64();
+            values.clear();
+            if (m_failed || count > (m_size - m_position) / sizeof(T))
+            {
+                m_failed = true;
+                return;
+            }
+            values.resize(static_cast<size_t>(count));
+            bytes(values.data(), values.size() * sizeof(T));
+        }
+
+        template <typename Map>
+        void podMap(Map &values)
+        {
+            const uint64_t count = u64();
+            values.clear();
+            for (uint64_t i = 0; i < count && !m_failed; ++i)
+            {
+                typename Map::key_type key{};
+                typename Map::mapped_type value{};
+                pod(key);
+                pod(value);
+                if (!m_failed)
+                    values.emplace(std::move(key), std::move(value));
+            }
+        }
+
+        // Number of elements of a container the caller reads one by one. `minimumBytes`
+        // is the least one element takes, which bounds a corrupt count.
+        [[nodiscard]] size_t count(size_t minimumBytes = 1u)
+        {
+            const uint64_t stored = u64();
+            if (m_failed || stored > (m_size - m_position) / (minimumBytes ? minimumBytes : 1u))
+            {
+                m_failed = true;
+                return 0u;
+            }
+            return static_cast<size_t>(stored);
+        }
+
+        void fail() noexcept { m_failed = true; }
+        [[nodiscard]] bool ok() const noexcept { return !m_failed; }
+        [[nodiscard]] bool atEnd() const noexcept { return m_position == m_size; }
+        [[nodiscard]] size_t remaining() const noexcept { return m_size - m_position; }
+
+    private:
+        const uint8_t *m_data = nullptr;
+        size_t m_size = 0u;
+        size_t m_position = 0u;
+        bool m_failed = false;
+    };
+}
