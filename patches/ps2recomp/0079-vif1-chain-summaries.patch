+    // (setChainSummaries' check) What a lite transfer does to VIF1's registers, followed from `r` the way
+    // PS2Memory::processVIF1Data does while lite (an UNPACK: its data passed over), with its interrupts and MARKs in order
+    // (an i bit: 1 << 31; a MARK: its value).
+    void followRegisters(VIFRegisters &r, const uint8_t *data, uint32_t sizeBytes, std::vector<uint32_t> &events)
+    {
+        uint32_t pos = 0u;
+        while (pos + 4u <= sizeBytes)
+        {
+            const uint8_t current = static_cast<uint8_t>((r.code >> 24) & 0x7Fu);
+            if ((current == 0x50u || current == 0x51u) && r.num != 0u)
+            {
+                const uint32_t availableQw = (sizeBytes - pos) / 16u;
+                if (availableQw == 0u)
+                    break;
+                const uint32_t chunkQw = std::min<uint32_t>(r.num, availableQw);
+                pos += chunkQw * 16u;
+                r.num -= chunkQw;
+                continue;
+            }
+            uint32_t cmd = 0u;
+            std::memcpy(&cmd, data + pos, 4u);
+            pos += 4u;
+            const uint8_t opcode = static_cast<uint8_t>((cmd >> 24) & 0x7Fu);
+            const uint32_t imm = cmd & 0xFFFFu, num = (cmd >> 16) & 0xFFu;
+            r.code = cmd;
+            r.num = num;
+            if ((cmd & 0x80000000u) != 0u)
+                events.push_back(1u << 31);
+            if ((opcode & 0x60u) == 0x60u)
+            {
+                const uint32_t vn = (opcode >> 2) & 3u, vl = opcode & 3u;
+                const uint32_t bits = vl == 0u ? 32u : (vl == 1u ? 16u : (vl == 2u ? 8u : (vn == 3u ? 4u : 16u)));
+                const uint32_t bytesPerVector = (((vl == 3u && vn == 3u) ? 16u : (vn + 1u) * bits) + 7u) / 8u;
+                const uint32_t writeCount = num == 0u ? 256u : num;
+                uint32_t cl = r.cycle & 0xFFu, wl = (r.cycle >> 8) & 0xFFu;
+                cl = cl ? cl : 1u, wl = wl ? wl : 1u;
+                uint32_t sourceCount = writeCount;
+                if (cl < wl)
+                    sourceCount = (writeCount / wl) * cl + std::min(writeCount % wl, cl);
+                pos += (sourceCount * bytesPerVector + 3u) & ~3u;
+                if (pos > sizeBytes)
+                    break;
+                continue;
+            }
+            switch (opcode)
+            {
+            case 0x01u: r.cycle = imm; break;
+            case 0x02u: r.ofst = imm & 0x3FFu, r.tops = r.base & 0x3FFu, r.stat &= ~(1u << 7); break;
+            case 0x03u: r.base = imm & 0x3FFu; break;
+            case 0x04u: r.itops = imm & 0x3FFu; break;
+            case 0x05u: r.mode = imm & 3u; break;
+            case 0x07u: r.mark = imm, r.stat |= 1u << 6, events.push_back(imm); break;
+            case 0x14u: case 0x15u: case 0x17u:
+            {
+                r.top = r.tops & 0x3FFu, r.itop = r.itops & 0x3FFu;
+                r.tops = ((r.stat & (1u << 7)) != 0u) ? (r.base & 0x3FFu) : ((r.base + r.ofst) & 0x3FFu);
+                r.stat ^= 1u << 7;
+                break;
+            }
+            case 0x20u:
+                if (pos + 4u > sizeBytes)
+                    return;
+                std::memcpy(&r.mask, data + pos, 4u), pos += 4u;
+                break;
+            case 0x30u: case 0x31u:
+                if (pos + 16u > sizeBytes)
+                    return;
+                std::memcpy(opcode == 0x30u ? r.row : r.col, data + pos, 16u), pos += 16u;
+                break;
+            case 0x4Au:
+                pos += (num == 0u ? 256u : num) * 8u;
+                if (pos > sizeBytes)
+                    return;
+                break;
+            case 0x50u: case 0x51u:
+            {
+                const uint32_t qwCount = imm == 0u ? 65536u : imm;
+                const uint32_t chunkQw = std::min<uint32_t>(qwCount, (sizeBytes - pos) / 16u);
+                pos += chunkQw * 16u;
+                r.num = qwCount - chunkQw;
+                break;
+            }
+            default: break;
+            }
+        }
+    }
+
+    // The registers VIF1 ended the whole transfer with, against what its summarized copy gives (and the interrupts and
+    // MARKs of both); and the follower itself against VIF1 on the whole one.
+    void checkSummarized(const VIFRegisters &before, const PS2Memory &memory, const std::vector<uint8_t> &whole,
+                         const std::vector<uint8_t> &summarized)
+    {
+        VIFRegisters a = before, b = before;
+        std::vector<uint32_t> ea, eb;
+        followRegisters(a, whole.data(), static_cast<uint32_t>(whole.size()), ea);
+        followRegisters(b, summarized.data(), static_cast<uint32_t>(summarized.size()), eb);
+        const VIFRegisters &real = memory.vif1_regs;
+        auto same = [](const VIFRegisters &x, const VIFRegisters &y) {
+            return x.cycle == y.cycle && x.mode == y.mode && x.mask == y.mask && x.itops == y.itops && x.base == y.base &&
+                   x.ofst == y.ofst && x.tops == y.tops && x.itop == y.itop && x.top == y.top && x.mark == y.mark &&
+                   ((x.stat ^ y.stat) & 0xC0u) == 0u && x.code == y.code && x.num == y.num &&
+                   std::memcmp(x.row, y.row, sizeof(x.row)) == 0 && std::memcmp(x.col, y.col, sizeof(x.col)) == 0;
+        };
+        SummaryCheck &c = g_summaryCheckStats;
+        ++c.transfers;
+        const bool follower = same(a, real), regs = same(b, real), events = ea == eb;
+        if (!(follower && regs && events))
+        {
+            ++c.differing;
+            if (c.told < 12)
+            {
+                ++c.told;
+                std::fprintf(stderr, "[vif1] summary check: %s%s%s (whole %zu bytes, summarized %zu; %zu / %zu interrupts+MARKs; real cycle %04x "
+                                     "mode %u itops %03x tops %03x top %03x dbf %u code %08x num %u, summarized cycle %04x mode %u itops %03x "
+                                     "tops %03x top %03x dbf %u code %08x num %u)\n",
+                             follower ? "" : "the follower differs from VIF1 on the whole transfer; ", regs ? "" : "the registers differ; ",
+                             events ? "" : "the interrupts / MARKs differ", whole.size(), summarized.size(), ea.size(), eb.size(),
+                             real.cycle, real.mode, real.itops, real.tops, real.top, (real.stat >> 7) & 1u, real.code, real.num,
+                             b.cycle, b.mode, b.itops, b.tops, b.top, (b.stat >> 7) & 1u, b.code, b.num);
+            }
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - c.last >= std::chrono::seconds(30))
+        {
+            std::fprintf(stderr, "[vif1] 30 s of the summary check: %llu transfers, %llu differing\n",
+                         static_cast<unsigned long long>(c.transfers), static_cast<unsigned long long>(c.differing));
+            c.transfers = c.differing = 0u;
+            c.last = now;
+        }
+    }
