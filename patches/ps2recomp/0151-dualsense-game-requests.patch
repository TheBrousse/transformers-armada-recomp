 #include <cwctype>
 #include <iostream>
 #include <map>
@@ -379,6 +380,16 @@ namespace ps2x::sonypad::host
                 out.red = m_config.red;
                 out.green = m_config.green;
                 out.blue = m_config.blue;
+                // The game's light bar (its Autobot's colour, its blinks: setLightbarRequest), worked out by real time.
+                const LightbarRequest request = lightbarRequest();
+                if (request.active)
+                {
+                    uint8_t rgb[3];
+                    lightbarColourAt(request, nowMs(), rgb);
+                    out.red = rgb[0];
+                    out.green = rgb[1];
+                    out.blue = rgb[2];
+                }
                 out.lightbarSetup = setup;
                 out.releaseLeds = release && m_config.lightbar;
                 if (setup)
@@ -435,6 +446,9 @@ namespace ps2x::sonypad::host
                 uint64_t writtenGeneration = guestMotorsGeneration() - 1u; // forces the first state write
                 bool writesOn = canWrite;
                 bool setupPending = canWrite && m_config.lightbar && device.model == Model::DualSense;
+                uint8_t writtenRgb[3] = {0u, 0u, 0u};
+                TriggerRequest writtenTriggers;
+                bool triggersSent = false; // (the first write clears any effect a pad still holds)
                 std::string endReason = "stopping";
 
                 if (!canWrite)
@@ -535,10 +549,24 @@ namespace ps2x::sonypad::host
                     if (writesOn)
                     {
                         const uint64_t generation = guestMotorsGeneration();
-                        const OutputState out = outputState(false, false);
+                        OutputState out = outputState(false, false);
                         const bool rumbling = out.weakMotor != 0u || out.strongMotor != 0u;
-                        const bool due = generation != writtenGeneration ||
+                        // (the game's light bar and triggers: a new colour - a blink's turn too - or new effects)
+                        const bool colourChanged = out.lightbar && (out.red != writtenRgb[0] || out.green != writtenRgb[1] ||
+                                                                    out.blue != writtenRgb[2]);
+                        const TriggerRequest triggers = triggerRequest();
+                        const bool triggersChanged = device.model == Model::DualSense && (!triggersSent || triggers != writtenTriggers);
+                        const bool due = generation != writtenGeneration || colourChanged || triggersChanged ||
                                          now - lastWrite >= (rumbling ? kRumbleKeepAliveMs : kIdleKeepAliveMs);
+                        if (triggersChanged)
+                        {
+                            out.triggers = true; // (inactive: all zero, the off effect - a held resistance lets go)
+                            if (triggers.active)
+                            {
+                                std::memcpy(out.leftTrigger, triggers.left, 11u);
+                                std::memcpy(out.rightTrigger, triggers.right, 11u);
+                            }
+                        }
                         if (setupPending || due)
                         {
                             const bool setup = setupPending;
@@ -551,7 +579,24 @@ namespace ps2x::sonypad::host
                             if (setup)
                                 setupPending = false;
                             else
+                            {
                                 writtenGeneration = generation;
+                                if (ok)
+                                {
+                                    writtenRgb[0] = out.red;
+                                    writtenRgb[1] = out.green;
+                                    writtenRgb[2] = out.blue;
+                                    if (triggersChanged)
+                                    {
+                                        writtenTriggers = triggers;
+                                        triggersSent = true;
+                                        if (m_config.trace)
+                                            logLine(std::string("[sonypad] adaptive triggers ") +
+                                                    (triggers.active ? "L2 " + hex(triggers.left, 11) + " R2 " + hex(triggers.right, 11)
+                                                                     : std::string("off")));
+                                    }
+                                }
+                            }
                             if (m_config.trace && (writes <= 4 || (!setup && generation != m_tracedGeneration)))
                             {
                                 const Motors motors = guestMotors(0);
@@ -607,7 +652,9 @@ namespace ps2x::sonypad::host
                 {
                     // The game is closing: motors off, the LEDs back to the firmware (our earlier launcher's exit).
                     DWORD error = 0;
-                    write(h, device, buildOutputReport(device.model, device.link, outputState(false, true), device.outputLength), error);
+                    OutputState release = outputState(false, true);
+                    release.triggers = device.model == Model::DualSense && writtenTriggers.active; // (and no held trigger effect)
+                    write(h, device, buildOutputReport(device.model, device.link, release, device.outputLength), error);
                 }
                 setLive(false);
                 CloseHandle(h);
