+    // A colour shuffle done in place (colourShuffle): the bits uHighMask picks of each word's top
+    // half taken from the same bits of its bottom half (a 16-bit view's draw of a word's low half
+    // into its high half, the game's way, a GL pixel at a time instead of a GS pixel).
+    inline const char *kColourShuffle = R"(#version 450 core
+layout(binding = 0, r32ui) coherent uniform uimage2D uImage;
+uniform uint uHighMask;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    uint w = imageLoad(uImage, p).r;
+    imageStore(uImage, p, uvec4((w & ~uHighMask) | ((w << 16u) & uHighMask)));
+}
 )";
 
