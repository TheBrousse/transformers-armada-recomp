+    // Transformers' glare shuffle (colourShuffleOn): a 16-bit view's sprites onto a 32-bit buffer
+    // the GPU keeps, reading the same buffer through the same view, only bits 14-15 written - done
+    // on the buffer at once (colourShuffle) and not drawn, so it never goes through local memory.
+    if (nativeEnabled && colourShuffleOn && colourShuffleProgram && fpsm == GS_PSM_CT16 && state.prim.type == GS_PRIM_SPRITE &&
+        state.prim.tme && ctx.tex0.psm == GS_PSM_CT16 && ctx.frame.fbmsk == 0x3FFFu)
+    {
+        const uint32_t frameBlock = ctx.frame.fbp * 32u;
+        const uint32_t bw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+        Target *word = findTarget(frameBlock, bw, kC32);
+        if (word)
+        {
+            const uint32_t blocks = bw * 64u / kKindPageW[kC32] * ((static_cast<uint32_t>(word->rows) + kKindPageH[kC32] - 1u) / kKindPageH[kC32]) * 32u;
+            if (ctx.tex0.tbp0 >= frameBlock && ctx.tex0.tbp0 < frameBlock + blocks && std::max<uint32_t>(ctx.tex0.tbw, 1u) == bw)
+            {
+                if (!vertices.empty())
+                {
+                    flushWhy = 5;
+                    flush();
+                }
+                // (FBMSK is RGBA8888's even over a 16-bit frame: bits 3-7 of each channel are the
+                // 5551 fields' - 0x3FFF keeps R and G's low 3 bits, so bits 8-15 are written: the
+                // green byte into the alpha byte)
+                const uint32_t fm = ctx.frame.fbmsk;
+                const uint32_t mask16 = ((fm >> 3u) & 0x1Fu) | ((fm >> 6u) & 0x3E0u) | ((fm >> 9u) & 0x7C00u) | ((fm >> 16u) & 0x8000u);
+                colourShuffle(*word, (~mask16 & 0xFFFFu) << 16u);
+                return;
+            }
+        }
+    }
     const bool zwrite = !ctx.zbuf.zmask;
     const Kind depthKind = kindOf(ctx.zbuf.psm);
     const bool depthPsm = depthKind == kZ32 || depthKind == kZ16 || depthKind == kZ16S;
