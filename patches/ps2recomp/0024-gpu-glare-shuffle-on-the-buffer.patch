+// The glare shuffle on the buffer itself (colourShuffleOn): its words' bits `highMask` (of the top
+// half) from the same bits of the bottom half, every GL pixel.
+void GSGpuRenderer::Impl::colourShuffle(Target &t, uint32_t highMask)
+{
+    ensureLoaded(t);
+    msaaResolve(t, 12); // (the scene drawn multisampled: into the texture first)
+    const int w = t.width * t.sx, h = t.rows * t.sy;
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glDisable(GL_SCISSOR_TEST);
+    glViewport(0, 0, w, h);
+    glUseProgram(colourShuffleProgram);
+    glUniform1ui(colourShuffleMaskLocation, highMask);
+    glBindImageTexture(0, t.tex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    glBindVertexArray(emptyVao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindVertexArray(vao);
+    glEnable(GL_SCISSOR_TEST);
+    glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+    t.alphaClock = ++alphaClock;
+    t.msStale = true; // (its multisampled copy filled again before it draws)
+    std::fill(std::begin(t.shadowValid), std::end(t.shadowValid), false);
+    ++statColourShuffles;
+}
+
 // Rows of cells c0 to c1 of a depth buffer in `state`: each run of them drawn by the program bound
 // (the pack or the unpack) through a scissor, and the same after.
