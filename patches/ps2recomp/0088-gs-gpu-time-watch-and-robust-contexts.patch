+// local memory and is made again at the new scale on its next use (as a buffer pushed out of the cache is), the
+// pictures and the composing textures are made again at the new size (the old pictures kept until no presentation
+// shows them any more), the multisampled copies with the new samples.
+void GSGpuRenderer::Impl::rescaleAll(int sx, int sy, int samples)
+{
+    flush();
+    while (!targets.empty())
+    {
+        dropTarget(*targets.back());
+        targets.pop_back();
+    }
+    batchFrame = batchDepth = nullptr;
+    alphaCopyOf = nullptr;
+    scaleX = fitScale(sx, viewportX);
+    scaleY = fitScale(sy, viewportY);
+    g_scaleX.store(scaleX);
+    g_scaleY.store(scaleY);
+    fields = envFlag("PS2X_GPU_FIELDS", scaleY > 1);
+    glBindFramebuffer(GL_FRAMEBUFFER, drawFbo);
+    glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_WIDTH, viewportX);
+    glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_HEIGHT, viewportY);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+    samples = samples > 1 ? samples : 0;
+    if (samples < samplesNow)
+    {
+        sceneMsaa = std::min(sceneMsaa, samples);
+        msaaSamples = std::min(msaaSamples, samples);
+        samplesNow = samples;
+        g_msaaMost.store(samples);
+    }
+    if (msDepthSamples)
+        glDeleteTextures(1, &msDepthSamples); // (its samples and size are the old ones: made again when needed)
+    msDepthSamples = 0u;
+    msDepthSamplesW = msDepthSamplesH = 0;
+    if (msResolveTex)
+        glDeleteTextures(1, &msResolveTex);
+    msResolveTex = 0u;
+    msResolveW = msResolveH = 0;
+    for (MomentLayer &layer : momentLayers)
+        layer.width = 0; // (made again on their next use, at the new scale and samples)
+
+    for (size_t i = 0; i < pictureSlots; ++i)
+    {
+        if (pictures[i])
+            retiredPictures.push_back(RetiredPicture{pictures[i], nextPicture + kMaxPictures});
+        pictures[i] = 0u;
+    }
+    const size_t slots = pictureSlots;
+    pictureSlots = 0u;
+    pictureLevels = 1;
+    while (std::max(kPictureWidth * scaleX, kPictureHeight * scaleY) >> pictureLevels)
+        ++pictureLevels;
+    if (!envFlag("PS2X_GPU_PICTURE_MIPS", true))
+        pictureLevels = 1;
+    makePictureSlots(slots);
+    if (composed)
+        glDeleteTextures(1, &composed);
+    composed = makeTexture(GL_RGBA8, kPictureWidth * scaleX, kPictureHeight * scaleY, GL_LINEAR);
+    if (composedFields)
+    {
+        glDeleteTextures(1, &composedFields);
+        composedFields = makeTexture(GL_RGBA8, kPictureWidth * scaleX, kPictureHeight * scaleY, GL_LINEAR);
+    }
+}
