+// (TODO 202) The GPU-time watch (the members' comment, "the GPU's time"): at each presentation.
+void GSGpuRenderer::Impl::watchGpuTime(uint64_t tick)
+{
+    // A GPU reset told (robust contexts): the game ends with word of it (gpuWasReset).
+    if (resetStatus || resetTestTick)
+    {
+        GLenum status = resetStatus ? resetStatus() : GL_NO_ERROR;
+        if (status == GL_NO_ERROR && resetTestTick && tick >= resetTestTick)
+            status = 0x8253; // (GL_GUILTY_CONTEXT_RESET: the test's)
+        if (status != GL_NO_ERROR)
+            gpuWasReset(status, scaleX, scaleY, samplesNow);
+    }
+    if (!retiredPictures.empty())
+    {
+        std::lock_guard<std::mutex> lock(g_pictureMutex);
+        for (auto it = retiredPictures.begin(); it != retiredPictures.end();)
+        {
+            bool shown = false;
+            for (const Published &p : g_published)
+                shown = shown || (p.valid && p.texture == it->texture);
+            if (!shown && nextPicture > it->until)
+            {
+                glDeleteTextures(1, &it->texture);
+                it = retiredPictures.erase(it);
+            }
+            else
+                ++it;
+        }
+    }
+    if (!timeWatch)
+        return;
+    GLint64 now = 0;
+    glGetInteger64v(GL_TIMESTAMP, &now);
+    double worst = 0.0;
+    while (!lagQueries.empty())
+    {
+        GLint available = 0;
+        glGetQueryObjectiv(lagQueries.front().query, GL_QUERY_RESULT_AVAILABLE, &available);
+        if (!available)
+            break;
+        GLint64 done = 0;
+        glGetQueryObjecti64v(lagQueries.front().query, GL_QUERY_RESULT, &done);
+        const double lag = slowTested(static_cast<double>(std::max<GLint64>(0, done - lagQueries.front().issued)) / 1.0e6);
+        lagRecent[lagRecentNext] = lag;
+        lagRecentNext = (lagRecentNext + 1u) % lagRecent.size();
+        lagRecentCount = std::min(lagRecentCount + 1u, lagRecent.size());
+        worst = std::max(worst, lag);
+        lagPool.push_back(lagQueries.front().query);
+        lagQueries.pop_front();
+    }
+    if (!lagQueries.empty()) // (one still out: behind by at least this much)
+        worst = std::max(worst, slowTested(static_cast<double>(std::max<GLint64>(0, now - lagQueries.front().issued)) / 1.0e6));
+    if (lagQueries.size() < 64u)
+    {
+        GLuint query = 0u;
+        if (lagPool.empty())
+            glGenQueries(1, &query);
+        else
+        {
+            query = lagPool.back();
+            lagPool.pop_back();
+        }
+        glQueryCounter(query, GL_TIMESTAMP);
+        lagQueries.push_back(LagQuery{query, now});
+    }
+
+    double median = 0.0;
+    if (lagRecentCount > 0u)
+    {
+        std::array<double, 16> sorted = lagRecent;
+        std::sort(sorted.begin(), sorted.begin() + static_cast<std::ptrdiff_t>(lagRecentCount));
+        median = sorted[lagRecentCount / 2u];
+    }
+    const auto clock = std::chrono::steady_clock::now();
+    if (timeLog)
+    {
+        timeLogMost = std::max(timeLogMost, worst);
+        if (clock - timeLogAt >= std::chrono::seconds(1))
+        {
+            std::fprintf(stderr, "[gpu] GPU backlog: median %.1f ms, most %.1f ms this second (%zu out)\n", median, timeLogMost,
+                         lagQueries.size());
+            timeLogMost = 0.0;
+            timeLogAt = clock;
+        }
+    }
+    if (clock < timeWatchFrom)
+    {
+        lagRecentCount = lagRecentNext = 0u; // (judged only on what comes after)
+        return;
+    }
+    const bool slow = lagRecentCount == lagRecent.size() && median > kSlowLagMs;
+    const bool spike = worst > kSpikeLagMs;
+    if (!slow && !spike)
+        return;
+    int sx = scaleX, sy = scaleY, samples = samplesNow;
+    if (!lowerOneStep(sx, sy, samples))
+    {
+        std::fprintf(stderr, "[gpu] the graphics card is behind by %.0f ms (median %.0f) at the lowest settings already (TODO 202)\n",
+                     worst, median);
+        timeWatch = false;
+        return;
+    }
+    std::fprintf(stderr,
+                 "[gpu] the graphics card fell behind (%s: %.0f ms, the median of the last %zu %.0f ms): Resolution %dx%d with %d samples "
+                 "drawn at %dx%d with %d samples from now on, for this run - the settings stay as chosen (TODO 202)\n",
+                 spike ? "once" : "most of the time", spike ? worst : median, lagRecentCount, median, scaleX, scaleY, samplesNow, sx,
+                 sy, samples);
+    rescaleAll(sx, sy, samples);
+    for (const LagQuery &q : lagQueries)
+        lagPool.push_back(q.query);
+    lagQueries.clear();
+    lagRecentCount = lagRecentNext = 0u;
+    timeWatchFrom = clock + std::chrono::seconds(3);
 }
 
