diff --git a/ps2xRuntime/include/runtime/ps2_xinput_rumble.h b/ps2xRuntime/include/runtime/ps2_xinput_rumble.h
new file mode 100644
index 0000000..b216dd5
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_xinput_rumble.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// The game's vibration on an Xbox (XInput) controller (TODO 200). A gamepad read through GLFW (raylib) has no
+// rumble, so on Windows the motors are written with XInput: the first connected XInput pad, while the gamepad that
+// drives the PS2 pad is a GLFW one (the native Sony path, ps2_sony_pad.h, has its own motors). The values are the
+// game's own actuator data (ps2x::sonypad::guestMotors, set by the libpad / libvib HLE): the small motor on/off ->
+// wRightMotorSpeed (the high-frequency motor), the large one 0..255 -> wLeftMotorSpeed (the low-frequency motor),
+// both scaled by PS2X_SONYPAD_RUMBLE (0..100, the Vibration setting, read at start).
+//
+// The motors stop whenever the game is not taking the pad: the window unfocused, the game's input blocked (the F1
+// menu, the settings panel), the game not reading the pad for a moment (paused, loading, a state being loaded: its
+// motors are cleared), the gamepad no longer the GLFW one, and at exit (stop). XInput1_4.dll is loaded when first
+// needed, else XInput9_1_0.dll: no new link dependency, and nothing happens on a machine without either.
+// A hidden window (PS2X_WINDOW_HIDDEN, an unattended run) never takes the controller.
+// PS2X_XINPUT_TRACE=1 logs each motor change ("[xinput] ..."); =2 also makes the calls in a hidden or unfocused
+// window and without a GLFW gamepad (to user 0 when none is connected: the call then answers "not connected"), so a
+// test machine can show that the game's vibration reaches XInput.
+
+#include <cstdint>
+
+namespace ps2x::xinput
+{
+    struct Speeds
+    {
+        uint16_t left = 0u;  // wLeftMotorSpeed: the low-frequency motor (the PS2's large motor)
+        uint16_t right = 0u; // wRightMotorSpeed: the high-frequency motor (the PS2's small motor)
+        bool operator==(const Speeds &o) const { return left == o.left && right == o.right; }
+        bool operator!=(const Speeds &o) const { return !(*this == o); }
+    };
+    // The XInput speeds for the guest's motors at percent (0..100).
+    Speeds speedsFor(bool small, uint8_t large, int percent);
+
+    // The host pad backend's read (any thread): whether a GLFW gamepad (not the native Sony pad) drives the pad.
+    void notePadRead(bool glfwGamepad);
+    // The window thread, each frame: the motors as the game has them, or off (above).
+    void tick(bool focused, bool inputBlocked);
+    // The motors off (the runtime's exit, after the window loop).
+    void stop();
+}
