diff --git a/ps2xRuntime/src/lib/ps2_xinput_rumble.cpp b/ps2xRuntime/src/lib/ps2_xinput_rumble.cpp
new file mode 100644
index 0000000..9e5c63a
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_xinput_rumble.cpp
@@ -0,0 +1,221 @@
+// XInput vibration for GLFW gamepads (TODO 200): see ps2_xinput_rumble.h.
+#include "runtime/ps2_xinput_rumble.h"
+#include "runtime/ps2_sony_pad.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h> // this file never includes raylib, whose names clash with it
+#endif
+
+namespace ps2x::xinput
+{
+    Speeds speedsFor(bool small, uint8_t large, int percent)
+    {
+        const uint32_t p = static_cast<uint32_t>(std::clamp(percent, 0, 100));
+        Speeds s;
+        s.left = static_cast<uint16_t>(static_cast<uint32_t>(large) * 257u * p / 100u);
+        s.right = small ? static_cast<uint16_t>(65535u * p / 100u) : uint16_t{0};
+        return s;
+    }
+
+    namespace
+    {
+        std::atomic<bool> g_glfwGamepad{false};
+        std::atomic<int64_t> g_lastReadMs{LLONG_MIN / 2};
+
+        int64_t nowMs()
+        {
+            return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        }
+
+        bool environmentOn(const char *name)
+        {
+            const char *v = std::getenv(name);
+            return v && *v && *v != '0';
+        }
+
+        // A read this long ago is a game not taking the pad (paused, loading, a state being loaded).
+        constexpr int64_t kReadStaleMs = 300;
+        // How often a missing XInput pad is looked for (XInputGetState of an empty slot is slow).
+        constexpr int64_t kScanMs = 1000;
+
+        struct Settings
+        {
+            int percent = 100;
+            int trace = 0; // PS2X_XINPUT_TRACE
+            bool hidden = false;
+        };
+        const Settings &settings()
+        {
+            static const Settings s = []()
+            {
+                Settings out;
+                if (const char *env = std::getenv("PS2X_SONYPAD_RUMBLE"); env && *env)
+                    out.percent = std::clamp(std::atoi(env), 0, 100);
+                if (const char *env = std::getenv("PS2X_XINPUT_TRACE"); env && *env)
+                    out.trace = std::clamp(std::atoi(env), 0, 2);
+                out.hidden = environmentOn("PS2X_WINDOW_HIDDEN");
+                return out;
+            }();
+            return s;
+        }
+
+#if defined(_WIN32)
+        // XINPUT_STATE / XINPUT_VIBRATION as xinput.h has them (kept here: no xinput.h, no import library).
+        struct PadState
+        {
+            DWORD packet;
+            WORD buttons;
+            BYTE leftTrigger, rightTrigger;
+            SHORT thumbLX, thumbLY, thumbRX, thumbRY;
+        };
+        struct Vibration
+        {
+            WORD left, right;
+        };
+        using GetStateFn = DWORD(WINAPI *)(DWORD, PadState *);
+        using SetStateFn = DWORD(WINAPI *)(DWORD, Vibration *);
+
+        struct Api
+        {
+            GetStateFn getState = nullptr;
+            SetStateFn setState = nullptr;
+        };
+        // Loaded the first time the game vibrates (the window thread only).
+        const Api &api()
+        {
+            static const Api a = []()
+            {
+                Api out;
+                for (const wchar_t *dll : {L"xinput1_4.dll", L"xinput9_1_0.dll"})
+                {
+                    HMODULE module = LoadLibraryW(dll);
+                    if (!module)
+                        continue;
+                    out.getState = reinterpret_cast<GetStateFn>(reinterpret_cast<void *>(GetProcAddress(module, "XInputGetState")));
+                    out.setState = reinterpret_cast<SetStateFn>(reinterpret_cast<void *>(GetProcAddress(module, "XInputSetState")));
+                    if (out.getState && out.setState)
+                    {
+                        std::fprintf(stderr, "[xinput] vibration for Xbox controllers: %ls\n", dll);
+                        return out;
+                    }
+                    out = Api{};
+                    FreeLibrary(module);
+                }
+                std::fprintf(stderr, "[xinput] no XInput DLL: Xbox controllers do not vibrate\n");
+                return out;
+            }();
+            return a;
+        }
+
+        // The window thread's.
+        int g_user = -1;      // the XInput pad written to; -1: none found yet
+        int64_t g_nextScan = 0;
+        Speeds g_written;     // what the pad was last told (off: it is never touched before the game vibrates)
+
+        int firstConnectedUser()
+        {
+            for (DWORD i = 0; i < 4; ++i)
+            {
+                PadState state{};
+                if (api().getState(i, &state) == ERROR_SUCCESS)
+                    return static_cast<int>(i);
+            }
+            return -1;
+        }
+
+        void write(const Speeds &s, const char *why)
+        {
+            Vibration v{s.left, s.right};
+            const DWORD result = api().setState(static_cast<DWORD>(g_user), &v);
+            if (settings().trace)
+            {
+                const sonypad::Motors m = sonypad::guestMotors(0);
+                std::fprintf(stderr, "[xinput] motors: guest small %s large %u -> left %u right %u, user %d (%s): %s\n",
+                             m.small ? "on" : "off", static_cast<unsigned>(m.large), static_cast<unsigned>(s.left),
+                             static_cast<unsigned>(s.right), g_user, why,
+                             result == ERROR_SUCCESS ? "ok" : result == ERROR_DEVICE_NOT_CONNECTED ? "not connected" : "error");
+            }
+            if (result == ERROR_SUCCESS)
+                g_written = s;
+            else
+            {
+                g_written = Speeds{}; // (a pad that went away is off; one found again starts from off)
+                g_user = -1;
+            }
+        }
+#endif
+    }
+
+    void notePadRead(bool glfwGamepad)
+    {
+        g_glfwGamepad.store(glfwGamepad, std::memory_order_relaxed);
+        g_lastReadMs.store(nowMs(), std::memory_order_relaxed);
+    }
+
+    void tick(bool focused, bool inputBlocked)
+    {
+#if defined(_WIN32)
+        const Settings &cfg = settings();
+        const bool test = cfg.trace >= 2;
+        if (cfg.hidden && !test)
+            return;
+        const int64_t now = nowMs();
+        const bool reading = now - g_lastReadMs.load(std::memory_order_relaxed) < kReadStaleMs;
+        const bool active = reading && !inputBlocked && (test || (focused && g_glfwGamepad.load(std::memory_order_relaxed)));
+        Speeds want;
+        if (active)
+        {
+            const sonypad::Motors m = sonypad::guestMotors(0);
+            want = speedsFor(m.small, m.large, cfg.percent);
+        }
+        if (want == g_written)
+            return;
+        // (only here, the first time the game vibrates: a game that never does never loads XInput)
+        if (!api().setState)
+            return;
+        if (g_user < 0)
+        {
+            if (want == Speeds{})
+            {
+                g_written = Speeds{};
+                return;
+            }
+            if (now < g_nextScan)
+                return;
+            g_nextScan = now + kScanMs;
+            g_user = firstConnectedUser();
+            if (g_user < 0)
+            {
+                if (!test)
+                    return;
+                g_user = 0; // (the test mode's call to an empty slot)
+            }
+        }
+        write(want, active ? "the game" : "off: the game is not taking the pad");
+#else
+        (void)focused;
+        (void)inputBlocked;
+#endif
+    }
+
+    void stop()
+    {
+#if defined(_WIN32)
+        if (g_user >= 0 && g_written != Speeds{} && api().setState)
+            write(Speeds{}, "off: exit");
+#endif
+    }
+}
