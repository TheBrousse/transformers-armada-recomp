+const PS2Runtime::GuestLayout &PS2Runtime::guestLayout()
+{
+    static const GuestLayout layout = []()
+    {
+        const char *env = std::getenv("PS2X_GUEST_RAM_MB");
+        if (env && std::atoi(env) == 32)
+            return GuestLayout{32u, 0x01FA8000u, 0u, 0u, 0x01FA8000u, 0x01FE0000u};
+        // (the main thread's stack at 0x01FE0000-0x02000000, where the game's crt0 puts it; the added data's 1 MB
+        // at the top of RAM)
+        constexpr uint32_t kAddedData = 0x00100000u;
+        return GuestLayout{PS2_RAM_SIZE >> 20, 0x01FE0000u, 0x02000000u, PS2_RAM_SIZE - kAddedData, PS2_RAM_SIZE - kAddedData,
+                           PS2_RAM_SIZE};
+    }();
+    return layout;
+}
+
+uint32_t PS2Runtime::guestHeapLargestFree() const
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    uint32_t largest = 0u;
+    for (const GuestHeapBlock &block : m_guestHeapBlocks)
+        if (block.free)
+            largest = std::max(largest, block.size);
+    return largest;
+}
