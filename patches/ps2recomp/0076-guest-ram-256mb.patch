+namespace
+{
+    // Main RAM in a state (N7: 256 MB, most of it never written): its 4 KB pages in runs - all-zero pages and pages
+    // filled with one word kept as a count (and the word), the rest raw. A state of the 256 MB HQ or a level is ~30 MB
+    // of RAM instead of 256. Marked so a state with the whole RAM as one blob (as before) still loads.
+    // PS2X_STATE_RAW=1: the whole RAM written as one blob, as before (an A/B of the size and the time).
+    constexpr uint64_t kRamPagesMark = 0x5345474150584D52ull; // ("RMXPAGES": not a size a blob could have)
+    constexpr size_t kRamPage = 4096u;
+    enum RamRun : uint8_t
+    {
+        kRunZero = 0u,   // u32 pages: all zero
+        kRunFilled = 1u, // u32 pages, u32 word: every word of each page that word
+        kRunRaw = 2u,    // u32 pages, then their bytes
+    };
+
+    bool rawRamStates()
+    {
+        static const bool raw = []()
+        {
+            const char *env = std::getenv("PS2X_STATE_RAW");
+            return env && *env == '1';
+        }();
+        return raw;
+    }
+
+    // A page all one word: that word, else false.
+    bool pageFilled(const uint8_t *page, uint32_t &word)
+    {
+        uint64_t first = 0u;
+        std::memcpy(&first, page, sizeof(first));
+        if (static_cast<uint32_t>(first) != static_cast<uint32_t>(first >> 32))
+            return false;
+        for (size_t at = 8u; at < kRamPage; at += 8u)
+        {
+            uint64_t value = 0u;
+            std::memcpy(&value, page + at, sizeof(value));
+            if (value != first)
+                return false;
+        }
+        word = static_cast<uint32_t>(first);
+        return true;
+    }
+
+    void saveRam(ps2x::StateWriter &out, const uint8_t *ram, size_t size)
+    {
+        if (rawRamStates())
+        {
+            out.blob(ram, size);
+            return;
+        }
+        out.u64(kRamPagesMark);
+        out.u64(size);
+        const size_t pages = size / kRamPage;
+        size_t page = 0u;
+        while (page < pages)
+        {
+            uint32_t word = 0u;
+            const bool filled = pageFilled(ram + page * kRamPage, word);
+            size_t end = page + 1u;
+            if (filled)
+            {
+                uint32_t next = 0u;
+                while (end < pages && pageFilled(ram + end * kRamPage, next) && next == word)
+                    ++end;
+                out.u8(word == 0u ? kRunZero : kRunFilled);
+                out.u32(static_cast<uint32_t>(end - page));
+                if (word != 0u)
+                    out.u32(word);
+            }
+            else
+            {
+                uint32_t next = 0u;
+                while (end < pages && !pageFilled(ram + end * kRamPage, next))
+                    ++end;
+                out.u8(kRunRaw);
+                out.u32(static_cast<uint32_t>(end - page));
+                out.bytes(ram + page * kRamPage, (end - page) * kRamPage);
+            }
+            page = end;
+        }
+    }
+
+    void loadRam(ps2x::StateReader &in, uint8_t *ram, size_t size)
+    {
+        const uint64_t first = in.u64();
+        if (first == size) // (the whole RAM as one blob: states made before, or with PS2X_STATE_RAW)
+        {
+            in.bytes(ram, size);
+            return;
+        }
+        if (first != kRamPagesMark || in.u64() != size)
+        {
+            in.fail(); // ("does not match this build")
+            return;
+        }
+        const size_t pages = size / kRamPage;
+        size_t page = 0u;
+        while (page < pages && in.ok())
+        {
+            const uint8_t kind = in.u8();
+            const uint32_t count = in.u32();
+            if (!in.ok() || count == 0u || count > pages - page)
+            {
+                in.fail();
+                return;
+            }
+            uint8_t *at = ram + page * kRamPage;
+            const size_t bytes = static_cast<size_t>(count) * kRamPage;
+            if (kind == kRunZero)
+                std::memset(at, 0, bytes);
+            else if (kind == kRunFilled)
+            {
+                const uint32_t word = in.u32();
+                for (size_t i = 0; i < bytes; i += 4u)
+                    std::memcpy(at + i, &word, 4u);
+            }
+            else if (kind == kRunRaw)
+                in.bytes(at, bytes);
+            else
+            {
+                in.fail();
+                return;
+            }
+            page += count;
+        }
+    }
+}
