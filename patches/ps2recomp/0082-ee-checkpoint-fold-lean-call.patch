+// (0082) The plain call on its own: what the round-6 plain way below does, in a function with nothing else, so its
+// frame saves a few registers instead of the nine the whole dispatcher needed. The rest: dispatchGuestCallFull.
 bool PS2Runtime::dispatchGuestCall(uint8_t *rdram,
                                    R5900Context *ctx,
                                    uint32_t targetPc,
                                    uint32_t sourcePc,
                                    uint32_t fallthroughPc,
                                    RecompiledFunction targetFn)
+{
+    if (!g_plainCalls || !targetFn) [[unlikely]]
+        return dispatchGuestCallFull(rdram, ctx, targetPc, sourcePc, fallthroughPc, targetFn);
+    ctx->pc = targetPc;
+    if (m_eeScheduler && m_eeScheduler->checkpointDue(EeScheduler::kGuestDispatchCycles))
+        return false;
+    Ps2DispatchLevels &levels = g_ps2DispatchLevels;
+    const uint32_t level = levels.level + 1u;
+    levels.level = level;
+    if (level < kDispatchLevels) [[likely]]
+        levels.resumedByDispatcher[level] = false;
+    targetFn(rdram, ctx, this);
+    if (ctx->pc == fallthroughPc && !isStopRequested() && !(level < kDispatchLevels && levels.resumedByDispatcher[level]))
+        [[likely]]
+    {
+        if (m_eeScheduler)
+            m_eeScheduler->clearCheckpointUnwind();
+        --levels.level;
+        return true;
+    }
+    return callEnd(rdram, ctx, targetPc, fallthroughPc, level);
+}
+
+PS2_NOINLINE bool PS2Runtime::dispatchGuestCallFull(uint8_t *rdram,
