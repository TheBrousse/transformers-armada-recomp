+// (0082) PS2X_RAISE_LOG=1, a measuring aid - how promptly the EE takes a request from another host thread: the request
+// noted with the EE clock (read without sync) and the host time; the dispatcher loop logs when it is back in the loop.
+namespace
+{
+    const bool g_raiseLogOn = []()
+    {
+        const char *env = std::getenv("PS2X_RAISE_LOG");
+        return env && *env == '1';
+    }();
+    std::atomic<const char *> g_raiseWhat{nullptr};
+    std::atomic<uint64_t> g_raiseCycle{0u};
+    std::atomic<int64_t> g_raiseNs{0};
+    int64_t raiseNowNs()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void noteRaise(const char *what, bool executor, const volatile uint64_t &eeCycle)
+    {
+        if (!g_raiseLogOn || executor)
+            return;
+        g_raiseCycle.store(eeCycle, std::memory_order_relaxed);
+        g_raiseNs.store(raiseNowNs(), std::memory_order_relaxed);
+        g_raiseWhat.store(what, std::memory_order_seq_cst);
+    }
+    void noteRaiseSeen(const char *where, uint64_t eeCycle)
+    {
+        if (!g_raiseLogOn)
+            return;
+        const char *what = g_raiseWhat.exchange(nullptr, std::memory_order_seq_cst);
+        if (!what)
+            return;
+        const uint64_t at = g_raiseCycle.load(std::memory_order_relaxed);
+        std::fprintf(stderr, "[ee raise] %s from another thread: back in the dispatcher (%s) after %lld EE cycles, %.1f us\n", what,
+                     where, static_cast<long long>(eeCycle - at), (raiseNowNs() - g_raiseNs.load(std::memory_order_relaxed)) / 1000.0);
+    }
+}
